"""Walk-forward analysis: causal cross-sleeve weighting (each week uses only prior data),
stitched into one OOS curve. Removes the hindsight-weighting contamination from the
headline number. Signal rules within sleeves are already causal/a-priori (lagged lookbacks,
trailing regime filter & funding weights), so only the allocation is walk-forwarded.
LIMIT: sleeve SELECTION (momentum/carry/trend) is still full-sample knowledge -> only the
live record is fully clean OOS. Run: PYTHONPATH=. python3 walk_forward.py"""
import numpy as np, pandas as pd
from tear_sheet import build_v3
_, j = build_v3(); W = j.resample("W").sum(); WARMUP = 52
def wf(method):
    oos = {}
    for t in range(WARMUP, len(W)):
        tr = W.iloc[t-WARMUP:t]
        act = [c for c in W.columns if tr[c].std() > 1e-9 and (tr[c] != 0).sum() > 20]
        if not act: continue
        if method == "equal": wts = {c: 1/len(act) for c in act}
        elif method == "invvol":
            iv = {c: 1/tr[c].std() for c in act}; s = sum(iv.values()); wts = {c: iv[c]/s for c in act}
        else:
            sh = {c: max(tr[c].mean()/tr[c].std(), 0)+0.1 for c in act}; s = sum(sh.values()); wts = {c: sh[c]/s for c in act}
        oos[W.index[t]] = sum(wts[c]*W[c].iloc[t] for c in act)
    s = pd.Series(oos); sr = s.mean()/s.std()*np.sqrt(52); rho = s.autocorr(1)
    neff = len(s)*(1-rho)/(1+rho); dd = ((1+s).cumprod()/(1+s).cumprod().cummax()-1).min()
    print(f"  {method:14s} OOS Sharpe {sr:.2f} | t(adj) {sr*np.sqrt(max(neff,1)/52):.2f} | maxDD {dd*100:.1f}%")
print("WALK-FORWARD (causal weights, stitched OOS 2021-2026):")
for m in ("equal","invvol","trail_sharpe"): wf(m)

