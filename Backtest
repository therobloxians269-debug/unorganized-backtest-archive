"""TRUE opens per Daye: the Q2 open of each cycle, not the Q1 open."""
import pandas as pd, numpy as np, warnings; warnings.filterwarnings('ignore')
def prep(df):
    o=df.copy(); m=(o.index.hour*60+o.index.minute).values
    o['tod']=m; o['m18']=(m-1080+1440)%1440
    o['dow']=o.index.dayofweek          # Mon=0
    r=o.resample('60min',label='left',closed='left').agg({'h':'max','l':'min','c':'last'}).dropna()
    tr=pd.concat([r.h-r.l,(r.h-r.c.shift()).abs(),(r.l-r.c.shift()).abs()],axis=1).max(axis=1)
    o['atr60']=tr.rolling(14).mean().shift(1).reindex(o.index,method='ffill')
    return o

def true_opens(b):
    out=[]
    idx=b.index; tod=b.tod.values; o=b.o.values; dow=b.dow.values
    # TDO = 00:00 NY  (Q2 of the day cycle)
    w=np.where((tod==0)&(np.r_[True,tod[:-1]!=0]))[0]
    for i in w: out.append(dict(kind='TDO',px=o[i],known=idx[i]))
    # TSO = 01:30 / 07:30 / 13:30 / 19:30  (Q2 of each 6h session)
    for t in (90,450,810,1170):
        w=np.where((tod==t)&(np.r_[True,tod[:-1]!=t]))[0]
        for i in w: out.append(dict(kind='TSO',px=o[i],known=idx[i]))
    # TMSO = 22.5 min into each 90m block (Q2 of the 90m cycle)
    m18=b.m18.values
    q2=((m18%90)>=22)&((m18%90)<23)
    w=np.where(q2&np.r_[True,~q2[:-1]])[0]
    for i in w: out.append(dict(kind='TMSO',px=o[i],known=idx[i]))
    # TWO = Monday 18:00 NY  (Q2 of the week)
    w=np.where((dow==0)&(tod==1080)&(np.r_[True,~((dow[:-1]==0)&(tod[:-1]==1080))]))[0]
    for i in w: out.append(dict(kind='TWO',px=o[i],known=idx[i]))
    # TMO = 2nd Monday of the month at 18:00
    mon=(dow==0)&(tod==1080)
    w=np.where(mon&np.r_[True,~mon[:-1]])[0]
    seen={}
    for i in w:
        k=(idx[i].year,idx[i].month); seen[k]=seen.get(k,0)+1
        if seen[k]==2: out.append(dict(kind='TMO',px=o[i],known=idx[i]))
    return pd.DataFrame(out)

