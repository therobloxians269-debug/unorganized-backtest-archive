"""Instrument, session, and cost specifications.

The system *researches* signals on free cash-index OHLCV (clean 09:30/16:00 ET RTH
open/close, decades of history) and *executes* on micro futures (MES/MNQ/MYM) for
capital efficiency, with the full-size E-mini used for execution realism and longer
futures history. Each :class:`Market` wires those three roles together.

All monetary values are USD. Tick value is derived (tick_size * point_multiplier)
and cross-checked against published CME contract specs in the tests.
"""
from __future__ import annotations

from collections.abc import Iterable
from dataclasses import dataclass
from datetime import time
from enum import Enum


class InstrumentKind(str, Enum):
    """Role of an instrument within a market."""

    CASH_INDEX = "cash_index"                     # signal source; not tradeable
    EQUITY_FUTURE = "equity_future"               # full-size E-mini; realism / history
    MICRO_EQUITY_FUTURE = "micro_equity_future"   # deployment instrument


@dataclass(frozen=True)
class SessionSpec:
    """Regular-trading-hours (RTH) session boundaries in a named timezone.

    The overnight target is close(t) -> open(t+1) using these RTH marks; the intraday
    leg is open(t) -> close(t). These are session marks, not a trading calendar;
    holidays/half-days are handled in M1.
    """

    name: str
    tz: str          # IANA tz name, e.g. "America/New_York"
    rth_open: time
    rth_close: time

    def __post_init__(self) -> None:
        if self.rth_open >= self.rth_close:
            raise ValueError(
                f"{self.name}: rth_open {self.rth_open} must precede rth_close {self.rth_close}"
            )
        try:
            from zoneinfo import ZoneInfo

            ZoneInfo(self.tz)
        except Exception as exc:  # pragma: no cover - host tzdata issue
            raise ValueError(f"{self.name}: invalid timezone {self.tz!r}: {exc}") from exc


@dataclass(frozen=True)
class CostSpec:
    """Cost components for a tradeable contract, per contract per side."""

    commission_per_side: float    # broker commission, USD/contract/side
    exchange_fee_per_side: float  # exchange + clearing + regulatory, USD/contract/side
    slippage_ticks: float         # assumed adverse slippage per side, in ticks

    def __post_init__(self) -> None:
        for field_name in ("commission_per_side", "exchange_fee_per_side", "slippage_ticks"):
            value = getattr(self, field_name)
            if value < 0:
                raise ValueError(f"CostSpec.{field_name} must be >= 0, got {value}")

    @property
    def fees_per_side(self) -> float:
        """Fixed (non-slippage) cost per contract per side."""
        return self.commission_per_side + self.exchange_fee_per_side


@dataclass(frozen=True)
class ContractSpec:
    """A tradeable futures contract."""

    symbol: str
    name: str
    kind: InstrumentKind
    data_symbol: str | None  # yfinance ticker for OHLCV; None when not separately fetched
    point_multiplier: float  # USD per 1.00 point of price
    tick_size: float         # minimum price increment, in points
    costs: CostSpec
    currency: str = "USD"
    exchange: str = "CME"

    def __post_init__(self) -> None:
        if self.point_multiplier <= 0:
            raise ValueError(f"{self.symbol}: point_multiplier must be > 0")
        if self.tick_size <= 0:
            raise ValueError(f"{self.symbol}: tick_size must be > 0")

    @property
    def tick_value(self) -> float:
        """USD value of one tick (tick_size * point_multiplier)."""
        return self.tick_size * self.point_multiplier

    def slippage_per_side(self) -> float:
        """USD slippage per contract per side."""
        return self.costs.slippage_ticks * self.tick_value

    def round_turn_cost(self) -> float:
        """Total modeled USD cost for one contract's round turn (entry + exit)."""
        return 2.0 * (self.costs.fees_per_side + self.slippage_per_side())


@dataclass(frozen=True)
class Market:
    """Wires a tradeable micro to its signal source and full-size sibling.

    - ``cash_symbol``: free cash-index OHLCV used for *signal* research (clean RTH).
    - ``fullsize``: full-size E-mini, for execution realism & longer futures history.
    - ``micro``: the deployment instrument (capital-efficient).
    """

    key: str
    description: str
    cash_symbol: str
    session: SessionSpec
    fullsize: ContractSpec
    micro: ContractSpec

    def __post_init__(self) -> None:
        if self.fullsize.point_multiplier <= self.micro.point_multiplier:
            raise ValueError(f"{self.key}: full-size multiplier must exceed micro multiplier")


# --- Shared session & regime constants -------------------------------------
