"""
Apex 50K evaluation — honest go/no-go engine (M4).

Two stages, no invented numbers:
  1. Backtest a DELIBERATELY PLAIN opening-range-breakout (ORB) signal on real
     ES front-month RTH 1-min bars, 2010-2026, with realistic MES costs.
     Record each trade's realized / peak-favorable / worst-adverse excursion.
  2. Monte-Carlo the Apex 50K eval PATH using the real trade distribution:
     - trailing threshold = $2,500 below the running EQUITY PEAK (incl. the
       trade's peak unrealized profit -> conservative: favorable move first,
       so the threshold ratchets up before the adverse move tests it)
     - pass = close cumulative >= +$3,000
     - integer micro sizing to a fixed $ risk-per-trade (swept)
     Reports P(pass), P(bust), P(timeout), median days, and EV.

  Also runs a ZERO-EDGE NULL (shuffle trade signs to ~breakeven) so we can see
  the pure risk-of-ruin geometry -- the honest floor.

Nothing here is tuned to maximize a backtest number. Params are fixed, sensible
defaults, stated up front. If the math doesn't clear the gate, we don't buy.
"""
import numpy as np
import pandas as pd

# ----------------------------------------------------------------------------
# CONFIG  (all knobs visible; none optimized)
# ----------------------------------------------------------------------------
DATA        = "/Users/kaveh/mim_research/es_front_rth_1m.parquet"

# --- Apex 50K rules (confirmed) ---
ACCOUNT_DD      = 2500.0     # trailing threshold, $ below running peak
PROFIT_TARGET   = 3000.0     # must CLOSE at/above
# no daily loss limit on the eval (we impose our own below)

# --- MES economics ---
PT_VALUE        = 5.0        # $ per ES/MES point (MES = $5/pt)
TICK            = 0.25       # points
COST_PER_MES_RT = 4.00       # $/contract round trip: ~$1.60 comm + ~1 tick slip each way

# --- Signal params (FIXED, not optimized) ---
OR_MINUTES      = 15         # opening range = first 15 RTH minutes (09:30-09:44)
TARGET_R        = 2.0        # take profit at 2R
STOP_CAP_PTS    = 40.0       # if OR range wider than this -> skip (stop too far)
STOP_MIN_PTS    = 4.0        # if OR range tighter than this -> skip (noise)
EXIT_HM         = "15:55"    # flat before the close
ENTRY_SLIP_PTS  = TICK       # 1 tick entry slippage (stop-entry through the level)

# --- Risk overlay for the MC ---
RISK_SWEEP      = [60, 90, 120, 160, 200, 250]   # $ risked per trade (sweep)
HARD_TRADE_CAP  = 250.0      # never risk more than this per trade even at 1 micro
MAX_DAYS        = 250        # eval timeout (trading days)
N_SIMS          = 20000

# --- Economics of the decision ---
EVAL_COST       = 35.0       # ~monthly eval w/ coupon
ACTIVATION_FEE  = 130.0      # one-time on pass (PA activation)
FIRST_PAYOUT    = 1000.0     # conservative first realized payout if funded+paid

RNG = np.random.default_rng(20260711)

# ----------------------------------------------------------------------------
# Load real ES RTH 1-min
# ----------------------------------------------------------------------------
def load_es():
    df = pd.read_parquet(DATA)
    # 'date' = day @ 00:00, 'hm' = 'HH:MM'
    dt = pd.to_datetime(df["date"].dt.strftime("%Y-%m-%d") + " " + df["hm"])
    df = df.assign(dt=dt).sort_values("dt").reset_index(drop=True)
    # RTH only (defensive; file is already RTH)
    mins = df["dt"].dt.hour * 60 + df["dt"].dt.minute
    df = df[(mins >= 9 * 60 + 30) & (mins <= 16 * 60)].copy()
    return df

# ----------------------------------------------------------------------------
# Backtest: plain ORB, 1 trade/day, first break of the opening range.
# Records per trade: R outcome, peak-favorable R, worst-adverse R, stop_pts.
# ----------------------------------------------------------------------------
def backtest(df):
    trades = []
    or_end = 9 * 60 + 30 + OR_MINUTES          # first bar time we may trade
    exit_h, exit_m = map(int, EXIT_HM.split(":"))
    exit_cut = exit_h * 60 + exit_m
    for day, g in df.groupby(df["dt"].dt.date):
        g = g.sort_values("dt")
        mins = g["dt"].dt.hour * 60 + g["dt"].dt.minute
        orb = g[mins < or_end]
        rest = g[(mins >= or_end) & (mins <= exit_cut)]
        if len(orb) < OR_MINUTES or len(rest) < 5:
            continue
        or_hi, or_lo = orb["high"].max(), orb["low"].min()
        rng = or_hi - or_lo
        if rng < STOP_MIN_PTS or rng > STOP_CAP_PTS:
            continue

        h = rest["high"].values; l = rest["low"].values; c = rest["close"].values
        entry = side = None
        for i in range(len(rest)):
            if h[i] >= or_hi:        # long break
                side, entry, stop = 1, or_hi + ENTRY_SLIP_PTS, or_lo
                break
            if l[i] <= or_lo:        # short break
                side, entry, stop = -1, or_lo - ENTRY_SLIP_PTS, or_hi
                break
        if side is None:
            continue
        risk_pts = abs(entry - stop)
        if risk_pts < STOP_MIN_PTS:
            continue
        tgt = entry + side * TARGET_R * risk_pts

        # walk bars from the breakout bar to resolution
        seg = rest.iloc[i:]
        sh = seg["high"].values; sl = seg["low"].values
        mfe = mae = 0.0
        outcome_pts = None
        for j in range(len(seg)):
            fav = side * (sh[j] - entry) if side == 1 else side * (entry - sl[j])
            adv = side * (sl[j] - entry) if side == 1 else side * (entry - sh[j])
            # signed excursions in points, from the trade's perspective
            up = (sh[j] - entry) * side
            dn = (sl[j] - entry) * side
            mfe = max(mfe, up)
            mae = min(mae, dn)
            # stop first (conservative), then target
            if dn <= -risk_pts:
                outcome_pts = -risk_pts
                break
            if up >= TARGET_R * risk_pts:
                outcome_pts = TARGET_R * risk_pts
                break
        if outcome_pts is None:      # timed out -> exit at last close
            outcome_pts = (seg["close"].values[-1] - entry) * side

        trades.append(dict(
            date=str(day), side=side, stop_pts=risk_pts,
            R=outcome_pts / risk_pts,
            mfe_R=mfe / risk_pts,
            mae_R=mae / risk_pts,
        ))
    return pd.DataFrame(trades)

# ----------------------------------------------------------------------------
# Monte-Carlo the Apex eval path from the empirical trade distribution.
# ----------------------------------------------------------------------------
def monte_carlo(tr, risk_dollars, zero_edge=False):
    R      = tr["R"].values.copy()
    mfeR   = tr["mfe_R"].values
    maeR   = tr["mae_R"].values
    stop   = tr["stop_pts"].values
    n      = len(R)

    if zero_edge:
        # neutralize drift: recenter realized R to ~0, keep excursion shapes
        R = R - R.mean()

    passes = busts = timeouts = 0
    days_to_pass = []

    for _ in range(N_SIMS):
        equity = 0.0
        peak   = 0.0
        thresh = -ACCOUNT_DD           # $2,500 below start
        done = False
        for d in range(MAX_DAYS):
            k = RNG.integers(n)        # iid trade bootstrap
            sp = stop[k]
            risk_1micro = sp * PT_VALUE
            if risk_1micro > HARD_TRADE_CAP:
                continue               # too-wide stop -> skip the day (no fill)
            contracts = max(1, int(risk_dollars // risk_1micro))
            cost = COST_PER_MES_RT * contracts

            # dollar excursions this trade (favorable move first -> conservative)
            best_d  = equity + mfeR[k] * sp * PT_VALUE * contracts
            worst_d = equity + maeR[k] * sp * PT_VALUE * contracts - cost
            realized_d = equity + R[k] * sp * PT_VALUE * contracts - cost

            # peak ratchets on the favorable excursion, tightening the threshold
            peak = max(peak, best_d)
            thresh = peak - ACCOUNT_DD
            if worst_d <= thresh:      # adverse excursion breaches -> BUST
                busts += 1
                done = True
                break

            equity = realized_d
            peak = max(peak, equity)
            thresh = peak - ACCOUNT_DD
            if equity >= PROFIT_TARGET:
                passes += 1
                days_to_pass.append(d + 1)
                done = True
                break
        if not done:
            timeouts += 1

    return dict(
        risk=risk_dollars,
        p_pass=passes / N_SIMS,
        p_bust=busts / N_SIMS,
        p_timeout=timeouts / N_SIMS,
        med_days=int(np.median(days_to_pass)) if days_to_pass else None,
    )

# ----------------------------------------------------------------------------
def main():
    print("Loading real ES RTH 1-min ...")
    df = load_es()
    print(f"  bars: {len(df):,}  days: {df['dt'].dt.date.nunique():,}  "
          f"range: {df['dt'].min().date()} -> {df['dt'].max().date()}\n")

    tr = backtest(df)
    n = len(tr)
    wr = (tr["R"] > 0).mean()
    exp_R = tr["R"].mean()
    # net R after cost (approx at 1 micro, avg stop)
    avg_stop_d = tr["stop_pts"].mean() * PT_VALUE
    cost_R = COST_PER_MES_RT / avg_stop_d
    net_R = exp_R - cost_R

    print("=" * 68)
    print("SIGNAL: plain opening-range breakout, ES RTH, FIXED params")
    print("=" * 68)
    print(f"  trades            : {n:,}  (~1/day)")
    print(f"  win rate          : {wr:6.1%}")
    print(f"  gross expectancy  : {exp_R:+.4f} R/trade")
    print(f"  ~cost             : {cost_R:.4f} R/trade  (avg stop ${avg_stop_d:.0f})")
    print(f"  NET expectancy    : {net_R:+.4f} R/trade")
    print(f"  avg stop distance : {tr['stop_pts'].mean():.1f} pts  "
          f"(median {tr['stop_pts'].median():.1f})")

    # year-by-year stability (robustness, not a tuned number)
    tr["yr"] = tr["date"].str[:4]
    yr = tr.groupby("yr")["R"].agg(["count", "mean"])
    pos_years = (yr["mean"] > 0).sum()
    print(f"  year stability    : {pos_years}/{len(yr)} years net-positive gross R")
    print()

    print("=" * 68)
    print("MONTE CARLO — Apex 50K eval  (P over 20k sims, conservative trailing)")
    print("=" * 68)
    print(f"  target +${PROFIT_TARGET:.0f}  |  trailing ${ACCOUNT_DD:.0f} below peak  |  "
          f"timeout {MAX_DAYS}d\n")
    print(f"  {'risk/trade':>10} {'P(pass)':>9} {'P(bust)':>9} "
          f"{'P(timeout)':>11} {'med days':>9}")
    print("  " + "-" * 52)
    real_rows = []
    for r in RISK_SWEEP:
        res = monte_carlo(tr, r)
        real_rows.append(res)
        md = res["med_days"] if res["med_days"] else "-"
        print(f"  {'$'+str(r):>10} {res['p_pass']:>8.1%} {res['p_bust']:>8.1%} "
              f"{res['p_timeout']:>10.1%} {str(md):>9}")

    print("\n  ZERO-EDGE NULL (drift removed -> pure risk-of-ruin floor):")
    print(f"  {'risk/trade':>10} {'P(pass)':>9} {'P(bust)':>9} {'P(timeout)':>11}")
    print("  " + "-" * 42)
    for r in RISK_SWEEP:
        res = monte_carlo(tr, r, zero_edge=True)
        print(f"  {'$'+str(r):>10} {res['p_pass']:>8.1%} {res['p_bust']:>8.1%} "
              f"{res['p_timeout']:>10.1%}")

    # EV using the best real risk level by P(pass)
    best = max(real_rows, key=lambda x: x["p_pass"])
    print("\n" + "=" * 68)
    print("HONEST EV  (best risk level by P(pass))")
    print("=" * 68)
    p = best["p_pass"]
    # crude: assume conditional-on-pass we reach a first payout ~70% of the time
    p_payout = p * 0.70
    ev = p_payout * FIRST_PAYOUT - EVAL_COST - p * ACTIVATION_FEE
    print(f"  risk/trade chosen : ${best['risk']}   P(pass)={p:.1%}")
    print(f"  P(first payout)   : ~{p_payout:.1%}  (pass x ~70% survive-to-payout)")
    print(f"  E[$] per attempt  : {p_payout:.2%}*${FIRST_PAYOUT:.0f} "
          f"- ${EVAL_COST:.0f} - {p:.1%}*${ACTIVATION_FEE:.0f}  =  ${ev:+.0f}")
    print(f"\n  GATE: buy the eval only if P(pass) >= 60%. "
          f"Best here = {p:.1%} -> {'PASS gate' if p>=0.60 else 'FAILS gate'}.")


if __name__ == "__main__":
    main()

