        prices.loc[first:, c] = 100.0 * (1.0 + ret[c].loc[first:].fillna(0.0)).cumprod()
        carry.loc[first:, c]  = car[c].loc[first:].ffill()       # sparse carry -> ffill

    dates = ret.index.values.astype("datetime64[D]")
    names = list(keep)
    cov = {c: round(float(car[c].notna().mean()) * 100) for c in keep}
    print(f"[load_panel] source=futures_panel.parquet (Databento-derived; ratio back-adjusted from roll-adjusted fret)")
    print(f"[load_panel] kept {len(keep)}: {names}")
