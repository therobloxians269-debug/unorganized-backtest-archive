    m = lgb.LGBMRegressor(**PARAMS); m.fit(F[isx].to_numpy(np.float32), z[isx])
    e = sig[osx] * m.predict(F[osx].to_numpy(np.float32))
    yo, ti = y[osx], F.index[osx]
    g = np.abs(e) >= thr
    gp = pd.Series(np.where(e[g] > 0, yo[g], -yo[g]), index=ti[g])

    crisis = np.zeros(len(gp), bool)
    for a, b in CRISIS:
        crisis |= ((gp.index >= pd.Timestamp(a, tz="America/New_York")) &
                   (gp.index <= pd.Timestamp(b, tz="America/New_York")))
    print("=" * 84); print(f"HOLDOUT — SPENT NOW.  gate |E|>={thr:.2f}  toll={toll}")
    print("=" * 84)
    for lab, sub in (("FULL", gp), ("CRISIS-STRIPPED", gp[~crisis])):
        net = sub - toll
