def make(kind, seed=0):
    rng=np.random.default_rng(seed)
    if kind=='real':   return lambda d,e,t: e>=t
    if kind=='invert': return lambda d,e,t: e< t
    if kind=='coin':   return lambda d,e,t: rng.random()<0.5
    if kind=='trend':  return lambda d,e,t: True
    if kind=='mr':     return lambda d,e,t: False

