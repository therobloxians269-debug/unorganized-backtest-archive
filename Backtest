import pandas as pd, numpy as np, warnings; warnings.filterwarnings('ignore')
from vp import race, RTH_A, RTH_B

def eighty_pct(b, hold_min=30, stop_buf=0.25, max_hold=390, pv=20., comm=4., long_only=False):
    """Market-Profile 80% rule: open outside prior VA, re-enter and HOLD -> traverse to the far side."""
    out=[]
    for day,g in b.groupby('daycycle',sort=True):
        g=g[(g.minofday>=RTH_A)&(g.minofday<=RTH_B)]
        if len(g)<60: continue
        val,vah,po=g['p_val'].iloc[0],g['p_vah'].iloc[0],g['rth_open'].iloc[0]
        if not np.isfinite(val) or not np.isfinite(vah) or vah<=val: continue
        if val<=po<=vah: continue                      # must open OUTSIDE value
        d = 1 if po<val else -1
        c=g['c'].values; hh=g['h'].values; ll=g['l'].values
        inside=(c>=val)&(c<=vah)
        run=0; ent=None
        for k in range(len(g)):
            run = run+1 if inside[k] else 0
            if run>=hold_min: ent=k; break
        if ent is None or ent>=len(g)-5: continue
        ep=g['o'].values[ent+1] if ent+1<len(g) else c[ent]
        vaw=vah-val
        st = (val-stop_buf*vaw) if d==1 else (vah+stop_buf*vaw)
        tgt= vah if d==1 else val
        if (d==1 and (ep<=st or tgt<=ep)) or (d==-1 and (ep>=st or tgt>=ep)): continue
        if long_only and d!=1: continue
        i=b.index.get_loc(g.index[ent])
        r=race(b,i,d,ep,st,tgt,max_hold,pv=pv,comm=comm)
        r.update(t=g.index[ent],d=d,rr=abs(tgt-ep)/abs(st-ep)); out.append(r)
    return pd.DataFrame(out)

def vwap_fade(b, k=2.0, tgt_sig=0.0, stop_sig=1.0, max_hold=180, pv=20., comm=4., min_rr=0.0):
    """Fade at VWAP +/- k sigma back toward VWAP (tgt_sig sigma)."""
    m=b.minofday.values; c=b['c'].values; vw=b['vwap'].values; sd=b['vsd'].values
    day=b['daycycle'].values; out=[]; used=set(); n=len(b)
    for i in range(1,n-2):
        if not (RTH_A<=m[i]<=RTH_B-30) or not np.isfinite(sd[i]) or sd[i]<=0: continue
        up=c[i]>=vw[i]+k*sd[i] and c[i-1]<vw[i-1]+k*sd[i-1]
        dn=c[i]<=vw[i]-k*sd[i] and c[i-1]>vw[i-1]-k*sd[i-1]
        if not(up or dn): continue
        key=(day[i], 1 if up else -1)
        if key in used: continue
        used.add(key)
        d=-1 if up else 1
        ep=b['o'].values[i+1]
        st=vw[i]+(k+stop_sig)*sd[i] if d==-1 else vw[i]-(k+stop_sig)*sd[i]
        tgt=vw[i]+tgt_sig*sd[i] if d==-1 else vw[i]-tgt_sig*sd[i]
        risk=abs(st-ep)
        if risk<=0 or abs(tgt-ep)/risk<min_rr: continue
        r=race(b,i+1,d,ep,st,tgt,max_hold,pv=pv,comm=comm)
        r.update(t=b.index[i+1],d=d,rr=abs(tgt-ep)/risk); out.append(r)
    return pd.DataFrame(out)

def va_rotate(b, stop_buf=0.25, max_hold=300, pv=20., comm=4.):
    """Touch prior VAH from below -> short to POC ; touch prior VAL from above -> long to POC."""
    m=b.minofday.values; h=b['h'].values; l=b['l'].values
    vah=b['p_vah'].values; val=b['p_val'].values; poc=b['p_poc'].values
    day=b['daycycle'].values; out=[]; used=set(); n=len(b)
    for i in range(1,n-2):
        if not (RTH_A<=m[i]<=RTH_B-30): continue
        if not np.isfinite(vah[i]) or not np.isfinite(val[i]) or not np.isfinite(poc[i]): continue
        vaw=vah[i]-val[i]
        if vaw<=0: continue
        hitH = h[i]>=vah[i] and h[i-1]<vah[i]
        hitL = l[i]<=val[i] and l[i-1]>val[i]
        if not(hitH or hitL): continue
        key=(day[i], 1 if hitH else -1)
        if key in used: continue
        used.add(key)
        d=-1 if hitH else 1
        ep=b['o'].values[i+1]
        st=vah[i]+stop_buf*vaw if d==-1 else val[i]-stop_buf*vaw
        tgt=poc[i]
        risk=abs(st-ep)
        if risk<=0 or (d==-1 and tgt>=ep) or (d==1 and tgt<=ep): continue
        r=race(b,i+1,d,ep,st,tgt,max_hold,pv=pv,comm=comm)
        r.update(t=b.index[i+1],d=d,rr=abs(tgt-ep)/risk); out.append(r)
    return pd.DataFrame(out)

def vwap_pullback(b, tgt_sig=2.0, stop_sig=0.75, max_hold=240, pv=20., comm=4.):
    """Trend continuation: price above VWAP all session, pull back TO VWAP, go with the trend."""
    m=b.minofday.values; c=b['c'].values; l=b['l'].values; h=b['h'].values
    vw=b['vwap'].values; sd=b['vsd'].values; day=b['daycycle'].values
    out=[]; used=set(); n=len(b)
    for i in range(30,n-2):
        if not (RTH_A+60<=m[i]<=RTH_B-45) or not np.isfinite(sd[i]) or sd[i]<=0: continue
        above=c[i-30:i].min()>vw[i-30:i].min() and c[i]>=vw[i] and l[i]<=vw[i]
        below=c[i-30:i].max()<vw[i-30:i].max() and c[i]<=vw[i] and h[i]>=vw[i]
        if not(above or below): continue
        key=(day[i], 1 if above else -1)
        if key in used: continue
        used.add(key)
        d=1 if above else -1
        ep=b['o'].values[i+1]
        st=vw[i]-stop_sig*sd[i] if d==1 else vw[i]+stop_sig*sd[i]
        tgt=vw[i]+tgt_sig*sd[i] if d==1 else vw[i]-tgt_sig*sd[i]
        risk=abs(st-ep)
        if risk<=0: continue
        r=race(b,i+1,d,ep,st,tgt,max_hold,pv=pv,comm=comm)
        r.update(t=b.index[i+1],d=d,rr=abs(tgt-ep)/risk); out.append(r)
    return pd.DataFrame(out)

def ib_break(b, ext=1.0, max_hold=300, pv=20., comm=4.):
    """Initial-balance breakout after 10:30, target = IB width extension, stop back inside."""
    m=b.minofday.values; h=b['h'].values; l=b['l'].values
    ibh=b['ibh'].values; ibl=b['ibl'].values; day=b['daycycle'].values
    out=[]; used=set(); n=len(b)
    for i in range(1,n-2):
        if not (RTH_A+60<=m[i]<=RTH_B-45): continue
        if not np.isfinite(ibh[i]) or not np.isfinite(ibl[i]): continue
        w=ibh[i]-ibl[i]
        if w<=0: continue
        up=h[i]>ibh[i] and h[i-1]<=ibh[i]
        dn=l[i]<ibl[i] and l[i-1]>=ibl[i]
        if not(up or dn): continue
        key=(day[i], 1 if up else -1)
        if key in used: continue
        used.add(key)
        d=1 if up else -1
        ep=b['o'].values[i+1]
        st=ibl[i]+0.5*w if d==1 else ibh[i]-0.5*w
        tgt=ibh[i]+ext*w if d==1 else ibl[i]-ext*w
        risk=abs(st-ep)
        if risk<=0: continue
        r=race(b,i+1,d,ep,st,tgt,max_hold,pv=pv,comm=comm)
        r.update(t=b.index[i+1],d=d,rr=abs(tgt-ep)/risk); out.append(r)
    return pd.DataFrame(out)

