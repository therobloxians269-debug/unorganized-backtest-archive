def dirshuffle_sig(sig, seed):
    """Keep reactive's ENTRY BARS exactly, keep the long/short proportion
    exactly, destroy only the ROUTING.  The sharpest possible test of 'does the
    state machine know which way to take the trigger?'"""
    rng = np.random.default_rng(seed)
    out = np.zeros_like(sig)
    pos = np.nonzero(sig)[0]
    vals = sig[pos].copy()
    rng.shuffle(vals)
    out[pos] = vals
    return out


@njit(cache=True)
def _markov_state(n, dc, p_stay, occ_cum, seed):
    """2/3-state chain with a target stationary occupancy, resampled per day."""
    np.random.seed(seed)
    out = np.zeros(n, np.int8)
    cur = np.int8(0)
    for t in range(n):
        if t == 0 or dc[t] != dc[t - 1]:
            cur = np.int8(0)
        if np.random.random() > p_stay:
            u = np.random.random()
            if u < occ_cum[0]:
                cur = np.int8(0)
            elif u < occ_cum[1]:
                cur = np.int8(1)
            else:
                cur = np.int8(-1)
        out[t] = cur
    return out


def decompose(F, d, cfg, pv, comm_pts, comm, ndays, split):
    """avgR in each (state at trigger) x (direction taken) cell."""
    trig = F.trigB(cfg["span"], cfg["z"])
    er, sg = F.er(cfg["K"])
    st = _state_machine(er, d["sess"], d["dc"], cfg["hi"], cfg["lo"])
    rows = []
    for sname, sval in (("TREND", 1), ("MR", -1), ("NEUTRAL", 0)):
        for dname, mult in (("continuation", 1), ("fade", -1)):
            sig = np.zeros(d["n"], np.int8)
            m = (st == sval)
            sig[m] = (mult * trig[m]).astype(np.int8)
            sig = make_sig(np.where(m, sval, 99).astype(np.int8),
                           (mult * trig).astype(np.int8), 1, cfg["cool"], d["n"]) \
                if False else sig
            # apply cooldown manually via _route mode 1 on a masked trigger
            tt = np.where(m, mult * trig, 0).astype(np.int8)
            out = np.zeros(d["n"], np.int8)
            _route(np.ones(d["n"], np.int8), tt, 1, cfg["cool"], out)
            r = run_sig(out, d, cfg, comm_pts, pv, comm, ndays,
                        f"{split} {sname}/{dname}")
            longfrac = float(np.mean(np.array([1.0])))
            rows.append(dict(split=split, state=sname, dirn=dname, n=r["n"],
                             avgR=r["avgR"], drop3=r["drop3"], dpt=r["dpt"],
                             t=r["t"]))
    return pd.DataFrame(rows)


