"""
THE MULTI-APEX STRUCTURE: ramp from starting capital -> a portfolio of funded accounts.
Month-by-month expected-value model + the honest correlated-bust risk (all accounts run the
SAME signal, so a bad strategy year busts many at once -> lumpy income).

    python3 apex_business.py
"""
from __future__ import annotations
import numpy as np
from apex_sim import trend_returns, TRAIL

# ---- approximate Apex params (VERIFY current pricing/rules) ----
EVAL_FEE = 50.0       # frequent-sale price (list ~$150)
ACTIVATION = 130.0    # one-time on pass
PASS = 0.73           # eval pass at ~9% vol + loss-limit
EVAL_MONTHS = 3       # ~67 trading-day median to pass
MAX_ACCT = 20         # Apex cap
RESERVE = 200.0       # cash buffer kept

# funded account at ~7% vol: ~$3,600/yr kept = $300/mo, ~83%/yr survival = ~1.5%/mo bust
INC_MO = 300.0
BUST_MO = 0.015


def ramp(start, bust_mo, inc_mo, months=24, label=""):
    cash, funded, pipeline = start, 0.0, [0.0] * EVAL_MONTHS
    realized = 0.0
    BUST_MO, INC_MO = bust_mo, inc_mo
    print(f"\n  START ${start:,.0f} [{label}]  (eval ${EVAL_FEE:.0f}, activ ${ACTIVATION:.0f}, "
          f"pass {PASS*100:.0f}%, bust {(1-(1-bust_mo)**12)*100:.0f}%/yr, ${inc_mo:.0f}/mo/acct)")
    print(f"    {'mo':>3} {'funded':>7} {'evaluating':>10} {'mo income':>10} {'cum profit':>11} {'cash':>8}")
    for m in range(1, months + 1):
        matured = pipeline.pop(0); pipeline.append(0.0)
        newf = matured * PASS
        funded = min(funded + newf, MAX_ACCT)
        cash -= newf * ACTIVATION
        income = funded * INC_MO
        cash += income; realized += income
        funded *= (1 - BUST_MO)
        slots = max(0, MAX_ACCT - funded - sum(pipeline))
        afford = max(0.0, (cash - RESERVE)) / EVAL_FEE
        buy = min(afford, slots, 6)                    # cap ~6 new evals/mo (realistic)
        cash -= buy * EVAL_FEE; realized -= buy * EVAL_FEE
        pipeline[-1] += buy
        if m % 3 == 0 or m == 1:
            print(f"    {m:3d} {funded:7.1f} {sum(pipeline):10.1f} ${income:8,.0f} "
                  f"${realized:9,.0f} ${cash:6,.0f}")
    print(f"    -> steady ~{funded:.0f} funded accts, ~${funded*INC_MO:,.0f}/mo "
          f"(~${funded*INC_MO*12:,.0f}/yr), cum net ${realized:,.0f}")


def breach_by_vol():
    """Honest survival: ACTUAL historical sequence (not bootstrap), new account from $50k.
    A new account must climb +$2,600 to LOCK the trail; until then the tight 5% trail bites."""
    net = trend_returns()
    z = (net / net.std()).values
    print(f"\n  HONEST SURVIVAL (actual sequence, new account, $2,500 trail = 5% of $50k):")
    print(f"    {'vol':>5} {'1yr-breach%':>11} {'~ann kept/acct':>15}")
    out = {}
    for v in (0.03, 0.04, 0.05, 0.07):
        sd = v * 50_000 / np.sqrt(252)
        pnl = z * sd
        br = wins = 0
        for i in range(0, len(pnl) - 252, 21):
            eq = 50_000 + np.cumsum(pnl[i:i + 252])
            if (eq - np.maximum.accumulate(eq)).min() <= -TRAIL:
                br += 1
            wins += 1
        breach = br / wins
        kept = 0.9 * (0.49 * v) * 50_000 * (1 - breach)         # Sharpe~0.49 * vol, survival-weighted
        out[v] = (breach, kept)
        print(f"    {v*100:4.0f}% {breach*100:10.0f}% ${kept:13,.0f}")
    return out


def main():
    print("=== OPTIMISTIC ramp (my earlier too-low 17%/yr bust) -- for contrast only ===")
    ramp(2000, BUST_MO, INC_MO, label="optimistic")
    bv = breach_by_vol()
    # realistic: pick 4% vol, bust = its actual 1yr breach, income = its kept/acct/12
    v = 0.04
    breach, kept = bv[v]
    bust_mo = 1 - (1 - breach) ** (1 / 12)
    print(f"\n=== REALISTIC ramp (4% vol, actual {breach*100:.0f}%/yr bust) ===")
    ramp(2000, bust_mo, kept / 12, label="realistic")
    print(f"\n  THE CATCH: $2,500 trail = only 5% DD. A 0.5-Sharpe strat breaches that most years")
    print(f"  unless run at VERY low vol -- and all accounts share the signal, so busts CLUSTER.")
    print(f"  Honest read: multi-Apex income is real but FAR below the rosy figure, and lumpy.")


if __name__ == "__main__":
    main()

