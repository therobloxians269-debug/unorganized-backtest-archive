#!/usr/bin/env python3
"""
onchain_stables.py -- HYPOTHESIS 1: stablecoin supply growth leads BTC/ETH demand.
(verbatim per spec; logic unchanged)
"""
from __future__ import annotations
import sys, math
import numpy as np
from scipy.stats import skew as sk, kurtosis as ku, norm, ttest_1samp, linregress

ANN = math.sqrt(365)   # crypto trades 365d/yr

# ---------- atoms ----------
def sharpe(x):
    x = x[np.isfinite(x)]
    return x.mean()/x.std(ddof=1)*ANN if len(x) > 1 and x.std() > 0 else 0.0

def calmar(x):
    x = x[np.isfinite(x)]; eq = np.cumsum(x)
    dd = (eq - np.maximum.accumulate(eq)).min()
    return (x.mean()*365)/abs(dd) if dd < 0 else float('inf')

def maxdd(x):
    x = x[np.isfinite(x)]; eq = np.cumsum(x)
    return (eq - np.maximum.accumulate(eq)).min()

# ---------- signal & strategy ----------
def signal(supply, k=14, w=90, C=2.0, mode='ls'):
    s = np.asarray(supply, float)
    g = np.full_like(s, np.nan)
    g[k:] = np.log(s[k:]/s[:-k])
    z = np.full_like(g, np.nan)
    for t in range(len(g)):
        lo = max(0, t-w+1); win = g[lo:t+1]; win = win[np.isfinite(win)]
        if len(win) > 5 and win.std() > 0:
            z[t] = (g[t]-win.mean())/win.std()
    if mode == 'ls':
        e = np.clip(z, -C, C)/C
    else:                       # long/flat
        e = np.clip(z, 0, C)/C
    return np.nan_to_num(e, nan=0.0)

def strat(e, asset_ret, cost_bps=3.0):
    e = np.asarray(e, float); r = np.asarray(asset_ret, float)
    pos = np.roll(e, 1); pos[0] = 0.0                       # lag: trade on yesterday's signal
    turn = np.abs(np.diff(pos, prepend=0.0))
    gross = pos*r
    net = gross - turn*(cost_bps*1e-4)
    return net, gross, turn.mean()

def alpha_beta(R, asset_ret):
    """R_t = alpha + beta r^BTC_t. Return annualized alpha, its t-stat, beta."""
    m = np.isfinite(R) & np.isfinite(asset_ret)
    if m.sum() < 30: return 0.0, 0.0, 0.0
    lr = linregress(asset_ret[m], R[m])
    alpha_ann = lr.intercept*365
    n = m.sum(); resid_sd = np.std(R[m]-(lr.slope*asset_ret[m]+lr.intercept), ddof=2)
    se_int = resid_sd*math.sqrt(1/n + asset_ret[m].mean()**2/np.sum((asset_ret[m]-asset_ret[m].mean())**2))
    t = lr.intercept/se_int if se_int > 0 else 0.0
    return float(alpha_ann), float(t), float(lr.slope)

# ---------- gate components (asset-agnostic, reused from validate.py) ----------
def direct_test(port, split):
    IS, OOS = port[:split], port[split:]
    tI = ttest_1samp(IS[np.isfinite(IS)], 0); tO = ttest_1samp(OOS[np.isfinite(OOS)], 0)
    return dict(ISs=sharpe(IS), ISt=float(tI.statistic), OOSs=sharpe(OOS), OOSt=float(tO.statistic))

def walk_forward(port, k=6, embargo=5):
    n = len(port); seg = n//k; out = []
    for i in range(k):
        a = i*seg+(embargo if i > 0 else 0); b = (i+1)*seg if i < k-1 else n
        out.append(sharpe(port[a:b]))
    return out

def block_bootstrap(port, block=20, n=1000, seed=0):
    p = port[np.isfinite(port)]; n_obs = len(p)
    if n_obs < block*2: return 0.0, 0.0
    rng = np.random.default_rng(seed); nb = int(np.ceil(n_obs/block)); sh = np.empty(n)
    for i in range(n):
        st = rng.integers(0, n_obs, nb)
        idx = (st[:, None]+np.arange(block)[None, :]).ravel()[:n_obs] % n_obs
        sh[i] = sharpe(p[idx])
    return float(np.percentile(sh, 5)), float(np.percentile(sh, 95))

def dsr(port, n_trials):
    p = port[np.isfinite(port)]; sd = p.std(ddof=1); srd = p.mean()/sd if sd > 0 else 0
    emax = (1-np.euler_gamma)*norm.ppf(1-1/n_trials)+np.euler_gamma*norm.ppf(1-1/(n_trials*math.e))
    sr0 = emax/math.sqrt(len(p))
    den = math.sqrt(max(1e-9, 1-float(sk(p))*srd+(float(ku(p, fisher=False))-1)/4*srd**2))
    return float(norm.cdf((srd-sr0)*math.sqrt(len(p)-1)/den))

def param_neighborhood(supply, ret, base_k=14, mode='ls', cost_bps=3.0):
    out = {}
    for k in sorted({max(3, int(base_k*(1+f))) for f in (-.5, -.25, 0, .5, 1.0)}):
        net, _, _ = strat(signal(supply, k=k, mode=mode), ret, cost_bps)
        out[k] = sharpe(net)
    return out

def regime_slices(port, bounds):
    return {k: sharpe(port[lo:hi]) for k, (lo, hi) in bounds.items()}

# ---------- the gate ----------
def gate(supply, btc_ret, *, name, n_trials, split=None, mode='ls',
         bar=0.7, cost_bps=3.0, regimes=None):
    e = signal(supply, mode=mode)
    net, gross, turn = strat(e, btc_ret, cost_bps)
    if split is None: split = int(len(net)*0.65)
    a_ann, a_t, beta = alpha_beta(net, btc_ret)
    bh = btc_ret.copy()                                   # buy & hold benchmark
    print(f"\n===== ON-CHAIN GATE: {name}   (bar: net Sharpe >= {bar}, mode={mode}) =====")
    print(f"  full     gross Sh={sharpe(gross):.2f}  NET Sh={sharpe(net):.2f}  Calmar={calmar(net):.2f}  turn={turn:.3f}/d")
    print(f"  vs B&H   strat Calmar={calmar(net):.2f}  BTC-B&H Calmar={calmar(bh):.2f}  strat maxDD={maxdd(net):.3f}  B&H maxDD={maxdd(bh):.3f}")
    print(f"  ALPHA    beta-neutral alpha={a_ann:+.3f}/yr  t={a_t:.1f}  (beta to BTC={beta:+.2f})   <-- the one that matters")
    dt = direct_test(net, split)
    print(f"  matched  IS Sh={dt['ISs']:.2f}(t={dt['ISt']:.1f})   OOS Sh={dt['OOSs']:.2f}(t={dt['OOSt']:.1f})")
    wf = walk_forward(net); print(f"  walkfwd  {[round(x,2) for x in wf]}")
    print(f"  paramN   {{{', '.join(f'{k}:{v:.2f}' for k,v in param_neighborhood(supply, btc_ret, mode=mode, cost_bps=cost_bps).items())}}}")
    if regimes: print(f"  regimes  {{{', '.join(f'{k}:{v:.2f}' for k,v in regime_slices(net, regimes).items())}}}")
    lo, hi = block_bootstrap(net); print(f"  bootCI   90% Sharpe [{lo:.2f}, {hi:.2f}]")
    d = dsr(net, n_trials); print(f"  DSR      N={n_trials} -> {d:.2f}")
    ok = (sharpe(net) >= bar and a_t > 1.5 and calmar(net) > calmar(bh)
          and lo > 0 and d > 0.9 and dt['OOSt'] > 1.5)
    print(f"  VERDICT  {'PASS - real alpha beyond beta' if ok else 'FAIL - does not clear the bar'}")
    return ok

# ---------- synthetic self-test: 3 controls ----------
def _ar_supply(T, rng, persistence=0.97, drift=0.0008, shock=0.01):
    """A plausible stablecoin-supply path: persistent growth with shocks (always >0)."""
    g = np.zeros(T)
    for t in range(1, T):
        g[t] = persistence*g[t-1] + rng.normal(drift, shock)
    return 1e10*np.exp(np.cumsum(g)), g   # level, and the latent daily growth

def make_synth(mode, T=2200, rng=None):
    rng = rng or np.random.default_rng(0)
    S, g = _ar_supply(T, rng)
    gk = np.zeros(T); k = 14
    gk[k:] = np.log(S[k:]/S[:-k])
    gz = (gk-np.nanmean(gk))/(np.nanstd(gk)+1e-12)
    if mode == 'lead':
        btc = 0.9*np.roll(gz, 1)*0.02 + rng.normal(0, 0.03, T)
    elif mode == 'noise':
        btc = rng.normal(0.0008, 0.03, T)
    elif mode == 'beta_trap':
        btc = rng.normal(0.0020, 0.03, T)
        S = 1e10*np.exp(np.cumsum(rng.normal(0.0008, 0.01, T)))  # decoupled noise supply
    else:
        raise ValueError(mode)
    return S, btc

if __name__ == "__main__":
    if len(sys.argv) > 1:
        import pandas as pd
        df = pd.read_parquet(sys.argv[1]).sort_values('date').reset_index(drop=True)
        S = df['stable_supply'].to_numpy(float)
        btc = np.r_[0.0, np.diff(np.log(df['btc'].to_numpy(float)))]
        yrs = pd.to_datetime(df['date']).dt.year.to_numpy()
        regs = {str(y): (int(np.argmax(yrs == y)), int(len(yrs)-np.argmax(yrs[::-1] == y)))
                for y in sorted(set(yrs))}
        gate(S, btc, name=f"stablecoin->BTC [{df.date.min()}..{df.date.max()}]",
             n_trials=16, mode='ls', regimes=regs)
        gate(S, btc, name="stablecoin->BTC (long/flat variant)", n_trials=16, mode='lo', regimes=regs)
        sys.exit(0)

    rng = np.random.default_rng(7)
    print("### CONTROL 1: supply genuinely LEADS btc  -> gate must PASS (real alpha)")
    S, b = make_synth('lead', rng=rng); gate(S, b, name="synth-lead", n_trials=16, mode='ls')
    print("\n### CONTROL 2: supply INDEPENDENT of btc -> gate must FAIL (no edge)")
    S, b = make_synth('noise', rng=rng); gate(S, b, name="synth-noise", n_trials=16, mode='ls')
    print("\n### CONTROL 3: disguised BETA (noise signal, long-only, bull drift) -> gate must FAIL on alpha")
    S, b = make_synth('beta_trap', rng=rng); gate(S, b, name="synth-beta-trap", n_trials=16, mode='lo')

