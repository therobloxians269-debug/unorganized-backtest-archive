"""
THE HANDOFF — our concept. Readable, one trade a day, exogenous entry time.

THE READ
    "Overnight ran 40 points on almost no volume. Nobody real bought that.
     RTH is going to make them prove it."

MECHANISM (real, not a pattern)
    Globex overnight is thin. A modest amount of size walks price a long way because
    there is nothing resting to stop it. Whatever inventory gets built there has to be
    handed off to RTH participants at real size the next morning. So:

      big overnight move on LITTLE volume  -> prices were never validated by real
                                              liquidity -> RTH re-auctions them (FADE)
      big overnight move on HEAVY volume   -> real participation, prices were paid
                                              for -> RTH accepts them (GO WITH)

    The signal is MOVE PER UNIT OF LIQUIDITY, not the move. That is the whole idea.

WHY IT IS IMMUNE TO WHAT KILLED THE OTHERS
    Entry time is 09:30, fixed by the clock. We never scan the session looking for a
    moment that "looks right" — that act of selection is what destroyed TERMINUS
    (p 0.876 -> 0.470 on fill) and the VWAP lean (z+197 -> negative when committed).
    Here the calendar picks the time and price only picks the side. Nothing to corrupt.
    It also fires EVERY session, so frequency is 1.00/day by construction.

EVERYTHING BELOW IS KNOWN AT 09:29:59.
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')

RTH0, RTH1 = 570, 960


def signals(day, rb, vol_win=20):
    """One row per session. Every column causal as of the 09:30 open."""
    d = day.copy()
    # trailing norms, shifted so today is never in its own denominator
    d['onV_ma'] = d.onV.shift(1).rolling(vol_win, min_periods=10).mean()
    d['onV_n'] = d.onV / d.onV_ma
    d['rvol_ma'] = d.rvol.shift(1).rolling(vol_win, min_periods=10).mean()

    A = d.ADR
    d['on_move'] = (d.o930 - d.prevC) / A            # the overnight net move
    d['on_rng'] = (d.onH - d.onL) / A                # how far it travelled
    d['on_absmove'] = d.on_move.abs()

    # THE SIGNAL: travel per unit of liquidity. High = a lot of price for very
    # little volume = unvalidated inventory.
    d['eff'] = d.on_absmove / d.onV_n.clip(lower=0.05)
    d['eff_rng'] = d.on_rng / d.onV_n.clip(lower=0.05)
    # how efficient was the move WITHIN the overnight range (directional conviction)
    d['on_dir'] = np.sign(d.on_move)
    d['on_conv'] = d.on_move.abs() / d.on_rng.clip(lower=1e-6)

    # forward: the RTH session, from the 09:30 open
    d['rth_ret'] = (d.cl - d.o930) / A
    # signed so + = the overnight move was FADED
    d['fade_y'] = -d.on_dir * d.rth_ret
    d = d.dropna(subset=['onV_n', 'on_move', 'eff', 'rth_ret'])
    return d[d.onV_ma > 0]


def add_paths(d, rb):
    """Intraday path columns for exits: MFE/MAE of the fade, and timed returns."""
    mfe, mae, r60, r120, hh, ll = [], [], [], [], [], []
    for dd, row in d.iterrows():
        b = rb.get(dd)
        if b is None:
            mfe.append(np.nan); mae.append(np.nan); r60.append(np.nan)
            r120.append(np.nan); hh.append(np.nan); ll.append(np.nan)
            continue
        C, H, L = b['C'], b['H'], b['L']
        o = float(row.o930); A = float(row.ADR); sgn = -float(row.on_dir)
        if sgn > 0:
            mfe.append((float(H.max()) - o) / A); mae.append((o - float(L.min())) / A)
        else:
            mfe.append((o - float(L.min())) / A); mae.append((float(H.max()) - o) / A)
        r60.append(sgn * (float(C[min(60, len(C) - 1)]) - o) / A)
        r120.append(sgn * (float(C[min(120, len(C) - 1)]) - o) / A)
        hh.append((float(H.max()) - o) / A); ll.append((o - float(L.min())) / A)
    d = d.copy()
    d['mfe'] = mfe; d['mae'] = mae; d['y60'] = r60; d['y120'] = r120
    d['up_ext'] = hh; d['dn_ext'] = ll
    return d


def dayt(x):
    """Mean and t. Sessions are already the unit here — one row per session."""
    x = np.asarray(x, dtype=float)
    x = x[np.isfinite(x)]
    if len(x) < 20:
        return np.nan, np.nan, len(x)
    return float(x.mean()), float(x.mean() / (x.std(ddof=1) / np.sqrt(len(x)))), len(x)


def deciles(d, by='eff', col='fade_y', q=5, label=''):
    g = d.dropna(subset=[by, col]).copy()
    g['b'] = pd.qcut(g[by], q, labels=False, duplicates='drop')
    print(f'\n  {label}  ({by} quantiles -> {col}; + means the overnight move was faded)')
    print(f'    {"bucket":<8}{"n":>6}{"med "+by:>12}{"mean":>10}{"t":>8}{"win%":>8}')
    rows = []
    for i in sorted(g.b.dropna().unique()):
        s = g[g.b == i]
        mu, t, n = dayt(s[col])
        rows.append((i, n, mu, t))
        print(f'    Q{int(i)+1:<7}{n:>6}{s[by].median():>12.3f}{mu:>+10.4f}{t:>+8.2f}'
              f'{(s[col] > 0).mean():>8.1%}')
    return rows


def trade(d, which, mode='fade', eff_thr=None, eff_q=None, stop_adr=None,
          target_adr=None, rb=None):
    """
    One trade per session at the 09:30 open. mode 'fade' sells an overnight rally,
    'go' buys it. Exit at the RTH close unless a stop/target is given, in which case
    the 1m path decides (race starts at bar 1, never the entry bar).
    """
    import sim as S
    cost = S.COST_PTS[which]; pv = S.PT_VALUE[which]
    g = d.copy()
    if eff_q is not None:
        g = g[g.eff >= g.eff.quantile(eff_q)]
    if eff_thr is not None:
        g = g[g.eff >= eff_thr]
    out = []
    for dd, row in g.iterrows():
        sgn = -float(row.on_dir) if mode == 'fade' else float(row.on_dir)
        if sgn == 0:
            continue
        A = float(row.ADR); o = float(row.o930)
        if stop_adr is None:
            pts = sgn * (float(row.cl) - o) - cost
            oc = 'close'
        else:
            b = rb[dd]; H, L, C = b['H'], b['L'], b['C']
            stop = o - sgn * stop_adr * A
            tgt = o + sgn * target_adr * A if target_adr else None
            Hs, Ls = H[1:], L[1:]
            xi = np.flatnonzero(Ls <= stop) if sgn > 0 else np.flatnonzero(Hs >= stop)
            xi = xi[0] if len(xi) else 10 ** 9
            if tgt is not None:
                ti = np.flatnonzero(Hs >= tgt) if sgn > 0 else np.flatnonzero(Ls <= tgt)
                ti = ti[0] if len(ti) else 10 ** 9
            else:
                ti = 10 ** 9
            if ti < xi:
                pts, oc = sgn * (tgt - o), 'win'
            elif xi < ti:
                pts, oc = sgn * (stop - o), 'loss'
            elif xi == ti and xi < 10 ** 9:
                pts, oc = sgn * (stop - o), 'ambig'
            else:
                pts, oc = sgn * (float(C[-1]) - o), 'close'
            pts -= cost
        R = stop_adr * A if stop_adr else 0.25 * A
        out.append(dict(day=dd, side='long' if sgn > 0 else 'short', eff=row.eff,
                        on_move=row.on_move, outcome=oc, pts=pts, usd=pts * pv,
                        R=R, Rmult=pts / R, ADR=A))
    return pd.DataFrame(out)


def show(t, label, nd):
    if not len(t):
        print(f'  {label:<28} n=0'); return None
    mu, tt, n = dayt(t.pts)
    print(f'  {label:<28} n={n:>5}  {n/nd:.2f}/day  {mu:>+7.3f} pts  t {tt:>+6.2f}  '
          f'WR {(t.pts > 0).mean():>5.1%}  ${t.usd.mean():>+7.2f}/tr  '
          f'${t.usd.sum():>+9.0f}')
    return tt

