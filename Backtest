def placebo_sig(sig, ts, seed, lo=120, hi=1440):
    """random-time placebo: every entry time shifted forward by U(120,1440) min.
    Same direction, same downstream logic (risk recomputed from that bar's ATR,
    same rr / maxhold / forced-exit)."""
    rng = np.random.default_rng(seed)
    pos = np.nonzero(sig)[0]
    if len(pos) == 0:
        return sig.copy()
    delta = rng.integers(lo, hi + 1, size=len(pos))
    newpos = np.searchsorted(ts, ts[pos] + delta, side="left")
    out = np.zeros_like(sig)
    for p, s in zip(newpos, sig[pos]):
        if p < len(out) and out[p] == 0:
            out[p] = s
    return out


def run_sig(sig, d, cfg, comm_pts, pv, comm, ndays, label):
    risk = cfg["s"] * d[cfg["atr"]]
    e_i, x_i, dr, nr, npts, why = simulate(sig.astype(np.int8), d["o"], d["h"], d["l"],
                                           d["c"], risk, d["fe"], cfg["mh"], cfg["rr"],
                                           SLIP, comm_pts, 5)
    s = stats(e_i, x_i, dr, nr, npts, why, d, pv, comm, ndays, label)
    s["_nr"] = nr
    s["_e"] = e_i
    return s


def state_diag(st, sess, dc):
    n = len(st)
    occ = {"NEUTRAL": float(np.mean(st == 0)), "TREND": float(np.mean(st == 1)),
           "MR": float(np.mean(st == -1))}
    sw = int(np.sum(st[1:] != st[:-1]))
    return occ, sw, sw / max(1, len(np.unique(dc)))


def headline(F, d, cfg, pv, comm_pts, comm, ndays, split, nseed=8, verbose=True):
    """THE decisive comparison.  Same trigger set everywhere; only the direction
    routing changes."""
    trig = F.trigA(cfg["K2"]) if cfg["trig"] == "A" else F.trigB(cfg["span"], cfg["z"])
    er, sg = F.er(cfg["K"])
    st = _state_machine(er, d["sess"], d["dc"], cfg["hi"], cfg["lo"])
    occ, sw, swpd = state_diag(st, d["sess"], d["dc"])
    res = {}
    modes = [(0, "REACTIVE (adaptive)"), (1, "always-TREND (all trig)"),
             (2, "always-MR (all trig)"), (3, "always-TREND (reactive bars)"),
             (4, "always-MR (reactive bars)")]
    for m, nm in modes:
        sig = make_sig(st, trig, m, cfg["cool"], d["n"])
        res[nm] = run_sig(sig, d, cfg, comm_pts, pv, comm, ndays, f"{split} {nm}")

    # ---- random switching, SAME switch frequency / occupancy / run-lengths ---
    rs = []
    for sd in range(nseed):
        rng = np.random.default_rng(1000 + sd)
        offs = rng.integers(1, 100000, size=4096).astype(np.int64)
        st_r = _rotate_state_within_day(st.astype(np.int8), d["dc"], offs)
        sig = make_sig(st_r, trig, 0, cfg["cool"], d["n"])
        rs.append(run_sig(sig, d, cfg, comm_pts, pv, comm, ndays, f"{split} rot{sd}"))
    res["RANDOM-SWITCH (rotated state)"] = dict(
        label=f"{split} RANDOM-SWITCH (rotated)",
        n=int(np.mean([r["n"] for r in rs])),
        avgR=float(np.mean([r["avgR"] for r in rs])),
        drop3=float(np.mean([r["drop3"] for r in rs])),
        tpd=float(np.mean([r["tpd"] for r in rs])),
        dpt=float(np.mean([r["dpt"] for r in rs])),
        win=float(np.mean([r["win"] for r in rs])),
        tot=float(np.mean([r["tot"] for r in rs])),
        maxdd_micro=float(np.mean([r["maxdd_micro"] for r in rs])),
        t=float(np.mean([r["t"] for r in rs])),
        _sd=float(np.std([r["avgR"] for r in rs], ddof=1)),
        _all=[r["avgR"] for r in rs])

    # ---- random-time placebo (mandated) -------------------------------------
    sig0 = make_sig(st, trig, 0, cfg["cool"], d["n"])
    pl = []
    for sd in range(nseed):
        ps = placebo_sig(sig0, d["ts"], 500 + sd)
        pl.append(run_sig(ps, d, cfg, comm_pts, pv, comm, ndays, f"{split} plc{sd}"))
    res["PLACEBO (time-shifted entries)"] = dict(
        label=f"{split} PLACEBO time-shift",
        n=int(np.mean([r["n"] for r in pl])),
        avgR=float(np.mean([r["avgR"] for r in pl])),
        drop3=float(np.mean([r["drop3"] for r in pl])),
        tpd=float(np.mean([r["tpd"] for r in pl])),
        dpt=float(np.mean([r["dpt"] for r in pl])),
        win=float(np.mean([r["win"] for r in pl])),
        tot=float(np.mean([r["tot"] for r in pl])),
        maxdd_micro=float(np.mean([r["maxdd_micro"] for r in pl])),
        t=float(np.mean([r["t"] for r in pl])),
        _sd=float(np.std([r["avgR"] for r in pl], ddof=1)),
        _all=[r["avgR"] for r in pl])

    if verbose:
        print(f"\n--- {split} --- cfg={ {k:v for k,v in cfg.items() if k not in ('atr',)} }")
        print(f"    state occupancy NEUTRAL {occ['NEUTRAL']*100:.1f}% / "
              f"TREND {occ['TREND']*100:.1f}% / MR {occ['MR']*100:.1f}% ; "
              f"{swpd:.1f} state switches per day-cycle")
        for k in ["REACTIVE (adaptive)", "always-TREND (all trig)", "always-MR (all trig)",
                  "always-TREND (reactive bars)", "always-MR (reactive bars)",
                  "RANDOM-SWITCH (rotated state)", "PLACEBO (time-shifted entries)"]:
            print("   ", fmt(res[k]))
        r = res["REACTIVE (adaptive)"]["avgR"]
        print(f"    >>> reactive - always_trend  = {r - res['always-TREND (all trig)']['avgR']:+.4f}")
        print(f"    >>> reactive - always_MR     = {r - res['always-MR (all trig)']['avgR']:+.4f}")
        print(f"    >>> reactive - random_switch = {r - res['RANDOM-SWITCH (rotated state)']['avgR']:+.4f} "
              f"(rot sd {res['RANDOM-SWITCH (rotated state)']['_sd']:.4f}, "
              f"z={(r - res['RANDOM-SWITCH (rotated state)']['avgR'])/max(1e-9,res['RANDOM-SWITCH (rotated state)']['_sd']):+.2f})")
        print(f"    >>> reactive - placebo       = {r - res['PLACEBO (time-shifted entries)']['avgR']:+.4f} "
              f"(plc sd {res['PLACEBO (time-shifted entries)']['_sd']:.4f})")
    res["_occ"] = occ
    res["_swpd"] = swpd
    return res


