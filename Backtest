gb = P.groupby(['session','slot'])
b = pd.DataFrame({
    'eo': gb['es_open'].first(), 'eh': gb['es_high'].max(), 'el': gb['es_low'].min(),
    'ec': gb['es_close'].last(), 'ev': gb['es_volume'].sum(),
    'yc': gb['ym_close'].last(),
}).reset_index().sort_values(['session','slot']).reset_index(drop=True)

o,hh,ll,c,v,y_c = (b[k].to_numpy() for k in ('eo','eh','el','ec','ev','yc'))
sess = b['session'].to_numpy(); slot = b['slot'].to_numpy(); n = len(b)

# daily context (lagged)
g = b.groupby('session')
dcl = g['ec'].last(); dhi = g['eh'].max(); dlo = g['el'].min()
d_atr = (dhi-dlo).rolling(20).mean(); d_ma200 = dcl.rolling(200).mean()
def lag(s): return s.shift(1).reindex(b['session']).to_numpy()
A = lag(d_atr); MA = lag((dcl-d_ma200)/d_atr); PDC = lag(dcl)
ycl = g['yc'].last(); YR1 = lag(ycl.pct_change())

def pret(x,k):
    r = np.full(n, np.nan); r[k:] = x[k:]/x[:-k]-1.0
    sd = np.empty(n, dtype=object); sd[:] = sess
    r[np.where(sd != np.roll(sd,k))[0]] = np.nan   # don't cross sessions
    return r
E1,E2,E4 = pret(c,1),pret(c,2),pret(c,4)
Y1,Y2,Y4 = pret(y_c,1),pret(y_c,2),pret(y_c,4)

day_open = np.full(n,np.nan); cur=None
for i in range(n):
    if cur != sess[i]: cur=sess[i]; _o=o[i]
    day_open[i]=_o

X = pd.DataFrame({
 'e1':E1,'e2':E2,'e4':E4,
 'y1':Y1,'y2':Y2,'y4':Y4,
 'sp1':E1-Y1,'sp2':E2-Y2,'sp4':E4-Y4,      # ES-YM relative strength (lead-lag)
 'ylead':Y1-E1,'yd':YR1,
 'ret_open':(c-day_open)/A,'gap':(day_open-PDC)/A,'ma200':MA,
 'slot':slot.astype(float),
})

years = pd.Series(pd.to_datetime(sess)).dt.year.to_numpy()
last_of = {}
for i in range(n): last_of[sess[i]] = i

def run(H, use_cross, label):
    elig = np.zeros(n,bool); yv = np.full(n,np.nan); xb = np.full(n,-1,int)
    for i in range(n):
        if slot[i] < 585 or slot[i] > 870: continue
        e = i+1
        if e>=n or sess[e]!=sess[i]: continue
        x_ = min(e+H-1, last_of[sess[i]])
        elig[i]=True; yv[i]=c[x_]-o[e]; xb[i]=x_
    cols = list(X.columns) if use_cross else [k for k in X.columns if k not in ('y1','y2','y4','sp1','sp2','sp4','ylead','yd')]
    Xm = X[cols].to_numpy()
    mask = elig & np.isfinite(yv) & np.isfinite(Xm).all(axis=1)
    trades=[]
    for Y in range(2021,2027):
