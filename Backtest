    ph = w[w["ph"] & (w["high"] > w["bhi"])]          # needs a real upper wick
    pl = w[w["pl"] & (w["low"] < w["blo"])]
    bear = ph["high"].max() if len(ph) else np.nan
    bull = pl["low"].min() if len(pl) else np.nan
    return bear, bull, w["high"].max(), w["low"].min()


