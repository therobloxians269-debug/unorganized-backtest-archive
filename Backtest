#!/usr/bin/env python3
"""GEXLAB M0 — option-chain snapshot recorder.

CBOE's free delayed-quote endpoint returns an entire option chain in ONE call:
open interest, volume, IV, bid/ask size, and exchange-computed greeks for every
listed contract. ~13k rows for QQQ.

It is a SNAPSHOT. There is no free history of it. Every session that goes
unrecorded is gone for good, which is why this module exists before any
research module does. It appends; it never rewrites.

    python3 snap.py                 # snapshot the default roots once
    python3 snap.py QQQ SPY         # explicit roots
    python3 snap.py --list          # what has been recorded so far
"""
from __future__ import annotations

import re
import sys
import time
import datetime as dt
from pathlib import Path

import pandas as pd
import requests

ROOT = Path(__file__).resolve().parent
DATA = ROOT / "data" / "chains"
CBOE = "https://cdn.cboe.com/api/global/delayed_quotes/options/{sym}.json"
UA = {"User-Agent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7)"}
# Both books hedge into the Nasdaq complex. _NDX is cash-settled, so its
# dealer hedge lands DIRECTLY in NQ futures; QQQ hedges into ETF shares.
DEFAULT_ROOTS = ["QQQ", "_NDX"]

# OSI: root(≤6, space-padded in the spec, unpadded here) YYMMDD C/P strike*1000
OSI = re.compile(r"^(?P<root>[A-Z^]+)(?P<y>\d{2})(?P<m>\d{2})(?P<d>\d{2})(?P<cp>[CP])(?P<k>\d{8})$")

KEEP = [
    "option", "bid", "bid_size", "ask", "ask_size", "iv", "open_interest",
    "volume", "delta", "gamma", "vega", "theta", "rho", "theo",
    "last_trade_price", "last_trade_time", "prev_day_close",
]


def parse_osi(sym: str) -> tuple[str, dt.date, str, float] | None:
    m = OSI.match(sym)
    if not m:
        return None
    g = m.groupdict()
    try:
        exp = dt.date(2000 + int(g["y"]), int(g["m"]), int(g["d"]))
    except ValueError:
        return None
    return g["root"], exp, g["cp"], int(g["k"]) / 1000.0


def fetch(root: str, retries: int = 3) -> dict:
    last = None
    for i in range(retries):
        try:
            r = requests.get(CBOE.format(sym=root), headers=UA, timeout=45)
            r.raise_for_status()
            return r.json()
        except Exception as e:  # noqa: BLE001 - surface whatever the wire gave us
            last = e
            time.sleep(2 * (i + 1))
    raise RuntimeError(f"{root}: chain fetch failed after {retries} tries: {last}")


def snapshot(root: str) -> Path:
    j = fetch(root)
    d = j["data"]
    # CBOE stamps this field in UTC, NOT ET, and it carries no offset to say so.
    # MEASURED 2026-08-10: four consecutive files each sat exactly +4.0h ahead of
    # our own write time, and the live field read 19:35 while it was 15:35 in New
    # York. Reading it as ET broke two things silently:
    #   · applies_to() rolls to the next session at hour >= 16, so every pull
    #     after 12:00 ET was stamped for TOMORROW -- the chart would find no row
    #     for the session actually being traded.
    #   · T (time to expiry) came out 4h too SHORT, and gamma blows up as T->0,
    #     so it over-weighted exactly the near-expiry strikes that matter most.
    # Convert properly rather than subtracting 4: the offset is 4h in EDT and 5h
    # in EST, and a hard-coded shift would silently break in November.
    ts = (pd.Timestamp(j["timestamp"], tz="UTC")
          .tz_convert("America/New_York").tz_localize(None))
    spot = float(d["current_price"])

    df = pd.DataFrame(d["options"])
    for c in KEEP:
        if c not in df.columns:
            df[c] = pd.NA
    df = df[KEEP].copy()

    parsed = df["option"].map(parse_osi)
    bad = parsed.isna().sum()
    df = df[parsed.notna()].copy()
    p = parsed[parsed.notna()]
    df["opt_root"] = [x[0] for x in p]
    df["expiry"] = [x[1] for x in p]
    df["right"] = [x[2] for x in p]
    df["strike"] = [x[3] for x in p]

    df["snap_ts"] = ts
    df["underlying"] = root
    df["spot"] = spot
    df["u_bid"] = float(d.get("bid") or "nan")
    df["u_ask"] = float(d.get("ask") or "nan")

    num = ["bid", "ask", "bid_size", "ask_size", "iv", "open_interest", "volume",
           "delta", "gamma", "vega", "theta", "rho", "theo", "last_trade_price",
           "prev_day_close"]
    for c in num:
        df[c] = pd.to_numeric(df[c], errors="coerce")

    out_dir = DATA / root
    out_dir.mkdir(parents=True, exist_ok=True)
    out = out_dir / f"{root}_{ts:%Y%m%d_%H%M%S}.parquet"
    df.to_parquet(out, index=False)

    oi = df["open_interest"].sum()
    live = int((df["open_interest"] > 0).sum())
    print(f"{root}  as-of {ts}  spot {spot:.2f}  {len(df):,} contracts "
          f"({live:,} with OI, total OI {oi:,.0f}, {bad} unparsed)  ->  {out.name}")
    return out


def listing() -> None:
    if not DATA.exists():
        print("nothing recorded yet")
        return
    for d in sorted(DATA.iterdir()):
        if not d.is_dir():
            continue
        fs = sorted(d.glob("*.parquet"))
        if not fs:
            continue
        # roots may themselves contain "_" (e.g. _NDX), so pull the 8-digit date
        # rather than splitting on underscores and hoping for the best
        days = sorted({m.group(1) for f in fs
                       if (m := re.search(r"_(\d{8})_\d{6}\.parquet$", f.name))})
        if not days:
            continue
        mb = sum(f.stat().st_size for f in fs) / 1e6
        print(f"{d.name:6s}  {len(fs):5d} snapshots  {len(days):4d} distinct days  "
              f"{days[0]}..{days[-1]}  {mb:.1f} MB")


if __name__ == "__main__":
    args = [a for a in sys.argv[1:] if not a.startswith("-")]
    if "--list" in sys.argv:
        listing()
    else:
        for r in (args or DEFAULT_ROOTS):
            try:
                snapshot(r.upper())
            except Exception as e:  # noqa: BLE001
                print(f"{r}: FAILED {type(e).__name__}: {e}", file=sys.stderr)

