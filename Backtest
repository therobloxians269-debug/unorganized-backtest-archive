"""
THE CHROME MODEL — kaveh's framework.

CENTRAL ORIGINAL CLAIM
    Not all liquidity is the same. Every retail framework treats liquidity pools as
    one object ("buyside liquidity", "sellside liquidity"). Measured on 13,038 raids,
    that is false:

        overnight low    reclaimed 94.4%   median 2 min   penetration 0.06 ADR
        IB low           reclaimed 93.4%   median 2 min   penetration 0.06 ADR
        IB high          reclaimed 90.6%   median 2 min   penetration 0.05 ADR
        overnight high   reclaimed 89.3%   median 2 min   penetration 0.06 ADR
        prior day high   reclaimed 74.8%   median 5 min   penetration 0.18 ADR

    A boundary has HARDNESS. Soft rails are reclaimed almost always, within minutes,
    barely penetrated — breaking one is noise. Hard rails break for real, three times
    deeper. Hardness, not location, says whether a break means anything.

THE VOCABULARY
    RAIL       a liquidity boundary (ONH/ONL, IB edges, PDH/PDL, weekly H/L)
    HARDNESS   1 - reclaim rate, measured on a trailing window per rail type. The
               model's core state variable. Estimated causally, never assumed.
    SKID       price crosses a SOFT rail and is thrown back -> the break was noise
    WELD       price crosses a HARD rail and holds -> the break was real
    THE PLATE  session VWAP; where volume actually traded. "Value".
    STRETCH    distance from the PLATE in ADR units
    THE STRIP  range budget: ADR consumed vs remaining
    CHROME     a smooth tape (low volume dispersion, orderly) — rails hold their character
    RUST       a rough tape — hardness estimates degrade, size down
    THE VERDICT the extreme-state estimator: P(the running extreme is final)
    THE TAX    the drift baseline any setup must beat before it counts as edge

THE LAWS (measured, not assumed)
    FILL LAW      a probability conditioned on an extreme holding collapses on fill
                  (0.876 -> 0.470; 1.000 when unfilled). Rails are STOPS, never entries.
    GEOMETRY LAW  cost/R varies 15x by instrument (MES 0.101 vs MNQ 0.0065). Trade MNQ.
    THE GATE      require >= 2R of room, known pre-entry, free.
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')

RTH0, RTH1 = 570, 960
IBLEN = 60

# every rail we can build causally, with when it becomes live
RAILS = {
    'ONH': ('up', 0), 'ONL': ('dn', 0),
    'PDH': ('up', 0), 'PDL': ('dn', 0),
    'IBH': ('up', RTH0 + IBLEN), 'IBL': ('dn', RTH0 + IBLEN),
    'PWH': ('up', 0), 'PWL': ('dn', 0),          # prior week high/low
}


def rail_levels(day):
    """Causal rail levels per session. Weekly rails come from completed prior weeks."""
    d = day.copy()
    wk = d.index.to_period('W')
    d['_wk'] = wk
    wh = d.groupby('_wk').hi.max().shift(1)
    wl = d.groupby('_wk').lo.min().shift(1)
    d['PWH'] = d._wk.map(wh)
    d['PWL'] = d._wk.map(wl)
    d['ONH_'] = d.onH; d['ONL_'] = d.onL
    d['PDH_'] = d.prevHi; d['PDL_'] = d.prevLo
    return d


def crossings(day, rb, min_bars=300):
    """
    One row per (session, rail) FIRST crossing. Records whether it was reclaimed, how
    fast, how deep, and what happened afterwards — the raw material for HARDNESS.
    """
    d = rail_levels(day)
    rows = []
    for dd, row in d.iterrows():
        b = rb.get(dd)
        if b is None:
            continue
        H, L, C, T = b['H'], b['L'], b['C'], b['T']
        A = float(row.ADR)
        if not (A > 0) or len(C) < min_bars:
            continue
        mib = T < RTH0 + IBLEN
        if mib.sum() < IBLEN * 0.8:
            continue
        lv = {'ONH': float(row.onH), 'ONL': float(row.onL),
              'PDH': float(row.prevHi), 'PDL': float(row.prevLo),
              'IBH': float(H[mib].max()), 'IBL': float(L[mib].min()),
              'PWH': float(row.PWH) if np.isfinite(row.PWH) else np.nan,
              'PWL': float(row.PWL) if np.isfinite(row.PWL) else np.nan}

        for name, (side, live) in RAILS.items():
            lvl = lv[name]
            if not np.isfinite(lvl):
                continue
            start = int(np.searchsorted(T, live, side='left')) if live else 0
            if start >= len(H) - 20:
                continue
            up = side == 'up'
            hit = (np.flatnonzero(H[start:] > lvl) if up
                   else np.flatnonzero(L[start:] < lvl))
            if not len(hit):
                continue
            i = start + int(hit[0])
            if i >= len(H) - 10:
                continue
            # reclaim = a CLOSE back through the rail
            fwd = (np.flatnonzero(C[i + 1:] < lvl) if up
                   else np.flatnonzero(C[i + 1:] > lvl))
            if len(fwd):
                j = i + 1 + int(fwd[0])
                tau = float(T[j] - T[i]); reclaimed = True
            else:
                j, tau, reclaimed = len(C) - 1, np.nan, False
            ext = float(H[i:j + 1].max()) if up else float(L[i:j + 1].min())
            pen = (ext - lvl) / A if up else (lvl - ext) / A
            # what happened after: continuation past the rail by the close
            cl = float(C[-1])
            cont = (cl - lvl) / A if up else (lvl - cl) / A
            rows.append(dict(day=dd, rail=name, side='up' if up else 'dn',
                             lvl=lvl, ADR=A, i=i, tod=int(T[i]),
                             reclaimed=reclaimed, tau=tau, pen=pen, cont=cont,
                             px=float(C[i]), j=j))
    return pd.DataFrame(rows)


def hardness_table(cr):
    """Static hardness per rail type — the taxonomy."""
    g = cr.groupby('rail').agg(
        n=('reclaimed', 'size'),
        reclaim=('reclaimed', 'mean'),
        med_tau=('tau', 'median'),
        med_pen=('pen', 'median'),
        cont=('cont', 'mean'))
    g['HARDNESS'] = 1.0 - g.reclaim
    return g.sort_values('HARDNESS', ascending=False)


def rolling_hardness(cr, win=60):
    """
    CAUSAL hardness: for each crossing, the reclaim rate of that rail type over the
    previous `win` crossings of the same type. This is the state variable the model
    trades on — never the full-sample value.
    """
    cr = cr.sort_values(['rail', 'day']).copy()
    cr['H_run'] = (cr.groupby('rail').reclaimed
                     .transform(lambda s: 1.0 - s.shift(1)
                                .rolling(win, min_periods=20).mean()))
    return cr

