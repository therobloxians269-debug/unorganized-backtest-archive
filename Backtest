"""
imbalance.py — Fair Value Gaps, Order Blocks, Breakers, and displacement.

These are ICT's "PD arrays" — the discrete price zones the algorithm is presumed
to return to. The two workhorses:

  Fair Value Gap (FVG): a 3-candle imbalance where the wicks of candle 1 and
    candle 3 do not overlap, leaving an inefficiency (a "gap" in delivery).
      bullish (BISI): low[i] > high[i-2]   → zone [high[i-2], low[i]], acts as support
      bearish (SIBI): high[i] < low[i-2]   → zone [high[i], low[i-2]], acts as resistance
    Consequent Encroachment (CE) = the 50% of the gap, ICT's preferred fill price.

  Order Block (OB): the last opposing-close candle before the impulse that broke
    structure — where price was last "accumulated" before the move.

  Displacement: an energetic, gap-leaving move (range >> ATR that prints an FVG).
    Displacement is what upgrades a plain CHoCH into a Market Structure Shift and
    is ICT's tell for genuine institutional intent versus noise.

Every object is stamped with the bar index at which it becomes known so the
engine stays strictly causal. Mitigation (price trading back into a zone) is
tracked live by the engine, not here.
"""
from __future__ import annotations

from dataclasses import dataclass
import numpy as np
import pandas as pd

from .indicators import rolling_atr_array


@dataclass
class FVG:
    idx: int            # formation bar (candle 3) — known at this bar
    direction: int      # +1 bullish (support), -1 bearish (resistance)
    top: float
    bottom: float

    @property
    def ce(self) -> float:
        return (self.top + self.bottom) / 2.0

    @property
    def size(self) -> float:
        return self.top - self.bottom


@dataclass
class OrderBlock:
    idx: int
    direction: int      # +1 bullish OB (demand), -1 bearish OB (supply)
    top: float
    bottom: float


def find_fvgs(df: pd.DataFrame, min_size_atr: float = 0.0,
              atr_period: int = 14) -> list[FVG]:
    """All 3-candle FVGs, optionally filtered to gaps >= min_size_atr * ATR."""
    high = df["high"].to_numpy()
    low = df["low"].to_numpy()
    n = len(df)
    a = rolling_atr_array(df, atr_period)
    out: list[FVG] = []
    for i in range(2, n):
        floor = (min_size_atr * a[i]) if (min_size_atr > 0 and not np.isnan(a[i])) else 0.0
        if low[i] > high[i - 2]:  # bullish imbalance
            if low[i] - high[i - 2] >= floor:
                out.append(FVG(i, +1, float(low[i]), float(high[i - 2])))
        elif high[i] < low[i - 2]:  # bearish imbalance
            if low[i - 2] - high[i] >= floor:
                out.append(FVG(i, -1, float(low[i - 2]), float(high[i])))
    return out


def displacement_at(df: pd.DataFrame, i: int, direction: int,
                    atr_arr: np.ndarray, lookback: int = 3,
                    body_mult: float = 1.5) -> bool:
    """True if the move ending at bar `i` is displacement in `direction`.

    Requires (a) a large directional body within the last `lookback` bars and
    (b) an FVG of the same direction printed in that window — the ICT definition
    of an energetic, gap-leaving delivery.
    """
    o = df["open"].to_numpy()
    c = df["close"].to_numpy()
    high = df["high"].to_numpy()
    low = df["low"].to_numpy()
    a = atr_arr[i]
    if np.isnan(a) or a <= 0:
        return False

    lo = max(2, i - lookback + 1)
    big_body = False
    for j in range(lo, i + 1):
        body = c[j] - o[j]
        if direction > 0 and body > body_mult * a:
            big_body = True
        if direction < 0 and -body > body_mult * a:
            big_body = True
    if not big_body:
        return False

    for j in range(lo, i + 1):
        if direction > 0 and low[j] > high[j - 2]:
            return True
        if direction < 0 and high[j] < low[j - 2]:
            return True
    return False


def order_block_before(df: pd.DataFrame, i: int, direction: int,
                       max_lookback: int = 15) -> OrderBlock | None:
    """Last opposing-close candle before the impulse ending at bar `i`.

    For a bullish move (direction +1) that is the last *down-close* candle; its
    full range [low, high] is the demand order block. Mirror for shorts.
    """
    o = df["open"].to_numpy()
    c = df["close"].to_numpy()
    high = df["high"].to_numpy()
    low = df["low"].to_numpy()
    lo = max(0, i - max_lookback)
    for j in range(i, lo, -1):
        if direction > 0 and c[j] < o[j]:
            return OrderBlock(j, +1, float(high[j]), float(low[j]))
        if direction < 0 and c[j] > o[j]:
            return OrderBlock(j, -1, float(high[j]), float(low[j]))
    return None

