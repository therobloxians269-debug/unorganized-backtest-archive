#!/usr/bin/env python3
"""
rebalance_pretest.py
================================================================================
FALSIFICATION PRE-TEST: Institutional 60/40 rebalancing front-run on ES vs ZN.

Tests the Harvey-Mazzoleni-Melone ("The Unintended Consequences of Rebalancing",
NBER WP 33554) mechanism: fixed-weight 60/40 funds mechanically sell equities /
buy bonds into month-end when equities have outperformed since the last rebalance.
A front-runner shorts equity index futures and longs Treasury futures ahead of
that flow.

This script is a GO/NO-GO gate, not a production harness. Every parameter is
fixed by the economic mechanism (NOT optimized), so the multiple-testing haircut
stays small. It reports failures honestly. It is designed to be able to KILL the
strategy.

PRE-REGISTERED PRIMARY SPEC: the front-run leg (short-equity/long-bond when
equities overweight, during the last N trading days into month-end). The reversal
and combined variants are reported as secondary readouts; the VERDICT keys off
the front-run so there is no post-hoc selection.

Decision thresholds (full-sample, annualized, all-days Sharpe of the PRIMARY spec):
    Sharpe >= 1.0  -> GREEN  (build the full harness)
    0.5 - 1.0      -> MARGINAL (one walk-forward look only, then decide)
    Sharpe < 0.5   -> KILL
Hard fails (override Sharpe):
    |market beta| >= 0.15  -> FAIL (disguised beta)
    active-day skew < 0    -> FAIL (loses the positive-skew selling point)

Usage:
    python rebalance_pretest.py                         # downloads ES=F and ZN=F
    python rebalance_pretest.py --es-file ES.csv        # use your own ES daily
    python rebalance_pretest.py --es-file ES.csv --bond-file ZN.csv
Options:
    --window 5        trading days into month-end for the front-run (mechanism: 4-5)
    --reversal 3      trading days after month-end for the reversal leg
    --cost-ticks 1.0  baseline one-way cost per leg, in ticks
    --trials 10       honest trial count for the Deflated Sharpe
    --start / --end   date range (default: last 16 years)
================================================================================
"""

import argparse
import warnings

import numpy as np
import pandas as pd
from scipy import stats

import matplotlib
matplotlib.use("Agg")  # headless-safe
import matplotlib.pyplot as plt

warnings.filterwarnings("ignore")

# ----------------------------------------------------------------------------
# Instrument constants
# ----------------------------------------------------------------------------
ES_TICK_PTS = 0.25          # ES minimum tick in index points
ZN_TICK_PTS = 1.0 / 64.0    # ZN minimum tick in price points (1/64)
TRADING_DAYS = 252
VOL_LOOKBACK = 60           # trailing window for risk-matching the two legs
VOL_CLIP = (0.25, 8.0)      # sane bounds on the bond/equity vol ratio (guard, not tuned)


# ----------------------------------------------------------------------------
# Data loading
# ----------------------------------------------------------------------------
def _flatten_yf(df):
    if isinstance(df.columns, pd.MultiIndex):
        df.columns = [c[0] for c in df.columns]
    return df


def _pick_close(df):
    for c in ["Settle", "Close", "Adj Close", "close", "settle", "PX_LAST", "Last"]:
        if c in df.columns:
            return df[c].astype(float)
    num = df.select_dtypes("number")
    if num.shape[1] == 0:
        raise ValueError("No numeric close/settle column found.")
    return num.iloc[:, 0].astype(float)


def load_file(path):
    df = pd.read_csv(path)
    date_col = None
    for c in df.columns:
        if str(c).lower() in ("date", "datetime", "time", "timestamp", "ts"):
            date_col = c
            break
    if date_col is None:
        date_col = df.columns[0]
    df[date_col] = pd.to_datetime(df[date_col], errors="coerce")
    df = df.dropna(subset=[date_col]).set_index(date_col).sort_index()
    if df.index.tz is not None:
        df.index = df.index.tz_localize(None)
    s = _pick_close(df)
    s.name = "close"
    return s


def download_yf(ticker, start, end):
    import yfinance as yf
    df = yf.download(ticker, start=start, end=end, progress=False, auto_adjust=False)
    if df is None or len(df) == 0:
        raise RuntimeError(f"yfinance returned no data for {ticker}")
    df = _flatten_yf(df)
    s = _pick_close(df)
    s.index = pd.to_datetime(s.index)
    if s.index.tz is not None:
        s.index = s.index.tz_localize(None)
    s.name = "close"
    return s.sort_index()


def download_stooq(symbols, start, end):
    from pandas_datareader import data as pdr
    last_err = None
    for sym in symbols:
        try:
            df = pdr.DataReader(sym, "stooq", start, end)
            if df is not None and len(df) > 0:
                df = df.sort_index()
                s = _pick_close(df)
                s.index = pd.to_datetime(s.index)
                if s.index.tz is not None:
                    s.index = s.index.tz_localize(None)
                s.name = "close"
                return s
        except Exception as e:  # noqa
            last_err = e
    raise RuntimeError(f"Stooq failed for {symbols}: {last_err}")


def get_series(name, file_path, yf_ticker, stooq_syms, start, end):
    if file_path:
        print(f"  [{name}] loading file: {file_path}")
        return load_file(file_path)
    print(f"  [{name}] downloading {yf_ticker} via yfinance ...")
    try:
        s = download_yf(yf_ticker, start, end)
        if (s.index.max() - s.index.min()).days < 15 * 365:
            print(f"  [{name}] yfinance history short "
                  f"({s.index.min().date()}..{s.index.max().date()}), trying Stooq ...")
            try:
                s2 = download_stooq(stooq_syms, start, end)
                if (s2.index.max() - s2.index.min()).days > (s.index.max() - s.index.min()).days:
                    s = s2
            except Exception as e:
                print(f"  [{name}] Stooq fallback failed ({e}); keeping yfinance.")
        return s
    except Exception as e:
        print(f"  [{name}] yfinance failed ({e}); trying Stooq ...")
        return download_stooq(stooq_syms, start, end)


# ----------------------------------------------------------------------------
# Strategy construction (mechanism-fixed, no optimization)
# ----------------------------------------------------------------------------
def build_panel(es, zn):
    df = pd.DataFrame({"es": es, "zn": zn}).dropna()
    df = df[~df.index.duplicated(keep="last")].sort_index()
    df["r_es"] = df["es"].pct_change()
    df["r_zn"] = df["zn"].pct_change()
    df["lr_es"] = np.log(df["es"]).diff()
    df["lr_zn"] = np.log(df["zn"]).diff()
    df = df.dropna()
    df["ym"] = df.index.to_period("M")
    return df


def add_drift_and_windows(df, window, reversal):
    """drift = cumulative (equity - bond) log return since the start of the
    current month (proxy for equities' overweight vs the last month-end rebalance)."""
    df = df.copy()
    df["cum_es"] = df.groupby("ym")["lr_es"].cumsum()
    df["cum_zn"] = df.groupby("ym")["lr_zn"].cumsum()
    df["drift"] = df["cum_es"] - df["cum_zn"]   # >0 => equities overweight

    df["rank_from_end"] = df.groupby("ym").cumcount(ascending=False) + 1
    df["rank_from_start"] = df.groupby("ym").cumcount() + 1
    df["in_frontrun"] = df["rank_from_end"] <= window
    df["in_reversal"] = df["rank_from_start"] <= reversal

    me_drift = df.groupby("ym")["drift"].last()
    prev_month_drift = me_drift.shift(1)
    df["prev_month_drift"] = df["ym"].map(prev_month_drift)
    return df


def risk_scale(df):
    """Bond/equity vol ratio (trailing, causal) to risk-match the two legs."""
    vol_es = df["r_es"].rolling(VOL_LOOKBACK).std()
    vol_zn = df["r_zn"].rolling(VOL_LOOKBACK).std()
    s = (vol_es / vol_zn).clip(*VOL_CLIP)
    return s.shift(1)


def strategy_returns(df, cost_ticks, variant):
    """Net & gross daily strategy returns for a variant in
    {'frontrun','reversal','combined'}.
    Equity leg weight in {-1,0,+1}; bond leg weight = sign * vol-scale s.
    Front-run: equities overweight (drift>0) -> short ES (+ long ZN).
    Reversal:  capture the snap-back -> long ES (+ short ZN) when prior-month drift>0.
    """
    s = risk_scale(df).fillna(0.0)

    w_es = pd.Series(0.0, index=df.index)
    w_zn = pd.Series(0.0, index=df.index)

    if variant in ("frontrun", "combined"):
        sgn = np.sign(df["drift"].shift(1)).fillna(0.0)
        mask = df["in_frontrun"].values
        w_es = w_es.where(~mask, -sgn)
        w_zn = w_zn.where(~mask, sgn * s)
    if variant in ("reversal", "combined"):
        sgn_rev = np.sign(df["prev_month_drift"]).fillna(0.0)
        mask_r = df["in_reversal"].values
        w_es = w_es.where(~mask_r, sgn_rev)
        w_zn = w_zn.where(~mask_r, -sgn_rev * s)

    gross = w_es.shift(1) * df["r_es"] + w_zn.shift(1) * df["r_zn"]

    c_es = cost_ticks * ES_TICK_PTS / df["es"]
    c_zn = cost_ticks * ZN_TICK_PTS / df["zn"]
    dW_es = (w_es - w_es.shift(1)).abs()
    dW_zn = (w_zn - w_zn.shift(1)).abs()
    cost = dW_es * c_es + dW_zn * c_zn

    net = (gross - cost).fillna(0.0)
    gross = gross.fillna(0.0)
    active = (w_es != 0) | (w_zn != 0)
    return net, gross, active


# ----------------------------------------------------------------------------
# Metrics
# ----------------------------------------------------------------------------
def ann_sharpe(r, periods=TRADING_DAYS):
    r = pd.Series(r).dropna()
    if len(r) < 2 or r.std() == 0:
        return np.nan
    return r.mean() / r.std() * np.sqrt(periods)


def max_drawdown(r):
    eq = (1 + pd.Series(r).fillna(0)).cumprod()
    return (eq / eq.cummax() - 1).min()


def psr(r, sr_bench_ann=0.0, periods=TRADING_DAYS):
    """Probabilistic Sharpe Ratio: P(true SR > benchmark)."""
    r = pd.Series(r).dropna()
    n = len(r)
    if n < 3 or r.std() == 0:
        return np.nan
    sr = r.mean() / r.std()
    sr_b = sr_bench_ann / np.sqrt(periods)
    sk = stats.skew(r)
    ku = stats.kurtosis(r, fisher=False)
    denom = np.sqrt(max(1 - sk * sr + (ku - 1) / 4.0 * sr ** 2, 1e-12))
    z = (sr - sr_b) * np.sqrt(n - 1) / denom
    return stats.norm.cdf(z)


def deflated_sharpe(r, n_trials, periods=TRADING_DAYS):
    """Bailey & Lopez de Prado DSR. SR0 (expected max under the null) is built from
    the sampling variance of the Sharpe estimator (we deliberately did NOT sweep,
    so a true cross-trial variance isn't available; this is the standard
    approximation and is conservative for small trial counts)."""
    r = pd.Series(r).dropna()
    n = len(r)
    if n < 3 or r.std() == 0:
        return np.nan, np.nan
    sr = r.mean() / r.std()
    sk = stats.skew(r)
    ku = stats.kurtosis(r, fisher=False)
    var_sr = max(1 - sk * sr + (ku - 1) / 4.0 * sr ** 2, 1e-12) / (n - 1)
    emc = 0.5772156649015329
    nt = max(int(n_trials), 1)
    if nt == 1:
        sr0 = 0.0
    else:
        z1 = stats.norm.ppf(1 - 1.0 / nt)
        z2 = stats.norm.ppf(1 - 1.0 / (nt * np.e))
        sr0 = np.sqrt(var_sr) * ((1 - emc) * z1 + emc * z2)
    denom = np.sqrt(max(1 - sk * sr + (ku - 1) / 4.0 * sr ** 2, 1e-12))
    z = (sr - sr0) * np.sqrt(n - 1) / denom
    return stats.norm.cdf(z), sr0 * np.sqrt(periods)


def market_beta(strat, mkt):
    d = pd.DataFrame({"s": strat, "m": mkt}).dropna()
    d = d[d["s"] != 0]
    if len(d) < 10 or d["m"].std() == 0:
        return np.nan, np.nan
    x = d["m"].values
    y = d["s"].values
    X = np.column_stack([np.ones_like(x), x])
    beta = np.linalg.lstsq(X, y, rcond=None)[0]
    resid = y - X @ beta
    s2 = (resid @ resid) / (len(y) - 2)
    cov = s2 * np.linalg.inv(X.T @ X)
    t = beta[1] / np.sqrt(cov[1, 1])
    return beta[1], t


def summarize(net, active, mkt, label, n_trials):
    act = net[active]
    beta, beta_t = market_beta(net, mkt)
    out = {
        "label": label,
        "n_active_days": int(active.sum()),
        "sharpe_all": ann_sharpe(net),
        "sharpe_active": ann_sharpe(act),
        "ann_ret_all": net.mean() * TRADING_DAYS,
        "ann_vol_all": net.std() * np.sqrt(TRADING_DAYS),
        "skew_active": stats.skew(act.dropna()) if len(act.dropna()) > 2 else np.nan,
        "maxdd": max_drawdown(net),
        "hit_rate": (act > 0).mean() if len(act) else np.nan,
        "beta_mkt": beta,
        "beta_t": beta_t,
        "psr_gt0": psr(net, 0.0),
        "psr_gt05": psr(net, 0.5),
    }
    dsr, sr0 = deflated_sharpe(net, n_trials)
    out["dsr"] = dsr
    out["sr0_ann"] = sr0
    return out


def subsample_and_rolling(net, mkt):
    idx = net.index
    mid = idx[len(idx) // 2]
    h1 = net[idx <= mid]
    h2 = net[idx > mid]
    res = {
        "half1_dates": f"{h1.index.min().date()}..{h1.index.max().date()}",
        "half2_dates": f"{h2.index.min().date()}..{h2.index.max().date()}",
        "sharpe_h1": ann_sharpe(h1),
        "sharpe_h2": ann_sharpe(h2),
        "beta_h1": market_beta(h1, mkt)[0],
        "beta_h2": market_beta(h2, mkt)[0],
    }
    roll = net.rolling(TRADING_DAYS * 2).apply(lambda w: ann_sharpe(w), raw=False)
    yearly = net.groupby(net.index.year).sum()
    return res, roll, yearly


# ----------------------------------------------------------------------------
# Reporting
# ----------------------------------------------------------------------------
def fmt(x, p=2):
    return "nan" if (x is None or (isinstance(x, float) and np.isnan(x))) else f"{x:.{p}f}"


def print_metrics_table(rows):
    cols = [
        ("Variant", "label", "s"),
        ("Shrp(all)", "sharpe_all", "f"),
        ("Shrp(act)", "sharpe_active", "f"),
        ("AnnRet", "ann_ret_all", "pct"),
        ("AnnVol", "ann_vol_all", "pct"),
        ("Skew(act)", "skew_active", "f"),
        ("MaxDD", "maxdd", "pct"),
        ("Hit%", "hit_rate", "pct"),
        ("Beta", "beta_mkt", "f3"),
        ("Beta_t", "beta_t", "f"),
        ("PSR>0", "psr_gt0", "f3"),
        ("PSR>.5", "psr_gt05", "f3"),
        ("DSR", "dsr", "f3"),
        ("ActDays", "n_active_days", "d"),
    ]
    header = " ".join(f"{c[0]:>10}" for c in cols)
    print(header)
    print("-" * len(header))
    for r in rows:
        cells = []
        for _name, key, kind in cols:
            v = r[key]
            if kind == "s":
                cells.append(f"{v:>10}")
            elif kind == "d":
                cells.append(f"{int(v):>10}")
            elif kind == "pct":
                cells.append(f"{v*100:>9.1f}%" if not (isinstance(v, float) and np.isnan(v)) else f"{'nan':>10}")
            elif kind == "f3":
                cells.append(f"{fmt(v,3):>10}")
            else:
                cells.append(f"{fmt(v,2):>10}")
        print(" ".join(cells))


def verdict(primary, cost_curve):
    print("\n" + "=" * 80)
    print("VERDICT  (pre-registered primary spec = FRONT-RUN leg)")
    print("=" * 80)
    sr = primary["sharpe_all"]
    beta = primary["beta_mkt"]
    skew = primary["skew_active"]

    hard_fail = []
    if not np.isnan(beta) and abs(beta) >= 0.15:
        hard_fail.append(f"market beta |{fmt(beta,3)}| >= 0.15  -> DISGUISED BETA")
    if not np.isnan(skew) and skew < 0:
        hard_fail.append(f"active-day skew {fmt(skew,2)} < 0  -> lost the positive-skew edge")

    print(f"Full-sample annualized Sharpe (all days): {fmt(sr,2)}")
    print(f"Market beta (trade-on days):              {fmt(beta,3)}  (t={fmt(primary['beta_t'],1)})")
    print(f"Active-day skew:                          {fmt(skew,2)}")
    print(f"Deflated Sharpe / PSR>0:                  {fmt(primary['dsr'],3)} / {fmt(primary['psr_gt0'],3)}")
    print(f"Max drawdown:                             {fmt(primary['maxdd']*100,1)}%")

    print("\nCost sensitivity (front-run Sharpe, all-days):")
    for t, sc in cost_curve:
        approx = "~1 tick" if abs(t - 1.0) < 1e-9 else ""
        print(f"   {t:>4.1f} ticks/leg one-way -> Sharpe {fmt(sc,2)}   {approx}")

    print("")
    if hard_fail:
        print("RESULT: FAIL (hard constraint)")
        for h in hard_fail:
            print("   - " + h)
        print("\n=> Do not build the harness on this spec. The mechanism may still be")
        print("   real but this expression is not beta-neutral / positively skewed as required.")
        return

    if np.isnan(sr):
        print("RESULT: INCONCLUSIVE — check data quality flags above.")
        return

    if sr >= 1.0:
        print("RESULT: GREEN — build the full harness.")
        print("   In-sample Sharpe clears 1.0 with beta-neutrality and positive skew intact.")
        print("   Next: stage-1 enhancements (flow-magnitude weighting, quarter-end")
        print("   amplification) and a locked OOS / walk-forward / honest-DSR battery.")
    elif sr >= 0.5:
        print("RESULT: MARGINAL — one walk-forward look, then decide (per pre-registered rule).")
        print("   Inspect the rolling-Sharpe and yearly tables: consistent across eras or")
        print("   driven by one regime? If consistent and skew/beta hold, it's a real")
        print("   diversifier but not yet a flagship. If era-dependent, treat as KILL.")
    else:
        print("RESULT: KILL — in-sample Sharpe below 0.5 before any OOS decay.")
        print("   Report verbatim and move on. Do not re-tune to force a pass.")

    print("\nSecondary variants (reversal, combined) are shown above for information only;")
    print("they do not change this verdict but inform what to build if GREEN.")


# ----------------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------------
def main():
    ap = argparse.ArgumentParser(description="60/40 rebalancing front-run pre-test (ES vs ZN).")
    ap.add_argument("--es-file", default=None, help="CSV of ES daily (date + close/settle).")
    ap.add_argument("--bond-file", default=None, help="CSV of ZN/10y daily (date + close/settle).")
    ap.add_argument("--window", type=int, default=5, help="front-run trading days into month-end.")
    ap.add_argument("--reversal", type=int, default=3, help="reversal trading days after month-end.")
    ap.add_argument("--cost-ticks", type=float, default=1.0, help="baseline one-way cost per leg (ticks).")
    ap.add_argument("--trials", type=int, default=10, help="honest trial count for Deflated Sharpe.")
    ap.add_argument("--start", default=None)
    ap.add_argument("--end", default=None)
    ap.add_argument("--outdir", default=".")
    args = ap.parse_args()

    end = pd.to_datetime(args.end) if args.end else pd.Timestamp.today().normalize()
    start = pd.to_datetime(args.start) if args.start else (end - pd.Timedelta(days=int(16 * 365.25)))

    print("=" * 80)
    print("LOADING DATA")
    print("=" * 80)
    es = get_series("ES ", args.es_file, "ES=F", ["ES.F", "^GSPC"], start, end)
    zn = get_series("ZN ", args.bond_file, "ZN=F", ["ZN.F", "10USY.B"], start, end)
    es = es[(es.index >= start) & (es.index <= end)]
    zn = zn[(zn.index >= start) & (zn.index <= end)]

    print("\nDATA QUALITY")
    for nm, s in [("ES", es), ("ZN", zn)]:
        print(f"  {nm}: {len(s)} rows, {s.index.min().date()}..{s.index.max().date()}")
    df = build_panel(es, zn)
    overlap = len(df)
    print(f"  overlap (aligned trading days): {overlap}")
    if overlap < 3000:
        print("  WARNING: <3000 overlapping days — results may be unreliable.")
    span_years = (df.index.max() - df.index.min()).days / 365.25
    if span_years < 15:
        print(f"  WARNING: overlap spans only {span_years:.1f} years (<15).")
    gaps = df.index.to_series().diff().dt.days
    nbig = int((gaps > 5).sum())
    if nbig:
        print(f"  NOTE: {nbig} gaps >5 calendar days (holidays/missing).")
    for nm in ["r_es", "r_zn"]:
        spikes = int((df[nm].abs() > 0.15).sum())
        if spikes:
            print(f"  WARNING: {spikes} {nm} moves >15% (possible bad ticks / roll errors).")

    df = add_drift_and_windows(df, args.window, args.reversal)
    mkt = df["r_es"]

    print("\n" + "=" * 80)
    print(f"STRATEGY METRICS  (window={args.window}d front-run, {args.reversal}d reversal, "
          f"cost={args.cost_ticks} tick/leg, trials={args.trials})")
    print("=" * 80)

    rows = []
    series = {}
    for variant in ["frontrun", "reversal", "combined"]:
        net, gross, active = strategy_returns(df, args.cost_ticks, variant)
        series[variant] = (net, gross, active)
        rows.append(summarize(net, active, mkt, variant, args.trials))
    print_metrics_table(rows)

    primary = rows[0]

    cost_curve = []
    for t in [0.5, 1.0, 2.0, 3.0]:
        net_t, _, _ = strategy_returns(df, t, "frontrun")
        cost_curve.append((t, ann_sharpe(net_t)))

    net_p, _, _ = series["frontrun"]
    sub, roll, yearly = subsample_and_rolling(net_p, mkt)
    print("\nSUBSAMPLE STABILITY (front-run):")
    print(f"  H1 {sub['half1_dates']}: Sharpe {fmt(sub['sharpe_h1'],2)}, beta {fmt(sub['beta_h1'],3)}")
    print(f"  H2 {sub['half2_dates']}: Sharpe {fmt(sub['sharpe_h2'],2)}, beta {fmt(sub['beta_h2'],3)}")
    print("\nYEARLY P&L (front-run, sum of daily returns):")
    for y, v in yearly.items():
        bar = "#" * int(max(v, 0) * 200)
        neg = "." * int(max(-v, 0) * 200)
        print(f"  {y}: {v*100:>6.2f}%  {neg}{bar}")

    try:
        eq = (1 + net_p.fillna(0)).cumprod()
        fig, ax = plt.subplots(3, 1, figsize=(10, 11))
        eq.plot(ax=ax[0], title="Front-run cumulative growth (1 = start)")
        ax[0].set_ylabel("growth")
        roll.plot(ax=ax[1], title="Rolling 2-year annualized Sharpe (front-run)")
        ax[1].axhline(0, color="k", lw=0.6)
        ax[1].axhline(1.0, color="g", lw=0.6, ls="--")
        ax[1].set_ylabel("Sharpe")
        ax[2].bar(yearly.index.astype(str), yearly.values * 100)
        ax[2].set_title("Yearly return (%)")
        ax[2].axhline(0, color="k", lw=0.6)
        plt.tight_layout()
        ppath = f"{args.outdir}/rebalance_pretest_diagnostics.png"
        plt.savefig(ppath, dpi=120)
        print(f"\nSaved diagnostics plot: {ppath}")
    except Exception as e:
        print(f"\n(plotting skipped: {e})")

    try:
        out = pd.DataFrame(rows).set_index("label")
        cpath = f"{args.outdir}/rebalance_pretest_results.csv"
        out.to_csv(cpath)
        print(f"Saved metrics CSV: {cpath}")
    except Exception as e:
        print(f"(results CSV skipped: {e})")

    verdict(primary, cost_curve)

    print("\nNOTE: This is a falsification GATE, not a harness. The parameters are")
    print("mechanism-fixed and were not optimized. If the verdict is KILL or FAIL,")
    print("that is the gate working — report it verbatim and do not re-tune to pass.")


if __name__ == "__main__":
    main()

