        if trm.sum()<4000 or tem.sum()<200: continue
        m = HistGradientBoostingRegressor(max_iter=300, learning_rate=0.05, max_depth=4,
                                          l2_regularization=1.0, min_samples_leaf=200, random_state=0)
        m.fit(Xm[trm], yv[trm])
        thr = np.quantile(np.abs(m.predict(Xm[trm])), max(0.0, 1.0 - 2.0*len(np.unique(sess[trm]))/trm.sum()))
        pte = np.full(n,np.nan); pte[tem]=m.predict(Xm[tem])
