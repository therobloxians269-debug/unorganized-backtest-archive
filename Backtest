#!/usr/bin/env python3
"""
FAMILY: vwap-mr   (VWAP + sigma-band mean reversion / continuation)
====================================================================
Anchored VWAPs (09:30 RTH, 18:00 day-cycle, 06:00 Europe) with volume-weighted
sigma bands.  Tests:
  * fade at 1 / 1.5 / 2 / 2.5 / 3 sigma, target VWAP or mid-band
  * momentum continuation through the same bands
  * VWAP reclaim / rejection triggers
  * band re-entry ("extension then close back inside") triggers
  * stop placement: band-based / ATR-based / structure(swing)-based / sigma-based
  * time-of-day windows, causal intraday regime filters

Splits (never tuned on OOS):
  IS   = NQ 2023-01-01 .. 2024-12-31
  OOS1 = NQ 2025-01-01 ..
  OOS2 = MNQ 2026 (all)

Costs (mandatory):
  NQ  pv=20  comm $4.00 RT  slip 0.25pt adverse on ENTRY and on STOP exits
  MNQ pv=2   comm $1.50 RT  same slip in points
Entry = NEXT bar open after the signal bar closes.
Stop assumed filled first when stop and target are both touched inside one bar.
Flat by 16:59 ET (end of the 18:00-anchored day-cycle).  No overnight carry.

Author: subagent (family scout).  Reads the shared parquets read-only.
"""
import os, sys, json, math, itertools, warnings
import numpy as np
import pandas as pd

warnings.filterwarnings("ignore")
pd.set_option("display.width", 220)
pd.set_option("display.max_columns", 60)

DIR = "/Users/kaveh/qt_cascade"
NY = "America/New_York"
RNG_MASTER = 700319

# ----------------------------------------------------------------------------
# cost model
# ----------------------------------------------------------------------------
COST = {
    "NQ":  dict(pv=20.0, comm=4.00, slip=0.25),
    "MNQ": dict(pv=2.0,  comm=1.50, slip=0.25),
}
MICRO = dict(pv=2.0, comm=1.50)          # for the 1-micro drawdown report


# ============================================================================
# 1. LOADING + CAUSAL PANEL
# ============================================================================
def load(path):
    df = pd.read_parquet(path)
    df = df.sort_index()
    return df


def _sess_ids(idx, kind, daycycle):
    """Integer session id per bar for a given VWAP anchor; -1 = outside.
       '1800' -> the 18:00-anchored day-cycle (whole cycle)
       '0930' -> 09:30..16:59 on the calendar date
       '0600' -> 06:00..16:59 on the calendar date
    """
    if kind == "1800":
        codes = pd.factorize(pd.Index(daycycle))[0]
        return codes.astype(np.int64)
    tmin = idx.hour * 60 + idx.minute
    start = {"0930": 9 * 60 + 30, "0600": 6 * 60}[kind]
    end = 16 * 60 + 59
    ok = (tmin >= start) & (tmin <= end)
    d = pd.factorize(pd.Index(idx.date))[0]
    out = np.where(ok, d, -1)
    return out.astype(np.int64)


def _grp_cumsum(x, g):
    """cumulative sum of x restarting whenever g changes (g must be blocked)."""
    cs = np.cumsum(x)
    # offset = cumulative sum at the last bar BEFORE the group started
    newg = np.empty(len(g), bool)
    newg[0] = True
    newg[1:] = g[1:] != g[:-1]
    starts = np.flatnonzero(newg)
    base = np.zeros(len(g))
    off = np.where(starts > 0, cs[starts - 1], 0.0)
    base[starts] = off
    base = np.maximum.accumulate(np.where(newg, base, -np.inf))
    base[~np.isfinite(base)] = 0.0
    # forward-fill the offsets
    idxf = np.maximum.accumulate(np.where(newg, np.arange(len(g)), -1))
    base = off[np.searchsorted(starts, idxf, side="right") - 1]
    return cs - base


def _grp_count(g):
    newg = np.empty(len(g), bool)
    newg[0] = True
    newg[1:] = g[1:] != g[:-1]
    idxf = np.maximum.accumulate(np.where(newg, np.arange(len(g)), -1))
    return np.arange(len(g)) - idxf + 1


def anchored_vwap(df, kind):
    """Volume-weighted VWAP and volume-weighted sigma, anchored per session."""
    idx = df.index
    g = _sess_ids(idx, kind, df["daycycle"].values)
    tp = ((df["h"].values + df["l"].values + df["c"].values) / 3.0)
    v = df["v"].values.astype(float)
    inside = g >= 0
    vv = np.where(inside, v, 0.0)
    pv_ = np.where(inside, tp * v, 0.0)
    p2v = np.where(inside, tp * tp * v, 0.0)
    gg = np.where(inside, g, -1)
    cv = _grp_cumsum(vv, gg)
    cpv = _grp_cumsum(pv_, gg)
    cp2 = _grp_cumsum(p2v, gg)
    n = _grp_count(gg)
    with np.errstate(invalid="ignore", divide="ignore"):
        vwap = cpv / cv
        var = cp2 / cv - vwap * vwap
    var = np.where(np.isfinite(var), np.maximum(var, 0.0), np.nan)
    sig = np.sqrt(var)
    vwap = np.where(inside, vwap, np.nan)
    sig = np.where(inside, sig, np.nan)
    nb = np.where(inside, n, 0)
    return vwap, sig, nb, gg


def build_panel(df, tag):
    """All causal arrays used by the family."""
    P = {}
    P["tag"] = tag
    P["idx"] = df.index
    P["o"] = df["o"].values.astype(float)
    P["h"] = df["h"].values.astype(float)
    P["l"] = df["l"].values.astype(float)
    P["c"] = df["c"].values.astype(float)
    P["v"] = df["v"].values.astype(float)
    n = len(df)
    P["n"] = n
    tmin = df.index.hour * 60 + df.index.minute
    P["tmin"] = tmin.values.astype(np.int32)

    # --- day-cycle blocks + last tradeable bar of each cycle (<= 16:59)
    dc = pd.factorize(pd.Index(df["daycycle"].values))[0].astype(np.int64)
    P["dc"] = dc
    newd = np.empty(n, bool); newd[0] = True; newd[1:] = dc[1:] != dc[:-1]
    starts = np.flatnonzero(newd)
    ends = np.append(starts[1:] - 1, n - 1)
    cyc_end = np.repeat(ends, np.diff(np.append(starts, n)))
    P["cyc_end"] = cyc_end.astype(np.int64)
    P["cyc_start"] = np.repeat(starts, np.diff(np.append(starts, n))).astype(np.int64)
    P["n_cycles"] = len(starts)

    # --- causal ATR on 1-min true range (shifted: known at bar close)
    c = df["c"]
    tr = pd.concat([df["h"] - df["l"], (df["h"] - c.shift()).abs(),
                    (df["l"] - c.shift()).abs()], axis=1).max(axis=1)
    P["atr30"] = tr.rolling(30, min_periods=20).mean().values
    P["atr60"] = tr.rolling(60, min_periods=40).mean().values
    P["atr390"] = tr.rolling(390, min_periods=250).mean().values

    # --- causal swing extremes (last M bars, INCLUDING current bar)
    for M in (15, 30, 60):
        P[f"swh{M}"] = df["h"].rolling(M, min_periods=M).max().values
        P[f"swl{M}"] = df["l"].rolling(M, min_periods=M).min().values

    # --- anchored VWAPs
    for kind in ("0930", "1800", "0600"):
        vw, sg, nb, gg = anchored_vwap(df, kind)
        P[f"vwap_{kind}"] = vw
        P[f"sig_{kind}"] = sg
        P[f"nb_{kind}"] = nb
        P[f"gid_{kind}"] = gg
        # causal VWAP slope over 30 bars (pts per bar), NaN early
        s = pd.Series(vw)
        P[f"slope_{kind}"] = ((s - s.shift(30)) / 30.0).values
        # running session hi/lo/open from the anchor -> efficiency ratio so far
        ins = gg >= 0
        gsafe = np.where(ins, gg, -1)
        hh = pd.Series(np.where(ins, P["h"], -np.inf)).groupby(gsafe).cummax().values
        ll = pd.Series(np.where(ins, P["l"], np.inf)).groupby(gsafe).cummin().values
        oo = pd.Series(np.where(ins, P["o"], np.nan)).groupby(gsafe).transform("first").values
        rng = hh - ll
        with np.errstate(invalid="ignore", divide="ignore"):
            er = np.abs(P["c"] - oo) / np.where(rng > 0, rng, np.nan)
        P[f"er_{kind}"] = np.where(ins, er, np.nan)
        # number of VWAP crosses so far this session (causal, closes)
        above = P["c"] > vw
        x = np.zeros(len(vw))
        x[1:] = ((above[1:] != above[:-1]) & ins[1:] & ins[:-1]).astype(float)
        P[f"ncx_{kind}"] = _grp_cumsum(np.where(ins, x, 0.0), gsafe)
    return P


# ============================================================================
# 2. SIGNAL GENERATION  (vectorised; returns candidate (pos, event_sign))
# ============================================================================
def candidates(P, anchor, k, trigger, minbar):
    """Return (positions, event_sign) of signal BARS.  Entry is at pos+1 open.
       event_sign = +1 -> the event is an UPWARD extension / upward vwap cross.
    """
    vw = P[f"vwap_{anchor}"]; sg = P[f"sig_{anchor}"]
    nb = P[f"nb_{anchor}"];  gid = P[f"gid_{anchor}"]
    c, h, l = P["c"], P["h"], P["l"]
    n = P["n"]
    ok = (gid >= 0) & (nb >= minbar) & np.isfinite(vw) & np.isfinite(sg) & (sg > 0)
    prev_same = np.zeros(n, bool)
    prev_same[1:] = (gid[1:] == gid[:-1])
    ok = ok & prev_same
    up = vw + k * sg
    dn = vw - k * sg

    if trigger == "cross":                    # close crosses the band outward
        a = np.zeros(n, bool); a[1:] = (c[1:] > up[1:]) & (c[:-1] <= up[:-1])
        b = np.zeros(n, bool); b[1:] = (c[1:] < dn[1:]) & (c[:-1] >= dn[:-1])
    elif trigger == "touch":                  # wick touches the band, new touch
        au = h >= up; ad = l <= dn
        a = np.zeros(n, bool); a[1:] = au[1:] & ~au[:-1]
        b = np.zeros(n, bool); b[1:] = ad[1:] & ~ad[:-1]
    elif trigger == "reenter":                # was outside, closes back inside
        au = c > up; ad = c < dn
        a = np.zeros(n, bool); a[1:] = ~au[1:] & au[:-1]
        b = np.zeros(n, bool); b[1:] = ~ad[1:] & ad[:-1]
    elif trigger == "vwapx":                  # close crosses the VWAP itself
        a = np.zeros(n, bool); a[1:] = (c[1:] > vw[1:]) & (c[:-1] <= vw[:-1])
        b = np.zeros(n, bool); b[1:] = (c[1:] < vw[1:]) & (c[:-1] >= vw[:-1])
    elif trigger == "vwaprej":                # tests VWAP from one side and fails
        a = np.zeros(n, bool)
        a[1:] = (h[1:] >= vw[1:]) & (c[1:] < vw[1:]) & (c[:-1] < vw[:-1])
        b = np.zeros(n, bool)
        b[1:] = (l[1:] <= vw[1:]) & (c[1:] > vw[1:]) & (c[:-1] > vw[:-1])
    else:
        raise ValueError(trigger)
    a &= ok; b &= ok
    pos = np.flatnonzero(a | b)
    ev = np.where(a[pos], 1, -1).astype(np.int8)
    return pos, ev


# ============================================================================
# 3. TRADE SIMULATION
# ============================================================================
def _first_hit(h, l, i0, i1, stop, targ, d):
    """First stop/target touch in [i0,i1].  Stop wins ties inside a bar."""
    if i1 < i0:
        return None, None
    hs = h[i0:i1 + 1]; ls = l[i0:i1 + 1]
    if d == 1:
        sb = ls <= stop; tb = hs >= targ
    else:
        sb = hs >= stop; tb = ls <= targ
    si = int(np.argmax(sb)) if sb.any() else -1
    ti = int(np.argmax(tb)) if tb.any() else -1
    if si < 0 and ti < 0:
        return None, None
    if si >= 0 and (ti < 0 or si <= ti):
        return i0 + si, "stop"
    return i0 + ti, "targ"


def simulate(P, cfg, mkt, cand=None):
    """Run one config.  Returns a DataFrame of trades."""
    pv = COST[mkt]["pv"]; comm = COST[mkt]["comm"]; slip = COST[mkt]["slip"]
    anchor = cfg["anchor"]; k = cfg["k"]
    o, h, l, c = P["o"], P["h"], P["l"], P["c"]
    vw = P[f"vwap_{anchor}"]; sg = P[f"sig_{anchor}"]; gid = P[f"gid_{anchor}"]
    cyc_end = P["cyc_end"]; tmin = P["tmin"]; n = P["n"]

    if cand is None:
        cand = candidates(P, anchor, k, cfg["trigger"], cfg.get("minbar", 30))
    cpos, cev = cand

    s = 1 if cfg["side"] == "momo" else -1          # fade = trade against the event
    w0, w1 = cfg.get("win", (0, 24 * 60))           # entry window in minutes-of-day
    max_hold = cfg.get("max_hold", 390)
    cool = cfg.get("cool", 15)
    maxtr = cfg.get("maxtr", 4)
    st_kind, st_par = cfg["stop"]
    tg_kind, tg_par = cfg["targ"]
    off = cfg.get("t_off", 0)                       # placebo timestamp offset (bars)

    # entry-window mask on the SIGNAL bar
    if w1 >= w0:
        wm = (tmin >= w0) & (tmin <= w1)
    else:
        wm = (tmin >= w0) | (tmin <= w1)
    # causal regime filters
    fm = np.ones(n, bool)
    filt = cfg.get("filt")
    if filt is not None:
        fk, fop, fv = filt
        arr = P[f"{fk}_{anchor}"]
        fm = (arr <= fv) if fop == "le" else (arr >= fv)
        fm = fm & np.isfinite(arr)

    keep = wm[cpos] & fm[cpos]
    cpos = cpos[keep]; cev = cev[keep]
    if len(cpos) == 0:
        return pd.DataFrame()

    rows = []
    cursor = -1
    per_cycle = {}
    dcarr = P["dc"]
    for ii in range(len(cpos)):
        i = int(cpos[ii])
        if i <= cursor:
            continue
        ep = i + 1 + off                             # entry bar (next bar open)
        if ep >= n or ep <= i:
            continue
        # placebo offset must not leave the day-cycle / must stay tradeable
        cyc = dcarr[ep]
        if off != 0 and dcarr[i] != cyc:
            continue
        last = int(cyc_end[ep])
        last = min(last, ep + max_hold)
        if last <= ep:
            continue
        if per_cycle.get(cyc, 0) >= maxtr:
            continue
        d = int(s * cev[ii])
        px = o[ep]
        if not np.isfinite(px) or px <= 0:
            continue
        e = px + d * slip                            # adverse entry slip

        # ---- stop
        if st_kind == "band":
            sl = vw[i] + cev[ii] * (k + st_par) * sg[i]
        elif st_kind == "sig":
            sl = e - d * st_par * sg[i]
        elif st_kind == "atr":
            sl = e - d * st_par * P["atr30"][i]
        elif st_kind == "atr60":
            sl = e - d * st_par * P["atr60"][i]
        elif st_kind == "swing":
            sl = (P[f"swl{st_par}"][i] if d == 1 else P[f"swh{st_par}"][i])
            sl = sl - d * 0.25 * P["atr30"][i]
        elif st_kind == "vwap":                      # stop on the far side of VWAP
            sl = vw[i] - d * st_par * sg[i]
        else:
            raise ValueError(st_kind)
        if not np.isfinite(sl):
            continue
        risk = d * (e - sl)
        lo_r = max(5.0, 0.0002 * px)
        hi_r = min(400.0, 0.015 * px)
        if not (lo_r <= risk <= hi_r):
            continue

        # ---- target
        if tg_kind == "vwap":
            tg = vw[i]
        elif tg_kind == "mid":
            tg = vw[i] + cev[ii] * (k * tg_par) * sg[i]
        elif tg_kind == "rr":
            tg = e + d * tg_par * risk
        elif tg_kind == "oppband":
            tg = vw[i] - cev[ii] * tg_par * sg[i]
        else:
            raise ValueError(tg_kind)
        if not np.isfinite(tg):
            continue
        if d * (tg - e) <= 0.5:                      # target must be ahead of entry
            continue

        xp, hit = _first_hit(h, l, ep, last, sl, tg, d)
        if xp is None:
            xp = last; hit = "time"
            xpx = c[last]
        elif hit == "stop":
            xpx = sl - d * slip                      # adverse slip on stop exits
        else:
            xpx = tg
        pts = d * (xpx - e)
        usd = pts * pv - comm
        usd_micro = pts * MICRO["pv"] - MICRO["comm"]
        rows.append(dict(sig=i, ep=ep, xp=xp, d=d, ev=int(cev[ii]), hit=hit,
                         e=e, sl=sl, tg=tg, risk=risk, pts=pts,
                         usd=usd, usd_micro=usd_micro,
                         R=usd / (risk * pv), hold=xp - ep,
                         ts=P["idx"][ep], cyc=int(cyc)))
        per_cycle[cyc] = per_cycle.get(cyc, 0) + 1
        cursor = xp + cool
    return pd.DataFrame(rows)


