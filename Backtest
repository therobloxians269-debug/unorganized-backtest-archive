    print(f"  -> {'PLATEAU (robust)' if pct(shp,5)>1.0 else 'sensitive'}: even the 5th-percentile weighting gives {pct(shp,5):.2f}")

    # ---- 3. randomized null ----
    print(f"\nRANDOMIZED NULL (flip each week's sign randomly, {N:,} draws):")
    null = np.array([stats(w * rng.choice([-1, 1], n))[0] for _ in range(2000)])
    z = (base_sh - null.mean()) / null.std()
    print(f"  null Sharpe ~ {null.mean():.2f} +/- {null.std():.2f}; actual {base_sh:.2f} is {z:.1f} sigma above null")


