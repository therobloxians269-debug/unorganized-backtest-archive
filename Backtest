#!/usr/bin/env python3
"""
selftest.py — deterministic unit checks for every primitive.

These are not performance claims; they assert *correctness*: that an FVG is where
it should be, that a swing is only confirmed `right` bars late (no look-ahead),
that a raid is read on the right side, that OTE math is exact, and that the engine
books a winner as a winner and a loser as a loser. Run before trusting any output.
"""
from __future__ import annotations

import numpy as np
import pandas as pd

from ict.structure import find_swings, track_structure
from ict.imbalance import find_fvgs, displacement_at, order_block_before
from ict.indicators import rolling_atr_array
from ict.liquidity import Level, find_sweeps
from ict.premium_discount import Range, ote_zone, in_ote
from ict.volume_profile import build_profile
from ict.smt import smt_confirms
from ict.models import Setup
from ict.risk import EngineConfig
from ict.engine import run_backtest

PASS, FAIL = 0, 0


def check(name, cond):
    global PASS, FAIL
    if cond:
        PASS += 1
        print(f"  ok   {name}")
    else:
        FAIL += 1
        print(f"  FAIL {name}")


def mkdf(o, h, l, c, v=None):
    n = len(c)
    idx = pd.date_range("2024-06-03 09:30", periods=n, freq="5min", tz="UTC")
    v = v if v is not None else [1000.0] * n
    return pd.DataFrame({"open": o, "high": h, "low": l, "close": c, "volume": v}, index=idx)


def test_fvg():
    print("FVG detection")
    # bullish 3-candle imbalance: low[2]=12 > high[0]=10  -> gap [10,12], ce=11
    df = mkdf(o=[9, 11, 13], h=[10, 13, 15], l=[9, 11, 12], c=[9.5, 12.5, 14])
    fv = find_fvgs(df)
    check("one bullish FVG found", len(fv) == 1 and fv[0].direction == 1)
    check("FVG bounds [10,12]", abs(fv[0].bottom - 10) < 1e-9 and abs(fv[0].top - 12) < 1e-9)
    check("FVG consequent encroachment = 11", abs(fv[0].ce - 11) < 1e-9)
    # bearish: high[2]=8 < low[0]=10 -> gap [8,10]
    df2 = mkdf(o=[11, 9, 7], h=[12, 9, 8], l=[10, 7, 6], c=[10.5, 7.5, 6.5])
    fv2 = find_fvgs(df2)
    check("one bearish FVG found", len(fv2) == 1 and fv2[0].direction == -1)


def test_swings_no_lookahead():
    print("swings + no-lookahead confirmation")
    df = mkdf(o=[1, 2, 5, 2, 1], h=[1, 2, 5, 2, 1], l=[0, 1, 4, 1, 0],
              c=[1, 2, 5, 2, 1])
    sw = find_swings(df, left=1, right=1)
    highs = [s for s in sw if s.kind == "H"]
    check("swing high at idx 2", any(s.idx == 2 for s in highs))
    top = next(s for s in highs if s.idx == 2)
    check("confirmed exactly right=1 bars later", top.confirm_idx == 3)
    check("confirm_idx == idx+right for all swings",
          all(s.confirm_idx == s.idx + 1 for s in sw))


def test_structure():
    print("structure BOS/CHoCH")
    h = [10, 11, 12, 11, 10, 11, 12, 13]
    l = [9, 10, 11, 10, 9, 10, 11, 12]
    c = [9.5, 10.5, 11.5, 10.5, 9.5, 10.5, 11.5, 12.8]
    df = mkdf(o=c, h=h, l=l, c=c)
    sw = find_swings(df, 1, 1)
    ev = track_structure(df, sw)
    check("at least one structure event", len(ev) >= 1)
    check("first break is bullish", ev[0].direction == 1)


def test_sweep():
    print("liquidity sweep")
    df = mkdf(o=[101, 101, 101], h=[102, 102, 102], l=[100, 99, 100],
              c=[101, 101, 101])
    lv = [Level(known_idx=0, price=100.0, ltype="PDL", side=-1)]  # old low = sell-side
    sweeps = find_sweeps(df, lv, expiry_bars=10)
    check("sell-side raid detected", len(sweeps) == 1 and sweeps[0].reversal_dir == 1)
    check("raid bar = 1, extreme = 99", sweeps[0].idx == 1 and abs(sweeps[0].extreme - 99) < 1e-9)


def test_premium_discount():
    print("premium/discount + OTE")
    r = Range(0.0, 100.0)
    check("50 is equilibrium", r.zone(50) == "equilibrium")
    check("25 is discount", r.zone(25) == "discount")
    check("75 is premium", r.zone(75) == "premium")
    lo, hi = ote_zone(0, 100, +1)
    check("long OTE ~ [21,38]", abs(lo - 21) < 1e-6 and abs(hi - 38) < 1e-6)
    check("30 in long OTE", in_ote(30, 0, 100, +1))
    check("50 not in long OTE", not in_ote(50, 0, 100, +1))


def test_volume_profile():
    print("volume profile POC")
    # heavy volume around 100, light elsewhere
    o = [95, 100, 105, 100, 90]
    h = [96, 101, 106, 101, 91]
    l = [94, 99, 104, 99, 89]
    c = [95, 100, 105, 100, 90]
    v = [100, 5000, 100, 5000, 100]
    df = mkdf(o, h, l, c, v)
    vp = build_profile(df, np.arange(len(c)), bin_size=1.0)
    check("POC near 100", abs(vp.poc - 100) <= 1.0)
    check("value area brackets POC", vp.val <= vp.poc <= vp.vah)


def test_smt():
    print("SMT divergence")
    n = 40
    base = np.linspace(100, 90, n)                 # primary drifts to a new low
    prim = mkdf(base, base + 1, base - 1, base)
    flat = np.concatenate([np.linspace(100, 95, n - 5), np.full(5, 96.0)])  # secondary holds
    sec = mkdf(flat, flat + 1, flat - 1, flat)
    check("bullish SMT (primary new low, secondary holds)",
          smt_confirms(prim, sec, n - 1, +1, lookback=30, recent=4))
    check("no bearish SMT here", not smt_confirms(prim, sec, n - 1, -1, lookback=30, recent=4))


def test_displacement_and_ob():
    print("displacement + order block")
    # a quiet run then a large up candle (close>>open) that also prints an FVG
    o = [100, 100.2, 100.1, 100.0, 100.3, 100.5]
    c = [100.2, 100.1, 100.0, 100.3, 100.4, 107.5]
    h = [100.3, 100.3, 100.2, 100.4, 100.5, 108.5]
    l = [99.9, 100.0, 99.9, 99.9, 100.2, 100.45]  # low[5]=100.45 > high[3]=100.4 -> bull FVG
    df = mkdf(o, h, l, c)
    atr = rolling_atr_array(df, period=3)
    check("displacement flagged at the impulse bar", displacement_at(df, 5, +1, atr, lookback=3, body_mult=1.0))
    ob = order_block_before(df, 5, +1, max_lookback=5)
    check("bullish OB is the last down-close before impulse", ob is not None and ob.direction == 1)


def test_engine_winner_and_loser():
    print("engine books winners/losers correctly")
    cfg = EngineConfig(commission_per_contract=0.0, slippage_ticks=0.0,
                       partial_enabled=False, risk_per_trade=100.0, point_value=1.0)
    # WINNER: fill at 100, target 106 (3R on 2pt risk)
    o = [100, 100, 101]; h = [100, 101, 107]; l = [100, 100, 101]; c = [100, 100, 106]
    df = mkdf(o, h, l, c)
    win = Setup(arm_idx=0, expiry_idx=10, direction=+1, entry=100.0, stop=98.0,
                target=106.0, model="t", score=0)
    res = run_backtest(df, [win], cfg)
    check("winner booked, R ~ +3", not res["trades"].empty and res["trades"]["R"].iloc[0] > 2.5)

    # LOSER: fill at 100, then stop at 98
    o = [100, 100, 100]; h = [100, 101, 100]; l = [100, 100, 97]; c = [100, 100, 97.5]
    df2 = mkdf(o, h, l, c)
    lose = Setup(arm_idx=0, expiry_idx=10, direction=+1, entry=100.0, stop=98.0,
                 target=110.0, model="t", score=0)
    res2 = run_backtest(df2, [lose], cfg)
    check("loser booked, R ~ -1", not res2["trades"].empty and res2["trades"]["R"].iloc[0] < -0.9)


def main():
    for t in (test_fvg, test_swings_no_lookahead, test_structure, test_sweep,
              test_premium_discount, test_volume_profile, test_smt,
              test_displacement_and_ob, test_engine_winner_and_loser):
        t()
    print(f"\n{PASS} passed, {FAIL} failed")
    raise SystemExit(1 if FAIL else 0)


if __name__ == "__main__":
    main()

