#!/usr/bin/env python3
"""OCEAN family f14_close_to_globex — post-RTH-close behavior conditioned on the
RTH day character (day move in ATR units), traded in the 16:00-23:00 ET evening.

Variants (all fixed clocks, market in / market out, flat well before next RTH):
  A: enter at RTH close (close of 15:59 bar), exit 17:00 / 18:01 / 20:00
  B: enter at first Globex bar close (18:01), exit 21:00 / 23:00
  C: enter at 15:55 (close of 15:54 bar), exit 18:01
Direction: cont = with the RTH day move, fade = against it.
Condition: |z| >= thr where z = (close16 - open0930) / ATR14(daily RTH range),
ATR strictly from prior 14 days. Optional vwap gate: RTH close vs RTH vwap must
agree with the day move sign.

Roll safety: the front-month splice jumps live in mid Mar/Jun/Sep/Dec; all days
with month in {3,6,9,12} and day-of-month 8..16 are excluded from trading.
Trades never hold across midnight (00:00 splices) or a weekend.

Friction: every leg is a market fill -> fric("eod") = 0.66 pt per round trip.
Causality: z/vwap known at the entry-bar close; fills at that same close.
"""
import sys, json, argparse, os
sys.path.insert(0, "/Users/kaveh/mes_mim")
import numpy as np
import pandas as pd
from omni2_lib import fric, DPP

PARQ = "/Users/kaveh/omni_x/es_front_2017_24h_1m.parquet"
DEV_END = pd.Timestamp("2023-01-01", tz="America/New_York")
RESULTS_DIR = "/Users/kaveh/mes_mim/ocean/results"
FRIC_RT = fric("eod")  # 0.66 pt: market entry + market exit

# ---------------- PRE-REGISTERED CONFIG (defaults) ----------------
PREREG = dict(entry=1555, exit=1801, dirn="cont", thr=1.00, vwap_gate=False)
# VERDICT: DEAD. Best cell of the sweep (above) fails the survival bar and the
# plateau rule: (1) 2019 = $262 of $460 net = 57% > 50% single-year cap, and
# top-3 months > 100% of net; (2) entry-clock neighbor e1600->x1801 cont
# thr=1.00 = -$491 (needle on the entry axis). Decomposition: at thr=1.00 the
# gross 15:55->18:01 cont edge is +1.30 pt while gross 16:00->18:01 cont is
# -0.02 pt, i.e. ALL edge sits in the 15:55-16:00 cash-close burst (the
# already-killed last-minutes MIM bet) and the evening/Globex leg is pure
# noise+friction drag. 27 of 32 cells are net-negative, most with expectancy
# ~= -0.66 pt = pure friction on zero gross edge. Defaults kept only so the
# stats block shows the family best case; do NOT trade this.
# -------------------------------------------------------------------

# price columns needed per clock: label -> (tod of bar whose CLOSE we use)
CLOCKS = {1555: 1554, 1600: 1559, 1700: 1659, 1801: 1800, 2000: 1959,
          2100: 2059, 2300: 2259}


def load(window):
    df = pd.read_parquet(PARQ)
    df = df.assign(ts=df["ts_event"].dt.tz_convert("America/New_York"))
    if window == "dev":
        df = df[df["ts"] < DEV_END]
    elif window == "holdout":
        df = df[df["ts"] >= DEV_END]
    return df.reset_index(drop=True)


def daily_table(df):
    d = df
    tod = d["ts"].dt.hour * 100 + d["ts"].dt.minute
    date = d["ts"].dt.date
    rth = d[(tod >= 930) & (tod <= 1559)]
    rtod = rth["ts"].dt.hour * 100 + rth["ts"].dt.minute
    rdate = rth["ts"].dt.date
    g = rth.groupby(rdate)
    tab = pd.DataFrame({
        "hi": g["high"].max(), "lo": g["low"].min(),
        "nbars": g["close"].size(),
        "pv": (rth["close"] * rth["volume"]).groupby(rdate).sum(),
        "vv": g["volume"].sum(),
    })
    tab["vwap"] = tab["pv"] / tab["vv"]
    o930 = rth[rtod == 930].set_index(rdate[rtod == 930])["open"]
    tab["o930"] = o930
    for lbl, btod in CLOCKS.items():
        rows = d[tod == btod]
        tab[f"p{lbl}"] = rows.set_index(date[tod == btod])["close"]
    tab = tab.sort_index()
    tab["rng"] = tab["hi"] - tab["lo"]
    tab["atr14"] = tab["rng"].shift(1).rolling(14).mean()
    tab["z"] = (tab["p1600"] - tab["o930"]) / tab["atr14"]
    tab["vwap_up"] = tab["p1600"] > tab["vwap"]
    idx = pd.to_datetime(pd.Series(tab.index, index=tab.index))
    tab["year"] = idx.dt.year
    tab["ym"] = idx.dt.strftime("%Y-%m")
    roll_win = idx.dt.month.isin([3, 6, 9, 12]) & idx.dt.day.between(8, 16)
    full_day = tab["nbars"] >= 300
    tab["eligible"] = full_day & ~roll_win & tab["atr14"].notna()
    return tab


def run_cfg(tab, cfg):
    t = tab[tab["eligible"]].copy()
    z = t["z"]
    sel = z.abs() >= cfg["thr"]
    if cfg.get("vwap_gate"):
        sel &= (t["vwap_up"] == (z > 0))
    e_px = t[f"p{cfg['entry']}"]
    x_px = t[f"p{cfg['exit']}"]
    sel &= e_px.notna() & x_px.notna() & (z != 0)
    side = np.sign(z) * (1.0 if cfg["dirn"] == "cont" else -1.0)
    pts = (side * (x_px - e_px) - FRIC_RT)[sel]
    tt = t[sel]
    return pd.DataFrame({"pts": pts, "usd": pts * DPP,
                         "year": tt["year"], "ym": tt["ym"]})


def stats(tr):
    if len(tr) == 0:
        return dict(net_usd=0.0, mar=0.0, trades=0, hit=0.0, maxdd_usd=0.0,
                    yearly={}, top3_month_share=0.0, expectancy_pts=0.0)
    eq = tr["usd"].cumsum()
    dd = float((eq - eq.cummax()).min())
    net = float(tr["usd"].sum())
    yearly = {str(int(y)): round(float(v), 2) for y, v in tr.groupby("year")["usd"].sum().items()}
    mo = tr.groupby("ym")["usd"].sum().sort_values(ascending=False)
    top3 = float(mo.head(3).sum() / net) if net != 0 else 0.0
    return dict(net_usd=round(net, 2),
                mar=round(net / abs(dd), 3) if dd < 0 else float("inf"),
                trades=int(len(tr)), hit=round(float((tr["pts"] > 0).mean()), 4),
                maxdd_usd=round(dd, 2), yearly=yearly,
                top3_month_share=round(top3, 4),
                expectancy_pts=round(float(tr["pts"].mean()), 4))


def cfg_label(c):
    return (f"e{c['entry']:04d}->x{c['exit']:04d} {c['dirn']:4s} thr={c['thr']:.2f}"
            + (" vwapG" if c.get("vwap_gate") else "      "))


# ---------------- SWEEP GRID (dev only; every cell counts) ----------------
SWEEP = []
for ex in (1700, 1801, 2000):                      # A: 16:00 entry
    for dirn in ("cont", "fade"):
        for thr in (0.50, 1.00):
            SWEEP.append(dict(entry=1600, exit=ex, dirn=dirn, thr=thr, vwap_gate=False))
for dirn in ("cont", "fade"):                      # C: 15:55 entry
    for thr in (0.50, 1.00):
        SWEEP.append(dict(entry=1555, exit=1801, dirn=dirn, thr=thr, vwap_gate=False))
for ex in (2100, 2300):                            # B: 18:01 entry, reversion
    for thr in (0.50, 0.75, 1.00):
        SWEEP.append(dict(entry=1801, exit=ex, dirn="fade", thr=thr, vwap_gate=False))
for ex in (2100, 2300):                            # B continuation probe
    SWEEP.append(dict(entry=1801, exit=ex, dirn="cont", thr=0.50, vwap_gate=False))
# refinement cells (thr plateau neighbors around the strongest region)
for ex in (1700, 1801, 2000):
    for thr in (0.25, 0.75):
        SWEEP.append(dict(entry=1600, exit=ex, dirn="fade", thr=thr, vwap_gate=False))
# plateau verification of the single positive cell (e1555 cont thr=1.00):
for thr in (0.75, 1.25):
    SWEEP.append(dict(entry=1555, exit=1801, dirn="cont", thr=thr, vwap_gate=False))
