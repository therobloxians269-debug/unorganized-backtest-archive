def pre_for(d):
    b15, b5 = _stamp(Q.resample(d, "15min")), _stamp(Q.resample(d, "5min"))
    p = {"b15": b15, "b5": b5}
    for s in ("short", "long"):
        p[f"s15_{s}"] = Q.ssmt(b15, lookback=LB, side=s, require_both=BOTH)
        p[f"s5_{s}"] = Q.ssmt(b5, lookback=LB, side=s, require_both=BOTH)
    return p


