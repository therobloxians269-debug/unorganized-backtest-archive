    print("\nReturn contribution:\n", (A.return_contribution(comp, program) * 100).round(0))
    print("\nRisk contribution:\n", (A.risk_contribution(comp, program) * 100).round(0))
    print("\nTail (monthly):", {k: round(v * 100, 2) for k, v in A.tail_risk(program).items()})
