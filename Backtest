"""Build & cache continuous front-month ES RTH 1-min bars from the GLBX parent file.
Outrights only, volume-based roll, DST-aware New York sessions. One-time heavy step.
    python3 build_bars.py  ->  es_front_rth_1m.parquet
"""
from __future__ import annotations
import re
import pandas as pd
import databento as db

OHLCV = "/Users/kaveh/Downloads/GLBX-20260607-YKKXM4QJ9A/glbx-mdp3-20100606-20260606.ohlcv-1m.dbn.zst"
OUT = "/Users/kaveh/mim_research/es_front_rth_1m.parquet"
OUTRIGHT = re.compile(r"^ES[FGHJKMNQUVXZ]\d$")


def main():
    print("Loading DBN...", flush=True)
    df = db.DBNStore.from_file(OHLCV).to_df()
    df = df[df["symbol"].str.match(OUTRIGHT)]
    idx = df.index
    et = (idx if idx.tz is not None else idx.tz_localize("UTC")).tz_convert("America/New_York")
    df = df.assign(et=et)
    df["date"] = df["et"].dt.normalize().dt.tz_localize(None)
    df["hm"] = df["et"].dt.strftime("%H:%M")
    rth = df[(df["et"].dt.time >= pd.Timestamp("09:30").time()) &
             (df["et"].dt.time <= pd.Timestamp("15:59").time())]
    # front month = most RTH volume that day
    dayvol = rth.groupby(["date", "symbol"])["volume"].sum().reset_index()
    front = dayvol.sort_values("volume").groupby("date").tail(1)[["date", "symbol"]].rename(
        columns={"symbol": "front"})
    rth = rth.merge(front, on="date")
    rth = rth[rth["symbol"] == rth["front"]]
    keep = rth[["date", "hm", "open", "high", "low", "close", "volume", "front"]].reset_index(drop=True)
    keep.to_parquet(OUT)
    print(f"saved {len(keep):,} rows -> {OUT}")
    print(f"{keep['date'].min().date()} -> {keep['date'].max().date()} | days={keep['date'].nunique()}")


if __name__ == "__main__":
    main()

