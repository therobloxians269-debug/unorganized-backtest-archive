"""
data.py — loading and multi-timeframe resampling.

ICT is a top-down, multi-timeframe discipline: a live trader reads bias off the
daily/4H, refines structure on 15m/5m, and executes on 1m. This module gives the
engine the same layered view from a single 1-minute base feed, all tz-aware so
that session/killzone logic (which is defined in New York time) is exact.
"""
from __future__ import annotations

import pandas as pd

NY_TZ = "America/New_York"

# Canonical OHLCV columns the whole engine expects.
OHLCV = ["open", "high", "low", "close", "volume"]

# pandas resample rules keyed by a friendly timeframe name.
TF_RULES = {
    "1m": "1min",
    "2m": "2min",
    "3m": "3min",
    "5m": "5min",
    "15m": "15min",
    "30m": "30min",
    "1h": "1h",
    "4h": "4h",
    "1d": "1D",
    "1w": "1W",
}


# Timestamp column names seen across the user's real feeds (Databento, etc.).
_TS_COLS = ("timestamp", "time", "date", "datetime", "ts", "ts_event")


def _finalize(df: pd.DataFrame, path: str) -> pd.DataFrame:
    """Shared normalization: pick a timestamp column, index UTC-aware, keep OHLCV."""
    df.columns = [c.strip().lower() for c in df.columns]

    ts_col = next((c for c in _TS_COLS if c in df.columns), None)
    if ts_col is None:
        raise ValueError(f"{path}: no timestamp column found (looked for {_TS_COLS})")

    ts = df[ts_col]
    if pd.api.types.is_numeric_dtype(ts):
        unit = "ms" if float(ts.iloc[0]) > 1e11 else "s"
        idx = pd.to_datetime(ts, unit=unit, utc=True)
    else:
        idx = pd.to_datetime(ts, utc=True)   # tz-aware inputs are converted to UTC

    df = df.set_index(idx).sort_index()
    df.index.name = "timestamp"

    missing = [c for c in OHLCV if c not in df.columns]
    if "volume" in missing:  # tolerate a feed with no volume
        df["volume"] = 0.0
        missing.remove("volume")
    if missing:
        raise ValueError(f"{path}: missing columns {missing}")

    df = df[OHLCV].astype(float)
    df = df[~df.index.duplicated(keep="last")]
    return df


def load_csv(path: str) -> pd.DataFrame:
    """Load an OHLCV CSV into a tz-aware (UTC) DataFrame indexed by timestamp."""
    return _finalize(pd.read_csv(path), path)


def load(path: str) -> pd.DataFrame:
    """Load OHLCV from CSV or Parquet (dispatch on extension). Same UTC-indexed frame."""
    if path.endswith((".parquet", ".pq")):
        return _finalize(pd.read_parquet(path), path)
    return load_csv(path)


def to_ny(df: pd.DataFrame) -> pd.DataFrame:
    """Return a copy whose index is expressed in New York time (DST-aware)."""
    out = df.copy()
    out.index = out.index.tz_convert(NY_TZ)
    return out


def resample(df: pd.DataFrame, tf: str) -> pd.DataFrame:
    """Resample a base feed to a higher timeframe with correct OHLCV aggregation.

    Bars are labeled by their *open* time (label='left', closed='left'), which is
    the causal convention: a bar stamped 09:30 covers 09:30:00–09:30:59 and is
    only complete once the next stamp prints.
    """
    if tf not in TF_RULES:
        raise ValueError(f"unknown timeframe {tf!r}; known={list(TF_RULES)}")
    agg = {"open": "first", "high": "max", "low": "min", "close": "last", "volume": "sum"}
    out = df.resample(TF_RULES[tf], label="left", closed="left").agg(agg).dropna(subset=["open"])
    return out


def session_date(df_ny: pd.DataFrame) -> pd.Series:
    """The ICT 'trading day' each NY-time bar belongs to.

    ICT runs its day from the 18:00 ET CME open, so an 18:00–23:59 bar belongs to
    the *next* calendar date's session (the standard futures convention). This is
    what PDH/PDL and daily-open logic key off.
    """
    idx = df_ny.index
    d = idx.normalize()
    roll = idx.hour >= 18
    return pd.Series(d, index=idx) + pd.to_timedelta(roll.astype(int), unit="D")

