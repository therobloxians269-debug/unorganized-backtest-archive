"""
TERMINUS · M1 — the state estimator, and the two gates that decide if it is real.

    P(the running extreme on this side is the day's final extreme | causal state at t)

Fit on ES 2010-2019 ONLY. Everything else is scored, never fitted.

GATE 1 — TIME CONTROL. Elapsed time alone is hugely predictive: at 15:55 almost
every running extreme survives, trivially. A model that merely relearns the clock is
worthless. The full model must beat an elapsed-time-only model on held-out data.
This is the control that killed hod_detection and it is the one that matters.

GATE 2 — LABEL PLACEBO. Shuffle survival labels within checkpoint. AUC must collapse
to ~0.50. If it does not, the harness leaks.

GATE 3 — TRANSFER. NQ and MNQ are never trained on. If the state is a real
market-wide latent, performance carries across instruments untouched.
"""
import numpy as np, pandas as pd, warnings, pickle, sys
warnings.filterwarnings('ignore')
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import roc_auc_score, brier_score_loss
import data as D, feats as F

RS = np.random.default_rng(7)


def build_events(which, cache=True):
    import os
    p = f'/Users/kaveh/terminus/cache_ev_{which}.parquet'
    if cache and os.path.exists(p):
        return pd.read_parquet(p)
    d = D.load(which)
    day, r = D.sessions(d)
    rb = D.rth_bars(r)
    ev = F.events(day, rb)
    os.makedirs('/Users/kaveh/terminus', exist_ok=True)
    ev.to_parquet(p)
    return ev


class Model:
    """Two logistics, one per side. Standardised inputs so coefficients are readable
    and so the Pine port only needs mean/scale constants."""

    def __init__(self, feats=F.FEATS):
        self.feats = feats
        self.mu, self.sd, self.M = {}, {}, {}

    def fit(self, tr):
        for side in ('hi', 'lo'):
            g = tr[tr.side == side]
            X = g[self.feats].values.astype(float)
            mu, sd = X.mean(0), X.std(0) + 1e-9
            self.mu[side], self.sd[side] = mu, sd
            self.M[side] = LogisticRegression(max_iter=4000, C=1.0).fit(
                (X - mu) / sd, g.surv.values.astype(int))
        return self

    def predict(self, d):
        out = np.full(len(d), np.nan)
        sv = d.side.values
        for side in ('hi', 'lo'):
            m = sv == side
            if m.sum():
                X = d.loc[m, self.feats].values.astype(float)
                out[m] = self.M[side].predict_proba((X - self.mu[side]) / self.sd[side])[:, 1]
        return out


if __name__ == '__main__':
