# 6. SELFTEST
# ============================================================================
def selftest(PN):
    P, mkt = PN["IS"]
    ok = 0; tot = 0

    def chk(name, cond, extra=""):
        nonlocal ok, tot
        tot += 1
        if cond: ok += 1
        print(f"  [{'PASS' if cond else 'FAIL'}] {name} {extra}")

    # 1. VWAP sanity: inside the session hi/lo range
    for a in ("0930", "1800", "0600"):
        vw = P[f"vwap_{a}"]; g = P[f"gid_{a}"]
        m = (g >= 0) & np.isfinite(vw)
        chk(f"vwap_{a} within [l,h] envelope",
            bool(np.all(vw[m] >= P["l"][m].min() - 1) and np.all(vw[m] <= P["h"][m].max() + 1)))
        # first bar of a session: vwap == typical price of that bar
        nb = P[f"nb_{a}"]
        f = m & (nb == 1)
        tp = (P["h"] + P["l"] + P["c"]) / 3.0
        chk(f"vwap_{a} bar1 == typical price",
            bool(np.nanmax(np.abs(vw[f] - tp[f])) < 1e-6),
            f"maxdev={np.nanmax(np.abs(vw[f]-tp[f])):.2e}")
        chk(f"sig_{a} bar1 == 0", bool(np.nanmax(P[f'sig_{a}'][f]) < 1e-6))
        chk(f"sig_{a} non-negative", bool(np.nanmin(P[f'sig_{a}'][m]) >= 0))

    # 2. VWAP recomputed by brute force on a random session must match
    rs = np.random.default_rng(0)
    a = "0930"; g = P[f"gid_{a}"]
    gids = np.unique(g[g >= 0])
    dev = 0.0
    for gd in rs.choice(gids, 5, replace=False):
        m = np.flatnonzero(g == gd)
        tp = (P["h"][m] + P["l"][m] + P["c"][m]) / 3.0
        v = P["v"][m]
        bf = np.cumsum(tp * v) / np.cumsum(v)
        dev = max(dev, float(np.max(np.abs(bf - P[f"vwap_{a}"][m]))))
        bv = np.cumsum(tp * tp * v) / np.cumsum(v) - bf * bf
        bs = np.sqrt(np.maximum(bv, 0))
        dev = max(dev, float(np.max(np.abs(bs - P[f"sig_{a}"][m]))))
    chk("brute-force VWAP/sigma match", dev < 1e-7, f"maxdev={dev:.2e}")

    # 3. cycle_end is the last bar of its day-cycle and its time <= 16:59
    ce = np.unique(P["cyc_end"])
    chk("cycle_end times <= 16:59", bool(np.all(P["tmin"][ce] <= 16 * 60 + 59)),
        f"max tmin={P['tmin'][ce].max()}")
    chk("cycle_end is last bar of its cycle",
        bool(np.all(P["dc"][ce] != np.where(ce + 1 < P["n"], P["dc"][np.minimum(ce + 1, P["n"] - 1)], -1))))

    # 4. simulate: entry strictly after signal, exit within cycle
    cfg = dict(anchor="0930", k=2.0, trigger="cross", side="fade",
               stop=("band", 1.0), targ=("vwap", 0), minbar=30, max_hold=390,
               cool=15, maxtr=4, win=(9 * 60 + 30, 15 * 60 + 55))
    tr = simulate(P, cfg, mkt)
    chk("entry bar == signal bar + 1", bool((tr["ep"] == tr["sig"] + 1).all()), f"n={len(tr)}")
    chk("exit >= entry", bool((tr["xp"] >= tr["ep"]).all()))
    chk("flat inside the day-cycle", bool((P["dc"][tr["xp"].values] == P["dc"][tr["ep"].values]).all()))
    chk("exit time <= 16:59", bool(np.all(P["tmin"][tr["xp"].values] <= 16 * 60 + 59)))
    chk("no overlapping trades", bool(np.all(tr["sig"].values[1:] > tr["xp"].values[:-1])))

    # 5. cost accounting: a stop-out must lose >= risk*pv + comm + 2 slips
    st = tr[tr.hit == "stop"]
    exp = -(st["risk"].values * COST[mkt]["pv"] + COST[mkt]["comm"] +
            COST[mkt]["slip"] * COST[mkt]["pv"])
    chk("stop-out P&L == -(risk+slip)*pv - comm",
        bool(np.max(np.abs(st["usd"].values - exp)) < 1e-6),
        f"maxdev={np.max(np.abs(st['usd'].values-exp)):.2e}" if len(st) else "")
    tgt = tr[tr.hit == "targ"]
    exp2 = tgt["d"].values * (tgt["tg"].values - tgt["e"].values) * COST[mkt]["pv"] - COST[mkt]["comm"]
    chk("target P&L == (tg-e)*pv - comm",
        bool(len(tgt) == 0 or np.max(np.abs(tgt["usd"].values - exp2)) < 1e-6))

    # 6. stop-first tie-break: build a synthetic bar where both are touched
    hh = np.array([100.0, 110.0]); ll = np.array([100.0, 90.0])
    xp, hit = _first_hit(hh, ll, 1, 1, 95.0, 105.0, 1)
    chk("stop wins the intrabar tie", hit == "stop")

    # 7. inverting the side must flip the sign of the raw (pre-cost) points
    cfgm = dict(cfg); cfgm["side"] = "momo"; cfgm["targ"] = ("rr", 1.0)
    cfgf = dict(cfg); cfgf["side"] = "fade"; cfgf["targ"] = ("rr", 1.0)
    tm = simulate(P, cfgm, mkt); tf_ = simulate(P, cfgf, mkt)
    chk("momo/fade take opposite directions on the same signals",
        bool(len(tm) and len(tf_) and tm["d"].iloc[0] == -tf_["d"].iloc[0]))

    # 8. no look-ahead: stop/target levels only use bars <= signal bar
    chk("levels use signal-bar data only (structural)", True, "(by construction)")

    print(f"  selftest {ok}/{tot}")
    return ok == tot


