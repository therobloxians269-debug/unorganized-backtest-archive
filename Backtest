"""
features.py -- capacity-saturating OHLCV representation.

NOT a hand-specified family. The point is to hand a universal function approximator
the richest STRICTLY CAUSAL view of the OHLCV sigma-algebra that tabular features can
express, and let it find whatever is there -- including interactions no human would
specify.

Every feature at bar t uses ONLY information available at the close of bar t.
Anything that peeks is a bug, and the purged CV would not catch it. Audited below.
"""
from __future__ import annotations
import numpy as np
import pandas as pd

EPS = 1e-9


def build(b: pd.DataFrame) -> pd.DataFrame:
    """b: 5-min RTH bars, DatetimeIndex (ET), cols open/high/low/close/volume."""
    o, h, l, c, v = (b[k].astype(float) for k in ("open", "high", "low", "close", "volume"))
    f = pd.DataFrame(index=b.index)
    day = b.index.normalize()
    cp = c.shift()

    # ---------------- per-bar primitives -------------------------------------
    ret = np.log(c / cp)
    rng = (h - l)
    f["ret"] = ret
    f["rng_c"] = rng / c
    f["body"] = (c - o) / (rng + EPS)                       # where in the bar it closed
    f["uw"] = (h - np.maximum(o, c)) / (rng + EPS)          # upper wick
    f["lw"] = (np.minimum(o, c) - l) / (rng + EPS)          # lower wick
    f["clv"] = ((c - l) - (h - c)) / (rng + EPS)            # close location value
    f["co"] = (c - o) / (c + EPS)
    f["gap_bar"] = (o - cp) / (c + EPS)                     # bar-to-bar gap
    f["lam"] = ret.abs() / np.sqrt(v + 1.0)                 # Kyle-lambda proxy: impact/vol

    # ---------------- volume -------------------------------------------------
    f["lv"] = np.log1p(v)
    for w in (6, 12, 24, 78):
        f[f"vz{w}"] = (v - v.rolling(w).mean()) / (v.rolling(w).std() + EPS)
        f[f"vr{w}"] = v / (v.rolling(w).mean() + EPS)
    tod = b.index.hour * 60 + b.index.minute
    f["v_tod"] = v / (v.groupby(tod).transform(
        lambda s: s.shift().expanding().mean()) + EPS)      # vs SAME time-of-day, causal

    # ---------------- momentum / path ----------------------------------------
    for w in (2, 3, 6, 12, 24, 48, 78):
        f[f"mom{w}"] = np.log(c / c.shift(w))
        f[f"vol{w}"] = ret.rolling(w).std()
    for w in (12, 24, 78):
        f[f"skew{w}"] = ret.rolling(w).skew()
        f[f"kurt{w}"] = ret.rolling(w).kurt()
        # variance ratio: path efficiency / Hurst proxy
        f[f"vr2_{w}"] = (np.log(c / c.shift(2)).rolling(w).var() /
                         (2 * ret.rolling(w).var() + EPS))
        f[f"vr4_{w}"] = (np.log(c / c.shift(4)).rolling(w).var() /
                         (4 * ret.rolling(w).var() + EPS))
        f[f"eff{w}"] = (c - c.shift(w)).abs() / (rng.rolling(w).sum() + EPS)

    # ---------------- range-based realised vol (OHLC estimators) -------------
    park = (np.log(h / l) ** 2) / (4 * np.log(2))
    gk = 0.5 * np.log(h / l) ** 2 - (2 * np.log(2) - 1) * np.log(c / o) ** 2
    rs = np.log(h / c) * np.log(h / o) + np.log(l / c) * np.log(l / o)
    for w in (6, 12, 24, 78):
        f[f"park{w}"] = park.rolling(w).mean() ** 0.5
        f[f"gk{w}"] = gk.rolling(w).mean().clip(lower=0) ** 0.5
        f[f"rs{w}"] = rs.rolling(w).mean().clip(lower=0) ** 0.5
    f["vol_of_vol"] = f["vol24"].rolling(78).std()
    f["vol_ratio"] = f["vol6"] / (f["vol78"] + EPS)         # short/long vol -- regime

    # ATR in POINTS (the unit the toll lives in)
    tr = np.maximum(rng, np.maximum((h - cp).abs(), (l - cp).abs()))
    atr = tr.rolling(14).mean()
    f["atr"] = atr
    f["rng_atr"] = rng / (atr + EPS)

    # ---------------- session state (all causal within the day) --------------
    g = b.groupby(day)
    d_open = g["open"].transform("first")
    d_hi = g["high"].cummax()
    d_lo = g["low"].cummin()
    f["pos_day"] = (c - d_lo) / (d_hi - d_lo + EPS)         # where in today's range
    f["from_open"] = (c - d_open) / (atr + EPS)
    f["day_rng_atr"] = (d_hi - d_lo) / (atr + EPS)
    bar_i = g.cumcount()
    f["bar_i"] = bar_i
    f["tod_sin"] = np.sin(2 * np.pi * bar_i / 78)
    f["tod_cos"] = np.cos(2 * np.pi * bar_i / 78)

    # session VWAP (causal cumulative)
    pv = (c * v).groupby(day).cumsum()
    vv = v.groupby(day).cumsum()
    vwap = pv / (vv + EPS)
    f["from_vwap"] = (c - vwap) / (atr + EPS)
    f["vwap_slope"] = vwap.diff() / (atr + EPS)

    # running drawdown/up within session
    f["dd_day"] = (c - d_hi) / (atr + EPS)
    f["du_day"] = (c - d_lo) / (atr + EPS)

    # ---------------- prior-day / overnight ----------------------------------
    D = b.groupby(day).agg(o=("open", "first"), c=("close", "last"),
                           h=("high", "max"), l=("low", "min"), v=("volume", "sum"))
    dtr = np.maximum(D.h - D.l, np.maximum((D.h - D.c.shift()).abs(),
                                           (D.l - D.c.shift()).abs()))
    datr = dtr.rolling(14).mean()
    pv_map = {
        "on_gap": (D.o - D.c.shift()) / (datr.shift() + EPS),  # dATR must be PRIOR-day
        "pd_ret": (D.c - D.o) / (datr + EPS),
        "pd_rng": (D.h - D.l) / (datr + EPS),
        "pd_clv": ((D.c - D.l) - (D.h - D.c)) / (D.h - D.l + EPS),
        "d_atr": datr,
    }
    for k, s in pv_map.items():
        src = s if k == "on_gap" else s.shift()   # on_gap already uses prior-day dATR
        f[k] = pd.Series(day, index=b.index).map(src)
    f["from_pdc"] = (c - pd.Series(day, index=b.index).map(D.c.shift())) / (atr + EPS)
    f["from_pdh"] = (c - pd.Series(day, index=b.index).map(D.h.shift())) / (atr + EPS)
    f["from_pdl"] = (c - pd.Series(day, index=b.index).map(D.l.shift())) / (atr + EPS)

    # ---------------- run length ---------------------------------------------
    sgn = np.sign(ret).fillna(0)
    grp = (sgn != sgn.shift()).cumsum()
    f["run"] = sgn * sgn.groupby(grp).cumcount()

    # ---------------- LAGS (let the model see the recent path) ---------------
    core = ["ret", "body", "clv", "uw", "lw", "lam", "vz12", "rng_atr", "run"]
    for k in core:
        for L in (1, 2, 3, 4, 5):
            f[f"{k}_L{L}"] = f[k].shift(L)

    return f.replace([np.inf, -np.inf], np.nan)


def audit_causality(b: pd.DataFrame, n=400, seed=0):
    """Perturb bar t+1..end and confirm NOTHING at row t changes. A leak here would
    make every downstream number a lie, and purged CV would not catch it."""
    rng = np.random.default_rng(seed)
    f0 = build(b.astype(float))
    i = len(b) - n
    b2 = b.astype(float).copy()
    b2.iloc[i:] = b2.iloc[i:] * (1 + rng.normal(0, 0.05, b2.iloc[i:].shape))
    f1 = build(b2)
    a, c_ = f0.iloc[:i - 1], f1.iloc[:i - 1]
    bad = [k for k in a.columns
           if not np.allclose(a[k].to_numpy(), c_[k].to_numpy(), equal_nan=True, atol=1e-8)]
    return bad

