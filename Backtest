import pandas as pd, numpy as np, warnings; warnings.filterwarnings('ignore')
FLAT=1019
def trade_trail(df,R,mode='fixed',rr=4.0,tp1_R=0.0,tp1_frac=0.0,be=True,
                trail_atr=2.0,trail_after=1.0,buf=2.0,max_hold=1440,
                max_stop=60.,min_stop=1.5,pv=20.,comm=4.,slip=0.25,cooldown=5):
    o,h,l=df.o.values,df.h.values,df.l.values
    m=df['minofday'].values; atr=df['atr60'].values; n=len(df)
    out=[]; last=-10**9
    for _,b in R.iterrows():
        i=int(b.i); d=int(b.dir)
        if i<=last+cooldown or i+2>=n or (FLAT<=m[i]<1080): continue
        ep=o[i+1]+(slip if d==1 else -slip)
        st=(b.bot-buf) if d==1 else (b.top+buf)
        if (d==1 and st>=ep) or (d==-1 and st<=ep): continue
        risk=abs(ep-st)
        if risk>max_stop or risk<min_stop: continue
        tg=ep+rr*risk if d==1 else ep-rr*risk
        pos=1.0; real=0.0; cs=st; got1=False; ext=ep; peak=0.0; fills=1
        j=i+1; why='time'
        while j<min(i+1+max_hold,n):
            if FLAT<=m[j]<1080:
                px=o[j]+(slip if d==-1 else -slip)
                real+=pos*((ep-px) if d==-1 else (px-ep)); why='flat'; break
            hit=(h[j]>=cs) if d==-1 else (l[j]<=cs)
            if hit:
                px=cs+(slip if d==-1 else -slip)
                real+=pos*((ep-px) if d==-1 else (px-ep))
                why='stop' if peak<trail_after else 'trail'; break
            ext=min(ext,l[j]) if d==-1 else max(ext,h[j])
            peak=max(peak,((ep-ext) if d==-1 else (ext-ep))/risk)
            if mode=='fixed':
                if (l[j]<=tg) if d==-1 else (h[j]>=tg):
                    real+=pos*rr*risk; why='tgt'; break
            else:
                if tp1_frac>0 and not got1:
                    t1=ep-tp1_R*risk if d==-1 else ep+tp1_R*risk
                    if (l[j]<=t1) if d==-1 else (h[j]>=t1):
                        real+=tp1_frac*tp1_R*risk; pos-=tp1_frac; got1=True; fills+=1
                        if be: cs=min(cs,ep) if d==-1 else max(cs,ep)
                if peak>=trail_after and not np.isnan(atr[j]) and atr[j]>0:
                    cand=ext+trail_atr*atr[j] if d==-1 else ext-trail_atr*atr[j]
                    cs=min(cs,cand) if d==-1 else max(cs,cand)
            j+=1
        else:
            j=min(i+max_hold,n-1); px=o[j]
            real+=pos*((ep-px) if d==-1 else (px-ep))
        net=real*pv-comm*fills
        out.append(dict(t=df.index[i+1],d=d,R=net/(risk*pv),pnl=net,peakR=peak,why=why,risk=risk))
        last=j
    return pd.DataFrame(out)

