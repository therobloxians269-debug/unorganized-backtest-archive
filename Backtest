"""M1 -- market-data ingestion, caching, and quality control.

Design goals:
- A small provider abstraction so the live source (yfinance, stooq) is swappable, and
  a deterministic ``SyntheticProvider`` makes the whole pipeline testable offline.
- An on-disk parquet cache so research is fast and reproducible (one network fetch).
- A strict quality-control layer: structural problems are ``errors``; suspicious-but-
  plausible findings (extreme returns, calendar gaps, zero index volume) are
  ``warnings``. Nothing here looks ahead -- it only inspects the series as given.

Signals are researched on the cash indices (clean RTH open/close); the full-size
futures are fetched only for later execution realism (M5). Continuous-futures roll
artifacts are therefore irrelevant to signal construction and are handled where used.
"""
from __future__ import annotations

import re
import zlib
from abc import ABC, abstractmethod
from dataclasses import dataclass, field
from pathlib import Path
from typing import TYPE_CHECKING

import numpy as np
import pandas as pd

from ope.instruments import VIX_SYMBOL, get_market
from ope.logging_utils import get_logger
from ope.paths import data_dir
from ope.trading_calendar import trading_days, validate_against_calendar

if TYPE_CHECKING:  # avoid any import cycle; only needed for type hints
    from ope.config import Config

_LOG = get_logger("data")

OHLCV_COLUMNS = ("open", "high", "low", "close", "volume")
PRICE_COLUMNS = ("open", "high", "low", "close")
DATE_INDEX_NAME = "date"


# --------------------------------------------------------------------------- #
# Normalization
# --------------------------------------------------------------------------- #
def normalize_ohlcv(raw: pd.DataFrame) -> pd.DataFrame:
    """Coerce a provider frame into the canonical OHLCV schema.

    - Flatten yfinance MultiIndex columns, lower-case names, keep OHLCV.
    - Ensure a sorted, unique, tz-naive ``DatetimeIndex`` named ``date`` (midnight).
    - Drop rows missing any OHLC value; fill missing volume with 0.
    """
    if raw is None or len(raw) == 0:
        return pd.DataFrame(columns=list(OHLCV_COLUMNS),
                            index=pd.DatetimeIndex([], name=DATE_INDEX_NAME))

    df = raw.copy()
    if isinstance(df.columns, pd.MultiIndex):
        df.columns = df.columns.get_level_values(0)
    df.columns = [str(c).strip().lower() for c in df.columns]

    available = [c for c in OHLCV_COLUMNS if c in df.columns]
    df = df[available]
    if "volume" not in df.columns:
        df["volume"] = 0.0
    df = df[list(OHLCV_COLUMNS)]

    idx = pd.DatetimeIndex(pd.to_datetime(df.index))
    if idx.tz is not None:
        idx = idx.tz_localize(None)
    df.index = idx.normalize()
    df.index.name = DATE_INDEX_NAME

    df = df.apply(pd.to_numeric, errors="coerce")
    df = df.dropna(subset=list(PRICE_COLUMNS))
    df["volume"] = df["volume"].fillna(0.0)
    df = df[~df.index.duplicated(keep="last")].sort_index()
    return df


# --------------------------------------------------------------------------- #
# Quality control
# --------------------------------------------------------------------------- #
@dataclass
class DataQualityReport:
    """Outcome of validating one OHLCV series."""

    symbol: str
    n_rows: int
    start: pd.Timestamp | None
    end: pd.Timestamp | None
    errors: list[str] = field(default_factory=list)
    warnings: list[str] = field(default_factory=list)

    @property
    def ok(self) -> bool:
        """True when there are no structural errors (warnings are allowed)."""
        return not self.errors

    def summary(self) -> str:
        status = "OK" if self.ok else "ERROR"
        return (f"[{status}] {self.symbol}: {self.n_rows} rows "
                f"[{self.start} -> {self.end}] | {len(self.errors)} errors, "
                f"{len(self.warnings)} warnings")


def validate_ohlcv(
    df: pd.DataFrame,
    symbol: str,
    *,
    check_calendar: bool = True,
    max_abs_logret: float = 0.5,
    flag_zero_volume: bool = False,
) -> DataQualityReport:
    """Validate an OHLCV frame. Structural issues -> errors; suspicious -> warnings."""
    errors: list[str] = []
    warnings: list[str] = []
    n = len(df)
    start = df.index.min() if n else None
    end = df.index.max() if n else None

    if n == 0:
        errors.append("empty series")
        return DataQualityReport(symbol, 0, None, None, errors, warnings)

    if not isinstance(df.index, pd.DatetimeIndex):
        errors.append("index is not a DatetimeIndex")
    sorted_unique = (
        isinstance(df.index, pd.DatetimeIndex)
        and df.index.is_monotonic_increasing
        and not df.index.has_duplicates
    )
    if isinstance(df.index, pd.DatetimeIndex):
        if not df.index.is_monotonic_increasing:
            errors.append("index is not sorted ascending")
        if df.index.has_duplicates:
            errors.append(f"{int(df.index.duplicated().sum())} duplicate dates")

    missing_cols = [c for c in OHLCV_COLUMNS if c not in df.columns]
    if missing_cols:
        errors.append(f"missing columns {missing_cols}")
        return DataQualityReport(symbol, n, start, end, errors, warnings)

    prices = df[list(PRICE_COLUMNS)]
    if prices.isna().any().any():
        errors.append("NaN in OHLC")
    if (prices <= 0).to_numpy().any():
        errors.append("non-positive prices")

    hi, lo = df["high"], df["low"]
    oc_max = df[["open", "close"]].max(axis=1)
    oc_min = df[["open", "close"]].min(axis=1)
    n_bad_high = int((hi < oc_max).sum())
    n_bad_low = int((lo > oc_min).sum())
    n_bad_hl = int((hi < lo).sum())
    if n_bad_high or n_bad_low or n_bad_hl:
        errors.append(
            f"OHLC inconsistency: {n_bad_high} high<max(o,c), "
            f"{n_bad_low} low>min(o,c), {n_bad_hl} high<low"
        )

    if (df["volume"] < 0).any():
        errors.append("negative volume")
    if flag_zero_volume and (df["volume"] == 0).any():
        warnings.append(f"{int((df['volume'] == 0).sum())} zero-volume rows")

    logret = np.log(df["close"].clip(lower=1e-12)).diff()
    n_extreme = int((logret.abs() > max_abs_logret).sum())
    if n_extreme:
        warnings.append(f"{n_extreme} extreme daily log-returns > {max_abs_logret:.2f}")

    if check_calendar and sorted_unique:
        cal = validate_against_calendar(df.index)
        if cal["missing"]:
            warnings.append(f"{len(cal['missing'])} expected trading days missing (gaps)")
        if cal["unexpected"]:
            warnings.append(f"{len(cal['unexpected'])} rows on non-trading days")

    return DataQualityReport(symbol, n, start, end, errors, warnings)


# --------------------------------------------------------------------------- #
# Providers
# --------------------------------------------------------------------------- #
class MarketDataProvider(ABC):
    """Fetch daily OHLCV for a symbol over ``[start, end]`` (inclusive)."""

    name: str

    @abstractmethod
    def fetch_daily(self, symbol: str, start, end) -> pd.DataFrame:
        ...


class YFinanceProvider(MarketDataProvider):
    """Primary live source: Yahoo Finance daily bars (free)."""

    name = "yfinance"

    def fetch_daily(self, symbol: str, start, end) -> pd.DataFrame:
        import yfinance as yf

        end_excl = (pd.Timestamp(end).normalize() + pd.Timedelta(days=1)) if end is not None else None
        raw = yf.download(
            symbol,
            start=pd.Timestamp(start).normalize() if start is not None else None,
            end=end_excl,
            interval="1d",
            auto_adjust=False,
            progress=False,
            threads=False,
        )
        return normalize_ohlcv(raw)


class StooqProvider(MarketDataProvider):
    """Fallback live source: Stooq daily CSV (free). Mapped symbols only."""

    name = "stooq"
    _SYMBOL_MAP = {"^GSPC": "^spx", "^NDX": "^ndx", "^DJI": "^dji", VIX_SYMBOL: "^vix"}

    def fetch_daily(self, symbol: str, start, end) -> pd.DataFrame:
        try:
            mapped = self._SYMBOL_MAP[symbol]
        except KeyError:
            raise KeyError(
                f"StooqProvider has no mapping for {symbol!r}; mapped: {list(self._SYMBOL_MAP)}"
            ) from None
        url = f"https://stooq.com/q/d/l/?s={mapped}&i=d"
        raw = pd.read_csv(url, parse_dates=["Date"], index_col="Date")
        df = normalize_ohlcv(raw)
        if start is not None:
            df = df[df.index >= pd.Timestamp(start).normalize()]
        if end is not None:
            df = df[df.index <= pd.Timestamp(end).normalize()]
        return df


class SyntheticProvider(MarketDataProvider):
    """Deterministic synthetic OHLCV for offline tests and pipeline validation.

    Generates a geometric-Brownian close path on the real trading calendar, splitting
    each day's drift/variance into an *overnight* and an *intraday* component. The
    ``overnight_share`` lets tests bake in a known overnight premium so downstream
    modules (M2/M3) can be checked for correct decomposition and signal recovery.
    """

    name = "synthetic"

    def __init__(self, seed: int = 0, annual_drift: float = 0.05, annual_vol: float = 0.16,
                 start_price: float = 100.0, overnight_share: float = 0.7):
        if not 0.0 <= overnight_share <= 1.0:
            raise ValueError("overnight_share must be in [0, 1]")
        self.seed = seed
        self.annual_drift = annual_drift
        self.annual_vol = annual_vol
        self.start_price = start_price
        self.overnight_share = overnight_share

    def _symbol_seed(self, symbol: str) -> int:
        return (zlib.crc32(symbol.encode("utf-8")) ^ (self.seed & 0xFFFFFFFF)) & 0xFFFFFFFF

    def fetch_daily(self, symbol: str, start, end) -> pd.DataFrame:
        days = trading_days(start, end)
        n = len(days)
        if n == 0:
            return normalize_ohlcv(pd.DataFrame())

        rng = np.random.default_rng(self._symbol_seed(symbol))
        dt = 1.0 / 252.0
        share = self.overnight_share
        on_mu, id_mu = share * self.annual_drift * dt, (1 - share) * self.annual_drift * dt
        on_sig = np.sqrt(share) * self.annual_vol * np.sqrt(dt)
        id_sig = np.sqrt(1 - share) * self.annual_vol * np.sqrt(dt)

        on_ret = rng.normal(on_mu, on_sig, n)
        id_ret = rng.normal(id_mu, id_sig, n)
        log_close = np.log(self.start_price) + np.cumsum(on_ret + id_ret)
        close = np.exp(log_close)
        open_ = close * np.exp(-id_ret)          # close = open * exp(id_ret)
        hl_noise = np.abs(rng.normal(0.0, id_sig, n))
        high = np.maximum(open_, close) * np.exp(hl_noise)
        low = np.minimum(open_, close) * np.exp(-hl_noise)
        volume = rng.integers(100_000, 1_000_000, n).astype(float)

        df = pd.DataFrame(
            {"open": open_, "high": high, "low": low, "close": close, "volume": volume},
            index=days,
        )
        return normalize_ohlcv(df)


_PROVIDERS = {p.name: p for p in (YFinanceProvider, StooqProvider, SyntheticProvider)}


def make_provider(name: str, **kwargs) -> MarketDataProvider:
    """Instantiate a provider by name (``yfinance``/``stooq``/``synthetic``)."""
    try:
        cls = _PROVIDERS[name]
    except KeyError:
        raise KeyError(f"Unknown provider {name!r}; known: {list(_PROVIDERS)}") from None
    return cls(**kwargs)


# --------------------------------------------------------------------------- #
# Caching & loading
# --------------------------------------------------------------------------- #
class DataStore:
    """On-disk OHLCV cache keyed by (source, symbol, daily)."""

    def __init__(self, cache_dir: str | Path | None = None, fmt: str = "parquet"):
        if fmt not in {"parquet", "csv"}:
            raise ValueError("fmt must be 'parquet' or 'csv'")
        self.cache_dir = Path(cache_dir) if cache_dir is not None else data_dir()
        self.cache_dir.mkdir(parents=True, exist_ok=True)
        self.fmt = fmt

    @staticmethod
    def _safe(symbol: str) -> str:
        return re.sub(r"[^0-9A-Za-z]+", "_", symbol).strip("_")

    def path(self, symbol: str, source: str) -> Path:
        return self.cache_dir / f"{source}__{self._safe(symbol)}__1d.{self.fmt}"

    def read(self, symbol: str, source: str) -> pd.DataFrame | None:
        path = self.path(symbol, source)
        if not path.exists():
            return None
        if self.fmt == "parquet":
            df = pd.read_parquet(path)
        else:
            df = pd.read_csv(path, index_col=0, parse_dates=True)
        return normalize_ohlcv(df)

    def write(self, symbol: str, source: str, df: pd.DataFrame) -> Path:
        path = self.path(symbol, source)
        if self.fmt == "parquet":
            df.to_parquet(path)
        else:
            df.to_csv(path)
        return path


class DataLoader:
    """Load OHLCV from cache or provider, then validate."""

    def __init__(self, provider: MarketDataProvider, store: DataStore | None = None,
                 validate: bool = True, raise_on_error: bool = False):
        self.provider = provider
        self.store = store if store is not None else DataStore()
        self.validate = validate
        self.raise_on_error = raise_on_error

    def load(self, symbol: str, start, end, use_cache: bool = True
             ) -> tuple[pd.DataFrame, DataQualityReport | None]:
        df = self.store.read(symbol, self.provider.name) if use_cache else None
        if df is None or df.empty:
            _LOG.info("fetching %s via %s", symbol, self.provider.name)
            df = self.provider.fetch_daily(symbol, start, end)
            if not df.empty:
                self.store.write(symbol, self.provider.name, df)
        else:
            _LOG.info("cache hit for %s (%s)", symbol, self.provider.name)

        if start is not None:
            df = df[df.index >= pd.Timestamp(start).normalize()]
        if end is not None:
            df = df[df.index <= pd.Timestamp(end).normalize()]

        report = None
        if self.validate:
            report = validate_ohlcv(df, symbol)
            if not report.ok:
                _LOG.warning(report.summary())
                if self.raise_on_error:
                    raise ValueError(report.summary())
        return df, report


# --------------------------------------------------------------------------- #
# High-level selection helpers (config-driven)
# --------------------------------------------------------------------------- #
def signal_symbols(config: "Config") -> list[str]:
    """Cash-index symbols (signal source) plus the VIX regime input."""
    return [get_market(k).cash_symbol for k in config.markets] + [VIX_SYMBOL]


def execution_symbols(config: "Config") -> list[str]:
    """Full-size futures data symbols (execution realism / longer history)."""
    symbols = (get_market(k).fullsize.data_symbol for k in config.markets)
    return [s for s in symbols if s is not None]


def load_dataset(config: "Config", provider: MarketDataProvider | None = None,
                 roles: tuple[str, ...] = ("signal",), use_cache: bool = True
                 ) -> dict[str, tuple[pd.DataFrame, DataQualityReport | None]]:
    """Load all symbols implied by ``config`` for the requested roles.

    ``roles`` may contain ``"signal"`` (cash + VIX) and/or ``"execution"`` (futures).
    Returns ``{symbol: (frame, report)}``.
    """
    provider = provider or make_provider(config.data.primary_source)
    store = DataStore(fmt=config.data.cache_format)
    loader = DataLoader(provider, store)

    symbols: list[str] = []
    if "signal" in roles:
        symbols += signal_symbols(config)
    if "execution" in roles:
        symbols += execution_symbols(config)

    out: dict[str, tuple[pd.DataFrame, DataQualityReport | None]] = {}
    for sym in dict.fromkeys(symbols):  # de-dup, preserve order
        out[sym] = loader.load(sym, config.data.start, config.data.end, use_cache=use_cache)
    return out

