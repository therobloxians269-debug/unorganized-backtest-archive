def stage_amd():
    B = bundles()["IS"]
    print("=" * 110)
    print("H6 AMD SHAPE (IS only): does the manipulation leg of quarter k predict quarter k+1?")
    print("=" * 110)
    # Build per-quarter table
    q = pd.DataFrame({"code": B.qcodes, "i": np.arange(B.n), "o": B.o, "h": B.h, "l": B.l,
                      "c": B.c, "q90": B.q90, "sess": B.sess, "dc": B.dc_codes,
                      "atr": B.atr15})
    g = q.groupby("code", sort=True)
    T = pd.DataFrame({
        "i0": g.i.min(), "i1": g.i.max(), "open": g.o.first(), "high": g.h.max(),
        "low": g.l.min(), "close": g.c.last(), "q90": g.q90.first(), "sess": g.sess.first(),
        "dc": g.dc.first(), "atr0": g.atr.first(),
    })
    T["pos"] = T.q90 % 4          # 0=A 1=M 2=D 3=X within the 6h session
    T["ret"] = T.close - T.open
    T["rng"] = T.high - T.low
    T = T.sort_values("i0").reset_index(drop=True)
    # neighbour links (must be same daycycle and consecutive q90)
    T["nx_ok"] = (T.dc.shift(-1) == T.dc) & (T.q90.shift(-1) == T.q90 + 1)
    for k in ["open", "high", "low", "close", "i0", "i1", "ret", "rng"]:
        T["n_" + k] = T[k].shift(-1)

    print("\n  (a) per-quarter-position stats (A=0,M=1,D=2,X=3) -- range and |ret|/ATR")
    for p in range(4):
        s = T[T.pos == p]
        print(f"    pos={p} n={len(s):5d} rng/atr={np.nanmean(s.rng/s.atr0):.3f} "
              f"|ret|/atr={np.nanmean(s.ret.abs()/s.atr0):.3f} "
              f"P(close>open)={np.mean(s.ret>0):.3f}")

    print("\n  (b) MANIPULATION SWEEP -> NEXT-QUARTER direction")
    print("      manip dir defined 3 ways; test P(next quarter closes opposite)")
    sub = T[T.nx_ok].copy()
    # def 1: sign of the manip quarter's own excursion (which extreme is further from its open)
    up_ex = sub.high - sub.open
    dn_ex = sub.open - sub.low
    sub["m1"] = np.where(up_ex > dn_ex, 1, -1)
    # def 2: sign of the manip quarter's close-open
    sub["m2"] = np.sign(sub.ret).replace(0, 1)
    # def 3: which side of the PREVIOUS quarter's range got swept during this quarter
    T["p_high"] = T.high.shift(1); T["p_low"] = T.low.shift(1)
    T["p_ok"] = (T.dc.shift(1) == T.dc) & (T.q90.shift(1) == T.q90 - 1)
    sub3 = T[T.nx_ok & T.p_ok].copy()
    swept_up = sub3.high > sub3.p_high
    swept_dn = sub3.low < sub3.p_low
    sub3["m3"] = np.where(swept_up & ~swept_dn, 1, np.where(swept_dn & ~swept_up, -1, 0))

    for lbl, s, col in [("m1 excursion", sub, "m1"), ("m2 close-open", sub, "m2"),
                        ("m3 prevrange-sweep", sub3, "m3")]:
        for p in range(4):
            ss = s[(s.pos == p) & (s[col] != 0)]
            if len(ss) < 50:
                continue
            nxt_ret = (ss.n_close - ss.n_open) / ss.atr0
            opp = -ss[col] * nxt_ret
            se = opp.std(ddof=1) / math.sqrt(len(opp))
            print(f"    {lbl:20s} at pos={p} (->pos {(p+1)%4}) n={len(ss):5d} "
                  f"reversal_fwd(ATR)={opp.mean():+.4f} t={opp.mean()/se:+5.2f} "
                  f"P(revert)={np.mean(opp>0):.3f}")

    print("\n  (c) classic QT: A-range built in pos0, swept in pos1, distribution in pos2")
    # accumulation range = pos0 quarter H/L. manipulation = pos1 sweeps one side. trade pos2 opposite.
    T2 = T.copy()
    res = []
    for dcv, grp in T2.groupby("dc"):
        grp = grp.sort_values("q90")
        for s in range(4):
            gg = grp[grp.sess == s]
            if len(gg) < 3:
                continue
            gg = gg.sort_values("q90")
            A = gg.iloc[0]; M = gg.iloc[1]; D = gg.iloc[2]
            su = M.high > A.high; sd = M.low < A.low
            if su and not sd:
                mdir = 1
            elif sd and not su:
                mdir = -1
            elif su and sd:
                mdir = 0
            else:
                mdir = 9  # no sweep
            res.append((dcv, s, mdir, (D.close - D.open) / A.atr0 if A.atr0 > 0 else np.nan,
                        (D.high - D.open) / A.atr0 if A.atr0 > 0 else np.nan,
                        (D.open - D.low) / A.atr0 if A.atr0 > 0 else np.nan))
    RR = pd.DataFrame(res, columns=["dc", "sess", "mdir", "Dret", "Dup", "Ddn"]).dropna()
    print(f"    n sessions with A/M/D present = {len(RR)}")
    print(f"    sweep-direction distribution: {RR.mdir.value_counts().to_dict()}  (1=up,-1=dn,0=both,9=none)")
    for s in [None, 0, 1, 2, 3]:
        r = RR if s is None else RR[RR.sess == s]
        for md in [1, -1]:
            rr = r[r.mdir == md]
            if len(rr) < 40:
                continue
            opp = -md * rr.Dret
            se = opp.std(ddof=1) / math.sqrt(len(opp))
            print(f"    sess={str(s):4s} manip={md:+d} n={len(rr):4d} D-leg-against-manip="
                  f"{opp.mean():+.4f}ATR t={opp.mean()/se:+5.2f} P>0={np.mean(opp>0):.3f}")


# ======================================================================================
# SIGNAL BUILDERS  -- every one returns (sig_bar, dir, stop_pts, dead_bar)
# CAUSALITY CONTRACT: sig_bar is the last bar whose data is used. Entry = open(sig_bar+1).
# ======================================================================================
ATRS = {"a15": "atr15", "a30": "atr30", "a60": "atr60"}


def _anchor(B, anchor):
    if anchor == "TMSO":
        return B.TMSO, B.q_first, B.q_last, B.qcodes
    if anchor == "TSO":
        return B.TSO, B.s_first, B.s_last, B.scodes
    return B.TDO, _dc_first(B), B.dc_last, B.dc_codes


def _dc_first(B):
    idx = np.arange(B.n)
    f = pd.Series(idx).groupby(B.dc_codes).min().to_numpy()
    return f[B.dc_codes]


def sig_drift(B, anchor="TMSO", N=5, thr=0.0, atr="a15", kstop=0.5, hold=None,
              sessions=(0, 1, 2, 3), qpos=(0, 1, 2, 3), flip=False):
    """DRIFT: N minutes after a true open, trade the direction price has already moved."""
    A, first, last, codes = _anchor(B, anchor)
    av = getattr(B, ATRS[atr])
    starts = np.where(first == np.arange(B.n))[0]
    sg = starts + N - 1
    ok = sg < B.n
    starts, sg = starts[ok], sg[ok]
    ok = codes[sg] == codes[starts]                       # still inside the period
    starts, sg = starts[ok], sg[ok]
    a0 = av[starts]
    ok = np.isfinite(a0) & (a0 > 0)
    starts, sg, a0 = starts[ok], sg[ok], a0[ok]
    ok = np.isin(B.sess[starts], list(sessions))
    if anchor == "TMSO":
        ok &= np.isin(B.q90[starts] % 4, list(qpos))
    starts, sg, a0 = starts[ok], sg[ok], a0[ok]
    disp = (B.c[sg] - B.o[starts]) / a0
    m = np.abs(disp) >= thr
    m &= disp != 0
    starts, sg, a0, disp = starts[m], sg[m], a0[m], disp[m]
    d = np.sign(disp).astype(int)
    if flip:
        d = -d
    dead = last[sg] if hold is None else np.minimum(sg + hold, last[sg])
    return sg, d, kstop * a0, dead


def sig_ext(B, anchor="TMSO", X=1.0, atr="a15", kstop=0.5, hold=None, fade=True,
            sessions=(0, 1, 2, 3), qpos=(0, 1, 2, 3), minute_min=0, minute_max=10**9):
    """FADE(X): first bar in the period where |c - trueopen| >= X*ATR.
       fade=True -> trade back toward the open. fade=False -> continuation."""
    A, first, last, codes = _anchor(B, anchor)
    av = getattr(B, ATRS[atr])
    a0 = av[first]                                        # ATR frozen at period start (causal)
    with np.errstate(invalid="ignore", divide="ignore"):
        dev = (B.c - A) / np.where(a0 > 0, a0, np.nan)
    elapsed = np.arange(B.n) - first
    trig = (np.abs(dev) >= X) & np.isfinite(dev) & (elapsed >= minute_min) & (elapsed <= minute_max)
    trig &= np.isin(B.sess, list(sessions))
    if anchor == "TMSO":
        trig &= np.isin(B.q90 % 4, list(qpos))
    dfp = pd.DataFrame({"code": codes[trig], "i": np.arange(B.n)[trig]})
    if len(dfp) == 0:
        return np.array([], int), np.array([], int), np.array([], float), np.array([], int)
    sg = dfp.groupby("code").i.min().to_numpy()
    d = (-np.sign(dev[sg])).astype(int)
    if not fade:
        d = -d
    st = kstop * a0[sg]
    dead = last[sg] if hold is None else np.minimum(sg + hold, last[sg])
    keep = np.isfinite(st) & (st > 0) & (d != 0)
    return sg[keep], d[keep], st[keep], dead[keep]


def sig_amd(B, mdef="excursion", tradepos=2, atr="a15", kstop=0.5, hold=None,
            sessions=(0, 1, 2, 3), reverse=True):
    """AMD: read the manipulation leg in quarter (tradepos-1), trade quarter tradepos against it.
       Signal bar = LAST bar of the manipulation quarter; entry = first bar of the next quarter."""
    idx = np.arange(B.n)
    q = pd.DataFrame({"code": B.qcodes, "i": idx, "o": B.o, "h": B.h, "l": B.l, "c": B.c,
                      "q90": B.q90, "sess": B.sess, "dc": B.dc_codes, "atr": getattr(B, ATRS[atr])})
    g = q.groupby("code", sort=True)
    T = pd.DataFrame({"i0": g.i.min(), "i1": g.i.max(), "open": g.o.first(), "high": g.h.max(),
                      "low": g.l.min(), "close": g.c.last(), "q90": g.q90.first(),
                      "sess": g.sess.first(), "dc": g.dc.first(), "atr0": g.atr.first()})
    T = T.sort_values("i0").reset_index(drop=True)
    T["pos"] = T.q90 % 4
    T["nx_ok"] = (T.dc.shift(-1) == T.dc) & (T.q90.shift(-1) == T.q90 + 1)
    T["n_i1"] = T.i1.shift(-1)
    T["p_high"] = T.high.shift(1); T["p_low"] = T.low.shift(1)
    T["p_ok"] = (T.dc.shift(1) == T.dc) & (T.q90.shift(1) == T.q90 - 1)
    mp = (tradepos - 1) % 4
    S = T[(T.pos == mp) & T.nx_ok & np.isin(T.sess, list(sessions))].copy()
    if mdef == "excursion":
        d = np.where((S.high - S.open) > (S.open - S.low), 1, -1)
    elif mdef == "closeopen":
        d = np.where(S.close >= S.open, 1, -1)
    else:  # prevsweep
        S = S[S.p_ok]
        su = (S.high > S.p_high).to_numpy(); sd = (S.low < S.p_low).to_numpy()
        d = np.where(su & ~sd, 1, np.where(sd & ~su, -1, 0))
    d = -d if reverse else d
    sg = S.i1.to_numpy().astype(int)
    a0 = S.atr0.to_numpy()
    dead = S.n_i1.to_numpy().astype(int) if hold is None else np.minimum(sg + hold,
                                                                        S.n_i1.to_numpy().astype(int))
    keep = (d != 0) & np.isfinite(a0) & (a0 > 0)
    return sg[keep], d[keep].astype(int), (kstop * a0)[keep], dead[keep]


# ======================================================================================
# PLACEBO -- shift every entry by U(120,1440) minutes, same logic/direction/sizing
# ======================================================================================
def placebo_events(B, sg, d, st_mult, hold_len, atrcol, seed):
    rng = np.random.default_rng(seed)
    off = rng.integers(120, 1441, size=len(sg))
    tgt = B.minute[sg] + off
    new = np.searchsorted(B.minute, tgt, side="left")
    ok = new < B.n - 2
    new = new[ok]; dd = d[ok]; hl = hold_len[ok]; sm = st_mult[ok]
    av = getattr(B, atrcol)
    a = av[new]
    ok2 = np.isfinite(a) & (a > 0)
    new, dd, hl, sm, a = new[ok2], dd[ok2], hl[ok2], sm[ok2], a[ok2]
    dead = np.minimum(new + hl, B.dc_last[new])
    ok3 = dead > new
    return new[ok3], dd[ok3], (sm * a)[ok3], dead[ok3]


