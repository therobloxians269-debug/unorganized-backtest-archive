"""Run a codified strategy over micro data, net of realistic friction, and score it.

metrics() returns everything the $1k-fit gates need + robustness stats in the
user's house style (daily Sharpe*sqrt(252), HAC-t, OOS split, every number net).
"""
import math
import numpy as np
import pandas as pd
from specs import SPECS, DATA_FOR, friction_usd, usd
from data import load
from families import FAMILIES, day_context

_CTX = {}   # cache day_context per data-symbol


def _ctx_for(dsym, df):
    if dsym not in _CTX:
        _CTX[dsym] = day_context(df)
    return _CTX[dsym]


def hac_t(y, lags=5):
    y = np.asarray(y, float); n = y.size
    if n < 10 or np.allclose(y, 0):
        return 0.0
    e = y - y.mean(); s = (e @ e) / n
    for l in range(1, min(lags, n - 1) + 1):
        s += 2 * (1 - l / (lags + 1)) * (e[l:] @ e[:-l]) / n
    return float(y.mean() / math.sqrt(max(s, 1e-12) / n))


def run(sym, family, params):
    """sym is the *tradable* symbol (MES/MNQ/MYM). Returns trades df with net_usd."""
    dsym = DATA_FOR.get(sym, sym)
    df = load(dsym)
    fn = FAMILIES[family]
    if family in ("sweep_reversal", "open_bias", "pivot_trade", "range_break", "range_fade"):
        params = {**params, "ctx": _ctx_for(dsym, df)}
    tr = fn(df, **params)
    if len(tr) == 0:
        return tr
    tr = tr.copy()
    tr["gross_usd"] = tr["pts"].astype(float) * SPECS[sym]["point_usd"]
    tr["fric_usd"] = tr["style"].map(lambda s: friction_usd(sym, s))
    tr["net_usd"] = tr["gross_usd"] - tr["fric_usd"]
    tr["risk_pts"] = (tr["entry"] - tr["exit"]).abs()   # rough realized adverse; refined below
    tr["date"] = pd.to_datetime(tr["entry_time"]).dt.tz_convert("America/New_York").dt.normalize().dt.tz_localize(None)
    tr["hold_min"] = (pd.to_datetime(tr["exit_time"]) - pd.to_datetime(tr["entry_time"])).dt.total_seconds() / 60
    return tr


def _dd(equity):
    peak = np.maximum.accumulate(equity)
    return float((equity - peak).min()) if len(equity) else 0.0


def metrics(tr, sym, label=""):
    if tr is None or len(tr) == 0:
        return dict(label=label, sym=sym, n=0, note="no trades")
    net = tr["net_usd"].to_numpy()
    eq = np.cumsum(net)
    wins = net[net > 0]; losses = net[net < 0]
    daily = tr.groupby("date")["net_usd"].sum()
    dsharpe = float(daily.mean() / daily.std() * math.sqrt(252)) if daily.std() > 0 else 0.0
    # worst realized single-trade loss (what a stop can cost on the account)
    worst = float(net.min())
    pf = float(wins.sum() / abs(losses.sum())) if losses.sum() != 0 else float("inf")
    return dict(
        label=label, sym=sym, n=int(len(tr)),
        win_rate=float((net > 0).mean()),
        pf_net=pf,
        exp_usd=float(net.mean()),
        total_net=float(net.sum()),
        avg_win=float(wins.mean()) if len(wins) else 0.0,
        avg_loss=float(losses.mean()) if len(losses) else 0.0,
        maxdd_usd=abs(_dd(eq)),
        sharpe_daily=dsharpe,
        tstat=hac_t(daily.to_numpy()),
        worst_trade_usd=worst,
        avg_hold_min=float(tr["hold_min"].mean()),
        days=int(tr["date"].nunique()),
        gross_exp=float(tr["gross_usd"].mean()),
        avg_fric=float(tr["fric_usd"].mean()),
    )


def oos_split(tr, sym):
    """Split by median date -> in-sample (IS) vs out-of-sample (OOS) metrics."""
    if tr is None or len(tr) < 20:
        return None, None
    med = tr["date"].median()
    a, b = tr[tr["date"] <= med], tr[tr["date"] > med]
    return metrics(a, sym, "IS"), metrics(b, sym, "OOS")


def evaluate(sym, family, params, label=""):
    tr = run(sym, family, params)
    m = metrics(tr, sym, label)
    is_m, oos_m = oos_split(tr, sym)
    m["oos_exp"] = oos_m["exp_usd"] if oos_m else None
    m["oos_pf"] = oos_m["pf_net"] if oos_m else None
    m["oos_total"] = oos_m["total_net"] if oos_m else None
    m["is_exp"] = is_m["exp_usd"] if is_m else None
    return m, tr


if __name__ == "__main__":
    # smoke test a few mechanisms
    for fam, p in [("orb", dict(or_min=5, target_R=2.0, side="break")),
                   ("orb", dict(or_min=15, target_R=1.0, side="fade")),
                   ("sweep_reversal", dict(ref="pdh_pdl", target_R=2.0)),
                   ("ema_cross", dict(fast=9, slow=20, target_R=2.0)),
                   ("vwap_reversion", dict(k_sd=2.0)),
                   ("open_bias", dict(ref="midnight_open"))]:
        m, _ = evaluate("MES", fam, p, f"{fam}:{p}")
        print(f"{fam:16} n={m['n']:>4} exp=${m.get('exp_usd',0):+6.2f} "
              f"PF={m.get('pf_net',0):.2f} DD=${m.get('maxdd_usd',0):.0f} "
              f"Sh={m.get('sharpe_daily',0):+.2f} OOSexp=${(m.get('oos_exp') or 0):+.2f}")

