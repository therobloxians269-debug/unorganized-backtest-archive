"""Port of jdehorty's "Machine Learning: Lorentzian Classification" (Pine v5).

Faithful to the published MLExtensions/KernelFunctions maths:
  features  : n_RSI(14), n_WT(10,11), n_CCI(20), n_ADX(20), n_RSI(9)
  distance  : sum log(1 + |f_now - f_hist|)
  neighbours: k=8 over every 4th bar of the last `max_bars_back`
  filters   : volatility (ATR1>ATR10), regime (KLMF slope >= -0.1),
              kernel (Nadaraya-Watson rational-quadratic, h=8 r=8 x=25)

Two deliberate deviations, both documented and both FAVOURABLE to the product:

1. Neighbour window.  The published loop scans array indices 0..maxBarsBack,
   and because Pine `array.push` appends, index 0 is the OLDEST bar ever seen.
   On a multi-year series that means it compares today against the first 2000
   bars of the chart forever.  We use a rolling window of the most recent
   `max_bars_back` bars, which is the intended behaviour and what every
   serious fork ships.

2. Training label.  The published label is
       y[i] = short if close[i-4] < close[i] else long
   i.e. a bar that has just RISEN is labelled "short" - a backward-looking,
   arguably inverted label.  We run both that and the forward label
       y[i] = long if close[i+4] > close[i] else short
   and report both, so the model gets its best possible shot.
   The forward label is only ever read from bars >= 5 bars in the past, so no
   look-ahead leaks into the prediction.
"""
import numpy as np
from numba import njit, prange

# ------------------------------------------------------------------ indicators


def _ema(x, n):
    a = 2.0 / (n + 1.0)
    out = np.empty_like(x)
    out[0] = x[0]
    for i in range(1, len(x)):
        out[i] = a * x[i] + (1 - a) * out[i - 1]
    return out


_ema_nb = njit(cache=True)(_ema)


@njit(cache=True)
def _rma(x, n):
    """Pine ta.rma: seeded with SMA(n) at bar n-1, then Wilder smoothing."""
    a = 1.0 / n
    out = np.empty_like(x)
    c = 0.0
    for i in range(len(x)):
        if i < n:
            c += x[i]
            out[i] = c / (i + 1)      # expanding mean until the seed bar
        else:
            out[i] = a * x[i] + (1 - a) * out[i - 1]
    return out


@njit(cache=True)
def _sma(x, n):
    out = np.empty_like(x)
    c = 0.0
    for i in range(len(x)):
        c += x[i]
        if i >= n:
            c -= x[i - n]
        out[i] = c / min(i + 1, n)
    return out


@njit(cache=True)
def _rsi(src, n):
    up = np.zeros(len(src))
    dn = np.zeros(len(src))
    for i in range(1, len(src)):
        d = src[i] - src[i - 1]
        up[i] = d if d > 0 else 0.0
        dn[i] = -d if d < 0 else 0.0
    ru = _rma(up, n)
    rd = _rma(dn, n)
    out = np.empty(len(src))
    for i in range(len(src)):
        out[i] = 100.0 if rd[i] == 0 else (0.0 if ru[i] == 0 else 100.0 - 100.0 / (1.0 + ru[i] / rd[i]))
    return out


@njit(cache=True)
def _cci(src, n):
    ma = _sma(src, n)
    out = np.empty(len(src))
    for i in range(len(src)):
        lo = max(0, i - n + 1)
        m = 0.0
        for j in range(lo, i + 1):
            m += abs(src[j] - ma[i])
        m /= (i - lo + 1)
        out[i] = 0.0 if m == 0 else (src[i] - ma[i]) / (0.015 * m)
    return out


@njit(cache=True)
def _true_range(h, l, c):
    tr = np.empty(len(c))
    tr[0] = h[0] - l[0]
    for i in range(1, len(c)):
        a = h[i] - l[i]
        b = abs(h[i] - c[i - 1])
        d = abs(l[i] - c[i - 1])
        tr[i] = max(a, max(b, d))
    return tr


@njit(cache=True)
def atr(h, l, c, n):
    return _rma(_true_range(h, l, c), n)


@njit(cache=True)
def _running_normalize(x):
    """Pine `normalize(src,0,1)`: rescale by the running historic min/max."""
    out = np.empty(len(x))
    mn = 1e10
    mx = -1e10
    for i in range(len(x)):
        v = x[i]
        if v == v:  # not nan
            if v < mn:
                mn = v
            if v > mx:
                mx = v
        rng = mx - mn
        if rng < 1e-10:
            rng = 1e-10
        out[i] = (v - mn) / rng
    return out


@njit(cache=True)
def _n_rsi(src, n1, n2):
    r = _rsi(src, n1)
    if n2 > 1:
        r = _ema_nb(r, n2)
    return r / 100.0


@njit(cache=True)
def _n_cci(src, n1, n2):
    c = _cci(src, n1)
    if n2 > 1:
        c = _ema_nb(c, n2)
    return _running_normalize(c)


@njit(cache=True)
def _n_wt(src, n1, n2):
    e1 = _ema_nb(src, n1)
    e2 = _ema_nb(np.abs(src - e1), n1)
    ci = np.empty(len(src))
    for i in range(len(src)):
        d = 0.015 * e2[i]
        ci[i] = 0.0 if d == 0 else (src[i] - e1[i]) / d
    wt1 = _ema_nb(ci, n2)
    wt2 = _sma(wt1, 4)
    return _running_normalize(wt1 - wt2)


@njit(cache=True)
def _n_adx(h, l, c, n):
    N = len(c)
    tr = _true_range(h, l, c)
    dmp = np.zeros(N)
    dmn = np.zeros(N)
    for i in range(1, N):
        up = h[i] - h[i - 1]
        dw = l[i - 1] - l[i]
        dmp[i] = up if (up > dw and up > 0) else 0.0
        dmn[i] = dw if (dw > up and dw > 0) else 0.0
    trs = np.empty(N)
    sp = np.empty(N)
    sn = np.empty(N)
    trs[0] = tr[0]
    sp[0] = dmp[0]
    sn[0] = dmn[0]
    for i in range(1, N):
        trs[i] = trs[i - 1] - trs[i - 1] / n + tr[i]
        sp[i] = sp[i - 1] - sp[i - 1] / n + dmp[i]
        sn[i] = sn[i - 1] - sn[i - 1] / n + dmn[i]
    dx = np.zeros(N)
    for i in range(N):
        if trs[i] > 0:
            dip = sp[i] / trs[i] * 100.0
            din = sn[i] / trs[i] * 100.0
            s = dip + din
            if s > 0:
                dx[i] = abs(dip - din) / s * 100.0
    return _rma(dx, n) / 100.0


def features(h, l, c):
    """The 5 default LDC features, each in [0,1]."""
    hlc3 = (h + l + c) / 3.0
    f = np.empty((len(c), 5))
    f[:, 0] = _n_rsi(c, 14, 1)
    f[:, 1] = _n_wt(hlc3, 10, 11)
    f[:, 2] = _n_cci(c, 20, 1)
    f[:, 3] = _n_adx(h, l, c, 20)
    f[:, 4] = _n_rsi(c, 9, 1)
    return np.nan_to_num(f, nan=0.0, posinf=1.0, neginf=0.0)


# ------------------------------------------------------------------ filters


@njit(cache=True)
def volatility_filter(h, l, c):
    return atr(h, l, c, 1) > atr(h, l, c, 10)


@njit(cache=True)
def regime_filter(src, h, l, threshold):
    """KLMF slope filter from MLExtensions."""
    N = len(src)
    v1 = 0.0
    v2 = 0.0
    klmf = 0.0
    slope = np.zeros(N)
    prev_k = 0.0
    for i in range(1, N):
        v1 = 0.2 * (src[i] - src[i - 1]) + 0.8 * v1
        v2 = 0.1 * (h[i] - l[i]) + 0.8 * v2
        omega = abs(v1 / v2) if v2 != 0 else 0.0
        o2 = omega * omega
        alpha = (-o2 + np.sqrt(o2 * o2 + 16.0 * o2)) / 8.0
        prev_k = klmf
        klmf = alpha * src[i] + (1.0 - alpha) * klmf
        slope[i] = abs(klmf - prev_k)
    ea = _ema_nb(slope, 200)
    out = np.zeros(N, dtype=np.bool_)
    for i in range(N):
        if ea[i] > 0:
            out[i] = ((slope[i] - ea[i]) / ea[i]) >= threshold
    return out


@njit(cache=True, parallel=True)
def kernel_rq(src, lookback, rel_weight, start_at):
    """Nadaraya-Watson rational-quadratic regression (KernelFunctions.pine)."""
    N = len(src)
    out = np.empty(N)
    n = start_at + 2
    w = np.empty(n)
    for i in range(n):
        w[i] = (1.0 + (i * i) / (lookback * lookback * 2.0 * rel_weight)) ** (-rel_weight)
    for t in prange(N):
        cw = 0.0
        tw = 0.0
        m = min(n, t + 1)
        for i in range(m):
            cw += src[t - i] * w[i]
            tw += w[i]
        out[t] = cw / tw
    return out


# ------------------------------------------------------------------ classifier


@njit(cache=True, parallel=True)
def knn_predict(feat, y, max_bars_back, k, stride, min_gap):
    """Lorentzian-distance KNN.

    For every bar t, scan candidate bars t-min_gap-1 back to t-max_bars_back
    stepping by `stride`, keep the k smallest distances, return sum of labels.
    """
    N, F = feat.shape
    pred = np.zeros(N, dtype=np.float64)
    for t in prange(N):
        if t < max_bars_back + min_gap + 1:
            continue
        bd = np.full(k, 1e18)
        bl = np.zeros(k)
        worst = 1e18
        j = t - min_gap - 1
        stop = t - max_bars_back
        while j >= stop:
            d = 0.0
            for q in range(F):
                d += np.log(1.0 + abs(feat[t, q] - feat[j, q]))
            if d < worst:
                # insert into the sorted top-k
                p = k - 1
                while p > 0 and bd[p - 1] > d:
                    bd[p] = bd[p - 1]
                    bl[p] = bl[p - 1]
                    p -= 1
                bd[p] = d
                bl[p] = y[j]
                worst = bd[k - 1]
            j -= stride
        s = 0.0
        for q in range(k):
            s += bl[q]
        pred[t] = s
    return pred


def labels(close, horizon=4, mode="forward"):
    """mode='forward': y[i]=+1 if close[i+horizon]>close[i]  (sensible)
       mode='published': y[i]=-1 if close[i-horizon]<close[i] (jdehorty's literal code)"""
    N = len(close)
    y = np.zeros(N)
    if mode == "forward":
        y[: N - horizon] = np.sign(close[horizon:] - close[: N - horizon])
    else:
        y[horizon:] = -np.sign(close[horizon:] - close[: N - horizon])
    return y


def classify(h, l, c, *, max_bars_back=2000, k=8, stride=4, horizon=4,
             label_mode="forward", use_volatility=True, use_regime=True,
             use_kernel=True, regime_threshold=-0.1, kernel_h=8, kernel_r=8.0,
             kernel_x=25):
    """Returns dict with prediction, filter mask, and the LDC directional signal."""
    h = np.ascontiguousarray(h, dtype=np.float64)
    l = np.ascontiguousarray(l, dtype=np.float64)
    c = np.ascontiguousarray(c, dtype=np.float64)
    feat = np.ascontiguousarray(features(h, l, c))
    y = labels(c, horizon, label_mode)
    # forward labels are only legal once they are known: enforce min_gap
    min_gap = horizon + 1 if label_mode == "forward" else 1
    pred = knn_predict(feat, y, max_bars_back, k, stride, min_gap)

    filt = np.ones(len(c), dtype=bool)
    if use_volatility:
        filt &= volatility_filter(h, l, c)
    if use_regime:
        filt &= regime_filter((h + l + c + c) / 4.0, h, l, regime_threshold)

    yhat = kernel_rq(c, float(kernel_h), float(kernel_r), kernel_x)
    kern_bull = np.zeros(len(c), dtype=bool)
    kern_bull[1:] = yhat[1:] >= yhat[:-1]
    if not use_kernel:
        kern_bull[:] = True
        kern_bear = np.ones(len(c), dtype=bool)
    else:
        kern_bear = ~kern_bull

    # signal is sticky: it only flips when prediction and filters agree
    sig = np.zeros(len(c), dtype=np.int8)
    _stick(pred, filt, sig)
    new_long = np.zeros(len(c), dtype=bool)
    new_short = np.zeros(len(c), dtype=bool)
    ch = np.zeros(len(c), dtype=bool)
    ch[1:] = sig[1:] != sig[:-1]
    new_long = ch & (sig == 1) & kern_bull
    new_short = ch & (sig == -1) & kern_bear
    return dict(pred=pred, filt=filt, signal=sig, kern_bull=kern_bull,
                new_long=new_long, new_short=new_short, yhat=yhat, feat=feat, y=y)


@njit(cache=True)
def _stick(pred, filt, out):
    cur = 0
    for i in range(len(pred)):
        if filt[i]:
            if pred[i] > 0:
                cur = 1
            elif pred[i] < 0:
                cur = -1
        out[i] = cur

