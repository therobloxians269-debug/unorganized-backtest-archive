"""
COST MODEL v2 — the fix.

WHAT WAS WRONG IN v1
  1. One tick of slippage was charged on BOTH sides of every trade. That is a
     MARKET-order assumption. In reality the entry is a limit and the target exit is
     a limit; only the STOP is a market order. v1 therefore charged roughly double.
  2. Everything was measured on ES, which is structurally the worst instrument for
     cost drag, and the verdict was generalised to instruments never tested:

         ES   ADR  24.6 pts / 0.25 tick =    98 ticks of daily range
         NQ   ADR   231 pts / 0.25 tick =   924 ticks
         MNQ  ADR   384 pts / 0.25 tick = 1,536 ticks

     Same tick, 9-15x the range. At a 0.35-ADR stop that is 0.064R of cost on MES
     versus 0.008R on MNQ — an 8x difference that decides whether a small gross edge
     lives or dies.

THE MODEL
  entry   LIMIT  -> no spread crossed, but the price must TRADE THROUGH by one tick
                    before we call it filled (the conservative convention). Unfilled
                    orders are reported as a fill rate, never silently dropped.
  target  LIMIT  -> no spread crossed, same trade-through requirement
  stop    MARKET -> one tick of slippage, always
  commission     -> per contract, round turn, charged on filled trades only

MARKET-order entry is kept available so the two can be compared honestly rather than
assumed.
"""
import numpy as np

TICK = {'ES': 0.25, 'NQ': 0.25, 'MNQ': 0.25, 'MES': 0.25}
PT = {'ES': 50.0, 'NQ': 20.0, 'MNQ': 2.0, 'MES': 5.0}
COMM = {'ES': 2.50, 'NQ': 2.50, 'MNQ': 1.24, 'MES': 1.24}


def comm_pts(which):
    """Round-turn commission expressed in index points."""
    return COMM[which] / PT[which]


def run_trade(H, L, C, j, sgn, entry, stop, tgt, which,
              entry_type='limit', require_through=True, max_wait=None):
    """
    Path-accurate single trade starting AFTER bar j.

    Returns dict(outcome, pts_net, fill_bar) where outcome is one of
    win / loss / ambig / timeout / nofill. pts_net is in index points.

    Harness rules preserved from v1: the search starts at j+1, the barrier race starts
    after the fill bar, and any same-bar ambiguity is charged as a LOSS.
    """
    tick = TICK[which]
    Hf, Lf = H[j + 1:], L[j + 1:]
    if len(Hf) < 3:
        return dict(outcome='nofill', pts_net=0.0, fill_bar=-1)

    if entry_type == 'market':
        fi = 0
        fill_px = float(C[j]) + sgn * tick          # cross the spread
        slip_in = tick
    else:
        thr = entry - sgn * (tick if require_through else 0.0)
        idx = np.flatnonzero(Lf <= thr) if sgn > 0 else np.flatnonzero(Hf >= thr)
        if max_wait is not None and len(idx):
            idx = idx[idx <= max_wait]
        if not len(idx):
            return dict(outcome='nofill', pts_net=0.0, fill_bar=-1)
        fi = int(idx[0])
        fill_px = entry                              # filled AT the limit
        slip_in = 0.0

    # the stop must still be beyond the fill
    if (sgn > 0 and stop >= fill_px) or (sgn < 0 and stop <= fill_px):
        return dict(outcome='nofill', pts_net=0.0, fill_bar=-1)

    Hr, Lr = Hf[fi + 1:], Lf[fi + 1:]
    if len(Hr) == 0:
        px = float(C[-1])
        return dict(outcome='timeout', fill_bar=fi,
                    pts_net=sgn * (px - fill_px) - comm_pts(which) - slip_in)

    tthr = tgt - sgn * (tick if require_through else 0.0)
    ti = np.flatnonzero(Hr >= tthr) if sgn > 0 else np.flatnonzero(Lr <= tthr)
    xi = np.flatnonzero(Lr <= stop) if sgn > 0 else np.flatnonzero(Hr >= stop)
    ti = int(ti[0]) if len(ti) else 10 ** 9
    xi = int(xi[0]) if len(xi) else 10 ** 9

    if ti == 10 ** 9 and xi == 10 ** 9:
        px = float(C[-1])
        gross = sgn * (px - fill_px)
        slip_out = TICK[which]                       # flat at the close, market
        oc = 'timeout'
    elif ti < xi:
        gross = sgn * (tgt - fill_px)                # limit fill, no slippage
        slip_out = 0.0
        oc = 'win'
    else:
        gross = sgn * (stop - fill_px)               # stop = market order
        slip_out = TICK[which]
        oc = 'loss' if xi < ti else 'ambig'
    return dict(outcome=oc, fill_bar=fi,
                pts_net=gross - comm_pts(which) - slip_in - slip_out)


def summary(which, adr, stop_frac):
    """Cost as a fraction of R, the number that actually decides feasibility."""
    risk = stop_frac * adr
    c = comm_pts(which) + TICK[which]                # commission + one stop-side tick
    return dict(instrument=which, adr=adr, risk_pts=risk, cost_pts=c,
                cost_R=c / risk, ticks_of_range=adr / TICK[which])

