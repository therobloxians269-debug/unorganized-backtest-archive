#!/usr/bin/env python3
"""Capital-preservation redesign for a $1,000 account.
Goal: drawdown DRASTICALLY smaller than return, OR overwhelming P(never underwater).
Levers (all mechanistic, none tuned to PnL):
  - regime gate ER(24) >= thr   (only trade clear trends)
  - max_entries per day         (1 => at most one loss/day)
  - stop_after_loss             (hard daily stop: first losing trade ends the day)
  - tight fixed stop in points  (caps $ risk per trade on 1 MES)
We ride winners to 16:00 (fat right tail) but HARD-CAP the bad day.
Everything reported on real ES 2022-2026 + full history, 1 MES ($5/pt), net friction.
MC bootstraps DAILY P&L (not per-trade) so the daily stop is honored."""
import numpy as np, pandas as pd
import omni2_lib as L
from omni2_lib import ORN, FLOOR, fric, DPP

def sim_day(s, er_thr, max_entries, stop_after_loss, stop_pts, use_atr_stop, atr_mult=1.5):
    h, l, c, atr, vwap, er = s["h"], s["l"], s["c"], s["atr"], s["vwap"], s["er"]
    orh, orl = s["or_hi"], s["or_lo"]
    pos = 0; entry = stop = np.nan; ebar = -1; risk0 = np.nan
    broke = 0; n = 0; day_pnl = 0.0; stopped = False; res = []
    for b in range(ORN, 78):
        if pos == 0 and n < max_entries and not stopped and er[b] >= er_thr and b < 77:
            above = c[b] > vwap[b]; below = c[b] < vwap[b]; side = 0
            if broke == 0:
                if c[b] > orh and above: side = 1; broke = 1
                elif c[b] < orl and below: side = -1; broke = -1
            else:
                if broke == 1 and above and l[b] <= vwap[b] + 0.5*atr[b] and c[b] > c[b-1]: side = 1
                elif broke == -1 and below and h[b] >= vwap[b] - 0.5*atr[b] and c[b] < c[b-1]: side = -1
            if side != 0:
                pos = side; entry = c[b]; ebar = b
                sd = max(atr_mult*atr[b], FLOOR) if use_atr_stop else stop_pts
                stop = c[b] - side*sd; risk0 = abs(entry-stop); n += 1
            continue
        if pos != 0 and b > ebar:
            hit = (l[b] <= stop) if pos > 0 else (h[b] >= stop)
            if hit:
                g = pos*(stop-entry) - fric("stop")
            elif b == 77:
                g = pos*(c[b]-entry) - fric("eod")
            else:
                continue
            res.append((s["date"], g, risk0)); day_pnl += g; pos = 0
            if stop_after_loss and g < 0: stopped = True
    return res

def run(S, **kw):
    rows = [dict(date=d, net=nt, risk=r) for s in S for d, nt, r in sim_day(s, **kw)]
    return pd.DataFrame(rows)

def daily(tr):
    d = tr.groupby("date")["net"].sum().reset_index()
    d["usd"] = d["net"]*DPP; d["yr"] = pd.to_datetime(d["date"]).dt.year
    return d

def mc(day_usd, start=1000, n=20000, horizon=None, seed=7):
    """Bootstrap whole trading DAYS. P(equity ever < start), median & 5th-pct worst dip."""
    rng = np.random.default_rng(seed)
    horizon = horizon or len(day_usd)
    worst = np.empty(n); under = 0; ruin = 0
    for i in range(n):
        seq = rng.choice(day_usd, size=horizon, replace=True)
        eq = start + np.cumsum(seq); mn = eq.min()
        worst[i] = mn - start
        under += mn < start
        ruin += mn <= 0
    return dict(p_under=under/n, p_ruin=ruin/n,
                med_worst=float(np.median(worst)), p05_worst=float(np.percentile(worst, 5)))

def summarize(name, tr):
    if len(tr) < 30:
        print(f"{name:42s} n={len(tr)} too few"); return
    d = daily(tr); u = d["usd"].to_numpy()
    d22 = d[d.yr >= 2022]; u22 = d22["usd"].to_numpy()
    eq = np.cumsum(u22); dd = (eq - np.maximum.accumulate(eq)).min()
    tot = u22.sum(); mar = tot/abs(dd) if dd < 0 else float("inf")
    m = mc(u22)
    print(f"{name:42s} | 22+: days={len(u22):4d} ${tot:6.0f} DD=${dd:7.0f} MAR={mar:4.2f} "
          f"win/day={100*(u22>0).mean():4.1f}% | MC$1k: P(under)={m['p_under']:5.1%} "
          f"P(ruin)={m['p_ruin']:5.1%} medWorst=${m['med_worst']:5.0f} p5Worst=${m['p05_worst']:6.0f}")

def main():
    S = L.load()
    print("CAPITAL-PRESERVATION SWEEP — 1 MES, net friction, ride winners to close")
    print("target: MAR high (DD<<return) AND low P(under) / P(ruin) from $1,000\n")
    cfgs = [
        ("gate.40 e3 noStop ATR (current)", dict(er_thr=0.40, max_entries=3, stop_after_loss=False, use_atr_stop=True,  stop_pts=0)),
        ("gate.40 e1 dayStop ATR",          dict(er_thr=0.40, max_entries=1, stop_after_loss=True,  use_atr_stop=True,  stop_pts=0)),
        ("gate.50 e1 dayStop ATR",          dict(er_thr=0.50, max_entries=1, stop_after_loss=True,  use_atr_stop=True,  stop_pts=0)),
        ("gate.55 e1 dayStop ATR",          dict(er_thr=0.55, max_entries=1, stop_after_loss=True,  use_atr_stop=True,  stop_pts=0)),
        ("gate.50 e2 dayStop ATR",          dict(er_thr=0.50, max_entries=2, stop_after_loss=True,  use_atr_stop=True,  stop_pts=0)),
        ("gate.50 e1 dayStop stop4pt",      dict(er_thr=0.50, max_entries=1, stop_after_loss=True,  use_atr_stop=False, stop_pts=4.0)),
        ("gate.55 e1 dayStop stop4pt",      dict(er_thr=0.55, max_entries=1, stop_after_loss=True,  use_atr_stop=False, stop_pts=4.0)),
        ("gate.50 e1 dayStop stop6pt",      dict(er_thr=0.50, max_entries=1, stop_after_loss=True,  use_atr_stop=False, stop_pts=6.0)),
    ]
    for name, kw in cfgs:
        summarize(name, run(S, **kw))

if __name__ == "__main__":
    main()

