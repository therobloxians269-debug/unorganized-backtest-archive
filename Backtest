import pandas as pd, numpy as np

def race(h,l,start,stop,tgt,d,limit):
    """first-touch race. returns (exit_idx, 'stop'|'tgt'|'time'). stop wins ties."""
    end=min(start+limit,len(h))
    if start>=end: return len(h)-1,'time'
    hs=h[start:end]; ls=l[start:end]
    if d==-1: s_hit=hs>=stop; t_hit=ls<=tgt
    else:     s_hit=ls<=stop; t_hit=hs>=tgt
    si=s_hit.argmax() if s_hit.any() else 10**9
    ti=t_hit.argmax() if t_hit.any() else 10**9
    if si==10**9 and ti==10**9: return end-1,'time'
    if si<=ti: return start+int(si),'stop'
    return start+int(ti),'tgt'

def simulate(df,sig,bias='none',tmso_gate=0,max_stop=60.,min_stop=1.0,buf=2.0,
             tp1_R=0.0,tp1_frac=0.0,tp2_R=6.0,be_after_tp1=True,
             max_hold=1440,max_trades_day=2,point_val=20.,comm=2.0,
             slip_ticks=1.0,tick=0.25,sess_filter=None,arrs=None):
    o=arrs['o'];h=arrs['h'];l=arrs['l'];day=arrs['day'];sess=arrs['sess'];mq=arrs['mq']
    B=arrs['B']; n=len(o); slip=slip_ticks*tick
    trades=[]; used={}; busy=-1
    I=sig['i'].values; D=sig['d'].values; A=sig['arm_i'].values
    for x in range(len(I)):
        i=int(I[x]); d=int(D[x]); a=int(A[x])
        if i<=busy or i+1>=n: continue
        if sess_filter is not None and sess[i] not in sess_filter: continue
        if tmso_gate and mq[i]>tmso_gate: continue
        if bias!='none':
            al=[(B[tf][0][i] if d==-1 else B[tf][1][i]) for tf in (1440,240,90)]
            if not {'d':al[0],'4h':al[1],'90':al[2],'any1':any(al),
                    'any2':sum(al)>=2,'all3':all(al)}[bias]: continue
        k=day[i]
        if used.get(k,0)>=max_trades_day: continue
        stop=(max(h[a:i+1].max(),h[i])+buf) if d==-1 else (min(l[a:i+1].min(),l[i])-buf)
        entry=o[i+1]+(-slip if d==-1 else slip); risk=abs(stop-entry)
        if risk>max_stop or risk<min_stop: continue
        t2=entry-tp2_R*risk if d==-1 else entry+tp2_R*risk
        units=1.0; realized=0.0; fills=1
        if tp1_frac>0:
            t1=entry-tp1_R*risk if d==-1 else entry+tp1_R*risk
            j,w=race(h,l,i+1,stop,t1,d,max_hold)
            if w=='tgt':
                realized+=tp1_frac*tp1_R*risk; units-=tp1_frac; fills+=1
                s2=entry if be_after_tp1 else stop
                j2,w2=race(h,l,j+1,s2,t2,d,max_hold-(j-i))
                if w2=='tgt': realized+=units*tp2_R*risk
                elif w2=='stop': realized+=units*((entry-s2 if d==-1 else s2-entry)-slip)
                else: px=o[j2]; realized+=units*((entry-px if d==-1 else px-entry)-slip)
                why=w2; jf=j2
            elif w=='stop': realized=-(risk+slip); why='stop'; jf=j
            else: px=o[j]; realized=(entry-px if d==-1 else px-entry)-slip; why='time'; jf=j
        else:
            j,w=race(h,l,i+1,stop,t2,d,max_hold)
            if w=='tgt': realized=tp2_R*risk
            elif w=='stop': realized=-(risk+slip)
            else: px=o[j]; realized=(entry-px if d==-1 else px-entry)-slip
            why=w; jf=j
        net=realized*point_val-comm*fills
        trades.append((df.index[i+1],d,entry,risk,why,net,net/(risk*point_val),jf-i))
        used[k]=used.get(k,0)+1; busy=jf
    return pd.DataFrame(trades,columns=['t','d','entry','risk','why','pnl','R','bars'])

def arrays(df):
    return dict(o=df['o'].values,h=df['h'].values,l=df['l'].values,
                day=df['daycycle'].values,sess=df['sess'].values,mq=df['min_into_q90'].values,
                B={tf:(df[f'bear{tf}'].values,df[f'bull{tf}'].values) for tf in (1440,240,90)})

def st(tr,label=''):
    if len(tr)==0: return f'{label:56s} NO TRADES'
    w=(tr.pnl>0).mean(); pos=tr.pnl[tr.pnl>0].sum(); neg=-tr.pnl[tr.pnl<0].sum()
    pf=pos/max(1e-9,neg); eq=tr.pnl.cumsum(); dd=(eq-eq.cummax()).min()
    t=tr.pnl.mean()/tr.pnl.std()*np.sqrt(len(tr)) if tr.pnl.std()>0 else 0
    return (f'{label:56s} n={len(tr):4d} WR={w*100:5.1f}% avgR={tr.R.mean():+.3f} '
            f'$/tr={tr.pnl.mean():+7.2f} net=${tr.pnl.sum():+8.0f} PF={pf:.2f} DD=${dd:.0f} t={t:+.2f}')

