              f"{st['sharpe']:>6.2f} {s['ann_return']*100:>6.1f} {s['max_drawdown']*100:>7.1f}")

    # Conditioned primary: era robustness + holdout (trade-days only, net of cost).
    tr = returns[primary][pos[primary] != 0].copy()
    tr.index = pd.to_datetime([str(d) for d in tr.index])
