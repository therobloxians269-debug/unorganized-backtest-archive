"""Scan every band touch, record CAUSAL conditions at the touch bar, race the fade forward."""
import numpy as np, pandas as pd, pickle
from ladder import pred, QS, FEATS

def scan(day, rth, P, qe=0.60, qs=0.80, tgt_q=0.60, pv=5.0, comm=1.50, tick=0.25, flat=959):
    rows=[]; di={d:i for i,d in enumerate(day.index)}
    for d,bars in rth.groupby('day'):
        if d not in di or len(bars)<300: continue
        i=di[d]; o=day.at[d,'o930']; A=day.at[d,'ADR']
        H=bars['high'].values; L=bars['low'].values; C=bars['close'].values; T=bars['tod'].values
        nb=len(bars)
        for side,dr in (('lo',1),('hi',-1)):
            ent = o - dr*P[(side,qe)][i]*A
            stp = o - dr*P[(side,qs)][i]*A
            osd = 'hi' if side=='lo' else 'lo'
            tgt = o + dr*P[(osd,tgt_q)][i]*A
            hitv = (L<=ent) if dr==1 else (H>=ent)
            w=np.flatnonzero(hitv & (T<flat))
            if len(w)==0: continue
            k=w[0]
            # ── causal state AT the touch bar ──
            runH=H[:k+1].max(); runL=L[:k+1].min()
            elapsed=(T[k]-570)/390.0
            used=(runH-runL)/A
            # has the OPPOSITE extreme already gone past its own q60?
            oppdist = (runH-o)/A if dr==1 else (o-runL)/A
            oppq    = P[(osd,tgt_q)][i]
            drive   = abs(C[k]-o)/A
            j=max(0,k-30); vel=(H[j:k+1].max()-L[j:k+1].min())/A
            # ── race the fade from k+1 ──
            R=np.nan; reason='none'
            risk=abs(ent-stp)
            if risk>1e-9 and k+1<nb:
                for m in range(k+1,nb):
                    last=(m==nb-1) or (T[m]>=flat)
                    hs=(L[m]<=stp) if dr==1 else (H[m]>=stp)
                    ht=(H[m]>=tgt) if dr==1 else (L[m]<=tgt)
                    if hs:   px=stp-dr*tick; reason='stop'
                    elif ht: px=tgt;         reason='target'
                    elif last: px=C[m];      reason='time'
                    else: continue
                    R=(dr*(px-ent)*pv-comm)/(risk*pv); break
            if np.isnan(R): continue
            rows.append(dict(day=d,side=side,dr=dr,R=R,reason=reason,risk_pts=risk,
                             elapsed=elapsed,used=used,oppdist=oppdist,oppq=oppq,
                             oppratio=oppdist/max(oppq,1e-6),drive=drive,vel=vel,
                             gap=day.at[d,'f_gap'],onr=day.at[d,'f_onlo']+day.at[d,'f_onhi'],
                             pdr=day.at[d,'f_pdr']))
    return pd.DataFrame(rows)

