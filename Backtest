"""The honest referee: is gate 0.55 + breaker a real edge or an in-sample artifact?
Optimize the gate on TRAIN (2022-2023) by MAR, then apply it BLIND to TEST (2024-26).
Also report every gate on both windows so we can see if ANY parameter is stable.
If the train-optimal parameter collapses OOS -> overfit, full stop."""
import numpy as np, pandas as pd
import omni2_lib as L
from omni5_smallacct import day_trades
from omni2_lib import DPP

def window_stats(S, er_thr, Lmonth, y_lo, y_hi, start=1000.0):
    """Chronological equity with monthly breaker over [y_lo, y_hi]. Return dict."""
    eq = start; peak = start; maxdd = 0.0; tot = 0.0
    cur = None; mpnl = 0.0; broken = False; ndays = 0
    for s in S:
        if not (y_lo <= s["date"].year <= y_hi): continue
        ym = (s["date"].year, s["date"].month)
        if ym != cur: cur = ym; mpnl = 0.0; broken = False
        if broken: continue
        u = sum(g for g, _ in day_trades(s, er_thr, 1)) * DPP
        if u != 0: ndays += 1
        eq += u; tot += u; mpnl += u
        peak = max(peak, eq); maxdd = min(maxdd, eq - peak)
        if mpnl <= -Lmonth: broken = True
    mar = tot/abs(maxdd) if maxdd < 0 else 9.99
    return dict(ret=tot, maxdd=maxdd, mar=mar, ndays=ndays)

def main():
    S = L.load()
    Lm = 100
    gates = [0.40, 0.45, 0.48, 0.50, 0.52, 0.54, 0.55, 0.56, 0.58, 0.60]
    print(f"monthly breaker L={Lm}, 1 entry/day. TRAIN=2022-2023  TEST=2024-2026\n")
    print(f"{'gate':>5} | {'TRAIN ret':>9} {'MAR':>6} | {'TEST ret':>8} {'MAR':>6}")
    best = None
