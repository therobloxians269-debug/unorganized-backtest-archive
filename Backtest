        for ym in months:
            try:
                r = requests.get(URL.format(s=s, ym=ym), timeout=15)
                if r.status_code != 200:
                    continue
                z = zipfile.ZipFile(io.BytesIO(r.content))
                df = pd.read_csv(z.open(z.namelist()[0]))
                df.columns = [c.strip() for c in df.columns]
                tcol = "calc_time" if "calc_time" in df.columns else df.columns[0]
                rcol = "last_funding_rate" if "last_funding_rate" in df.columns else df.columns[-1]
                df["t"] = pd.to_datetime(df[tcol], unit="ms")
                df["sym"] = s
                df["fr"] = pd.to_numeric(df[rcol], errors="coerce")
                rows.append(df[["t", "sym", "fr"]])
                got += 1
            except Exception:
                pass
        print(f"  {s}: {got} months", flush=True)
    allf = pd.concat(rows, ignore_index=True)
    allf.to_parquet(CACHE)
