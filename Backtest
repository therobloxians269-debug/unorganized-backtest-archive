"""Positive-skew runner engine: tight stop, trail, long holds, concurrent positions.
   Targets the 1:5 .. 1:90 winner profile -- many small losses, rare huge winners."""
import pandas as pd,numpy as np,warnings; warnings.filterwarnings('ignore')

def add_atr(df,tf=60,n=14):
    r=df.resample(f'{tf}min',label='left',closed='left').agg({'h':'max','l':'min','c':'last'}).dropna()
    tr=pd.concat([r.h-r.l,(r.h-r.c.shift()).abs(),(r.l-r.c.shift()).abs()],axis=1).max(axis=1)
    a=tr.rolling(n).mean()
    df[f'atr{tf}']=a.reindex(df.index,method='ffill')
    return df

def sim(df,sig,A,minscore=0,max_stop=15.,buf=2.,
        trail_atr=2.0,trail_after_R=1.0,max_hold=7200,max_concurrent=3,
        max_trades_day=99,point_val=20.,comm=4.,slip_ticks=1.,tick=.25,be_at_R=0.0):
    o,h,l=A['o'],A['h'],A['l']; day=A['day']; bs,us=A['bs'],A['us']; atr=A['atr']
    n=len(o); slip=slip_ticks*tick; out=[]; used={}
    I,D,Ar=sig['i'].values,sig['d'].values,sig['arm_i'].values
    open_until=[]   # exit indices of currently-open trades
    for x in range(len(I)):
        i,d,a=int(I[x]),int(D[x]),int(Ar[x])
        if i+2>=n: continue
        open_until=[e for e in open_until if e>i]
        if len(open_until)>=max_concurrent: continue
        if minscore and ((bs[i] if d==-1 else us[i])<minscore): continue
        k=day[i]
        if used.get(k,0)>=max_trades_day: continue
        stop=(max(h[a:i+1].max(),h[i])+buf) if d==-1 else (min(l[a:i+1].min(),l[i])-buf)
        entry=o[i+1]+(-slip if d==-1 else slip); risk=abs(stop-entry)
        if risk>max_stop or risk<1.0: continue
        cs=stop; ext=entry; peakR=0.0; why='time'
        end=min(i+1+max_hold,n)
        for j in range(i+1,end):
            hi,lo=h[j],l[j]
            if (hi>=cs) if d==-1 else (lo<=cs):
                px=cs+(slip if d==-1 else -slip); why='trail' if peakR>0 else 'stop'; break
            ext=min(ext,lo) if d==-1 else max(ext,hi)
            curR=((entry-ext) if d==-1 else (ext-entry))/risk
            peakR=max(peakR,curR)
            if be_at_R and curR>=be_at_R:
                cs=min(cs,entry) if d==-1 else max(cs,entry)
            if curR>=trail_after_R and not np.isnan(atr[j]):
                ns=ext+trail_atr*atr[j] if d==-1 else ext-trail_atr*atr[j]
                cs=min(cs,ns) if d==-1 else max(cs,ns)
        else:
            j=end-1; px=o[j]+(slip if d==-1 else -slip)
        pts=(entry-px) if d==-1 else (px-entry)
        net=pts*point_val-comm
        out.append((df.index[i+1],d,risk,why,net,net/(risk*point_val),peakR,j-i))
        used[k]=used.get(k,0)+1; open_until.append(j)
    return pd.DataFrame(out,columns=['t','d','risk','why','pnl','R','peakR','bars'])

def arrs(df,tf=60):
    return dict(o=df['o'].values,h=df['h'].values,l=df['l'].values,day=df['daycycle'].values,
                bs=df['bear_score'].values,us=df['bull_score'].values,atr=df[f'atr{tf}'].values)
def f(t,pv=20.):
    if len(t)<5: return f'{"n="+str(len(t)):^62s}'
    pf=t.pnl[t.pnl>0].sum()/max(1e-9,-t.pnl[t.pnl<0].sum())
    return (f'n={len(t):4d} WR={(t.pnl>0).mean()*100:4.1f}% avgR={t.R.mean():+.3f} '
            f'$/tr={t.pnl.mean():+7.1f} PF={pf:4.2f} maxR={t.R.max():5.1f} net=${t.pnl.sum():+8.0f}')

