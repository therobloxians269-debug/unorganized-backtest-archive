def maxdd(usd):
    eq = np.cumsum(np.asarray(usd, float))
    return float(np.max(np.maximum.accumulate(np.concatenate([[0.0], eq])) -
                        np.concatenate([[0.0], eq]))) if len(eq) else 0.0


def stats(tr, ndays):
    if len(tr) == 0:
        return dict(n=0, avgR=np.nan, usd=np.nan, tpd=0.0, wr=np.nan,
                    dd=np.nan, drop3=np.nan, t=np.nan, tot=0.0)
    R = tr["R"].values; U = tr["usd"].values
    srt = np.sort(R)[::-1]
    drop3 = float(np.mean(srt[3:])) if len(R) > 3 else np.nan
    sd = R.std(ddof=1) if len(R) > 1 else np.nan
    return dict(n=int(len(R)), avgR=float(R.mean()), usd=float(U.mean()),
                tpd=len(R) / ndays, wr=float((U > 0).mean()),
                dd=maxdd(U), drop3=drop3,
                t=float(R.mean() / (sd / np.sqrt(len(R)))) if sd and sd > 0 else np.nan,
                tot=float(U.sum()))


