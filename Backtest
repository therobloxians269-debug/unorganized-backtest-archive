            if l[b] <= stop:
                g = (stop - entry) - fric("stop"); kind = "stop"
            elif h[b] >= lvl:
                g = (lvl - entry) - fric("target"); kind = "target"
            elif (b - ebar) >= tstop:
                g = (c[b] - entry) - fric("eod"); kind = "time"
            elif b == 77:
                g = (c[b] - entry) - fric("eod"); kind = "eod"
            else:
                continue
        else:
            if h[b] >= stop:
                g = (entry - stop) - fric("stop"); kind = "stop"
            elif l[b] <= lvl:
                g = (entry - lvl) - fric("target"); kind = "target"
            elif (b - ebar) >= tstop:
                g = (entry - c[b]) - fric("eod"); kind = "time"
            elif b == 77:
                g = (entry - c[b]) - fric("eod"); kind = "eod"
            else:
                continue
        res.append((s["date"], g, risk0, pos, kind))
        pos = 0
    return res


def run(S, er_thr, k_ext, m_stop, tstop=12):
    rows = [r for s in S for r in sim_day(s, er_thr, k_ext, m_stop, tstop)]
    return pd.DataFrame(rows, columns=["date", "net", "risk", "side", "kind"])


def stats(tr):
    if len(tr) == 0:
        return dict(net_usd=0.0, mar=0.0, trades=0, hit=0.0, maxdd_usd=0.0,
                    yearly={}, top3_month_share=0.0, expectancy_pts=0.0)
    tr = tr.copy()
    tr["dt"] = pd.to_datetime(tr["date"].astype(str))
    tr["usd"] = tr["net"] * DPP
    net_usd = float(tr["usd"].sum())
    day = tr.groupby("date")["usd"].sum()
    eq = day.cumsum().to_numpy()
    dd = float((eq - np.maximum.accumulate(eq)).min())
    mar = net_usd / abs(dd) if dd < 0 else float("inf")
    yearly = {str(y): round(float(v), 2)
              for y, v in tr.groupby(tr["dt"].dt.year)["usd"].sum().items()}
    mon = tr.groupby(tr["dt"].dt.to_period("M"))["usd"].sum().sort_values(ascending=False)
    top3 = float(mon.head(3).sum())
    top3_share = top3 / net_usd if net_usd > 0 else float("nan")
    return dict(net_usd=round(net_usd, 2),
                mar=round(mar, 3) if np.isfinite(mar) else mar,
                trades=int(len(tr)),
                hit=round(float((tr["net"] > 0).mean()), 4),
                maxdd_usd=round(dd, 2),
                yearly=yearly,
                top3_month_share=round(top3_share, 4) if np.isfinite(top3_share) else None,
                expectancy_pts=round(float(tr["net"].mean()), 4))


def survival(st, n_years):
    """DEV survival bar."""
    if st["trades"] == 0 or st["net_usd"] <= 0:
        return False, "net<=0 or no trades"
    ok = []
    ok.append(("net>0", st["net_usd"] > 0))
    ok.append(("MAR>=1", st["mar"] >= 1.0))
    ok.append(("trades>=80", st["trades"] >= 80))
    yv = list(st["yearly"].values())
    ok.append(("60%yrs+", sum(v > 0 for v in yv) >= 0.6 * n_years))
    ok.append(("noYr>50%", max(yv) <= 0.5 * st["net_usd"] if st["net_usd"] > 0 else False))
    return all(f for _, f in ok), ",".join(n for n, f in ok if not f)


def print_stats_block(name, st):
    print(f"\n=== {name} ===")
    print(f"trades={st['trades']}  net=${st['net_usd']:,.0f}  maxDD=${st['maxdd_usd']:,.0f}  "
          f"MAR={st['mar']}  hit={st['hit']:.3f}  expectancy={st['expectancy_pts']:+.3f} pts/trade  "
          f"top3mo_share={st['top3_month_share']}")
    print("yearly $: " + "  ".join(f"{y}:{v:+,.0f}" for y, v in sorted(st["yearly"].items())))


def sweep(S):
    n_years = len({str(s["date"])[:4] for s in S})
    print(f"\nSWEEP (DEV, {len(S)} sessions, {n_years} years) — 27 configs = "
          f"thr{GRID_THR} x k{GRID_K} x m{GRID_M}, tstop=12, both sides")
    print(f"{'thr':>4} {'k':>4} {'m':>4} | {'n':>5} {'net$':>8} {'MAR':>6} {'hit':>5} "
          f"{'yrs+':>5} {'maxYr%':>6} | {'nL':>5} {'long$':>8} {'nS':>5} {'short$':>8} | flags")
    table = {}
    for thr in GRID_THR:
        for k in GRID_K:
            for m in GRID_M:
                tr = run(S, thr, k, m)
                st = stats(tr)
                lg = tr[tr["side"] > 0]; sh = tr[tr["side"] < 0]
                yv = list(st["yearly"].values())
                yrs_pos = sum(v > 0 for v in yv)
                max_share = (max(yv) / st["net_usd"] * 100) if st["net_usd"] > 0 else float("nan")
                alive, why = survival(st, n_years)
                table[(thr, k, m)] = st
                mark = " <-- PREREG" if (thr, k, m) == (PREREG["er_thr"], PREREG["k_ext"], PREREG["m_stop"]) else ""
                print(f"{thr:>4.2f} {k:>4.1f} {m:>4.1f} | {st['trades']:>5d} {st['net_usd']:>8,.0f} "
                      f"{st['mar']:>6.2f} {st['hit']:>5.2f} {yrs_pos:>3d}/{n_years:<2d} {max_share:>5.0f}% | "
                      f"{len(lg):>5d} {lg['net'].sum()*DPP:>8,.0f} {len(sh):>5d} {sh['net'].sum()*DPP:>8,.0f} | "
                      f"{'PASS' if alive else 'fail:' + why}{mark}")
    # plateau check around pre-registered config
    thr0, k0, m0 = PREREG["er_thr"], PREREG["k_ext"], PREREG["m_stop"]
    print(f"\nPLATEAU CHECK around prereg (thr={thr0}, k={k0}, m={m0}) — "
          f"every one-step neighbor must be DEV-net-positive:")
    def neighbors(grid, x):
        i = grid.index(x)
        return [grid[j] for j in (i - 1, i + 1) if 0 <= j < len(grid)]
    all_pos = True
    for t in neighbors(GRID_THR, thr0):
        v = table[(t, k0, m0)]["net_usd"]; all_pos &= v > 0
        print(f"  thr->{t}: net=${v:,.0f} {'OK' if v > 0 else 'NEGATIVE'}")
    for kk in neighbors(GRID_K, k0):
        v = table[(thr0, kk, m0)]["net_usd"]; all_pos &= v > 0
        print(f"  k->{kk}:   net=${v:,.0f} {'OK' if v > 0 else 'NEGATIVE'}")
    for mm in neighbors(GRID_M, m0):
        v = table[(thr0, k0, mm)]["net_usd"]; all_pos &= v > 0
        print(f"  m->{mm}:   net=${v:,.0f} {'OK' if v > 0 else 'NEGATIVE'}")
    print(f"PLATEAU: {'YES — all neighbors net-positive' if all_pos else 'NO — needle'}")
    return table


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--window", choices=["dev", "holdout", "all"], default="dev")
    args = ap.parse_args()
    S = load_window(args.window)
    print(f"f02_vwap_reversion | window={args.window} | {len(S)} sessions "
          f"{S[0]['date']}..{S[-1]['date']}")

    # pre-registered config
