#!/usr/bin/env python3
"""Trend-filtered opening-range breakout AND range-fade on real ES 1-min bars.
Structural levers only (trend regime, volatility regime) with round defaults and
causal filters. Reports full + post-2018 OOS. Net of 0.75pt MES friction."""
import math
import numpy as np, pandas as pd

FRIC=0.75; PT_USD=5.0

def hac_t(y,lags=5):
    y=np.asarray(y,float); n=y.size
    if n<10 or np.allclose(y,0): return 0.0
    e=y-y.mean(); s=(e@e)/n
    for l in range(1,min(lags,n-1)+1): s+=2*(1-l/(lags+1))*(e[l:]@e[:-l])/n
    return float(y.mean()/math.sqrt(max(s,1e-12)/n))

def load():
    df=pd.read_parquet("/Users/kaveh/mim_research/es_front_rth_1m.parquet")
    df["date"]=pd.to_datetime(df["date"]).dt.date
    hm=df["hm"].str.split(":",expand=True)
    df["mos"]=(hm[0].astype(int)*60+hm[1].astype(int))-(9*60+30)
    df=df[(df["mos"]>=0)&(df["mos"]<390)]
    # daily close + trend context (causal)
    dc=df.sort_values(["date","mos"]).groupby("date")["close"].last()
    dclose=dc.to_frame("dclose")
    dclose["sma20"]=dclose["dclose"].rolling(20).mean()
    dclose["trend20"]=np.sign(dclose["dclose"].shift(1)-dclose["sma20"].shift(1))   # prior day vs its SMA
    dclose["prevclose"]=dclose["dclose"].shift(1)
    return df, dclose

def day_signal(g, W, mode, orrange_med, trend_bias, prevclose):
    o=g["open"].to_numpy(); h=g["high"].to_numpy(); l=g["low"].to_numpy(); c=g["close"].to_numpy()
    m=g["mos"].to_numpy()
    idx={int(x):i for i,x in enumerate(m)}
    orb=[idx[k] for k in range(W) if k in idx]
    if len(orb)<W: return None
    oh=float(np.max(h[orb])); ol=float(np.min(l[orb])); orr=oh-ol
    walk=[idx[k] for k in range(W,390) if k in idx]
    if not walk or orr<=0: return None
    volOK = np.isnan(orrange_med) or orr>=orrange_med    # trade only "real range" days
    # find first OR break
    d=0; entry=np.nan; start=None
    for k,i in enumerate(walk):
        up=float(h[i])>=oh; dn=float(l[i])<=ol
        if up and not dn: d=1; entry=oh; start=k; break
        if dn and not up: d=-1; entry=ol; start=k; break
        if up and dn:
            d=1 if float(o[i])>=oh else -1; entry=oh if d>0 else ol; start=k; break
    if d==0: return None
    seg=walk[start:]
    if mode=="breakout":
        # trend filter: only take breakout aligned with daily trend bias (if given)
        if trend_bias is not None and not np.isnan(trend_bias) and trend_bias!=0 and d!=trend_bias:
            return None
        if not volOK: return None
        sd=d; e=entry; stop=ol if d>0 else oh
    else:  # fade: fade the break back toward the range (range-day capture)
        sd=-d; e=entry; stop = entry + d*orr*0.5   # stop 0.5*OR beyond the break
        if not volOK: return None
    risk=abs(e-stop)
    if risk<=0: return None
    tgt = (float(o[idx[0]])) if mode=="fade" else None   # fade targets the OR open (mid-ish); breakout rides to EOD
    exit_px=float(c[seg[-1]]);
    for i in seg:
        hi=float(h[i]); lo=float(l[i])
        hs=(lo<=stop) if sd>0 else (hi>=stop)
        ht=tgt is not None and ((hi>=tgt) if sd>0 else (lo<=tgt))
        if hs: exit_px=stop; break
        if ht: exit_px=tgt; break
    return sd*(exit_px-e)-FRIC

def backtest(df,dclose,W,mode,use_trend,use_vol):
    # trailing median OR range (causal): compute per day then shift
    orr_by_day={}
    for dte,g in df.groupby("date",sort=True):
        g=g.sort_values("mos"); m=g["mos"].to_numpy(); idx={int(x):i for i,x in enumerate(m)}
        orb=[idx[k] for k in range(W) if k in idx]
        if len(orb)>=W:
            h=g["high"].to_numpy(); l=g["low"].to_numpy()
            orr_by_day[dte]=float(np.max(h[orb])-np.min(l[orb]))
    orr=pd.Series(orr_by_day).sort_index()
    orr_med=orr.rolling(40).median().shift(1)   # prior 40-day median, causal
    pnl=[]; dts=[]
    for dte,g in df.groupby("date",sort=True):
        g=g.sort_values("mos")
        tb = dclose["trend20"].get(dte, np.nan) if use_trend else None
        pc = dclose["prevclose"].get(dte, np.nan)
        med = orr_med.get(dte, np.nan) if use_vol else np.nan
        r=day_signal(g,W,mode,med,tb,pc)
        if r is not None: pnl.append(r); dts.append(dte)
    return np.array(pnl), np.array([d.year for d in dts])

def summ(pnl,label):
    n=pnl.size
    if n<10: return {"cell":label,"n":n,"net_pt":None,"hit":None,"pf":None,"hac_t":None,"ann_usd":None}
    win=pnl[pnl>0]; los=pnl[pnl<=0]
    pf=(win.sum()/abs(los.sum())) if los.size and los.sum()!=0 else float('inf')
    return {"cell":label,"n":n,"net_pt":round(float(pnl.mean()),4),
            "ann_usd":round(float(pnl.sum()/(n/252)*PT_USD),0),
            "hit":round(float((pnl>0).mean()),3),"pf":round(float(pf),2),"hac_t":round(hac_t(pnl),2)}

def main():
    df,dclose=load()
    print(f"{df['date'].nunique()} sessions {min(df['date'])}..{max(df['date'])}  fric={FRIC}pt\n")
    rows=[]
    for W in (15,30):
        for mode in ("breakout","fade"):
            for ut in ((False,True) if mode=="breakout" else (False,)):
                for uv in (False,True):
                    pnl,yr=backtest(df,dclose,W,mode,ut,uv)
                    tag=f"OR{W}_{mode}_trend{int(ut)}_vol{int(uv)}"
                    rows.append(summ(pnl,tag+" FULL"))
                    rows.append(summ(pnl[yr>=2018],tag+" OOS18+"))
    pd.set_option("display.width",200)
    print(pd.DataFrame(rows).to_string(index=False))
    print(f"\nhurdle {FRIC}pt. Want: net_pt>0 on FULL & OOS, HAC-t>=2, hit/pf sane.")

if __name__=="__main__":
    main()

