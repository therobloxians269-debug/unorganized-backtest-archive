#!/usr/bin/env python3
"""
fetch_sp500_changes.py  —  build events.csv for recon_reversal_freetest.py

Scrapes the authoritative, FREE S&P 500 component-change history from Wikipedia
("List of S&P 500 companies" -> "Selected changes to the list of S&P 500
components") and writes it in the events contract:

    ticker,effective_date,action,index

Run this LOCALLY (needs network + lxml):
    pip install pandas lxml
    python fetch_sp500_changes.py --out events_sp500.csv --since 2015-01-01

NOTES / HONESTY
---------------
* Wikipedia's change table is the cleanest free source but is community-maintained.
  Spot-check a sample of effective dates against S&P DJI press releases before
  you trust a DEAD/SURVIVES verdict on borderline numbers.
* The "Date" column on that table is the change's EFFECTIVE date. The harness's
  default --entry-on eff_prev_close enters at the close of the trading day BEFORE
  this date (the auction that prints the forced flow), which matches S&P practice
  of names being effective "prior to the open" of the stated date.
* Russell reconstitution is NOT here. Get Russell add/delete lists from FTSE
  Russell's recon files (also free) and append rows with index=r1000 / r2000 and
  effective_date = the June recon effective date. More events = more power.
* Tickers change/delist. The harness drops names with missing price history and
  logs the count, so a few stale tickers won't corrupt the test.
"""
from __future__ import annotations

import argparse
import pandas as pd

WIKI_URL = "https://en.wikipedia.org/wiki/List_of_S%26P_500_companies"


def fetch_changes(url: str = WIKI_URL) -> pd.DataFrame:
    tables = pd.read_html(url)
    # The changes table has a multi-level header with Added/Removed groups and
    # a Date column. Find it by structure rather than position (position drifts).
    changes = None
    for t in tables:
        cols = ["|".join(map(str, c)).lower() if isinstance(c, tuple) else str(c).lower()
                for c in t.columns]
        joined = " ".join(cols)
        if "added" in joined and "removed" in joined and "date" in joined:
            changes = t.copy()
            changes.columns = cols
            break
    if changes is None:
        raise RuntimeError("Could not locate the S&P 500 changes table; "
                           "Wikipedia layout may have changed.")
    return changes


def to_events(changes: pd.DataFrame) -> pd.DataFrame:
    # locate columns by keyword
    def find(key_a, key_b=None):
        for c in changes.columns:
            if key_a in c and (key_b is None or key_b in c):
                return c
        return None

    date_col = find("date")
    add_tk = find("added", "ticker") or find("added", "symbol")
    rem_tk = find("removed", "ticker") or find("removed", "symbol")
    if date_col is None or (add_tk is None and rem_tk is None):
        raise RuntimeError(f"Unexpected columns: {list(changes.columns)}")

    rows = []
    dates = pd.to_datetime(changes[date_col], errors="coerce")
    for i in range(len(changes)):
        d = dates.iloc[i]
        if pd.isna(d):
            continue
        if add_tk is not None:
            tk = str(changes[add_tk].iloc[i]).strip()
            if tk and tk.lower() != "nan":
                rows.append({"ticker": tk, "effective_date": d.date(),
                             "action": "add", "index": "sp500"})
        if rem_tk is not None:
            tk = str(changes[rem_tk].iloc[i]).strip()
            if tk and tk.lower() != "nan":
                rows.append({"ticker": tk, "effective_date": d.date(),
                             "action": "delete", "index": "sp500"})
    ev = pd.DataFrame(rows)
    # clean tickers (Wikipedia sometimes uses BRK.B style; your price source may
    # want BRK-B -- adjust here to match your data vendor's symbology)
    ev["ticker"] = ev["ticker"].str.replace(r"\.", "-", regex=True).str.upper()
    return ev.sort_values("effective_date").reset_index(drop=True)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--out", default="events_sp500.csv")
    ap.add_argument("--since", default="2010-01-01")
    ap.add_argument("--url", default=WIKI_URL)
    args = ap.parse_args()

    ev = to_events(fetch_changes(args.url))
    ev = ev[pd.to_datetime(ev["effective_date"]) >= pd.to_datetime(args.since)]
    ev.to_csv(args.out, index=False)
    n_add = int((ev["action"] == "add").sum())
    print(f"Wrote {len(ev)} events ({n_add} adds / {len(ev)-n_add} deletes) "
          f"since {args.since} -> {args.out}")
    print("Distinct tickers:", ev["ticker"].nunique())
    print("Year span:", pd.to_datetime(ev['effective_date']).dt.year.min(),
          "->", pd.to_datetime(ev['effective_date']).dt.year.max())
    print("\nNext: pull daily OHLC for these tickers + SPY, then run:")
    print(f"  python recon_reversal_freetest.py --events {args.out} "
          f"--prices ./prices_dir --market SPY.csv")


if __name__ == "__main__":
    main()

