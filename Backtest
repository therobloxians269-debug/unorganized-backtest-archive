      f"{rngpct.median()/STOP_PCT:.1f}R median\n")


def simulate(target_frac, use_fixed_r=None):
    """target_frac: fraction of the range toward the opposite block (1.0 = full DOL).
       use_fixed_r: if set, ignore the range and use a fixed R multiple instead."""
    trades = []
