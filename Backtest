"""
$5k FUTURES PROGRAM -- trend + CARRY on the 14-market local basket, then combine.
Carry = term-structure roll yield (long backwardation / short contango, vol-scaled).
Tests whether carry is uncorrelated enough to trend to lift the portfolio Sharpe.

    python3 futures_program.py
"""
from __future__ import annotations
import numpy as np
import pandas as pd
from lib_perf import perf_stats, psr, deflated_sharpe, per_year, maxdd, line

PANEL = "/Users/kaveh/mim_research/futures_panel.parquet"
ANN = 252
LOOKS, VW, COST_BP = (21, 63, 126, 252), 63, 3.0
OOS = "2018-01-01"


def vol_target(w, rets, tgt, win=VW, cap=3.0):
    g = (w * rets).sum(axis=1)
    scale = (tgt / (g.rolling(win).std() * np.sqrt(ANN))).shift(1).clip(0, cap).fillna(0.0)
    return w.mul(scale, axis=0)


def net_of(w, rets, cost_bp=COST_BP):
    turn = w.diff().abs().sum(axis=1)
    net = ((w * rets).sum(axis=1) - turn * cost_bp * 1e-4).dropna()
    return net, turn.mean() * ANN


def normalize(w):
    return w.div(w.abs().sum(axis=1).replace(0, np.nan), axis=0).fillna(0.0)


def weekly(w):
    return w.resample("W").last().reindex(w.index, method="ffill")


def summ(name, net, turn):
    s = perf_stats(net, ANN)
    oos = perf_stats(net[net.index >= OOS], ANN)["sharpe"]
    print(f"  {name:18s} Sh {s['sharpe']:5.2f} | CAGR {s['cagr']*100:5.1f}% | maxDD {s['maxdd']*100:6.1f}% "
          f"| Calmar {s['calmar']:4.2f} | turn {turn:4.0f}x | OOS18 Sh {oos:4.2f}")
    return net


def main():
    p = pd.read_parquet(PANEL)
    F = p.pivot_table(index="date", columns="root", values="fret")           # returns
    K = p.pivot_table(index="date", columns="root", values="carry_ann")      # carry
    F = F.sort_index(); K = K.reindex(F.index).ffill(limit=5)
    AV = (F.rolling(VW).std() * np.sqrt(ANN)).shift(1)
    P = (1 + F.fillna(0)).cumprod()

    CAP = 0.20                                   # max gross weight per market (kills domination)
    # ---- TREND sleeve (slower, weekly, capped) ----
    z = sum((P / P.shift(L) - 1) / (AV * np.sqrt(L / ANN)) for L in (63, 126, 252)) / 3
    wT = normalize((np.tanh(z) / AV).shift(1)).clip(-CAP, CAP)
    wT = vol_target(weekly(wT), F, 0.12)
    nT, tT = net_of(wT, F)

    # ---- CARRY sleeve (per-market TS z-score of carry, weekly, capped) ----
    Kz = (K - K.rolling(252).mean()) / K.rolling(252).std()    # is THIS market's carry high vs own history
    Kz = Kz.clip(-3, 3)
    wC = normalize((np.tanh(Kz) / AV).shift(1)).clip(-CAP, CAP)
    wC = vol_target(weekly(wC), F, 0.12)
    nC, tC = net_of(wC, F)

    print(f"14-market futures  {F.index[0].date()} -> {F.index[-1].date()}\n")
    summ("TREND", nT, tT)
    summ("CARRY", nC, tC)
    j = pd.concat([nT.rename("T"), nC.rename("C")], axis=1).dropna()
    rho = j["T"].corr(j["C"])
    print(f"\n  corr(trend, carry) = {rho:+.2f}  (low = real diversification)")

    # ---- combine (risk-parity 50/50 unit-vol) then target 12% ----
    uT = nT / (nT.std() * np.sqrt(ANN)); uC = nC / (nC.std() * np.sqrt(ANN))
    combo = ((uT + uC) / 2).dropna()
    combo = combo / (combo.std() * np.sqrt(ANN)) * 0.12          # retarget 12% vol
    summ("TREND+CARRY", combo, (tT + tC) / 2)

    print(f"\n  combo PSR vs 0 {psr(combo,0,ANN)*100:.0f}% | PSR vs 1.0 {psr(combo,1.0,ANN)*100:.0f}% | "
          f"DSR@N15 {deflated_sharpe(combo,15,np.var([perf_stats(nT,ANN)['sharpe'],perf_stats(nC,ANN)['sharpe']]),ANN)*100:.0f}%")
    print("\n  per-year NET (trend / carry / combo):")
    py = pd.concat([per_year(nT), per_year(nC), per_year(combo)], axis=1, keys=["T", "C", "X"])
    for y, r in py.iterrows():
        print(f"    {y}   T {r['T']*100:+6.1f}%   C {r['C']*100:+6.1f}%   combo {r['X']*100:+6.1f}%")

    base = combo / (combo.std() * np.sqrt(ANN))
    print("\n  combo vol-target frontier ($5k, toward 30% DD):")
    print(f"    {'vol':>5} {'CAGR':>7} {'realDD':>7} {'$5k->':>9} {'Sharpe':>6}")
    for vt in (0.10, 0.15, 0.20, 0.25, 0.30):
        r = base * vt
        cagr = (1 + r).prod() ** (1 / (len(r) / ANN)) - 1
        flag = "  <- ~30% DD" if -0.34 < maxdd(r) < -0.27 else ""
        print(f"    {vt*100:4.0f}% {cagr*100:6.1f}% {maxdd(r)*100:6.1f}% {5000*(1+r).prod():9.0f}$ "
              f"{r.mean()/r.std()*np.sqrt(ANN):5.2f}{flag}")


if __name__ == "__main__":
    main()

