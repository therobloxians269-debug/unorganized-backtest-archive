"""
=============================================================================
IABR Strategy  –  Module 2: Volatility Regime Classification
=============================================================================
Strategy    : Intraday Auction Balance Reversion (IABR)
Instruments : MES · ES · MNQ · NQ · MYM · YM
Environment : Python 3.10+  |  Google Colab compatible
Version     : 1.1  (pandas 3.0 compatible; stdlib zoneinfo)
Depends on  : m1_data_session.py
=============================================================================

DESCRIPTION
-----------
Classifies every bar and session into one of four volatility regimes:

    CONTRACTED  vol < 25th percentile  (tight range)
    BALANCED    25th-75th percentile   (normal range - IABR target)
    EXPANDING   75th-90th percentile   (volatility picking up)
    TRENDING    > 90th percentile  OR  strong intraday directional move
    UNKNOWN     insufficient history (warmup period)

Two independent regime layers are produced:

    pre_session_regime
        Determined before each session opens using only completed prior-
        session data.  Constant across all bars in a session.

    intraday_regime
        Updated bar-by-bar.  Starts as pre_session_regime.  Latches to
        TRENDING permanently within the session if either:
            (a) price travels > trending_run_atr ATRs from the session open
            (b) the Kaufman Efficiency Ratio exceeds trending_er after
                at least er_min_bars bars.
        Once latched, TRENDING cannot revert within the session.

DESIGN RATIONALE
----------------
IABR depends on price rotating around institutional reference levels.
Trending sessions destroy this premise.  This module exists exclusively
to prevent the strategy from operating in the wrong market context.

LOOKAHEAD GUARANTEE
-------------------
Session-level features for session N use ONLY data from sessions 0 to N-1.
shift(1) is applied before every rolling operation.  Intraday features at
bar T use only bars within the current session up to bar T (expanding).

OUTPUT SCHEMA  (new columns appended to the Module 1 output)
------------------------------------------------------------
  tr                  float64   - True Range, every bar
  atr_5s              float64   - 5-session rolling ATR  (pre-session)
  atr_10s             float64   - 10-session rolling ATR (pre-session)
  atr_20s             float64   - 20-session rolling ATR (pre-session)
  overnight_gap_pct   float64   - (open - prior_close) / prior_close
  gap_flag            bool      - |gap| > large_gap_pct threshold
  vol_pct_rank        float64   - 0-100; atr_10s percentile vs trailing 60
  pre_session_regime  category  - see RegimeLabel
  session_atr_live    float64   - expanding mean TR within current session
  intraday_run_score  float64   - (close - session_open) / atr_20s
  intraday_er         float64   - Kaufman Efficiency Ratio (expanding)
  intraday_regime     category  - live regime; latches to TRENDING on move
  regime_gate         bool      - True = regime is favourable for IABR
=============================================================================
"""

# ---- 0. Imports -------------------------------------------------------------
import logging
import warnings
from dataclasses import dataclass
from enum import Enum
from typing import Dict, Optional, Tuple

import numpy as np
import pandas as pd

from m1_data_session import (
    MODULE1_OUTPUT_SCHEMA,
    DataLoader,
    EconomicCalendar,
    SessionManager,
    SessionType,
    run_module1_demo,
    validate_module1_output,
)

warnings.filterwarnings("ignore", category=pd.errors.PerformanceWarning)

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(name)s - %(message)s",
    datefmt="%H:%M:%S",
)
logger = logging.getLogger("IABR.M2")

__all__ = [
    "RegimeLabel",
    "RegimeConfig",
    "VolatilityRegimeModule",
    "MODULE2_OUTPUT_SCHEMA",
    "validate_module2_output",
    "run_module2_demo",
]


# ============================================================================
# SECTION 1 - REGIME ENUMERATION
# ============================================================================

class RegimeLabel(str, Enum):
    CONTRACTED = "contracted"
    BALANCED   = "balanced"
    EXPANDING  = "expanding"
    TRENDING   = "trending"
    UNKNOWN    = "unknown"


_IABR_FAVORABLE  = frozenset({RegimeLabel.BALANCED.value})
_ALL_REGIME_CATS = [r.value for r in RegimeLabel]


# ============================================================================
# SECTION 2 - CONFIGURATION
# ============================================================================

@dataclass
class RegimeConfig:
    """
    Threshold parameters for regime classification.

    Percentile thresholds
    ---------------------
    contracted_pct   below -> CONTRACTED
    expanding_pct    above -> EXPANDING
    trending_pct     above -> TRENDING (vol-based)

    Intraday trend detection
    ------------------------
    trending_run_atr  price moves > N ATRs from session open -> TRENDING latch
    trending_er       expanding mean ER > threshold          -> TRENDING latch
    er_min_bars       minimum bars before ER latch is evaluated
    """
    contracted_pct:   float            = 25.0
    expanding_pct:    float            = 75.0
    trending_pct:     float            = 90.0
    atr_windows:      Tuple[int, ...]  = (5, 10, 20)
    vol_lookback:     int              = 60
    min_history:      int              = 20
    large_gap_pct:    float            = 0.005
    trending_run_atr: float            = 1.5
    trending_er:      float            = 0.65
    er_min_bars:      int              = 20

    def __post_init__(self) -> None:
        assert self.contracted_pct < self.expanding_pct
        assert self.expanding_pct  < self.trending_pct <= 100.0
        assert self.vol_lookback   >= self.min_history
        assert all(w > 0 for w in self.atr_windows)


# ============================================================================
# SECTION 3 - VOLATILITY REGIME MODULE
# ============================================================================

class VolatilityRegimeModule:
    """
    Main processing engine for Module 2.

    Session-level pipeline (one computation per trading day)
    --------------------------------------------------------
    _compute_session_aggregates  -> session OHLCV, range, overnight gap
    _compute_rolling_atrs        -> atr_5s / atr_10s / atr_20s
    _compute_vol_percentile_rank -> vol_pct_rank
    _classify_pre_session_regime -> pre_session_regime label
    _broadcast_session_data      -> map session cols to every bar

    Bar-level pipeline (expanding within each session)
    --------------------------------------------------
    _compute_true_range          -> tr
    _compute_intraday_metrics    -> session_atr_live, run_score, ER
    _compute_intraday_regime     -> intraday_regime with latch logic
    _compute_regime_gate         -> regime_gate boolean
    """

    def __init__(self, config: Optional[RegimeConfig] = None) -> None:
        self.config = config or RegimeConfig()
        logger.info(
            f"VolatilityRegimeModule ready | "
            f"contracted<{self.config.contracted_pct}th | "
            f"balanced={self.config.contracted_pct}th-{self.config.expanding_pct}th | "
            f"trending>{self.config.trending_pct}th or run>{self.config.trending_run_atr}xATR"
        )

    # ---- Main entry point ---------------------------------------------------

    def process(self, df_m1: pd.DataFrame) -> pd.DataFrame:
        """
        Annotate a Module 1 output DataFrame with all regime columns.
        The input is never mutated.
        """
        if not validate_module1_output(df_m1):
            raise ValueError("Input does not conform to Module 1 output schema.")

        df = df_m1.copy()

        # Session-level
        sess = self._compute_session_aggregates(df)
        sess = self._compute_rolling_atrs(sess)
        sess = self._compute_vol_percentile_rank(sess)
        sess = self._classify_pre_session_regime(sess)
        df   = self._broadcast_session_data(df, sess)

        # Bar-level
        df = self._compute_true_range(df)
        df = self._compute_intraday_metrics(df)
        df = self._compute_intraday_regime(df)
        df = self._compute_regime_gate(df)

        self._log_summary(df)
        return df

    # =========================================================================
    # SESSION-LEVEL STEPS
    # =========================================================================

    def _compute_session_aggregates(self, df: pd.DataFrame) -> pd.DataFrame:
        """
        One row per RTH session.

        Columns: s_open/high/low/close, s_volume, s_bars, s_range, s_body,
                 s_dir, overnight_gap_pct, gap_flag.

        CAUSAL: overnight_gap_pct at session N uses session N-1 close (shift).
        Session N's range only enters the ATR when computing session N+1.
        """
        rth_mask = df["session_type"] == SessionType.RTH.value
        rth_df   = df.loc[rth_mask]
        if rth_df.empty:
            raise ValueError("No RTH bars in input.")

        sess = rth_df.groupby("rth_session_id", sort=True).agg(
            s_open   = ("open",   "first"),
            s_high   = ("high",   "max"),
            s_low    = ("low",    "min"),
            s_close  = ("close",  "last"),
            s_volume = ("volume", "sum"),
            s_bars   = ("close",  "count"),
        )
        sess["s_range"] = sess["s_high"] - sess["s_low"]
        sess["s_body"]  = (sess["s_close"] - sess["s_open"]).abs()
        sess["s_dir"]   = np.sign(sess["s_close"] - sess["s_open"])

        prior_close = sess["s_close"].shift(1)
        sess["overnight_gap_pct"] = (
            (sess["s_open"] - prior_close) / prior_close.clip(lower=1e-9)
        )
        sess["gap_flag"] = sess["overnight_gap_pct"].abs() > self.config.large_gap_pct
        return sess

    def _compute_rolling_atrs(self, sess: pd.DataFrame) -> pd.DataFrame:
        """
        Rolling mean of session range at each window in config.atr_windows.

        CAUSAL: shift(1) before rolling means ATR at session N uses
        sessions N-w to N-1 exclusively.
        """
        shifted = sess["s_range"].shift(1)
        for w in self.config.atr_windows:
            sess[f"atr_{w}s"] = shifted.rolling(
                window=w, min_periods=max(1, w // 2)
            ).mean()
        return sess

    def _compute_vol_percentile_rank(self, sess: pd.DataFrame) -> pd.DataFrame:
        """
        Percentile rank of atr_10s vs its trailing vol_lookback distribution.

        Result: 0-100.  Sessions with < min_history data points -> NaN.

        No lookahead: atr_10s[N] was built from sessions <= N-1, so
        including it in its own rank window does not use future data.
        """
        atr_col = "atr_10s" if "atr_10s" in sess.columns else f"atr_{self.config.atr_windows[0]}s"
        sess["vol_pct_rank"] = (
            sess[atr_col]
            .rolling(window=self.config.vol_lookback, min_periods=self.config.min_history)
            .rank(pct=True)
            * 100.0
        )
        return sess

    def _classify_pre_session_regime(self, sess: pd.DataFrame) -> pd.DataFrame:
        """Map vol_pct_rank to RegimeLabel via vectorised np.select."""
        pct      = sess["vol_pct_rank"]
        has_data = pct.notna()
        cfg      = self.config

        conditions = [
            ~has_data,
            has_data & (pct <  cfg.contracted_pct),
            has_data & (pct >= cfg.contracted_pct) & (pct < cfg.expanding_pct),
            has_data & (pct >= cfg.expanding_pct)  & (pct < cfg.trending_pct),
        ]
        choices = [
            RegimeLabel.UNKNOWN.value,
            RegimeLabel.CONTRACTED.value,
            RegimeLabel.BALANCED.value,
            RegimeLabel.EXPANDING.value,
        ]
        sess["pre_session_regime"] = pd.Categorical(
            np.select(conditions, choices, default=RegimeLabel.TRENDING.value),
            categories=_ALL_REGIME_CATS,
        )
        return sess

    def _broadcast_session_data(
        self, df: pd.DataFrame, sess: pd.DataFrame
    ) -> pd.DataFrame:
        """
        Map session-level columns to every bar via rth_session_id.
        Non-RTH bars (rth_session_id=NaN) receive NaN for all session columns.
        The regime column Categorical dtype is explicitly restored after mapping.
        """
        cols = (
            [f"atr_{w}s" for w in self.config.atr_windows]
            + ["overnight_gap_pct", "gap_flag", "vol_pct_rank", "pre_session_regime"]
        )
        for col in cols:
            if col not in sess.columns:
                continue
            mapped = df["rth_session_id"].map(sess[col])
            if col == "pre_session_regime":
                df[col] = pd.Categorical(mapped, categories=_ALL_REGIME_CATS)
            else:
                df[col] = mapped
        return df

    # =========================================================================
    # BAR-LEVEL STEPS
    # =========================================================================

    def _compute_true_range(self, df: pd.DataFrame) -> pd.DataFrame:
        """
        TR = max(H-L, |H-prev_C|, |L-prev_C|).
        First bar receives H-L.  Session gaps are intentionally captured
        in the first bar's TR (standard CME futures convention).
        """
        prev    = df["close"].shift(1)
        df["tr"] = pd.concat([
            df["high"] - df["low"],
            (df["high"] - prev).abs(),
            (df["low"]  - prev).abs(),
        ], axis=1).max(axis=1)
        return df

    def _compute_intraday_metrics(self, df: pd.DataFrame) -> pd.DataFrame:
        """
        Three expanding intraday metrics (RTH bars only; non-RTH = NaN).

        session_atr_live    Expanding mean TR within session.
                            = cumsum(tr) / bar_count_in_session

        intraday_run_score  Signed distance from session open in ATR units.
                            = (close - session_open) / atr_20s
                            Uses pre-session ATR for a stable denominator.
                            Falls back to session_atr_live if atr_20s is NaN.

        intraday_er         Kaufman Efficiency Ratio.
                            = |close - session_open| / cumsum(tr)
                            Range [0, 1].  Low = choppy (good for IABR).
        """
        for col in ("session_atr_live", "intraday_run_score", "intraday_er"):
            df[col] = np.nan

        rth_mask = df["session_type"] == SessionType.RTH.value
        if not rth_mask.any():
            return df

        rth = df.loc[rth_mask].copy()
        grp = rth.groupby("rth_session_id", sort=False)

        # session_atr_live
        tr_cumsum = grp["tr"].cumsum()
        bar_num   = grp["tr"].cumcount() + 1
        atr_live  = tr_cumsum / bar_num

        # session open price
        sess_open = grp["open"].transform("first")

        # intraday_run_score
        ps_atr    = rth["atr_20s"].where(rth["atr_20s"].notna(), other=atr_live)
        ps_atr    = ps_atr.clip(lower=1e-9)
        run_score = (rth["close"] - sess_open) / ps_atr

        # intraday_er
        net_move = (rth["close"] - sess_open).abs()
        cum_tr   = grp["tr"].cumsum().clip(lower=1e-9)
        er       = (net_move / cum_tr).clip(upper=1.0)

        # Write back (positional alignment is safe: rth is a contiguous
        # ordered slice of df with no intervening modifications)
        df.loc[rth_mask, "session_atr_live"]   = atr_live.values
        df.loc[rth_mask, "intraday_run_score"] = run_score.values
        df.loc[rth_mask, "intraday_er"]        = er.values
        return df

    def _compute_intraday_regime(self, df: pd.DataFrame) -> pd.DataFrame:
        """
        Live intraday regime with TRENDING latch.

        Initialisation: each bar inherits pre_session_regime.

        TRENDING latch triggers (either is sufficient):
            Trigger 1 - Run score
                cummax(|intraday_run_score|) > trending_run_atr
                Vectorised via GroupBy.cummax().

            Trigger 2 - Efficiency ratio
                expanding_mean(intraday_er) > trending_er
                AND bar_position >= er_min_bars
                Expanding mean = cumsum(er) / bar_count.

        UNKNOWN sessions are never overridden.
        Non-RTH bars: NaN (preserved).
        """
        # Start with an object-dtype copy to allow free string assignment
        df["intraday_regime"] = df["pre_session_regime"].astype(object)

        rth_mask = df["session_type"] == SessionType.RTH.value
        if not rth_mask.any():
            df["intraday_regime"] = pd.Categorical(
                df["intraday_regime"], categories=_ALL_REGIME_CATS
            )
            return df

        rth = df.loc[rth_mask].copy()
        cfg = self.config
        grp = rth.groupby("rth_session_id", sort=False)

        # Trigger 1: run score latch
        abs_run   = rth["intraday_run_score"].abs()
        max_run   = abs_run.groupby(rth["rth_session_id"]).cummax()
        run_latch = max_run > cfg.trending_run_atr

        # Trigger 2: ER latch
        bar_pos     = grp["tr"].cumcount()
        er_cumsum   = grp["intraday_er"].cumsum()
        er_exp_mean = er_cumsum / (bar_pos + 1)
        er_latch    = (bar_pos >= cfg.er_min_bars) & (er_exp_mean > cfg.trending_er)

        # Composite override (exclude UNKNOWN sessions)
        not_unknown  = rth["pre_session_regime"] != RegimeLabel.UNKNOWN.value
        override_idx = rth.index[(run_latch | er_latch) & not_unknown]
        df.loc[override_idx, "intraday_regime"] = RegimeLabel.TRENDING.value

        df["intraday_regime"] = pd.Categorical(
            df["intraday_regime"], categories=_ALL_REGIME_CATS
        )
        return df

    def _compute_regime_gate(self, df: pd.DataFrame) -> pd.DataFrame:
        """
        regime_gate = True when intraday_regime in IABR_FAVORABLE and RTH.
        Module 5 combines this with signal_eligible (M1) for final entry gate.
        """
        rth_ok        = df["session_type"] == SessionType.RTH.value
        reg_ok        = df["intraday_regime"].isin(_IABR_FAVORABLE)
        df["regime_gate"] = (rth_ok & reg_ok).astype(bool)
        return df

    # ---- Logging ------------------------------------------------------------

    def _log_summary(self, df: pd.DataFrame) -> None:
        rth_mask = df["session_type"] == SessionType.RTH.value
        rth_bars = rth_mask.sum()
        pre_d    = df.loc[rth_mask, "pre_session_regime"].value_counts().to_dict()
        intr_d   = df.loc[rth_mask, "intraday_regime"].value_counts().to_dict()
        gate_pct = df["regime_gate"].sum() / rth_bars * 100 if rth_bars else 0.0
        logger.info(
            f"[M2] total={len(df):,} | rth={rth_bars:,} | "
            f"pre={pre_d} | intra={intr_d} | "
            f"gate={df['regime_gate'].sum():,} ({gate_pct:.1f}% of RTH)"
        )


# ============================================================================
# SECTION 4 - OUTPUT SCHEMA
# ============================================================================

MODULE2_OUTPUT_SCHEMA: Dict[str, str] = {
    "tr":                  "float64",
    "atr_5s":              "float64",
    "atr_10s":             "float64",
    "atr_20s":             "float64",
    "overnight_gap_pct":   "float64",
    "gap_flag":            "bool",
    "vol_pct_rank":        "float64",
    "pre_session_regime":  "category",
    "session_atr_live":    "float64",
    "intraday_run_score":  "float64",
    "intraday_er":         "float64",
    "intraday_regime":     "category",
    "regime_gate":         "bool",
}


def validate_module2_output(df: pd.DataFrame) -> bool:
    """Verify all MODULE2_OUTPUT_SCHEMA columns are present."""
    missing = [c for c in MODULE2_OUTPUT_SCHEMA if c not in df.columns]
    if missing:
        logger.error(f"Module 2 schema VIOLATION - missing: {missing}")
        return False
    return True


