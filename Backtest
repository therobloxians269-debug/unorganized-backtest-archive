"""
M1 — Data prep for The Box Theory backtest.

Source: real ES front-month continuous 1-minute bars (Databento GLBX, 2010-2026),
        NOT the synthetic ict/judas micro CSVs.

Produces:
  - bars5:  RTH-only 5-minute OHLCV, tz-aware ET, tagged with session_date.
  - boxes:  per-session table of the box that applies to THAT trading day
            (= prior RTH session's high/low), plus midline & 20% edge zones.
"""
import pandas as pd
import numpy as np

SRC = "/Users/kaveh/overnight_premium_engine/data/es_front_1m.parquet"

RTH_START = pd.Timestamp("09:30").time()
RTH_END   = pd.Timestamp("16:00").time()   # exclusive


def load_1m():
    df = pd.read_parquet(SRC)
    df = df[["session_date", "symbol", "open", "high", "low", "close", "volume"]].copy()
    df.index.name = "et"
    return df


def rth_filter(df):
    t = df.index.time
    mask = (t >= RTH_START) & (t < RTH_END)
    r = df[mask].copy()
    # For RTH, group key = calendar date of the bar (RTH always falls on the
    # daytime of its session_date, but use the actual bar date to be safe).
    r["day"] = r.index.normalize()
    return r


def resample_5m(rth):
    """Resample 1m -> 5m within each RTH day (no cross-session bleed)."""
    out = []
    agg = {"open": "first", "high": "max", "low": "min", "close": "last",
           "volume": "sum", "symbol": "last"}
    for day, g in rth.groupby("day"):
        b = g.resample("5min", closed="left", label="left").agg(agg).dropna(subset=["open"])
        b["day"] = day
        out.append(b)
    bars5 = pd.concat(out)
    bars5 = bars5.sort_index()
    return bars5


def build_boxes(rth):
    """Box for trading day D = prior RTH session's high/low (from 1m data)."""
    daily = rth.groupby("day").agg(rth_high=("high", "max"),
                                   rth_low=("low", "min"),
                                   rth_open=("open", "first"),
                                   rth_close=("close", "last"))
    daily = daily.sort_index()
    # box that applies TODAY = yesterday's RTH range
    box = pd.DataFrame(index=daily.index)
    box["box_high"] = daily["rth_high"].shift(1)
    box["box_low"]  = daily["rth_low"].shift(1)
    box = box.dropna()
    box["box_range"] = box["box_high"] - box["box_low"]
    box["mid"]       = (box["box_high"] + box["box_low"]) / 2.0
    # edge zones (upper/lower 20% of box)
    z = 0.20
    box["sell_zone"] = box["box_high"] - z * box["box_range"]   # >= this = sell zone
    box["buy_zone"]  = box["box_low"]  + z * box["box_range"]   # <= this = buy zone
    return box


def build():
    df = load_1m()
    rth = rth_filter(df)
    bars5 = resample_5m(rth)
    boxes = build_boxes(rth)
    return bars5, boxes


if __name__ == "__main__":
    bars5, boxes = build()
    print(f"bars5: {len(bars5):,} 5m bars  {bars5.index.min()} -> {bars5.index.max()}")
    print(f"boxes: {len(boxes):,} trading days")
    print("\nbox_range stats (ES points):")
    print(boxes["box_range"].describe(percentiles=[.1,.5,.9]).round(2))
    print("\nsample boxes:")
    print(boxes.tail(3).round(2))
    # sanity: 5m bars per RTH day should be ~78 (390min/5)
    per = bars5.groupby("day").size()
    print(f"\n5m bars/day median={int(per.median())} (expect 78)  min={int(per.min())} max={int(per.max())}")
    bars5.to_parquet("/Users/kaveh/box_theory/bars5.parquet")
    boxes.to_parquet("/Users/kaveh/box_theory/boxes.parquet")
    print("saved bars5.parquet, boxes.parquet")

