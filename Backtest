#!/usr/bin/env python3
"""Wait out the Yahoo rate-limit, then re-pull the still-missing tickers slowly
(longer per-request delay) to recover throttle false-negatives. Genuinely
delisted names will remain missing."""
import json, time, warnings, os, sys
import pandas as pd
import yfinance as yf
warnings.filterwarnings("ignore")

COOLDOWN = int(sys.argv[1]) if len(sys.argv) > 1 else 600
DELAY = 2.5
OUT = "prices_dir"

print(f"cooldown {COOLDOWN}s ...", flush=True)
time.sleep(COOLDOWN)

m = json.load(open("pull_manifest.json"))
missing = list(m["empty"])
print(f"re-pulling {len(missing)} still-missing tickers @ {DELAY}s", flush=True)

def flatten_write(sym, df):
    if df is None or len(df) == 0:
        return 0
    if isinstance(df.columns, pd.MultiIndex):
        df = df.copy(); df.columns = [c[0] for c in df.columns]
    if not {"Open", "Close"}.issubset(set(df.columns)):
        return 0
    out = pd.DataFrame({
        "date": pd.to_datetime(df.index).normalize(),
        "open": df["Open"].to_numpy().ravel(),
        "high": df.get("High", df["Open"]).to_numpy().ravel(),
        "low":  df.get("Low", df["Open"]).to_numpy().ravel(),
        "close": df["Close"].to_numpy().ravel(),
    })
    if "Adj Close" in df.columns:
        out["adj_close"] = df["Adj Close"].to_numpy().ravel()
    out = out.dropna(subset=["open", "close"])
    out = out[(out["open"] > 0) & (out["close"] > 0)]
    if len(out) == 0:
        return 0
    out.to_csv(f"{OUT}/{sym}.csv", index=False)
    return len(out)

recovered, still = [], []
for i, s in enumerate(missing):
    try:
        df = yf.download(s, start="2014-09-01", end="2026-06-23",
                         auto_adjust=False, progress=False, threads=False)
        n = flatten_write(s, df)
        (recovered if n > 0 else still).append(s if n == 0 else (s, n))
    except Exception:
        still.append(s)
    if (i + 1) % 20 == 0:
        print(f"  ...{i+1}/{len(missing)} recovered={len(recovered)}", flush=True)
    time.sleep(DELAY)

m["ok"] = m["ok"] + recovered
m["empty"] = still
json.dump(m, open("pull_manifest.json", "w"))
print(f"\nCOOLDOWN RE-PULL DONE recovered={len(recovered)} still_missing={len(still)}", flush=True)
print("recovered:", [r[0] for r in recovered], flush=True)
print("still_missing:", still, flush=True)

