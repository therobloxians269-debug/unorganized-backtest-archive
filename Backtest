                    print(f"{i:>2} {branch:6} {bucket:3} {w:>2} {k:>4.1f} | {st['n']:>4} "
                          f"{st['net']:>8.0f} {st['mar']:>6.2f} {st['hit']:>5.2f} {st['dd']:>8.0f} "
                          f"{100*st['ypos']:>5.0f} {100*st['mys']:>6.0f} {st['exp']:>7.3f}{tag}")
    st = stats(run(S, "go", "L", 6, 1.0))
    print(f"25 go     L    6  1.0 | {st['n']:>4} {st['net']:>8.0f} {st['mar']:>6.2f} {st['hit']:>5.2f} "
          f"{st['dd']:>8.0f} {100*st['ypos']:>5.0f} {100*st['mys']:>6.0f} {st['exp']:>7.3f}  (extra k-neighbor probe)")
    st = stats(run(S, "go", "L", 6, 1.5, excl_roll=True))
    print(f"26 go     L    6  1.5 | {st['n']:>4} {st['net']:>8.0f} {st['mar']:>6.2f} {st['hit']:>5.2f} "
          f"{st['dd']:>8.0f} {100*st['ypos']:>5.0f} {100*st['mys']:>6.0f} {st['exp']:>7.3f}  (EXCL roll weeks, mid Mar/Jun/Sep/Dec)")
    print("\nPLATEAU of pre-registered (go,L,w=6,k=1.5): neighbors go/M/6/1.5 (+$50), "
