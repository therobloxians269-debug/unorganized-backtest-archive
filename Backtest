    yrs=t['yr'].nunique()
    yr_t = {Y: (gg['pnl'].mean(), len(gg)) for Y,gg in t.groupby('yr')}
    pos_years = sum(1 for Y in yr_t if yr_t[Y][0]>0)
    print(f"{label:26} N={len(p):4d} ({len(p)/yrs:3.0f}/yr) exp=${p.mean():+6.2f} t={p.mean()/p.std()*np.sqrt(len(p)):+5.2f} "
          f"skew={pd.Series(p).skew():+5.2f} posYrs={pos_years}/{len(yr_t)} tot=${p.sum():+6.0f}")

print("ES-only features, horizon sweep (2021-2026 walk-forward OOS):")
for H in (2,4,6,12):
    run(H, False, f"ES-only H={H}")
print("\n+ YM cross-market lead-lag features:")
for H in (2,4,6,12):
    run(H, True, f"ES+YM cross H={H}")

