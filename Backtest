    dec_table(tr, by='dev', label='ES TRAIN, all bars')

    print(f'\n{"-"*100}\n  CONTROL 3 — the actual trade, one per day, costs charged\n{"-"*100}')
    for lab, s_, w in (('ES TRAIN', tr, 'ES'), ('ES DEV', dv, 'ES')):
