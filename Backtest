"""Can we DETECT that the session extreme is in, from the bar that made it?
Not forecasting - classification. y=1 if this bar set the session low AND it held to the close.
Race/label logic starts strictly at i, features use only bars <= i.  Base rate ~1/390."""
import numpy as np, pandas as pd, pickle, warnings; warnings.filterwarnings('ignore')
SCR='/private/tmp/claude-501/-Users-kaveh/d5ce5738-dd59-4ca2-bd9c-e9b02fe3107c/scratchpad'

def frame(df):
    rows=[]
    for d,b in df.groupby('day'):
        if len(b)<300: continue
        o=b['open'].values; h=b['high'].values; l=b['low'].values
        c=b['close'].values; v=b['volume'].values; t=b['tod'].values; n=len(b)
        runL=np.minimum.accumulate(l); runH=np.maximum.accumulate(h)
        sessL=l.min()
        # label: this bar's low IS the session low (and therefore held to the close)
        y=(l<=sessL+1e-9).astype(int)
        rng=h-l
        atr=pd.Series(rng).rolling(30,min_periods=5).mean().shift(1).values
        vol=pd.Series(v).rolling(30,min_periods=5).mean().shift(1).values
        with np.errstate(invalid='ignore',divide='ignore'):
            rows.append(pd.DataFrame({
              'day':d,'i':np.arange(n),'y':y,'tod':t,
              'elapsed':(t-570)/390.0,
              'rng_atr':rng/atr,                       # range expansion
              'vol_rel':v/vol,                         # volume spike
              'clspos':np.where(rng>0,(c-l)/rng,0.5),  # close position in bar (1 = closed on high)
              'newlow':(l<=runL+1e-9).astype(float),   # is this a new running low at all
              'ext':(runH-l)/np.maximum(atr,1e-9),     # how far below the running high
              'dn3':pd.Series((c<o).astype(float)).rolling(3,min_periods=1).sum().values,
              'wick':np.where(rng>0,(np.minimum(o,c)-l)/rng,0.0),  # lower wick fraction
            }))
    return pd.concat(rows,ignore_index=True).replace([np.inf,-np.inf],np.nan).dropna()

if __name__=='__main__':
    esday,esrth,nqday,nqrth=pickle.load(open(f'{SCR}/ladder_feats.pkl','rb'))
    F=frame(esrth); F['yr']=pd.DatetimeIndex(F.day).year
    pickle.dump(F,open(f'{SCR}/detect.pkl','wb'))
    print('rows',len(F),'base rate %.4f'%F.y.mean(),' days',F.day.nunique())

