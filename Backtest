import pandas as pd, numpy as np, warnings; warnings.filterwarnings('ignore')

def fvg_tf(df, tf):
    """All 3-bar FVGs on an intraday resample. Stamped at the CLOSE of the 3rd bar (causal)."""
    if tf==1: r=df[['h','l','c']].copy()
    else: r=df.resample(f'{tf}min',label='left',closed='left').agg({'h':'max','l':'min','c':'last'}).dropna()
    hi,lo=r['h'].values,r['l'].values; t=r.index; g=[]
    for i in range(2,len(r)):
        if lo[i]>hi[i-2]: g.append((t[i]+pd.Timedelta(minutes=tf),hi[i-2],lo[i],1))
        if hi[i]<lo[i-2]: g.append((t[i]+pd.Timedelta(minutes=tf),hi[i],lo[i-2],-1))
    return pd.DataFrame(g,columns=['known','bot','top','dir'])

def anchors(df, kind):
    """Reference opens the FPFVG is measured from."""
    idx=df.index; mins=idx.hour*60+idx.minute
    if kind=='daily18':  m=(mins==1080)
    elif kind=='mid00':  m=(mins==0)
    elif kind=='rth930': m=(mins==570)
    elif kind=='weekly':
        dt=idx.to_series().diff(); m=(dt>pd.Timedelta(hours=12)).values
    else: raise ValueError(kind)
    return idx[m]

def first_presented(gaps, anch, horizon_min=1440):
    """FPFVG = the FIRST fvg formed after each anchor. Returns df(valid_from, bot, top, dir)."""
    gk=gaps['known'].values; out=[]
    for a in anch:
        a64=np.datetime64(a.tz_convert('UTC').tz_localize(None)) if a.tz else np.datetime64(a)
        w=np.searchsorted(gk, a.to_datetime64())
        if w>=len(gaps): continue
        row=gaps.iloc[w]
        if (row['known']-a).total_seconds()/60 > horizon_min: continue
        out.append(dict(anchor=a, valid_from=row['known'], bot=row['bot'], top=row['top'], dir=row['dir']))
    return pd.DataFrame(out)

