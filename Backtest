#!/usr/bin/env python3
"""GEXLAB M2 — the falsification gate.

Nothing in this project ships until this passes.

THE CLAIM UNDER TEST
--------------------
Dealer gamma is signed by an ASSUMPTION (dealers long call OI, short put OI),
not by data. Open interest is unsigned; nobody publishes who is long. Every
public GEX chart inherits that guess and almost nobody tests it.

It is free to test, because the assumption makes a sharp prediction that has
nothing to do with trading:

    high net GEX  ->  dealers long gamma  ->  hedging sells rallies and buys
                      dips  ->  LOWER realised volatility the next session.

Three outcomes, and only one of them lets the project continue:

    monotone negative   convention holds. Levels are worth measuring (M3).
    flat                dealer positioning is not recoverable from OI. The
                        levels are decoration. Stop, log the kill.
    monotone positive   the sign is BACKWARDS. Flip DEALER_SIGN and re-gate.

WHY RANK AND NOT RAW
--------------------
Listed options volume grew several-fold over the sample. A raw netGEX series
regressed across years measures 2016-vs-2025, not gamma. Everything here uses
the percentile rank of netGEX inside a trailing window, so a "high gamma day"
means high relative to its own era.

CAUSALITY
---------
OI reported for date D is cleared overnight and known before D's open, but this
gate still only ever predicts D+1 -- never same-day. Same-day would let the
session's own move leak into the feature.

    python3 gate.py              # the quintile table and the verdict
    python3 gate.py --pin        # the OpEx pinning test
"""
from __future__ import annotations

import sys
from pathlib import Path

import numpy as np
import pandas as pd
from scipy import stats

import gex as G

ROOT = Path(__file__).resolve().parent
HIST = ROOT / "data" / "hist" / "QQQ"
RANK_DAYS = 365     # trailing window for the percentile rank, in CALENDAR days
RANK_MIN_N = 20     # observations required inside that window before ranking
BUCKET = "30D"      # 30-day gamma is the regime measure; 0DTE is a level measure


# ───────────────────────── features from stored chains ─────────────────────────
def build_features() -> pd.DataFrame:
    fs = sorted(HIST.glob("*.parquet"))
    if len(fs) < 30:
        raise SystemExit(
            f"only {len(fs)} sessions stored — the gate needs ~100+ to mean anything.\n"
            f"Run:  python3 backfill.py run weekly 2022-01-01 2025-12-31")
    rows = []
    for f in fs:
        try:
            df = G.load(f)
        except Exception:  # noqa: BLE001
            continue
        if df.empty:
            continue
        spot = float(df["spot"].iloc[0])
        if not np.isfinite(spot):
            continue
        lo, hi = G.BUCKETS[BUCKET]
        sub = df[(df["dte"] >= lo) & (df["dte"] <= hi)]
        if len(sub) < 50:
            continue
        p = G.profile(sub, spot)
        flip = G.gamma_flip(sub, spot)
        rows.append({
            "date": pd.Timestamp(df["snap_ts"].iloc[0]).normalize(),
            "spot": spot,
            "net_gex": float(p["gex"].sum()),
            "abs_gex": float(p["gex"].abs().sum()),
            "flip": flip,
            "flip_dist": (spot - flip) / spot if flip else np.nan,
            "total_oi": float(sub["open_interest"].sum()),
        })
    if not rows:
        raise SystemExit(
            f"{len(fs)} stored file(s) but none produced features.\n"
            f"Every one was skipped, which means one of:\n"
            f"  - the {BUCKET} bucket held fewer than 50 contracts (expiries too far out?)\n"
            f"  - spot was missing (the AV payload has no underlying price; the\n"
            f"    calendar join in backfill.py supplies it)\n"
            f"  - the files failed to load at all\n"
            f"Inspect one with:  python3 -c \"import gex,sys;print(gex.load(sys.argv[1]).head())\" <file>")
    out = pd.DataFrame(rows).sort_values("date").reset_index(drop=True)
    # scale-free: net gamma as a share of gross gamma, immune to OI growth
    out["gex_share"] = out["net_gex"] / out["abs_gex"]

    # Rank inside a trailing CALENDAR window, not a trailing count of rows.
    # A row-count window is silently wrong whenever the sampling frequency is not
    # daily: the plan here samples weekly, so 252 rows would be five years and the
    # window would never fill, degrading to an expanding window. Calendar time is
    # invariant to how densely we sampled.
    dates = out["date"].to_numpy()
    vals = out["net_gex"].to_numpy()
    rank = np.full(len(vals), np.nan)
    win = np.timedelta64(RANK_DAYS, "D")
    for i in range(len(vals)):
        m = (dates <= dates[i]) & (dates > dates[i] - win)
        w = vals[m]
        if len(w) >= RANK_MIN_N:
            rank[i] = float((w < vals[i]).mean())
    out["gex_rank"] = rank
    return out


def attach_forward_vol(feat: pd.DataFrame) -> pd.DataFrame:
    """Next-session realised range, normalised by its own trailing level.

    Parkinson from the daily bar. No intraday feed needed, and the high/low
    range is a far more efficient vol estimator than close-to-close.
    """
    cal = G_calendar()
    cal = cal[cal.index >= feat["date"].min() - pd.Timedelta(days=10)].copy()
    cal["park"] = np.log(cal["high"] / cal["low"]) / np.sqrt(4 * np.log(2))
    cal["park_norm"] = cal["park"] / cal["park"].rolling(20).median().shift(1)
    cal["ret"] = np.log(cal["close"]).diff()
    # forward: the session AFTER the chain date
    cal["fwd_park"] = cal["park_norm"].shift(-1)
    cal["fwd_absret"] = cal["ret"].abs().shift(-1) / cal["ret"].abs().rolling(20).median()

    f = feat.set_index("date").join(cal[["fwd_park", "fwd_absret"]], how="left")
    return f.dropna(subset=["fwd_park", "gex_rank"]).reset_index()


def G_calendar() -> pd.DataFrame:
    import backfill
    return backfill.calendar()


# ───────────────────────────── the test ─────────────────────────────
def quintile_table(d: pd.DataFrame, feat: str, target: str) -> pd.DataFrame:
    q = pd.qcut(d[feat], 5, labels=False, duplicates="drop")
    t = (d.assign(q=q).groupby("q")
         .agg(n=(target, "size"), lo=(feat, "min"), hi=(feat, "max"),
              mean=(target, "mean"), med=(target, "median"))
         .reset_index())
    return t


def report(d: pd.DataFrame, feat: str, target: str) -> float:
    t = quintile_table(d, feat, target)
    print(f"\n  {feat} quintile  ->  {target}   (n={len(d)})")
    print(f"    {'q':>2} {'n':>5} {'range':>16} {'mean':>8} {'median':>8}")
    for _, r in t.iterrows():
        print(f"    {int(r['q'])+1:>2} {int(r['n']):>5} "
              f"{r['lo']:>7.3f}..{r['hi']:<7.3f} {r['mean']:>8.3f} {r['med']:>8.3f}")
    rho, p = stats.spearmanr(d[feat], d[target])
    lohi = t["mean"].iloc[-1] - t["mean"].iloc[0]
    print(f"    spearman rho {rho:+.4f}  p {p:.4f}   q5-q1 {lohi:+.4f}")
    return rho


def placebo(d: pd.DataFrame, feat: str, target: str, n: int = 2000) -> tuple[float, float]:
    """Shuffle the feature against the target. Any structure surviving this is
    an artifact of the ranking, not of gamma."""
    rng = np.random.default_rng(7)
    x, y = d[feat].to_numpy(), d[target].to_numpy()
    obs = stats.spearmanr(x, y).statistic
    null = np.array([stats.spearmanr(rng.permutation(x), y).statistic for _ in range(n)])
    pv = float((np.abs(null) >= abs(obs)).mean())
    return obs, pv


def main() -> None:
    feat = build_features()
    d = attach_forward_vol(feat)
    print(f"gate sample: {len(d)} sessions  {d['date'].min():%Y-%m-%d}..{d['date'].max():%Y-%m-%d}")
    print(f"bucket={BUCKET}   feature = next-session realised range, self-normalised")

    r1 = report(d, "gex_rank", "fwd_park")
    r2 = report(d, "gex_share", "fwd_park")
    report(d, "gex_rank", "fwd_absret")

    obs, pv = placebo(d, "gex_rank", "fwd_park")
    print(f"\n  shuffle placebo   observed rho {obs:+.4f}   p {pv:.4f}  "
          f"({'separates' if pv < 0.05 else 'DOES NOT separate'} from noise)")

    print("\n  VERDICT")
    if pv >= 0.05:
        print("    FLAT — net GEX does not forecast realised vol. Dealer positioning")
        print("    is not recoverable from unsigned OI. The levels are decoration.")
        print("    STOP. Log the kill; do not build M3.")
    elif r1 < 0:
        print("    NEGATIVE and separated from noise — the standard sign convention")
        print("    HOLDS on this sample. Dealer gamma is real here. Proceed to M3,")
        print("    and carry this p-value into the trials ledger.")
    else:
        print("    POSITIVE — high net GEX predicts HIGHER vol. The sign convention")
        print("    is BACKWARDS on this sample. Flip DEALER_SIGN in gex.py and re-run")
        print("    before interpreting a single level.")


def pin_test() -> None:
    """OpEx pinning: on monthly expiry, does the close land nearer the biggest
    gamma strike than chance? Ni/Pearson/Poteshman (2005) found it on equities."""
    feat = build_features()
    cal = G_calendar()
    rows = []
    for f in sorted(HIST.glob("*.parquet")):
        df = G.load(f)
        if df.empty:
            continue
        date = pd.Timestamp(df["snap_ts"].iloc[0]).normalize()
        if not (date.weekday() == 4 and 15 <= date.day <= 21):
            continue
        spot = float(df["spot"].iloc[0])
        sub = df[df["dte"] <= 7]
        if len(sub) < 50:
            continue
        p = G.profile(sub, spot)
        pin = float(p.loc[p["gex"].abs().idxmax(), "strike"])
        if date not in cal.index:
            continue
        close = float(cal.loc[date, "close"])
        rows.append({"date": date, "pin": pin, "close": close, "open": float(cal.loc[date, "open"]),
                     "dist_close": abs(close - pin) / close,
                     "dist_open": abs(float(cal.loc[date, "open"]) - pin) / close})
    d = pd.DataFrame(rows)
    if len(d) < 20:
        raise SystemExit(f"only {len(d)} OpEx sessions stored; run:  "
                         f"python3 backfill.py run opex 2016-01-01 2025-12-31")
    t = stats.ttest_rel(d["dist_close"], d["dist_open"])
    print(f"OpEx pin test   n={len(d)}")
    print(f"  |open - pin|   {d['dist_open'].mean():.4%}")
    print(f"  |close - pin|  {d['dist_close'].mean():.4%}")
    print(f"  paired t {t.statistic:+.3f}  p {t.pvalue:.4f}")
    print(f"  {'CLOSES PULL TOWARD THE PIN' if t.statistic < 0 and t.pvalue < 0.05 else 'no pinning detected'}")


if __name__ == "__main__":
    if "--pin" in sys.argv:
        pin_test()
    else:
        main()

