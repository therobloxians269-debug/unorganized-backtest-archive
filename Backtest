import numpy as np, pandas as pd
import qtlib as Q

MNQ_PT, COST_PTS = 2.0, 1.12
FLAT_MIN = 16 * 60

df = Q.load_data(verbose=False).copy()
df["tmin"] = df.index.hour * 60 + df.index.minute
ny = df.index
sinceDay = ((df["tmin"] - 1080 + 1440) % 1440).to_numpy()
day_key = ny.year.to_numpy() * 1000 + ny.dayofyear.to_numpy()
ids = {
    "Micro": day_key * 100 + (sinceDay // 22.5).astype(int),
    "90min": day_key * 100 + (sinceDay // 90).astype(int),
    "Day": day_key * 10 + (sinceDay // 360).astype(int),
    "Week": day_key,
    "Month": ny.year.to_numpy() * 100 + ny.month.to_numpy() * 10 + np.minimum(3, (ny.day.to_numpy() - 1) // 7),
}
CYCLES = list(ids)


def cycle_state(qid):
    s = pd.Series(qid, index=df.index)
    g = df.groupby(s, sort=False)
    o = {}
    for p in ("nq", "es", "ym"):
        o[f"c{p}h"] = g[f"{p}_high"].cummax().to_numpy()
        o[f"c{p}l"] = g[f"{p}_low"].cummin().to_numpy()
        o[f"p{p}h"] = s.map(g[f"{p}_high"].max().shift(1)).to_numpy()
        o[f"p{p}l"] = s.map(g[f"{p}_low"].min().shift(1)).to_numpy()
    return o


bear, bull, cur_hi, cur_lo = {}, {}, {}, {}
for c in CYCLES:
    st = cycle_state(ids[c])
    bear[c] = np.where(np.isnan(st["pnqh"]), False, (st["cnqh"] > st["pnqh"]) & (~(st["cesh"] > st["pesh"]) | ~(st["cymh"] > st["pymh"])))
    bull[c] = np.where(np.isnan(st["pnql"]), False, (st["cnql"] < st["pnql"]) & (~(st["cesl"] < st["pesl"]) | ~(st["cyml"] < st["pyml"])))
    cur_hi[c], cur_lo[c] = st["cnqh"], st["cnql"]

align_bear = np.sum([bear[c] for c in CYCLES], axis=0)
align_bull = np.sum([bull[c] for c in CYCLES], axis=0)

