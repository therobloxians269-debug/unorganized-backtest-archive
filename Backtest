"""
Push P using data we have: is the trend's daily Sharpe HIGHER on high-conviction days /
in favorable regimes? If so, deploying eval risk only then raises conditional Sharpe -> P.
Measures conditional Sharpe by 3 a-priori conditioners (no cherry-picking), all LAGGED.

    python3 trend_conviction.py
"""
from __future__ import annotations
import numpy as np
import pandas as pd

PANEL = "/Users/kaveh/mim_research/futures_panel.parquet"
ANN = 252


def build():
    p = pd.read_parquet(PANEL)
    F = p.pivot_table(index="date", columns="root", values="fret").sort_index()
    AV = (F.rolling(63).std() * np.sqrt(ANN)).shift(1)
    P = (1 + F.fillna(0)).cumprod()
    z = sum((P / P.shift(L) - 1) / (AV * np.sqrt(L / ANN)) for L in (63, 126, 252)) / 3
    sig = np.tanh(z)
    w = (sig / AV)
    w = w.div(w.abs().sum(axis=1).replace(0, np.nan), axis=0).fillna(0.0).clip(-0.2, 0.2)
    w = w.resample("W").last().reindex(w.index, method="ffill")
    scale = (0.12 / ((w * F).sum(axis=1).rolling(63).std() * np.sqrt(ANN))).shift(1).clip(0, 3).fillna(0.0)
    w = w.mul(scale, axis=0)
    turn = w.diff().abs().sum(axis=1)
    net = ((w * F).sum(axis=1) - turn * 3.0 * 1e-4).dropna()
    # conditioners (all lagged -> usable in real time)
    conv = sig.abs().mean(axis=1).shift(1)                       # avg trend strength across markets
    agree = sig.apply(np.sign).mean(axis=1).abs().shift(1)       # directional agreement across markets
    hot = net.rolling(63).mean().shift(1)                        # strategy's own trailing performance
    df = pd.DataFrame({"net": net, "conv": conv, "agree": agree, "hot": hot}).dropna()
    return df


def csharpe(r):
    return r.mean() / r.std() * np.sqrt(ANN) if len(r) > 20 and r.std() > 0 else np.nan


def tercile_report(df, col):
    q = df[col].quantile([1/3, 2/3]).values
    lo = df[df[col] <= q[0]]["net"]; mid = df[(df[col] > q[0]) & (df[col] <= q[1])]["net"]; hi = df[df[col] > q[1]]["net"]
    print(f"  by {col:6s}:  low Sh {csharpe(lo):+.2f} (n{len(lo)})  | mid {csharpe(mid):+.2f}  | "
          f"HIGH Sh {csharpe(hi):+.2f} (n{len(hi)})")
    return csharpe(hi)


def main():
    df = build()
    print(f"trend daily, {df.index[0].date()}->{df.index[-1].date()}, N={len(df)}, "
          f"full Sharpe {csharpe(df['net']):.2f}\n")
    print("Conditional Sharpe (deploy eval risk only on HIGH days):")
    sh_conv = tercile_report(df, "conv")
    sh_agree = tercile_report(df, "agree")
    sh_hot = tercile_report(df, "hot")

    # combined favorable regime: top-half conviction AND top-half agreement AND hot>0
    fav = df[(df["conv"] > df["conv"].median()) & (df["agree"] > df["agree"].median()) & (df["hot"] > 0)]
    print(f"\n  COMBINED favorable (conv>med & agree>med & hot>0): Sharpe {csharpe(fav['net']):+.2f} "
          f"| {len(fav)} days = {len(fav)/len(df)*100:.0f}% of time")
    print(f"  unfavorable (the rest):                              Sharpe {csharpe(df.drop(fav.index)['net']):+.2f}")

    # honest checks
    print(f"\n  caveats: conditional-Sharpe est. noise; high-conv days persist (you wait for them);")
    print(f"  multiple conditioners tested -> discount. fraction of time tradable matters for eval speed.")
    # save favorable-regime returns for the Apex re-sim
    fav["net"].to_frame("net").to_parquet("/Users/kaveh/mim_research/trend_favorable.parquet")
    df["net"].to_frame("net").to_parquet("/Users/kaveh/mim_research/trend_all.parquet")
    print("  saved favorable-regime returns -> trend_favorable.parquet")


if __name__ == "__main__":
    main()

