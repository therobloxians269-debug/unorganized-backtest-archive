@dataclass(frozen=True)
class InstrumentSpec:
    """Immutable contract specification for a single futures instrument."""
    symbol:          str
    exchange:        str
    tick_size:       float
    point_value:     float
    margin_intraday: float
    is_micro:        bool
    parent_symbol:   Optional[str]

    @property
    def tick_value(self) -> float:
        return self.tick_size * self.point_value

    @property
    def commission_roundturn(self) -> float:
        """~$0.62/side NinjaTrader rate assumed."""
        return 1.24


