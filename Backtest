#!/usr/bin/env python3
"""
crypto_funding_pos.py -- HYPOTHESIS 2: perp funding POSITIONING extremes, cross-sectional.
(verbatim per spec; logic unchanged)
"""
from __future__ import annotations
import sys, math
import numpy as np
from scipy.stats import skew as sk, kurtosis as ku, norm, ttest_1samp, linregress, rankdata

ANN = math.sqrt(365)

def sharpe(x):
    x = x[np.isfinite(x)]
    return x.mean()/x.std(ddof=1)*ANN if len(x) > 1 and x.std() > 0 else 0.0
def calmar(x):
    x = x[np.isfinite(x)]; eq = np.cumsum(x); dd = (eq-np.maximum.accumulate(eq)).min()
    return (x.mean()*365)/abs(dd) if dd < 0 else float('inf')
def maxdd(x):
    x = x[np.isfinite(x)]; eq = np.cumsum(x); return (eq-np.maximum.accumulate(eq)).min()

def _xs_z(M):
    mu = np.nanmean(M, axis=1, keepdims=True); sd = np.nanstd(M, axis=1, keepdims=True)
    return (M-mu)/np.where(sd > 0, sd, np.nan)
def _logret(P):
    R = np.full_like(P, np.nan); R[1:] = np.log(P[1:]/P[:-1]); return R
def _rollvol(R, w=30):
    T, N = R.shape; v = np.full_like(R, np.nan)
    for t in range(T):
        lo = max(0, t-w+1)
        with np.errstate(invalid='ignore'): v[t] = np.nanstd(R[lo:t+1], axis=0)
    return v

def fund_weights(F, P, w_ts=45, entry=1.5, exit_=0.5, volw=30):
    T, N = F.shape
    fz_ts = np.full_like(F, np.nan)
    for c in range(N):
        for t in range(T):
            lo = max(0, t-w_ts+1); seg = F[lo:t+1, c]; seg = seg[np.isfinite(seg)]
            if len(seg) > 5 and seg.std() > 0: fz_ts[t, c] = (F[t, c]-seg.mean())/seg.std()
    elig = np.zeros((T, N))                                   # hysteresis -> low turnover
    for c in range(N):
        on = False
        for t in range(T):
            z = fz_ts[t, c]
            if np.isfinite(z):
                if not on and abs(z) > entry: on = True
                elif on and abs(z) < exit_: on = False
            elig[t, c] = 1.0 if on else 0.0
    score = -_xs_z(F)*elig                                    # fade, only when eligible
    vol = _rollvol(_logret(P), volw); vol = np.where(vol > 0, vol, np.nan)
    w = score/vol
    w = np.where(score == 0, np.nan, w)                       # inactive don't bias demean
    w = w - np.nanmean(w, axis=1, keepdims=True)              # dollar neutral over active
    gross = np.nansum(np.abs(w), axis=1, keepdims=True)
    w = np.where(gross > 0, w/gross, 0.0)
    return np.nan_to_num(w, nan=0.0)

def ls_returns(W, R, cost_bps=5.0):
    Wl = np.roll(W, 1, axis=0); Wl[0] = 0.0
    turn = np.abs(np.diff(Wl, axis=0, prepend=Wl[:1])).sum(1)
    gross = np.nansum(Wl*np.nan_to_num(R), axis=1)
    return gross - turn*(cost_bps*1e-4), gross, turn.mean()

def fwd_ic(F, P, **kw):
    W = fund_weights(F, P, **kw); R = _logret(P); ics = []
    for t in range(len(W)-1):
        s = W[t]; r = R[t+1]; m = (s != 0) & np.isfinite(r)
        if m.sum() >= 4: ics.append(np.corrcoef(rankdata(s[m]), rankdata(r[m]))[0, 1])
    return float(np.nanmean(ics)) if ics else 0.0

def market_alpha(ls, R):
    mkt = np.nanmean(R, axis=1); m = np.isfinite(ls) & np.isfinite(mkt)
    if m.sum() < 30: return 0.0, 0.0, 0.0
    lr = linregress(mkt[m], ls[m]); n = m.sum()
    resid = np.std(ls[m]-(lr.slope*mkt[m]+lr.intercept), ddof=2)
    se = resid*math.sqrt(1/n + mkt[m].mean()**2/np.sum((mkt[m]-mkt[m].mean())**2))
    return float(lr.intercept*365), float(lr.intercept/se if se > 0 else 0.0), float(lr.slope)

def direct_test(p, s):
    I, O = p[:s], p[s:]; tI = ttest_1samp(I[np.isfinite(I)], 0); tO = ttest_1samp(O[np.isfinite(O)], 0)
    return dict(ISs=sharpe(I), ISt=float(tI.statistic), OOSs=sharpe(O), OOSt=float(tO.statistic))
def walk_forward(p, k=6, emb=5):
    n = len(p); seg = n//k; return [sharpe(p[i*seg+(emb if i > 0 else 0):(i+1)*seg if i < k-1 else n]) for i in range(k)]
def block_bootstrap(p, block=20, n=1000, seed=0):
    p = p[np.isfinite(p)]; m = len(p)
    if m < block*2: return 0.0, 0.0
    rng = np.random.default_rng(seed); nb = int(np.ceil(m/block)); sh = np.empty(n)
    for i in range(n):
        st = rng.integers(0, m, nb); idx = (st[:, None]+np.arange(block)[None, :]).ravel()[:m] % m
        sh[i] = sharpe(p[idx])
    return float(np.percentile(sh, 5)), float(np.percentile(sh, 95))
def dsr(p, nt):
    p = p[np.isfinite(p)]; sd = p.std(ddof=1); srd = p.mean()/sd if sd > 0 else 0
    emax = (1-np.euler_gamma)*norm.ppf(1-1/nt)+np.euler_gamma*norm.ppf(1-1/(nt*math.e))
    den = math.sqrt(max(1e-9, 1-float(sk(p))*srd+(float(ku(p, fisher=False))-1)/4*srd**2))
    return float(norm.cdf((srd-emax/math.sqrt(len(p)))*math.sqrt(len(p)-1)/den))
def cost_sweep(W, R):
    return {b: round(sharpe(ls_returns(W, R, b)[0]), 2) for b in (2, 3, 5, 10)}
def param_neighborhood(F, P):
    out = {}
    for e in (1.0, 1.25, 1.5, 2.0, 2.5):
        net, _, _ = ls_returns(fund_weights(F, P, entry=e), _logret(P), 5.0); out[f"e{e}"] = round(sharpe(net), 2)
    return out
def regime_slices(p, b): return {k: sharpe(p[lo:hi]) for k, (lo, hi) in b.items()}

def gate(F, P, *, name, n_trials, split=None, bar=0.7, cost_bps=5.0, regimes=None):
    R = _logret(P); W = fund_weights(F, P); net, gross, turn = ls_returns(W, R, cost_bps)
    if split is None: split = int(len(net)*0.65)
    a_ann, a_t, beta = market_alpha(net, R); ic = fwd_ic(F, P)
    bh = np.nanmean(R, axis=1); active = (W != 0).any(1).sum()
    print(f"\n===== FUNDING-POSITIONING GATE: {name}   (bar: net Sharpe >= {bar}) =====")
    print(f"  breadth  {P.shape[1]} perps, {active} active days   signal->fwd-ret IC={ic:+.3f}")
    print(f"  full     gross Sh={sharpe(gross):.2f}  NET Sh={sharpe(net):.2f}  Calmar={calmar(net):.2f}  turn={turn:.3f}/d")
    print(f"  COSTS    net Sharpe by bps {cost_sweep(W, R)}   <-- where does it die?")
    print(f"  vs B&H   strat Calmar={calmar(net):.2f}  basket-B&H Calmar={calmar(bh):.2f}  strat maxDD={maxdd(net):.3f}")
    print(f"  ALPHA    market-neutral alpha={a_ann:+.3f}/yr  t={a_t:.1f}  (beta to basket={beta:+.2f})")
    dt = direct_test(net, split); print(f"  matched  IS Sh={dt['ISs']:.2f}(t={dt['ISt']:.1f})   OOS Sh={dt['OOSs']:.2f}(t={dt['OOSt']:.1f})")
    print(f"  walkfwd  {[round(x,2) for x in walk_forward(net)]}")
    print(f"  paramN   {param_neighborhood(F, P)}")
    if regimes: print(f"  regimes  {{{', '.join(f'{k}:{v:.2f}' for k,v in regime_slices(net, regimes).items())}}}")
    lo, hi = block_bootstrap(net); print(f"  bootCI   90% Sharpe [{lo:.2f}, {hi:.2f}]")
    d = dsr(net, n_trials); print(f"  DSR      N={n_trials} -> {d:.2f}")
    ok = (sharpe(net) >= bar and a_t > 1.5 and lo > 0 and d > 0.9 and dt['OOSt'] > 1.5)
    print(f"  VERDICT  {'PASS - survives costs with real alpha' if ok else 'FAIL - does not clear the bar'}")
    return ok

def _synth(mode, T=1400, N=25, rng=None):
    rng = rng or np.random.default_rng(0)
    rho = 0.1 if mode == 'cost_trap' else 0.85
    F = np.zeros((T, N))
    for c in range(N):
        for t in range(1, T): F[t, c] = rho*F[t-1, c] + rng.normal(0, 0.0006)
    fz = _xs_z(F); common = rng.normal(0.0008, 0.03, T); idio = rng.normal(0, 0.05, (T, N))
    th = 0.0006 if mode == 'cost_trap' else 0.05
    if mode == 'noise':
        Rr = common[:, None] + idio
    else:
        Rr = -th*np.nan_to_num(fz) + common[:, None] + idio
        Rr = np.roll(Rr, 1, 0)
    P = 100*np.exp(np.cumsum(np.nan_to_num(Rr), axis=0))
    return F, P

if __name__ == "__main__":
    if len(sys.argv) > 1:
        import pandas as pd
        df = pd.read_parquet(sys.argv[1]).sort_values('date').reset_index(drop=True)
        coins = sorted({c[:-8] for c in df.columns if c.endswith('_funding')})
        F = np.column_stack([df[f'{c}_funding'].to_numpy(float) for c in coins])
        P = np.column_stack([df[f'{c}_px'].to_numpy(float) for c in coins])
        yrs = pd.to_datetime(df['date']).dt.year.to_numpy()
        regs = {str(y): (int(np.argmax(yrs == y)), int(len(yrs)-np.argmax(yrs[::-1] == y))) for y in sorted(set(yrs))}
        print(f"perps ({len(coins)}): {coins}")
        gate(F, P, name=f"funding-positioning [{df.date.min()}..{df.date.max()}]", n_trials=10, regimes=regs)
        sys.exit(0)

    rng = np.random.default_rng(5)
    print("### CONTROL 1: funding extreme -> price reversion (real, persistent) -> PASS")
    F, P = _synth('reversion', rng=rng); gate(F, P, name="synth-reversion", n_trials=10)
    print("\n### CONTROL 2: funding unrelated to returns -> FAIL")
    F, P = _synth('noise', rng=rng); gate(F, P, name="synth-noise", n_trials=10)
    print("\n### CONTROL 3: real edge but fast-flipping funding -> turnover kills net -> FAIL on costs")
    F, P = _synth('cost_trap', rng=rng); gate(F, P, name="synth-cost-trap", n_trials=10)

