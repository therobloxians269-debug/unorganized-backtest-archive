"""
TERMINUS · M0 gate.

The spine is only trusted if it independently reproduces the structural fact the
whole model rests on:

    P(at least one of the day's two extremes is already printed in the first hour)
      = 72.3% on ES,  78.0% on NQ

If those numbers do not come back, the frame builder is wrong and nothing downstream
means anything. This file also prints the containment by hour so the "use the full
hour, not 30 minutes" choice is re-derived rather than assumed.
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')
import data as D

RTH0 = D.RTH0


def ib_containment(day, rb, iblen):
    """Was the running high/low at RTH0+iblen the eventual day high/low?"""
    rows = []
    for dd, row in day.iterrows():
        b = rb.get(dd)
        if b is None:
            continue
        H, L, T = b['H'], b['L'], b['T']
        m = T < RTH0 + iblen
        if m.sum() < iblen * 0.8:
            continue
        ibh, ibl = H[m].max(), L[m].min()
        rows.append(dict(day=dd,
                         hi_in=bool(H.max() <= ibh + 1e-9),
                         lo_in=bool(L.min() >= ibl - 1e-9)))
    f = pd.DataFrame(rows).set_index('day')
    f['either'] = f.hi_in | f.lo_in
    f['both'] = f.hi_in & f.lo_in
    return f


def run(which):
    print(f'\n{"="*66}\n  {which}\n{"="*66}')
    d = D.load(which)
    corr = D.check_es_alignment(d, which)
    print(f'  bars            {len(d):,}   {d.index[0].date()} -> {d.index[-1].date()}')
    print(f'  price band      {d.close.min():.1f} .. {d.close.max():.1f}   [PASS]')
    if corr is not None:
        print(f'  NQ~ES 1m corr   {corr:.3f}   [PASS: timestamps aligned]')

    day, r = D.sessions(d)
    rb = D.rth_bars(r)
    print(f'  ADR leak audit  [PASS]')
    print(f'  sessions        {len(day):,}   median ADR {day.ADR.median():.1f} pts')

    print(f'\n  P(extreme already printed) by opening-window length:')
    print(f'    {"window":>8} {"n":>6} {"HIGH in":>9} {"LOW in":>8} {"EITHER":>8} {"BOTH":>7}')
    res = {}
    for iblen in (30, 60, 90, 120):
        f = ib_containment(day, rb, iblen)
        res[iblen] = f
        print(f'    {iblen:>5} min {len(f):>6} {f.hi_in.mean():>8.1%} {f.lo_in.mean():>8.1%} '
              f'{f.either.mean():>8.1%} {f.both.mean():>7.1%}')
    return day, rb, res


if __name__ == '__main__':
    print('TERMINUS M0 — data spine + structural gate')
    out = {}
    for w in ('ES', 'NQ', 'MNQ'):
        out[w] = run(w)

    print(f'\n{"="*66}\n  GATE\n{"="*66}')
    ok = True
    for w, target in (('ES', 0.723), ('NQ', 0.780)):
        got = out[w][2][60].either.mean()
        p = abs(got - target) <= 0.03
        ok &= p
        print(f'  {w}: either-extreme-in-first-hour {got:.1%}  '
              f'(expected {target:.1%})  [{"PASS" if p else "FAIL"}]')
    print(f'\n  M0 {"PASS — spine reproduces the known structure" if ok else "FAIL — STOP"}')

