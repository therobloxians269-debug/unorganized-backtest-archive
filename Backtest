#!/usr/bin/env python3
"""Real backtest of MES/MIM on 16y of ES sessions (es_sessions.parquet).
Honest: net of MES friction, split by era incl. true post-publication OOS,
with HAC-t (Newey-West), DSR (Bailey-Lopez de Prado), and a sign-flip MCPT.
ES == MES index (MES is 1/10 size, $5/pt); friction expressed in index points."""
import math, sys
import numpy as np, pandas as pd

FRIC = 0.75          # MES round-trip friction in index points (~$3.74)
PT_USD = 5.0         # MES $/pt
EM = 0.5772156649015329

def hac_t(y, lags=5):
    y = np.asarray(y, float); n = y.size
    if n < 10 or np.allclose(y, 0): return 0.0
    e = y - y.mean(); s = (e@e)/n
    for l in range(1, min(lags, n-1)+1):
        s += 2*(1-l/(lags+1))*(e[l:]@e[:-l])/n
    return float(y.mean()/math.sqrt(max(s,1e-12)/n))

def _ppf(p):
    from statistics import NormalDist
    return NormalDist().inv_cdf(min(max(p,1e-12),1-1e-12))
def _cdf(x):
    from statistics import NormalDist
    return NormalDist().cdf(x)

def dsr(y, n_trials):
    y = np.asarray(y, float); n = y.size
    if n < 10: return 0.0
    sd = y.std(ddof=1)
    if sd <= 0: return 0.0
    sr = y.mean()/sd
    s = pd.Series(y); g3 = float(s.skew()); g4 = float(s.kurt())+3.0
    v = max((1 - g3*sr + (g4-1)/4*sr*sr)/(n-1), 1e-12)
    sr0 = math.sqrt(v)*((1-EM)*_ppf(1-1.0/n_trials)+EM*_ppf(1-1.0/(n_trials*math.e)))
    return _cdf((sr-sr0)/math.sqrt(v))

def mcpt(dirv, target, fric, n=5000, seed=1):
    rng = np.random.default_rng(seed)
    obs = (dirv*target - fric).sum()
    ge = 0
    for _ in range(n):
        f = rng.choice([-1,1], size=dirv.size)
        if (f*dirv*target - fric).sum() >= obs-1e-9: ge += 1
    return (1+ge)/(1+n)

def stats(df, sig_col, label, fric=FRIC, n_trials=34):
    d = df.dropna(subset=[sig_col, "target_pts"]).copy()
    dirv = np.sign(d[sig_col].to_numpy())
    tgt = d["target_pts"].to_numpy()
    m = dirv != 0
    dirv, tgt = dirv[m], tgt[m]
    pnl = dirv*tgt - fric
    n = pnl.size
    if n == 0: return None
    yrs = n/252.0
    hit = float((pnl>0).mean())
    sd = pnl.std(ddof=1)
    sharpe = float(np.sqrt(252)*pnl.mean()/sd) if sd>0 else 0.0
    return {"split": label, "n": n, "gross_pt": round(float((dirv*tgt).mean()),4),
            "net_pt": round(float(pnl.mean()),4), "net_pts_tot": round(float(pnl.sum()),1),
            "ann_usd": round(float(pnl.sum()/yrs*PT_USD),0), "hit": round(hit,4),
            "sharpe": round(sharpe,3), "hac_t": round(hac_t(pnl),3),
            "dsr": round(dsr(pnl, n_trials),3), "mcpt_p": round(mcpt(dirv,tgt,fric),4)}

def main():
    df = pd.read_parquet("/Users/kaveh/mim_research/es_sessions.parquet").reset_index()
    df["date"] = pd.to_datetime(df["date"])
    df["yr"] = df["date"].dt.year
    print(f"Loaded {len(df)} ES sessions {df['date'].min().date()}..{df['date'].max().date()}")
    print(f"Friction = {FRIC} pt round-trip (MES). Signal = sign(first30_on) "
          f"[paper r1, incl overnight]; also first30 [intraday]. Enter 15:30, exit 16:00.\n")

    rows = []
    # headline: paper r1 (with overnight), full + eras (post-2018 = true OOS / post-publication)
    for sig in ["first30_on", "first30"]:
        rows.append(stats(df, sig, f"[{sig}] FULL 2010-2026"))
        rows.append(stats(df[df.yr<=2017], sig, f"[{sig}] 2010-2017 (pre-pub)"))
        rows.append(stats(df[df.yr>=2018], sig, f"[{sig}] 2018-2026 (POST-PUB OOS)"))
        rows.append(stats(df[df.yr>=2022], sig, f"[{sig}] 2022-2026 (recent OOS)"))
    print(pd.DataFrame([r for r in rows if r]).to_string(index=False))

    # per-year, paper r1, net of friction — decay check
    print("\nPer-year net (first30_on, sign rule, net of 0.75pt):")
    yr_rows = []
    for y, g in df.dropna(subset=["first30_on"]).groupby("yr"):
        s = stats(g, "first30_on", str(y))
        if s: yr_rows.append({"yr": y, "n": s["n"], "net_pt": s["net_pt"],
                              "net_pts_tot": s["net_pts_tot"], "hit": s["hit"], "hac_t": s["hac_t"]})
    print(pd.DataFrame(yr_rows).to_string(index=False))

    # gross vs friction: what's the break-even?
    d = df.dropna(subset=["first30_on"])
    dirv = np.sign(d["first30_on"].to_numpy()); tgt = d["target_pts"].to_numpy()
    gross = (dirv*tgt).mean()
    print(f"\nMean GROSS pt/trade (full sample): {gross:.4f}  "
          f"-> break-even friction; MES friction {FRIC}pt leaves {gross-FRIC:+.4f} net/trade.")

if __name__ == "__main__":
    main()

