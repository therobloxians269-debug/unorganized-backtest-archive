def run_module1_demo(symbol: str = "MES") -> pd.DataFrame:
    """End-to-end Module 1 integration test using synthetic data."""
    SEP = "=" * 65
    print(SEP)
    print(f"  IABR  –  Module 1 Integration Test          [{symbol}]")
    print(SEP)

    print("\n[1/4]  Generating synthetic data …")
    raw = DataLoader.generate_synthetic(symbol=symbol, n_sessions=252, seed=42)
    print(f"       Bars: {len(raw):,}  |  {raw.index[0].date()} → {raw.index[-1].date()}")

    print("\n[2/4]  Building economic calendar …")
    cal = EconomicCalendar()
    cal.load_default_high_impact_dates("2023-01-01", "2024-01-01")
    cal.add_event(EconomicEvent(pd.Timestamp("2023-03-14"), EventType.CPI,
                                EventImpact.HIGH, time(8,30), "CPI March 2023"))
    cal.add_event(EconomicEvent(pd.Timestamp("2023-05-03"), EventType.FOMC,
                                EventImpact.HIGH, time(14,0), "FOMC May 2023"))
    print(f"       Events: {len(cal._events)}")

    print(f"\n[3/4]  Processing sessions …")
    sm        = SessionManager(symbol)
    processed = sm.process(raw, calendar=cal)

    print(f"\n[4/4]  Validation")
    print("-" * 50)
    for stype, cnt in processed["session_type"].value_counts().items():
        print(f"  {str(stype):<15} {cnt:>8,} bars")

    s0_close = processed.loc[processed["rth_session_id"] == 0.0, "close"].iloc[-1]
