"""
volclock_backtest.py
====================
Runnable backtest harness for the execution-overlay + risk-sizing system.

WHAT THIS PROVES (synthetic data): the PLUMBING. Volume-bar construction, the
round-trip/latency cost model (return-space, ES-calibrated), the adverse-
selection gate, Almgren-Chriss order-splitting with OFI-conditioned aggression,
vol-targeting (Psi) + convex drawdown cutoff (Phi), and a full cost-loaded
equity recursion emitting Sharpe / Sortino / Calmar / MaxDD.

WHAT THIS DOES NOT PROVE: edge. The host signal (`SyntheticOracle`) is a knob,
not a predictor. The ONLY result that transfers to reality is the execution
overlay's cost saving vs a market order -- a property of the cost model.

TO MAKE IT REAL: (1) swap synth_ticks() for a Databento bar loader,
(2) drop a validated alpha into a HostSignal subclass, (3) run your
chronological-split / embargo / purge / DSR gauntlet. Nothing is believable
before (3).
"""
from __future__ import annotations
from abc import ABC, abstractmethod
from dataclasses import dataclass
import sys
import numpy as np
import polars as pl

RNG = np.random.default_rng(7)
BPS = 1e-4  # one basis point as a fraction

# ----------------------------------------------------------------------------
@dataclass
class Contract:
    multiplier: float = 50.0          # ES=$50/pt, MES=$5/pt
    tick: float = 0.25
    ref_price: float = 5500.0
    bars_per_year: float = 252 * 26

@dataclass
class CostParams:           # all in basis points of notional
    spread_bps: float = 0.45          # 1 ES tick at ~5500
    commission_bps: float = 0.073     # per side (~$2/contract)
    A_floor_bps: float = 0.30         # adverse-selection floor (passive leg)
    adverse_slope_bps: float = 0.60   # extra adverse-sel when OFI runs against us
    eta_bps: float = 6.0              # temporary-impact coeff (sqrt-law)
    gamma_bps: float = 1.0            # permanent-impact coeff
    delta: float = 0.15               # decision->fill latency (s)
    beta_delta: float = 0.30          # latency-slippage coeff

# ----------------------------------------------------------------------------
def synth_ticks(n_ticks=3_000_000, p0=5500.0, drift_strength=1.0,
                dd_shock_at=0.55) -> pl.DataFrame:
    """Ticks: autocorrelated order flow + bid-ask bounce + slow latent drift +
    a mid-sample vol shock so Phi can engage. REPLACE with a Databento loader."""
    eps = np.empty(n_ticks); eps[0] = 1
    flip = RNG.random(n_ticks) > 0.62
    for i in range(1, n_ticks):
        eps[i] = -eps[i-1] if flip[i] else eps[i-1]
    sizes = RNG.integers(1, 8, n_ticks).astype(float)
    t = np.arange(n_ticks)
    latent = drift_strength * np.sin(2*np.pi*t/120_000)
    vol = np.full(n_ticks, 0.060)
    if dd_shock_at is not None:
        k0 = int(dd_shock_at*n_ticks); vol[k0:k0+n_ticks//10] *= 3.2
    innov = RNG.normal(0, 1, n_ticks)*vol
    micro = 0.5*eps*(sizes/sizes.mean())*0.01
    mid = p0 + np.cumsum(innov + micro + latent/1000.0)
    price = mid + eps*(Contract().tick/2)
    return pl.DataFrame({"price": price, "mid": mid, "size": sizes,
                         "aggressor": eps, "_latent": latent})

# 1. Volume bars --------------------------------------------------------------
class VolumeBarBuilder:
    def __init__(self, V_star): self.V = V_star
    def build(self, ticks):
        return (ticks
            .with_columns(bar_id=(pl.col("size").cum_sum()//self.V).cast(pl.Int64),
                          signed=pl.col("size")*pl.col("aggressor"))
            .group_by("bar_id", maintain_order=True)
            .agg(open=pl.col("mid").first(), close=pl.col("mid").last(),
                 high=pl.col("mid").max(), low=pl.col("mid").min(),
                 vol=pl.col("size").sum(), ofi=pl.col("signed").sum()/self.V)
            .with_columns(logret=(pl.col("close")/pl.col("open")).log())
            .with_columns(sigma=pl.col("logret").rolling_std(64, min_samples=8)
                          .fill_null(strategy="backward").fill_null(0.001)))

# 2. Host signal (plug-in). Oracle is a KNOB ----------------------------------
class HostSignal(ABC):
    @abstractmethod
    def alpha(self, bars: pl.DataFrame, gate_floor: float) -> np.ndarray: ...

class SyntheticOracle(HostSignal):
    """alpha = info_frac * (future-return component) + sqrt(1-info_frac^2)*noise,
    scaled so std(alpha) straddles the gate. info_frac in [0,1]: 0=pure noise,
    1=perfect foresight. LEAKS THE FUTURE. Drives plumbing only."""
    def __init__(self, info_frac, target_mult=2.5, H=5):
        self.f, self.mult, self.H = info_frac, target_mult, H
    def alpha(self, bars, gate_floor):
        lr = bars["logret"].to_numpy()
        fwd = np.zeros_like(lr)
        for h in range(1, self.H+1): fwd[:-h] += lr[h:]
        fwd /= self.H
        fz = (fwd - fwd.mean())/(fwd.std()+1e-12)
        nz = RNG.normal(0, 1, len(lr))
        raw = self.f*fz + np.sqrt(max(1-self.f**2, 0))*nz       # corr(raw,fwd)=info_frac
        return raw*(self.mult*gate_floor)

# 3. Cost model (return space) ------------------------------------------------
class CostModel:
    def __init__(self, p: CostParams, contract: Contract):
        self.p, self.c = p, contract
        self.spread = p.spread_bps*BPS
        self.comm = p.commission_bps*BPS
        self.A = p.A_floor_bps*BPS
        self.adv = p.adverse_slope_bps*BPS
        self.eta = p.eta_bps*BPS
        self.gamma = p.gamma_bps*BPS

    def round_trip(self):            return self.spread + 2*self.comm
    def latency_slip(self, sigma):   return self.p.beta_delta*sigma*np.sqrt(self.p.delta)
    def gate_rhs(self, sigma):       return self.round_trip()+self.A+self.latency_slip(sigma)

    def child_cost_usd(self, n, V, ofi, aggression, price):
        """Realized $ cost of child trade `n` contracts (signed)."""
        if n == 0: return 0.0
        s = np.sign(n); notional = price*self.c.multiplier
        temp = self.eta*np.sqrt(abs(n)/max(V, 1e-9))            # impact (fraction)
        adverse = self.A + self.adv*max(0.0, -ofi*s)            # passive leg only
        taker = self.spread/2 + self.comm + temp               # cross: pay half-spread+impact
        passive = -self.spread/2 + self.comm + adverse + 0.3*temp  # post: earn half-spread, eat adverse
        unit = aggression*taker + (1-aggression)*passive       # fraction per contract
        return abs(n)*unit*notional                            # $ (can be slightly <0 if benign passive)

# 4. Risk sizer: Phi, Psi, gate, CVaR clip ------------------------------------
class RiskSizer:
    def __init__(self, costs, f_star=0.30, sigma_tgt=0.001, D_max=0.18, p=2.0,
                 psi_max=4.0, rho=0.04, L_max=3.0):
        self.costs, self.f, self.st = costs, f_star, sigma_tgt
        self.Dmax, self.p, self.psi_max, self.rho, self.L = D_max, p, psi_max, rho, L_max
    def target_notional(self, alpha, sigma, equity, dd, ddev):
        if abs(alpha) <= self.costs.gate_rhs(sigma):           # adverse-sel gate
            return 0.0, True
        dd = min(max(dd, 0.0), 0.999)
        Phi = max(0.0, 1.0-(dd/self.Dmax)**self.p)             # convex DD cutoff
        Psi = min(self.psi_max, self.st/max(sigma, 1e-6))      # vol targeting
        raw = self.f*(alpha/max(sigma**2, 1e-9))*equity*Phi*Psi
        cvar_unit = 2.06*ddev                                  # ~95% CVaR of N(0,ddev)
        if cvar_unit > 1e-9:
            cap = self.rho*equity/cvar_unit
            raw = float(np.clip(raw, -cap, cap))
        gross = self.L*equity                                  # hard gross-leverage cap
        return float(np.clip(raw, -gross, gross)), False

# 5. Execution: AC weights + OFI-conditioned aggression -----------------------
class ExecutionOptimizer:
    def __init__(self, costs, n_children=6, risk_aversion=2e-4):
        self.costs, self.N, self.lam = costs, n_children, risk_aversion
    def ac_weights(self, sigma, tau=1.0):
        eta_t = max(self.costs.eta - 0.5*self.costs.gamma*tau, 0.25*self.costs.eta)
        arg = 1 + 0.5*(self.lam*sigma**2/eta_t)*tau**2
        arg = min(arg, float(np.cosh(2.0)))                    # cap front-loading
        if arg <= 1.0: return np.full(self.N, 1.0/self.N)      # TWAP
        kappa = np.arccosh(arg)/tau
        j = np.arange(self.N+1)
        hold = np.sinh(kappa*(self.N-j)*tau)/np.sinh(kappa*self.N*tau)
        w = np.diff(1.0-hold); return w/w.sum()
    def _aggression(self, n, ofi, residual_ev):
        s = np.sign(n)
        taker = self.costs.spread/2 + self.costs.comm
        adverse = self.costs.A + self.costs.adv*max(0.0, -ofi*s)
        passive = -self.costs.spread/2 + self.costs.comm + adverse
        aligned_take = (np.sign(n) == np.sign(ofi)) and (residual_ev > taker)
        return 1.0 if (aligned_take or passive > taker) else 0.0  # take if posting is dearer
    def execute_usd(self, delta, V, ofi, alpha, sigma, price, market_order=False):
        if abs(delta) < 1e-9: return 0.0
        if market_order:
            return self.costs.child_cost_usd(delta, V, ofi, 1.0, price)
        w = self.ac_weights(sigma)
        total, residual_ev = 0.0, abs(alpha)
        for wi in w:
            n = delta*wi
            a = self._aggression(n, ofi, residual_ev)
            total += self.costs.child_cost_usd(n, V/self.N, ofi, a, price)
            residual_ev *= 0.85
        return total

# 6. Backtester: cost-loaded equity recursion --------------------------------
@dataclass
class Result:
    equity: np.ndarray; positions: np.ndarray; gated_frac: float
    exec_usd: float; baseline_usd: float; turnover: float

class Backtester:
    def __init__(self, contract, sizer, execu, costs, e0=100_000.0):
        self.c, self.sizer, self.execu, self.costs, self.e0 = contract, sizer, execu, costs, e0
    def run(self, bars, signal):
        gate0 = self.costs.gate_rhs(float(bars["sigma"].median()))
        a = signal.alpha(bars, gate0)
        close = bars["close"].to_numpy(); sigma = bars["sigma"].to_numpy()
        ofi = bars["ofi"].to_numpy(); vol = bars["vol"].to_numpy()
        lr = bars["logret"].to_numpy(); n = len(close)
        equity = np.empty(n); equity[0] = self.e0
        pos = np.zeros(n); peak = self.e0
        gated = 0; exec_usd = base_usd = 0.0; turn = 0.0
        for k in range(1, n):
            dd = 1.0 - equity[k-1]/peak
            ddev = max(np.std(np.minimum(lr[max(0, k-64):k], 0.0)), 1e-5)
            tgt_notional, was_gated = self.sizer.target_notional(
                a[k], sigma[k], equity[k-1], dd, ddev)
            gated += was_gated
            tgt = tgt_notional/(close[k]*self.c.multiplier)    # contracts
            delta = tgt - pos[k-1]; turn += abs(delta)
            slip = self.execu.execute_usd(delta, vol[k], ofi[k], a[k], sigma[k], close[k])
            base = self.execu.execute_usd(delta, vol[k], ofi[k], a[k], sigma[k],
                                          close[k], market_order=True)
            exec_usd += abs(slip); base_usd += abs(base)
            mtm = pos[k-1]*(close[k]-close[k-1])*self.c.multiplier
            equity[k] = max(equity[k-1] + mtm - slip, 1.0)  # ruin guard
            pos[k] = tgt; peak = max(peak, equity[k])
        return Result(equity, pos, gated/n, exec_usd, base_usd, turn)

# Metrics ---------------------------------------------------------------------
def perf(equity, bpy):
    r = np.diff(equity)/equity[:-1]; r = r[np.isfinite(r)]
    if len(r) < 2 or r.std() == 0:
        return dict(sharpe=0, sortino=0, calmar=0, maxdd=0, cagr=0)
    ann = np.sqrt(bpy); sharpe = r.mean()/r.std()*ann
    dn = r[r < 0].std() if (r < 0).any() else 1e-9
    sortino = r.mean()/dn*ann
    peak = np.maximum.accumulate(equity); dd = 1-equity/peak; maxdd = dd.max()
    yrs = len(equity)/bpy; cagr = (equity[-1]/equity[0])**(1/max(yrs, 1e-9))-1
    calmar = cagr/maxdd if maxdd > 1e-9 else 0
    d = dict(sharpe=sharpe, sortino=sortino, calmar=calmar, maxdd=maxdd, cagr=cagr)
    return {k: float(np.nan_to_num(v, posinf=0.0, neginf=0.0)) for k, v in d.items()}

# Real-data loader: Databento MES MBO -> volume bars ------------------------
def load_mes_mbo(path, v_star=2500, price_scale=None, sign_method="tick"):
    """Load a Databento MES MBO parquet and build volume bars in the SAME schema
    VolumeBarBuilder.build() produces, so the whole engine runs on real ticks."""
    lf = pl.scan_parquet(path); cols = lf.collect_schema().names()
    need = ["action", "side", "price", "size"]
    miss = [c for c in need if c not in cols]
    if miss:
        raise ValueError(f"missing columns {miss}; file has {cols}")
    df = lf.select(need).collect()
    trades = df.filter(pl.col("action") == "T")
    if trades.height == 0:
        raise ValueError("no action=='T' rows found; check the action encoding")
    price = trades["price"].to_numpy().astype(float)
    size = trades["size"].to_numpy().astype(float)
    if price_scale is None:
        price_scale = 1e-9 if np.nanmedian(np.abs(price)) > 1e8 else 1.0
    price = price * price_scale

    dp = np.diff(price, prepend=price[0]); tick_sign = np.sign(dp)
    last = 1.0
    for i in range(len(tick_sign)):
        if tick_sign[i] == 0: tick_sign[i] = last
        else: last = tick_sign[i]
    sd = trades["side"].to_numpy()
    side_sign = np.where(sd == "B", 1.0, np.where(sd == "A", -1.0, 0.0))
    m = side_sign != 0
    agree = float(np.mean(tick_sign[m] == side_sign[m])) if m.any() else float("nan")
    sign = tick_sign if sign_method == "tick" else side_sign

    ticks = pl.DataFrame({"price": price, "mid": price, "size": size, "aggressor": sign})
    bars = VolumeBarBuilder(v_star).build(ticks)
    print(f"[loader] trades parsed: {trades.height:,} | volume bars: {bars.height} "
          f"| price_scale={price_scale:g}")
    print(f"[loader] tick-rule vs side-field sign agreement: {agree:.1%} "
          f"(<<50% => your `side` is the maker side)")
    return bars

def load_mes_dbn(path, instrument_id=42003945, v_star=2500, sign_method="tick"):
    """Decode a Databento MES `.dbn.zst` MBO file -> volume bars (engine schema).

    Handles the MES.FUT-parent reality (multiple contract months interleaved): it
    filters to ONE instrument_id (pass instrument_id=None to auto-pick the
    max-trade-volume contract). For CME MBO, trade ('T') prints carry side='N' and
    per-order fills arrive as 'F' records:
      - sign_method='tick'  (default): tick-rule on T prints. Robust, side-agnostic.
      - sign_method='fill': aggressor from F.side (A = resting ask hit => buyer = +1).
    A per-second signed-volume cross-check between the two is printed; if it comes
    back NEGATIVE, the venue convention is opposite -> flip the F.side mapping.
    """
    import pandas as pd
    from databento import DBNStore
    df = DBNStore.from_file(path).to_df()        # pandas; float px, datetime ts, symbol
    if instrument_id is None:
        t0 = df[df["action"] == "T"]
        if t0.empty: raise ValueError("no T (trade) records in file")
        instrument_id = int(t0.groupby("instrument_id")["size"].sum().idxmax())
        print(f"[dbn] front month auto-selected: instrument_id={instrument_id}")
    d = df[df["instrument_id"] == instrument_id]
    trades = d[d["action"] == "T"]; fills = d[d["action"] == "F"]
    if trades.empty: raise ValueError(f"no trades for instrument_id={instrument_id}")
    print(f"[dbn] iid {instrument_id}: {len(trades):,} T, {len(fills):,} F | "
          f"T.side={dict(trades['side'].value_counts())} | "
          f"F.side={dict(fills['side'].value_counts()) if len(fills) else {}}")

    p_t = trades["price"].to_numpy(float)
    dp = np.diff(p_t, prepend=p_t[0]); s_t = np.sign(dp); last = 1.0
    for i in range(len(s_t)):
        if s_t[i] == 0: s_t[i] = last
        else: last = s_t[i]
    s_f = None
    if len(fills):
        sd = fills["side"].to_numpy()
        s_f = np.where(sd == "A", 1.0, np.where(sd == "B", -1.0, 0.0))
        sec_t = pd.DataFrame({"t": trades["ts_event"].dt.floor("s").values,
                              "sv": s_t * trades["size"].to_numpy(float)}).groupby("t")["sv"].sum()
        sec_f = pd.DataFrame({"t": fills["ts_event"].dt.floor("s").values,
                              "sv": s_f * fills["size"].to_numpy(float)}).groupby("t")["sv"].sum()
        j = pd.concat([sec_t, sec_f], axis=1, join="inner").dropna()
        corr = j.iloc[:, 0].corr(j.iloc[:, 1]) if len(j) > 2 else float("nan")
        print(f"[dbn] per-second signed-vol corr (tick vs fill): {corr:+.3f} "
              f"({'agree' if corr > 0 else 'FLIP F.side mapping' if corr < 0 else 'n/a'})")

    if sign_method == "fill" and s_f is not None:
        price, size, sign, src = (fills["price"].to_numpy(float),
                                  fills["size"].to_numpy(float), s_f, "F-fills")
    else:
        price, size, sign, src = p_t, trades["size"].to_numpy(float), s_t, "T(tick-rule)"
    ticks = pl.DataFrame({"price": price, "mid": price, "size": size.astype(float),
                          "aggressor": sign})
    bars = VolumeBarBuilder(v_star).build(ticks)
    print(f"[dbn] signed via {src}: {bars.height} volume bars from {len(price):,} prints")
    return bars

def estimate_kyle_lambda(bars):
    """Permanent price impact measured FROM the data: regress bar logret on signed
    flow (OFI). Returns lambda (return per unit OFI). This calibrates gamma instead
    of assuming it -- a measured structural parameter, not one fit to returns."""
    ofi = bars["ofi"].to_numpy(); ret = bars["logret"].to_numpy()
    A = np.vstack([ofi, np.ones_like(ofi)]).T
    coef, *_ = np.linalg.lstsq(A, ret, rcond=None)
    return float(coef[0])

# Reusable execution-overlay test (the transferable result) ------------------
def execution_overlay_test(bars, costs, contract, n_orders=300, label=""):
    hi = bars.height
    lo = 64 if hi > 128 else max(1, hi // 8)
    if hi - lo < 2:
        print(f"\nEXECUTION OVERLAY TEST {label}— too few bars ({hi}) to sample")
        return 0.0
    execu = ExecutionOptimizer(costs)
    idx = RNG.integers(lo, hi, n_orders)
    ac_tot = mk_tot = notional_tot = 0.0
    for i in idx:
        r = bars.row(int(i), named=True); qty = float(RNG.choice([-40, -25, 25, 40]))
        ac_tot += execu.execute_usd(qty, r["vol"], r["ofi"], 0.0008, r["sigma"], r["close"])
        mk_tot += execu.execute_usd(qty, r["vol"], r["ofi"], 0.0008, r["sigma"],
                                    r["close"], market_order=True)
        notional_tot += abs(qty) * r["close"] * contract.multiplier
    ac_bps = ac_tot / notional_tot / BPS
    mk_bps = mk_tot / notional_tot / BPS
    print(f"\nEXECUTION OVERLAY TEST {label}— {n_orders} random parent orders")
    print(f"  AC + OFI-conditioned : {ac_bps:6.2f} bps  (${ac_tot:,.0f})")
    print(f"  single market orders : {mk_bps:6.2f} bps  (${mk_tot:,.0f})")
    print(f"  shortfall reduction  : {mk_bps - ac_bps:6.2f} bps  (${mk_tot - ac_tot:,.0f} saved)")
    return mk_bps - ac_bps

# Driver ----------------------------------------------------------------------
def run_real(path):
    """Backtest the execution overlay on REAL MES MBO ticks, with impact
    calibrated from the data."""
    contract = Contract(multiplier=5.0, ref_price=5500.0)   # MES = $5/pt
    print("="*78)
    print(f"REAL MES MBO EXECUTION BACKTEST — {path}")
    print("="*78)
    if path.endswith((".dbn", ".dbn.zst", ".zst")):
        bars = load_mes_dbn(path)              # Databento native; front-month filtered
    else:
        bars = load_mes_mbo(path, v_star=2500) # pre-converted parquet
    lam = estimate_kyle_lambda(bars)
    sig = float(bars["sigma"].median())
    print(f"[data] median bar sigma: {sig:.5f} | mean|OFI|: "
          f"{float(bars['ofi'].abs().mean()):.4f} | measured Kyle-lambda: {lam:.3e}")

    cp = CostParams()
    cp.gamma_bps = float(np.clip(abs(lam) / BPS, 0.1, 3.0))
    costs = CostModel(cp, contract)
    print(f"[calib] gamma set from data: {cp.gamma_bps:.2f} bps/unit-OFI | "
          f"taker round-trip: {costs.round_trip()/BPS:.2f} bps\n")

    execution_overlay_test(bars, costs, contract, label="(real MES) ")

    print("\nEngine sanity on real bars (noise signal — P&L is NOT meaningful):")
    bt = Backtester(contract, RiskSizer(costs), ExecutionOptimizer(costs), costs)
    res = bt.run(bars, SyntheticOracle(info_frac=0.0))
    m = perf(res.equity, contract.bars_per_year)
    print(f"  gated {res.gated_frac:.1%} of bars | MaxDD {m['maxdd']:.1%} (vs 18% Phi cap) "
          f"| no-edge Sharpe {m['sharpe']:.2f} (should be <=0)")
    print("\nWhat this validates: the overlay's shortfall reduction and the cost")
    print("model on REAL MES microstructure, plus impact measured from your data.")
    print("What it does NOT: edge. Bring a validated HostSignal + longer history.")

def main():
    if len(sys.argv) > 1:
        run_real(sys.argv[1]); return
    contract = Contract(); costs = CostModel(CostParams(), contract)
    print("="*78)
    print("PLUMBING VALIDATION — synthetic data, synthetic oracle. NOT a P&L claim.")
    print("(pass a MES MBO parquet path as argv[1] to run on REAL data)")
    print("="*78)
    print(f"Taker round-trip cost: {costs.round_trip()/BPS:.2f} bps  "
          f"(gate floor before latency term)\n")
    ticks = synth_ticks()
