    print(f"Built {bars.height} volume bars from {ticks.height:,} ticks (V*=2500)")
    print(f"Median bar sigma: {float(bars['sigma'].median()):.5f} | "
          f"gate floor @ median sigma: {costs.gate_rhs(float(bars['sigma'].median()))/BPS:.2f} bps\n")
    print(f"{'info_frac':>9} | {'Sharpe':>7} {'Sortino':>8} {'Calmar':>7} {'MaxDD':>7} "
          f"| {'gated%':>7} | {'exec$':>9} {'base$':>9} {'saved':>9}")
    print("-"*92)
