import numpy as np, pandas as pd, microbt as M

PATH='/Users/kaveh/omni_x/es_front_2017_24h_1m.parquet'
NY='America/New_York'

def run(tf, side):
    df=M.load(PATH, tf=tf)
    ny=df.index.tz_convert(NY)
    day=ny.normalize()
    tstr=ny.strftime('%H:%M')
    minute=ny.hour*60+ny.minute
    o=df['open'].to_numpy(); h=df['high'].to_numpy(); l=df['low'].to_numpy(); c=df['close'].to_numpy(); v=df['volume'].to_numpy()
    df=df.assign(_day=day.values,_min=minute)
    trades=[]
    # RTH: 09:30(570) .. 16:00(960). entry at 15:30(930) open, exit last RTH bar close
    for d,g in df.groupby('_day'):
        pos=g.index  # timestamps
        ii=[df.index.get_loc(t) for t in pos]
        ii=np.array(ii)
        mins=g['_min'].to_numpy()
        rth=(mins>=570)&(mins<960)  # 09:30 <= t < 16:00
        if rth.sum()<5: continue
        ri=ii[rth]; rm=mins[rth]
        # session open = open of first RTH bar
        sop=o[ri[0]]
        # signal window: bars up to and including 15:00 (min<900 covers up to 15:00 start)
        sig_mask=rm<900  # bars before 15:00 (i.e., signal known by 15:00)
        if sig_mask.sum()<3: continue
        sig_idx=ri[sig_mask]
        # VWAP through 15:00 using typical price
        tp=(h[sig_idx]+l[sig_idx]+c[sig_idx])/3.0
        vol=v[sig_idx]
        vwap=(tp*vol).sum()/vol.sum() if vol.sum()>0 else tp.mean()
        p15=c[sig_idx[-1]]  # price at ~15:00
        up=(p15-sop)>0
        above=p15>vwap
        # entry bar: first RTH bar with min>=930 (15:30)
        ent_mask=rm>=930
        if ent_mask.sum()<1: continue
        ent=ri[ent_mask][0]
        # exit: last RTH bar
        ext=ri[-1]
        if ext<ent: ext=ent
        long_ok = up and above
        short_ok = (not up) and (p15<vwap)
        if side=='long' and long_ok:
            trades.append((ent,ext,1))
        elif side=='short' and short_ok:
            trades.append((ent,ext,-1))
    return M.evaluate(df, trades, name=f'moc_{side}_{tf}')

for tf in ['5min','30min']:
    for side in ['long','short']:
        r=run(tf,side)
        M.show(r)
        if r.get('IS'): print('   IS_t',r['IS']['t'],'OOS_t',r.get('OOS'))
    print()

