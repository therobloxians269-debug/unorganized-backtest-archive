"""Batch 2 — low-turnover intraday structure (<=1-2 trades/day).

Post-2018 regime favours continuation/breakout (user's 5m-VWAP-breakout and
claims-momentum survivors point the same way). Test opening-range and
gap/session structures where a fixed round-trip cost is small vs the hold.
Each strategy yields at most a couple of Trades per session.
"""
from __future__ import annotations

import numpy as np
import pandas as pd

from daytrade import Trade, screen_day, leaderboard

RTH_OPEN = 570   # 09:30 ET in minutes
RTH_CLOSE = 960  # 16:00


def _mod(g):
    return g.index.hour * 60 + g.index.minute


def opening_range_break(g, or_min=30, exit_min=RTH_CLOSE - 5, mode="mom"):
    """Break of the first `or_min` RTH range -> one trade, hold to exit_min.
    mode='mom': trade the break direction; 'fade': trade against it."""
    m = _mod(g)
    orr = g[(m >= RTH_OPEN) & (m < RTH_OPEN + or_min)]
    if len(orr) < or_min * 0.5:
        return []
    hi, lo = orr["es_high"].max(), orr["es_low"].min()
    after = g[(m >= RTH_OPEN + or_min) & (m < exit_min)]
    if after.empty:
        return []
    exit_bar = g[m < exit_min].iloc[-1]
    for ts, row in after.iterrows():
        if row["es_high"] > hi:
            side = 1 if mode == "mom" else -1
            return [Trade(g["session"].iloc[0], side, hi, exit_bar["es_close"], "brk_hi")]
        if row["es_low"] < lo:
            side = -1 if mode == "mom" else 1
            return [Trade(g["session"].iloc[0], side, lo, exit_bar["es_close"], "brk_lo")]
    return []


def first_hour_follow(g, decide_min=RTH_OPEN + 60, exit_min=RTH_CLOSE - 5, mode="mom"):
    """Sign of 09:30->decide return sets rest-of-day direction."""
    m = _mod(g)
    pre = g[m <= decide_min]
    post = g[(m > decide_min) & (m < exit_min)]
    if len(pre) < 30 or post.empty:
        return []
    open_px = pre["es_close"].iloc[0]
    r = pre["es_close"].iloc[-1] - open_px
    if r == 0:
        return []
    side = int(np.sign(r)) * (1 if mode == "mom" else -1)
    entry = post["es_close"].iloc[0]
    exit_bar = g[m < exit_min].iloc[-1]
    return [Trade(g["session"].iloc[0], side, entry, exit_bar["es_close"], "fh")]


def overnight_gap(g, exit_min=RTH_CLOSE - 5, mode="mom", min_gap=2.0):
    """Gap = RTH open vs prior close (approx via first RTH bar vs session's
    earliest overnight)."""
    m = _mod(g)
    rth = g[m >= RTH_OPEN]
    if len(rth) < 60:
        return []
    prior = g[m < RTH_OPEN]
    if prior.empty:
        return []
    gap = rth["es_close"].iloc[0] - prior["es_close"].iloc[-1]
    if abs(gap) < min_gap:
        return []
    side = int(np.sign(gap)) * (1 if mode == "mom" else -1)
    entry = rth["es_close"].iloc[0]
    exit_bar = rth[m[m >= RTH_OPEN] < exit_min]
    exit_px = exit_bar["es_close"].iloc[-1] if not exit_bar.empty else rth["es_close"].iloc[-1]
    return [Trade(g["session"].iloc[0], side, entry, exit_px, "gap")]


BATCH = [
    ("or_break_mom",   opening_range_break, [{"or_min": o, "mode": "mom"} for o in (15, 30, 60)]),
    ("or_break_fade",  opening_range_break, [{"or_min": o, "mode": "fade"} for o in (15, 30, 60)]),
    ("first_hour_mom", first_hour_follow,   [{"decide_min": RTH_OPEN + d, "mode": "mom"} for d in (30, 60, 90)]),
    ("first_hour_fade",first_hour_follow,   [{"decide_min": RTH_OPEN + d, "mode": "fade"} for d in (30, 60, 90)]),
    ("gap_mom",        overnight_gap,       [{"mode": "mom", "min_gap": g} for g in (1, 2, 4)]),
    ("gap_fade",       overnight_gap,       [{"mode": "fade", "min_gap": g} for g in (1, 2, 4)]),
]


def main():
    results = []
    for name, fn, grid in BATCH:
        r = screen_day(name, fn, grid, rth_only=False)
        results.append(r)
        print(f"  ran {name:16s} -> test SR {r.get('te_sharpe',0):+.2f} [{r['status']}]")
    print("\n" + leaderboard(results))
    surv = [r for r in results if r["status"] == "SURVIVE"]
    print(f"\nSURVIVORS: {len(surv)}")
    for r in surv:
        print("  ", r)


if __name__ == "__main__":
    main()

