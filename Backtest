"""Replicate the boxes: buy the swing LOW of a pullback while structure is UP,
stop just under that low, target the PRIOR swing high. Long-biased mean reversion
inside a trend — which is what every green box on the chart is."""
import numpy as np, pandas as pd, warnings; warnings.filterwarnings('ignore')
TICK=0.25
def swings(H5,L5,lb=2):
    ph=np.full(len(H5),np.nan); pl=np.full(len(H5),np.nan)
    for i in range(lb,len(H5)-lb):
        if H5[i]==H5[i-lb:i+lb+1].max(): ph[i+lb]=H5[i]
        if L5[i]==L5[i-lb:i+lb+1].min(): pl[i+lb]=L5[i]
    return ph,pl
def run(m, pv=2.0, comm=1.50, lb=2, stopPct=0.0015, minRR=2.0, trendMA=100,
        maxwait=36, maxhold=288, longonly=True, verbose=False):
    o,h,l,c=m.open.values,m.high.values,m.low.values,m.close.values
    n=len(m); idx=np.arange(n)//5
    H5=pd.Series(h).groupby(idx).max().values; L5=pd.Series(l).groupby(idx).min().values
    C5=pd.Series(c).groupby(idx).last().values
    ph,pl=swings(H5,L5,lb)
    ma=pd.Series(C5).rolling(trendMA).mean().values
    phf=pd.Series(ph).ffill().values; plf=pd.Series(pl).ffill().values
    out=[]
    for gi in range(trendMA+lb, len(L5)-1):
        # a NEW confirmed swing low just printed at bar gi
        if not np.isfinite(pl[gi]): continue
        low=pl[gi]
        if not np.isfinite(ma[gi]) or not np.isfinite(phf[gi]): continue
        up = C5[gi] > ma[gi]                       # structure up
        if longonly and not up: continue
        d=1
        ent=low + stopPct*low*0.35                 # entry just above the low
        stp=low - stopPct*low
        tgt=phf[gi]                                # the PRIOR swing high
        risk=abs(ent-stp)
        if risk<TICK or tgt<=ent: continue
        rr=(tgt-ent)/risk
        if rr<minRR: continue
        st=gi*5+5
        if st>=n: break
        fill=-1
        for k in range(st,min(st+maxwait*5,n)):
            if l[k]<=ent: fill=k; break
        if fill<0: continue
        for k in range(fill+1,min(fill+maxhold,n)):
            if l[k]<=stp: px=stp-TICK; why='STOP'; break
            if h[k]>=tgt: px=tgt; why='TARGET'; break
            if k==min(fill+maxhold,n)-1: px=c[k]; why='time'; break
        else: continue
        out.append(dict(t=m.index[fill],entry=round(ent,2),stop=round(stp,2),target=round(tgt,2),
                        rr=round(rr,1),result=why,pnl=round((px-ent)*pv-comm,2)))
    return pd.DataFrame(out)

