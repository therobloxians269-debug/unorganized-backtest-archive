"""M4 -- risk management & position sizing.

Overnight equity-index risk is fat-tailed and, crucially, *un-stoppable*: once held
through the close there is no intraday stop before the next open. The only real risk
levers are therefore (1) the regime gate (M3, decides *whether* to be on) and (2)
*ex-ante* sizing (this module, decides *how big*). We size by inverse-volatility
targeting so the overnight book runs at a roughly constant annualized volatility, then
hard-cap exposure for the tails the vol forecast cannot see.

Sizing for a long overnight position of weight ``w`` (= notional / capital):
    annualized book vol  ~=  w * sigma_overnight_annual
Setting that equal to ``target_annual_vol`` gives the vol-target weight
    w* = target_annual_vol / sigma_overnight_annual   (capped at ``max_leverage``)
The M3 signal in {0, 1} then scales participation, and the dollar notional is converted
to an integer micro-contract count (you cannot trade a fraction of a contract):
    n = round( signal * w* * capital / (price * point_multiplier) ),  clipped to caps.

Everything is point-in-time: the vol forecast at ``d`` uses only overnight returns up to
``d``, and ``price`` is ``d``'s cash close (the entry mark). No target leakage.
"""
from __future__ import annotations

from typing import TYPE_CHECKING

import numpy as np
import pandas as pd

from ope.instruments import get_market
from ope.logging_utils import get_logger

if TYPE_CHECKING:  # avoid import cycle; only for type hints
    from ope.config import Config
    from ope.instruments import ContractSpec

_LOG = get_logger("risk")

VOL_FORECAST_METHODS = ("rolling", "ewma")
SIZING_COLUMNS = (
    "forecast_vol", "target_weight", "weight", "n_contracts",
    "position_notional", "realized_weight",
)


def forecast_overnight_vol(
    overnight_logret: pd.Series,
    lookback: int,
    *,
    periods_per_year: int = 252,
    method: str = "rolling",
) -> pd.Series:
    """Point-in-time annualized forecast of overnight-return volatility.

    ``rolling`` uses a trailing sample std; ``ewma`` an exponentially-weighted std
    (span = ``lookback``), which reacts faster to volatility clustering. Both end the
    window at ``d`` and are NaN until ``lookback`` observations exist.
    """
    if method not in VOL_FORECAST_METHODS:
        raise ValueError(f"unknown method {method!r}; known: {VOL_FORECAST_METHODS}")
    if lookback < 2:
        raise ValueError("lookback must be >= 2")

    if method == "rolling":
        daily = overnight_logret.rolling(lookback, min_periods=lookback).std(ddof=1)
    else:
        daily = overnight_logret.ewm(span=lookback, min_periods=lookback).std(bias=False)
    return (daily * np.sqrt(periods_per_year)).rename("forecast_vol")


def vol_target_weight(
    forecast_vol: pd.Series,
    target_vol: float,
    max_leverage: float,
) -> pd.Series:
    """Inverse-vol exposure weight ``target_vol / forecast_vol``, capped at ``max_leverage``.

    Non-positive or missing forecasts yield 0 weight (we will not size a position without
    a usable risk estimate).
    """
    weight = (target_vol / forecast_vol).where(forecast_vol > 0, other=0.0)
    return weight.clip(upper=max_leverage).fillna(0.0).rename("target_weight")


def size_position(
    signal: pd.Series,
    forecast_vol: pd.Series,
    price: pd.Series,
    contract: "ContractSpec",
    *,
    capital: float,
    target_vol: float,
    max_leverage: float,
    max_contracts: int,
) -> pd.DataFrame:
    """Vol-target an overnight position into an integer micro-contract count.

    All series are aligned to ``signal.index``. Returns one row per decision date with
    the intended ``weight``, the rounded ``n_contracts`` (clipped to ``[0, max_contracts]``),
    and the realized exposure after integer rounding.
    """
    if capital <= 0:
        raise ValueError("capital must be > 0")
    if max_contracts < 1:
        raise ValueError("max_contracts must be >= 1")

    idx = signal.index
    sig = signal.reindex(idx).fillna(0.0)
    fv = forecast_vol.reindex(idx)
    px = price.reindex(idx)

    target_w = vol_target_weight(fv, target_vol, max_leverage)
    weight = (sig * target_w).rename("weight")
    notional = weight * capital

    per_contract = px * contract.point_multiplier
    raw = (notional / per_contract).where(per_contract > 0)
    n_contracts = raw.round().clip(lower=0, upper=max_contracts).fillna(0.0).astype("int64")

    position_notional = (n_contracts * per_contract).fillna(0.0)
    realized_weight = position_notional / capital

    return pd.DataFrame(
        {
            "forecast_vol": fv,
            "target_weight": target_w,
            "weight": weight,
            "n_contracts": n_contracts,
            "position_notional": position_notional,
            "realized_weight": realized_weight,
        },
        index=idx,
    )


def size_book(
    panels: dict[str, pd.DataFrame],
    signals: dict[str, pd.Series],
    prices: dict[str, pd.Series],
    config: "Config",
    *,
    method: str = "rolling",
) -> dict[str, pd.DataFrame]:
    """Size every market's overnight position from M2 panels, M3 signals, and cash prices.

    ``prices[key]`` is the cash-index close used as the entry mark (the blueprint researches
    and prices on cash, deploys on the micro). Returns ``{market_key: sizing frame}``.
    """
    risk = config.risk
    out: dict[str, pd.DataFrame] = {}
    for key, signal in signals.items():
        if key not in panels or key not in prices:
            _LOG.warning("missing panel/price for market %s; skipping sizing", key)
            continue
        panel = panels[key]
        forecast = forecast_overnight_vol(
            panel["overnight_logret"], risk.vol_lookback,
            periods_per_year=risk.trading_days_per_year, method=method,
        )
        out[key] = size_position(
            signal, forecast, prices[key], get_market(key).micro,
            capital=risk.capital, target_vol=risk.target_annual_vol,
            max_leverage=risk.max_leverage, max_contracts=risk.max_micros_per_market,
        )
    return out

