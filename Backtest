==============================================================================
"""M4 -- honest evaluation of the MES maker scalper across the full month of MBO.

Runs every session once at ZERO cost / ZERO taker-slip (the "raw path"), records per-trade
raw gross + a taker flag, then applies commission and taker slippage ANALYTICALLY (neither
changes which trades trigger -- only their P&L). That lets us sweep the whole cost/slip grid
from a single pass, and run the inverted-signal placebo the same way.

Reports: per-day table, aggregate + daily Sharpe, commission x slippage sensitivity grid,
inverted-signal placebo, chronological walk-forward (train early / test late), and the
PRE-REGISTERED kill conditions.

    PYTHONPATH=. python3 -m research.ofmm.run
"""
from __future__ import annotations

import numpy as np

from research.ofmm.tape import load_day, day_files, TICK, POINT
from research.ofmm.backtest import Params, run_day

ANN = 252
DOLLAR_TICK = TICK * POINT        # $1.25


def raw_pass(sign=1, **overrides):
    """Run all days at zero cost/slip; return list of (date, trades) with raw gross+taker."""
    p = Params(comm_side=0.0, taker_slip_ticks=0.0, sign=sign, **overrides)
    out = []
    for f in day_files():
        tp = load_day(f)
        trades, _, _, stats = run_day(tp, p)
        out.append((tp.date, trades, stats))
    return out


def net_of(trade, comm_side, slip):
    g = trade["gross_ticks"]
    if trade["taker"]:
        g -= slip                          # extra ticks lost crossing under latency
    return g * DOLLAR_TICK - 2.0 * comm_side


def day_nets(days, comm_side, slip):
    return np.array([sum(net_of(t, comm_side, slip) for t in tr) for _, tr, _ in days])


def sharpe(nets):
    if len(nets) < 2 or nets.std(ddof=1) == 0:
        return float("nan")
    return nets.mean() / nets.std(ddof=1) * np.sqrt(ANN)


def report(days, comm_side, slip, label):
    nets = day_nets(days, comm_side, slip)
    ntr = sum(len(tr) for _, tr, _ in days)
    tot = nets.sum()
    print(f"\n===== {label}  (comm ${comm_side:.2f}/side = ${2*comm_side:.2f} RT, "
          f"taker slip {slip:.2f} tk) =====")
    print(f"{'date':>10} {'trades':>7} {'net$':>10} {'cum$':>10}")
    cum = 0.0
    for (d, tr, _), nt in zip(days, nets):
        cum += nt
        print(f"{d:>10} {len(tr):>7} {nt:>10.2f} {cum:>10.2f}")
    posdays = (nets > 0).mean() * 100
    print(f"  TOTAL net ${tot:,.2f} over {ntr:,} trades on {len(days)} days | "
          f"mean/day ${nets.mean():.2f} | daily Sharpe(ann) {sharpe(nets):.2f} | "
          f"{posdays:.0f}% up-days | $/contract-yr est ${nets.mean()*ANN:,.0f}")
    return nets


def main():
    print("Loading + running raw pass (all sessions, WITH imbalance)...")
    days = raw_pass(sign=1)
    print("Running raw pass (INVERTED placebo)...")
    inv = raw_pass(sign=-1)

    CS, SL = 0.35, 0.5                       # default cost model
    base = report(days, CS, SL, "BASELINE with-flow")
    report(inv, CS, SL, "PLACEBO inverted-signal")

    # ---- commission x taker-slip sensitivity (analytic) ----
    print("\n===== COST / SLIPPAGE SENSITIVITY  (total net $, all days) =====")
    comms = [0.17, 0.35, 0.62, 1.00]         # $/side  (RT $0.34 .. $2.00)
    slips = [0.0, 0.5, 1.0, 1.5]             # taker slip ticks
    print("  slip\\comm  " + " ".join(f"${c:>5.2f}" for c in comms))
    for s in slips:
        cells = []
        for c in comms:
            cells.append(f"{day_nets(days, c, s).sum():>7.0f}")
        print(f"    {s:>4.1f}tk   " + " ".join(f"{x:>6}" for x in cells))

    # ---- walk-forward: chronological train (early) vs test (late) ----
    k = len(days) // 2
    tr_nets = day_nets(days[:k], CS, SL)
    te_nets = day_nets(days[k:], CS, SL)
    print("\n===== WALK-FORWARD (frozen params, chronological split) =====")
    print(f"  TRAIN {days[0][0]}..{days[k-1][0]}: net ${tr_nets.sum():.0f} "
          f"Sharpe {sharpe(tr_nets):.2f} {(tr_nets>0).mean()*100:.0f}% up")
    print(f"  TEST  {days[k][0]}..{days[-1][0]}: net ${te_nets.sum():.0f} "
          f"Sharpe {sharpe(te_nets):.2f} {(te_nets>0).mean()*100:.0f}% up")

    # ---- PRE-REGISTERED kill conditions (evaluated at default cost) ----
    print("\n===== PRE-REGISTERED KILL CONDITIONS (default cost) =====")
    checks = [
        ("net total > 0",              base.sum() > 0),
        ("daily Sharpe(ann) >= 1.0",   sharpe(base) >= 1.0),
        ("up-days >= 55%",             (base > 0).mean() >= 0.55),
        ("survives 1-tick taker slip", day_nets(days, CS, 1.0).sum() > 0),
        ("survives $0.62/side comm",   day_nets(days, 0.62, SL).sum() > 0),
        ("inverted placebo < 0 (real edge)", day_nets(inv, CS, SL).sum() < 0),
        ("test-half net > 0 (OOS)",    te_nets.sum() > 0),
    ]
    for name, ok in checks:
        print(f"  [{'PASS' if ok else 'FAIL'}] {name}")
    verdict = all(ok for _, ok in checks)
    print(f"\n  VERDICT: {'SURVIVES -> forward-test candidate' if verdict else 'FAILS gauntlet'}")


if __name__ == "__main__":
    main()

