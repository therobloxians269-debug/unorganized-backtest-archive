"""Mean reversion, market-profile family. The 80% rule generalised to intraday re-entry."""
import numpy as np, pandas as pd, warnings; warnings.filterwarnings('ignore')
from vp import race, RTH_A, RTH_B

def va_reentry(b, hold_min=30, stop_buf=0.25, max_hold=390, pv=2., comm=1.50,
               require_open_outside=False, va_shift=0.0, long_only=False, min_rr=0.0):
    """Price trades OUTSIDE prior value, then accepts back INSIDE for hold_min consecutive
    minutes -> target the far edge of value. va_shift displaces the VA for placebo."""
    out=[]
    for day,g in b.groupby('daycycle',sort=True):
        g=g[(g.minofday>=RTH_A)&(g.minofday<=RTH_B)]
        if len(g)<60: continue
        val,vah=g['p_val'].iloc[0]+va_shift, g['p_vah'].iloc[0]+va_shift
        po=g['rth_open'].iloc[0]
        if not np.isfinite(val) or not np.isfinite(vah) or vah<=val: continue
        if require_open_outside and (val<=po<=vah): continue
        c=g['c'].values; o=g['o'].values
        inside=(c>=val)&(c<=vah)
        outside_above=c>vah; outside_below=c<val
        seen_above=False; seen_below=False; run=0; ent=None; d=0
        for k in range(len(g)):
            if outside_above[k]: seen_above=True; run=0
            elif outside_below[k]: seen_below=True; run=0
            else:
                run+=1
                if run>=hold_min and (seen_above or seen_below):
                    # came back from ABOVE -> value is below us -> go SHORT to VAL
                    d = -1 if (seen_above and not seen_below) else (1 if (seen_below and not seen_above) else 0)
                    if d==0:                     # been both sides: use the more recent excursion
                        d = -1 if outside_above[:k].sum()>outside_below[:k].sum() else 1
                    ent=k; break
        if ent is None or ent>=len(g)-5: continue
        if long_only and d!=1: continue
        ep=o[ent+1] if ent+1<len(g) else c[ent]
        vaw=vah-val
        st = (val-stop_buf*vaw) if d==1 else (vah+stop_buf*vaw)
        tgt= vah if d==1 else val
        if (d==1 and (ep<=st or tgt<=ep)) or (d==-1 and (ep>=st or tgt>=ep)): continue
        rr=abs(tgt-ep)/abs(st-ep)
        if rr<min_rr: continue
        i=b.index.get_loc(g.index[ent])
        r=race(b,i,d,ep,st,tgt,max_hold,pv=pv,comm=comm)
        r.update(t=g.index[ent],d=d,rr=rr); out.append(r)
    return pd.DataFrame(out)

