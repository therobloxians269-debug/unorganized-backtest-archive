"""The genuine fund-grade candidate: a DOLLAR-NEUTRAL cross-sectional equity factor strategy
on the S&P 500. Cross-sectional strategies need breadth in NAMES (hundreds) -- which is why
XS-momentum died on 16-39 ETFs but can reach Sharpe ~1.0+ market-neutral on ~500 stocks.

Factors (all causal): 12-1 momentum, short-term (1-week) reversal, low realized vol.
Composite cross-sectional z-score -> dollar-neutral rank weights -> portfolio vol-target,
net of cost. Reports IS/OOS, beta/alpha vs SPY, and the gauntlet (PSR vs 1.0, DSR).

CAVEAT: uses CURRENT S&P 500 membership -> survivorship bias. For a long-SHORT neutral book
this is far milder than for long-only (it affects both legs), but it must be fixed with
point-in-time constituents before any fund pitch. Reported honestly.

    PYTHONPATH=. python3 research/xs_equity.py
"""
from __future__ import annotations

import numpy as np
import pandas as pd

from ope.validation import (
    deflated_sharpe_ratio,
    perf_stats,
    probabilistic_sharpe_ratio,
)

COST_BP, TGT, WIN, CAP, ANN = 3.0, 0.10, 63, 3.0, 252.0
IS_END, OOS_START = "2018-12-31", "2022-01-01"
FALLBACK = ("AAPL MSFT AMZN NVDA GOOGL META TSLA BRK-B JPM JNJ V PG XOM UNH HD MA KO PEP "
            "ABBV AVGO COST MRK WMT CVX LLY ADBE CRM ACN MCD NKE TMO ABT DHR LIN ORCL "
            "TXN NEE PM HON UNP QCOM LOW INTC IBM CAT GS AMGN BA SBUX MMM GE F BAC C WFC "
            "T VZ CMCSA DIS PFE CSCO INTU AMD NFLX PYPL").split()


def sp500_tickers():
    src = ("https://raw.githubusercontent.com/datasets/s-and-p-500-companies/"
           "main/data/constituents.csv")
    try:
        t = pd.read_csv(src)["Symbol"].astype(str).str.replace(".", "-", regex=False)
        return sorted(t.tolist())
    except Exception as e:
        print(f"(constituent fetch failed: {e}; using {len(FALLBACK)}-name fallback)")
        return FALLBACK


def zscore(df):
    return df.sub(df.mean(axis=1), axis=0).div(df.std(axis=1).replace(0, np.nan), axis=0)


def main():
    import yfinance as yf
    tk = sp500_tickers()
    px = yf.download(tk, start="2010-01-01", auto_adjust=True, progress=False)["Close"]
    px = px.dropna(how="all").dropna(axis=1, thresh=int(len(px) * 0.6))
    px = px[px.columns[px.iloc[-1].notna()]]
    rets = px.pct_change()
    n = px.shape[1]
    print(f"universe: {n} stocks | {px.index[0].date()} -> {px.index[-1].date()}\n")

    # causal cross-sectional factors (each a raw signal; higher = prefer long)
    factors = {
        "momentum": (px.shift(21) / px.shift(252) - 1.0),     # 12-1 momentum
        "reversal": -(px / px.shift(5) - 1.0),                # 1-week reversal
        "lowvol":   -(rets.rolling(63).std()),                # prefer low vol
    }
    factors["combo(mom+rev)"] = zscore(factors["momentum"]) + zscore(factors["reversal"])

    spy = yf.download("SPY", start="2010-01-01", auto_adjust=True, progress=False)["Close"]
    spy = spy.pct_change().squeeze()

    def run(raw, name):
        w = zscore(raw).shift(1)                              # lag 1 day
        w = w.sub(w.mean(axis=1), axis=0)                     # dollar-neutral
        w = w.div(w.abs().sum(axis=1).replace(0, np.nan), axis=0)
        g = (w * rets).sum(axis=1)
        scale = (TGT / (g.rolling(WIN).std() * np.sqrt(ANN))).shift(1).clip(0, CAP).fillna(0.0)
        w = w.mul(scale, axis=0)
        gross = (w * rets).sum(axis=1)
        turn = w.diff().abs().sum(axis=1)
        net = (gross - turn * COST_BP * 1e-4).dropna()
        gp, fp = perf_stats(gross.dropna()), perf_stats(net)
        oos = perf_stats(net[net.index >= OOS_START])
        sp = spy.reindex(net.index)
        bb = pd.concat([net, sp], axis=1).dropna()
        beta = bb.cov().iloc[0, 1] / bb.iloc[:, 1].var()
        psr1 = probabilistic_sharpe_ratio(net, 1.0 / np.sqrt(ANN))
        print(f"  {name:<14} GROSS Sh {gp['sharpe']:+.2f} | NET Sh {fp['sharpe']:+.2f} "
              f"(OOS {oos['sharpe']:+.2f}) ann {fp['ann_return']*100:+5.1f}% DD {fp['max_drawdown']*100:6.1f}% "
              f"turn {turn.mean()*ANN:3.0f}x beta {beta:+.2f} PSR>1 {psr1*100:4.1f}%")
        return net

    print("dollar-neutral, vol-targeted, net of 3bp:")
    for name, raw in factors.items():
        run(raw, name)


if __name__ == "__main__":
    main()

