from ladder import pred, QS

def events(day, rth, side='hi'):
    P=pred(M,day); di={d:i for i,d in enumerate(day.index)}
    rows=[]
    for d,b in rth.groupby('day'):
        if d not in di or len(b)<300: continue
        i=di[d]; o=day.at[d,'o930']; A=day.at[d,'ADR']
        H=b["high"].values; L=b["low"].values; C=b["close"].values; O=b["open"].values; T=b["tod"].values; n=len(b)
        runH=np.maximum.accumulate(H); runL=np.minimum.accumulate(L)
        sgn=1 if side=='hi' else -1
        px = H if side=='hi' else L
        run = runH if side=='hi' else runL
        newext = np.r_[True, (px[1:]>run[:-1]) if side=='hi' else (px[1:]<run[:-1])]
        idx=np.flatnonzero(newext)
        final = px.max() if side=='hi' else px.min()
        fanlv=[P[(side,q)][i] for q in QS]
        cnt=0; lastk=0
        for k in idx:
            cnt+=1
            trav = (run[k]-o)/A if side=='hi' else (o-run[k])/A
            # which calibrated fan band has been exceeded
            fq=0
            for q,lv in zip(QS,fanlv):
                if trav>=lv: fq=q*100
            opp = (o-runL[k])/A if side=='hi' else (runH[k]-o)/A
            rng5 = (H[max(0,k-5):k+1].max()-L[max(0,k-5):k+1].min())/A
            rng30= (H[max(0,k-30):k+1].max()-L[max(0,k-30):k+1].min())/A
            bar  = H[k]-L[k]
            wick = ((H[k]-max(O[k],C[k]))/bar) if bar>0 else 0.0
            if side=='lo': wick = ((min(O[k],C[k])-L[k])/bar) if bar>0 else 0.0
            rows.append(dict(day=d, k=k, tod=T[k],
                elapsed=(T[k]-570)/390.0, trav=trav, fanq=fq,
                fan_ratio=trav/max(fanlv[2],1e-6),          # vs the q60 level
                used=(runH[k]-runL[k])/A, opp=opp,
                since=(k-lastk)/390.0, cnt=cnt, wick=wick,
                v5=rng5, v30=rng30,
                is_ext=int(abs(px[k]-final)<1e-9)))
            lastk=k
    return pd.DataFrame(rows)

