    ap.add_argument("--gate", default="er", choices=["er", "drift", "both"])
    ap.add_argument("--er", type=float, default=0.55)
    ap.add_argument("--atr", type=float, default=2.0)
    ap.add_argument("--entries", type=int, default=3)
    a = ap.parse_args()

    S = load_sessions(a.window)
