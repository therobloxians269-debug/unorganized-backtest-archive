    # true day open = open of first bar of the day cycle
    df['TDO']=df.groupby('daycycle')['o'].transform('first')
    df['TSO']=df.groupby('sesskey')['o'].transform('first')
    # running day-cycle extremes (causal, inclusive of current bar)
    df['dhigh']=df.groupby('daycycle')['h'].cummax()
    df['dlow'] =df.groupby('daycycle')['l'].cummin()
    return df

# ------------- resample -------------
def rs(df,mins):
    a={'o':'first','h':'max','l':'min','c':'last',
       'es_high':'max','es_low':'min','es_close':'last',
       'ym_high':'max','ym_low':'min','ym_close':'last'}
    r=df.resample(f'{mins}min',label='left',closed='left').agg(a).dropna()
    return r

# ------------- SMT detection (causal) -------------
def smt_events(r,L=1,R=1,ref='either'):
    """Return list of (timestamp_known, dir) where dir=-1 bearish, +1 bullish.
       Known-at = close of the bar that sweeps the confirmed pivot."""
    h=r['h'].values; l=r['l'].values
    eh=r['es_high'].values; el=r['es_low'].values
    yh=r['ym_high'].values; yl=r['ym_low'].values
    n=len(r); ts=r.index
    # causal pivots: pivot at i confirmed at i+R
    piv_h=np.zeros(n,bool); piv_l=np.zeros(n,bool)
    for i in range(L,n-R):
        if h[i]==max(h[i-L:i+R+1]) and h[i]>h[i-1] and h[i]>h[i+R]: piv_h[i]=True
        if l[i]==min(l[i-L:i+R+1]) and l[i]<l[i-1] and l[i]<l[i+R]: piv_l[i]=True
    ev=[]
    last_ph=-1; last_pl=-1; used_ph=-1; used_pl=-1
    for j in range(n):
        # confirm pivots that became visible at j (pivot index j-R)
        k=j-R
        if k>=0 and piv_h[k]: last_ph=k
        if k>=0 and piv_l[k]: last_pl=k
        # bearish: NQ takes out pivot high, ES/YM does not
        if last_ph>=0 and last_ph!=used_ph and h[j]>h[last_ph] and j>last_ph:
            es_fail = eh[j]<=eh[last_ph]; ym_fail = yh[j]<=yh[last_ph]
            ok = {'either':es_fail or ym_fail,'es':es_fail,'ym':ym_fail,'both':es_fail and ym_fail}[ref]
            if ok: ev.append((ts[j],-1))
            used_ph=last_ph
        if last_pl>=0 and last_pl!=used_pl and l[j]<l[last_pl] and j>last_pl:
            es_fail = el[j]>=el[last_pl]; ym_fail = yl[j]>=yl[last_pl]
            ok = {'either':es_fail or ym_fail,'es':es_fail,'ym':ym_fail,'both':es_fail and ym_fail}[ref]
            if ok: ev.append((ts[j],1))
            used_pl=last_pl
    return ev

# ------------- CISD on 1m -------------
def cisd(df):
    """bear_lvl[i] = open of first bar of most recent completed up-close run (frozen)
       bull_lvl[i] = open of first bar of most recent completed down-close run"""
    o=df['o'].values; c=df['c'].values; n=len(df)
    bear=np.full(n,np.nan); bull=np.full(n,np.nan)
    cur_up=np.nan; cur_dn=np.nan; frozen_up=np.nan; frozen_dn=np.nan
    for i in range(n):
        if c[i]>o[i]:
            if np.isnan(cur_up): cur_up=o[i]
            if not np.isnan(cur_dn): frozen_dn=cur_dn; cur_dn=np.nan
        elif c[i]<o[i]:
            if np.isnan(cur_dn): cur_dn=o[i]
            if not np.isnan(cur_up): frozen_up=cur_up; cur_up=np.nan
        bear[i]=cur_up if not np.isnan(cur_up) else frozen_up   # start of most recent up-leg
        bull[i]=cur_dn if not np.isnan(cur_dn) else frozen_dn   # start of most recent down-leg
    df['cisd_bear']=bear; df['cisd_bull']=bull
    return df

