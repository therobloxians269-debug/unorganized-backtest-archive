"""Data loading + timeframe resampling for the Bman Studios reconstruction.

Samples (deliberately kept disjoint):
  A  NQ 1m  2022-12-26 .. 2023-12-31   (build / inspect)
  B  NQ 1m  2024-01-01 .. 2025-12-11   (validation)
  F  NQ 1m  2026-01-15 .. 2026-06-05   (FORWARD holdout - untouched until the end)
  ES NQ-equivalent slice for cross-market replication.
"""
import pandas as pd
import numpy as np

NQ_MAIN = "/Users/kaveh/qt_cascade/nq_v6.parquet"      # 2022-12-26 .. 2025-12-11
NQ_FWD = "/Users/kaveh/qt_cascade/mnq.parquet"          # 2026-01-15 .. 2026-06-05
ES_ALL = "/Users/kaveh/omni_x/es_front_2017_24h_1m.parquet"

# instrument economics (points -> dollars) and the retail cost floor
SPECS = {
    # micro contracts: what a small account actually trades
    "MNQ": dict(dollars_per_point=2.0, tick=0.25, commission_rt=1.24, slip_ticks_per_side=1.0),
    "MES": dict(dollars_per_point=5.0, tick=0.25, commission_rt=1.24, slip_ticks_per_side=1.0),
}


def cost_points(sym="MNQ"):
    """Round-turn cost expressed in index points."""
    s = SPECS[sym]
    comm_pts = s["commission_rt"] / s["dollars_per_point"]
    slip_pts = 2.0 * s["slip_ticks_per_side"] * s["tick"]
    return comm_pts + slip_pts


def _norm(df):
    df = df.rename(columns={"o": "open", "h": "high", "l": "low", "c": "close", "v": "volume"})
    df = df[["open", "high", "low", "close", "volume"]].copy()
    df = df[~df.index.duplicated(keep="first")].sort_index()
    return df


def load_nq_main():
    d = pd.read_parquet(NQ_MAIN, columns=["o", "h", "l", "c", "v"])
    d.index = pd.to_datetime(d.index)
    return _norm(d)


def load_nq_fwd():
    d = pd.read_parquet(NQ_FWD, columns=["o", "h", "l", "c", "v"])
    d.index = pd.to_datetime(d.index)
    return _norm(d)


def load_es(start="2022-12-26", end="2025-12-11"):
    d = pd.read_parquet(ES_ALL)
    d["ts"] = pd.to_datetime(d["ts_event"], utc=True).dt.tz_convert("America/New_York")
    d = d.set_index("ts")[["open", "high", "low", "close", "volume"]]
    d = d[~d.index.duplicated(keep="first")].sort_index()
    return d.loc[start:end]


def resample(df, minutes):
    """Resample 1m bars to `minutes`, anchored to the CME session (18:00 ET open)."""
    if minutes == 1:
        return df
    o = df.resample(f"{minutes}min", origin="start_day", label="left", closed="left").agg(
        {"open": "first", "high": "max", "low": "min", "close": "last", "volume": "sum"}
    )
    return o.dropna(subset=["open", "high", "low", "close"])


def session_of(index):
    """0=Asia(18:00-03:00 ET) 1=London(03:00-08:00) 2=NewYork(08:00-17:00)."""
    h = index.hour + index.minute / 60.0
    s = np.full(len(index), 2, dtype=np.int64)
    s[(h >= 18.0) | (h < 3.0)] = 0
    s[(h >= 3.0) & (h < 8.0)] = 1
    return s


SPLITS = {
    "A_2023": ("2022-12-26", "2023-12-31"),
    "B_2024_25": ("2024-01-01", "2025-12-11"),
}

