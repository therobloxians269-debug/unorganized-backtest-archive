"""
The two blocks.

BLOCK A — the PRINTED block. Once the IB breaks, the opposite IB edge is the day's
          extreme 72-86% of the time. That is not a forecast, it is a fact with a
          measured hit rate. It never moves.
BLOCK B — the UNPRINTED block. Forecast of how far the break-side extreme travels
          BEYOND the break level, fitted CONDITIONAL ON THE BREAK (the unconditional
          pre-open fan under-covers badly here - breaking the IB is itself evidence
          of a bigger day).

Both fitted on ES 2010-2017 only, never refit. Up-breaks and down-breaks are MIRRORED
into one model so the sign carries no information and n doubles.
"""
import numpy as np, pandas as pd
from sklearn.linear_model import QuantileRegressor

QS = [0.20, 0.40, 0.60, 0.80, 0.90, 0.95]

# features at the BREAK bar; every one known at the close of that bar
FEATS = ['f_ibr', 'f_tleft', 'f_ibpos', 'f_on_with', 'f_on_against',
         'f_gap_m', 'f_pdr', 'f_drive']


def prep(day):
    """Mirror up/down breaks into one direction-free frame."""
    d = day[day.brk.isin(['up', 'dn'])].copy()
    s = np.where(d.brk.values == 'up', 1.0, -1.0)
    A = d.ADR.values
    d['s'] = s
    d['brk_lvl'] = np.where(s > 0, d.ibh, d.ibl)          # the level that broke
    d['opp_lvl'] = np.where(s > 0, d.ibl, d.ibh)          # BLOCK A: the printed edge
    ext = np.where(s > 0, d.post_hi - d.brk_lvl, d.brk_lvl - d.post_lo)

    d['y_ext']        = ext / A                            # BLOCK B target variable
    d['f_ibr']        = d.ib_rng / A
    d['f_tleft']      = (RTHEND - d.brk_tod) / 330.0
    d['f_ibpos']      = s * (d.brk_lvl - d.o930) / A
    d['f_on_with']    = np.where(s > 0, d.onH - d.o930, d.o930 - d.onL) / A
    d['f_on_against'] = np.where(s > 0, d.o930 - d.onL, d.onH - d.o930) / A
    d['f_gap_m']      = s * d.f_gap
    d['f_pdr']        = d.prevRng / A
    d['f_drive']      = s * (d.brk_c - d.o930) / A
    return d.dropna(subset=FEATS + ['y_ext'])


RTHEND = 960


def fit(train, qs=QS, target='y_ext'):
    X = train[FEATS].values
    y = train[target].values
    return {q: QuantileRegressor(quantile=q, alpha=1e-4, solver='highs').fit(X, y)
            for q in qs}


def predict(M, d, floor=0.02):
    X = d[FEATS].values
    return {q: np.maximum(m.predict(X), floor) for q, m in M.items()}


def calibration(M, d, tag=''):
    """Fraction of unseen sessions whose realised extension fell SHORT of each band.
    A calibrated q should come out at q. This is the only claim that must hold OOS."""
    P = predict(M, d)
    y = d.y_ext.values
    cov = {q: float((y <= P[q]).mean()) for q in M}
    err = np.mean([abs(cov[q] - q) for q in M])
    print(f'  {tag:22s} n={len(d):5d}  ' +
          '  '.join(f'q{int(q*100)} {cov[q]:.3f}' for q in sorted(M)) +
          f'   |err| {err:.4f}')
    return cov, err

