"""
TERMINUS · metrics.

WHY STRATIFIED AUC IS THE ONLY HONEST NUMBER HERE
--------------------------------------------------
Survival probability rises with elapsed time (at 15:55 nearly every running extreme
survives). Predicted probability rises with elapsed time too. So if you pool every
checkpoint into one AUC you measure mostly "the clock", and a label placebo shuffled
within checkpoint STILL scores ~0.59 because the between-checkpoint structure is
untouched. Measured, not assumed: that is exactly what happened on the first run.

Stratifying by (checkpoint, side) removes it entirely. Inside a stratum every row is
a different day at the same time of day, so elapsed time is constant and carries zero
discriminating power by construction. Any lift above 0.50 is therefore pure
cross-sectional signal: "of the days that look like this at 11:00, which running lows
hold?" That is also precisely the question a trader asks at 11:00.

Gate metric  = n-weighted mean within-stratum AUC.
Null         = same metric under label permutation inside each stratum -> 0.500.
"""
import numpy as np, pandas as pd
from sklearn.metrics import roc_auc_score


def fast_auc(y, p):
    """Rank AUC. Returns nan for degenerate strata (all one class)."""
    y = np.asarray(y, dtype=np.int8)
    n1 = int(y.sum()); n0 = len(y) - n1
    if n1 == 0 or n0 == 0:
        return np.nan
    r = pd.Series(p).rank().values
    return (r[y == 1].sum() - n1 * (n1 + 1) / 2.0) / (n1 * n0)


def strat_auc(df, p, by=('t', 'side'), min_n=30):
    """n-weighted mean AUC within strata, plus the per-stratum table."""
    d = pd.DataFrame({'y': df.surv.values.astype(int), 'p': np.asarray(p)})
    for b in by:
        d[b] = df[b].values
    rows = []
    for key, g in d.groupby(list(by)):
        if len(g) < min_n:
            continue
        a = fast_auc(g.y.values, g.p.values)
        if np.isfinite(a):
            rows.append((key, len(g), a))
    tab = pd.DataFrame(rows, columns=['key', 'n', 'auc'])
    if not len(tab):
        return np.nan, tab
    return float((tab.auc * tab.n).sum() / tab.n.sum()), tab


def perm_null(df, p, by=('t', 'side'), n_perm=200, seed=7, min_n=30):
    """
    Null distribution of the stratified AUC under label permutation INSIDE each
    stratum. This destroys all cross-sectional signal while preserving the
    time-of-day structure, so a clean harness must centre on 0.500.
    """
    rng = np.random.default_rng(seed)
    d = pd.DataFrame({'y': df.surv.values.astype(int), 'p': np.asarray(p)})
    for b in by:
        d[b] = df[b].values
    groups = [(g.y.values, g.p.values) for _, g in d.groupby(list(by)) if len(g) >= min_n]
    ns = np.array([len(y) for y, _ in groups], dtype=float)
    out = np.empty(n_perm)
    for i in range(n_perm):
        a = np.array([fast_auc(rng.permutation(y), p_) for y, p_ in groups])
        m = np.isfinite(a)
        out[i] = (a[m] * ns[m]).sum() / ns[m].sum()
    return out


def report(name, df, p, n_perm=0, by=('t', 'side')):
    pooled = roc_auc_score(df.surv.values.astype(int), p)
    s, tab = strat_auc(df, p, by=by)
    line = (f'  {name:<14} n={len(df):>7,}  base={df.surv.mean():.3f}   '
            f'STRAT-AUC {s:.4f}   (pooled {pooled:.3f})')
    extra = {}
    if n_perm:
        nu = perm_null(df, p, by=by, n_perm=n_perm)
        z = (s - nu.mean()) / (nu.std() + 1e-12)
        line += f'   null {nu.mean():.4f}±{nu.std():.4f}  z={z:+.1f}'
        extra = dict(null_mu=float(nu.mean()), null_sd=float(nu.std()), z=float(z))
    print(line)
    return dict(name=name, n=len(df), base=float(df.surv.mean()),
                strat=s, pooled=float(pooled), **extra)

