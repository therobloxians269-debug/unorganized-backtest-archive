"""Diagnostics: is the maker scalper's P&L a REAL orderflow edge or a fill-model artifact?

The decisive test is signal inversion. If trading AGAINST the imbalance (sign=-1) also
makes money, then the P&L comes from the fill model magically earning the spread, not from
prediction. A real edge must be roughly antisymmetric: sign=+1 wins <=> sign=-1 loses.

    PYTHONPATH=. python3 -m research.ofmm.diag [YYYYMMDD]
"""
from __future__ import annotations

import sys
from dataclasses import replace

import numpy as np

from research.ofmm.tape import load_day, day_files
from research.ofmm.backtest import Params, run_day


def gross_by_kind(trades):
    out = {}
    for t in trades:
        k = t["exit"]
        g = out.setdefault(k, [0, 0.0, 0.0])
        g[0] += 1
        g[1] += t["gross"]
        g[2] += t["net"]
    return out


def line(tag, trades, summ):
    net = summ["net"]; gross = summ["gross"]; n = summ["n"]
    bk = gross_by_kind(trades)
    parts = " ".join(f"{k}:{v[0]}({v[1]/max(1,v[0]):+.2f}g)" for k, v in sorted(bk.items()))
    print(f"  {tag:<22} n={n:>4} net=${net:>8.2f} gross=${gross:>8.2f} "
          f"avg_gross={gross/max(1,n):+.3f} | {parts}")


def main():
    day = sys.argv[1] if len(sys.argv) > 1 else None
    files = day_files()
    path = next((f for f in files if day and day in f), files[-1])
    tp = load_day(path)
    base = Params()
    print(f"=== {tp.date} : is it signal or fill-artifact? ===")

    variants = [
        ("baseline (sign=+1)", base),
        ("INVERTED (sign=-1)", replace(base, sign=-1)),
        ("no-flip-exit", replace(base, flip_exit=False)),
        ("no-flip INVERTED", replace(base, flip_exit=False, sign=-1)),
        ("zero-commission", replace(base, comm_side=0.0)),
        ("theta=0 (no gate)", replace(base, theta=0.0, theta_hold=0.0)),
    ]
    for tag, pr in variants:
        trades, summ, _, stats = run_day(tp, pr)
        line(tag, trades, summ)
        print(f"      posts={stats['posts']} fills={stats['fills']} "
              f"fill_rate={stats['fills']/max(1,stats['posts'])*100:.1f}%")


if __name__ == "__main__":
    main()

