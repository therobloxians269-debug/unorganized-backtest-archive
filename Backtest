        # the SSMT fires AS the extreme prints, so the structural stop sits on top
        # of the entry. Enforce a real minimum: at least min_atr x ATR away.
        floor_d = min_atr * atr[i]
        r = max((struct - e) if side == "short" else (e - struct), floor_d)
        stop = e + r if side == "short" else e - r
        if not np.isfinite(r) or r <= 0 or r > e * cap_pct / 100:
            i += 1
