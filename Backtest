    for p in ("nq", "es", "ym"):
        out[f"cur_{p}_h"] = g[f"{p}_high"].cummax().to_numpy()
        out[f"cur_{p}_l"] = g[f"{p}_low"].cummin().to_numpy()
        qh = g[f"{p}_high"].max()
        ql = g[f"{p}_low"].min()
        out[f"prv_{p}_h"] = s.map(qh.shift(1)).to_numpy()
        out[f"prv_{p}_l"] = s.map(ql.shift(1)).to_numpy()
