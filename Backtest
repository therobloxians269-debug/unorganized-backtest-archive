"""
liquidity.py — where the stops are, and when they get taken.

ICT's core claim: price is engineered to reach *liquidity* — clusters of resting
orders (stops) sitting beyond obvious highs and lows. Old highs hold buy-side
liquidity (BSL); old lows hold sell-side liquidity (SSL). The algorithm reaches
for that liquidity (the "draw"), and the *raid* of a pool — a wick through it
that closes back — is the manipulation that precedes a genuine move.

This module builds the day's reference pools and detects the sweeps:

  Reference pools (each stamped with the bar it becomes known):
    PDH/PDL         prior session high/low
    ASIA_H/ASIA_L   Asian-range extremes (20:00–00:00 ET)
    LON_H/LON_L     London-killzone extremes (02:00–05:00 ET)
    EQH/EQL         equal highs/lows (engineered liquidity from twin swings)

  Sweep = a bar whose wick pierces a pool but whose *close* returns to the
    origin side. A sell-side sweep (raid of an old low, close back above) is a
    bullish ignition; a buy-side sweep (raid of an old high, close back below)
    is bearish. The pierced extreme is the natural stop reference.
"""
from __future__ import annotations

from dataclasses import dataclass
import numpy as np
import pandas as pd

from .structure import Swing


@dataclass
class Level:
    known_idx: int     # first bar at which the level is known
    price: float
    ltype: str         # PDH, PDL, ASIA_H, ...
    side: int          # +1 buy-side (above), -1 sell-side (below)


@dataclass
class Sweep:
    idx: int           # bar that performed the raid
    level: float
    ltype: str
    reversal_dir: int  # +1 bullish reversal expected, -1 bearish
    extreme: float     # wick extreme that took the liquidity (stop reference)


def _session_groups(session_dates: pd.Series):
    """Yield (session_date, positional indices) in chronological order."""
    codes = session_dates.to_numpy()
    order = []
    seen = {}
    for p, d in enumerate(codes):
        key = d
        if key not in seen:
            seen[key] = len(order)
            order.append([key, []])
        order[seen[key]][1].append(p)
    for key, positions in order:
        yield key, np.array(positions)


def reference_levels(df_ny: pd.DataFrame, session_dates: pd.Series) -> list[Level]:
    """Build PDH/PDL and Asian/London session pools, stamped causally."""
    high = df_ny["high"].to_numpy()
    low = df_ny["low"].to_numpy()
    hour = np.array([ts.hour for ts in df_ny.index])

    groups = list(_session_groups(session_dates))
    levels: list[Level] = []
    prev_hi = prev_lo = None
    for d, pos in groups:
        first = int(pos[0])
        # Prior-session high/low → today's PDH/PDL, known at this session's open.
        if prev_hi is not None:
            levels.append(Level(first, prev_hi, "PDH", +1))
            levels.append(Level(first, prev_lo, "PDL", -1))
        # Asian range (evening bars, hour >= 20), known once it completes.
        amask = pos[(hour[pos] >= 20)]
        if len(amask) > 0:
            known = int(amask[-1]) + 1
            if known < len(df_ny):
                levels.append(Level(known, float(high[amask].max()), "ASIA_H", +1))
                levels.append(Level(known, float(low[amask].min()), "ASIA_L", -1))
        # London killzone (02:00–05:00), known once it completes.
        lmask = pos[(hour[pos] >= 2) & (hour[pos] < 5)]
        if len(lmask) > 0:
            known = int(lmask[-1]) + 1
            if known < len(df_ny):
                levels.append(Level(known, float(high[lmask].max()), "LON_H", +1))
                levels.append(Level(known, float(low[lmask].min()), "LON_L", -1))
        prev_hi = float(high[pos].max())
        prev_lo = float(low[pos].min())
    return levels


def equal_highs_lows(swings: list[Swing], tol: float) -> list[Level]:
    """Twin swing highs/lows within `tol` = engineered liquidity (EQH/EQL).

    The pool is known once the *second* matching pivot confirms.
    """
    out: list[Level] = []
    highs = [s for s in swings if s.kind == "H"]
    lows = [s for s in swings if s.kind == "L"]
    for arr, ltype, side in ((highs, "EQH", +1), (lows, "EQL", -1)):
        for a, b in zip(arr, arr[1:]):
            if abs(a.price - b.price) <= tol:
                price = (a.price + b.price) / 2.0
                out.append(Level(b.confirm_idx, price, ltype, side))
    return out


def find_sweeps(df: pd.DataFrame, levels: list[Level], expiry_bars: int = 480,
                tol: float = 0.0) -> list[Sweep]:
    """Detect the first raid of each pool within `expiry_bars` of it becoming known."""
    high = df["high"].to_numpy()
    low = df["low"].to_numpy()
    close = df["close"].to_numpy()
    n = len(df)
    sweeps: list[Sweep] = []
    for lv in levels:
        stop = min(n, lv.known_idx + expiry_bars)
        for t in range(lv.known_idx, stop):
            if lv.side > 0:  # buy-side pool (old high): raid = wick above, close below
                if high[t] > lv.price + tol and close[t] < lv.price:
                    sweeps.append(Sweep(t, lv.price, lv.ltype, -1, float(high[t])))
                    break
            else:            # sell-side pool (old low): raid = wick below, close above
                if low[t] < lv.price - tol and close[t] > lv.price:
                    sweeps.append(Sweep(t, lv.price, lv.ltype, +1, float(low[t])))
                    break
    sweeps.sort(key=lambda s: s.idx)
    return sweeps

