"""BlackArbs / opening-range claim: by 10:30 one of the day's two extremes is usually already in.
Measure on ES 2010-2026 and NQ. Then: when the OR breaks one way, is the OTHER side the day's
extreme, and is that tradeable?"""
import numpy as np, pandas as pd, pickle, warnings; warnings.filterwarnings('ignore')
SCR='/private/tmp/claude-501/-Users-kaveh/d5ce5738-dd59-4ca2-bd9c-e9b02fe3107c/scratchpad'
esday,esrth,nqday,nqrth=pickle.load(open(f'{SCR}/ladder_feats.pkl','rb'))

def measure(day, rth, IB=60, tag=''):
    rows=[]
    for d,b in rth.groupby('day'):
        if len(b)<300: continue
        H=b['high'].values; L=b['low'].values; T=b['tod'].values
        ib=T<570+IB
        if ib.sum()<IB*0.8: continue
        ibh=H[ib].max(); ibl=L[ib].min()
        sh=H.max(); sl=L.min()
        hi_in_ib = abs(sh-ibh)<1e-9
        lo_in_ib = abs(sl-ibl)<1e-9
        post=~ib
        up=np.flatnonzero(post&(H>=ibh)); dn=np.flatnonzero(post&(L<=ibl))
        iu=up[0] if len(up) else 10**9; idn=dn[0] if len(dn) else 10**9
        brk = 'up' if iu<idn else ('dn' if idn<iu else 'none')
        rows.append(dict(day=d,hi_in_ib=hi_in_ib,lo_in_ib=lo_in_ib,
                         either=hi_in_ib or lo_in_ib, both=hi_in_ib and lo_in_ib,
                         brk=brk, ibh=ibh, ibl=ibl, sh=sh, sl=sl,
                         ib_rng=ibh-ibl, day_rng=sh-sl))
    R=pd.DataFrame(rows)
    print(f'=== {tag}  n={len(R)} sessions · IB = first {IB} min ===')
    print(f'  P(day HIGH is the IB high)        {R.hi_in_ib.mean()*100:5.1f}%')
    print(f'  P(day LOW  is the IB low)         {R.lo_in_ib.mean()*100:5.1f}%')
    print(f'  P(EITHER extreme set in the IB)   {R.either.mean()*100:5.1f}%   <- BlackArbs claim ~75%')
    print(f'  P(BOTH — inside day)              {R.both.mean()*100:5.1f}%')
    print(f'  breakout direction: up {(R.brk=="up").mean()*100:.0f}%  dn {(R.brk=="dn").mean()*100:.0f}%  none {(R.brk=="none").mean()*100:.0f}%')
    u=R[R.brk=='up']; dn=R[R.brk=='dn']
    print(f'  GIVEN break UP  -> IB low IS the day low : {u.lo_in_ib.mean()*100:5.1f}%  (n={len(u)})')
    print(f'  GIVEN break DOWN-> IB high IS the day high: {dn.hi_in_ib.mean()*100:5.1f}%  (n={len(dn)})')
    print(f'  ...and excluding inside days, "opposite side holds" = '
          f'{pd.concat([u.lo_in_ib,dn.hi_in_ib]).mean()*100:5.1f}%')
    print(f'  median IB range {R.ib_rng.median():.1f}  vs day range {R.day_rng.median():.1f} '
          f'({R.ib_rng.median()/R.day_rng.median()*100:.0f}% of the day)')
    print()
    return R

for D,RT,tag in [(esday,esrth,'ES 2010-2026'),(nqday,nqrth,'NQ 2023-2025')]:
    for IB in [30,60]:
        measure(D,RT,IB,f'{tag}')

