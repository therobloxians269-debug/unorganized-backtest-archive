#!/usr/bin/env python3
"""Faithful, look-ahead-free backtest of the two ICT modules on 24h front-month ES.
Silver Bullet (sweep->MSS->FVG->limit) and Midnight Fade (RSI reset -> EMA reclaim).
Splits by regime: pre-2020 / 2020-21 / 2022+ and per-year. Net of MES friction."""
import math, sys
import numpy as np, pandas as pd
from zoneinfo import ZoneInfo

ET = ZoneInfo("America/New_York")
FRIC = 0.75          # MES round-trip friction (pts)
DPP = 5.0            # $/pt MES
TICK = 0.25

def rma(s, n):
    return s.ewm(alpha=1.0/n, adjust=False).mean()

def load_front():
    o = pd.read_parquet("/Users/kaveh/overnight_premium_engine/data/es_outright_1m.parquet",
                        columns=["ts_event","symbol","open","high","low","close","volume"])
    t = pd.DatetimeIndex(o["ts_event"])
    t = t.tz_convert(ET) if t.tz is not None else t.tz_localize("UTC").tz_convert(ET)
    o["et"] = t
    o["date"] = t.date
    o["sod"] = t.hour*3600 + t.minute*60
    # front map per ET date from the RTH file
    r = pd.read_parquet("/Users/kaveh/mim_research/es_front_rth_1m.parquet", columns=["date","front"])
    r["date"] = pd.to_datetime(r["date"]).dt.date
    fm = r.groupby("date")["front"].agg(lambda s: s.value_counts().index[0]).to_dict()
    o["front"] = o["date"].map(fm)
    o = o[o["symbol"] == o["front"]].copy()
    o = o.sort_values("et").reset_index(drop=True)
    # continuous 1-min indicators (match Pine ta.* which are continuous)
    prevc = o["close"].shift(1)
    tr = np.maximum(o["high"]-o["low"], np.maximum((o["high"]-prevc).abs(), (o["low"]-prevc).abs()))
    o["atr1"] = rma(tr, 14)
    o["ema9"] = o["close"].ewm(span=9, adjust=False).mean()
    o["xup"]  = (o["close"] > o["ema9"]) & (o["close"].shift(1) <= o["ema9"].shift(1))
    o["xdn"]  = (o["close"] < o["ema9"]) & (o["close"].shift(1) >= o["ema9"].shift(1))
    return o, fm

def add_5m(o):
    """5m RSI/ATR mapped to each 1m bar via the last 5m bar that CLOSED at/before it (no look-ahead)."""
    g = o.set_index("et")
    b5 = pd.DataFrame({
        "open": g["open"].resample("5min").first(), "high": g["high"].resample("5min").max(),
        "low": g["low"].resample("5min").min(),   "close": g["close"].resample("5min").last()}).dropna()
    d = b5["close"].diff()
    ag = rma(d.clip(lower=0), 14); al = rma((-d).clip(upper=0), 14)
    b5["rsi5"] = 100 - 100/(1 + ag/al.replace(0, np.nan))
    pc = b5["close"].shift(1)
    tr5 = np.maximum(b5["high"]-b5["low"], np.maximum((b5["high"]-pc).abs(), (b5["low"]-pc).abs()))
    b5["atr5"] = rma(tr5, 14)
    b5["close_time"] = b5.index + pd.Timedelta("5min")           # value available at bar close
    m = pd.merge_asof(o[["et"]].sort_values("et"), b5[["close_time","rsi5","atr5"]].sort_values("close_time"),
                      left_on="et", right_on="close_time", direction="backward")
    o["rsi5"] = m["rsi5"].to_numpy(); o["atr5"] = m["atr5"].to_numpy()
    return o

def add_bias(o, tf="60min", length=50):
    g = o.set_index("et")
    bh = g["close"].resample(tf).last().dropna().to_frame("c")
    bh["ema"] = bh["c"].ewm(span=length, adjust=False).mean()
    bh["close_time"] = bh.index + pd.Timedelta(tf)
    m = pd.merge_asof(o[["et"]].sort_values("et"), bh[["close_time","ema"]].sort_values("close_time"),
                      left_on="et", right_on="close_time", direction="backward")
    e = m["ema"].to_numpy()
    o["bias"] = np.where(o["close"].to_numpy() > e, 1, np.where(o["close"].to_numpy() < e, -1, 0))
    return o

def sb_backtest(o, use_bias):
    out = []
    for d, g in o.groupby("date", sort=True):
        g = g.reset_index(drop=True)
        sod = g["sod"].to_numpy(); O=g["open"].to_numpy(); H=g["high"].to_numpy()
        L=g["low"].to_numpy(); C=g["close"].to_numpy(); A=g["atr1"].to_numpy(); B=g["bias"].to_numpy()
        liq = (sod>=7200)&(sod<34200)                     # 02:00-09:30
        if liq.sum() < 30: continue
        sH = H[liq].max(); sL = L[liq].min()
        win = np.flatnonzero((sod>=36000)&(sod<39600))    # 10:00-11:00
        if win.size < 5: continue
        swept=False; sdir=0; structHi=structLo=np.nan; dispLo=np.inf; dispHi=-np.inf
        mss=False; i0=win[0]
        entry=stop=tp=np.nan; ordered=False; wait=0; fillbar=-1; res=None
        i=i0
        n=len(g)
        while i < n and sod[i] < 39600+3600:               # allow setup to resolve past 11:00
            if not swept:
                if L[i] < sL and (not use_bias or B[i] >= 0):
                    swept=True; sdir=1; structHi=H[max(0,i-5):i].max() if i>=1 else np.nan; dispLo=L[i]
                elif H[i] > sH and (not use_bias or B[i] <= 0):
                    swept=True; sdir=-1; structLo=L[max(0,i-5):i].min() if i>=1 else np.nan; dispHi=H[i]
            elif not mss:
                if sdir==1:
                    dispLo=min(dispLo,L[i])
                    if C[i] > structHi and (C[i]-O[i]) >= 1.5*A[i]: mss=True
                else:
                    dispHi=max(dispHi,H[i])
                    if C[i] < structLo and (O[i]-C[i]) >= 1.5*A[i]: mss=True
            elif not ordered:
                if sdir==1 and i>=2 and L[i] > H[i-2] and (L[i]-H[i-2]) > 0.25*A[i]:
                    entry=L[i]; stop=dispLo-2*TICK; tp=entry+2*(entry-stop); ordered=True; wait=0; obar=i
                elif sdir==-1 and i>=2 and H[i] < L[i-2] and (L[i-2]-H[i]) > 0.25*A[i]:
                    entry=H[i]; stop=dispHi+2*TICK; tp=entry-2*(stop-entry); ordered=True; wait=0; obar=i
            else:
                if fillbar<0:                                # awaiting fill (from NEXT bar; no same-bar)
                    if i>obar:
                        wait+=1
                        if (sdir==1 and L[i]<=entry) or (sdir==-1 and H[i]>=entry): fillbar=i
                        elif wait>5: res=("cancel",0.0); break
                else:                                        # manage
                    hitS = L[i]<=stop if sdir==1 else H[i]>=stop
                    hitT = H[i]>=tp if sdir==1 else L[i]<=tp
                    if hitS: res=("sl", -abs(entry-stop)-FRIC); break
                    if hitT: res=("tp",  abs(tp-entry)-FRIC); break
                    if sod[i] >= (15*3600+45*60):
                        res=("flat", sdir*(C[i]-entry)-FRIC); break
            i+=1
        if fillbar>=0 and res is None:
            res=("flat", sdir*(C[min(i,n-1)]-entry)-FRIC)
        if res is not None and res[0] != "cancel":
            out.append((d, res[1], res[0]))
    return pd.DataFrame(out, columns=["date","pts","kind"])

def mof_backtest(o):
    out=[]
    for d,g in o.groupby("date", sort=True):
        g=g.reset_index(drop=True)
        sod=g["sod"].to_numpy(); O=g["open"].to_numpy(); H=g["high"].to_numpy(); L=g["low"].to_numpy()
        C=g["close"].to_numpy(); R=g["rsi5"].to_numpy(); A5=g["atr5"].to_numpy()
        xup=g["xup"].to_numpy(); xdn=g["xdn"].to_numpy()
        m0=np.flatnonzero(sod==0)
        if m0.size==0: continue
        mid=O[m0[0]]
        armL=armS=False; pos=0; entry=stop=np.nan; nT=0; n=len(g)
        for i in range(n):
            if pos!=0:
                hitS = L[i]<=stop if pos>0 else H[i]>=stop
                hitT = H[i]>=mid if pos>0 else L[i]<=mid
                if hitS: out.append((d,-abs(entry-stop)-FRIC,"sl")); pos=0; continue
                if hitT: out.append((d, abs(mid-entry)-FRIC,"tp")); pos=0; continue
                if sod[i]>=(15*3600+45*60): out.append((d, pos*(C[i]-entry)-FRIC,"flat")); pos=0; continue
            inwin = (sod[i]>=30600)&(sod[i]<41400)          # 08:30-11:30
            if not inwin: continue
            disc = C[i]<mid; prem=C[i]>mid
            if disc and not np.isnan(R[i]) and R[i]<30: armL=True
            if prem and not np.isnan(R[i]) and R[i]>70: armS=True
            if pos==0 and nT<2:
                if armL and disc and xup[i] and not np.isnan(A5[i]):
                    pos=1; entry=C[i]; stop=C[i]-1.5*A5[i]; armL=False; nT+=1
                elif armS and prem and xdn[i] and not np.isnan(A5[i]):
                    pos=-1; entry=C[i]; stop=C[i]+1.5*A5[i]; armS=False; nT+=1
    return pd.DataFrame(out, columns=["date","pts","kind"])

def report(tr, name):
    if len(tr)==0:
        print(f"\n{name}: no trades"); return
    tr=tr.copy(); tr["yr"]=pd.to_datetime(tr["date"]).dt.year
    def line(lbl, d):
        if len(d)<5: return f"{lbl:16s} n={len(d):5d}  (too few)"
        pt=d["pts"]; hit=(pt>0).mean()
        return (f"{lbl:16s} n={len(d):5d}  net_pt={pt.mean():+.3f}  tot={pt.sum():+8.1f}  "
                f"$${pt.sum()*DPP:>9.0f}  hit={hit:.3f}  ann$={pt.sum()/ (len(d)/252) *DPP:>7.0f}")
    print(f"\n===== {name} ({len(tr)} trades) — friction {FRIC}pt =====")
    print(line("ALL", tr))
    print(line("pre-2020", tr[tr.yr<2020]))
    print(line("2020-2021", tr[(tr.yr>=2020)&(tr.yr<=2021)]))
    print(line("2022+", tr[tr.yr>=2022]))
    print("  per-year:")
    for y,d in tr.groupby("yr"):
        pt=d["pts"]
        print(f"    {y}: n={len(d):4d} net_pt={pt.mean():+.3f} tot={pt.sum():+7.1f} ${pt.sum()*DPP:>8.0f} hit={(pt>0).mean():.3f}")
    print("  exit mix:", tr["kind"].value_counts().to_dict())

def main():
    o,fm = load_front()
    print(f"front-month 24h bars: {len(o):,}  dates {o['date'].min()}..{o['date'].max()}")
    print(f"has 00:00 bars: {(o['sod']==0).sum()}   02:00 bars: {(o['sod']==7200).sum()}")
    o = add_5m(o)
    o = add_bias(o)
    sb_nb = sb_backtest(o, use_bias=False)
    sb_b  = sb_backtest(o, use_bias=True)
    mof   = mof_backtest(o)
    report(sb_nb, "SILVER BULLET (bias OFF)")
    report(sb_b,  "SILVER BULLET (HTF-EMA bias ON)")
    report(mof,   "MIDNIGHT FADE")

if __name__=="__main__":
    main()

