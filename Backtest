#!/usr/bin/env python3
"""
recon_reversal_freetest.py
==========================

A $0, falsification-first test of the closing-auction dislocation-reversion
hypothesis, run on the cleanest natural experiment available for free:
INDEX RECONSTITUTION effective dates, where the *direction* of forced flow is
public knowledge.

THE HYPOTHESIS UNDER TEST
-------------------------
Passive index funds must trade at the official close to minimise tracking
error. On a reconstitution effective date this forced flow is one-sided and
known:
    * ADDITION  -> forced BUYING  -> close pushed RICH -> should revert DOWN
    * DELETION  -> forced SELLING -> close pushed CHEAP -> should revert UP
If the dislocation-reversion mechanism is real and capturable, a strategy that
trades AGAINST the forced flow at the effective-date close and exits into the
next session should earn a positive, market-adjusted return that survives cost.

WHY THIS IS THE RIGHT PRE-TEST (and why it comes BEFORE spending Databento $)
----------------------------------------------------------------------------
1. Direction is free & known: no imbalance feed required to know which way the
   forced flow points on a recon effective date.
2. It isolates the auction dislocation from the announcement-to-effective
   "index effect" drift (mostly decayed): we ENTER at the effective-date CLOSE,
   strictly AFTER any announcement drift, and exit into the next open / next
   few closes.
3. It is a clean FILTER: if the *largest, cleanest, known-direction* forced
   flow in US equities shows no overnight reversion net of cost, the general
   imbalance-magnitude signal won't rescue the marginal case -> do NOT spend
   the $10. If it DOES show reversion, the Databento pull is well-spent to
   generalise to all large caps on all structural days (the breadth the handful
   of recon days cannot provide on its own).

NO-LOOK-AHEAD GUARANTEES
------------------------
* The SIGNAL (which side to trade) is the add/delete flag, known at announcement
  (strictly before the effective date). No peeking.
* ENTRY uses close(t); EXIT uses open(t+1) and/or close(t+1..t+k) -- all strictly
  after entry, located by TRADING-DAY position in each name's own price index
  (handles weekends/holidays; never calendar arithmetic).
* Market adjustment uses the market's return over the *same* dates.

WHAT THIS DOES NOT DO
---------------------
It does not pull data. Wire your own OHLC (CSV/parquet primary; optional
yfinance fallback for local use). It does not pretend a ~20-40 event/year study
has the power of a daily strategy -- it reports the event count and a
cluster-robust (per-recon-date) view, and the verdict abstains rather than
false-killing when N is too small.

USAGE
-----
    # Prove the tool is correct (runs anywhere, no data needed):
    python recon_reversal_freetest.py --selftest

    # Real run once you've wired data:
    python recon_reversal_freetest.py \
        --events events.csv \
        --prices ./prices_csv_dir   (or prices_long.parquet) \
        --market SPY.csv

EVENTS FILE CONTRACT  (events.csv)
----------------------------------
    ticker,effective_date,action,index
    SMCI,2024-03-18,add,sp500
    WHR,2024-03-18,delete,sp500
  * effective_date = the date the change takes effect (close of the PRIOR
    trading day is the auction that prints the forced flow; in S&P practice the
    name is in the index "effective prior to the open" of effective_date, so the
    forced auction is the close of the trading day BEFORE effective_date).
    --entry-on {eff_prev_close, eff_close} lets you test both conventions; the
    default (eff_prev_close) matches the mechanics and is the honest one.
  * action in {add, delete}; index is free-text (sp500, r1000, r2000, ...).

PRICES CONTRACT
---------------
  * Directory mode: one CSV per ticker named TICKER.csv with columns
    date,open,high,low,close[,adj_close]. Or
  * Long mode: a single CSV/parquet with columns
    ticker,date,open,high,low,close[,adj_close].
  Returns are computed from RAW open/close (correct for a single overnight
  return). If adj_close is present, events spanning a split/ex-div boundary
  (detected via a jump in adj_close/close) are dropped and logged.
"""

from __future__ import annotations

import argparse
import sys
from dataclasses import dataclass, field
from pathlib import Path

import numpy as np
import pandas as pd
from scipy import stats


# --------------------------------------------------------------------------- #
# Configuration & pre-registered kill conditions
# --------------------------------------------------------------------------- #
@dataclass
class Config:
    # Exit horizons in trading days after entry (1 = next open is also reported)
    horizons: tuple[int, ...] = (1, 2, 3, 5)
    # Round-trip cost grid in bps for the sweep
    cost_grid_bps: tuple[float, ...] = (0, 2, 5, 10, 15, 20, 30)
    # Cost at which the edge must still be significant to be "retail-viable"
    cost_hurdle_bps: float = 10.0
    # Beta for market adjustment: 1.0 = market-adjusted (conservative default)
    beta_mode: str = "unit"        # {"unit", "estimate"}
    beta_window: int = 60          # daily-return window for --estimate-beta
    beta_gap: int = 10             # skip last N days before event to avoid drift
    # Bootstrap
    n_boot: int = 10_000
    seed: int = 7
    # ---- PRE-REGISTERED KILL CONDITIONS (locked before looking at real output)
    kill_min_events: int = 30      # below this -> ABSTAIN (insufficient power)
    kill_alpha: float = 0.05       # one-sided p for "reversion is positive"
    # Verdict requires: (a) zero-cost market-adj mean > 0 at p<alpha,
    #                   (b) survives cost_hurdle at p<alpha,
    #                   (c) raw->market-adj does not collapse (not just beta),
    #                   (d) N >= kill_min_events.


# --------------------------------------------------------------------------- #
# Data loading
# --------------------------------------------------------------------------- #
def load_events(path: str) -> pd.DataFrame:
    ev = pd.read_csv(path)
    ev.columns = [c.strip().lower() for c in ev.columns]
    need = {"ticker", "effective_date", "action"}
    if not need.issubset(ev.columns):
        raise ValueError(f"events file must have columns {need}; got {set(ev.columns)}")
    ev["ticker"] = ev["ticker"].str.strip().str.upper()
    ev["action"] = ev["action"].str.strip().str.lower()
    bad = ~ev["action"].isin(["add", "delete"])
    if bad.any():
        raise ValueError(f"action must be add/delete; bad rows:\n{ev[bad]}")
    ev["effective_date"] = pd.to_datetime(ev["effective_date"]).dt.normalize()
    if "index" not in ev.columns:
        ev["index"] = "unknown"
    # flow_sign: +1 = buy pressure (add), -1 = sell pressure (delete).
    # We trade AGAINST flow, so position = -flow_sign.
    ev["flow_sign"] = np.where(ev["action"] == "add", 1.0, -1.0)
    return ev.reset_index(drop=True)


def _normalise_price_df(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()
    df.columns = [c.strip().lower() for c in df.columns]
    if "date" not in df.columns:
        raise ValueError("price data needs a 'date' column")
    df["date"] = pd.to_datetime(df["date"]).dt.normalize()
    for col in ("open", "close"):
        if col not in df.columns:
            raise ValueError(f"price data needs an '{col}' column")
    df = df.sort_values("date").drop_duplicates("date").reset_index(drop=True)
    return df


def load_prices(path: str) -> dict[str, pd.DataFrame]:
    """Return {ticker -> price df sorted by date}."""
    p = Path(path)
    out: dict[str, pd.DataFrame] = {}
    if p.is_dir():
        for f in sorted(p.glob("*.csv")):
            out[f.stem.upper()] = _normalise_price_df(pd.read_csv(f))
    elif p.suffix.lower() in (".parquet", ".pq"):
        long = pd.read_parquet(p)
        long.columns = [c.strip().lower() for c in long.columns]
        for tk, g in long.groupby(long["ticker"].str.upper()):
            out[tk] = _normalise_price_df(g.drop(columns=["ticker"]))
    else:  # single long CSV
        long = pd.read_csv(p)
        long.columns = [c.strip().lower() for c in long.columns]
        for tk, g in long.groupby(long["ticker"].str.upper()):
            out[tk] = _normalise_price_df(g.drop(columns=["ticker"]))
    if not out:
        raise ValueError(f"no price series loaded from {path}")
    return out


def load_market(path: str) -> pd.DataFrame:
    return _normalise_price_df(pd.read_csv(path))


def try_yfinance(tickers: list[str], start: str, end: str
                 ) -> tuple[dict[str, pd.DataFrame], pd.DataFrame | None]:
    """Optional convenience loader for LOCAL use (needs network + yfinance)."""
    import yfinance as yf  # noqa: imported lazily on purpose
    raw = yf.download(tickers + ["SPY"], start=start, end=end,
                      auto_adjust=False, progress=False, group_by="ticker")
    prices: dict[str, pd.DataFrame] = {}
    for tk in tickers + ["SPY"]:
        try:
            sub = raw[tk][["Open", "High", "Low", "Close", "Adj Close"]].dropna()
        except Exception:
            continue
        sub = sub.rename(columns=str.lower).rename(columns={"adj close": "adj_close"})
        sub = sub.reset_index().rename(columns={"Date": "date"})
        prices[tk.upper()] = _normalise_price_df(sub)
    market = prices.pop("SPY", None)
    return prices, market


# --------------------------------------------------------------------------- #
# Event panel construction (the no-look-ahead core)
# --------------------------------------------------------------------------- #
def _pos_of_date_on_or_before(idx: pd.DatetimeIndex, d: pd.Timestamp) -> int | None:
    """Integer position of the last trading day <= d, or None."""
    loc = idx.searchsorted(d, side="right") - 1
    return int(loc) if loc >= 0 else None


def _split_div_safe(df: pd.DataFrame, i0: int, i1: int) -> bool:
    """True if no split/ex-div boundary between positions i0 and i1 (inclusive)."""
    if "adj_close" not in df.columns:
        return True  # cannot check; assume clean (document this)
    ratio = (df["adj_close"] / df["close"]).to_numpy()
    seg = ratio[i0:i1 + 1]
    if np.any(~np.isfinite(seg)) or np.nanmin(seg) <= 0:
        return False
    # a split/large dividend shows up as a step change in the adj/raw ratio
    rel = seg / seg[0]
    return bool(np.nanmax(np.abs(rel - 1.0)) < 0.01)


def build_panel(events: pd.DataFrame,
                prices: dict[str, pd.DataFrame],
                market: pd.DataFrame,
                cfg: Config,
                entry_on: str = "eff_prev_close") -> tuple[pd.DataFrame, dict]:
    """
    For each event compute signed, market-adjusted reversion returns at each
    horizon. Returns (panel, drop_log).

    entry_on:
      'eff_prev_close' -> entry = close of the last trading day strictly BEFORE
                          effective_date (the auction that prints the forced
                          flow; matches index mechanics). DEFAULT.
      'eff_close'      -> entry = close ON effective_date (alternative convention).
    """
    mkt = market.set_index("date")
    mkt_open = mkt["open"].to_numpy()
    mkt_close = mkt["close"].to_numpy()
    mkt_idx = mkt.index

    rows = []
    drops: dict[str, int] = {}

    def drop(reason: str):
        drops[reason] = drops.get(reason, 0) + 1

    for _, ev in events.iterrows():
        tk = ev["ticker"]
        df = prices.get(tk)
        if df is None or len(df) < cfg.beta_window + max(cfg.horizons) + 5:
            drop("no_or_short_price_series")
            continue
        idx = pd.DatetimeIndex(df["date"])

        anchor = _pos_of_date_on_or_before(idx, ev["effective_date"])
        if anchor is None:
            drop("effective_date_before_series")
            continue

        # Entry position
        if entry_on == "eff_prev_close":
            # last trading day strictly before effective_date
            ipos = idx.searchsorted(ev["effective_date"], side="left") - 1
        else:  # eff_close
            ipos = _pos_of_date_on_or_before(idx, ev["effective_date"])
        if ipos is None or ipos < cfg.beta_window:
            drop("entry_too_early_in_series")
            continue
        if ipos + max(cfg.horizons) >= len(df):
            drop("not_enough_future_bars")
            continue

        o = df["open"].to_numpy()
        c = df["close"].to_numpy()
        entry_close = c[ipos]
        if not np.isfinite(entry_close) or entry_close <= 0:
            drop("bad_entry_price")
            continue

        entry_date = idx[ipos]
        # Beta for market adjustment
        if cfg.beta_mode == "estimate":
            j_end = ipos - cfg.beta_gap
            j_beg = j_end - cfg.beta_window
            if j_beg < 1:
                drop("beta_window_unavailable")
                continue
            stk_ret = c[j_beg + 1:j_end + 1] / c[j_beg:j_end] - 1.0
            # align market on same dates
            m_pos = mkt_idx.searchsorted(idx[j_beg:j_end + 1])
            if m_pos.max() >= len(mkt_idx):
                drop("market_window_unavailable")
                continue
            m_close_w = mkt_close[m_pos]
            m_ret = m_close_w[1:] / m_close_w[:-1] - 1.0
            if len(m_ret) != len(stk_ret) or np.std(m_ret) == 0:
                drop("beta_regression_degenerate")
                continue
            beta = float(np.cov(stk_ret, m_ret)[0, 1] / np.var(m_ret))
            beta = float(np.clip(beta, -1.0, 3.0))
        else:
            beta = 1.0

        rec = {
            "ticker": tk, "action": ev["action"], "index": ev["index"],
            "effective_date": ev["effective_date"], "entry_date": entry_date,
            "flow_sign": ev["flow_sign"], "beta": beta,
        }

        # ---- Overnight (close -> next open) ----
        nxt_open = o[ipos + 1]
        if not np.isfinite(nxt_open) or nxt_open <= 0:
            drop("bad_next_open")
            continue
        if not _split_div_safe(df, ipos, ipos + 1):
            drop("split_or_exdiv_boundary")
            continue
        r_on = nxt_open / entry_close - 1.0
        # market overnight on the same boundary
        me = mkt_idx.searchsorted(entry_date)
        if me + 1 >= len(mkt_idx) or mkt_idx[me] != entry_date:
            # market must have the same entry date
            drop("market_missing_entry_date")
            continue
        m_on = mkt_open[me + 1] / mkt_close[me] - 1.0
        ab_on = r_on - beta * m_on
        # strat return = trade AGAINST flow: position = -flow_sign
        rec["strat_overnight_raw"] = -ev["flow_sign"] * r_on
        rec["strat_overnight_adj"] = -ev["flow_sign"] * ab_on
        rec["mkt_overnight"] = m_on

        # ---- Multi-day (close -> close+k) ----
        ok = True
        for h in cfg.horizons:
            if not _split_div_safe(df, ipos, ipos + h):
                rec[f"strat_cc{h}_raw"] = np.nan
                rec[f"strat_cc{h}_adj"] = np.nan
                continue
            exit_close = c[ipos + h]
            if not np.isfinite(exit_close) or exit_close <= 0:
                rec[f"strat_cc{h}_raw"] = np.nan
                rec[f"strat_cc{h}_adj"] = np.nan
                ok = False
                continue
            r_cc = exit_close / entry_close - 1.0
            m_close_exit = mkt_close[me + h] if me + h < len(mkt_idx) else np.nan
            m_cc = m_close_exit / mkt_close[me] - 1.0 if np.isfinite(m_close_exit) else np.nan
            ab_cc = r_cc - beta * m_cc
            rec[f"strat_cc{h}_raw"] = -ev["flow_sign"] * r_cc
            rec[f"strat_cc{h}_adj"] = -ev["flow_sign"] * ab_cc
        rows.append(rec)

    panel = pd.DataFrame(rows)
    return panel, drops


# --------------------------------------------------------------------------- #
# Statistics
# --------------------------------------------------------------------------- #
def _bootstrap_mean_ci(x: np.ndarray, n_boot: int, seed: int,
                       alpha: float = 0.05) -> tuple[float, float, float, float]:
    """Return (mean, lo, hi, p_one_sided_gt0) via percentile bootstrap."""
    x = x[np.isfinite(x)]
    if len(x) < 3:
        return (np.nan, np.nan, np.nan, np.nan)
    rng = np.random.default_rng(seed)
    boot = rng.choice(x, size=(n_boot, len(x)), replace=True).mean(axis=1)
    lo, hi = np.percentile(boot, [100 * alpha / 2, 100 * (1 - alpha / 2)])
    p_gt0 = float(np.mean(boot <= 0.0))  # one-sided: P(mean not > 0)
    return (float(x.mean()), float(lo), float(hi), p_gt0)


def summarise_series(name: str, x: np.ndarray, cfg: Config) -> dict:
    x = x[np.isfinite(x)]
    n = len(x)
    if n < 3:
        return {"name": name, "n": n}
    mean_bps = x.mean() * 1e4
    t = stats.ttest_1samp(x, 0.0)
    _, lo, hi, p_boot = _bootstrap_mean_ci(x, cfg.n_boot, cfg.seed, cfg.kill_alpha)
    hit = float(np.mean(x > 0))
    # Wilcoxon sign test p (robust to fat tails)
    try:
        w_p = stats.wilcoxon(x, zero_method="zsplit", alternative="greater").pvalue
    except Exception:
        w_p = np.nan
    return {
        "name": name, "n": n, "mean_bps": mean_bps,
        "t": float(t.statistic), "p_t": float(t.pvalue),
        "p_boot_1s": p_boot, "p_wilcoxon_1s": float(w_p),
        "ci_lo_bps": lo * 1e4, "ci_hi_bps": hi * 1e4, "hit_rate": hit,
    }


def per_recon_date_view(panel: pd.DataFrame, col: str) -> np.ndarray:
    """Cluster-robust: one equal-weight observation per (effective_date)."""
    if col not in panel or panel.empty:
        return np.array([])
    g = panel.groupby("effective_date")[col].mean()
    return g.to_numpy()


def cost_sweep(panel: pd.DataFrame, col: str, cfg: Config) -> pd.DataFrame:
    """Subtract round-trip cost from each event; report mean & significance."""
    base = panel[col].to_numpy()
    base = base[np.isfinite(base)]
    out = []
    for cbps in cfg.cost_grid_bps:
        x = base - cbps / 1e4
        m = x.mean() * 1e4
        t = stats.ttest_1samp(x, 0.0).statistic if len(x) > 2 else np.nan
        _, _, _, p = _bootstrap_mean_ci(x, cfg.n_boot, cfg.seed, cfg.kill_alpha)
        out.append({"cost_bps": cbps, "net_mean_bps": m, "t": t, "p_boot_1s": p})
    df = pd.DataFrame(out)
    # breakeven cost (linear): cost where net mean crosses 0
    gross = base.mean() * 1e4
    df.attrs["breakeven_bps"] = gross  # net mean = gross - cost; zero at cost=gross
    return df


# --------------------------------------------------------------------------- #
# Reporting & verdict
# --------------------------------------------------------------------------- #
def _fmt(d: dict) -> str:
    if d.get("n", 0) < 3:
        return f"  {d['name']:<26} n={d.get('n',0):<4} (too few to summarise)"
    return (f"  {d['name']:<26} n={d['n']:<4} mean={d['mean_bps']:+7.2f}bps  "
            f"t={d['t']:+5.2f}  p_boot={d['p_boot_1s']:.3f}  "
            f"hit={d['hit_rate']*100:4.1f}%  "
            f"CI[{d['ci_lo_bps']:+.1f},{d['ci_hi_bps']:+.1f}]bps")


def report(panel: pd.DataFrame, drops: dict, cfg: Config, entry_on: str) -> dict:
    print("=" * 78)
    print("RECON-REVERSION FREE TEST  —  closing-auction dislocation hypothesis")
    print("=" * 78)
    n_ev = len(panel)
    print(f"\nEvents used: {n_ev}   (entry convention: {entry_on}, "
          f"beta: {cfg.beta_mode})")
    if drops:
        print("Dropped events by reason:")
        for k, v in sorted(drops.items(), key=lambda kv: -kv[1]):
            print(f"    {k:<32} {v}")
    if n_ev == 0:
        print("\nNo usable events. Check data wiring.")
        return {"verdict": "NO_DATA"}

    yrs = panel["effective_date"].dt.year
    print(f"Date span: {panel['effective_date'].min().date()} -> "
          f"{panel['effective_date'].max().date()}   "
          f"({yrs.nunique()} yrs, ~{n_ev / max(1, yrs.nunique()):.0f} events/yr)")
    n_add = int((panel['action'] == 'add').sum())
    print(f"Composition: {n_add} adds / {n_ev - n_add} deletes")

    # ---- Overnight, per-event ----
    print("\n--- PER-EVENT  (each recon name = 1 obs) ---")
    on_raw = summarise_series("overnight close->open RAW",
                              panel["strat_overnight_raw"].to_numpy(), cfg)
    on_adj = summarise_series("overnight close->open ADJ",
                              panel["strat_overnight_adj"].to_numpy(), cfg)
    print(_fmt(on_raw))
    print(_fmt(on_adj))
    for h in cfg.horizons:
        s = summarise_series(f"close->close+{h} ADJ",
                             panel[f"strat_cc{h}_adj"].to_numpy(), cfg)
        print(_fmt(s))

    # ---- Overnight, per-recon-date (cluster robust) ----
    print("\n--- PER-RECON-DATE  (each effective date = 1 obs; cluster-robust) ---")
    pdv_adj = per_recon_date_view(panel, "strat_overnight_adj")
    on_adj_cluster = summarise_series("overnight ADJ (by date)", pdv_adj, cfg)
    print(_fmt(on_adj_cluster))

    # ---- Add vs delete legs (diagnostic; which side carries it) ----
    print("\n--- BY LEG  (overnight ADJ) ---")
    for act in ("add", "delete"):
        sub = panel.loc[panel["action"] == act, "strat_overnight_adj"].to_numpy()
        print(_fmt(summarise_series(f"{act} leg", sub, cfg)))

    # ---- Cost sweep on the headline series (overnight ADJ, per-event) ----
    print("\n--- COST SWEEP  (overnight close->open, market-adjusted) ---")
    sweep = cost_sweep(panel, "strat_overnight_adj", cfg)
    for _, r in sweep.iterrows():
        flag = "  <-- hurdle" if abs(r["cost_bps"] - cfg.cost_hurdle_bps) < 1e-9 else ""
        print(f"    cost={r['cost_bps']:>4.0f}bps  net={r['net_mean_bps']:+7.2f}bps  "
              f"t={r['t']:+5.2f}  p_boot={r['p_boot_1s']:.3f}{flag}")
    print(f"    linear breakeven cost ~ {sweep.attrs['breakeven_bps']:+.2f} bps "
          f"(gross overnight ADJ mean)")

    # ---- VERDICT against pre-registered kill conditions ----
    print("\n" + "=" * 78)
    print("VERDICT  (pre-registered kill conditions)")
    print("=" * 78)

    net_at_hurdle = sweep.loc[sweep["cost_bps"] == cfg.cost_hurdle_bps]
    p_hurdle = float(net_at_hurdle["p_boot_1s"].iloc[0]) if len(net_at_hurdle) else 1.0
    mean_hurdle = float(net_at_hurdle["net_mean_bps"].iloc[0]) if len(net_at_hurdle) else -1.0

    cond_n = n_ev >= cfg.kill_min_events
    cond_zero = (on_adj.get("p_boot_1s", 1.0) < cfg.kill_alpha) and (on_adj.get("mean_bps", -1) > 0)
    cond_hurdle = (p_hurdle < cfg.kill_alpha) and (mean_hurdle > 0)
    # not-just-beta: market-adj mean retains >=50% of raw mean (and same sign)
    raw_m = on_raw.get("mean_bps", 0.0)
    adj_m = on_adj.get("mean_bps", 0.0)
    cond_notbeta = (adj_m > 0) and (raw_m <= 0 or adj_m >= 0.5 * raw_m)

    def line(ok, txt):
        print(f"   [{'PASS' if ok else 'FAIL'}]  {txt}")

    line(cond_n, f"N >= {cfg.kill_min_events} events for power "
                 f"(have {n_ev})")
    line(cond_zero, f"zero-cost market-adj overnight mean > 0 at "
                    f"p<{cfg.kill_alpha} (mean {adj_m:+.2f}bps, "
                    f"p={on_adj.get('p_boot_1s', float('nan')):.3f})")
    line(cond_hurdle, f"survives {cfg.cost_hurdle_bps:.0f}bps round-trip at "
                      f"p<{cfg.kill_alpha} (net {mean_hurdle:+.2f}bps, "
                      f"p={p_hurdle:.3f})")
    line(cond_notbeta, f"effect is NOT just market drift "
                       f"(raw {raw_m:+.2f} -> adj {adj_m:+.2f}bps)")

    if not cond_n:
        verdict = "ABSTAIN_LOW_POWER"
        msg = ("ABSTAIN: too few events to conclude. Extend the recon history "
               "(more years / add Russell) before deciding. Do NOT spend the "
               "$10 yet; also do NOT declare it dead.")
    elif cond_zero and cond_hurdle and cond_notbeta:
        verdict = "SURVIVES"
        msg = ("SURVIVES the free pre-test. The mechanism shows a real, "
               "market-adjusted, cost-surviving reversion on the cleanest "
               "forced-flow days. THIS JUSTIFIES the targeted Databento "
               "imbalance pull to generalise to all large caps on all "
               "structural days (for breadth/power).")
    else:
        verdict = "DEAD"
        msg = ("DEAD on arrival for the constrained trader. The largest, "
               "cleanest, known-direction forced flow does not produce a "
               "cost-surviving, market-adjusted reversion. The general "
               "imbalance signal will not rescue the marginal case. "
               "DO NOT spend the $10. Thread closed.")
    print("\n   >>> " + verdict)
    print("   " + msg)
    print("=" * 78)
    return {"verdict": verdict, "n_events": n_ev,
            "overnight_adj_bps": adj_m, "net_at_hurdle_bps": mean_hurdle}


# --------------------------------------------------------------------------- #
# Synthetic self-test  (proves the tool detects signal, null, and breakeven)
# --------------------------------------------------------------------------- #
def _make_synthetic(planted: bool, seed: int,
                    n_names: int = 220, n_days: int = 600,
                    dislocation_bps: float = 35.0, revert_frac: float = 0.6,
                    overnight_noise_bps: float = 40.0):
    """
    Build synthetic OHLC with a common market factor. If planted=True, on each
    event's auction close we dislodge the close in the flow direction by
    `dislocation_bps`, and the next open reverts `revert_frac` of it. The
    planted, market-adjusted, AGAINST-flow overnight edge is ~ revert_frac *
    dislocation_bps. With dislocation=35, revert=0.6 -> ~21 bps gross edge:
    should survive ~10bps and die ~20-30bps.
    """
    rng = np.random.default_rng(seed)
    dates = pd.bdate_range("2022-01-03", periods=n_days)
    # market factor daily log-returns
    mkt_ret = rng.normal(0.0003, 0.011, n_days)
    mkt_close = 400 * np.exp(np.cumsum(mkt_ret))
    # market overnight share: split each day's move into overnight+intraday
    mkt_on = rng.normal(0.0, 0.004, n_days)
    mkt_open = np.empty(n_days)
    mkt_open[0] = mkt_close[0]
    mkt_open[1:] = mkt_close[:-1] * (1 + mkt_on[1:])
    market = pd.DataFrame({"date": dates, "open": mkt_open, "high": mkt_open,
                           "low": mkt_open, "close": mkt_close, "adj_close": mkt_close})

    tickers = [f"SYN{i:03d}" for i in range(n_names)]
    betas = rng.uniform(0.6, 1.6, n_names)
    prices: dict[str, pd.DataFrame] = {}
    # choose events: one per name on a random mid-sample date, half add half delete
    ev_rows = []
    for i, tk in enumerate(tickers):
        beta = betas[i]
        idio = rng.normal(0.0, 0.013, n_days)
        stk_ret = beta * mkt_ret + idio
        close = 50 * np.exp(np.cumsum(stk_ret))
        # overnight = beta*mkt_on + idio_on ; open = prev_close*(1+overnight)
        idio_on = rng.normal(0.0, overnight_noise_bps / 1e4, n_days)
        overnight = beta * mkt_on + idio_on
        open_ = np.empty(n_days)
        open_[0] = close[0]
        open_[1:] = close[:-1] * (1 + overnight[1:])

        # plant an event for ~85% of names (so N is realistic), in days [120, 520]
        if rng.random() < 0.85:
            epos = int(rng.integers(120, n_days - 10))
            action = "add" if rng.random() < 0.5 else "delete"
            flow = 1.0 if action == "add" else -1.0
            if planted:
                d = flow * dislocation_bps / 1e4
                # dislodge the auction close
                close[epos] *= (1 + d)
                # next open reverts revert_frac of the dislocation
                # set open[epos+1] relative to the (pre-dislocation) close path:
                pre = close[epos] / (1 + d)
                open_[epos + 1] = pre * (1 + d * (1 - revert_frac)) * (1 + beta * mkt_on[epos + 1])
            # effective_date = the day AFTER the auction (so eff_prev_close = epos)
            ev_rows.append({"ticker": tk,
                            "effective_date": dates[epos + 1],
                            "action": action, "index": "syn"})
        prices[tk] = pd.DataFrame({"date": dates, "open": open_, "high": open_,
                                   "low": open_, "close": close, "adj_close": close})
    events = pd.DataFrame(ev_rows)
    # match the load_events() contract (flow_sign: +1 add / -1 delete)
    events["flow_sign"] = np.where(events["action"] == "add", 1.0, -1.0)
    return events, prices, market


def run_selftest():
    cfg = Config()
    print("\n############ SELF-TEST 1: PLANTED EFFECT (should SURVIVE & break ~20-30bps) ############")
    ev, px, mk = _make_synthetic(planted=True, seed=cfg.seed)
    panel, drops = build_panel(ev, px, mk, cfg, entry_on="eff_prev_close")
    r1 = report(panel, drops, cfg, "eff_prev_close")

    print("\n\n############ SELF-TEST 2: NULL (no dislocation; should be DEAD) ############")
    ev0, px0, mk0 = _make_synthetic(planted=False, seed=cfg.seed + 1)
    panel0, drops0 = build_panel(ev0, px0, mk0, cfg, entry_on="eff_prev_close")
    r0 = report(panel0, drops0, cfg, "eff_prev_close")

    print("\n\n############ SELF-TEST SUMMARY ############")
    ok1 = r1.get("verdict") == "SURVIVES"
    ok0 = r0.get("verdict") in ("DEAD",)
    print(f"  planted -> {r1.get('verdict')}   (expected SURVIVES)   "
          f"{'OK' if ok1 else 'XX'}")
    print(f"  null    -> {r0.get('verdict')}   (expected DEAD)       "
          f"{'OK' if ok0 else 'XX'}")
    print(f"\n  Tool correctness: {'PASS' if (ok1 and ok0) else 'CHECK'}")
    return ok1 and ok0


# --------------------------------------------------------------------------- #
# CLI
# --------------------------------------------------------------------------- #
def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--selftest", action="store_true",
                    help="run synthetic planted+null tests (no data needed)")
    ap.add_argument("--events", help="events CSV (ticker,effective_date,action,index)")
    ap.add_argument("--prices", help="dir of TICKER.csv, or a long CSV/parquet")
    ap.add_argument("--market", help="market proxy OHLC CSV (e.g. SPY)")
    ap.add_argument("--entry-on", default="eff_prev_close",
                    choices=["eff_prev_close", "eff_close"])
    ap.add_argument("--estimate-beta", action="store_true",
                    help="estimate per-name beta from pre-event window "
                         "(default: market-adjusted, beta=1)")
    ap.add_argument("--cost-hurdle-bps", type=float, default=10.0)
    ap.add_argument("--min-events", type=int, default=30)
    args = ap.parse_args()

    cfg = Config(beta_mode="estimate" if args.estimate_beta else "unit",
                 cost_hurdle_bps=args.cost_hurdle_bps,
                 kill_min_events=args.min_events)

    if args.selftest:
        ok = run_selftest()
        sys.exit(0 if ok else 1)

    if not (args.events and args.prices and args.market):
        ap.error("real run needs --events, --prices and --market "
                 "(or use --selftest)")

    events = load_events(args.events)
    prices = load_prices(args.prices)
    market = load_market(args.market)
    panel, drops = build_panel(events, prices, market, cfg, entry_on=args.entry_on)
    report(panel, drops, cfg, args.entry_on)


if __name__ == "__main__":
    main()

