"""The honest next step: a BROAD multi-asset-class trend program (proper CTA breadth).

Same FROZEN signal as ope.trend, applied to a pre-specified ~39-market universe spanning 8
asset classes -- NOT selected on results. Breadth is the one non-overfit lever to lift
Sharpe (it scales ~sqrt of uncorrelated bets). We also test cross-sectional momentum (XS)
and a 50/50 TS+XS combo on the SAME universe (a documented uncorrelated pair), then run the
gauntlet (PSR vs 1.0, DSR) and compare to the 16-ETF baseline.

    PYTHONPATH=. python3 research/broad_trend.py
"""
from __future__ import annotations

import numpy as np
import pandas as pd

from ope.trend import ETF_BASKET, ETF_COST_BP, backtest, trend_weights
from ope.validation import (
    deflated_sharpe_ratio,
    perf_stats,
    probabilistic_sharpe_ratio,
    trial_sr_variance,
)

# Pre-specified by asset-class coverage (committed before seeing results; no cherry-picking).
BROAD = {
    "US equity":   ["SPY", "QQQ", "IWM"],
    "Dev equity":  ["EFA", "VGK", "EWJ", "EWU", "EWG", "EWA", "EWC"],
    "EM equity":   ["EEM", "FXI", "EWZ", "INDA", "EWY", "EWT", "EWW"],
    "Rates":       ["TLT", "IEF", "SHY", "TIP", "AGG", "BWX"],
    "Credit":      ["LQD", "HYG", "EMB"],
    "Commodities": ["GLD", "SLV", "DBC", "USO", "UNG", "DBA", "DBB"],
    "Real estate": ["VNQ", "RWX"],
    "FX":          ["UUP", "FXE", "FXY", "FXB"],
}
UNIVERSE = [t for v in BROAD.values() for t in v]
COST_BP = 2.0                 # conservative flat one-way bps for a mixed-liquidity ETF set
TGT, WIN, CAP, ANN = 0.10, 63, 3.0, 252.0
IS_END, OOS_START = "2018-12-31", "2022-01-01"


def _vol_target(w, rets):
    g = (w * rets).sum(axis=1)
    scale = (TGT / (g.rolling(WIN).std() * np.sqrt(ANN))).shift(1).clip(0, CAP).fillna(0.0)
    return w.mul(scale, axis=0)


def _net(w, rets, cost_bp=COST_BP):
    return ((w * rets).sum(axis=1) - w.diff().abs().sum(axis=1) * cost_bp * 1e-4).dropna()


def _ts_signal(px):
    """Frozen TS-trend signal, gross-normalized, BEFORE portfolio vol-targeting."""
    rets = px.pct_change()
    av = (rets.rolling(WIN).std() * np.sqrt(ANN)).shift(1)
    z = sum(px.pct_change(L) / (av * np.sqrt(L / ANN)) for L in (63, 126, 252)) / 3
    w = np.tanh(z).shift(1) / av
    return w.div(w.abs().sum(axis=1).replace(0, np.nan), axis=0)


def _class_balanced_ts(px, rets):
    """Equal RISK per asset class: TS-trend within each cluster, clusters equal-weighted."""
    parts = []
    for cols in (BROAD.values()):
        cols = [t for t in cols if t in px.columns]
        if not cols:
            continue
        w = _ts_signal(px[cols])
        parts.append(w.reindex(columns=px.columns).fillna(0.0))
    combined = sum(parts) / len(parts)
    combined = combined.div(combined.abs().sum(axis=1).replace(0, np.nan), axis=0)
    return _vol_target(combined, rets)


def _xs_mom_weights(px, look=126):
    r = px.pct_change(look)
    z = r.sub(r.mean(axis=1), axis=0).div(r.std(axis=1).replace(0, np.nan), axis=0)
    av = (px.pct_change().rolling(WIN).std() * np.sqrt(ANN)).shift(1)
    w = np.tanh(z).shift(1) / av
    return w.div(w.abs().sum(axis=1).replace(0, np.nan), axis=0)


def _report(name, net, spy):
    full, is_, oos = (perf_stats(net), perf_stats(net[net.index <= IS_END]),
                      perf_stats(net[net.index >= OOS_START]))
    b = pd.concat([net, spy], axis=1).dropna()
    beta = b.cov().iloc[0, 1] / b.iloc[:, 1].var()
    alpha = (net.mean() - beta * spy.reindex(net.index).mean()) * ANN
    psr1 = probabilistic_sharpe_ratio(net, 1.0 / np.sqrt(ANN))
    ratio = oos["sharpe"] / is_["sharpe"] if is_["sharpe"] else float("nan")
    print(f"  {name:<11} Sh {full['sharpe']:.2f} (IS {is_['sharpe']:.2f}/OOS {oos['sharpe']:.2f}, "
          f"OOS/IS {ratio:.2f}) | ann {full['ann_return']*100:4.1f}% DD {full['max_drawdown']*100:5.1f}% "
          f"| beta {beta:+.2f} alpha {alpha*100:4.1f}% | PSR>1.0 {psr1*100:4.1f}%")
    return net


def main():
    import yfinance as yf
    raw = yf.download(UNIVERSE, start="2006-01-01", auto_adjust=True, progress=False)["Close"]
    px = raw.dropna(how="all").dropna(axis=1, thresh=int(len(raw) * 0.4))
    kept = [c for c in UNIVERSE if c in px.columns]
    print(f"universe: {len(kept)}/{len(UNIVERSE)} markets with data | "
          f"{px.index[0].date()} -> {px.index[-1].date()}\n")
    rets = px.pct_change()
    spy = px["SPY"].pct_change()

    # baseline (16-ETF frozen engine) vs broad TS (same frozen engine, more markets)
    base = backtest(px[[c for c in ETF_BASKET if c in px.columns]],
                    cost_bp={k: v for k, v in ETF_COST_BP.items() if k in px.columns}).net
    broad_ts = backtest(px[kept], cost_bp=COST_BP).net
    xs = _net(_vol_target(_xs_mom_weights(px[kept]), rets[kept]), rets[kept])
    ts_w = trend_weights(px[kept])
    xs_w = _vol_target(_xs_mom_weights(px[kept]), rets[kept])     # already targeted; renorm below
    combo_w = _vol_target((ts_w.div(ts_w.abs().sum(1).replace(0, np.nan), axis=0).fillna(0)
                           + _xs_mom_weights(px[kept]).fillna(0)) / 2, rets[kept])
    combo = _net(combo_w, rets[kept])

    cbal = _net(_class_balanced_ts(px[kept], rets[kept]), rets[kept])

    print("STRATEGY (full | in-sample<=2018 / out-of-sample>=2022):")
    _report("baseline16", base, spy)
    _report("broad TS", broad_ts, spy)
    _report("class-bal TS", cbal, spy)
    _report("broad XS", xs, spy)
    _report("TS+XS combo", combo, spy)

    cfgs = {"baseline16": base, "broad_ts": broad_ts, "cbal": cbal,
            "broad_xs": xs, "combo": combo}
    srvar = trial_sr_variance(cfgs)
    cand = max([("baseline16", base), ("class-bal TS", cbal), ("broad TS", broad_ts)],
               key=lambda kv: perf_stats(kv[1])["sharpe"])
    print(f"\nGAUNTLET (best trend candidate = {cand[0]}):")
    for N in (4, 15, 30):
        dsr = deflated_sharpe_ratio(cand[1], srvar, N)
        print(f"  DSR @ N={N:<2} trials: {dsr*100:.1f}%")
    print(f"  PSR vs 0: {probabilistic_sharpe_ratio(cand[1],0.0)*100:.1f}%  |  "
          f"PSR vs 1.0: {probabilistic_sharpe_ratio(cand[1],1.0/np.sqrt(ANN))*100:.1f}%")


if __name__ == "__main__":
    main()

