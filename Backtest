    sig = None
    for i in idxs:
        if mn[i] < 600: continue  # after 10:00 ET only
        if i >= last: break
        dist = c[i] - p
        if abs(dist) > 1.0*a:
            direction = -1 if dist>0 else 1  # toward prior close
            sig = (i, direction); break
    if sig is None: continue
    si, direction = sig
    e = si+1
    if e > last or days[e]!=d: continue
    entry = o[e]
    target = p
    stop = entry - direction*0.5*a  # 0.5 ATR further from entry away from target
    exit_bar = last
    for j in range(e, last+1):
        if direction==1:
            if h[j] >= target: exit_bar=j; break
            if l[j] <= stop:   exit_bar=j; break
        else:
            if l[j] <= target: exit_bar=j; break
            if h[j] >= stop:   exit_bar=j; break
    trades.append((e, exit_bar, direction))

r = M.evaluate(df.reset_index(drop=True) if False else df, trades, name='prior_close_magnet')
M.show(r)
import json
print("JSON", json.dumps({k:r.get(k) for k in ['trades','win','exp','ann','ann_pct','maxDD','calmar','skew','ann_sharpe']}))
print("IS", r.get('IS'), "OOS", r.get('OOS'))

