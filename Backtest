"""M0 -- MBO event tape: decode one day of MES Market-By-Order into compact integer
arrays (front-month outright, dominant session), and cache to .npz so downstream
strategy passes re-run in seconds instead of re-decoding 11M+ records.

We keep the FULL session in the tape (not just RTH) so the book is warm when the
strategy starts acting at the RTH open. The strategy layer decides when to *act*.

Conventions (verified against the data in ope/tick_data.py and l3_book_alpha.py):
    price raw units are 1e-9 index points; MES tick = 0.25 pt = 250_000_000 raw.
    px_tick = round(raw / 250_000_000)  -> exact integer tick index.
    action ordinals: A(dd) C(ancel) M(odify) R(eset/clear) T(rade) F(ill).
    side ordinals:   B(id)  A(sk)  N(one).

    PYTHONPATH=. python3 -m research.ofmm.tape [YYYYMMDD]   # decode+cache+sanity
"""
from __future__ import annotations

import glob
import os
import sys
from dataclasses import dataclass

import numpy as np
import databento as db

MBO_GLOB = "data/mbo/GLBX-20260607-8MCA89KCJQ/*.mbo.dbn.zst"
CACHE_DIR = "data/mbo/_tape_cache"
RAW_PER_TICK = 250_000_000        # 0.25 pt in 1e-9 raw units
TICK = 0.25
POINT = 5.0                       # MES $ per index point ; 1 tick = $1.25

# action / side ordinals as int8
A, C, M, R, T, F = (ord(x) for x in "ACMRTF")
BID, ASK, NONE = ord("B"), ord("A"), ord("N")


@dataclass
class Tape:
    date: str            # 'YYYYMMDD'
    front: int           # instrument_id of front-month outright
    ts: np.ndarray       # int64 ns
    action: np.ndarray   # uint8 ordinal
    side: np.ndarray     # uint8 ordinal
    px: np.ndarray       # int32 price in ticks
    size: np.ndarray     # int32
    oid: np.ndarray      # int64 order id

    def __len__(self) -> int:
        return len(self.ts)


def _codes(arr):
    """Normalize a databento char column (bytes 'S1' or small int) to uint8 ordinals."""
    if arr.dtype.kind in ("S", "a"):
        return np.frombuffer(np.ascontiguousarray(arr).tobytes(), dtype=np.uint8)
    return arr.astype(np.uint8)


def _cache_path(path: str) -> str:
    base = os.path.splitext(os.path.basename(path))[0]      # glbx-mdp3-YYYYMMDD.mbo
    return os.path.join(CACHE_DIR, base + ".npz")


def load_day(path: str, use_cache: bool = True) -> Tape:
    cp = _cache_path(path)
    if use_cache and os.path.exists(cp):
        z = np.load(cp, allow_pickle=False)
        return Tape(str(z["date"]), int(z["front"]), z["ts"], z["action"],
                    z["side"], z["px"], z["size"], z["oid"])

    store = db.DBNStore.from_file(path)
    arr = store.to_ndarray()
    iid = arr["instrument_id"]
    front = int(np.bincount(iid).argmax())                  # most-active = front outright
    ts_all = arr["ts_event"].astype("int64")
    day_idx = ts_all // 86_400_000_000_000
    target = np.bincount(day_idx - day_idx.min()).argmax() + day_idx.min()
    m = (iid == front) & (day_idx == target)
    a = arr[m]

    raw_px = a["price"].astype(np.int64)
    # round-to-nearest tick (handles the sentinel INT64_MAX for no-price actions -> huge,
    # harmless: such records are R/T without a book level and never match our levels)
    px = np.where(np.abs(raw_px) < (1 << 62),
                  np.rint(raw_px / RAW_PER_TICK), 0).astype(np.int32)
    date = str(np.datetime64(int(target) * 86_400, "s").astype("datetime64[D]")).replace("-", "")

    tp = Tape(
        date=date, front=front,
        ts=a["ts_event"].astype(np.int64),
        action=_codes(a["action"]),
        side=_codes(a["side"]),
        px=px,
        size=a["size"].astype(np.int32),
        oid=a["order_id"].astype(np.int64),
    )
    if use_cache:
        os.makedirs(CACHE_DIR, exist_ok=True)
        np.savez(cp, date=tp.date, front=tp.front, ts=tp.ts, action=tp.action,
                 side=tp.side, px=tp.px, size=tp.size, oid=tp.oid)
    return tp


def day_files() -> list[str]:
    return sorted(glob.glob(MBO_GLOB))


def _sanity(tp: Tape) -> None:
    """Reconstruct top-of-book on the tape and print the same checks as l3_book_alpha."""
    bid: dict[int, int] = {}
    ask: dict[int, int] = {}
    orders: dict[int, tuple[int, int, int]] = {}
    n = len(tp)
    act, sd, px, sz, oid = tp.action, tp.side, tp.px, tp.size, tp.oid
    spreads = []
    bszs, aszs = [], []
    sample = max(1, n // 200_000)
    for i in range(n):
        ac = act[i]
        if ac == A:
            orders[int(oid[i])] = (int(sd[i]), int(px[i]), int(sz[i]))
            lv = bid if sd[i] == BID else ask
            lv[int(px[i])] = lv.get(int(px[i]), 0) + int(sz[i])
        elif ac == C or ac == F:
            o = orders.get(int(oid[i]))
            if o:
                lv = bid if o[0] == BID else ask
                r = lv.get(o[1], 0) - int(sz[i])
                if r > 0:
                    lv[o[1]] = r
                else:
                    lv.pop(o[1], None)
                ns = o[2] - int(sz[i])
                if ns > 0:
                    orders[int(oid[i])] = (o[0], o[1], ns)
                else:
                    orders.pop(int(oid[i]), None)
        elif ac == M:
            o = orders.pop(int(oid[i]), None)
            if o:
                lv = bid if o[0] == BID else ask
                r = lv.get(o[1], 0) - o[2]
                if r > 0:
                    lv[o[1]] = r
                else:
                    lv.pop(o[1], None)
            orders[int(oid[i])] = (int(sd[i]), int(px[i]), int(sz[i]))
            lv = bid if sd[i] == BID else ask
            lv[int(px[i])] = lv.get(int(px[i]), 0) + int(sz[i])
        elif ac == R:
            orders.clear(); bid.clear(); ask.clear()
        if bid and ask and (i % sample == 0):
            bb, aa = max(bid), min(ask)
            if aa > bb:
                spreads.append(aa - bb)
                bszs.append(bid[bb]); aszs.append(ask[aa])
    spreads = np.array(spreads)
    print(f"date={tp.date} front={tp.front} events={n:,}")
    print(f"  mean spread {spreads.mean()*TICK:.4f} pt | frac 1-tick {(spreads==1).mean()*100:.1f}%"
          f" | mean bidsz {np.mean(bszs):.0f} asksz {np.mean(aszs):.0f}")


if __name__ == "__main__":
    day = sys.argv[1] if len(sys.argv) > 1 else None
    files = day_files()
    path = next((f for f in files if day and day in f), files[-1])
    print(f"file: {path}")
    import time
    t0 = time.time()
    tp = load_day(path, use_cache=False)
    print(f"decoded in {time.time()-t0:.1f}s -> {len(tp):,} events")
    t0 = time.time()
    tp2 = load_day(path, use_cache=True)      # writes then would read; verify roundtrip
    print(f"cache roundtrip ok: {len(tp2)==len(tp)} (cached load {time.time()-t0:.1f}s)")
    _sanity(tp)

