"""M1+M2+M3 -- the event-driven maker scalper with an EXACT MBO queue-position fill
simulator. One monolithic pass per day (the book, the signal, our order, our fills and
our P&L must share the hot loop; a callback design would be too slow for 11M events).

WHY MAKER, NOT TAKER (established empirically before this was written):
  MES sits at a 1-tick spread ~92-97% of the time with ~50 lots resting at each touch.
  Book-imbalance predicts the next ~10s mid move with IC ~0.074, but the *monetizable*
  size is ~0.2 tick at the extremes vs a ~2-tick round-trip cost to CROSS. Taker is dead.
  So we POST (earn the spread) on the side imbalance favors, and let the MBO tape decide,
  honestly, whether we fill and whether we get run over (adverse selection).

THE FILL SIMULATOR (the differentiator -- what MBO uniquely enables). CME index futures
match strict price-time FIFO. When we post 1 lot at price P we join the BACK of the queue.
We know the exact resting size ahead (level size at post) and, via order ids + an arrival
counter, which later reductions are from orders ahead of us vs behind us:
    * CANCEL / MODIFY-away of an order ahead  -> queue_ahead shrinks (we advance) [no fill]
    * EXECUTION (F) of an order ahead         -> queue_ahead shrinks             [no fill]
    * once the queue ahead is gone, the NEXT execution at our level fills US at P (FIFO:
      we have priority over everything that arrived behind us). A single sweep whose size
      exceeds the remaining queue fills us in that same event.
  Cancels advance us but never fill us; only executions fill us; adds behind us never help.
  Conservative and exact -- no optimistic "we always get filled" assumption.

Causality: the signal (top-of-book imbalance) uses only book state up to the current
event; we decide, post and fill strictly forward in event time. RTH-only actions; the
book is warmed by the full session. All prices are integer ticks.

    PYTHONPATH=. python3 -m research.ofmm.backtest [YYYYMMDD]
"""
from __future__ import annotations

import sys
from dataclasses import dataclass

import numpy as np

from research.ofmm.tape import (Tape, load_day, day_files, TICK, POINT,
                                A, C, M, R, T, F, BID, ASK)

NS = 1_000_000_000
DAY_NS = 86_400 * NS


@dataclass
class Params:
    theta: float = 0.35          # imbalance gate to ENTER (post on the favored side)
    theta_hold: float = 0.10     # cancel a working entry if imbalance falls below this
    decide_ns: int = 200_000_000 # min gap between entry evaluations when flat (200 ms)
    work_ns: int = 5 * NS        # cancel an unfilled entry after this long
    tp_ticks: int = 1            # passive take-profit distance (ticks)
    stop_ticks: int = 2          # protective (taker) stop distance (ticks)
    hold_ns: int = 30 * NS       # time stop for an open position
    flip_exit: bool = False      # taker-exit if imbalance flips hard against the position
    sign: int = 1                # +1 = trade WITH imbalance; -1 = INVERTED (placebo)
    comm_side: float = 0.35      # commission per side ($); round-trip = 2x
    taker_slip_ticks: float = 0.5  # extra slippage charged on TAKER exits (latency proxy)
    cancel_latency_ns: int = 0   # delay before a working-entry cancel takes effect; during
                                 # the window the order stays fillable (adverse-selection realism)
    rth_start_ns: int = int(13.5 * 3600 * NS)   # 13:30 UTC = 09:30 ET (EDT)
    rth_end_ns: int = 20 * 3600 * NS            # 20:00 UTC = 16:00 ET (EDT)
    flat_by_ns: int = int(19.9167 * 3600 * NS)  # stop opening ~5 min before the close


def _summarize(trades, date):
    if not trades:
        return dict(date=date, n=0, net=0.0, gross=0.0, comm=0.0, win=np.nan,
                    tp=0, stop=0, flip=0, time=0, eod=0, avg_net=np.nan,
                    longs=0, shorts=0)
    net = np.array([t["net"] for t in trades])
    kinds = [t["exit"] for t in trades]
    return dict(
        date=date, n=len(trades), net=float(net.sum()),
        gross=float(sum(t["gross"] for t in trades)),
        comm=float(sum(t["comm"] for t in trades)),
        win=float((net > 0).mean()), avg_net=float(net.mean()),
        tp=kinds.count("tp"), stop=kinds.count("stop"), flip=kinds.count("flip"),
        time=kinds.count("time"), eod=kinds.count("eod"),
        longs=sum(1 for t in trades if t["side"] > 0),
        shorts=sum(1 for t in trades if t["side"] < 0),
    )


def run_day(tp: Tape, p: Params, collect_ic: bool = False):
    """Replay one day; return (trades, summary, ic_rows, stats)."""
    act, sd, px, sz, oid, ts = tp.action, tp.side, tp.px, tp.size, tp.oid, tp.ts
    n = len(tp)
    comm_rt = 2.0 * p.comm_side

    orders: dict[int, tuple] = {}       # oid -> (side, px, size, seq)
    bid: dict[int, int] = {}
    ask: dict[int, int] = {}
    best_bid = -1
    best_ask = 1 << 30
    seq = 0

    # our state machine: 0 flat, 1 working-entry, 2 in-position (resting TP + risk mgmt)
    phase = 0
    e_side = 0                  # +1 long / -1 short
    e_price = 0                 # entry post price (ticks); also entry fill price
    e_book = BID               # book side of our resting entry order
    e_postseq = 0
    q_ahead = 0
    e_work_ts = 0
    cancel_at = -1              # pending-cancel deadline (ns); -1 = none
    fill_ts = 0
    mid_at_fill = 0.0
    tp_price = 0
    tp_book = ASK
    tp_postseq = 0
    q_tp = 0
    last_decide = -1

    trades = []
    stats = dict(posts=0, fills=0)
    ic_rows = [] if collect_ic else None
    last_ic_ts = 0

    def imb_now():
        if best_bid < 0 or best_ask >= (1 << 30):
            return 0.0
        bs = bid.get(best_bid, 0); as_ = ask.get(best_ask, 0)
        tot = bs + as_
        return (bs - as_) / tot if tot else 0.0

    for i in range(n):
        ac = act[i]; s = int(sd[i]); pr = int(px[i]); z = int(sz[i]); t = int(ts[i])
        oi = int(oid[i])

        # =================== maintain the L3 book (l3_book_alpha rules) ===================
        if ac == A:
            seq += 1
            orders[oi] = (s, pr, z, seq)
            if s == BID:
                bid[pr] = bid.get(pr, 0) + z
                if pr > best_bid:
                    best_bid = pr
            else:
                ask[pr] = ask.get(pr, 0) + z
                if pr < best_ask:
                    best_ask = pr

        elif ac == C or ac == F:
            o = orders.get(oi)
            if o is not None:
                os_, op, osz, oq = o
                lv = bid if os_ == BID else ask
                r = lv.get(op, 0) - z
                if r > 0:
                    lv[op] = r
                else:
                    lv.pop(op, None)
                    if os_ == BID and op == best_bid:
                        best_bid = _new_best_bid(bid, best_bid)
                    elif os_ == ASK and op == best_ask:
                        best_ask = _new_best_ask(ask, best_ask)
                if osz - z > 0:
                    orders[oi] = (os_, op, osz - z, oq)
                else:
                    orders.pop(oi, None)

                # ---- our queue / fills (M2) ----
                if phase == 1 and os_ == e_book and op == e_price:
                    if oq <= e_postseq:                    # a reduction AHEAD of us
                        eat = z if z < q_ahead else q_ahead
                        q_ahead -= eat
                        if ac == F and z - eat > 0:         # sweep reached us in one event
                            phase = 2
                            _fill_entry_locals = True
                        else:
                            _fill_entry_locals = False
                    elif ac == F:                          # behind-us exec => ahead cleared, we fill
                        q_ahead = 0
                        phase = 2
                        _fill_entry_locals = True
                    else:
                        _fill_entry_locals = False
                    if phase == 2 and _fill_entry_locals:
                        fill_ts = t
                        stats["fills"] += 1
                        mid_at_fill = (best_bid + best_ask) / 2.0 if (best_bid >= 0 and best_ask < (1 << 30)) else e_price
                        tp_price = e_price + e_side * p.tp_ticks
                        tp_book = ASK if e_side > 0 else BID
                        tp_postseq = seq
                        q_tp = (ask if tp_book == ASK else bid).get(tp_price, 0)

                elif phase == 2 and os_ == tp_book and op == tp_price:
                    if oq <= tp_postseq:
                        eat = z if z < q_tp else q_tp
                        q_tp -= eat
                        hit = ac == F and z - eat > 0
                    elif ac == F:
                        q_tp = 0
                        hit = True
                    else:
                        hit = False
                    if hit:
                        trades.append(_rec(e_side, fill_ts, t, e_price, tp_price, "tp",
                                           comm_rt, mid_at_fill))
                        phase = 0

        elif ac == M:
            o = orders.pop(oi, None)
            if o is not None:
                os_, op, osz, oq = o
                lv = bid if os_ == BID else ask
                r = lv.get(op, 0) - osz
                if r > 0:
                    lv[op] = r
                else:
                    lv.pop(op, None)
                    if os_ == BID and op == best_bid:
                        best_bid = _new_best_bid(bid, best_bid)
                    elif os_ == ASK and op == best_ask:
                        best_ask = _new_best_ask(ask, best_ask)
                # modify's removal of an order that was ahead of us
                if phase == 1 and os_ == e_book and op == e_price and oq <= e_postseq:
                    if s == os_ and pr == op and z <= osz:      # reduce-in-place keeps priority
                        q_ahead -= (osz - z)
                    else:
                        q_ahead -= osz if osz < q_ahead else q_ahead
                elif phase == 2 and os_ == tp_book and op == tp_price and oq <= tp_postseq:
                    if s == os_ and pr == op and z <= osz:
                        q_tp -= (osz - z)
                    else:
                        q_tp -= osz if osz < q_tp else q_tp
            seq += 1
            orders[oi] = (s, pr, z, seq)                     # re-add (behind us)
            if s == BID:
                bid[pr] = bid.get(pr, 0) + z
                if pr > best_bid:
                    best_bid = pr
            else:
                ask[pr] = ask.get(pr, 0) + z
                if pr < best_ask:
                    best_ask = pr

        elif ac == R:
            orders.clear(); bid.clear(); ask.clear()
            best_bid = -1; best_ask = 1 << 30
            phase = 0

        # =================== M1 diagnostic: 1s IC samples ===================
        if collect_ic and best_bid >= 0 and best_ask < (1 << 30) and t - last_ic_ts >= NS:
            last_ic_ts = t
            ic_rows.append((t, (best_bid + best_ask) / 2.0, imb_now()))

        # =================== strategy (RTH only) ===================
        if best_bid < 0 or best_ask >= (1 << 30) or best_ask <= best_bid:
            continue
        nsd = t % DAY_NS

        if phase == 2:
            g = p.sign * imb_now()
            adverse = (best_bid <= e_price - p.stop_ticks) if e_side > 0 else \
                      (best_ask >= e_price + p.stop_ticks)
            flip = p.flip_exit and ((g <= -p.theta) if e_side > 0 else (g >= p.theta))
            timeout = (t - fill_ts) >= p.hold_ns
            eod = nsd >= p.rth_end_ns
            if adverse or flip or timeout or eod:
                # cross to flatten (taker), charged an extra latency/slippage penalty
                exit_px = (best_bid - p.taker_slip_ticks) if e_side > 0 else (best_ask + p.taker_slip_ticks)
                kind = "stop" if adverse else ("flip" if flip else ("time" if timeout else "eod"))
                trades.append(_rec(e_side, fill_ts, t, e_price, exit_px, kind, comm_rt, mid_at_fill))
                phase = 0
            continue

        if phase == 1:
            g = p.sign * imb_now()
            stale = best_bid > e_price if e_side > 0 else best_ask < e_price
            weak = (g < p.theta_hold) if e_side > 0 else (g > -p.theta_hold)
            expired = (t - e_work_ts) >= p.work_ns
            eod = nsd >= p.rth_end_ns
            if stale or weak or expired or eod:
                if p.cancel_latency_ns <= 0 or eod:
                    phase = 0; cancel_at = -1                        # cancel now (no cost)
                elif cancel_at < 0:
                    cancel_at = t + p.cancel_latency_ns              # cancel in flight
            if phase == 1 and cancel_at >= 0 and t >= cancel_at:     # cancel lands
                phase = 0; cancel_at = -1
            continue

        # phase 0: consider a new entry (throttled, 1-tick market, inside RTH)
        if not (p.rth_start_ns <= nsd < p.flat_by_ns):
            continue
        if t - last_decide < p.decide_ns:
            continue
        last_decide = t
        if best_ask - best_bid != 1:
            continue
        imb = p.sign * imb_now()
        if imb >= p.theta:
            phase = 1; e_side = 1; e_price = best_bid; e_book = BID
            e_postseq = seq; q_ahead = bid.get(best_bid, 0); e_work_ts = t
            cancel_at = -1; stats["posts"] += 1
        elif imb <= -p.theta:
            phase = 1; e_side = -1; e_price = best_ask; e_book = ASK
            e_postseq = seq; q_ahead = ask.get(best_ask, 0); e_work_ts = t
            cancel_at = -1; stats["posts"] += 1

    return trades, _summarize(trades, tp.date), ic_rows, stats


def _new_best_bid(bid, old):
    if not bid:
        return -1
    b = old - 1
    lim = old - 40
    while b >= lim:
        if b in bid:
            return b
        b -= 1
    return max(bid)


def _new_best_ask(ask, old):
    if not ask:
        return 1 << 30
    a = old + 1
    lim = old + 40
    while a <= lim:
        if a in ask:
            return a
        a += 1
    return min(ask)


def _rec(side, ts_in, ts_out, px_in, px_out, kind, comm_rt, mid_in):
    gross_ticks = (px_out - px_in) * side
    gross = gross_ticks * TICK * POINT
    return dict(side=side, ts_in=ts_in, ts_out=ts_out, px_in=px_in, px_out=px_out,
                exit=kind, taker=(kind != "tp"), gross_ticks=gross_ticks, gross=gross,
                comm=comm_rt, net=gross - comm_rt, mid_in=mid_in)


def _fmt(s):
    return (f"{s['date']}: n={s['n']:>4} net=${s['net']:>8.2f} "
            f"gross=${s['gross']:>8.2f} comm=${s['comm']:>7.2f} "
            f"win={s['win']*100:>4.1f}% avg=${s['avg_net']:>6.3f} | "
            f"tp={s['tp']} stop={s['stop']} flip={s['flip']} time={s['time']} eod={s['eod']} "
            f"| L/S={s['longs']}/{s['shorts']}")


if __name__ == "__main__":
    day = sys.argv[1] if len(sys.argv) > 1 else None
    files = day_files()
    path = next((f for f in files if day and day in f), files[-1])
    import time
    tp = load_day(path)
    t0 = time.time()
    trades, summ, _, stats = run_day(tp, Params())
    dt = time.time() - t0
    print(_fmt(summ))
    print(f"posts={stats['posts']} fills={stats['fills']} "
          f"fill_rate={stats['fills']/max(1,stats['posts'])*100:.1f}% | run {dt:.1f}s")

