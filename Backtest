    print(f'\n{"="*84}\n  Per pool, tau<=15 vs tau>60 (r60)\n{"="*84}')
    print(f'    {"pool":<7}{"n fast":>8}{"mean":>10}{"t":>8}   {"n slow":>8}{"mean":>10}{"t":>8}')
    for p in RC.POOLS:
        s = ra[(ra.pool == p) & ra.reclaimed]
        f_ = s[s.tau <= 15]; sl = s[s.tau > 60]
        if len(f_) < 30 or len(sl) < 30:
