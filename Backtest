"""Replicate Rejection_Blocks_0630.pine exactly, then test whether it works."""
import pandas as pd, numpy as np, warnings; warnings.filterwarnings('ignore')

def htf(df, tf=15):
    r=df.resample(f'{tf}min',label='left',closed='left').agg(
        {'o':'first','h':'max','l':'min','c':'last','v':'sum'}).dropna()
    tr=pd.concat([r.h-r.l,(r.h-r.c.shift()).abs(),(r.l-r.c.shift()).abs()],axis=1).max(axis=1)
    r['atr']=tr.rolling(14).mean()
    r['vma']=r['v'].rolling(20).mean()
    return r

def blocks(r, tf=15, swing=2, min_wick=1.0, min_wick_pct=0.30):
    """identical scoring to the Pine. `known` = when the swing is CONFIRMED."""
    o,h,l,c,v=r['o'].values,r['h'].values,r['l'].values,r['c'].values,r['v'].values
    atr,vma=r['atr'].values,r['vma'].values; t=r.index; n=len(r); out=[]
    for p in range(swing, n-swing):
        bhi,blo=max(o[p],c[p]),min(o[p],c[p])
        body=max(abs(c[p]-o[p]),0.25); rng=max(h[p]-l[p],0.25)
        upw,dnw=h[p]-bhi,blo-l[p]
        w=range(p-swing,p+swing+1)
        isHi=all(h[q]<h[p] for q in w if q!=p); isLo=all(l[q]>l[p] for q in w if q!=p)
        strH=sum(1 for q in w if q!=p and h[q]<h[p]); strL=sum(1 for q in w if q!=p and l[q]>l[p])
        a=max(atr[p],0.25) if np.isfinite(atr[p]) else 0.25
        vm=max(vma[p],1.0) if np.isfinite(vma[p]) else 1.0
        known=t[p+swing]+pd.Timedelta(minutes=tf)
        if isHi and upw>min_wick*body and upw/rng>=min_wick_pct:
            sc=(upw/rng)+min(upw/a,2)/2+min(v[p]/vm,3)/3+strH/(swing*2)
            out.append(dict(known=known,top=h[p],bot=bhi,dir=-1,score=sc))
        if isLo and dnw>min_wick*body and dnw/rng>=min_wick_pct:
            sc=(dnw/rng)+min(dnw/a,2)/2+min(v[p]/vm,3)/3+strL/(swing*2)
            out.append(dict(known=known,top=blo,bot=l[p],dir=1,score=sc))
    return pd.DataFrame(out)

def lock_0630(df, B, lock_min=390, lookback_h=24, need_virgin=True, w_fresh=0.5):
    """pick the best bullish + bearish at 06:30 exactly as the indicator does."""
    m=(df.index.hour*60+df.index.minute).values
    picks=[]
    for day,g in df.groupby('daycycle',sort=True):
        gm=(g.index.hour*60+g.index.minute).values
        w=np.where(gm==lock_min)[0]
        if len(w)==0: continue
        T=g.index[w[0]]; px=g['c'].values[w[0]]
        cand=B[(B.known<=T)&(B.known>=T-pd.Timedelta(hours=lookback_h))].copy()
        if len(cand)==0: continue
        # mitigation: has price reached the block CE since it was confirmed?
        seg=df[(df.index>=T-pd.Timedelta(hours=lookback_h))&(df.index<=T)]
        mit=[]
        for _,b in cand.iterrows():
            s=seg[seg.index>=b.known]
            ce=(b.top+b.bot)/2
            mit.append(bool(len(s) and ((s['l']<=ce).any() if b.dir==1 else (s['h']>=ce).any())))
        cand['mit']=mit
        rank=np.argsort(cand.known.values)
        cand['fresh']=np.linspace(0,1,len(cand))[np.argsort(rank)]
        cand['S']=cand.score+w_fresh*cand.fresh
        for d in (1,-1):
            sub=cand[(cand.dir==d)]
            sub=sub[(sub.top<=px) if d==1 else (sub.bot>=px)]
            pool=sub[~sub.mit] if (need_virgin and (~sub.mit).any()) else sub
            if len(pool)==0: continue
            b=pool.loc[pool.S.idxmax()]
            picks.append(dict(day=day,t=T,dir=d,top=b.top,bot=b.bot,score=b.S,
                              px=px,dist=abs(px-((b.top+b.bot)/2)),virgin=not b.mit))
    return pd.DataFrame(picks)

