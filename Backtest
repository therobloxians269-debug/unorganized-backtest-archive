          f"{S[0]['date']}..{S[-1]['date']}")
    er_thr = None if a.gate == "drift" else a.er
    st = stats(run_cfg(S, a.gate, er_thr, a.atr, a.entries))
    ok, why = survives(st)
    print(f"\n===== PRE-REGISTERED CONFIG  gate={a.gate} er={er_thr} "
          f"atr_mult={a.atr} max_entries={a.entries} =====")
