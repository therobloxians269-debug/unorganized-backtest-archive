SLIP = 0.25          # 1 tick, market exits only
T830 = 8*3600 + 30*60
EOD = 15*3600 + 45*60

def _at(sod, O, tsec):
    idx = np.flatnonzero(sod == tsec)
    return O[idx[0]] if idx.size else np.nan

def manage(d, entry, stop, H, L, C, sod, s, mode):
    tgt = entry + d*3*STOP                       # 3R fixed target (limit)
    reached = False; maxfav = 0.0; n = len(H)
    for j in range(s, n):
        hi = H[j]; lo = L[j]
        if (lo <= stop) if d > 0 else (hi >= stop):
            return d*(stop-entry) - COMM - SLIP, "stop"
        if mode == "3R" and ((hi >= tgt) if d > 0 else (lo <= tgt)):
            return d*(tgt-entry) - COMM, "tp"    # limit fill: no exit slippage
        if mode == "time" and sod[j] >= 11*3600:
            return d*(C[j]-entry) - COMM - SLIP, "time"
        if sod[j] >= EOD:
            return d*(C[j]-entry) - COMM - SLIP, "eod"
        if mode == "trail":
            fav = (hi-entry) if d > 0 else (entry-lo)
            maxfav = max(maxfav, fav)
            if maxfav >= STOP:
                if not reached:
                    reached = True; stop = entry
                trail = entry + maxfav - STOP if d > 0 else entry - maxfav + STOP
                stop = max(stop, trail) if d > 0 else min(stop, trail)
    return d*(C[n-1]-entry) - COMM - SLIP, "eod"

def run(sessions, dayset, react_min, mag_thr, exit_mode, side=1):
    t_react = T830 + react_min*60
    rows = []
    for dte, a in sessions:
        wd = dte.weekday()
        isThu = wd == 3
        isNfp = wd == 4 and dte.day <= 7
        if dayset == "claims" and not isThu: continue
        if dayset == "nfp" and not isNfp: continue
        if dayset == "control" and (isThu or isNfp): continue
        O,H,L,C,sod = a["O"],a["H"],a["L"],a["C"],a["sod"]
        p0 = _at(sod, O, T830); p1 = _at(sod, O, t_react)
        if np.isnan(p0) or np.isnan(p1): continue
        react = p1 - p0
        if abs(react) < mag_thr: continue
        d = int(np.sign(react)) * side
        if d == 0: continue
        eidx = np.flatnonzero(sod == t_react)
        if not eidx.size: continue
        s = eidx[0]; entry = O[s]; stop = entry - d*STOP
        pts, kind = manage(d, entry, stop, H, L, C, sod, s, exit_mode)
        rows.append((dte, pts, kind))
    return pd.DataFrame(rows, columns=["date","pts","kind"])

def stats(tr):
    p = tr["pts"].to_numpy()
    eq = np.cumsum(p) * DPP
    dd = eq - np.maximum.accumulate(eq)
    mdd = dd.min() if len(dd) else 0.0
    tot = p.sum()*DPP
    return dict(n=len(p), net=tot, hit=(p>0).mean() if len(p) else 0,
                avgR=p.mean()/STOP if len(p) else 0, mdd=mdd,
                rr=(tot/abs(mdd)) if mdd < 0 else np.inf,
                ann=tot/(len(p)/252) if len(p) else 0)

def show(tr, name):
    if len(tr) < 10:
        print(f"{name:42s} n={len(tr):4d}  (too few)"); return None
    tr = tr.copy(); tr["yr"] = pd.to_datetime(tr["date"]).dt.year
    a = stats(tr); pre = stats(tr[tr.yr < 2020]); rec = stats(tr[tr.yr >= 2022])
    print(f"{name:42s} n={a['n']:4d} net=${a['net']:>7.0f} hit={a['hit']:.2f} "
          f"avgR={a['avgR']:+.3f} maxDD=${a['mdd']:>7.0f} ret/DD={a['rr']:>5.2f} "
          f"|pre20 net=${pre['net']:>6.0f} avgR={pre['avgR']:+.2f} |2022+ net=${rec['net']:>6.0f} avgR={rec['avgR']:+.2f}")
    return a

def main():
    S = ie.load()
    print(f"loaded {len(S)} sessions. STOP={STOP}pt=$20. friction: {COMM}pt comm +{SLIP}pt slip(market exits)\n")
    print("=== MOMENTUM (enter direction of 8:30->8:45 reaction), by exit & surprise filter ===")
    for exit_mode in ["3R","time","trail"]:
        for mag in [0.0, 4.0, 7.0]:
            show(run(S, "claims", 15, mag, exit_mode, side=1), f"claims mom {exit_mode} mag>{mag:.0f}")
        print()
    print("=== CONTROL: same on NON-catalyst days (edge must be the event) ===")
    for exit_mode in ["3R","trail"]:
        show(run(S, "control", 15, 4.0, exit_mode, side=1), f"control mom {exit_mode} mag>4")
    print("\n=== FADE check (should be worse if momentum is real) ===")
    show(run(S, "claims", 15, 4.0, "trail", side=-1), "claims FADE trail mag>4")
    print("\n=== NFP (first Friday) momentum ===")
    for exit_mode in ["3R","trail"]:
        show(run(S, "nfp", 15, 0.0, exit_mode, side=1), f"nfp mom {exit_mode}")

if __name__ == "__main__":
    main()

