#!/usr/bin/env python3
"""
sentinel_live.py — live Judas Swing Sentinel on Interactive Brokers.

Multi-threaded architecture
---------------------------
  [IB thread / asyncio loop]   ib_insync event loop owns ALL IB I/O: two
        |                      keepUpToDate 1-min bar subscriptions (MES,
        | completed 1m bars    MNQ), order placement, cancels, PnL feed.
        v                      (The IB socket API is not thread-safe;
  [strategy thread]            per-symbol socket threads is an anti-pattern
        |                      — everything touching `ib` is marshaled back
        | OrderIntents         to this loop via call_soon_threadsafe.)
        v
  [IB thread places bracket]   limit @ FVG 50% + OCA stop/target
  [risk thread]                clock-based force-flat, daily-loss kill
                               switch, heartbeat logging.

Safety defaults: connects to the PAPER port (7497). Pass --live for 7496.

Usage:
    python3 sentinel_live.py                  # paper
    python3 sentinel_live.py --live           # real money, know what you do
"""
from __future__ import annotations

import argparse
import datetime as dt
import logging
import queue
import threading
from zoneinfo import ZoneInfo

try:
    from ib_async import IB, ContFuture, MarketOrder, util   # maintained fork
except ImportError:
    from ib_insync import IB, ContFuture, MarketOrder, util  # original

from judas import Bar, Config, JudasSwingSentinel, OrderIntent
from judas.config import InstrumentSpec

ET = ZoneInfo("America/New_York")
log = logging.getLogger("sentinel")


# ----------------------------------------------------------------------
class LiveSentinel:
    def __init__(self, cfg: Config, host: str, port: int, client_id: int,
                 daily_loss_limit: float):
        self.cfg = cfg
        self.host, self.port, self.client_id = host, port, client_id
        self.daily_loss_limit = daily_loss_limit

        self.ib = IB()
        self.loop = None                       # asyncio loop (IB thread)
        self.bar_q: queue.Queue = queue.Queue()
        self.halt = threading.Event()          # kill switch: no new orders
        self.stop_all = threading.Event()      # full shutdown
        self.started_at = dt.datetime.now(ET)
        self.contracts = {}                    # symbol -> qualified Future
        self._bar_state = {}                   # symbol -> last emitted bar time

        self.sentinel = JudasSwingSentinel(cfg)
        self._sentinel_lock = threading.Lock()

    # ------------------------------------------------------------- IB thread
    def run(self) -> None:
        util.patchAsyncio()
        self.ib.connect(self.host, self.port, clientId=self.client_id)
        self.loop = util.getLoop()
        log.info("connected to IB %s:%d", self.host, self.port)

        for spec in (self.cfg.signal, self.cfg.reference):
            fut = self._front_month(spec.symbol)
            self.contracts[spec.symbol] = fut
            bars = self.ib.reqHistoricalData(
                fut, endDateTime="", durationStr="2 D", barSizeSetting="1 min",
                whatToShow="TRADES", useRTH=False, formatDate=2, keepUpToDate=True)
            # warm-up: replay history so 1H pools/structure exist at go-live
            for b in bars[:-1]:
                self._emit(spec.symbol, b, warmup=True)
            bars.updateEvent += self._make_on_update(spec.symbol, bars)
            log.info("%s -> %s, warmed up %d bars", spec.symbol,
                     fut.localSymbol, len(bars) - 1)

        self.ib.pnlEvent += self._on_pnl
        acct = self.ib.managedAccounts()[0]
        self.ib.reqPnL(acct)

        threading.Thread(target=self._strategy_worker, daemon=True,
                         name="strategy").start()
        threading.Thread(target=self._risk_worker, daemon=True,
                         name="risk").start()

        log.info("sentinel live — window %s-%s ET, flat %s ET",
                 self.cfg.window_start, self.cfg.window_end, self.cfg.flat_time)
        self.ib.run()                          # blocks; processes IB events

    def _front_month(self, symbol: str):
        cds = self.ib.reqContractDetails(ContFuture(symbol, exchange="CME"))
        if not cds:
            raise RuntimeError(f"no contract details for {symbol}")
        fut = cds[0].contract
        fut.secType = "FUT"                   # order-able concrete future
        (fut,) = self.ib.qualifyContracts(fut)
        return fut

    def _make_on_update(self, symbol: str, bars):
        def on_update(_, has_new_bar: bool):
            if has_new_bar and len(bars) >= 2:
                self._emit(symbol, bars[-2], warmup=False)  # completed bar
        return on_update

    def _emit(self, symbol: str, b, warmup: bool) -> None:
        ts = b.date if isinstance(b.date, dt.datetime) else dt.datetime.combine(
            b.date, dt.time())
        ts = ts.astimezone(ET)
        if self._bar_state.get(symbol) == ts:
            return
        self._bar_state[symbol] = ts
        self.bar_q.put((symbol, Bar(ts, b.open, b.high, b.low, b.close,
                                    float(b.volume)), warmup))

    # ------------------------------------------------------- strategy thread
    def _strategy_worker(self) -> None:
        while not self.stop_all.is_set():
            try:
                symbol, bar, warmup = self.bar_q.get(timeout=1.0)
            except queue.Empty:
                continue
            with self._sentinel_lock:
                intent = self.sentinel.on_bar(symbol, bar)
            if intent is None or warmup:
                continue
            if self.halt.is_set():
                log.warning("intent suppressed (halted): %s", intent.tag)
                continue
            log.info("INTENT %s side=%+d lmt=%.2f stp=%.2f tgt=%.2f | %s",
                     symbol, intent.side, intent.limit, intent.stop,
                     intent.target, intent.tag)
            self.loop.call_soon_threadsafe(self._place_bracket, intent)

    # ------------------------------------------------------------- IB thread
    def _place_bracket(self, it: OrderIntent) -> None:
        fut = self.contracts[self.cfg.signal.symbol]
        action = "BUY" if it.side > 0 else "SELL"
        qty = self.cfg.contracts
        bracket = self.ib.bracketOrder(action, qty, limitPrice=it.limit,
                                       takeProfitPrice=it.target,
                                       stopLossPrice=it.stop)
        for o in bracket:
            o.outsideRth = True
            o.tif = "DAY"
        trades = [self.ib.placeOrder(fut, o) for o in bracket]
        parent = trades[0]
        log.info("bracket placed: %s %d @ %.2f (tp %.2f / sl %.2f)",
                 action, qty, it.limit, it.target, it.stop)

        def cancel_if_unfilled():
            if parent.orderStatus.status not in ("Filled", "Cancelled",
                                                 "ApiCancelled"):
                log.info("TTL expired, cancelling unfilled parent")
                self.ib.cancelOrder(parent.order)
        self.loop.call_later(it.ttl_bars * 60, cancel_if_unfilled)

    def _flatten(self, why: str) -> None:
        log.warning("FLATTEN (%s)", why)
        for tr in self.ib.openTrades():
            self.ib.cancelOrder(tr.order)
        for pos in self.ib.positions():
            if pos.contract.symbol not in self.contracts:
                continue
            side = "SELL" if pos.position > 0 else "BUY"
            self.ib.placeOrder(pos.contract,
                               MarketOrder(side, abs(int(pos.position))))

    # ------------------------------------------------------------ risk thread
    def _on_pnl(self, pnl) -> None:
        if (self.daily_loss_limit and pnl.dailyPnL is not None
                and pnl.dailyPnL <= -abs(self.daily_loss_limit)
                and not self.halt.is_set()):
            self.halt.set()
            log.error("DAILY LOSS LIMIT hit (%.2f) — halting + flattening",
                      pnl.dailyPnL)
            self.loop.call_soon_threadsafe(self._flatten, "daily loss limit")

    def _risk_worker(self) -> None:
        flat_h, flat_m = map(int, self.cfg.flat_time.split(":"))
        flattened_for = None
        while not self.stop_all.is_set():
            now = dt.datetime.now(ET)
            if (now.hour, now.minute) >= (flat_h, flat_m) and \
                    flattened_for != now.date():
                flattened_for = now.date()
                self.loop.call_soon_threadsafe(self._flatten, "flat time")
            if now.minute % 15 == 0 and now.second < 5:
                log.info("heartbeat: connected=%s halted=%s qsize=%d",
                         self.ib.isConnected(), self.halt.is_set(),
                         self.bar_q.qsize())
            self.stop_all.wait(5.0)


# ----------------------------------------------------------------------
def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--host", default="127.0.0.1")
    ap.add_argument("--live", action="store_true",
                    help="connect to LIVE port 7496 (default: paper 7497)")
    ap.add_argument("--port", type=int, default=None)
    ap.add_argument("--client-id", type=int, default=17)
    ap.add_argument("--signal", default="MES")
    ap.add_argument("--reference", default="MNQ")
    ap.add_argument("--contracts", type=int, default=1)
    ap.add_argument("--daily-loss-limit", type=float, default=200.0,
                    help="halt + flatten if daily PnL <= -limit ($)")
    args = ap.parse_args()

    logging.basicConfig(level=logging.INFO,
                        format="%(asctime)s %(threadName)-9s %(levelname)-7s %(message)s")

    specs = {"MES": InstrumentSpec("MES", 0.25, 5.0),
             "MNQ": InstrumentSpec("MNQ", 0.25, 2.0),
             "MYM": InstrumentSpec("MYM", 1.0, 0.5)}
    cfg = Config(signal=specs[args.signal], reference=specs[args.reference],
                 contracts=args.contracts)

    port = args.port or (7496 if args.live else 7497)
    if args.live:
        log.warning("LIVE TRADING port %d — real money.", port)

    LiveSentinel(cfg, args.host, port, args.client_id,
