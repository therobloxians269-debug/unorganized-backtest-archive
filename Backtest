"""The catch and the payoff. Given the IB breaks UP at ~10:30, the IB low is the day's low
~72-80% of the time — but that low is BEHIND you. What is actually harvestable, and is the
'opposite side holds' number informative or just mechanical?"""
import numpy as np, pandas as pd, pickle, warnings; warnings.filterwarnings('ignore')
SCR='/private/tmp/claude-501/-Users-kaveh/d5ce5738-dd59-4ca2-bd9c-e9b02fe3107c/scratchpad'
esday,esrth,nqday,nqrth=pickle.load(open(f'{SCR}/ladder_feats.pkl','rb'))
for D,RT,tag,pv in [(esday,esrth,'ES',5.0),(nqday,nqrth,'NQ',2.0)]:
    rows=[]
    for d,b in RT.groupby('day'):
        if len(b)<300: continue
        H=b['high'].values; L=b['low'].values; C=b['close'].values; T=b['tod'].values
        ib=T<630
        if ib.sum()<48: continue
        ibh=H[ib].max(); ibl=L[ib].min(); ibr=ibh-ibl
        if ibr<=0: continue
        post=np.flatnonzero(~ib)
        up=[i for i in post if H[i]>=ibh]; dn=[i for i in post if L[i]<=ibl]
        iu=up[0] if up else 10**9; idn=dn[0] if dn else 10**9
        if min(iu,idn)==10**9: continue
        upfirst = iu<idn
        k=min(iu,idn)
        rest_h=H[k:].max(); rest_l=L[k:].min()
        if upfirst:
            run=(rest_h-ibh)/ibr                 # extension beyond the IB, in IB units
            adverse=(ibh-rest_l)/ibr             # how far back it came, in IB units
            held = rest_l>ibl
        else:
            run=(ibl-rest_l)/ibr
            adverse=(rest_h-ibl)/ibr
            held = rest_h<ibh
        rows.append(dict(day=d,upfirst=upfirst,run=run,adverse=adverse,held=held,ibr=ibr,
                         mins_left=390-(T[k]-570)))
    R=pd.DataFrame(rows)
    print(f'=== {tag}  n={len(R)} · at the IB break (median {R.mins_left.median():.0f} min left) ===')
    print(f'  P(opposite IB edge holds all day)      {R.held.mean()*100:5.1f}%')
    print(f'  extension beyond the IB, in IB units:  median {R.run.median():.2f}  mean {R.run.mean():.2f}  '
          f'P(>=0.5) {(R.run>=0.5).mean()*100:.0f}%  P(>=1.0) {(R.run>=1.0).mean()*100:.0f}%')
    print(f'  adverse move back toward the IB:       median {R.adverse.median():.2f} IB  '
          f'P(retraces >=0.5 IB) {(R.adverse>=0.5).mean()*100:.0f}%  P(>=1.0 = full giveback) {(R.adverse>=1.0).mean()*100:.0f}%')
    # the honest question: is "held" informative, or just what a random walk does?
    # null = symmetric barrier from the break point: distance to opposite edge is 1.0 IB
    print(f'  --> risking the full IB (stop at the far edge) to make the extension:')
    for tgt in [0.5,1.0,1.5]:
        winr=(R.run>=tgt)&(R.held)
        # first-touch approximation: winner needs target before the far edge
        ev=(winr.mean()*tgt - (1-winr.mean())*1.0)
        print(f'      target {tgt:.1f} IB · stop 1.0 IB : hit {winr.mean()*100:5.1f}%  EV {ev:+.3f} IB  '
              f'= {ev*R.ibr.median()*pv:+7.2f} $/trade at 1 micro')
    print()

