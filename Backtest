#!/usr/bin/env python3
"""OCEAN_BOOK — FORWARD-TEST HARNESS (paper). NO CONFIRMED LIVE EDGE.

The 14-family OCEAN search produced ZERO confirmed candidates. This book is the
honest fallback: the single strongest record (f08_swing_donchian, best holdout
MAR of the two families that reached holdout; verdict was still DIES) wrapped in
maximum-survival overlays for a $1,000 account trading 1 MES ($5/pt).

BASE STRATEGY (f08 pre-registered config, unchanged):
  LONG-ONLY Donchian swing on RTH session closes. Enter long 1 MES at the 16:00
  session close when close > max of the prior N=20 session HIGHS. Exit at the
  16:00 close when close < min of the prior M=10 session LOWS, or after K=20
  sessions held. One position at a time; no same-session re-entry.

SURVIVAL OVERLAYS (book level; the only additions to the base rules):
  1. HARD DAILY STOP: while holding, a resting stop each session at
     prior_session_close - daily_stop_usd/$5 pts (entry price on the first
     session after entry). Gap through the stop fills at the RTH open (worse).
     Swept over {$100, $150}; chosen by MC survival.
  2. MONTHLY BREAKER: if month-to-date book P&L <= -breaker_usd at any session
     close, flatten at that close and take no entries until the next calendar
     month. Swept over {$100, $150}; chosen by MC survival.
  3. ACCOUNT FLOOR $400: if equity <= $400 at a session close, flatten and halt
     permanently. (Applied inside every MC path; reported for the historical
     path from a $1,000 start.)

MONTE CARLO: stationary block bootstrap (mean block 10 sessions) of the
overlay-applied daily book P&L (full 2010-2026 sample), 4000 paths x 250
sessions from $1,000. P(ruin) = path touches <= $400. P(under) = final equity
< $1,000. Overlay combo chosen to minimize P(ruin), then P(under), then max
holdout net.

PRE-REGISTERED FORWARD-TEST GATE (60 trading days, paper):
  net > $0 after friction AND maxDD > -$250, else ABANDON.
"""
import sys, os, json, datetime as dt
import numpy as np
sys.path.insert(0, "/Users/kaveh/mes_mim")
import omni2_lib as L
from omni2_lib import DPP

START_EQ = 1000.0
FLOOR = 400.0
ENTRY_FRIC = 0.41          # pts: 0.16 comm + 0.25 slip (market entry at close)
EXIT_FRIC = 0.25           # pts: 0.25 slip (market exit; comm charged once RT)
N, M, K = 20, 10, 20       # Donchian params (M = N//2, family spec)
HOLDOUT_START = dt.date(2023, 1, 1)
DAILY_STOP_GRID = (100.0, 150.0)
BREAKER_GRID = (100.0, 150.0)
MC_PATHS, MC_HORIZON, MC_BLOCK, MC_SEED = 4000, 250, 10, 20260709
GATE_DAYS, GATE_DD = 60, -250.0
RESULTS_DIR = "/Users/kaveh/mes_mim/ocean/results"


def build_daily(S):
    return dict(dates=np.array([s["date"] for s in S]),
                o=np.array([s["o"][0] for s in S]),
                h=np.array([s["h"].max() for s in S]),
                l=np.array([s["l"].min() for s in S]),
                c=np.array([s["c"][-1] for s in S]))


def run_book(D, daily_stop_usd, breaker_usd):
    """Full-sample book sim with overlays 1+2 (floor handled separately).
    Returns (dates, daily P&L $ array, trades list)."""
    dates, o, h, l, c = D["dates"], D["o"], D["h"], D["l"], D["c"]
    n = len(dates)
    stop_pts = daily_stop_usd / DPP
    pnl = np.zeros(n)
    trades = []
    pos = 0; entry_px = np.nan; entry_i = -1
    cur_month = None; mtd = 0.0; blocked = False
    for t in range(N, n):
        mo = (dates[t].year, dates[t].month)
        if mo != cur_month:
            cur_month = mo; mtd = 0.0; blocked = False
        day = 0.0; acted = False           # acted = any exit/entry this session
        if pos != 0:
            ref = c[t - 1]                 # prior close = daily mark reference
            stop_px = ref - stop_pts       # long-only book
            if o[t] <= stop_px or l[t] <= stop_px:
                fill = min(o[t], stop_px)  # gap through stop -> open fill
                day += (fill - ref) * DPP - EXIT_FRIC * DPP
                trades.append(dict(edate=dates[entry_i], xdate=dates[t], kind="daily_stop",
                                   net_usd=(fill - entry_px - ENTRY_FRIC - EXIT_FRIC) * DPP))
                pos = 0; acted = True
            else:
                day += (c[t] - ref) * DPP
                held = t - entry_i
                sig_exit = c[t] < l[t - M:t].min()
                if sig_exit or held >= K or t == n - 1:
                    day -= EXIT_FRIC * DPP
                    trades.append(dict(edate=dates[entry_i], xdate=dates[t],
                                       kind="signal" if sig_exit else ("time" if held >= K else "eow"),
                                       net_usd=(c[t] - entry_px - ENTRY_FRIC - EXIT_FRIC) * DPP))
                    pos = 0; acted = True
        # monthly breaker check at the close, after the day's P&L is known
        if mtd + day <= -breaker_usd:
            if pos != 0:                   # flatten at this close (already marked to close)
                day -= EXIT_FRIC * DPP
                trades.append(dict(edate=dates[entry_i], xdate=dates[t], kind="breaker",
                                   net_usd=(c[t] - entry_px - ENTRY_FRIC - EXIT_FRIC) * DPP))
                pos = 0; acted = True
            blocked = True
        # entry at the close (never on a session with an exit; never when blocked)
        if pos == 0 and not acted and not blocked and t < n - 1 and c[t] > h[t - N:t].max():
            pos = 1; entry_px = c[t]; entry_i = t
            day -= ENTRY_FRIC * DPP
        mtd += day
        pnl[t] = day
    return dates, pnl, trades


def window_stats(dates, pnl, start=None):
    m = np.ones(len(dates), dtype=bool) if start is None else np.array([d >= start for d in dates])
    p = pnl[m]
    eq = np.cumsum(p)
    dd = float((eq - np.maximum.accumulate(eq)).min()) if len(eq) else 0.0
    net = float(p.sum())
    mar = net / abs(dd) if dd < 0 else float("inf")
    min_eq_from_1k = float(START_EQ + eq.min()) if len(eq) else START_EQ
    return dict(net_usd=round(net, 2), maxdd_usd=round(dd, 2), mar=round(mar, 3),
                sessions=int(m.sum()), min_equity_from_1000=round(min_eq_from_1k, 2))


def monte_carlo(pnl, rng):
    """Stationary block bootstrap of daily book P&L. Floor halt inside paths."""
    src = pnl[N:]                          # drop warmup zeros
    n = len(src)
    ruin = 0; under = 0; gate_fail = 0
    finals = np.empty(MC_PATHS)
    for p in range(MC_PATHS):
        path = np.empty(MC_HORIZON); i = 0
        while i < MC_HORIZON:
            start = rng.integers(0, n)
            blen = min(1 + rng.geometric(1.0 / MC_BLOCK), MC_HORIZON - i)
            idx = (start + np.arange(blen)) % n
            path[i:i + blen] = src[idx]; i += blen
        eq = START_EQ + np.cumsum(path)
        hit = np.nonzero(eq <= FLOOR)[0]
        if len(hit):                       # halt at floor: freeze equity after touch
            ruin += 1
            eq[hit[0]:] = eq[hit[0]]
        finals[p] = eq[-1]
        if eq[-1] < START_EQ:
            under += 1
        g = np.cumsum(path[:GATE_DAYS])
        gdd = (g - np.maximum.accumulate(g)).min()
        if not (g[-1] > 0 and gdd > GATE_DD):
            gate_fail += 1
    return dict(p_ruin=round(ruin / MC_PATHS, 4), p_under=round(under / MC_PATHS, 4),
                p_gate_fail_60d=round(gate_fail / MC_PATHS, 4),
                median_final=round(float(np.median(finals)), 2),
                p5_final=round(float(np.percentile(finals, 5)), 2),
                p95_final=round(float(np.percentile(finals, 95)), 2))


def main():
    S = L.load()
    D = build_daily(S)
    print("OCEAN_BOOK — FORWARD-TEST HARNESS (paper). NO CONFIRMED LIVE EDGE.")
    print(f"sessions: {len(D['dates'])}  {D['dates'][0]} .. {D['dates'][-1]}")
    print(f"base = f08_swing_donchian L-only N={N} M={M} K={K} (holdout verdict was DIES; "
          f"this book exists only to run the pre-registered 60-day forward test)\n")

    # baseline (no overlays) for reference
    dts, pnl0, tr0 = run_book(D, daily_stop_usd=1e12, breaker_usd=1e12)
    b_all = window_stats(dts, pnl0); b_ho = window_stats(dts, pnl0, HOLDOUT_START)
    print(f"baseline (no overlays): ALL net ${b_all['net_usd']:+.0f} maxDD ${b_all['maxdd_usd']:.0f} "
          f"MAR {b_all['mar']:.2f} | HOLDOUT net ${b_ho['net_usd']:+.0f} maxDD ${b_ho['maxdd_usd']:.0f} "
          f"MAR {b_ho['mar']:.2f}\n")

    # overlay sweep, each scored by its own MC (fixed seed per combo for fairness)
    print(f"{'dstop':>6} {'brk':>6} | {'ALLnet':>8} {'ALLdd':>8} {'MAR':>6} | {'HOnet':>8} {'HOdd':>8} "
          f"{'HOmar':>6} | {'P(ruin)':>8} {'P(under)':>8} {'P(gateF)':>8} {'medFin':>8}")
    rows = []
    for ds in DAILY_STOP_GRID:
        for bk in BREAKER_GRID:
            dts, pnl, tr = run_book(D, ds, bk)
            sa = window_stats(dts, pnl); sh = window_stats(dts, pnl, HOLDOUT_START)
            mc = monte_carlo(pnl, np.random.default_rng(MC_SEED))
            rows.append(dict(daily_stop=ds, breaker=bk, all=sa, holdout=sh, mc=mc,
                             trades=len(tr), stop_exits=sum(1 for x in tr if x["kind"] == "daily_stop"),
                             breaker_exits=sum(1 for x in tr if x["kind"] == "breaker")))
            print(f"{ds:6.0f} {bk:6.0f} | {sa['net_usd']:8.0f} {sa['maxdd_usd']:8.0f} {sa['mar']:6.2f} | "
                  f"{sh['net_usd']:8.0f} {sh['maxdd_usd']:8.0f} {sh['mar']:6.2f} | "
                  f"{mc['p_ruin']:8.4f} {mc['p_under']:8.4f} {mc['p_gate_fail_60d']:8.4f} {mc['median_final']:8.0f}")

    # selection: min P(ruin) at MC-noise granularity (1 SE ~ sqrt(p(1-p)/paths) ~ 0.006,
    # so P(ruin) is bucketed to 0.01 — differences inside one SE are ties), then min
    # P(under), then max holdout net.
