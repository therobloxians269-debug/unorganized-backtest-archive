"""Verify the primitives before trusting any backtest number."""
import numpy as np
import pandas as pd
import qtlib as Q

PASS, FAIL = [], []


def check(name, cond, extra=""):
    (PASS if cond else FAIL).append(name)
    print(f"  {'PASS' if cond else 'FAIL'}  {name}{'  ' + extra if extra else ''}")


def mk(opens, closes, highs=None, lows=None, prefix="nq"):
    n = len(opens)
    idx = pd.date_range("2024-01-02 09:30", periods=n, freq="1min", tz=Q.NY)
    highs = highs or [max(o, c) for o, c in zip(opens, closes)]
    lows = lows or [min(o, c) for o, c in zip(opens, closes)]
    return pd.DataFrame({f"{prefix}_open": opens, f"{prefix}_close": closes,
                         f"{prefix}_high": highs, f"{prefix}_low": lows}, index=idx)


print("\n--- QT clock: block_start_min (90m blocks off the 18:00 day start) ---")
for tmin, want, lbl in [(18*60, 18*60, "18:00->18:00"), (19*60, 18*60, "19:00->18:00"),
                        (19*60+30, 19*60+30, "19:30->19:30"), (0, 0, "00:00->00:00"),
                        (6*60, 6*60, "06:00->06:00"), (7*60+29, 6*60, "07:29->06:00"),
                        (7*60+30, 7*60+30, "07:30->07:30"), (9*60, 9*60, "09:00->09:00"),
                        (10*60+30, 10*60+30, "10:30->10:30")]:
    check(f"block {lbl}", Q.block_start_min(tmin) == want, f"got {Q.block_start_min(tmin)}")

print("\n--- QT clock: true opens are the Q2 opens ---")
check("TDO == 00:00", Q.TDO_MIN == 0)
check("TNY == 07:30 (Q2 of the 06:00-12:00 NY session)", Q.TNY_MIN == 450)
check("TNY_ALT == 09:30 (the variant he stated)", Q.TNY_ALT == 570)
check("TMSO(07:30 block) == 07:52.5", Q.tmso_min(7*60+35) == 450 + 22.5,
      f"got {Q.tmso_min(7*60+35)}")
check("09:30 is NOT a 90m block open (it sits inside Q3)", Q.block_start_min(570) == 540,
      f"block of 09:30 = {Q.block_start_min(570)} (09:00)")

print("\n--- CISD: bearish = close below the open of the first candle of the up-run ---")
# up,up,up then a down bar closing below the first up-open
b = mk([100, 101, 102, 103], [101, 102, 103, 99])
s = Q.cisd(b, "short").to_numpy()
check("fires on close below run open", s.tolist() == [False, False, False, True], f"{s.tolist()}")

# down bar that does NOT break the level -> no signal, level stays armed
b = mk([100, 101, 102, 103], [101, 102, 103, 100.5])
check("no fire when close stays above the level", not Q.cisd(b, "short").any())

# wick below the level but body close above -> must NOT fire (wicks are ignored)
b = mk([100, 101, 102, 103], [101, 102, 103, 100.5], lows=[100, 101, 102, 95])
check("wick through level does NOT fire (bodies only)", not Q.cisd(b, "short").any())

# a fresh up-run re-arms the level higher
b = mk([100, 101, 105, 106, 107], [101, 100.5, 106, 107, 105.5])
s = Q.cisd(b, "short").to_numpy()
check("re-arms at the new run's open (105), fires at close 105.5<106? no; check idx",
      s.tolist() == [False, False, False, False, False], f"{s.tolist()}")
b = mk([100, 101, 105, 106, 107], [101, 100.5, 106, 107, 104.9])
check("fires once the new run's open is broken", Q.cisd(b, "short").to_numpy()[-1])

# bullish mirror
b = mk([100, 99, 98, 97], [99, 98, 97, 101])
check("bullish CISD mirrors", Q.cisd(b, "long").to_numpy().tolist() == [False, False, False, True])

print("\n--- SSMT: NQ takes its extreme, reference does not ---")
n = 20
idx = pd.date_range("2024-01-02 09:30", periods=n, freq="15min", tz=Q.NY)
base = np.arange(n, dtype=float)
d = pd.DataFrame(index=idx)
for p in ("nq", "es", "ym"):
    d[f"{p}_high"] = 100 + base * 0
    d[f"{p}_low"] = 90 + base * 0
d.iloc[-1, d.columns.get_loc("nq_high")] = 105        # NQ makes a new high
check("bear SSMT when NQ HH and refs flat", Q.ssmt(d, 12, "short").iloc[-1])
d.iloc[-1, d.columns.get_loc("es_high")] = 106        # ES confirms
d.iloc[-1, d.columns.get_loc("ym_high")] = 106
check("no bear SSMT when both refs confirm", not Q.ssmt(d, 12, "short").iloc[-1])
check("require_both=True is stricter",
      not Q.ssmt(d, 12, "short", require_both=True).iloc[-1])

print("\n--- data alignment (the close-stamp fix) ---")
df = Q.load_data(verbose=False).iloc[:400_000]
er = np.log(df["es_close"]).diff()
nr = np.log(df["nq_close"]).diff()
yr = np.log(df["ym_close"]).diff()
c_now, c_ym = er.corr(nr), er.corr(yr)
check("corr(es,nq) same-bar > 0.8 after fix", c_now > 0.8, f"corr={c_now:.4f}")
check("corr(es,nq) >= corr(es,ym) control", c_now >= c_ym - 0.02,
      f"nq={c_now:.4f} ym={c_ym:.4f}")
for k in (-2, -1, 1, 2):
    ck = er.corr(np.log(df["nq_close"].shift(k)).diff())
    check(f"lag {k:+d} is dead (no residual offset)", abs(ck) < 0.2, f"corr={ck:.4f}")

print("\n--- OHLC sanity on the live frame ---")
for p in ("es", "nq", "ym"):
    bad = ((df[f"{p}_low"] > df[f"{p}_open"]) | (df[f"{p}_low"] > df[f"{p}_close"]) |
           (df[f"{p}_high"] < df[f"{p}_open"]) | (df[f"{p}_high"] < df[f"{p}_close"])).sum()
    check(f"{p} OHLC consistent", bad == 0, f"{bad} bad bars")

print("\n--- true opens attach correctly ---")
d2 = Q.add_true_opens(df.iloc[:200_000])
day = d2[d2["sdate"] == sorted(d2["sdate"].unique())[3]]
mid = day[day["tmin"] == 0]
check("TDO equals the 00:00 bar open", np.isclose(day["tdo"].iloc[0], mid["nq_open"].iloc[0]),
      f"tdo={day['tdo'].iloc[0]} open@00:00={mid['nq_open'].iloc[0]}")
n730 = day[day["tmin"] == 450]
check("TNY equals the 07:30 bar open", np.isclose(day["tny"].iloc[0], n730["nq_open"].iloc[0]))
check("TDO is constant within a session day", day["tdo"].nunique() == 1)
check("TMSO varies within a day (rolling micro open)", day["tmso"].nunique() > 5,
      f"{day['tmso'].nunique()} distinct")

print("\n--- null scrambler preserves marginals, destroys co-movement ---")
sc = Q.scramble_references(df.iloc[:200_000])
real = np.log(df["es_close"].iloc[:200_000]).diff().corr(np.log(df["nq_close"].iloc[:200_000]).diff())
null = np.log(sc["es_close"]).diff().corr(np.log(sc["nq_close"]).diff())
check("scramble kills es/nq correlation", abs(null) < 0.15, f"real={real:.3f} null={null:.3f}")
rs = df["es_close"].iloc[:200_000].std()
check("scramble preserves ES marginal scale", abs(sc["es_close"].std() / rs - 1) < 0.35,
      f"real_sd={rs:.1f} null_sd={sc['es_close'].std():.1f}")

print(f"\n{'='*60}\n  {len(PASS)} passed, {len(FAIL)} failed")
if FAIL:
    print("  FAILURES:", FAIL)

