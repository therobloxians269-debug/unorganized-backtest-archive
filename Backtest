"""Reproducibility utilities: deterministic seeding and run manifests.

Capturing the resolved config alongside the exact runtime environment (interpreter,
platform, key package versions, git commit if available) makes any result auditable
and repeatable -- a hard requirement for research validity.
"""
from __future__ import annotations

import json
import os
import platform
import random
import subprocess
import sys
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

from ope.paths import outputs_dir, project_root

_KEY_PACKAGES = (
    "numpy", "pandas", "scipy", "pyarrow", "yfinance", "matplotlib",
)


def set_seeds(seed: int) -> None:
    """Seed Python's ``random`` and NumPy (if installed) for determinism.

    ``PYTHONHASHSEED`` affects hash randomization and can only be fixed before
    interpreter start; set it in the environment for byte-for-byte reproducibility.
    """
    random.seed(seed)
    try:
        import numpy as np

        np.random.seed(seed)
    except ModuleNotFoundError:
        pass


def _package_versions() -> dict[str, str]:
    from importlib.metadata import PackageNotFoundError, version

    versions: dict[str, str] = {}
    for pkg in _KEY_PACKAGES:
        try:
            versions[pkg] = version(pkg.replace("_", "-"))
        except PackageNotFoundError:
            versions[pkg] = "not installed"
    return versions


def _git_commit() -> str | None:
    try:
        result = subprocess.run(
            ["git", "rev-parse", "HEAD"],
            cwd=project_root(),
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    return result.stdout.strip() if result.returncode == 0 else None


def capture_environment() -> dict[str, Any]:
    """Snapshot the runtime environment for the manifest."""
    return {
        "timestamp_utc": datetime.now(timezone.utc).isoformat(),
        "python_version": sys.version.split()[0],
        "platform": platform.platform(),
        "machine": platform.machine(),  # 'arm64' on Apple Silicon
        "processor": platform.processor(),
        "pythonhashseed": os.environ.get("PYTHONHASHSEED", "unset"),
        "git_commit": _git_commit(),
        "packages": _package_versions(),
    }


@dataclass
class RunManifest:
    """Resolved config + environment, persisted for reproducibility."""

    run_name: str
    seed: int
    config: dict[str, Any]
    environment: dict[str, Any]

    @classmethod
    def create(cls, run_name: str, seed: int, config: dict[str, Any]) -> RunManifest:
        return cls(run_name=run_name, seed=seed, config=config, environment=capture_environment())

    def to_dict(self) -> dict[str, Any]:
        return {
            "run_name": self.run_name,
            "seed": self.seed,
            "config": self.config,
            "environment": self.environment,
        }

    def save(self, path: str | Path | None = None) -> Path:
        """Write the manifest as JSON (defaults to ``outputs/<run_name>_manifest.json``)."""
        target = Path(path) if path is not None else outputs_dir() / f"{self.run_name}_manifest.json"
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(json.dumps(self.to_dict(), indent=2, sort_keys=True))
        return target

