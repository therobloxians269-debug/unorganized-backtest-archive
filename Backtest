"""M1 GROUND-TRUTH SCREEN: does transient impact (high displacement-per-volume) revert?
Design guards:
  - forward return starts at o[i+1], NOT c[i]  -> no bid-ask-bounce artifact
  - time-of-day expectations are TRAILING ONLY (rolling 60 prior sessions, shifted)
  - impulses never cross session boundaries
  - key test is CONDITIONAL: within big moves, does lambda sort the outcome?
  - placebo shuffles lambda within time-of-day bucket (same conditioning subset)
"""
import pandas as pd, numpy as np
from m0_data import load, NQ

d = load(NQ)
d['sid'] = d.date.factorize()[0]
g = d.groupby('sid', sort=False)

def tod_expect(series, tod, date, win=60):
    """Trailing per-minute-of-day mean over prior `win` sessions. No lookahead."""
    piv = pd.DataFrame({'v': series.values, 'tod': tod.values, 'date': date.values}) \
            .pivot_table(index='date', columns='tod', values='v', aggfunc='mean')
    exp = piv.rolling(win, min_periods=20).mean().shift(1)
    s = exp.stack().rename('e').reset_index()
    key = pd.DataFrame({'date': date.values, 'tod': tod.values})
    return key.merge(s, on=['date','tod'], how='left')['e'].values

rows = []
for k in (5, 10, 15, 20):
    disp = g['c'].transform(lambda s: s - s.shift(k))
    vol  = g['v'].transform(lambda s: s.rolling(k).sum())
    e_d  = tod_expect(disp.abs(), d.tod, d.date)
    e_v  = tod_expect(vol,        d.tod, d.date)
    dn   = disp.abs().values / e_d          # move size vs normal for this minute
    vn   = vol.values / e_v                 # volume vs normal for this minute
    lam  = dn / vn                          # points per unit volume, vs normal
    for m in (10, 20, 30, 60):
        nxt_o = g['o'].transform(lambda s: s.shift(-1))
        fwd_c = g['c'].transform(lambda s: s.shift(-m))
        # signed AGAINST the impulse: positive = the move reverted
        rev = -np.sign(disp.values) * (fwd_c.values - nxt_o.values)
        rows.append(pd.DataFrame(dict(k=k, m=m, date=d.date.values, tod=d.tod.values,
                                      dn=dn, vn=vn, lam=lam, rev=rev,
                                      sgn=np.sign(disp.values))))
R = pd.concat(rows, ignore_index=True).replace([np.inf,-np.inf], np.nan).dropna()
R = R[R.sgn != 0]
R.to_parquet('screen.parquet')
print(f'screen rows={len(R):,}\n')

def clustered_t(df, col='rev'):
    """t-stat with SE clustered by session (memory: trade-level SE is 5-9x too small)."""
    daily = df.groupby('date')[col].mean()
    n = len(daily)
    return daily.mean(), daily.mean()/(daily.std(ddof=1)/np.sqrt(n)) if n > 2 else np.nan, n

print('=== A. Does size alone predict reversion? (all lambda) ===')
for (k,m), sub in R.groupby(['k','m']):
    big = sub[sub.dn >= sub.dn.quantile(0.90)]
    mu, t, n = clustered_t(big)
    print(f'  k={k:2d} m={m:2d}  top-decile MOVE SIZE: rev={mu:+7.3f} pts  t={t:+6.2f}  n={len(big):,}')

print('\n=== B. THE REAL TEST: within big moves, does LAMBDA sort it? ===')
print('    (quintiles of displacement-per-volume, inside the top-decile-size subset)')
for (k,m), sub in R.groupby(['k','m']):
    big = sub[sub.dn >= sub.dn.quantile(0.90)].copy()
    big['q'] = pd.qcut(big.lam, 5, labels=False, duplicates='drop')
    line = []
    for q in sorted(big.q.dropna().unique()):
        mu, t, _ = clustered_t(big[big.q==q]); line.append(f'{mu:+6.2f}')
    lo = big[big.q==0]; hi = big[big.q==big.q.max()]
    sprd = hi.groupby('date').rev.mean().mean() - lo.groupby('date').rev.mean().mean()
    j = hi.groupby('date').rev.mean().align(lo.groupby('date').rev.mean(), join='inner')
    dif = (j[0]-j[1]); tsp = dif.mean()/(dif.std(ddof=1)/np.sqrt(len(dif)))
    print(f'  k={k:2d} m={m:2d}  Q1..Q5 rev pts: [{" ".join(line)}]   Q5-Q1={sprd:+6.2f} t={tsp:+5.2f}')

