"""PERSONAL-ACCOUNT maximizer (not the fund product). Levers the v3 program to a chosen
drawdown budget. Static leverage scales return+DD together; the DRAWDOWN-CONTROL overlay
(de-lever toward a DD cap, re-lever at high-water) improves return-per-drawdown (Calmar).
RECOMMENDED: ~3-4x + DD-control@30% -> ~40% backtest CAGR / -25% DD (live haircut: ~25-35%).
RISK: leverage multiplies the venue tail (FTX-class -12% unlevered -> -48% at 4x); the
overlay de-levers weekly and CANNOT stop an overnight venue death -> diversify venues,
don't max leverage, keep carry delta-neutral. Run: PYTHONPATH=. python3 personal_max.py"""
import numpy as np, pandas as pd
from tear_sheet import build_v3
port,_ = build_v3(); w = port.resample("W").sum().dropna(); bv = w.std()*np.sqrt(52)
def st(r): 
    eq=(1+r).cumprod(); return eq.iloc[-1]**(52/len(r))-1, (eq/eq.cummax()-1).min(), r.mean()/r.std()*np.sqrt(52)
print(f"base vol {bv*100:.1f}%")
print("static leverage:")
for L in (1,2,3,4,5):
    c,d,s=st(w*L); print(f"  {L}x: CAGR {c*100:.0f}% maxDD {d*100:.0f}% Sharpe {s:.2f}")
print("drawdown-control overlay:")
for Lmax,cap in [(3,.25),(4,.30),(5,.30)]:
    eq=1.;hwm=1.;rs=[]
    for ret in w.values:
        L=Lmax*max(0,1-(-(eq/hwm-1))/cap); rs.append(L*ret); eq*=(1+L*ret); hwm=max(hwm,eq)
    c,d,s=st(pd.Series(rs)); print(f"  {Lmax}x@{cap*100:.0f}%: CAGR {c*100:.0f}% maxDD {d*100:.0f}% Calmar {c/abs(d):.2f}")

