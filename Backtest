#!/usr/bin/env python3
"""OCEAN family f05_prevday_levels — prior-day level engine on real ES 5m RTH.

Two branches:
  A breakout continuation: first 5m close crossing beyond prev_hi (long) /
    prev_lo (short) with ER(24) >= er_thr confirmation; ATR stop; ride to EOD.
  B rejection fade: bar pierces prev_lo intrabar by >= pierce_min*ATR but closes
    back above it (prior bar close also above) -> long fade to session VWAP
    (limit target); symmetric short at prev_hi. ATR stop, EOD backstop.

Causality: signal on completed bar close, entry at that close (slippage in
friction); stops/targets evaluated intrabar only on bars strictly after entry
bar; EOD exit at bar 77 close. Friction via omni2_lib.fric (stop/eod 0.66pt,
limit target 0.41pt). 1 MES, $5/pt. Max one trade per session.

Usage: python3 f05_prevday_levels.py --window dev|holdout|all
Runs the PRE-REGISTERED config (defaults), prints stats + full DEV sweep table,
writes JSON to /Users/kaveh/mes_mim/ocean/results/f05_prevday_levels_<window>.json
"""
import sys, os, json, argparse
sys.path.insert(0, "/Users/kaveh/mes_mim")
import numpy as np, pandas as pd
from datetime import date
import omni2_lib as L
from omni2_lib import fric, DPP

DEV_END = date(2022, 12, 31)
HOLD_START = date(2023, 1, 1)
LAST_ENTRY = 71   # no new entries after 15:25 bar close (structural, not swept)
MIN_ROOM = 1.0    # fade: target must be >= 1pt away from entry (structural)
MIN_STOP = 1.0    # minimum stop distance in points (structural)

# ---------------- engine ----------------

def sim_day_A(s, er_thr, stop_mult):
    """Breakout continuation: first close crossing prev_hi/prev_lo, ER gate, EOD ride."""
    ph, pl = s["prev_hi"], s["prev_lo"]
    h, l, c, atr, er = s["h"], s["l"], s["c"], s["atr"], s["er"]
    pos = 0; entry = stop = np.nan; ebar = -1
    for b in range(1, 78):
        if pos == 0:
            if b > LAST_ENTRY:
                break
            side = 0
            if c[b] > ph and c[b-1] <= ph and er[b] >= er_thr:
                side = 1
            elif c[b] < pl and c[b-1] >= pl and er[b] >= er_thr:
                side = -1
            if side != 0:
                pos = side; entry = c[b]; ebar = b
                sd = max(stop_mult * atr[b], MIN_STOP)
                stop = entry - side * sd
            continue
        if b > ebar:
            hit = (l[b] <= stop) if pos > 0 else (h[b] >= stop)
            if hit:
                return [(s["date"], pos * (stop - entry) - fric("stop"), "stop")]
            if b == 77:
                return [(s["date"], pos * (c[b] - entry) - fric("eod"), "eod")]
    return []

def sim_day_B(s, pierce_min, stop_mult, target_kind="vwap"):
    """Rejection fade: intrabar pierce of prev_lo/prev_hi that closes back inside
    -> fade toward vwap (limit target) with ATR stop, EOD backstop."""
    ph, pl, pc = s["prev_hi"], s["prev_lo"], s["prev_close"]
    h, l, c, atr, vwap = s["h"], s["l"], s["c"], s["atr"], s["vwap"]
    pos = 0; entry = stop = tgt = np.nan; ebar = -1
    for b in range(1, 78):
        if pos == 0:
            if b > LAST_ENTRY:
                break
            side = 0
            if (l[b] <= pl - pierce_min * atr[b]) and c[b] > pl and c[b-1] > pl:
                side = 1
            elif (h[b] >= ph + pierce_min * atr[b]) and c[b] < ph and c[b-1] < ph:
                side = -1
            if side != 0:
                if target_kind == "eod":
                    t = None   # no profit target: ride rejection to session close
                else:
                    t = vwap[b] if target_kind == "vwap" else pc
                if t is None or side * (t - c[b]) >= MIN_ROOM:   # need room toward target
                    pos = side; entry = c[b]; ebar = b; tgt = t
                    sd = max(stop_mult * atr[b], MIN_STOP)
                    stop = entry - side * sd
            continue
        if b > ebar:
            hit_stop = (l[b] <= stop) if pos > 0 else (h[b] >= stop)
            if hit_stop:   # pessimistic: stop before target in same bar
                return [(s["date"], pos * (stop - entry) - fric("stop"), "stop")]
            hit_tgt = tgt is not None and ((h[b] >= tgt) if pos > 0 else (l[b] <= tgt))
            if hit_tgt:
                return [(s["date"], pos * (tgt - entry) - fric("target"), "target")]
            if b == 77:
                return [(s["date"], pos * (c[b] - entry) - fric("eod"), "eod")]
    return []

def run(S, branch, **p):
    rows = []
    for s in S:
        if s["prev_hi"] is None:
            continue
        sim = sim_day_A if branch == "A" else sim_day_B
        for d, net, kind in sim(s, **p):
            rows.append(dict(date=d, net=net, kind=kind))
    return pd.DataFrame(rows)

