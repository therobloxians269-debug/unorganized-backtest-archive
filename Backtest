"""
f6_orb.py -- FAMILY: OPENING RANGE BREAKOUT (exhaustive)

Anchors : 09:30 RTH, 06:00 NY-am QT open, 18:00 day-cycle open, 00:00 London open
Windows : 5/15/30/60 min
Entries : breakout, breakout-retest, failed-breakout fade
Stops   : k * OR-width, opposite OR extreme, k * ATR
Exits   : fixed R, ATR trail, OR-width multiples, max-hold, session close (16:59)
Filters : OR width vs ATR, volume, gap direction, day of week, SSMT score,
          prior-day close position

Discipline:
  * every feature is causal; HTF audit printed (see audit_lookahead)
  * sweep on IS only, select by ROBUSTNESS (drop-top-3, plateau), then OOS1/OOS2
  * random-time placebo U(120,1440) min, >=6 seeds
"""
import os, sys, math, itertools, json, time
import numpy as np
import pandas as pd
from numba import njit

DIR = "/Users/kaveh/qt_cascade"
NQ = os.path.join(DIR, "nq_v6.parquet")
MNQ = os.path.join(DIR, "mnq_v6.parquet")

# ---------------------------------------------------------------- costs
COSTS = {
    "NQ":  dict(pv=20.0, comm=4.00, slip=0.25),
    "MNQ": dict(pv=2.0,  comm=1.50, slip=0.25),
}

ANCHORS = {"0930": (9, 30), "0600": (6, 0), "1800": (18, 0), "0000": (0, 0)}

# ================================================================ loading
def load(path):
    d = pd.read_parquet(path)
    d = d.sort_index()
    return d


def build_daycycle_table(d):
    """Per-daycycle causal table: OHLC of the cycle, prior-day ATR14, prior close pos."""
    g = d.groupby("daycycle", sort=True)
    t = pd.DataFrame({
        "dh": g["h"].max(), "dl": g["l"].min(),
        "do": g["o"].first(), "dc": g["c"].last(),
        "n": g.size(),
    })
    prev_c = t["dc"].shift(1)
    tr = pd.concat([
        t["dh"] - t["dl"],
        (t["dh"] - prev_c).abs(),
        (t["dl"] - prev_c).abs()], axis=1).max(axis=1)
    # ATR of *completed prior* cycles only -> shift(1) BEFORE rolling
    t["atrD"] = tr.shift(1).rolling(14, min_periods=6).mean()
    rng = (t["dh"] - t["dl"]).replace(0, np.nan)
    t["prev_closepos"] = ((t["dc"] - t["dl"]) / rng).shift(1)
    t["prev_close"] = prev_c
    t["prev_range"] = (t["dh"] - t["dl"]).shift(1)
    return t


# ================================================================ OR construction
def build_or(d, dcodes, ndays, anchor, win):
    """
    Returns per-daycycle arrays.  OR uses bars with ts in [anchor, anchor+win).
    sig_i = index of FIRST bar with ts >= anchor+win  (the OR is fully known then).
    dl_i  = index of last bar with ts <= 16:59 in that day-cycle (Apex flat-by).
    """
    hh, mm = ANCHORS[anchor]
    tod = (d.index.hour * 60 + d.index.minute).to_numpy().astype(np.int64)
    tmin = d.index.to_numpy().astype("datetime64[m]").astype(np.int64)  # min since epoch (UTC)
    a0 = hh * 60 + mm
    n = len(d)
    dstart = np.zeros(ndays, np.int64) - 1
    dend = np.zeros(ndays, np.int64) - 1
    starts = np.flatnonzero(np.r_[True, dcodes[1:] != dcodes[:-1]])
    ends = np.r_[starts[1:], n]
    for k, dd in enumerate(dcodes[starts]):
        dstart[dd] = starts[k]
        dend[dd] = ends[k]

    or_hi = np.full(ndays, np.nan)
    or_lo = np.full(ndays, np.nan)
    or_vol = np.full(ndays, np.nan)
    or_open = np.full(ndays, np.nan)
    sig_i = np.full(ndays, -1, np.int64)
    dl_i = np.full(ndays, -1, np.int64)
    anch_i = np.full(ndays, -1, np.int64)

    hv = d["h"].to_numpy(); lv = d["l"].to_numpy()
    ov = d["o"].to_numpy(); vv = d["v"].to_numpy().astype(np.float64)
    cutoff = 16 * 60 + 59

    for dd in range(ndays):
        s, e = dstart[dd], dend[dd]
        if s < 0 or e - s < 90:
            continue
        tods = tod[s:e]
        pos = np.flatnonzero(tods == a0)
        if len(pos) == 0:
            continue
        a = s + (0 if anchor == "1800" else int(pos[0]))
        if anchor == "1800" and tods[0] != a0:
            continue
        # OR window = bars with wall-clock ts strictly inside [anchor, anchor+win)
        t_a = tmin[a]
        j = a
        while j < e and (tmin[j] - t_a) < win:
            j += 1
        wend = j
        if wend <= a or wend >= e or (wend - a) < max(3, win // 3):
            continue
        or_hi[dd] = hv[a:wend].max()
        or_lo[dd] = lv[a:wend].min()
        or_vol[dd] = vv[a:wend].sum()
        or_open[dd] = ov[a]
        anch_i[dd] = a
        sig_i[dd] = wend
        cand = np.flatnonzero(tods <= cutoff)
        if len(cand) == 0:
            continue
        dl_i[dd] = s + int(cand[-1])
    return dict(or_hi=or_hi, or_lo=or_lo, or_vol=or_vol, or_open=or_open,
                sig_i=sig_i, dl_i=dl_i, anch_i=anch_i, dstart=dstart, dend=dend)


# ================================================================ engine (numba)
@njit(cache=True)
def _scan(o, h, l, c,
          or_hi, or_lo, sig_i, dl_i, atr_sig, okmask,
          entry_mode, stop_mode, k_stop, rr, max_hold,
          trail_k, side_mode, buf, slip, pv, comm,
          evt_max, min_risk, max_risk,
          out_day, out_ei, out_xi, out_side, out_ep, out_sp, out_tp,
          out_xp, out_risk, out_pnl, out_reason, out_sig):
    """entry_mode 0=break 1=retest 2=fade
       stop_mode 0=k*ORwidth 1=opposite OR extreme 2=k*ATR 3=swing extreme since breakout
       side_mode 0=both 1=long 2=short (applies to the *trade* direction)"""
    nt = 0
    nd = len(sig_i)
    for dd in range(nd):
        if okmask[dd] == 0:
            continue
        s = sig_i[dd]; dl = dl_i[dd]
        if s < 0 or dl < 0 or dl <= s + 2:
            continue
        oh = or_hi[dd]; ol = or_lo[dd]
        if not (oh > ol):
            continue
        orw = oh - ol
        # ---- find first breakout bar
        bo = -1; bdir = 0
        for j in range(s, dl):
            up = h[j] > oh + buf
            dn = l[j] < ol - buf
            if up and dn:
                bo = -2  # ambiguous outside bar -> skip day
                break
            if up:
                bo = j; bdir = 1; break
            if dn:
                bo = j; bdir = -1; break
        if bo < 0:
            continue
        # ---- resolve signal bar per entry mode
        sigbar = -1; tside = 0
        if entry_mode == 0:
            sigbar = bo; tside = bdir
        elif entry_mode == 1:  # retest of the broken level
            lim = bo + evt_max
            if lim > dl:
                lim = dl
            for j in range(bo + 1, lim):
                if bdir == 1:
                    if l[j] <= oh:
                        sigbar = j; tside = 1; break
                    if c[j] < ol:
                        break
                else:
                    if h[j] >= ol:
                        sigbar = j; tside = -1; break
                    if c[j] > oh:
                        break
        else:  # fade the failed breakout: close back inside OR
            lim = bo + evt_max
            if lim > dl:
                lim = dl
            for j in range(bo + 1, lim):
                if bdir == 1:
                    if c[j] < oh:
                        sigbar = j; tside = -1; break
                else:
                    if c[j] > ol:
                        sigbar = j; tside = 1; break
        if sigbar < 0 or tside == 0:
            continue
        if side_mode == 1 and tside != 1:
            continue
        if side_mode == 2 and tside != -1:
            continue
        ei = sigbar + 1
        if ei > dl:
            continue
        ep = o[ei] + slip * tside
        # swing extreme between the breakout bar and the signal bar (inclusive)
        exc_hi = h[bo]; exc_lo = l[bo]
        for k in range(bo, sigbar + 1):
            if h[k] > exc_hi:
                exc_hi = h[k]
            if l[k] < exc_lo:
                exc_lo = l[k]
        # ---- stop
        if stop_mode == 0:
            sp = ep - tside * k_stop * orw
        elif stop_mode == 1:
            sp = ol if tside == 1 else oh
        elif stop_mode == 2:
            sp = ep - tside * k_stop * atr_sig[dd]
        else:
            sp = (exc_lo - buf) if tside == 1 else (exc_hi + buf)
        risk = (ep - sp) * tside
        if risk < min_risk or risk != risk or risk > max_risk:
            continue
        tp = ep + tside * rr * risk
        # ---- walk
        stop = sp
        xi = -1; xp = 0.0; reason = 0
        last = ei + max_hold
        if last > dl:
            last = dl
        for k in range(ei, last + 1):
            if tside == 1:
                if l[k] <= stop:
                    xi = k; xp = stop - slip; reason = 1; break
                if h[k] >= tp:
                    xi = k; xp = tp; reason = 2; break
                if trail_k > 0.0:
                    ns = c[k] - trail_k * atr_sig[dd]
                    if ns > stop:
                        stop = ns
            else:
                if h[k] >= stop:
                    xi = k; xp = stop + slip; reason = 1; break
                if l[k] <= tp:
                    xi = k; xp = tp; reason = 2; break
                if trail_k > 0.0:
                    ns = c[k] + trail_k * atr_sig[dd]
                    if ns < stop:
                        stop = ns
        if xi < 0:
            xi = last; xp = c[last]; reason = 3
        pnl = (xp - ep) * tside * pv - comm
        out_day[nt] = dd; out_ei[nt] = ei; out_xi[nt] = xi; out_side[nt] = tside
        out_ep[nt] = ep; out_sp[nt] = sp; out_tp[nt] = tp; out_xp[nt] = xp
        out_risk[nt] = risk; out_pnl[nt] = pnl; out_reason[nt] = reason
        out_sig[nt] = sigbar
        nt += 1
    return nt


def run(mkt, arrs, orb, okmask, cfg):
    ck = COSTS[mkt]
    nd = len(orb["sig_i"])
    cap = nd + 5
    out = {k: np.zeros(cap, dt) for k, dt in
           [("day", np.int64), ("ei", np.int64), ("xi", np.int64), ("side", np.int64),
            ("ep", np.float64), ("sp", np.float64), ("tp", np.float64),
            ("xp", np.float64), ("risk", np.float64), ("pnl", np.float64),
            ("reason", np.int64), ("sig", np.int64)]}
    n = _scan(arrs["o"], arrs["h"], arrs["l"], arrs["c"],
              orb["or_hi"], orb["or_lo"], orb["sig_i"], orb["dl_i"],
              orb["atr_sig"], okmask.astype(np.int64),
              cfg["entry_mode"], cfg["stop_mode"], cfg["k_stop"], cfg["rr"],
              cfg["max_hold"], cfg.get("trail_k", 0.0), cfg.get("side_mode", 0),
              cfg.get("buf", 0.0), ck["slip"], ck["pv"], ck["comm"],
              cfg.get("evt_max", 60), cfg.get("min_risk", 3.0),
              cfg.get("max_risk", 1e9),
              out["day"], out["ei"], out["xi"], out["side"], out["ep"], out["sp"],
              out["tp"], out["xp"], out["risk"], out["pnl"], out["reason"], out["sig"])
    tr = pd.DataFrame({k: v[:n] for k, v in out.items()})
    tr["R"] = tr["pnl"] / (tr["risk"] * ck["pv"])
    return tr


# ================================================================ stats
def stats(tr, ndays, mkt):
    """All $ figures are reported PER ONE MICRO (MNQ). NQ results are /10."""
    scale = 0.1 if mkt == "NQ" else 1.0
    if len(tr) == 0:
        return dict(n=0, tpd=0.0, avgR=np.nan, usd=np.nan, wr=np.nan,
                    d3=np.nan, pf=np.nan, dd1m=np.nan, tot=0.0, t=np.nan, risk=np.nan)
    R = tr["R"].to_numpy(); P = tr["pnl"].to_numpy() * scale
    srt = np.sort(R)[::-1]
    d3 = srt[3:].mean() if len(srt) > 3 else np.nan
    eq = np.cumsum(P)
    dd = float((np.maximum.accumulate(np.r_[0, eq]) - np.r_[0, eq]).max())
    gp = P[P > 0].sum(); gl = -P[P < 0].sum()
    pvm = 20.0 * scale if mkt == "NQ" else 2.0
    return dict(n=int(len(tr)), tpd=len(tr) / ndays, avgR=float(R.mean()),
                usd=float(P.mean()), wr=float((P > 0).mean()), d3=float(d3),
                pf=float(gp / gl) if gl > 0 else np.inf, dd1m=dd,
                tot=float(P.sum()), risk=float(tr["risk"].mean() * pvm),
                t=float(R.mean() / (R.std(ddof=1) / np.sqrt(len(R)))) if len(R) > 2 else np.nan)


# ================================================================ market prep
class Mkt:
    def __init__(self, path, name, mask=None, label=""):
        d = load(path)
        if mask is not None:
            d = d[mask(d)]
        self.d = d
        self.name = name
        self.label = label
        self.dcs = pd.Index(sorted(d["daycycle"].unique()))
        self.ndays = len(self.dcs)
        code = pd.Categorical(d["daycycle"], categories=self.dcs).codes.astype(np.int64)
        self.dcodes = code
        self.arrs = {k: d[k].to_numpy(np.float64) for k in ("o", "h", "l", "c", "v")}
        self.dtab = build_daycycle_table(d)
        self.dow = pd.Series([pd.Timestamp(x).dayofweek for x in self.dcs], index=self.dcs)
        self._orb = {}

    def orb(self, anchor, win, atr_col="atr30"):
        key = (anchor, win, atr_col)
        if key in self._orb:
            return self._orb[key]
        o = build_or(self.d, self.dcodes, self.ndays, anchor, win)
        sv = o["sig_i"]
        atr = np.full(self.ndays, np.nan)
        a = self.d[atr_col].to_numpy(np.float64)
        good = sv >= 0
        atr[good] = a[sv[good]]
        o["atr_sig"] = np.nan_to_num(atr, nan=1e9)
        # causal per-day context evaluated AT the signal bar
        ctx = {}
        for col in ("bull_score", "bear_score", "v"):
            arr = self.d[col].to_numpy(np.float64)
            z = np.full(self.ndays, np.nan); z[good] = arr[sv[good]]
            ctx[col] = z
        o["ctx"] = ctx
        o["orw"] = o["or_hi"] - o["or_lo"]
        o["atrD"] = self.dtab["atrD"].to_numpy()
        o["prev_closepos"] = self.dtab["prev_closepos"].to_numpy()
        o["prev_close"] = self.dtab["prev_close"].to_numpy()
        o["gap"] = o["or_open"] - o["prev_close"]
        # causal volume ratio: OR volume vs median of prior 20 same-window ORs
        v = pd.Series(o["or_vol"])
        o["volr"] = (v / v.shift(1).rolling(20, min_periods=8).median()).to_numpy()
        o["dow"] = self.dow.to_numpy()
        self._orb[key] = o
        return o


def base_mask(o, wlo=0.0, whi=99.0, atr_ref="atrD"):
    ok = (o["sig_i"] >= 0) & (o["dl_i"] > 0) & np.isfinite(o["orw"]) & (o["orw"] > 0)
    ref = o[atr_ref]
    with np.errstate(invalid="ignore"):
        r = o["orw"] / ref
    ok &= np.isfinite(r) & (r >= wlo) & (r <= whi)
    return ok


# ================================================================ lookahead audit
def audit_lookahead(mk, log):
    log("\n" + "=" * 78)
    log("LOOKAHEAD AUDIT  (%s)" % mk.label)
    log("=" * 78)
    d = mk.d
    ok = True

    # ---- A. supplied HTF column atr60 -- recompute with explicit shift discipline
    r = d[["h", "l", "c"]].resample("60min", label="left", closed="left").agg(
        {"h": "max", "l": "min", "c": "last"}).dropna()
    pc = r["c"].shift(1)
    tr = pd.concat([r["h"] - r["l"], (r["h"] - pc).abs(), (r["l"] - pc).abs()], axis=1).max(axis=1)
    a = tr.rolling(14).mean().shift(1)          # <-- the .shift(1) that v5 was missing
    ref = a.reindex(d.index, method="ffill")
    m = d["atr60"].notna() & ref.notna()
    diff = (d["atr60"][m] - ref[m]).abs()
    log("A) atr60 column vs independently shifted rebuild:  max|diff|=%.6f  match=%.4f%%"
        % (diff.max(), 100 * (diff < 1e-9).mean()))
    if diff.max() > 1e-6:
        ok = False
    # the *unshifted* (buggy v5-style) version must DISAGREE -> proves the shift is present
    ref_bug = tr.rolling(14).mean().reindex(d.index, method="ffill")
    m2 = d["atr60"].notna() & ref_bug.notna()
    dbug = (d["atr60"][m2] - ref_bug[m2]).abs()
    log("   same rebuild WITHOUT .shift(1): differs on %.2f%% of rows (must be >0)"
        % (100 * (dbug > 1e-9).mean()))

    # ---- B. OR levels are fully closed before the first eligible signal bar
    bad = 0; checked = 0
    for anchor, win in (("0930", 15), ("0930", 30), ("0600", 30), ("1800", 60), ("0000", 30)):
        o = mk.orb(anchor, win)
        s = o["sig_i"]; a_i = o["anch_i"]
        g = np.flatnonzero((s >= 0) & (a_i >= 0))
        rng = np.random.default_rng(7)
        for dd in rng.choice(g, size=min(40, len(g)), replace=False):
            lo, hi = a_i[dd], s[dd]
            hh = d["h"].to_numpy()[lo:hi].max(); ll = d["l"].to_numpy()[lo:hi].min()
            checked += 1
            if abs(hh - o["or_hi"][dd]) > 1e-9 or abs(ll - o["or_lo"][dd]) > 1e-9:
                bad += 1
            # signal bar must start at/after anchor+win
            t0 = d.index[lo]; t1 = d.index[hi]
            if (t1 - t0).total_seconds() / 60.0 < win:
                bad += 1
    log("B) OR levels rebuilt from raw bars in [anchor,anchor+win): %d checks, %d mismatches"
        % (checked, bad))
    if bad:
        ok = False

    # ---- C. daily ATR uses only COMPLETED prior day-cycles
    t = mk.dtab
    rng = np.random.default_rng(11)
    idxs = rng.choice(np.arange(20, len(t)), size=min(25, len(t) - 20), replace=False)
    bad = 0
    for i in idxs:
        prev = t.iloc[:i]           # strictly prior cycles
        pc = prev["dc"].shift(1)
        trr = pd.concat([prev["dh"] - prev["dl"], (prev["dh"] - pc).abs(),
                         (prev["dl"] - pc).abs()], axis=1).max(axis=1)
        manual = trr.iloc[-14:].mean()
        if abs(manual - t["atrD"].iloc[i]) > 1e-9:
            bad += 1
    log("C) daily ATR14 recomputed from strictly-prior cycles: %d checks, %d mismatches"
        % (len(idxs), bad))
    if bad:
        ok = False

    # ---- D. trade-level: entry strictly after signal bar, exit >= entry, exit <= 16:59
    o = mk.orb("0930", 15)
    m = base_mask(o)
    tr_ = run(mk.name, mk.arrs, o, m,
              dict(entry_mode=0, stop_mode=0, k_stop=1.0, rr=1.5, max_hold=390))
    v1 = int((tr_["ei"] <= tr_["sig"]).sum())
    v2 = int((tr_["xi"] < tr_["ei"]).sum())
    tt = mk.d.index[tr_["xi"].to_numpy()]
    v3 = int(((tt.hour * 60 + tt.minute) > 16 * 60 + 59).sum())
    v4 = int((tr_["ei"].to_numpy() < o["sig_i"][tr_["day"].to_numpy()]).sum())
    log("D) trades n=%d | entry<=signal:%d  exit<entry:%d  exit_after_1659:%d  entry_before_ORclose:%d"
        % (len(tr_), v1, v2, v3, v4))
    if v1 or v2 or v3 or v4:
        ok = False

    # ---- E. shift-the-world test: shifting all price bars forward by 1 must degrade,
    #        a lookahead-free engine cannot profit from data it has not seen.
    log("E) engine unbiasedness: random-entry control is run in the placebo section.")
    log("AUDIT RESULT: %s" % ("PASS" if ok else "*** FAIL ***"))
    return ok


# ================================================================ sweep
def sweep(mk, anchors, wins, grid, wlo=0.0, whi=99.0, min_tpd=0.0, log=print):
    rows = []
    for anchor in anchors:
        for win in wins:
            o = mk.orb(anchor, win)
            m = base_mask(o, wlo, whi)
            if m.sum() < 40:
                continue
            for cfg in grid:
                tr = run(mk.name, mk.arrs, o, m, cfg)
                st = stats(tr, mk.ndays, mk.name)
                if st["n"] < 40:
                    continue
                rows.append(dict(anchor=anchor, win=win, **cfg, **st))
    return pd.DataFrame(rows)


KS_BY_MODE = {0: (0.15, 0.25, 0.4, 0.6, 1.0), 1: (0.0,),
              2: (0.5, 0.75, 1.0, 1.5, 2.0), 3: (0.0,)}


def mkgrid(entry_modes, stop_modes, rrs, holds, trails=(0.0,), sides=(0,),
           evt=(60,), ks_override=None, extra=None):
    g = []
    for em, sm in itertools.product(entry_modes, stop_modes):
        kss = (ks_override or KS_BY_MODE)[sm]
        for ks, rr, mh, tk, sd, ev in itertools.product(kss, rrs, holds, trails, sides, evt):
            c = dict(entry_mode=em, stop_mode=sm, k_stop=float(ks), rr=float(rr),
                     max_hold=int(mh), trail_k=float(tk), side_mode=int(sd),
                     evt_max=int(ev))
            if extra:
                c.update(extra)
            g.append(c)
    return g


# ================================================================ placebo
def placebo(mk, anchor, win, cfg, okmask, seeds=8, lo=120, hi=1440, log=print):
    """Same logic, entries displaced by U(120,1440) minutes.
    Side / risk / RR / hold are preserved; only the entry timestamp moves.
    Exit is raced from the displaced entry with the same barriers, still capped
    by the 16:59 flat-by rule of whichever day-cycle the displaced entry lands in."""
    o = mk.orb(anchor, win)
    tr = run(mk.name, mk.arrs, o, okmask, cfg)
    if len(tr) == 0:
        return np.nan, np.nan, []
    ck = COSTS[mk.name]
    H = mk.arrs["h"]; L = mk.arrs["l"]; C = mk.arrs["c"]; O = mk.arrs["o"]
    N = len(H)
    # deadline lookup per bar index -> day-cycle deadline
    dl_by_day = o["dl_i"]
    dcode = mk.dcodes
    res = []
    for sd in range(seeds):
        rng = np.random.default_rng(1000 + sd)
        off = rng.integers(lo, hi + 1, size=len(tr))
        Rs = []
        for k in range(len(tr)):
            ei0 = int(tr["ei"].iloc[k]); side = int(tr["side"].iloc[k])
            risk = float(tr["risk"].iloc[k]); rr = cfg["rr"]; mh = cfg["max_hold"]
            ei = ei0 + int(off[k])
            if ei >= N - 2:
                continue
            dd = dcode[ei]
            dl = dl_by_day[dd] if dd < len(dl_by_day) else -1
            if dl < 0 or ei >= dl:
                continue
            ep = O[ei] + ck["slip"] * side
            sp = ep - side * risk
            tp = ep + side * rr * risk
            stop = sp
            last = min(ei + mh, dl)
            xp = None
            for j in range(ei, last + 1):
                if side == 1:
                    if L[j] <= stop:
                        xp = stop - ck["slip"]; break
                    if H[j] >= tp:
                        xp = tp; break
                    if cfg.get("trail_k", 0.0) > 0:
                        ns = C[j] - cfg["trail_k"] * o["atr_sig"][dd]
                        if ns > stop:
                            stop = ns
                else:
                    if H[j] >= stop:
                        xp = stop + ck["slip"]; break
                    if L[j] <= tp:
                        xp = tp; break
                    if cfg.get("trail_k", 0.0) > 0:
                        ns = C[j] + cfg["trail_k"] * o["atr_sig"][dd]
                        if ns < stop:
                            stop = ns
            if xp is None:
                xp = C[last]
            pnl = (xp - ep) * side * ck["pv"] - ck["comm"]
            Rs.append(pnl / (risk * ck["pv"]))
        res.append(np.mean(Rs) if Rs else np.nan)
    real = float(tr["R"].mean())
    return real, float(np.nanmean(res)), res


