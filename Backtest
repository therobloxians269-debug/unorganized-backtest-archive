    """Causal loop, house style (omni4_preserve.sim_day): signal at bar close,
    entry at that close (market); exits evaluated only on bars > entry bar;
    stop checked before target within a bar (conservative)."""
    h, l, c, atr, vwap, er = s["h"], s["l"], s["c"], s["atr"], s["vwap"], s["er"]
    pos = 0; entry = stop = risk0 = np.nan; ebar = -1
