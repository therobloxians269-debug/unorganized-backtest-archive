#!/usr/bin/env python3
"""
ml_intraday.py — maximum-effort intraday search: walk-forward ML on real ES 15m.

Instead of testing hand-written rules one at a time, build a ~40-feature causal
matrix over every RTH 15m bar and let a gradient-boosted model search the
interaction space. Walk-forward: train on all years < Y, predict year Y, retrain
yearly. Trade only when |prediction| clears a threshold set on TRAIN preds
(picked to yield ~2 trades/day), chronologically, max 2/day, non-overlapping,
enter next bar open, exit after H bars or session close. $2.50 RT, 1 MES.

Every feature uses information available at the signal bar's close. Daily
features use the PRIOR day's close. Threshold from train only. No within-day
ranking (that would peek at the afternoon).
"""
import numpy as np, pandas as pd
from sklearn.ensemble import HistGradientBoostingRegressor

MES, RT = 5.0, 2.5
H = 6                       # exit horizon: 6 x 15m = 90 min (or session close)
TARGET_TPD = 2.0            # desired trades/day -> threshold percentile on train

# ---------- load ----------
df = pd.read_parquet("/Users/kaveh/omni_x/es_front_2017_24h_1m.parquet")
df = df.rename(columns={'ts_event': 'ts'}).set_index('ts').sort_index()
df = df[~df.index.duplicated()][['open','high','low','close','volume']].astype(float)
b = (df.resample('15min', label='left', closed='left')
       .agg({'open':'first','high':'max','low':'min','close':'last','volume':'sum'})
       .dropna(subset=['open']))
ny = b.index.tz_convert('America/New_York')
b['mins'] = ny.hour*60 + ny.minute
b['day'] = ny.normalize()
b['dow'] = ny.dayofweek

o,h,l,c,v = (b[k].to_numpy() for k in ('open','high','low','close','volume'))
mins = b['mins'].to_numpy(); days = b['day'].to_numpy()
n = len(b)

# ---------- daily context keyed by NY session date (all lagged to prior close) ----------
g = b.groupby('day')
dcl = g['close'].last()
dhi = g['high'].max(); dlo = g['low'].min()
d_atr = (dhi - dlo).rolling(20).mean()
d_ma200 = dcl.rolling(200).mean()
d_ret1 = dcl.pct_change(); d_ret3 = dcl.pct_change(3); d_ret5 = dcl.pct_change(5)
d_vol20 = d_ret1.rolling(20).std()
d_volp = d_vol20.expanding(60).apply(lambda a: (a[-1] >= a).mean(), raw=True)  # causal pctile
def lagmap(s):
    return s.shift(1).reindex(b['day']).to_numpy()
ATRd   = lagmap(d_atr)
MAdist = lagmap((dcl - d_ma200) / d_atr)
RET1d, RET3d, RET5d = lagmap(d_ret1), lagmap(d_ret3), lagmap(d_ret5)
VOLP   = lagmap(d_volp)
PDH, PDL, PDC = lagmap(dhi), lagmap(dlo), lagmap(dcl)

# ---------- intraday running state ----------
rth = (mins >= 570) & (mins <= 960)
day_open = np.full(n, np.nan); day_hi = np.full(n, np.nan); day_lo = np.full(n, np.nan)
vwap = np.full(n, np.nan); cum_sv = np.full(n, np.nan); bars_in = np.full(n, -1.0)
cur = None
for i in range(n):
    if not rth[i]: continue
    if cur != days[i]:
        cur = days[i]; _o = o[i]; _h = h[i]; _lo = l[i]
        _pv = 0.0; _vv = 0.0; _sv = 0.0; _k = 0
    _h = max(_h, h[i]); _lo = min(_lo, l[i])
    tp = (h[i]+l[i]+c[i])/3.0
    _pv += tp*v[i]; _vv += v[i]
    rng = max(h[i]-l[i], 1e-9)
    _sv += v[i] * (2*(c[i]-l[i])/rng - 1)
    _k += 1
    day_open[i]=_o; day_hi[i]=_h; day_lo[i]=_lo
    vwap[i] = _pv/max(_vv,1e-9); cum_sv[i]=_sv; bars_in[i]=_k

# trailing 20-day same-slot volume average (causal: shifted by construction)
slotv = pd.DataFrame({'day':b['day'],'mins':b['mins'],'v':b['volume']})
slotv['avg'] = slotv.groupby('mins')['v'].transform(lambda s: s.shift(1).rolling(20, min_periods=5).mean())
RVOL = (slotv['v']/slotv['avg']).to_numpy()

# 15m ATR ratio
tr15 = np.maximum(h-l, np.abs(c-np.roll(c,1))); tr15[0]=h[0]-l[0]
atr5  = pd.Series(tr15).rolling(5).mean().to_numpy()
atr20 = pd.Series(tr15).rolling(20).mean().to_numpy()

def pret(k):
    r = np.full(n, np.nan); r[k:] = c[k:]/c[:-k]-1.0
    return r
R1,R2,R4,R8 = pret(1),pret(2),pret(4),pret(8)

consec = np.zeros(n)
for i in range(1,n):
    consec[i] = consec[i-1]+1 if c[i]>c[i-1] else (consec[i-1]-1 if c[i]<c[i-1] else 0)

A = np.where(np.isfinite(ATRd) & (ATRd>0), ATRd, np.nan)
body = (c-o); brange = np.maximum(h-l,1e-9)
feats = {
 'ret1':R1,'ret2':R2,'ret4':R4,'ret8':R8,
 'ret_open':(c-day_open)/A,'gap':(day_open-PDC)/A,
 'd_ret1':RET1d,'d_ret3':RET3d,'d_ret5':RET5d,
 'ma200':MAdist,'volp':VOLP,
 'vwap_d':(c-vwap)/A,'hi_d':(day_hi-c)/A,'lo_d':(c-day_lo)/A,
 'rng_d':(day_hi-day_lo)/A,'pdh_d':(PDH-c)/A,'pdl_d':(c-PDL)/A,'pdc_d':(c-PDC)/A,
 'rvol':RVOL,'csv':cum_sv/np.maximum(pd.Series(v).rolling(26).mean().to_numpy(),1),
 'atr_r':atr5/np.maximum(atr20,1e-9),'tr_a':tr15/A,
 'body':body/brange,'cpos':(c-l)/brange,'consec':consec,
 'mins':mins.astype(float),'sin_t':np.sin(2*np.pi*mins/1440),'cos_t':np.cos(2*np.pi*mins/1440),
 'dow':b['dow'].to_numpy().astype(float),'bars_in':bars_in,
}
X = pd.DataFrame(feats, index=b.index)

# ---------- target: forward H-bar net move (points), intraday only ----------
last_rth_of_day = {}
for i in range(n):
    if rth[i]: last_rth_of_day[days[i]] = i
elig = np.zeros(n, dtype=bool); y = np.full(n, np.nan); exit_bar = np.full(n, -1)
for i in range(n):
    if not rth[i] or mins[i] < 585 or mins[i] > 870: continue   # signal 09:45..14:30
    e = i+1
    if e >= n or not rth[e] or days[e] != days[i]: continue
    xb = min(e+H-1, last_rth_of_day[days[i]])
    if xb <= e-1: continue
    elig[i] = True; y[i] = c[xb]-o[e]; exit_bar[i] = xb

mask = elig & np.isfinite(y) & np.isfinite(X.to_numpy()).all(axis=1)
years = ny.year.to_numpy()
print(f"eligible samples: {mask.sum():,}  ({mask.sum()/((years[-1]-years[0])+1):,.0f}/yr)  features: {X.shape[1]}")

# ---------- walk-forward ----------
all_trades = []
for Y in range(2019, 2027):
    tr_m = mask & (years < Y); te_m = mask & (years == Y)
    if tr_m.sum() < 5000 or te_m.sum() < 300: continue
    m = HistGradientBoostingRegressor(max_iter=300, learning_rate=0.05, max_depth=4,
                                      l2_regularization=1.0, min_samples_leaf=200, random_state=0)
    m.fit(X.to_numpy()[tr_m], y[tr_m])
    ptr = m.predict(X.to_numpy()[tr_m])
    n_days_tr = len(np.unique(days[tr_m]))
    k = TARGET_TPD * n_days_tr
    thr = np.quantile(np.abs(ptr), max(0.0, 1.0 - k/len(ptr)))
    pte = np.full(n, np.nan); pte[te_m] = m.predict(X.to_numpy()[te_m])
    # chronological, threshold-only, cap 2/day, non-overlapping
    open_until = -1; per_day = {}
    for i in np.where(te_m)[0]:
        if i <= open_until or not np.isfinite(pte[i]) or abs(pte[i]) < thr: continue
        d0 = days[i]
        if per_day.get(d0, 0) >= 2: continue
        dirn = 1 if pte[i] > 0 else -1
        pnl = dirn * y[i] * MES - RT
        all_trades.append((b.index[i], Y, pnl, dirn))
        per_day[d0] = per_day.get(d0, 0) + 1
        open_until = exit_bar[i]

t = pd.DataFrame(all_trades, columns=['t','year','pnl','dir'])
if len(t) == 0:
    print("NO TRADES CLEARED THE THRESHOLD"); raise SystemExit
p = t['pnl'].to_numpy()
eq = 1000 + np.cumsum(p); mdd = float(-(eq-np.maximum.accumulate(eq)).min())
yrs = t['year'].nunique()
print(f"\nWALK-FORWARD OOS (all years unseen at train time):")
print(f"trades {len(p)} (~{len(p)/yrs:.0f}/yr, {len(p)/(252*yrs):.1f}/day) win {100*(p>0).mean():.1f}%")
print(f"exp ${p.mean():+.2f}/trade   t={p.mean()/p.std()*np.sqrt(len(p)):+.2f}   skew {pd.Series(p).skew():+.2f}")
print(f"total ${p.sum():+.0f}   ann ${p.sum()/yrs:+.0f}   maxDD ${mdd:.0f}   long% {100*(t['dir']>0).mean():.0f}")
print("\nper-year:")
for Y, g in t.groupby('year'):
    gp = g['pnl'].to_numpy()
    print(f"  {Y}: n={len(gp):4d}  exp ${gp.mean():+6.2f}  tot ${gp.sum():+7.0f}  t={gp.mean()/gp.std()*np.sqrt(len(gp)):+.2f}")

