"""
TERMINUS · M3 post-mortem, and the two repairs that are structurally different
(not parameter tweaks on a corpse).

DIAGNOSIS TO TEST
  H: getting filled is itself bad news. The model says P(low is final)=0.85 at the
     checkpoint, but a limit deep in the swing only fills when price travels BACK
     toward the low — and that is exactly the state in which the low breaks. So
     P(low survives | filled) << P(low survives).
     Measure both. If the gap is large, the checkpoint probability is simply not the
     probability that governs the trade.

REPAIR A — market entry, stop NOT at the extreme.
     Keep the directional claim (the day still has travel toward the far end), drop
     "the extreme is the stop". Stop at a fraction of ADR below entry, target beyond
     the opposite extreme. This never needs a retracement, so no fill selection.

REPAIR C — re-score at the fill.
     Place the limit, but only take the trade if the model STILL says p >= thr at the
     moment of fill, using features recomputed at that bar. This directly repairs the
     broken conditioning and is fully causal.
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')
import data as D, feats as F, calib as CB, sim as S
from m1_model import Model, build_events

CFG = dict(thr_in=0.85, thr_out=0.55, b=0.05, p=0.10, min_swing=0.30)


def prep(which, model, K=60):
    d = D.load(which)
    day, r = D.sessions(d)
    rb = D.rth_bars(r)
    ev = build_events(which)
    ev = ev.assign(p=CB.recalibrate(ev, model.predict(ev), K=K))
    return day, rb, ev


# ---------------------------------------------------------------- diagnosis
def fill_conditioning(day, rb, ev, f=0.33, b=0.05, thr_in=0.85, thr_out=0.55,
                      min_swing=0.30):
    """P(extreme survives) unconditionally vs conditional on the limit filling."""
    piv = (ev.pivot_table(index=['day', 't'], columns='side', values='p',
                          aggfunc='first')
             .rename(columns={'hi': 'p_hi', 'lo': 'p_lo'}).dropna())
    rows = []
    for dd, g in piv.groupby(level=0):
        bb = rb.get(dd)
        if bb is None or dd not in day.index:
            continue
        H, L, T = bb['H'], bb['L'], bb['T']
        A = float(day.at[dd, 'ADR'])
        dayH, dayL = float(H.max()), float(L.min())
        taken = False
        for (_, t), row in g.iterrows():
            if taken:
                break
            k = int(np.searchsorted(T, t, side='right')) - 1
            if k < 30 or k >= len(H) - 5:
                continue
            rh = float(H[:k + 1].max()); rl = float(L[:k + 1].min())
            swing = rh - rl
            if swing < min_swing * A:
                continue
            for long in (True, False):
                pin = row.p_lo if long else row.p_hi
                pout = row.p_hi if long else row.p_lo
                if not (pin >= thr_in and pout <= thr_out):
                    continue
                entry = (rl + f * swing) if long else (rh - f * swing)
                stop = (rl - b * A) if long else (rh + b * A)
                Hf, Lf = H[k + 1:], L[k + 1:]
                if long:
                    fi = np.flatnonzero(Lf <= entry)
                    si = np.flatnonzero(Lf <= stop)
                else:
                    fi = np.flatnonzero(Hf >= entry)
                    si = np.flatnonzero(Hf >= stop)
                fi = fi[0] if len(fi) else 10 ** 9
                si = si[0] if len(si) else 10 ** 9
                filled = (fi < 10 ** 9) and (fi <= si)
                surv = (dayL >= rl - 1e-9) if long else (dayH <= rh + 1e-9)
                rows.append(dict(day=dd, p=pin, filled=bool(filled), surv=bool(surv)))
                taken = True
                break
    return pd.DataFrame(rows)


# ---------------------------------------------------------------- repair A
def trades_market(day, rb, ev, which, thr_in=0.85, thr_out=0.55, stop_frac=0.25,
                  p=0.10, min_swing=0.30, one_per_day=True, last_entry=930,
                  rr_gate=0.0):
    cost = S.COST_PTS[which]
    piv = (ev.pivot_table(index=['day', 't'], columns='side', values='p',
                          aggfunc='first')
             .rename(columns={'hi': 'p_hi', 'lo': 'p_lo'}).dropna())
    out = []
    for dd, g in piv.groupby(level=0):
        bb = rb.get(dd)
        if bb is None or dd not in day.index:
            continue
        H, L, C, T = bb['H'], bb['L'], bb['C'], bb['T']
        A = float(day.at[dd, 'ADR'])
        taken = False
        for (_, t), row in g.iterrows():
            if taken and one_per_day:
                break
            if t > last_entry:
                break
            k = int(np.searchsorted(T, t, side='right')) - 1
            if k < 30 or k >= len(H) - 5:
                continue
            rh = float(H[:k + 1].max()); rl = float(L[:k + 1].min())
            px = float(C[k])
            if (rh - rl) < min_swing * A:
                continue
            for long in (True, False):
                pin = row.p_lo if long else row.p_hi
                pout = row.p_hi if long else row.p_lo
                if not (pin >= thr_in and pout <= thr_out):
                    continue
                stop = (px - stop_frac * A) if long else (px + stop_frac * A)
                tgt = (rh + p * A) if long else (rl - p * A)
                R = stop_frac * A
                rew = (tgt - px) if long else (px - tgt)
                if rew <= 0 or R <= 0 or (rew / R) < rr_gate:
                    continue
                Hr, Lr = H[k + 1:], L[k + 1:]
                if long:
                    ti = np.flatnonzero(Hr >= tgt); xi = np.flatnonzero(Lr <= stop)
                else:
                    ti = np.flatnonzero(Lr <= tgt); xi = np.flatnonzero(Hr >= stop)
                ti = ti[0] if len(ti) else 10 ** 9
                xi = xi[0] if len(xi) else 10 ** 9
                if ti == 10 ** 9 and xi == 10 ** 9:
                    oc = 'timeout'
                    pts = (float(C[-1]) - px) if long else (px - float(C[-1]))
                elif ti < xi:
                    oc, pts = 'win', rew
                elif xi < ti:
                    oc, pts = 'loss', -R
                else:
                    oc, pts = 'ambig', -R
                net = pts - cost
                out.append(dict(day=dd, t=t, side='long' if long else 'short',
                                entry=px, stop=stop, tgt=tgt, R=R, rr=rew / R,
                                p_in=pin, outcome=oc, pts=net, Rmult=net / R,
                                usd=net * S.PT_VALUE[which], ADR=A, filled=True))
                taken = True
                break
    return pd.DataFrame(out)


# ---------------------------------------------------------------- repair C
def trades_rescore(day, rb, ev, which, model, f=0.33, b=0.05, p=0.10,
                   thr_in=0.85, thr_out=0.55, thr_fill=0.70, min_swing=0.30,
                   last_entry=930):
    """Limit entry, but the trade is only accepted if the model still endorses the
    state at the fill bar. Features are recomputed at the fill using only bars <= fill."""
    cost = S.COST_PTS[which]
    piv = (ev.pivot_table(index=['day', 't'], columns='side', values='p',
                          aggfunc='first')
             .rename(columns={'hi': 'p_hi', 'lo': 'p_lo'}).dropna())
    out = []
    for dd, g in piv.groupby(level=0):
        bb = rb.get(dd)
        if bb is None or dd not in day.index:
            continue
        H, L, C, T, V = bb['H'], bb['L'], bb['C'], bb['T'], bb['V']
        row_d = day.loc[dd]
        A = float(row_d.ADR)
        taken = False
        for (_, t), row in g.iterrows():
            if taken:
                break
            if t > last_entry:
                break
            k = int(np.searchsorted(T, t, side='right')) - 1
            if k < 30 or k >= len(H) - 5:
                continue
            rh = float(H[:k + 1].max()); rl = float(L[:k + 1].min())
            px = float(C[k]); swing = rh - rl
            if swing < min_swing * A:
                continue
            for long in (True, False):
                pin = row.p_lo if long else row.p_hi
                pout = row.p_hi if long else row.p_lo
                if not (pin >= thr_in and pout <= thr_out):
                    continue
                entry = (rl + f * swing) if long else (rh - f * swing)
                if (long and entry >= px) or ((not long) and entry <= px):
                    continue
                stop = (rl - b * A) if long else (rh + b * A)
                tgt = (rh + p * A) if long else (rl - p * A)
                oc, pts, fb = S.simulate_one(H, L, C, k, long, entry, stop, tgt)
                if oc == 'nofill':
                    taken = True
                    break
                j = k + 1 + fb                      # absolute index of the fill bar
                pf = _score_at(model, H, L, C, V, T, j, row_d, long)
                if pf < thr_fill:
                    out.append(dict(day=dd, outcome='vetoed', filled=False,
                                    p_in=pin, p_fill=pf, R=0.0, rr=np.nan,
                                    pts=0.0, Rmult=0.0, usd=0.0))
                    taken = True
                    break
                R = (entry - stop) if long else (stop - entry)
                net = pts - cost
                out.append(dict(day=dd, t=t, side='long' if long else 'short',
                                entry=entry, stop=stop, tgt=tgt, R=R,
                                rr=((tgt - entry) if long else (entry - tgt)) / R,
                                p_in=pin, p_fill=pf, outcome=oc, pts=net,
                                Rmult=net / R, usd=net * S.PT_VALUE[which],
                                ADR=A, filled=True))
                taken = True
                break
    return pd.DataFrame(out)


def _score_at(model, H, L, C, V, T, j, row_d, long):
    """Recompute the model's probability for the relevant side at bar j (causal)."""
    A = float(row_d.ADR); o = float(row_d.o930)
    cmaxH, cminL, ihi, ilo, nhi, nlo, vwap = F._running(H[:j + 1], L[:j + 1],
                                                        C[:j + 1], V[:j + 1])
    rh, rl = float(cmaxH[j]), float(cminL[j])
    used = (rh - rl) / A
    t = int(T[j]); el = (t - F.RTH0) / float(F.RTH1 - F.RTH0)
    vel = (C[j] - C[max(0, j - 30)]) / A
    vw = (C[j] - vwap[j]) / A
    mib = T[:j + 1] < F.RTH0 + 60
    ibh = float(H[:j + 1][mib].max()); ibl = float(L[:j + 1][mib].min())
    onH, onL = float(row_d.onH), float(row_d.onL)
    gap = (o - float(row_d.prevC)) / A
    sgn = 1.0 if not long else -1.0     # long trades stand on the LOW
    side = 'lo' if long else 'hi'
    run = (o - rl) / A if long else (rh - o) / A
    opp = (rh - o) / A if long else (o - rl) / A
    iex = ilo[j] if long else ihi[j]
    nnew = (nlo[j] if long else nhi[j]) / max(j, 1)
    lvl = rl if long else rh
    retr = (abs(lvl - C[j]) / A) / max(used, 1e-6)
    ibb = 1.0 if ((rl < ibl - 1e-9) if long else (rh > ibh + 1e-9)) else 0.0
    onb = 1.0 if ((rl < onL - 1e-9) if long else (rh > onH + 1e-9)) else 0.0
    s = 1.0 if long else 1.0
    vals = dict(s_el=el, s_run=run, s_opp=opp, s_used=used,
                s_room=max(0.0, 1.0 - used),
                s_since=(j - iex) / max(j, 1), s_nnew=nnew,
                s_pos=(C[j] - o) / A * (-1 if long else 1),
                s_vel=vel * (-1 if long else 1), s_retr=retr,
                s_vwap=vw * (-1 if long else 1), s_ibb=ibb, s_onb=onb,
                s_gap=gap * (-1 if long else 1),
                s_expa=used / max(el, 1e-6))
    X = np.array([[vals[c] for c in model.feats]], dtype=float)
    return float(model.M[side].predict_proba((X - model.mu[side]) / model.sd[side])[0, 1])


if __name__ == '__main__':
    print('TERMINUS M3 post-mortem\n' + '=' * 100)
    es_ev = build_events('ES')
    model = Model().fit(es_ev[es_ev.day <= '2019-12-31'])
    P = {w: prep(w, model) for w in ('ES', 'NQ')}

    print('\n  DIAGNOSIS — does getting filled destroy the conditioning?')
    print('  ' + '-' * 98)
    for w in ('ES', 'NQ'):
        day, rb, ev = P[w]
        if w == 'ES':
            ev = ev[ev.day >= '2020-01-01']; day = day[day.index >= '2020-01-01']
        fc = fill_conditioning(day, rb, ev)
        if not len(fc):
            continue
        a = fc.surv.mean()
        bf = fc[fc.filled].surv.mean()
        nf = fc[~fc.filled].surv.mean()
        print(f'  {w}: signals {len(fc):>5}   model said p~{fc.p.mean():.3f}   '
              f'ACTUAL survival {a:.3f}   |   if FILLED {bf:.3f} (n={fc.filled.sum()})   '
              f'if not filled {nf:.3f}')
        print(f'      -> conditioning damage: {bf - a:+.3f}')

    print('\n  REPAIR A — market entry, stop at a fraction of ADR (no fill selection)')
    print('  ' + '-' * 98)
    for w, dev in (('ES', True), ('NQ', False)):
        day, rb, ev = P[w]
        if dev:
            ev = ev[ev.day >= '2020-01-01']; day = day[day.index >= '2020-01-01']
        for sf in (0.15, 0.25, 0.35):
            t = trades_market(day, rb, ev, w, stop_frac=sf)
            if len(t):
                t['filled'] = True
                print(S.fmt(S.summarise(t, f'{w} stop={sf:.2f}ADR')))

    print('\n  REPAIR C — limit entry, re-scored at the fill')
    print('  ' + '-' * 98)
    for w, dev in (('ES', True), ('NQ', False)):
        day, rb, ev = P[w]
        if dev:
            ev = ev[ev.day >= '2020-01-01']; day = day[day.index >= '2020-01-01']
        for tf in (0.50, 0.65, 0.80):
            t = trades_rescore(day, rb, ev, w, model, thr_fill=tf)
            if len(t):
                nv = int((t.outcome == 'vetoed').sum())
                tt = t[t.outcome != 'vetoed']
                s = S.summarise(tt, f'{w} thr_fill={tf:.2f}')
                print(S.fmt(s) + f'   vetoed={nv}')

