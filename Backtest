"""
VRP BACKTEST on REAL DoltHub SPY option chains (bid/ask) -- the master-prompt-compliant test.
Pre-registered, fixed rule: monthly, sell a ~30-DTE 5%-OTM put, buy a 10%-OTM put
(DEFINED RISK), held to expiry. Net of real bid/ask + commission. Compare to NAKED short put
to expose the tail. Falsify: does it survive Mar-2020, 2x costs; Sortino/Calmar/CVaR.

    python3 vrp_backtest.py
"""
from __future__ import annotations
import json, os, time
import numpy as np
import pandas as pd
import requests
import yfinance as yf

BASE = "https://www.dolthub.com/api/v1alpha1/post-no-preference/options/master"
CACHE = "/Users/kaveh/mim_research/spy_chains.json"
COMMISSION = 1.30          # ~2 legs in @ $0.65; held to expiry
SHORT_OTM, LONG_OTM, DTE = 0.95, 0.90, 30


def load_cache():
    return json.load(open(CACHE)) if os.path.exists(CACHE) else {}


def chain_puts(date, cache):
    if date in cache:
        return cache[date]
    sql = (f"SELECT strike,bid,ask,delta,expiration FROM option_chain "
           f"WHERE act_symbol='SPY' AND date='{date}' AND call_put='Put'")
    for _ in range(4):
        try:
            j = requests.get(BASE, params={"q": sql}, timeout=60).json()
            if j.get("query_execution_status") == "Success":
                cache[date] = j["rows"]; return j["rows"]
        except Exception:
            pass
        time.sleep(1)
    cache[date] = []; return []


def main():
    spy = yf.download("SPY", start="2019-01-01", auto_adjust=True, progress=False)["Close"]
    spy = spy.iloc[:, 0] if hasattr(spy, "columns") else spy
    cache = load_cache()
    months = pd.date_range("2019-02-01", "2026-04-01", freq="MS")
    trades = []
    for m in months:
        # first trading date in month with an available chain
        entry = None
        for off in range(0, 7):
            d = (m + pd.Timedelta(days=off)).strftime("%Y-%m-%d")
            if d in spy.index.strftime("%Y-%m-%d").tolist():
                puts = chain_puts(d, cache)
                if puts:
                    entry = d; break
        if not entry:
            continue
        S0 = float(spy.loc[entry])
        df = pd.DataFrame(puts)
        for c in ("strike", "bid", "ask", "delta"):
            df[c] = pd.to_numeric(df[c], errors="coerce")
        df["expiration"] = pd.to_datetime(df["expiration"])
        df["dte"] = (df["expiration"] - pd.Timestamp(entry)).dt.days
        exp = df[df["dte"].between(20, 45)]
        if exp.empty:
            continue
        target = exp["dte"].sub(DTE).abs().idxmin()
        ed = exp.loc[target, "expiration"]
        leg = exp[exp["expiration"] == ed].dropna(subset=["strike", "bid", "ask"])
        exp_dates = spy.index[spy.index <= ed]
        if len(exp_dates) == 0:
            continue
        Sx = float(spy.loc[exp_dates[-1]])

        def spread(short_otm, long_otm):
            sK = leg.iloc[(leg["strike"] - short_otm * S0).abs().argsort()].iloc[0]
            lK = leg.iloc[(leg["strike"] - long_otm * S0).abs().argsort()].iloc[0]
            if sK["strike"] <= lK["strike"]:
                return None
            cr = sK["bid"] - lK["ask"]
            wd = sK["strike"] - lK["strike"]
            pay = cr - max(0, sK["strike"] - Sx) + max(0, lK["strike"] - Sx)
            return pay * 100 - COMMISSION, max((wd - cr) * 100, 1), cr
        otm = spread(SHORT_OTM, LONG_OTM)
        atm = spread(0.99, 0.94)                              # near-ATM short, 5%-wide
        if otm is None or atm is None:
            continue
        sKn = leg.iloc[(leg["strike"] - SHORT_OTM * S0).abs().argsort()].iloc[0]
        trades.append(dict(entry=entry, S0=S0, Sx=Sx, credit=otm[2],
                           spread_pnl=otm[0], spread_risk=otm[1],
                           atm_pnl=atm[0], atm_risk=atm[1], atm_credit=atm[2],
                           naked_pnl=(sKn["bid"] - max(0, sKn["strike"] - Sx)) * 100 - COMMISSION / 2,
                           naked_risk=0.20 * S0 * 100))
    json.dump(cache, open(CACHE, "w"))
    t = pd.DataFrame(trades).set_index(pd.to_datetime([x["entry"] for x in trades]))
    print(f"VRP put-spread backtest: {len(t)} monthly trades, {t.index[0].date()}->{t.index[-1].date()}\n")

    def stats(name, pnl, risk):
        r = (pnl / risk)                                     # return on capital-at-risk
        ann = 12
        sh = r.mean() / r.std() * np.sqrt(ann)
        so = r.mean() / r[r < 0].std() * np.sqrt(ann) if (r < 0).any() else np.nan
        eq = r.cumsum(); dd = (eq - eq.cummax()).min()
        cvar = r[r <= r.quantile(0.05)].mean()
        cagr = r.mean() * 12
        print(f"  {name:16s} Sharpe {sh:5.2f} | Sortino {so:5.2f} | Calmar {cagr/abs(dd) if dd<0 else 0:4.2f} "
              f"| avg {r.mean()*100:+4.1f}%/mo | maxDD {dd*100:5.0f}% | CVaR5 {cvar*100:5.0f}% | "
              f"win {(pnl>0).mean()*100:.0f}% | worst {r.min()*100:.0f}% ({r.idxmin().date()})")

    print("DEFINED-RISK put spreads (net real bid/ask + commission):")
    stats("OTM 5/10", t["spread_pnl"], t["spread_risk"])
    stats("ATM 1/6", t["atm_pnl"], t["atm_risk"])
    stats("ATM 2x-cost", t["atm_pnl"] - COMMISSION - (t["atm_credit"]*0.5*100).clip(lower=0), t["atm_risk"])
    print("\nNAKED short put -- the uncapped tail (DANGER, sample misses crashes):")
    stats("naked", t["naked_pnl"], t["naked_risk"])
    print(f"\n  Mar-2020 region trades:")
    for dt, row in t[(t.index >= "2020-02-01") & (t.index <= "2020-04-30")].iterrows():
        print(f"    {dt.date()}  spread {row['spread_pnl']/row['spread_risk']*100:+5.0f}%  "
              f"naked {row['naked_pnl']/row['naked_risk']*100:+5.0f}%")


if __name__ == "__main__":
    main()

