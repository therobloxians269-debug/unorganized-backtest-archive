                if not mr_hit and b > ER_N and rangep_o >= 6:
                    sd = np.std(devs[-24:]) if len(devs) >= 12 else 0
                    if sd > 0 and 2.0 * sd <= abs(c[b] - vwap) <= 3.5 * sd:
                        mr_hit = True
                        if planted: plant_left = 12; plant_dir = -np.sign(c[b] - vwap)
                if dtype == 'squeeze' and not broke and 12 <= b <= 40:
                    if c[b] > fh_hi or c[b] < fh_lo:
                        broke = True
                        if planted: plant_left = 22; plant_dir = 1.2 * (1 if c[b] > fh_hi else -1)
                if not swept and not trend_o:
                    if (h[b] > prev_hi and h[b] - prev_hi <= 0.5 * atr_o and c[b] < prev_hi - 1.0):
                        swept = True
                        if planted: plant_left = 15; plant_dir = -1
                    elif (l[b] < prev_lo and prev_lo - l[b] <= 0.5 * atr_o and c[b] > prev_lo + 1.0):
                        swept = True
                        if planted: plant_left = 15; plant_dir = 1
        days.append(dict(o=o, h=h, l=l, c=c, v=v, prev_hi=prev_hi, prev_lo=prev_lo,
                         spent_hi=spent_hi, spent_lo=spent_lo, dtype=dtype))
        prev_close = c[-1]; prev_hi = h.max(); prev_lo = l.min()
