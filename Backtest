TICK=0.25; FLAT=959

def featurize(f, rr=3.0, pv=2.0, comm=1.50, ce=0.5, maxwait=60, maxhold=240):
    df=pd.read_parquet(f)
    LV=build_levels(df); R=rejections(df,LV,minConf=1)
    x=df.rename(columns={'o':'open','h':'high','l':'low','c':'close'})[['open','high','low','close']]
    day,rth=fbuild(x); P=pred(M,day); di={d:i for i,d in enumerate(day.index)}
    o,h,l,c,v=df.o.values,df.h.values,df.l.values,df.c.values,df.v.values.astype(float)
    tod=(df.index.hour*60+df.index.minute).values
    dayidx=pd.DatetimeIndex(df.index).normalize()
    vma=pd.Series(v).rolling(60,min_periods=10).mean().shift(1).values
    rngb=h-l; bp=np.nan_to_num(np.where(rngb>0,2*(c-l)/np.where(rngb>0,rngb,1)-1,0))
    names=list(LV.columns); Lv=LV.values
    rows=[]
    for _,b in R.iterrows():
        i=int(b.i); d=int(b.dir)
        if i+2>=len(df) or not (570<=tod[i]<FLAT): continue
        dd=dayidx[i]
        if dd not in di: continue
        j=di[dd]; A=day.at[dd,'ADR']; o930=day.at[dd,'o930']
        if not np.isfinite(A) or A<=0: continue
        # session-so-far
        m=(dayidx==dd)&(tod>=570)&(np.arange(len(df))<=i)
        if m.sum()<15: continue
        runH=h[m].max(); runL=l[m].min()
        # ---- the stack ----
        which={n:0 for n in ['POC','VAH','VAL','VWAP','VWAP +1s','VWAP -1s','Kalman','EM Upper','EM Lower']}
        for nm_ in b.names.split('+'):
            if nm_ in which: which[nm_]=1
        trav=(runH-o930)/A if d==-1 else (o930-runL)/A
        fanq=0
        for q in [0.2,0.4,0.6,0.8,0.9,0.95]:
            if trav>=P[('hi' if d==-1 else 'lo',q)][j]: fanq=q
        orm=(dayidx==dd)&(tod>=570)&(tod<630)
        orh=h[orm].max() if orm.sum()>10 else np.nan; orl=l[orm].min() if orm.sum()>10 else np.nan
        feat=dict(conf=b.n, wick=(h[i]-max(o[i],c[i]))/rngb[i] if d==-1 and rngb[i]>0 else
                            ((min(o[i],c[i])-l[i])/rngb[i] if rngb[i]>0 else 0),
                  bp=bp[i]*(-d), volx=v[i]/vma[i] if np.isfinite(vma[i]) and vma[i]>0 else 1,
                  volz=(v[i]-v[m].mean())/(v[m].std()+1e-9),
                  trav=trav, fanq=fanq, used=(runH-runL)/A,
                  elapsed=(tod[i]-570)/390., barA=rngb[i]/A,
                  or_out=float(d==-1 and np.isfinite(orh) and h[i]>orh) + float(d==1 and np.isfinite(orl) and l[i]<orl),
                  dir=d, **{f'lv_{k}':vv for k,vv in which.items()})
        # ---- outcome: CE-50% entry, stop past the wick, rr target ----
        ext=l[i] if d==1 else h[i]; body=min(o[i],c[i]) if d==1 else max(o[i],c[i])
        lim=ext+ce*(body-ext); stp=(b.bot-2.0) if d==1 else (b.top+2.0)
        if (d==1 and stp>=lim) or (d==-1 and stp<=lim): continue
        risk=abs(lim-stp)
        if risk<1.5 or risk>60: continue
        fill=-1
        for k in range(i+1,min(i+1+maxwait,len(df))):
            if tod[k]>=FLAT: break
            if (l[k]<=lim) if d==1 else (h[k]>=lim): fill=k; break
        if fill<0: continue
        tgt=lim+d*rr*risk; pnl=np.nan
        for k in range(fill+1,min(fill+maxhold,len(df))):
            last=tod[k]>=FLAT or k==len(df)-1
            hs=(l[k]<=stp) if d==1 else (h[k]>=stp)
            ht=(h[k]>=tgt) if d==1 else (l[k]<=tgt)
            if hs: px=stp-d*TICK
            elif ht: px=tgt
            elif last: px=c[k]
            else: continue
            pnl=d*(px-lim)*pv-comm; break
        if not np.isfinite(pnl): continue
        feat.update(t=df.index[i], pnl=pnl, R=pnl/(risk*pv), risk=risk)
        rows.append(feat)
    return pd.DataFrame(rows)

