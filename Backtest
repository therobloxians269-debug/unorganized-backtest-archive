"""
MECHANISM SCREEN — which of these events are REAL in the tape, and do any of them
actually predict anything?

These are PROBES, not strategies. We are mapping which underlying mechanisms exist in
true aggressor flow. Whatever survives, we build OUR object on that mechanism — the
finding would be "absorption at levels is real", not "trade order blocks".

Data: 28 sessions, 1,758 RTH 5-min bars, Databento GLBX trades with aggressor side.
⚠️ POWER: with ~1,750 bars this screen can see effects of roughly 0.15 SD and up. That
is the right sensitivity for our purpose — a mechanism too weak to show here is also
too weak to pay a retail cost floor, so a miss here is not a miss that matters.

Every probe is scored the same way:
  · signed forward return over 3 / 6 / 12 bars (15 / 30 / 60 min)
  · normalised by the session's own bar-range scale
  · against a TIME-OF-DAY-MATCHED control drawn from all other bars
    (the lesson from today: an unmatched control hands the trigger credit for context)
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')

OF = '/Users/kaveh/Downloads/mesx/orderflow/bars_5min.parquet'
rng = np.random.default_rng(97)


def load():
    d = pd.read_parquet(OF)
    d = d[d.rth].copy().sort_values(['date_et', 'tod_min']).reset_index(drop=True)
    d['rng'] = d.high - d.low
    d['body'] = d.close - d.open
    g = d.groupby('date_et')
    d['scale'] = g['rng'].transform('median')
    d['vz'] = g['volume'].transform(lambda s: (s - s.mean()) / (s.std() + 1e-9))
    d['dz'] = g['delta'].transform(lambda s: (s - s.mean()) / (s.std() + 1e-9))
    d['bdz'] = g['big_delta'].transform(lambda s: (s - s.mean()) / (s.std() + 1e-9))
    # RESIDUALS — delta and bar direction co-move hard, so thresholding them
    # independently gives a near-empty set (measured: n=1..12). The residual is the
    # honest object: how much MORE aggression than this bar's travel deserved.
    bz = g['body'].transform(lambda s: (s - s.mean()) / (s.std() + 1e-9))
    d['bz'] = bz
    bt = np.polyfit(d.bz.values, d.dz.values, 1)[0]
    d['dres'] = d.dz - bt * d.bz                 # + = buying beyond the move
    rz = g['rng'].transform(lambda s: (s - s.mean()) / (s.std() + 1e-9))
    d['rz'] = rz
    bt2 = np.polyfit(d.vz.values, d.rz.values, 1)[0]
    d['rres'] = d.rz - bt2 * d.vz                # + = travel beyond the volume (thin book)
    d['cmaxH'] = g['high'].transform(lambda s: np.maximum.accumulate(s.values))
    d['cminL'] = g['low'].transform(lambda s: np.minimum.accumulate(s.values))
    d['new_hi'] = d.high >= d.cmaxH - 1e-9
    d['new_lo'] = d.low <= d.cminL + 1e-9
    # forward returns in units of the session's typical bar range
    for k in (3, 6, 12):
        d[f'f{k}'] = (g['close'].shift(-k) - d.close) / d.scale
    return d.dropna(subset=['f3', 'f6', 'f12'])


def probe(d, mask, sign, label, n_draw=400):
    """
    sign: +1 if the hypothesis says price goes UP after this event, -1 for down.
    `sign` may be an array (per-row direction) or a scalar.
    """
    s = np.asarray(sign, dtype=float)
    if s.ndim == 0:
        s = np.full(len(d), float(sign))
    m = np.asarray(mask, dtype=bool)
    n = int(m.sum())
    if n < 25:
        print(f'  {label:<38} n={n:<5} (too few)')
        return
    out = [f'  {label:<38} n={n:<5}']
    for k in (3, 6, 12):
        y = (s[m] * d[f'f{k}'].values[m])
        mu = float(np.nanmean(y))
        # time-of-day matched control
        tod = d.tod_min.values
        counts = pd.Series(tod[m]).value_counts()
        pool = {t: np.flatnonzero(tod == t) for t in counts.index}
        ctrl = []
        for _ in range(n_draw):
            pick = [rng.choice(pool[t], size=min(c, len(pool[t])), replace=False)
                    for t, c in counts.items() if len(pool[t])]
            ii = np.concatenate(pick)
            ctrl.append(float(np.nanmean(s[ii] * d[f'f{k}'].values[ii])))
        ctrl = np.array(ctrl)
        z = (mu - ctrl.mean()) / (ctrl.std() + 1e-12)
        out.append(f'  {k:>2}b {mu:>+7.3f} z{z:>+6.2f}')
    print(''.join(out))


if __name__ == '__main__':
    d = load()
    print('MECHANISM SCREEN — true aggressor flow, 28 sessions')
    print('=' * 96)
    print(f'  {len(d):,} RTH 5m bars   forward return in units of the session median bar range')
    print(f'  (+z means the event beat a time-of-day-matched control in the hypothesised '
          f'direction)\n')

    print('  --- ABSORPTION: more aggression than the bar\'s travel deserved ---')
    q90, q10 = d.dres.quantile(0.90), d.dres.quantile(0.10)
    q75, q25 = d.dres.quantile(0.75), d.dres.quantile(0.25)
    probe(d, d.dres >= q90, +1, 'buy absorption, top decile')
    probe(d, d.dres <= q10, -1, 'sell absorption, bottom decile')
    probe(d, (d.dres >= q75) & (d.body < 0), +1, 'buyers absorb a DOWN bar (q75)')
    probe(d, (d.dres <= q25) & (d.body > 0), -1, 'sellers absorb an UP bar (q75)')
    probe(d, (d.dres >= q75) & d.new_lo, +1, 'buy absorption AT a new low')
    probe(d, (d.dres <= q25) & d.new_hi, -1, 'sell absorption AT a new high')
    probe(d, d.dres >= q90, -1, 'buy absorption -> CONTINUATION (inverse)')

    print('\n  --- STOP CASCADE: large-lot aggression at a fresh extreme ---')
    b25, b75 = d.bdz.quantile(0.25), d.bdz.quantile(0.75)
    probe(d, d.new_lo & (d.bdz <= b25), +1, 'big-lot SELL into a new low (exhaust)')
    probe(d, d.new_hi & (d.bdz >= b75), -1, 'big-lot BUY into a new high (exhaust)')
    probe(d, d.new_lo & (d.bdz <= b25), -1, 'same, CONTINUATION hypothesis')

    print('\n  --- EXHAUSTION AT THE EXTREME: who printed at the high/low ---')
    dh = d.delta_at_high / d.vol_at_high.replace(0, np.nan)
    dl = d.delta_at_low / d.vol_at_low.replace(0, np.nan)
    probe(d, d.new_hi & (dh > 0.3), -1, 'buyers paying up AT the high')
    probe(d, d.new_lo & (dl < -0.3), +1, 'sellers hitting AT the low')

    print('\n  --- STACKED IMBALANCE (prior work said these FADE) ---')
    probe(d, d.buy_stack >= 3, -1, 'buy stack >=3  -> fade')
    probe(d, d.sell_stack >= 3, +1, 'sell stack >=3 -> fade')
    probe(d, d.buy_stack >= 3, +1, 'buy stack >=3  -> continue')

    print('\n  --- THIN BOOK: big move on little volume (the FVG mechanism) ---')
    r75 = d.rres.quantile(0.75)
    probe(d, (d.rres >= r75) & (d.body > 0), -1, 'thin move UP -> gives back')
    probe(d, (d.rres >= r75) & (d.body < 0), +1, 'thin move DOWN -> gives back')
    probe(d, (d.rres >= r75) & (d.body > 0), +1, 'thin move UP -> CONTINUES (inverse)')

    print('\n  --- CONTROL: does anything at all predict here? ---')
    probe(d, d.dz > 1.5, +1, 'raw delta z>1.5 -> up')
    probe(d, d.dz < -1.5, -1, 'raw delta z<-1.5 -> down')
    probe(d, d.vz > 1.5, +np.sign(d.body.values), 'heavy volume, go with the bar')

