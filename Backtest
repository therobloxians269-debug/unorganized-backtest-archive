# CONFIG RUNNER
# ======================================================================================
def build(B, cfg):
    f = cfg["fam"]
    p = {k: v for k, v in cfg.items() if k not in ("fam", "name", "targ_mult")}
    if f == "drift":
        return sig_drift(B, **p)
    if f == "ext":
        return sig_ext(B, **p)
    if f == "amd":
        return sig_amd(B, **p)
    raise ValueError(f)


def run_cfg(B, cfg, tag, targ_mult=None, seq=True):
    sg, d, st, dead = build(B, cfg)
    if len(sg) == 0:
        return pd.DataFrame(), dict(n=0, avgR=np.nan, dpt=np.nan, wr=np.nan, tpd=0,
                                    tot=0, maxdd=np.nan, drop3=np.nan, pf=np.nan, tstat=np.nan)
    tm = cfg.get("targ_mult", targ_mult)
    tr = simulate(B, sg, d, st, dead, COST[tag], sequential=seq, targ_mult=tm)
    return tr, stats(tr, B, COST[tag])


def run_placebo(B, cfg, tag, nseed=8, targ_mult=None):
    sg, d, st, dead = build(B, cfg)
    if len(sg) == 0:
        return np.nan, np.nan, []
    atrcol = ATRS[cfg.get("atr", "a15")]
    kstop = cfg.get("kstop", 0.5)
    av = getattr(B, atrcol)
    # recover the ATR that produced the stop so the placebo re-derives it at the shifted time
    smult = np.full(len(sg), kstop, float)
    hold_len = (dead - sg).astype(int)
    tm = cfg.get("targ_mult", targ_mult)
    out = []
    for s in range(nseed):
        p_sg, p_d, p_st, p_dead = placebo_events(B, sg, d, smult, hold_len, atrcol, seed=1000 + s)
        if len(p_sg) == 0:
            continue
        tr = simulate(B, p_sg, p_d, p_st, p_dead, COST[tag], sequential=True, targ_mult=tm)
        s2 = stats(tr, B, COST[tag])
        out.append(s2)
    if not out:
        return np.nan, np.nan, []
    return float(np.mean([o["avgR"] for o in out])), float(np.std([o["avgR"] for o in out])), out


