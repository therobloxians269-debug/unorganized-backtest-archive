#!/usr/bin/env python3
"""Re-price the two ICT modules under REALISTIC Tradovate friction (limit fills).
Managers return GROSS pts; friction applied per exit-kind:
  commission 0.16pt always; +0.25pt (1 tick) slippage per MARKET fill;
  limit fills (FVG entry, fixed-target exit) = 0 slippage."""
import numpy as np, pandas as pd
import ict_exits as ie
TICK = ie.TICK; DPP = 5.0
COMM = 0.16; SLIP = 0.25
EOD = 15*3600 + 45*60

def fric_sb(kind):                      # SB: limit entry, limit TP, market otherwise
    return COMM + (0.0 if kind == "tp" else SLIP)
def fric_mof(kind, entry_market=True):  # MOF: momentum reclaim entry
    return COMM + (SLIP if entry_market else 0.0) + (0.0 if kind == "tp" else SLIP)

# ---- SB manager returns GROSS pts ----
def sb_manage(sdir, entry, stop, risk, H, L, C, sod, s, mode):
    reached = False; maxfav = 0.0
    tgt2 = entry + sdir*2*risk; tgt1 = entry + sdir*1*risk; n = len(H)
    for j in range(s, n):
        hi = H[j]; lo = L[j]
        if (lo <= stop) if sdir > 0 else (hi >= stop):
            return sdir*(stop-entry), "stop"
        if mode == "2R" and ((hi >= tgt2) if sdir > 0 else (lo <= tgt2)):
            return sdir*(tgt2-entry), "tp"
        if mode == "1R" and ((hi >= tgt1) if sdir > 0 else (lo <= tgt1)):
            return sdir*(tgt1-entry), "tp"
        if sod[j] >= EOD:
            return sdir*(C[j]-entry), "flat"
        fav = (hi-entry) if sdir > 0 else (entry-lo)
        if mode == "time12":
            if fav >= risk and not reached:
                reached = True; stop = entry
            if (not reached) and (j - s + 1) >= 12:
                return sdir*(C[j]-entry), "time"
        if mode == "trail1R":
            maxfav = max(maxfav, fav)
            if maxfav >= risk:
                if not reached:
                    reached = True; stop = entry
                tr = entry + maxfav - risk if sdir > 0 else entry - maxfav + risk
                stop = max(stop, tr) if sdir > 0 else min(stop, tr)
    return sdir*(C[n-1]-entry), "flat"

def sb_run(sessions, mode):
    out = []
    for dte, a in sessions:
        O,H,L,C,sod,A = a["O"],a["H"],a["L"],a["C"],a["sod"],a["atr1"]
        liq = (sod >= 7200) & (sod < 34200)
        if liq.sum() < 30: continue
        sH = H[liq].max(); sL = L[liq].min()
        win = np.flatnonzero((sod >= 36000) & (sod < 39600))
        if win.size < 5: continue
        n = len(H); i = win[0]
        swept=False; sdir=0; structHi=structLo=np.nan; dispLo=np.inf; dispHi=-np.inf
        mss=False; ordered=False; wait=0; obar=-1; entry=stop=np.nan; fillbar=-1
        while i < n and sod[i] < 39600 + 3600:
            if not swept:
                if L[i] < sL: swept=True; sdir=1; structHi=H[max(0,i-5):i].max(); dispLo=L[i]
                elif H[i] > sH: swept=True; sdir=-1; structLo=L[max(0,i-5):i].min(); dispHi=H[i]
            elif not mss:
                if sdir==1:
                    dispLo=min(dispLo,L[i])
                    if C[i] > structHi and (C[i]-O[i]) >= 1.5*A[i]: mss=True
                else:
                    dispHi=max(dispHi,H[i])
                    if C[i] < structLo and (O[i]-C[i]) >= 1.5*A[i]: mss=True
            elif not ordered:
                if sdir==1 and i>=2 and L[i] > H[i-2] and (L[i]-H[i-2]) > 0.25*A[i]:
                    entry=L[i]; stop=dispLo-2*TICK; ordered=True; wait=0; obar=i
                elif sdir==-1 and i>=2 and H[i] < L[i-2] and (L[i-2]-H[i]) > 0.25*A[i]:
                    entry=H[i]; stop=dispHi+2*TICK; ordered=True; wait=0; obar=i
            else:
                if i > obar:
                    wait += 1
                    if (sdir==1 and L[i]<=entry) or (sdir==-1 and H[i]>=entry): fillbar=i; break
                    if wait > 5: break
            i += 1
        if fillbar >= 0 and abs(entry-stop) > 0:
            g, k = sb_manage(sdir, entry, stop, abs(entry-stop), H, L, C, sod, fillbar+1, mode)
            out.append((dte, g, k, g - fric_sb(k)))
    return pd.DataFrame(out, columns=["date","gross","kind","net"])

def mof_run(sessions, entry_market=True):
    out = []
    for dte, a in sessions:
        O,H,L,C,sod = a["O"],a["H"],a["L"],a["C"],a["sod"]
        R,A5,xup,xdn = a["rsi5"],a["atr5"],a["xup"],a["xdn"]
        m0 = np.flatnonzero(sod == 0)
        if m0.size == 0: continue
        mid = O[m0[0]]; armL=armS=False; pos=0; entry=stop=np.nan; nT=0; n=len(C)
        for i in range(n):
            if pos != 0:
                hitS = L[i] <= stop if pos > 0 else H[i] >= stop
                if hitS:
                    g = pos*(stop-entry); out.append((dte,g,"sl",g-fric_mof("sl",entry_market))); pos=0; continue
                if (H[i] >= mid) if pos > 0 else (L[i] <= mid):
                    g = pos*(mid-entry); out.append((dte,g,"tp",g-fric_mof("tp",entry_market))); pos=0; continue
                if sod[i] >= EOD:
                    g = pos*(C[i]-entry); out.append((dte,g,"flat",g-fric_mof("flat",entry_market))); pos=0; continue
            if not ((sod[i] >= 30600) & (sod[i] < 41400)): continue
            disc = C[i] < mid; prem = C[i] > mid
            if disc and not np.isnan(R[i]) and R[i] < 30: armL = True
            if prem and not np.isnan(R[i]) and R[i] > 70: armS = True
            if pos == 0 and nT < 2:
                if armL and disc and xup[i] and not np.isnan(A5[i]):
                    pos=1; entry=C[i]; stop=C[i]-1.5*A5[i]; armL=False; nT+=1
                elif armS and prem and xdn[i] and not np.isnan(A5[i]):
                    pos=-1; entry=C[i]; stop=C[i]+1.5*A5[i]; armS=False; nT+=1
    return pd.DataFrame(out, columns=["date","gross","kind","net"])

def show(tr, name):
    if len(tr) < 10: print(f"{name:34s} (too few)"); return
    tr = tr.copy(); tr["yr"] = pd.to_datetime(tr["date"]).dt.year
    def one(d):
        if len(d) < 5: return "  —"
        net = d["net"].to_numpy(); eq = np.cumsum(net)*DPP; dd = (eq-np.maximum.accumulate(eq)).min()
        return (f"n={len(d):4d} gross={d['gross'].mean():+.3f} net={d['net'].mean():+.3f} "
                f"${net.sum()*DPP:>7.0f} hit={(net>0).mean():.2f} maxDD=${dd:>7.0f}")
    print(f"{name}")
    print(f"   ALL      {one(tr)}")
    print(f"   pre-2020 {one(tr[tr.yr<2020])}")
    print(f"   2022+    {one(tr[tr.yr>=2022])}")

def main():
    S = ie.load()
    print(f"loaded {len(S)} sessions. Friction: {COMM}pt comm + {SLIP}pt slip per MARKET fill (limit=0)\n")
    print("===== SILVER BULLET (gross-negative -> friction can't save it) =====")
    for m in ["2R","time12"]:
        show(sb_run(S, m), f"SB {m}")
    print("\n===== MIDNIGHT FADE (gross-positive -> friction is decisive) =====")
    show(mof_run(S, entry_market=True),  "MOF anchor (MARKET entry, realistic)")
    show(mof_run(S, entry_market=False), "MOF anchor (LIMIT entry, optimistic)")

if __name__ == "__main__":
    main()

