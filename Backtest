@dataclass
class Setup:
    arm_idx: int
    expiry_idx: int
    direction: int
    entry: float
    stop: float
    target: float
    model: str
    score: int
    meta: dict = field(default_factory=dict)

    @property
    def risk(self) -> float:
        return abs(self.entry - self.stop)

    @property
    def rr(self) -> float:
        return abs(self.target - self.entry) / self.risk if self.risk else 0.0


@dataclass
class Context:
    df: pd.DataFrame               # base feed (UTC index)
    df_ny: pd.DataFrame            # same bars, NY index (for killzone checks)
    bias: np.ndarray              # {+1,-1,0} per base bar
    swings: list
    events: list
    sweeps: list
    fvgs: list
    levels: list
    atr: np.ndarray
    tick: float
    secondary: pd.DataFrame | None = None
    session_ord: np.ndarray | None = None
    profiles: list | None = None   # VolumeProfile per session ordinal (or None)


def _fvg_entry(fvg: FVG, mode: str) -> float:
    """Entry price inside an FVG for a given fill philosophy.

    After displacement the gap sits between price and the origin; a pullback
    touches the *near* edge first, then the 50% consequent encroachment, then the
    *far* edge (the deep, best-price fill). direction is baked into top/bottom.
    """
    if fvg.direction > 0:      # bullish gap below price: near=top, far=bottom
        return {"edge": fvg.top, "ce": fvg.ce, "far": fvg.bottom}.get(mode, fvg.ce)
    else:                       # bearish gap above price: near=bottom, far=top
        return {"edge": fvg.bottom, "ce": fvg.ce, "far": fvg.top}.get(mode, fvg.ce)


def _prior_profile(ctx: Context, t: int) -> VolumeProfile | None:
    if ctx.session_ord is None or ctx.profiles is None:
        return None
    o = int(ctx.session_ord[t])
    if o - 1 < 0 or o - 1 >= len(ctx.profiles):
        return None
    return ctx.profiles[o - 1]


def _target_pool(ctx: Context, entry: float, direction: int, known_idx: int,
                 risk: float, cfg: ModelConfig) -> tuple[float, str]:
    """Pick the opposing draw-on-liquidity beyond entry (nearest that clears min_rr)."""
    candidates: list[tuple[float, str]] = []
    for lv in ctx.levels:
        if lv.known_idx > known_idx:
            continue
        if direction > 0 and lv.side > 0 and lv.price > entry:
            candidates.append((lv.price, lv.ltype))
        if direction < 0 and lv.side < 0 and lv.price < entry:
            candidates.append((lv.price, lv.ltype))
    # Volume-profile magnets (POC / value-area edges) as extra draws.
    vp = _prior_profile(ctx, known_idx)
    if vp is not None:
        for px, tag in ((vp.poc, "POC"), (vp.vah, "VAH"), (vp.val, "VAL")):
            if direction > 0 and px > entry:
                candidates.append((px, tag))
            if direction < 0 and px < entry:
                candidates.append((px, tag))

    floor = cfg.min_rr * risk
    if direction > 0:
        qualifying = [(px, tag) for px, tag in candidates if (px - entry) >= floor]
    else:
        qualifying = [(px, tag) for px, tag in candidates if (entry - px) >= floor]
    if qualifying:
        # Nearest qualifying pool = the conservative, reachable objective.
        px, tag = min(qualifying, key=lambda c: abs(c[0] - entry))
        return px, tag
    # Fallback: fixed R multiple.
    tgt = entry + direction * cfg.rr_target * risk
    return tgt, "RR"


def _recent_fvg(ctx: Context, direction: int, lo_idx: int, hi_idx: int) -> FVG | None:
    """Most recent same-direction FVG whose formation bar is in (lo_idx, hi_idx]."""
    best = None
    for f in ctx.fvgs:
        if f.direction != direction:
            continue
        if lo_idx < f.idx <= hi_idx:
            if best is None or f.idx > best.idx:
                best = f
    return best


def build_setups(ctx: Context, cfg: ModelConfig) -> list[Setup]:
    df = ctx.df
    df_ny = ctx.df_ny
    n = len(df)
    events = ctx.events
    setups: list[Setup] = []

    # Index structure events by bar for quick forward scans.
    events_by_idx = sorted(events, key=lambda e: e.idx)
    ev_idx = np.array([e.idx for e in events_by_idx]) if events_by_idx else np.array([], dtype=int)

    for sw in ctx.sweeps:
        d = sw.reversal_dir
        if cfg.pool_types and sw.ltype not in cfg.pool_types:
            continue

        # 1) find the first same-direction MSS within the window after the raid.
        j0 = int(np.searchsorted(ev_idx, sw.idx + 1, side="left")) if len(ev_idx) else 0
        mss = None
        for k in range(j0, len(events_by_idx)):
            e = events_by_idx[k]
            if e.idx > sw.idx + cfg.mss_window:
                break
            if e.direction != d:
                continue
            if cfg.require_displacement and not displacement_at(df, e.idx, d, ctx.atr):
                continue
            mss = e
            break
        if mss is None:
            continue

        m = mss.idx
        # 2) killzone gate on the shift bar.
        if cfg.killzones:
            kz = _sessions.active_killzones(df_ny.index[m])
            if not any(z in cfg.killzones for z in kz):
                continue

        # 3) bias gate.
        bias = int(ctx.bias[m])
        if cfg.require_bias and bias != d:
            continue

        # 4) the entry PD array: FVG in the displacement leg, else order block.
        fvg = _recent_fvg(ctx, d, sw.idx, m)
        entry = None
        entry_kind = None
        if fvg is not None:
            entry, entry_kind = _fvg_entry(fvg, cfg.entry_mode), f"FVG_{cfg.entry_mode}"
        elif cfg.use_order_block_fallback:
            ob = order_block_before(df, m, d, max_lookback=cfg.mss_window)
            if ob is not None:
                entry = (ob.top + ob.bottom) / 2.0
                entry_kind = "OB_CE"
        if entry is None:
            continue

        # 5) stop beyond the raid extreme.
        buf = cfg.stop_buffer_ticks * ctx.tick
        stop = sw.extreme - buf if d > 0 else sw.extreme + buf
        risk = abs(entry - stop)
        if risk <= 0:
            continue
        # entry must sit on the correct side of the stop.
        if d > 0 and not (stop < entry):
            continue
        if d < 0 and not (stop > entry):
            continue

        # 6) target = opposing draw on liquidity.
        target, tgt_tag = _target_pool(ctx, entry, d, m, risk, cfg)
        if d > 0 and not (target > entry):
            continue
        if d < 0 and not (target < entry):
            continue
        rr = abs(target - entry) / risk
        if rr < cfg.min_rr - 1e-9:
            continue

        # --- confluences / scoring ---
        score = 0
        meta = {"pool": sw.ltype, "entry_kind": entry_kind, "target_tag": tgt_tag,
                "bias": bias, "rr": round(rr, 2)}

        if bias == d:
            score += 1
            meta["bias_ok"] = True

        rng = current_range(ctx.swings, m)
        ote_ok = False
        pd_ok = True
        if rng is not None:
            frac = rng.frac(entry)
            meta["pd_frac"] = round(frac, 3)
            if d > 0 and frac < 0.5:
                pd_ok = True; score += 1
            elif d < 0 and frac > 0.5:
                pd_ok = True; score += 1
            else:
                pd_ok = not cfg.require_discount_premium
            ote_ok = in_ote(entry, rng.low, rng.high, d)
            if ote_ok:
                score += 1
                meta["ote"] = True
        if cfg.require_discount_premium and not pd_ok:
            continue
        if cfg.require_ote and not ote_ok:
            continue

        smt_ok = smt_confirms(df, ctx.secondary, m, d) if ctx.secondary is not None else False
        if smt_ok:
            score += 1
            meta["smt"] = True
        if cfg.require_smt and not smt_ok:
            continue

        vp = _prior_profile(ctx, m)
        if vp is not None and vp.is_lvn(entry):
            score += 1
            meta["lvn"] = True

        if score < cfg.min_score:
            continue

        setups.append(Setup(
            arm_idx=m,
            expiry_idx=min(n - 1, m + cfg.entry_valid_bars),
            direction=d,
            entry=float(entry),
            stop=float(stop),
            target=float(target),
            model=cfg.name,
            score=score,
            meta=meta,
        ))

    setups.sort(key=lambda s: s.arm_idx)
    return setups

