"""Which morning statistic best predicts whether the AFTERNOON trends or reverts?
Lo-MacKinlay variance ratio (M2, heteroskedasticity-robust) · Hurst (R/S) · OU half-life ·
lag-1 autocorrelation · Kaufman efficiency ratio. All computed 09:30-10:30, causal."""
import numpy as np, pandas as pd, warnings; warnings.filterwarnings('ignore')

def vr_lomac(r, q):
    """Lo-MacKinlay variance ratio + heteroskedasticity-robust M2 statistic."""
    n=len(r)
    if n < q*3: return np.nan, np.nan
    mu=r.mean()
    va=((r-mu)**2).sum()/(n-1)
    rq=np.convolve(r,np.ones(q),'valid')          # overlapping q-sums
    m=q*(n-q+1)*(1-q/n)
    vb=((rq-q*mu)**2).sum()/m
    if va<=0: return np.nan, np.nan
    vr=vb/va
    # heteroskedasticity-consistent asymptotic variance
    th=0.0
    for j in range(1,q):
        d=((r[j:]-mu)**2 * (r[:-j]-mu)**2).sum() / (((r-mu)**2).sum()**2)
        th += (2*(q-j)/q)**2 * d
    z=(vr-1)/np.sqrt(th) if th>0 else np.nan
    return vr, z

def hurst_rs(x):
    """classic R/S Hurst over dyadic windows"""
    x=np.asarray(x,float); n=len(x)
    if n<32: return np.nan
    ns=[]; rs=[]
    w=8
    while w<=n//2:
        k=n//w; vals=[]
        for i in range(k):
            s=x[i*w:(i+1)*w]
            z=s-s.mean(); c=np.cumsum(z)
            R=c.max()-c.min(); S=s.std(ddof=1)
            if S>0: vals.append(R/S)
        if vals: ns.append(w); rs.append(np.mean(vals))
        w*=2
    if len(ns)<3: return np.nan
    return np.polyfit(np.log(ns),np.log(rs),1)[0]

def ou_halflife(p):
    p=np.asarray(p,float)
    dp=np.diff(p); lag=p[:-1]
    if len(dp)<20 or lag.std()==0: return np.nan
    b=np.polyfit(lag,dp,1)[0]
    return np.log(2)/(-b) if b<0 else np.nan

def build(df, decide=630):
    m=(df.index.hour*60+df.index.minute)
    r=df[(m>=570)&(m<960)].copy(); r['tod']=m[(m>=570)&(m<960)]; r['day']=r.index.normalize()
    rows=[]
    for day,b in r.groupby('day'):
        if len(b)<300: continue
        pre=b[b.tod<=decide]; post=b[b.tod>decide]
        if len(pre)<45 or len(post)<60: continue
        p=pre.c.values; ret=np.diff(np.log(p))
        if ret.std()==0: continue
        vr2,z2=vr_lomac(ret,2); vr5,z5=vr_lomac(ret,5); vr10,_=vr_lomac(ret,10)
        H=hurst_rs(p); hl=ou_halflife(p)
        ac1=pd.Series(ret).autocorr(1)
        er=abs(p[-1]-p[0])/np.abs(np.diff(p)).sum()      # Kaufman efficiency ratio
        ibd=abs(p[-1]-pre.o.iloc[0])/max(pre.h.max()-pre.l.min(),1e-9)
        # ── the LABEL: does the AFTERNOON trend? ──
        po=post.c.values
        aft_de=abs(po[-1]-po[0])/max(post.h.max()-post.l.min(),1e-9)
        aft_er=abs(po[-1]-po[0])/np.abs(np.diff(po)).sum()
        rows.append(dict(day=day,vr2=vr2,z2=z2,vr5=vr5,z5=z5,vr10=vr10,H=H,hl=hl,ac1=ac1,
                         er=er,ib_de=ibd,aft_de=aft_de,aft_er=aft_er,
                         aft_rng=post.h.max()-post.l.min()))
    return pd.DataFrame(rows).replace([np.inf,-np.inf],np.nan)

def auc(x,y):
    ok=np.isfinite(x)&np.isfinite(y)
    x,y=x[ok],y[ok]
    a=x[~y]; b=x[y]
    if len(a)<10 or len(b)<10: return np.nan
    rk=pd.Series(np.concatenate([a,b])).rank().values
    return (rk[len(a):].sum()-len(b)*(len(b)+1)/2)/(len(a)*len(b))

