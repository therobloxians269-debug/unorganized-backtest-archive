"""
APEX $50k EVALUATION pass-probability simulator.
Rules: start $50,000; PASS at +$3,000 ($53,000); trailing DD $2,500 following the equity
peak, LOCKING at $50,100 once peak >= $52,600; overnight allowed; no time limit.
Generator = our 14-mkt futures TREND program's real daily net returns, block-bootstrapped
(preserves fat tails + autocorrelation) and scaled to a chosen daily $ volatility.
Finds the sizing that maximizes P(pass before bust).

    python3 apex_sim.py
"""
from __future__ import annotations
import numpy as np
import pandas as pd

PANEL = "/Users/kaveh/mim_research/futures_panel.parquet"
ANN = 252
START, TARGET, TRAIL, LOCK = 50_000.0, 53_000.0, 2_500.0, 50_100.0
H, TRIALS, BLOCK = 252, 40_000, 10
FEE = 150.0


def trend_returns():
    """Rebuild the improved trend sleeve daily net returns (Sharpe ~0.49)."""
    p = pd.read_parquet(PANEL)
    F = p.pivot_table(index="date", columns="root", values="fret").sort_index()
    AV = (F.rolling(63).std() * np.sqrt(ANN)).shift(1)
    P = (1 + F.fillna(0)).cumprod()
    z = sum((P / P.shift(L) - 1) / (AV * np.sqrt(L / ANN)) for L in (63, 126, 252)) / 3
    w = (np.tanh(z) / AV).shift(1)
    w = w.div(w.abs().sum(axis=1).replace(0, np.nan), axis=0).fillna(0.0).clip(-0.2, 0.2)
    w = w.resample("W").last().reindex(w.index, method="ffill")
    g = (w * F).sum(axis=1)
    scale = (0.12 / (g.rolling(63).std() * np.sqrt(ANN))).shift(1).clip(0, 3).fillna(0.0)
    w = w.mul(scale, axis=0)
    turn = w.diff().abs().sum(axis=1)
    net = ((w * F).sum(axis=1) - turn * 3.0 * 1e-4).dropna()
    return net


def simulate(z, sigma_dollar, rng):
    """z = unit-daily-vol return pool; returns (pass%, bust%, timeout%, median days-to-pass)."""
    n = len(z)
    nb = int(np.ceil(H / BLOCK))
    starts = rng.integers(0, n, size=(TRIALS, nb))
    idx = (starts[:, :, None] + np.arange(BLOCK)[None, None, :]).reshape(TRIALS, -1)[:, :H] % n
    pnl = z[idx] * sigma_dollar                       # (TRIALS, H) daily $ P&L
    eq = START + np.cumsum(pnl, axis=1)
    peak = np.maximum.accumulate(eq, axis=1)
    floor = np.minimum(peak - TRAIL, LOCK)
    bust = eq <= floor
    win = eq >= TARGET
    first_bust = np.where(bust.any(1), bust.argmax(1), H + 1)
    first_win = np.where(win.any(1), win.argmax(1), H + 2)
    passed = first_win < first_bust
    busted = first_bust < first_win
    timeout = ~passed & ~busted
    med_days = np.median(first_win[passed]) if passed.any() else np.nan
    return passed.mean(), busted.mean(), timeout.mean(), med_days


def main():
    net = trend_returns()
    dvol = net.std()
    z = (net / dvol).values                            # unit daily vol
    ann_sh = net.mean() / dvol * np.sqrt(ANN)
    print(f"generator: futures trend, {net.index[0].date()}->{net.index[-1].date()}, "
          f"Sharpe {ann_sh:.2f}, daily skew {pd.Series(z).skew():.2f}\n")
    print(f"Apex $50k: pass +${TARGET-START:.0f}, trail ${TRAIL:.0f} (lock ${LOCK:.0f}), no time limit, {H}d cap\n")
    rng = np.random.default_rng(7)
    print(f"  {'$vol/day':>9} {'~micros':>8} {'PASS%':>7} {'BUST%':>7} {'TIMEOUT%':>9} {'medDays':>8} {'fees/pass':>10}")
    for sd in (100, 150, 200, 300, 450, 650, 900):
        pp, bb, to, md = simulate(z, sd, rng)
        micros = sd / 200.0                            # ~ $200 daily P&L vol per micro-ish unit
        feespass = FEE / pp if pp > 0 else np.inf
        print(f"  {sd:8.0f}$ {micros:7.1f} {pp*100:6.1f}% {bb*100:6.1f}% {to*100:8.1f}% "
              f"{md:7.0f} {feespass:9.0f}$")

    # also show an optimistic generator (ETF-trend-like Sharpe 0.74) by lifting drift
    print("\n  [optimistic: if executed at ETF-trend quality ~Sharpe 0.74]")
    z2 = z + (0.74 - ann_sh) / np.sqrt(ANN)            # shift mean to raise Sharpe to ~0.74
    rng = np.random.default_rng(7)
    print(f"  {'$vol/day':>9} {'~micros':>8} {'PASS%':>7} {'BUST%':>7} {'TIMEOUT%':>9} {'medDays':>8}")
    for sd in (150, 300, 450, 650):
        pp, bb, to, md = simulate(z2, sd, rng)
        print(f"  {sd:8.0f}$ {sd/200.0:7.1f} {pp*100:6.1f}% {bb*100:6.1f}% {to*100:8.1f}% {md:7.0f}")

    print("\n  caveat: daily-granularity DD (Apex trails intraday peak -> real bust% slightly higher);")
    print("  PASS only gets a funded acct -> income then depends on funded payout rules + the same edge.")


if __name__ == "__main__":
    main()

