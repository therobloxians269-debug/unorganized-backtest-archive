"""Validate Path A on the 14 futures we ALREADY own (no spend): does a managed-futures
trend+carry program diversify our equity trend+momentum combo and pull drawdown toward <10%?

If the cross-asset stack lowers DD / lifts Sharpe, expanding to ~30 markets is a clear buy.
If not, we've saved the data spend. All on existing data.

    PYTHONPATH=. python3 research/managed_futures_stack.py
"""
from __future__ import annotations

import numpy as np
import pandas as pd

from ope.trend import ETF_BASKET, ETF_COST_BP, backtest
from ope.validation import perf_stats, probabilistic_sharpe_ratio
from research.combine_edges import momentum_net
from research.trend_carry import build_signals, load_outrights, net, norm_w

ANN, TGT, OOS = 252.0, 0.10, "2022-01-01"


def maxdd(r):
    eq = (1 + r).cumprod()
    return float((eq / eq.cummax() - 1).min())


def rp(series_dict, tgt=TGT):
    """Risk-parity blend: scale each to equal vol, average, re-target (real return units)."""
    z = pd.concat(series_dict, axis=1).dropna()
    blend = (z / z.std()).mean(axis=1)
    return blend * (tgt / np.sqrt(ANN)) / blend.std()


def line(name, r, bench):
    s = perf_stats(r); o = perf_stats(r[r.index >= OOS])
    bb = pd.concat([r, bench], axis=1).dropna()
    beta = bb.cov().iloc[0, 1] / bb.iloc[:, 1].var()
    print(f"  {name:<22} Sh {s['sharpe']:.2f} (OOS {o['sharpe']:.2f}) | ann {s['ann_return']*100:4.1f}% "
          f"| maxDD {s['max_drawdown']*100:6.1f}% | beta {beta:+.2f}")


def main():
    import yfinance as yf
    # managed futures: trend + carry on the 14 markets we own
    R, ts, cs = build_signals(load_outrights())
    wt, wv = norm_w(R, ts), norm_w(R, cs)
    mf = net(R, 0.5 * wt + 0.5 * wv)

    # equity: trend (ETF) + cross-sectional momentum (S&P)
    etf = yf.download(ETF_BASKET, start="2006-01-01", auto_adjust=True, progress=False)["Close"]
    etf = etf.dropna(how="all").dropna(axis=1, thresh=int(len(etf) * 0.4))
    trend = backtest(etf, cost_bp={k: v for k, v in ETF_COST_BP.items() if k in etf.columns}).net
    mom = momentum_net(yf)
    spy = yf.download("SPY", start="2006-01-01", auto_adjust=True, progress=False)["Close"].squeeze()
    spyr = spy.pct_change()

    equity = rp({"trend": trend, "mom": mom})
    full3 = rp({"trend": trend, "mom": mom, "mf": mf})

    j = pd.concat({"equity": equity, "mf": mf.reindex(equity.index)}, axis=1).dropna()
    corr = j["equity"].corr(j["mf"])
    print(f"period {full3.index[0].date()} -> {full3.index[-1].date()}")
    print(f"corr(equity-combo, managed-futures) = {corr:+.2f}  (low = real cross-asset diversification)\n")

    print("components & stacks (vs SPY):")
    line("equity combo", equity, spyr)
    line("managed futures (T+C)", mf, spyr)
    line("STACK equity+MF", full3, spyr)

    print("\nDrawdown vs vol-target for the 3-way stack (your <10% DD goal):")
    for vt in (0.10, 0.08, 0.06):
        r = full3 * (vt / np.sqrt(ANN)) / full3.std()
        flag = " <-- <10% DD" if maxdd(r) > -0.10 else ""
        print(f"  vol {vt*100:.0f}%: ann {r.mean()*ANN*100:4.1f}% | maxDD {maxdd(r)*100:5.1f}% "
              f"| Sharpe {r.mean()/r.std()*np.sqrt(ANN):.2f} | PSR>1.0 "
              f"{probabilistic_sharpe_ratio(r,1.0/np.sqrt(ANN))*100:4.1f}%{flag}")


if __name__ == "__main__":
    main()

