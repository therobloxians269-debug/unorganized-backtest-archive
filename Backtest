"""Tradeable intrinsic-time test. At a DC confirmation (known AT that bar), enter in the DC
direction. Stop = back at the DC origin extreme (risk = d by construction). Target = k*d.
Race starts the bar AFTER confirmation. Fully causal."""
import numpy as np, pandas as pd, warnings; warnings.filterwarnings('ignore')
TICK=0.25
def dc_conf(h,l,c,d):
    """causal DC confirmations on intrabar extremes; returns list of (i, dir, origin_px)"""
    n=len(c); ev=[]; mode=0; ext=c[0]; oi=0
    for i in range(1,n):
        if mode<=0:
            if l[i]<ext: ext=l[i]; oi=i
            if h[i]>=ext*(1+d):
                ev.append((i,1,ext)); mode=1; ext=h[i]; oi=i
        if mode>=0:
            if h[i]>ext: ext=h[i]; oi=i
            if l[i]<=ext*(1-d):
                ev.append((i,-1,ext)); mode=-1; ext=l[i]; oi=i
    return ev

def run(df,d,kt,pv=2.0,comm=1.50,maxhold=600,rth=True,flat=959):
    o,h,l,c=df.o.values,df.h.values,df.l.values,df.c.values
    m=(df.index.hour*60+df.index.minute).values; n=len(df)
    ev=dc_conf(h,l,c,d); out=[]
    for (i,dr,orig) in ev:
        if rth and not (570<=m[i]<flat): continue
        if i+2>=n: continue
        ent=c[i]+dr*TICK
        stp=orig
        risk=abs(ent-stp)
        if risk<TICK: continue
        tgt=ent+dr*kt*d*ent
        for k in range(i+1,min(i+1+maxhold,n)):
            last=(rth and m[k]>=flat) or k==n-1
            hs=(l[k]<=stp) if dr==1 else (h[k]>=stp)
            ht=(h[k]>=tgt) if dr==1 else (l[k]<=tgt)
            if hs: px=stp-dr*TICK; why='stop'
            elif ht: px=tgt; why='tgt'
            elif last: px=c[k]; why='time'
            else: continue
            pnl=dr*(px-ent)*pv-comm
            out.append(dict(t=df.index[i],d=dr,pnl=pnl,R=pnl/(risk*pv),why=why,risk=risk,bars=k-i))
            break
    return pd.DataFrame(out)

for f,tag in [('nq_v6.parquet','NQ 2023-25'),('mnq_v6.parquet','MNQ 2026')]:
    df=pd.read_parquet(f)
    D=pd.DatetimeIndex(df.index).normalize().nunique()
    print(f'=== {tag} — enter AT the directional change, stop at its origin ===')
    print(f'  {"delta":>6s} {"k":>4s} {"n":>5s} {"/day":>5s} {"WR%":>5s} {"avgR":>7s} {"$/tr":>8s} {"$/day":>8s} {"risk$":>6s} {"skew":>6s}')
    for d in [0.002,0.003,0.005,0.008]:
        for kt in [0.5,1.0,1.5,2.0,3.0]:
            T=run(df,d,kt)
            if len(T)<25: continue
            print(f'  {d*100:5.2f}% {kt:4.1f} {len(T):5d} {len(T)/D:5.2f} {(T.pnl>0).mean()*100:5.1f} '
                  f'{T.R.mean():+7.3f} {T.pnl.mean():+8.2f} {T.pnl.sum()/D:+8.2f} {T.risk.median()*2:6.0f} {T.R.skew():+6.2f}')
    print()

