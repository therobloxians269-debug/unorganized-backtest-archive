"""VWAP + Volume Profile: the textbook set, causal by construction."""
import pandas as pd, numpy as np, warnings; warnings.filterwarnings('ignore')

RTH_A, RTH_B = 570, 959          # 09:30, 15:59 ET
def _rth(df):
    m=df.index.hour*60+df.index.minute
    return df[(m>=RTH_A)&(m<=RTH_B)]

def profile(g, bin_pts, va_frac=0.70):
    lo,hi=g['l'].min(), g['h'].max()
    if not np.isfinite(lo) or hi<=lo: return None
    edges=np.arange(lo, hi+bin_pts, bin_pts)
    if len(edges)<3: return None
    vol=np.zeros(len(edges)-1)
    gl,gh,gv=g['l'].values,g['h'].values,g['v'].values
    for k in range(len(g)):
        a=max(np.searchsorted(edges,gl[k])-1,0)
        b=min(max(np.searchsorted(edges,gh[k])-1,a),len(vol)-1)
        vol[a:b+1]+=gv[k]/(b-a+1)
    if vol.sum()<=0: return None
    c=(edges[:-1]+edges[1:])/2; p=int(vol.argmax())
    tot=vol.sum(); acc=vol[p]; li=hi_i=p
    while acc<va_frac*tot and (li>0 or hi_i<len(vol)-1):
        dn=vol[li-1] if li>0 else -1
        up=vol[hi_i+1] if hi_i<len(vol)-1 else -1
        if up>=dn: hi_i+=1; acc+=vol[hi_i]
        else: li-=1; acc+=vol[li]
    return dict(poc=c[p], val=c[li], vah=c[hi_i], dhi=g['h'].max(), dlo=g['l'].min(),
                dclose=g['c'].iloc[-1])

def build(df, bin_pts=2.0, rth_profile=True):
    """Prior-session VP (shifted => causal) + causal session VWAP/sigma + IB."""
    src=_rth(df) if rth_profile else df
    rows=[]
    for day,g in src.groupby('daycycle',sort=True):
        p=profile(g,bin_pts)
        if p: p['daycycle']=day; rows.append(p)
    vp=pd.DataFrame(rows).set_index('daycycle').sort_index().shift(1)   # CAUSAL
    out=df.copy()
    for c in ['poc','val','vah','dhi','dlo','dclose']:
        out['p_'+c]=out['daycycle'].map(vp[c])
    # session VWAP anchored at the RTH open, expanding => causal
    m=out.index.hour*60+out.index.minute
    key=out['daycycle'].astype(str)+'_'+(m>=RTH_A).astype(int).astype(str)
    tp=(out['h']+out['l']+out['c'])/3; pv=tp*out['v']
    cv=out['v'].groupby(key).cumsum(); cpv=pv.groupby(key).cumsum()
    out['vwap']=cpv/cv.replace(0,np.nan)
    var=((tp-out['vwap'])**2*out['v']).groupby(key).cumsum()/cv.replace(0,np.nan)
    out['vsd']=np.sqrt(var.clip(lower=0))
    # initial balance 09:30-10:30, known at 10:30
    ib=out[(m>=RTH_A)&(m<RTH_A+60)].groupby('daycycle').agg(ibh=('h','max'),ibl=('l','min'))
    out['ibh']=out['daycycle'].map(ib['ibh']); out['ibl']=out['daycycle'].map(ib['ibl'])
    out.loc[m<RTH_A+60,['ibh','ibl']]=np.nan          # not knowable before 10:30
    out['rth_open']=out['daycycle'].map(_rth(out).groupby('daycycle')['o'].first())
    out['minofday']=m
    return out

def race(df,i,d,ep,st,tgt,max_hold,flat=RTH_B,pv=20.,comm=4.,slip=0.25):
    h,l,o=df['h'].values,df['l'].values,df['o'].values; m=df['minofday'].values; n=len(df)
    for j in range(i+1,min(i+1+max_hold,n)):
        if m[j]>flat: px=o[j]+(slip if d==-1 else -slip); why='flat'; break
        if (h[j]>=st) if d==-1 else (l[j]<=st): px=st+(slip if d==-1 else -slip); why='stop'; break
        if (l[j]<=tgt) if d==-1 else (h[j]>=tgt): px=tgt; why='tgt'; break
    else:
        j=min(i+max_hold,n-1); px=o[j]+(slip if d==-1 else -slip); why='time'
    pts=(ep-px) if d==-1 else (px-ep)
    risk=abs(st-ep)
    return dict(pnl=pts*pv-comm, R=(pts*pv-comm)/(risk*pv), why=why, bars=j-i, risk=risk)

def rep(t,days,lab):
    if t is None or len(t)<5: return f'{lab:34s} n={0 if t is None else len(t)}'
    pf=t.pnl[t.pnl>0].sum()/max(1e-9,-t.pnl[t.pnl<0].sum())
    R=np.sort(t.R.values)[::-1]; d3=(R.sum()-R[:3].sum())/max(1,len(R)-3)
    return (f'{lab:34s} n={len(t):4d} ({len(t)/days:4.2f}/d) WR={(t.pnl>0).mean()*100:4.1f}% '
            f'avgR={t.R.mean():+.3f} drop3={d3:+.3f} $/tr={t.pnl.mean():+7.1f} PF={pf:4.2f} net=${t.pnl.sum():+8.0f}')

