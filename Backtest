"""
Sleeve interface.

A sleeve is a self-contained return stream. Each implements `weights()` (target portfolio at
each rebalance) and `returns()` (net-of-cost daily P&L). The portfolio layer combines sleeves by
risk budget — it never sees a sleeve's internals, which keeps Core IP isolated and redactable.
"""
from __future__ import annotations

from abc import ABC, abstractmethod
from dataclasses import dataclass

import pandas as pd


@dataclass(frozen=True)
class SleeveSpec:
    name: str
    asset_class: str          # "crypto" | "futures"
    market_neutral: bool
    cost_model_bps: float     # bundled all-in friction applied per unit turnover
    rebalance: str            # pandas offset alias, e.g. "W"


class Sleeve(ABC):
    spec: SleeveSpec

    @abstractmethod
    def weights(self, asof: pd.Timestamp | None = None) -> pd.DataFrame:
        """Target weights per instrument over time (point-in-time, no look-ahead)."""

    @abstractmethod
    def returns(self) -> pd.Series:
        """Net-of-cost daily returns of the sleeve at unit (1x) scale."""

    def turnover(self) -> pd.Series:
        """One-way turnover per rebalance (used for cost attribution & capacity work)."""
        w = self.weights()
        return w.diff().abs().sum(axis=1)

