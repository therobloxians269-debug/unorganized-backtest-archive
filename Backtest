"""Replica of thebigk259's Confluence Rejection Stack — all 13 levels, causal."""
import pandas as pd, numpy as np, warnings; warnings.filterwarnings('ignore')
TICK=0.25

def _sess_mask(idx, a, b):
    m=idx.hour*60+idx.minute
    return (m>=a)&(m<b) if a<b else ((m>=a)|(m<b))

def _anch_vwap(df, mask, hold=True, bands=False):
    """session-anchored VWAP; resets on each session start; optionally held after close."""
    src=(df.h+df.l+df.c)/3; v=df.v.fillna(0)
    start=mask & ~np.r_[False, mask[:-1]]
    grp=start.cumsum()
    pv=(src*v).where(mask,0); vv=v.where(mask,0)
    cpv=pv.groupby(grp).cumsum(); cv=vv.groupby(grp).cumsum()
    mean=(cpv/cv.replace(0,np.nan))
    out=mean.where(mask)
    if hold: out=out.ffill()
    if not bands: return out
    p2=(src*src*v).where(mask,0).groupby(grp).cumsum()
    var=(p2/cv.replace(0,np.nan)-mean**2).clip(lower=0)
    sd=np.sqrt(var).where(mask)
    if hold: sd=sd.ffill()
    return out, sd

def build_levels(df, emLen=20, kfQ=0.01, kfR=1.0, pocBinTicks=4):
    L={}
    idx=df.index
    rth=_sess_mask(idx,570,960)
    vw,sd=_anch_vwap(df,pd.Series(rth,index=idx),hold=False,bands=True)
    L['VWAP']=vw; L['VWAP +1s']=vw+sd; L['VWAP -1s']=vw-sd
    L['VWAP +3s']=vw+3*sd; L['VWAP -3s']=vw-3*sd
    for nm,a,b in [('Asia VWAP',1080,180),('London VWAP',180,570),
                   ('NY AM VWAP',570,720),('NY PM VWAP',720,960)]:
        L[nm]=_anch_vwap(df,pd.Series(_sess_mask(idx,a,b),index=idx),hold=True)
    # expected move off the PREVIOUS completed daily bar
    d=df.resample('1D').agg({'o':'first','c':'last'}).dropna()
    lr=np.log(d.c/d.c.shift())
    sig=lr.rolling(emLen).std().shift(1)
    pc=d.c.shift(1)
    up=(pc*np.exp(sig)).reindex(idx,method='ffill')
    dn=(pc*np.exp(-sig)).reindex(idx,method='ffill')
    L['EM Upper']=up; L['EM Lower']=dn
    # 1-state Kalman on hlc3
    z=((df.h+df.l+df.c)/3).values; n=len(z)
    x=np.empty(n); P=1.0; xv=z[0]
    for i in range(n):
        P=P+kfQ; K=P/(P+kfR); xv=xv+K*(z[i]-xv); P=(1-K)*P; x[i]=xv
    L['Kalman']=pd.Series(x,index=idx)
    # developing POC, daily reset
    binsz=pocBinTicks*TICK
    poc=np.full(n,np.nan); day=df['daycycle'].values
    hi=df.h.values; lo=df.l.values; vol=df.v.fillna(0).values
    from collections import defaultdict
    prof=defaultdict(float); cur=None; best=-1.0; bk=0
    for i in range(n):
        if day[i]!=cur:
            prof=defaultdict(float); cur=day[i]; best=-1.0; bk=0
        a=int(np.floor(lo[i]/binsz)); b=int(np.floor(hi[i]/binsz))
        nb=b-a+1
        if 0<nb<=2000 and vol[i]>0:
            per=vol[i]/nb
            for k in range(a,b+1):
                prof[k]+=per
                if prof[k]>best: best=prof[k]; bk=k
        poc[i]=(bk+0.5)*binsz if best>0 else np.nan
    L['POC']=pd.Series(poc,index=idx)
    # VAH / VAL — developing 70% value area around the POC, daily reset (the 2 levels I was missing)
    vah=np.full(n,np.nan); val=np.full(n,np.nan)
    prof=defaultdict(float); cur=None
    for i in range(n):
        if day[i]!=cur: prof=defaultdict(float); cur=day[i]
        a=int(np.floor(lo[i]/binsz)); b=int(np.floor(hi[i]/binsz))
        nb=b-a+1
        if 0<nb<=2000 and vol[i]>0:
            per=vol[i]/nb
            for k in range(a,b+1): prof[k]+=per
        if len(prof)>2 and (i%5==0 or i==n-1):
            ks=np.array(sorted(prof)); vs=np.array([prof[k] for k in ks])
            p=int(vs.argmax()); tot=vs.sum(); acc=vs[p]; loI=hiI=p
            while acc<0.70*tot and (loI>0 or hiI<len(vs)-1):
                dn=vs[loI-1] if loI>0 else -1; up=vs[hiI+1] if hiI<len(vs)-1 else -1
                if up>=dn: hiI+=1; acc+=up
                else: loI-=1; acc+=dn
            val[i]=(ks[loI]+0.5)*binsz; vah[i]=(ks[hiI]+0.5)*binsz
        elif i>0: val[i]=val[i-1]; vah[i]=vah[i-1]
    L['VAH']=pd.Series(vah,index=idx); L['VAL']=pd.Series(val,index=idx)
    return pd.DataFrame(L)

def rejections(df, LV, minConf=2, tolTicks=2, wickRatio=0.5, minRangeATR=0.25, reqBody=False):
    tol=tolTicks*TICK
    o,h,l,c=df.o.values,df.h.values,df.l.values,df.c.values
    r=df.resample('60min',label='left',closed='left').agg({'h':'max','l':'min','c':'last'}).dropna()
    tr=pd.concat([r.h-r.l,(r.h-r.c.shift()).abs(),(r.l-r.c.shift()).abs()],axis=1).max(axis=1)
    atr=tr.rolling(14).mean().shift(1).reindex(df.index,method='ffill').values
    M=LV.values; names=list(LV.columns)
    bt=np.maximum(o,c); bb=np.minimum(o,c); rng=h-l
    upw=h-bt; dnw=bb-l
    out=[]
    for i in range(len(df)):
        if rng[i]<=0: continue
        if np.isfinite(atr[i]) and minRangeATR>0 and rng[i]<minRangeATR*atr[i]: continue
        row=M[i]; ok=np.isfinite(row)
        # bearish: levels inside [bodyTop-tol, high+tol]
        selU=ok&(row>=bt[i]-tol)&(row<=h[i]+tol)
        nU=int(selU.sum())
        if nU>=minConf and upw[i]>=wickRatio*rng[i] and c[i]<row[selU].min() and (not reqBody or c[i]<o[i]):
            out.append(dict(i=i,t=df.index[i],dir=-1,n=nU,top=h[i],bot=bt[i],
                            names='+'.join([names[k] for k in np.where(selU)[0]]),atr=atr[i]))
        selD=ok&(row>=l[i]-tol)&(row<=bb[i]+tol)
        nD=int(selD.sum())
        if nD>=minConf and dnw[i]>=wickRatio*rng[i] and c[i]>row[selD].max() and (not reqBody or c[i]>o[i]):
            out.append(dict(i=i,t=df.index[i],dir=1,n=nD,top=bb[i],bot=l[i],
                            names='+'.join([names[k] for k in np.where(selD)[0]]),atr=atr[i]))
    return pd.DataFrame(out)

