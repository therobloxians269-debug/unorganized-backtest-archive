    tr0 = run(d, ii, dd, rk, dict(rr=2.0))
    print("T6 zero-cost random null avgR:", f"{tr0.netR.mean():+.4f}",
          f"(n={len(tr0)}, want ~0 +-0.02)")
    COST["NQ"] = save


def stage_mfe():
    """MFE distribution of the family's raw entries: is there a 'big trade' available daily?"""
    for sp in ("IS", "OOS1", "OOS2"):
