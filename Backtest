"""
THE BELL — the closing auction. Our concept, readable, one trade a day.

THE READ
    "Size is showing up into the close and it isn't stopping — somebody HAS to be
     done by 16:00."   and then
    "...and whoever hedged that flow has no reason to keep it at 16:01."

MECHANISM (the only genuinely OBLIGATED flow in the whole structure)
    Index funds, MOC orders and rebalancing must print AT the 16:00 close. Not
    "tend to" — must. A large buy imbalance means the dealers who will be short at
    the close hedge by buying futures INTO the bell. Two consequences, opposite signs:

      (a) THE RAMP    the hedging must complete, so late drift CONTINUES to 16:00
      (b) THE UNWIND  that hedge is inventory nobody wants overnight, so it comes
                      OFF after the close and the move gives back

    Both entries are fixed by the clock, so the selection bug that killed the other
    six concepts cannot appear. One trade a day by construction.

CONTROL — this must be distinguished from Market Intraday Momentum, which is ALREADY
DEAD on ES 2010-26 (opening-30min return -> closing-30min return). MIM is included
below as an explicit control so we can see whether the auction signature adds
anything MIM did not already fail to provide.
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')

RTH0, RTH1 = 570, 960          # 09:30, 16:00


def bell_frame(d, sig=(930, 950), post=(960, 990), adrlen=14, vol_win=20):
    """
    One row per session with the auction signature and both forward windows.

    sig   the signature window (default 15:30-15:50)
    post  the unwind window    (default 16:00-16:30)
    All signature columns use only bars inside `sig`, which closes before any entry.
    """
    tod = d.index.hour * 60 + d.index.minute
    d = d.assign(tod=tod, day=d.index.normalize(),
                 rth=(tod >= RTH0) & (tod < RTH1))
    r = d[d.rth]
    g = r.groupby('day')
    day = pd.DataFrame({'o930': g['open'].first(), 'hi': g['high'].max(),
                        'lo': g['low'].min(), 'cl': g['close'].last(),
                        'n': g.size(), 'rvol': g['volume'].sum()})
    day = day[day.n >= 300]
    day['rng'] = day.hi - day.lo
    day['ADR'] = day.rng.shift(1).rolling(adrlen).mean()
    day = day.dropna(subset=['ADR'])
    day = day[day.ADR > 0]

    rows = []
    for dd, b in d[d.day.isin(day.index)].groupby('day'):
        row = day.loc[dd]
        A = float(row.ADR)
        T = b.tod.values; C = b.close.values; V = b.volume.values
        H = b.high.values; L = b.low.values

        m_sig = (T >= sig[0]) & (T < sig[1])
        m_end = (T >= sig[1]) & (T < RTH1)          # signature close -> 16:00
        m_post = (T >= post[0]) & (T < post[1])
        if m_sig.sum() < 10 or m_end.sum() < 5:
            continue

        c_sig0 = float(C[m_sig][0]); c_sig1 = float(C[m_sig][-1])
        v_sig = float(V[m_sig].sum())
        c_close = float(C[m_end][-1])

        # --- MIM control: the opening 30 minutes ---
        m_open = (T >= RTH0) & (T < RTH0 + 30)
        mim = ((float(C[m_open][-1]) - float(C[m_open][0])) / A
               if m_open.sum() >= 10 else np.nan)

        rows.append(dict(
            day=dd, ADR=A, px_sig=c_sig1, px_close=c_close,
            drift=(c_sig1 - c_sig0) / A,               # the late-session push
            v_sig=v_sig,
            rng_sig=(float(H[m_sig].max()) - float(L[m_sig].min())) / A,
            mim=mim,
            # forward (a): signature close -> 16:00
            y_ramp=(c_close - c_sig1) / A,
            # forward (b): 16:00 -> post window end
            y_post=((float(C[m_post][-1]) - c_close) / A) if m_post.sum() >= 5 else np.nan,
            n_post=int(m_post.sum()),
        ))
    f = pd.DataFrame(rows).set_index('day').sort_index()
    # volume surge vs the same window on prior sessions (causal)
    f['v_ma'] = f.v_sig.shift(1).rolling(vol_win, min_periods=10).mean()
    f['surge'] = f.v_sig / f.v_ma
    # "size showing up AND pushing" — the readable signal
    f['push'] = np.sign(f.drift) * f.surge
    return f.dropna(subset=['surge', 'drift'])


def dayt(x):
    x = np.asarray(x, dtype=float); x = x[np.isfinite(x)]
    if len(x) < 15:
        return np.nan, np.nan, len(x)
    return float(x.mean()), float(x.mean() / (x.std(ddof=1) / np.sqrt(len(x)))), len(x)


def buckets(f, by, col, q=5, sign=+1, label=''):
    g = f.dropna(subset=[by, col]).copy()
    g['b'] = pd.qcut(g[by], q, labels=False, duplicates='drop')
    print(f'\n  {label}   ({by} quantiles -> {col})')
    print(f'    {"bucket":<8}{"n":>6}{"med":>9}{"mean":>11}{"t":>8}{"win%":>8}')
    for i in sorted(g.b.dropna().unique()):
        s = g[g.b == i]
        y = sign * s[col]
        mu, t, n = dayt(y)
        print(f'    Q{int(i)+1:<7}{n:>6}{s[by].median():>+9.2f}{mu:>+11.5f}{t:>+8.2f}'
              f'{(y > 0).mean():>8.1%}')


def trade(f, which, mode='ramp', surge_thr=0.0, min_drift=0.0):
    """
    mode 'ramp'   : enter at the signature close, exit 16:00, WITH the drift
    mode 'unwind' : enter at 16:00, exit end of post window, AGAINST the drift
    """
    import sim as S
    cost = S.COST_PTS[which]; pv = S.PT_VALUE[which]
    g = f[(f.surge >= surge_thr) & (f.drift.abs() >= min_drift)]
    out = []
    for dd, row in g.iterrows():
        s = np.sign(row.drift)
        if s == 0:
            continue
        if mode == 'ramp':
            y, sgn = row.y_ramp, s
        else:
            y, sgn = row.y_post, -s
        if not np.isfinite(y):
            continue
        pts = sgn * y * row.ADR - cost
        out.append(dict(day=dd, side='long' if sgn > 0 else 'short',
                        surge=row.surge, drift=row.drift,
                        pts=pts, usd=pts * pv, R=0.25 * row.ADR,
                        Rmult=pts / (0.25 * row.ADR)))
    return pd.DataFrame(out)


def show(t, label, nd):
    if not len(t):
        print(f'  {label:<34} n=0'); return
    mu, tt, n = dayt(t.pts)
    print(f'  {label:<34} n={n:>5}  {n/max(nd,1):.2f}/day  {mu:>+7.3f} pts  '
          f't {tt:>+6.2f}  WR {(t.pts>0).mean():>5.1%}  ${t.usd.mean():>+7.2f}/tr  '
          f'${t.usd.sum():>+9.0f}')

