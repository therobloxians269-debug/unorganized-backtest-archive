#!/usr/bin/env python3
"""
pairs_esym.py — MES/MYM intraday relative-value mean reversion, for a $1k account.

Structure: z-score of log(ES/YM) on 5m RTH bars over a rolling window. When the
ratio stretches (|z| > entry), SHORT the rich leg / LONG the cheap leg (both
micros, integer contracts), exit when z reverts (|z| < exit) or at 16:00 ET.
Market-neutral: spread vol << outright vol, so DD and margin are small.

Costs per pair round-trip: MES $2.50 (comm+1 tick) x nES + MYM $2.24 (comm+1x$0.5
tick x2 sides) x nYM. Execution at NEXT bar open on both legs. No overnight.
"""
import numpy as np, pandas as pd

MESPV, MYMPV = 5.0, 0.50
MES_RT, MYM_RT = 2.5, 2.24

P = pd.read_parquet("/Users/kaveh/quant_lab/cache/es_ym_1m.parquet")
P = P[P['rth']].copy()
P['slot'] = (P['min_of_day'] // 5) * 5
g = P.groupby(['session','slot'])
b = pd.DataFrame({
    'eo': g['es_open'].first(), 'ec': g['es_close'].last(),
    'yo': g['ym_open'].first(), 'yc': g['ym_close'].last(),
}).reset_index().sort_values(['session','slot']).reset_index(drop=True)
eo,ec,yo,yc = (b[k].to_numpy() for k in ('eo','ec','yo','yc'))
sess = b['session'].to_numpy(); slot = b['slot'].to_numpy(); n = len(b)
years = pd.to_datetime(b['session']).dt.year.to_numpy()

lr = np.log(ec) - np.log(yc)          # log ratio
last_of = {}
for i in range(n): last_of[sess[i]] = i

def zscore(win):
    m = pd.Series(lr).rolling(win).mean().to_numpy()
    s = pd.Series(lr).rolling(win).std().to_numpy()
    return (lr - m) / np.where(s > 1e-9, s, np.nan)

def run(win, ez, xz, nES, nYM, split_year=2023, label=""):
    z = zscore(win)
    trades = []   # (year, pnl)
    i = 0
    while i < n - 1:
        zi = z[i]
        if not np.isfinite(zi) or abs(zi) < ez or slot[i] > 900:   # no entries after 15:00
            i += 1; continue
        e = i + 1
        if e >= n or sess[e] != sess[i]: i += 1; continue
        d_es = -1 if zi > 0 else 1        # ratio rich -> short ES / long YM
        # find exit: z reverts or session end
        x = last_of[sess[i]]
        for k in range(e, last_of[sess[i]] + 1):
            if np.isfinite(z[k]) and abs(z[k]) < xz:
                x = k; break
        if x <= e - 1: i += 1; continue
        pnl = d_es * (ec[x] - eo[e]) * MESPV * nES \
            - d_es * (yc[x] - yo[e]) * MYMPV * nYM \
            - (MES_RT * nES + MYM_RT * nYM)
        trades.append((years[i], pnl))
        i = x + 1
    if not trades:
        print(f"{label}: no trades"); return
    t = pd.DataFrame(trades, columns=['yr','pnl']); p = t['pnl'].to_numpy()
    yrs = t['yr'].nunique()
    eq = 1000 + np.cumsum(p); mdd = float(-(eq - np.maximum.accumulate(eq)).min())
    isv = t[t['yr'] < split_year]['pnl']; oos = t[t['yr'] >= split_year]['pnl']
    it = isv.mean()/isv.std()*np.sqrt(len(isv)) if len(isv) > 5 and isv.std() > 0 else 0
    ot = oos.mean()/oos.std()*np.sqrt(len(oos)) if len(oos) > 5 and oos.std() > 0 else 0
    posyrs = sum(1 for _, gg in t.groupby('yr') if gg['pnl'].mean() > 0)
    print(f"{label:28} N={len(p):5d} ({len(p)/yrs:4.0f}/yr) win={100*(p>0).mean():4.1f}% "
          f"exp=${p.mean():+6.2f} DD=${mdd:5.0f} skew={pd.Series(p).skew():+5.2f} "
          f"IS_t={it:+5.2f} OOS_t={ot:+5.2f} posYrs={posyrs}/{yrs}")

print("MES/MYM 5m pairs reversion (2019-2026, costs both legs, next-bar-open):")
print("--- 1 MES : 1 MYM ---")
for win in (36, 78, 156):          # 3h, 1 day, 2 days of 5m bars
    for ez, xz in ((2.0, 0.5), (2.5, 0.5), (3.0, 1.0)):
        run(win, ez, xz, 1, 1, label=f"w{win} in{ez} out{xz} 1:1")
print("--- 2 MES : 3 MYM (beta-balanced) ---")
for win in (78, 156):
    for ez, xz in ((2.0, 0.5), (2.5, 0.5)):
        run(win, ez, xz, 2, 3, label=f"w{win} in{ez} out{xz} 2:3")

