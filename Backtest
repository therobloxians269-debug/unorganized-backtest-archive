"""
engine.py — the causal backtest loop.

The engine walks the base timeframe one bar at a time and never sees the future:
  * setups arm on their MSS bar; their limit order is workable from the *next*
    bar until it expires;
  * only one position is carried at a time (the discretionary "one idea" rule) —
    filling a setup cancels every other working order;
  * within a bar, if both stop and target are touched, the stop is assumed first
    (cfg.stop_priority) — the conservative, no-cheating convention;
  * an optional scale-out at +partial_rr banks part of the trade and slides the
    stop to break-even, exactly like manual management.

Output: a list of closed Trade dicts (R and dollars) plus an equity curve in R.
"""
from __future__ import annotations

import numpy as np
import pandas as pd

from .models import Setup
from .risk import EngineConfig, contracts_for, round_trip_cost_R


def _touch(bar_low, bar_high, price):
    return bar_low <= price <= bar_high


def run_backtest(ctx_df: pd.DataFrame, setups: list[Setup], cfg: EngineConfig) -> dict:
    df = ctx_df
    o = df["open"].to_numpy()
    h = df["high"].to_numpy()
    l = df["low"].to_numpy()
    c = df["close"].to_numpy()
    idx = df.index
    n = len(df)

    setups = sorted(setups, key=lambda s: s.arm_idx)
    ptr = 0
    working: list[Setup] = []
    pos = None          # open position dict or None
    trades: list[dict] = []

    def open_position(s: Setup, fill_bar: int):
        risk_pts = abs(s.entry - s.stop)
        contracts = contracts_for(risk_pts, cfg)
        return {
            "setup": s,
            "dir": s.direction,
            "entry": s.entry,
            "stop": s.stop,
            "orig_stop": s.stop,
            "target": s.target,
            "risk_pts": risk_pts,
            "contracts": contracts,
            "fill_bar": fill_bar,
            "remaining": 1.0,           # fraction of position still open
            "realized_R": 0.0,          # R banked from partials
            "partial_done": False,
        }

    def close_chunk(price, frac):
        pnl_pts = (price - pos["entry"]) * pos["dir"]
        return pnl_pts / pos["risk_pts"] * frac

    def finalize(exit_bar, exit_price, reason):
        s = pos["setup"]
        total_R = pos["realized_R"] + close_chunk(exit_price, pos["remaining"])
        total_R -= round_trip_cost_R(pos["risk_pts"], cfg)
        trades.append({
            "model": s.model,
            "dir": pos["dir"],
            "entry_time": idx[pos["fill_bar"]],
            "exit_time": idx[exit_bar],
            "entry": pos["entry"],
            "stop": pos["orig_stop"],
            "target": pos["target"],
            "exit": exit_price,
            "contracts": round(pos["contracts"], 2),
            "R": total_R,
            "dollars": total_R * cfg.risk_per_trade,
            "reason": reason,
            "score": s.score,
            "bars_held": exit_bar - pos["fill_bar"],
            **{f"meta_{k}": v for k, v in s.meta.items()},
        })

    for t in range(n):
        # 1) arm setups whose MSS bar is now.
        while ptr < len(setups) and setups[ptr].arm_idx == t:
            working.append(setups[ptr])
            ptr += 1

        # 2) manage an open position on this bar (exits before any new fill).
        if pos is not None:
            d = pos["dir"]
            risk_pts = pos["risk_pts"]
            entry = pos["entry"]
            partial_px = entry + d * cfg.partial_rr * risk_pts
            stop = pos["stop"]
            target = pos["target"]

            hit_stop = (l[t] <= stop) if d > 0 else (h[t] >= stop)
            hit_target = (h[t] >= target) if d > 0 else (l[t] <= target)
            hit_partial = (h[t] >= partial_px) if d > 0 else (l[t] <= partial_px)

            # Adverse-first: a bar touching both stop and target is a stop.
            if hit_stop and (cfg.stop_priority or not hit_target):
                finalize(t, stop, "stop" if stop == pos["orig_stop"] else "breakeven")
                pos = None
            elif hit_target and not hit_stop:
                # optional partial already implied by reaching target; bank remainder.
                finalize(t, target, "target")
                pos = None
            elif hit_target and hit_stop and not cfg.stop_priority:
                finalize(t, target, "target")
                pos = None
            else:
                # No terminal exit this bar; handle scale-out + break-even.
                if (cfg.partial_enabled and not pos["partial_done"] and hit_partial
                        and cfg.partial_frac > 0):
                    pos["realized_R"] += close_chunk(partial_px, cfg.partial_frac)
                    pos["remaining"] -= cfg.partial_frac
                    pos["partial_done"] = True
                    if cfg.breakeven_after_partial:
                        pos["stop"] = entry
                    if pos["remaining"] <= 1e-9:
                        finalize(t, partial_px, "partial_full")
                        pos = None

        # 3) if flat, try to fill the oldest still-valid working order.
        if pos is None and working:
            working = [w for w in working if t <= w.expiry_idx]
            filled = None
            for w in working:
                if t < w.arm_idx + 1:      # not workable until the bar after arming
                    continue
                touched = (l[t] <= w.entry) if w.direction > 0 else (h[t] >= w.entry)
                if touched:
                    filled = w
                    break
            if filled is not None:
                pos = open_position(filled, t)
                working = []               # one slot: cancel the rest
                # allow the same bar to also stop/target (adverse move after fill)
                d = pos["dir"]
                stop, target = pos["stop"], pos["target"]
                hit_stop = (l[t] <= stop) if d > 0 else (h[t] >= stop)
                hit_target = (h[t] >= target) if d > 0 else (l[t] <= target)
                if hit_stop and (cfg.stop_priority or not hit_target):
                    finalize(t, stop, "stop")
                    pos = None
                elif hit_target and not hit_stop:
                    finalize(t, target, "target")
                    pos = None

        # 4) expire working orders while a position is open, too.
        if pos is not None:
            working = [w for w in working if t <= w.expiry_idx]

    # Close any position still open at the end of data at the last close.
    if pos is not None:
        finalize(n - 1, c[-1], "eod")

    trades_df = pd.DataFrame(trades)
    equity = _equity_curve(trades_df)
    return {"trades": trades_df, "equity": equity}


def _equity_curve(trades: pd.DataFrame) -> pd.Series:
    if trades.empty:
        return pd.Series(dtype=float)
    s = trades.sort_values("exit_time").set_index("exit_time")["R"].cumsum()
    s.name = "equity_R"
    return s

