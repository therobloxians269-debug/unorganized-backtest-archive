"""
VRP falsification #1 (real DoltHub vol data): does the variance risk premium exist, and is
its TAIL survivable? iv_current (30d implied) vs forward realized (hv shifted ~30d).
Harvest proxy P&L = iv^2 - rv_fwd^2 (variance-swap units), monthly non-overlapping.
If the premium isn't there or the tail is ruinous even before structuring -> NO-GO.

    python3 vrp_research.py
"""
from __future__ import annotations
import numpy as np
import pandas as pd
import requests

BASE = "https://www.dolthub.com/api/v1alpha1/post-no-preference/options/master"
SYMS = ["SPY", "QQQ", "IWM"]


import time

PAGE = 500  # smaller pages -> DoltHub server-side timeouts ("context deadline exceeded") far rarer


def _query(q, tries=5):
    for i in range(tries):
        try:
            j = requests.get(BASE, params={"q": q}, timeout=90).json()
        except Exception:
            time.sleep(2 * (i + 1)); continue
        if j.get("query_execution_status") == "Success":
            return j.get("rows", [])
        time.sleep(2 * (i + 1))  # Error (usually deadline exceeded) -> back off and retry
    return None


def pull(sym):
    rows, off = [], 0
    while True:
        r = _query(f"SELECT date, iv_current, hv_current FROM volatility_history "
                   f"WHERE act_symbol='{sym}' ORDER BY date LIMIT {PAGE} OFFSET {off}")
        if r is None:
            print(f"  {sym}: DoltHub kept timing out at offset {off}; using {len(rows)} rows so far")
            break
        rows += r
        if len(r) < PAGE:
            break
        off += PAGE
    if not rows:
        return pd.DataFrame(columns=["date", "iv_current", "hv_current"])
    d = pd.DataFrame(rows)
    for c in ("iv_current", "hv_current"):
        d[c] = pd.to_numeric(d[c], errors="coerce")
    d["date"] = pd.to_datetime(d["date"])
    return d.dropna().sort_values("date").reset_index(drop=True)


def analyze(sym):
    d = pull(sym)
    # forward realized vol ~ trailing realized measured ~30 calendar days later
    fwd = d[["date", "hv_current"]].rename(columns={"date": "fdate", "hv_current": "rv_fwd"})
    d2 = pd.merge_asof(d.assign(t=d["date"] + pd.Timedelta(days=30)).sort_values("t"),
                       fwd.sort_values("fdate"), left_on="t", right_on="fdate",
                       direction="forward")
    d2["vrp"] = d2["iv_current"] - d2["rv_fwd"]                 # premium in vol points
    d2 = d2.dropna(subset=["vrp", "rv_fwd"]).set_index("date")
    # monthly non-overlapping harvest P&L (variance-swap units, scaled to ~vol points)
    m = d2.resample("ME").last().dropna(subset=["iv_current", "rv_fwd"])
    m["pnl"] = m["iv_current"] ** 2 - m["rv_fwd"] ** 2          # short variance
    p = m["pnl"].dropna()
    if len(p) < 12:
        print(f"  {sym}: too few months"); return
    sh = p.mean() / p.std() * np.sqrt(12)
    sortino = p.mean() / p[p < 0].std() * np.sqrt(12)
    eq = p.cumsum(); dd = (eq - eq.cummax()).min()
    cvar = p[p <= p.quantile(0.05)].mean()
    worst = p.idxmin()
    print(f"  {sym}: VRP mean {d2['vrp'].mean()*100:+.1f} vol-pts, {(d2['vrp']>0).mean()*100:.0f}% positive | "
          f"harvest Sharpe {sh:.2f} Sortino {sortino:.2f}")
    print(f"        worst month {worst.date()} ({p.min():.3f} var-units, ={'-' if p.min()<0 else ''}"
          f"{abs(p.min())**0.5*100:.0f} vol-pts) | CVaR5 {cvar:.3f} | tail/median ratio "
          f"{abs(p.min()/p.median()):.0f}x")
    return d2, p


def main():
    print("VRP FALSIFICATION #1 (real iv vs forward realized, 2019-2026)\n")
    for s in SYMS:
        analyze(s)
    print("\n  read: VRP>0 & mostly-positive = premium EXISTS. But check the tail ratio --")
    print("  short-variance has huge negative skew; if one month dwarfs the rest, naked = ruin,")
    print("  and the GO test becomes whether a DEFINED-RISK spread (real chain) tames it.")


if __name__ == "__main__":
    main()

