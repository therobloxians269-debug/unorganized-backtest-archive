            atr_o = tr if b == 0 else atr_o + (tr - atr_o) / ATR_N
            prev_c = c[b]
            closes.append(c[b])
            er_o = 0.0
            if b >= ER_N:
                den = np.sum(np.abs(np.diff(closes[-(ER_N + 1):])))
                er_o = abs(closes[-1] - closes[-(ER_N + 1)]) / den if den > 0 else 0.0
            rangep_o = (rangep_o + 1) if (b >= ER_N and er_o <= 0.13) else 0
            trend_o = b >= ER_N and er_o >= 0.35
            # structural events tracked on BOTH tapes; plants (planted tape only)
            # live exactly on the detector trigger conditions
            if plant_left == 0:
                if dtype == 'trend' and not pulled and b > EMA_N:
                    if (tdir == 1 and l[b] <= ema) or (tdir == -1 and h[b] >= ema):
                        pulled = True
