"""The $1k-account fitness test. A strategy PASSES only if ALL gates hold.

G1 sizing/margin  : tradable as 1 micro, intraday day-margin <= account, not overnight.
G2 cost floor     : net expectancy per trade > 0 AFTER real friction (the sub-cost trap).
G3 survivability  : max $-drawdown < DD_LIMIT and worst single stop affordable on $1k.
G4 robust edge    : net PF > 1 AND out-of-sample net expectancy > 0 (not just full-sample fit).
Plus a sample-size floor (>=30 trades) so we don't bless noise.
"""
from specs import SPECS, ACCOUNT, DD_LIMIT_USD

MIN_TRADES = 30
WORST_STOP_FRAC = 0.25      # one stop must cost < 25% of the account


def gate(m, sym):
    """m = engine.metrics dict (with oos fields). Returns dict of gate results."""
    if m.get("n", 0) < MIN_TRADES:
        return dict(passes=False, reason=f"insufficient sample (n={m.get('n',0)}<{MIN_TRADES})",
                    g1=None, g2=None, g3=None, g4=None, insufficient=True)
    dm = SPECS[sym]["dm_intraday"]
    g1 = dm <= ACCOUNT                                      # 1 micro intraday fits
    g2 = m["exp_usd"] > 0                                   # positive net edge/trade
    g3 = (m["maxdd_usd"] < DD_LIMIT_USD) and (m["worst_trade_usd"] > -ACCOUNT * WORST_STOP_FRAC)
    g4 = (m["pf_net"] > 1.0) and ((m.get("oos_exp") or -1) > 0)
    passes = bool(g1 and g2 and g3 and g4)
    reasons = []
    if not g1: reasons.append("margin>acct")
    if not g2: reasons.append(f"neg edge (${m['exp_usd']:+.2f}/trade)")
    if not g3:
        if m["maxdd_usd"] >= DD_LIMIT_USD: reasons.append(f"DD ${m['maxdd_usd']:.0f}>{DD_LIMIT_USD:.0f}")
        if m["worst_trade_usd"] <= -ACCOUNT * WORST_STOP_FRAC: reasons.append(f"worst stop ${m['worst_trade_usd']:.0f}")
    if not g4:
        if m["pf_net"] <= 1.0: reasons.append(f"PF {m['pf_net']:.2f}<=1")
        if (m.get("oos_exp") or -1) <= 0: reasons.append(f"OOS neg (${(m.get('oos_exp') or 0):+.2f})")
    return dict(passes=passes, reason=("PASS" if passes else "; ".join(reasons)),
                g1=g1, g2=g2, g3=g3, g4=g4, insufficient=False)

