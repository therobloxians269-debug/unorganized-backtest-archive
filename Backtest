def main() -> tuple[pd.DataFrame, list[TradeRecord], dict]:
    """
    Orchestrate the full pipeline:
        Synthetic Data → Signal Detection → Backtest → Metrics → Report → Export

    Returns
    ───────
    (result_df, trades, metrics) for programmatic downstream use (e.g. plotting,
    walk-forward optimisation, Monte Carlo permutation testing).
    """
    cfg = BacktestConfig()

    banner = (
        "\n"
        "  ╔═══════════════════════════════════════════════════╗\n"
        "  ║     NET-GEX GAMMA-FLIP BACKTEST ENGINE  v1.0     ║\n"
        "  ║     Intraday  |  5-min  |  Strict Friction       ║\n"
        "  ╚═══════════════════════════════════════════════════╝"
    )
    print(banner)

    # ── Step 1: Synthesise market data ────────────────────────────────────────
    print(f"\n  [1/5] Synthesising {cfg.ticker} OHLCV + Net GEX stream ...")
    df_raw = generate_synthetic_data(cfg)
    n_sessions = len(pd.bdate_range(cfg.start_date, cfg.end_date))
    print(f"        {len(df_raw):,} bars across {n_sessions} trading sessions")

    # ── Step 2: Detect gamma flips ────────────────────────────────────────────
    print(f"\n  [2/5] Detecting GEX zero-crossings (vectorised, no look-ahead) ...")
    df_sig = compute_signals(df_raw, cfg)
    n_bull = int((df_sig["raw_signal"] ==  1).sum())
    n_bear = int((df_sig["raw_signal"] == -1).sum())
    print(f"        {n_bull + n_bear} flip signals  ({n_bull} bullish / {n_bear} bearish)")

    # ── Step 3: Run backtest ──────────────────────────────────────────────────
    print(f"\n  [3/5] Running backtest with friction model ...")
    df_res, trades = run_backtest(df_sig, cfg)
    print(f"        {len(trades)} round-trip trades executed")

    # ── Step 4: Compute metrics ───────────────────────────────────────────────
    print(f"\n  [4/5] Computing performance metrics ...")
    metrics = compute_metrics(df_res, trades, cfg)

    # ── Step 5: Report & export ───────────────────────────────────────────────
    print(f"\n  [5/5] Rendering performance report & exporting results ...")
    print_report(metrics, trades, cfg)
    export_results(df_res, trades)

    return df_res, trades, metrics


