import numpy as np
import pandas as pd
from scipy.stats import norm

# ─────────────────────────────────────────────────────────────────────────────
# GLOBAL CONSTANTS
# ─────────────────────────────────────────────────────────────────────────────
T_0DTE        = 0.019   # Fractional year ≈ 1 trading day  (T = days/252)
R             = 0.05    # Annualized risk-free rate
CONTRACT_MULT = 100     # Standard equity-options contract multiplier

# Pre-computed scalar for inline normal PDF: 1 / sqrt(2π)
_INV_SQRT2PI = 1.0 / np.sqrt(2.0 * np.pi)


# ─────────────────────────────────────────────────────────────────────────────
# 1.  VECTORIZED BLACK-SCHOLES GAMMA ENGINE
# ─────────────────────────────────────────────────────────────────────────────
def bs_gamma_vectorized(
    S: np.ndarray,
    K: np.ndarray,
    sigma: np.ndarray,
    t: float = T_0DTE,
    r: float = R,
) -> np.ndarray:
    """
    Fully vectorized Black-Scholes Gamma across an entire options strip.

    Formula
    -------
        d1    = [ ln(S/K) + (r + σ²/2)·T ] / (σ·√T)
        Γ     = N'(d1) / (S · σ · √T)
        N'(x) = (1/√2π) · exp(−x²/2)           ← inlined for throughput

    Parameters
    ----------
    S     : 1-D array — spot / underlying prices
    K     : 1-D array — strike prices
    sigma : 1-D array — annualized implied volatilities
    t     : float     — time to expiry in years (default: T_0DTE = 0.019)
    r     : float     — risk-free rate           (default: R = 0.05)

    Returns
    -------
    gamma : 1-D array of Black-Scholes Gamma values
    """
    # Clip sigma to guard against division-by-zero on deep-ITM/OTM 0DTE legs
    sigma_safe = np.maximum(sigma, 1e-10)
    sqrt_t     = np.sqrt(t)                                  # scalar

    # ── d1 ────────────────────────────────────────────────────────────────────
    d1 = (np.log(S / K) + (r + 0.5 * sigma_safe ** 2) * t) / (sigma_safe * sqrt_t)

    # ── N'(d1) — standard normal PDF (inlined; ~3× faster than norm.pdf) ─────
    n_prime_d1 = _INV_SQRT2PI * np.exp(-0.5 * d1 * d1)

    # ── Gamma ─────────────────────────────────────────────────────────────────
    gamma = n_prime_d1 / (S * sigma_safe * sqrt_t)

    return gamma


# ─────────────────────────────────────────────────────────────────────────────
# 2.  NET DOLLAR GEX PER STRIKE
# ─────────────────────────────────────────────────────────────────────────────
def compute_net_gex(df: pd.DataFrame) -> pd.DataFrame:
    """
    Compute Net Dollar Gamma Exposure (GEX) per strike level.

    Convention  — market makers are SHORT public open interest:
    ─────────────────────────────────────────────────────────────
      Row GEX (call) = +volume × Γ × 100 × S      [dealers long Γ vs short calls]
      Row GEX (put)  = −volume × Γ × 100 × S      [put Γ subtracted per spec]

      Net GEX|K = Σ call_GEX|K − Σ put_GEX|K

    Parameters
    ----------
    df : DataFrame — columns: strike, type, volume, impliedVolatility,
                               underlying_price

    Returns
    -------
    gex_df : DataFrame  [strike | net_gex | spot_price]
             one row per unique strike, sorted ascending
    """
    # ── Zero-copy extraction to numpy ────────────────────────────────────────
    S      = df["underlying_price"].to_numpy(dtype=np.float64)
    K      = df["strike"].to_numpy(dtype=np.float64)
    sigma  = df["impliedVolatility"].to_numpy(dtype=np.float64)
    volume = df["volume"].to_numpy(dtype=np.float64)

    # ── Option-type sign mask (+1 call / −1 put) — no branching, no loops ────
    is_call = (df["type"].to_numpy() == "call")           # bool array
    sign    = np.where(is_call, 1.0, -1.0)                # float64 array

    # ── Per-row Gamma (single vectorized pass over entire chain) ─────────────
    gamma = bs_gamma_vectorized(S, K, sigma)

    # ── Signed dollar GEX per row ─────────────────────────────────────────────
    row_gex = sign * volume * gamma * CONTRACT_MULT * S

    # ── Strike-level aggregation via vectorized bincount ─────────────────────
    unique_strikes, inv_idx = np.unique(K, return_inverse=True)   # sorted
    net_gex_per_strike      = np.bincount(inv_idx, weights=row_gex)

    spot = float(df["underlying_price"].iat[0])

    return pd.DataFrame({
        "strike":     unique_strikes,
        "net_gex":    net_gex_per_strike,
        "spot_price": spot,
    })   # already sorted ascending by np.unique


# ─────────────────────────────────────────────────────────────────────────────
# 3.  REGIME DETECTION + GAMMA FLIP INTERPOLATION
# ─────────────────────────────────────────────────────────────────────────────
def detect_regime(gex_df: pd.DataFrame) -> dict:
    """
    Aggregate Net GEX → dealer gamma regime label + Gamma Flip price level.

    Gamma Flip Algorithm
    ────────────────────
    1. Compute the running (cumulative) sum of Net GEX along the strike ladder.
    2. Detect zero-crossings via np.diff(np.sign(cumulative_gex)).
    3. Linearly interpolate the exact crossing price between flanking strikes.
    4. When multiple crossings exist, report the one whose midpoint strike is
       closest to the current spot (most actionable for intraday flow).

    Parameters
    ----------
    gex_df : output of compute_net_gex()

    Returns
    -------
    dict with keys:
        total_net_gex    — scalar aggregate Net GEX across all strikes
        regime           — "POSITIVE (Long Gamma)" | "NEGATIVE (Short Gamma)"
        gamma_flip_level — interpolated flip strike, or np.nan if absent
        spot_price       — underlying spot at time of snapshot
    """
    gex_arr     = gex_df["net_gex"].to_numpy(dtype=np.float64)
    strikes_arr = gex_df["strike"].to_numpy(dtype=np.float64)
    spot        = float(gex_df["spot_price"].iat[0])

    # ── Aggregate regime ──────────────────────────────────────────────────────
    total_net_gex = gex_arr.sum()
    regime = "POSITIVE (Long Gamma)" if total_net_gex >= 0.0 else "NEGATIVE (Short Gamma)"

    # ── Cumulative GEX profile ────────────────────────────────────────────────
    cum_gex = np.cumsum(gex_arr)

    # ── Zero-crossing detection — pure numpy, no loops ───────────────────────
    # sign_diff ≠ 0 wherever the cumulative GEX changes sign
    flip_idx_arr = np.nonzero(np.diff(np.sign(cum_gex)))[0]   # indices before crossing

    if flip_idx_arr.size == 0:
        gamma_flip_level = np.nan
    else:
        # ── Select crossing closest to spot ───────────────────────────────────
        lo  = strikes_arr[flip_idx_arr]
        hi  = strikes_arr[flip_idx_arr + 1]
        mid = 0.5 * (lo + hi)
        best_idx = flip_idx_arr[np.argmin(np.abs(mid - spot))]

        # ── Linear interpolation: solve for x where cumulative GEX = 0 ───────
        x0, x1 = strikes_arr[best_idx],  strikes_arr[best_idx + 1]
        y0, y1 = cum_gex[best_idx],      cum_gex[best_idx + 1]
        gamma_flip_level = x0 - y0 * (x1 - x0) / (y1 - y0)

    return {
        "total_net_gex":    total_net_gex,
        "regime":           regime,
        "gamma_flip_level": gamma_flip_level,
        "spot_price":       spot,
    }


# ─────────────────────────────────────────────────────────────────────────────
# 4.  MASTER PIPELINE
# ─────────────────────────────────────────────────────────────────────────────
def run_gex_pipeline(df: pd.DataFrame) -> tuple[pd.DataFrame, dict]:
    """
    End-to-end 0DTE GEX pipeline.

    Parameters
    ----------
    df : raw 0DTE options chain DataFrame

    Returns
    -------
    (gex_df, regime_info)
        gex_df      — per-strike Net GEX DataFrame
        regime_info — aggregate stats + Gamma Flip level dict
    """
    gex_df      = compute_net_gex(df)
    regime_info = detect_regime(gex_df)
    return gex_df, regime_info


# ─────────────────────────────────────────────────────────────────────────────
# DEMO  ── replace df_demo with your live options chain DataFrame
# ─────────────────────────────────────────────────────────────────────────────
if __name__ == "__main__":
    rng  = np.random.default_rng(seed=42)
    SPOT = 5_250.0
    N    = 400

    # Simulate a realistic 0DTE SPX-style chain
    strike_range = np.arange(4_900.0, 5_600.0, 5.0)
    strikes      = np.tile(strike_range, 2)[:N]
    opt_types    = np.where(np.arange(N) < N // 2, "call", "put")

    # Realistic vol smile: ATM ~ 0.12, skewed higher for OTM puts
    atm_dist   = np.abs(strikes - SPOT) / SPOT
    base_vol   = 0.12 + 1.8 * atm_dist ** 2
    put_mask   = opt_types == "put"
    base_vol   = np.where(put_mask, base_vol * 1.25, base_vol)   # put skew

    df_demo = pd.DataFrame({
        "strike":            strikes,
        "type":              opt_types,
        "volume":            rng.integers(200, 60_000, size=N).astype(np.int64),
        "impliedVolatility": np.clip(base_vol + rng.normal(0, 0.01, N), 0.05, 1.5),
        "underlying_price":  np.full(N, SPOT),
    })

    # ── Run pipeline ──────────────────────────────────────────────────────────
    gex_df, regime = run_gex_pipeline(df_demo)

    # ── Pretty-print results ──────────────────────────────────────────────────
    SEP = "═" * 66
    pd.set_option("display.float_format", lambda x: f"{x:>16,.2f}")

    print(f"\n{SEP}")
    print("  PER-STRIKE NET GEX  ──  Top 15 by |Exposure|")
    print(SEP)

    top15 = (
        gex_df
        .assign(net_gex_M=lambda d: d["net_gex"] / 1e6)
        .reindex(gex_df["net_gex"].abs().nlargest(15).index)
        [["strike", "net_gex_M"]]
        .rename(columns={"strike": "Strike", "net_gex_M": "Net GEX  ($M)"})
    )
    print(top15.to_string(index=False))

    flip   = regime["gamma_flip_level"]
    dist   = (flip - SPOT) if not np.isnan(flip) else float("nan")
    pct    = 100.0 * dist / SPOT if not np.isnan(flip) else float("nan")

    print(f"\n{SEP}")
    print("  GAMMA REGIME SUMMARY")
    print(SEP)
    print(f"  Spot Price           : {regime['spot_price']:>16,.2f}")
    print(f"  Total Net GEX        : {regime['total_net_gex']:>16,.2f}")
    print(f"  Regime               :  {regime['regime']}")
    flip_disp = f"{flip:>16,.2f}  ({dist:+.2f} / {pct:+.3f}% from spot)" \
                if not np.isnan(flip) else "            Not Detected"
    print(f"  Gamma Flip Level     : {flip_disp}")
    print(f"  Model  T={T_0DTE}   R={R}")
