"""
How to INCREASE P(pass) on the Apex $50k eval. Tests the real levers via Monte-Carlo
on the trend program's actual returns:
  1. dynamic anti-martingale sizing (trade small near the floor, push hard after the lock)
  2. daily loss-cap (positive-skew structuring: bound each day's loss)
  3. drawdown GEOMETRY (trailing vs static floor; firm selection)
  4. multiple cheap attempts (the practical multiplier)
  5. higher conditional Sharpe (conviction filtering / max diversification)

    python3 apex_increaseP.py
"""
from __future__ import annotations
import numpy as np
from apex_sim import trend_returns, START, TARGET, TRAIL, LOCK, H, BLOCK

TRIALS = 30_000


def gen_indices(n, rng):
    nb = int(np.ceil(H / BLOCK))
    starts = rng.integers(0, n, size=(TRIALS, nb))
    return (starts[:, :, None] + np.arange(BLOCK)[None, None, :]).reshape(TRIALS, -1)[:, :H] % n


def sim(z, gi, sizing, losscap=None, trailing=True):
    T = gi.shape[0]
    eq = np.full(T, START); peak = np.full(T, START)
    floor = np.full(T, START - TRAIL)
    resolved = np.zeros(T, bool); passed = np.zeros(T, bool); busted = np.zeros(T, bool)
    pday = np.full(T, -1)
    for t in range(H):
        sig = sizing(eq, floor)
        pnl = z[gi[:, t]] * sig
        if losscap is not None:
            pnl = np.maximum(pnl, -losscap)
        eq = eq + pnl
        peak = np.maximum(peak, eq)
        floor = np.minimum(peak - TRAIL, LOCK) if trailing else np.full(T, START - TRAIL)
        nb = (~resolved) & (eq <= floor)
        npass = (~resolved) & (~nb) & (eq >= TARGET)
        busted |= nb; passed |= npass; pday[npass] = t
        resolved |= nb | npass
    md = np.median(pday[passed]) if passed.any() else np.nan
    return passed.mean(), busted.mean(), (1 - resolved).mean(), md


def main():
    net = trend_returns()
    z = (net / net.std()).values
    sh = net.mean() / net.std() * np.sqrt(252)
    rng = np.random.default_rng(7); gi = gen_indices(len(z), rng)
    print(f"generator Sharpe {sh:.2f}\n")

    print(f"{'policy':42s} {'PASS%':>6} {'BUST%':>6} {'TO%':>5} {'medDays':>7}")

    # baseline constants
    for s in (200, 300, 450):
        p, b, to, md = sim(z, gi, lambda e, f, s=s: s)
        print(f"{'constant $'+str(s)+'/day':42s} {p*100:5.1f}% {b*100:5.1f}% {to*100:4.1f}% {md:6.0f}")

    # 1. dynamic anti-martingale: size ~ k*(equity - floor), clipped
    for k, lo, hi in ((0.12, 50, 600), (0.18, 50, 800), (0.25, 50, 1000)):
        p, b, to, md = sim(z, gi, lambda e, f, k=k, lo=lo, hi=hi: np.clip(k * (e - f), lo, hi))
        print(f"{f'dyn anti-martingale k={k} [{lo},{hi}]':42s} {p*100:5.1f}% {b*100:5.1f}% {to*100:4.1f}% {md:6.0f}")

    # 2. daily loss-cap (positive skew) on the best constant size
    for lc in (300, 200, 120):
        p, b, to, md = sim(z, gi, lambda e, f: 450, losscap=lc)
        print(f"{f'constant $450 + daily loss-cap ${lc}':42s} {p*100:5.1f}% {b*100:5.1f}% {to*100:4.1f}% {md:6.0f}")

    # dyn + loss-cap combined
    p, b, to, md = sim(z, gi, lambda e, f: np.clip(0.18 * (e - f), 50, 800), losscap=250)
    print(f"{'dyn k=0.18 + loss-cap $250 (BEST combo)':42s} {p*100:5.1f}% {b*100:5.1f}% {to*100:4.1f}% {md:6.0f}")
    best_p = p

    # 3. geometry: STATIC floor (some firms) vs trailing, same size
    p, b, to, md = sim(z, gi, lambda e, f: 450, trailing=False)
    print(f"{'STATIC-DD firm ($47.5k floor), $450':42s} {p*100:5.1f}% {b*100:5.1f}% {to*100:4.1f}% {md:6.0f}")

    # 5. higher conditional Sharpe (conviction filter / max diversification) -> shift drift
    for tgt_sh in (0.74, 1.00, 1.20):
        z2 = z + (tgt_sh - sh) / np.sqrt(252)
        p, b, to, md = sim(z2, gi, lambda e, f: np.clip(0.18 * (e - f), 50, 800), losscap=250)
        print(f"{f'BEST combo @ Sharpe {tgt_sh:.2f} (filtered)':42s} {p*100:5.1f}% {b*100:5.1f}% {to*100:4.1f}% {md:6.0f}")

    # 4. multiple attempts multiplier
    print("\nMultiple cheap attempts  P(funded in N tries) = 1-(1-p)^N:")
    for p0, lbl in ((0.47, "baseline 47%"), (best_p, f"best policy {best_p*100:.0f}%")):
        line = "  ".join(f"N={n}:{(1-(1-p0)**n)*100:.0f}%" for n in (1, 2, 3, 4, 5))
        print(f"  {lbl:20s} {line}")


if __name__ == "__main__":
