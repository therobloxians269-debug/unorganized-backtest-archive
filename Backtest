"""
FlowLab v1.0 — OF-1 preregistered order-flow falsification harness (MES intraday)
==================================================================================
Data class: CME aggressor-classified trades (Databento GLBX.MDP3, schema=trades).
Reconstructs every Tradovate Orderflow+ visual as computable features:
footprint bid/ask per level, bar delta / CVD, stacked imbalances, absorption,
volume profile POC/VAH/VAL, sweep prints, opening delta.

Spec (frozen): MES only, 1 contract ($5/pt), 5m signal / 1m adjudication, RTH only,
stop floor 5.0 pts (cost-geometry law), friction 0.498 pt RT baseline,
0.75 pt RT when the exit is a stop-market (live-fill calibration from PSX2 work).

Gates: net expectancy > 0, HAC t >= 3.0, DSR >= 0.95 at honest cumulative N,
MCPT p <= 0.05 — applied on VAL, then single-shot untouched holdout.
"""

from __future__ import annotations
import math
import numpy as np
import pandas as pd
from dataclasses import dataclass

TICK = 0.25
FRICTION_RT = 0.498      # pts round trip, entry + TP/time exit
FRICTION_STOP = 0.75     # pts round trip when exit is a stop-market
STOP_PTS = 5.0           # cost-geometry stop floor
RTH_SECS = 23400         # 6.5h RTH session
M_PER_SESS = 390         # 1m bars per session
B5_PER_SESS = 78         # 5m bars per session
POINT_VALUE = 5.0        # MES $/pt

EM_GAMMA = 0.5772156649015329


# ----------------------------------------------------------------------------
# Synthetic tape (self-test only — machinery validation, never a verdict source)
# ----------------------------------------------------------------------------

def _one_session_base(rng, start_price, lam=3.5, sig=0.30):
    """One RTH session of trades: sec(float), price, side(+1 ask-hit/-1 bid-hit), size."""
    r = rng.normal(0.0, sig, RTH_SECS)
    p_sec = start_price + np.cumsum(r)
    counts = rng.poisson(lam, RTH_SECS)
    idx = np.repeat(np.arange(RTH_SECS), counts)
    n = idx.size
    sec = idx + rng.random(n)
    price = p_sec[idx] + rng.normal(0.0, 0.20, n)

    # AR(1) latent aggressor bias so bar delta has realistic persistence
    lat = np.empty(RTH_SECS)
    lat[0] = rng.normal()
    eps = rng.normal(0.0, 1.0, RTH_SECS)
    phi = 0.97
    for i in range(1, RTH_SECS):
        lat[i] = phi * lat[i - 1] + math.sqrt(1 - phi * phi) * eps[i]
    side = np.where(lat[idx] + rng.normal(0.0, 1.2, n) > 0, 1, -1).astype(np.int8)
    flip = rng.random(n) < 0.25
    side = np.where(flip, -side, side).astype(np.int8)
    size = np.clip(np.exp(rng.normal(0.3, 1.0, n)), 1, 200).astype(np.int64)

    # sweep bursts (candidates for F7; no alpha attached by construction)
    bs, bp, bsd, bq = [], [], [], []
    for _ in range(8):
        t0 = int(rng.integers(600, RTH_SECS - 600))
        d = 1 if rng.random() < 0.5 else -1
        k = int(rng.integers(6, 14))
        bs.append(t0 + rng.random(k) * 0.9)
        bp.append(np.full(k, p_sec[t0]) + rng.normal(0, 0.1, k))
        bsd.append(np.full(k, d, dtype=np.int8))
        bq.append(rng.integers(30, 120, k).astype(np.int64))
    sec = np.concatenate([sec] + bs)
    price = np.concatenate([price] + bp)
    side = np.concatenate([side] + bsd)
    size = np.concatenate([size] + bq)
    o = np.argsort(sec, kind="stable")
    return sec[o], price[o], side[o], size[o]


def _plant_f1_effect(sec, price, side, size, drift_pts, rng, excl_b5=None):
    """Inject genuine flow->price predictability on the F1 mechanism:
    after a 20-bar 5m high(low) break with strong same-side bar delta,
    price drifts drift_pts in the break direction over the next 600s.
    Delta itself is untouched (drift = impact of informed flow).
    excl_b5: injected-absorption bar ids, excluded from the plant's own
    delta-dispersion estimate and from trigger candidacy (ground truth
    bookkeeping only -- the harness under test never receives this)."""
    if drift_pts <= 0:
        return price
    price = price.copy()
    excl = set(excl_b5 or [])
    b5 = (sec // 300).astype(int)
    df = pd.DataFrame({"b": b5, "p": price, "sq": side.astype(np.int64) * size})
    g = df.groupby("b", sort=True)
    hi = g["p"].max()
    cl = g["p"].last()
    lo = g["p"].min()
    dl = g["sq"].sum()
    bars = pd.DataFrame({"hi": hi, "lo": lo, "cl": cl, "dl": dl})
    # Mechanism-matched trigger: same rolling-window delta dispersion the
    # harness feature pipeline uses (rolling 200, within-session approx).
    bars["dstd"] = bars["dl"].rolling(200, min_periods=20).std()
    bars["ph"] = bars["hi"].rolling(20).max().shift(1)
    bars["pl"] = bars["lo"].rolling(20).min().shift(1)
    n_up = n_dn = 0
    CAP = 5
    for b in bars.index:
        if b in excl:
            continue
        row = bars.loc[b]
        if not np.isfinite(row["dstd"]) or row["dstd"] <= 0:
            continue
        t_end = (b + 1) * 300.0
        if row["cl"] > row["ph"] and row["dl"] >= 1.5 * row["dstd"] and n_up < CAP:
            n_up += 1
            m = sec > t_end
            price[m] += drift_pts * np.minimum((sec[m] - t_end) / 300.0, 1.0)
        elif row["cl"] < row["pl"] and row["dl"] <= -1.5 * row["dstd"] and n_dn < CAP:
            n_dn += 1
            m = sec > t_end
            price[m] -= drift_pts * np.minimum((sec[m] - t_end) / 300.0, 1.0)
    return price


def _inject_absorption(rng, sec, price, side, size, n_events=2):
    """Bar-aligned absorption events: one full 5m bar with ~6x volume,
    balanced aggressor sides, and price pinned flat (F3/F4 candidates,
    no alpha attached). Existing trades inside the bar are flattened too.
    Returns the injected 5m bar ids so the ground-truth plant can exclude
    them from its own threshold statistics (the harness never sees this)."""
    price = price.copy()
    add = [sec], [price], [side], [size]
    injected_b5 = []
    for _ in range(n_events):
        b0 = int(rng.integers(6, B5_PER_SESS - 6))
        injected_b5.append(b0)
        t0, t1 = b0 * 300.0, (b0 + 1) * 300.0
        m = (sec >= t0) & (sec < t1)
        if not m.any():
            continue
        p0 = float(np.median(price[m]))
        price[m] = p0 + rng.normal(0, 0.15, int(m.sum()))
        k = int(rng.integers(1500, 2500))
        a_sec = t0 + rng.random(k) * 300.0
        a_price = p0 + rng.normal(0, 0.15, k)
        a_side = np.where(rng.random(k) < 0.5, 1, -1).astype(np.int8)
        a_size = np.clip(np.exp(rng.normal(1.0, 0.8, k)), 1, 200).astype(np.int64)
        add[0].append(a_sec); add[1].append(a_price)
        add[2].append(a_side); add[3].append(a_size)
    sec = np.concatenate(add[0]); price = np.concatenate(add[1])
    side = np.concatenate(add[2]); size = np.concatenate(add[3])
    o = np.argsort(sec, kind="stable")
    return sec[o], price[o], side[o], size[o], injected_b5


def make_tape(n_sessions, seed, planted_drift_pts=0.0, start_price=6800.0,
              gap_sd=12.0):
    """Multi-session tape dict of numpy arrays with a 'sess' column."""
    rng = np.random.default_rng(seed)
    out = {"sess": [], "sec": [], "price": [], "side": [], "size": []}
    px = start_price
    for s in range(n_sessions):
        if s > 0:
            px += rng.normal(0.0, gap_sd)   # overnight gap
        sec, price, side, size = _one_session_base(rng, px)
        sec, price, side, size, inj_b5 = _inject_absorption(rng, sec, price, side, size)
        price = _plant_f1_effect(sec, price, side, size, planted_drift_pts, rng,
                                 excl_b5=inj_b5)
        price = np.round(price / TICK) * TICK
        out["sess"].append(np.full(sec.size, s, dtype=np.int16))
        out["sec"].append(sec.astype(np.float32))
        out["price"].append(price.astype(np.float32))
        out["side"].append(side)
        out["size"].append(size.astype(np.int32))
        px = float(price[-1])
    return {k: np.concatenate(v) for k, v in out.items()}


# ----------------------------------------------------------------------------
# Bars, footprints, features
# ----------------------------------------------------------------------------

def _tape_session_chunks(tape, chunk_sessions=25):
    """Yield tape-dict views sliced into blocks of sessions. Bar-level outputs
    are tiny, so per-trade frames only ever exist for one block at a time.
    Works for both synthetic tapes and Databento-loaded real tapes."""
    sess = tape["sess"]
    lo, hi = int(sess[0]), int(sess[-1])
    s0 = lo
    while s0 <= hi:
        s1 = min(s0 + chunk_sessions - 1, hi)
        i0, i1 = np.searchsorted(sess, s0), np.searchsorted(sess, s1 + 1)
        yield {k: v[i0:i1] for k, v in tape.items()}
        s0 = s1 + 1


def build_bars(tape, bar_sec, chunk_sessions=25):
    """OHLCV + delta bars on a fixed grid; missing bars forward-filled flat.
    Session-chunked: peak memory is one block of per-trade rows."""
    out = [_build_bars_block(blk, bar_sec)
           for blk in _tape_session_chunks(tape, chunk_sessions)]
    per = RTH_SECS // bar_sec
    bars = pd.concat(out, ignore_index=True)
    bars["g"] = bars["sess"] * per + bars["b"]  # global bar index
    return bars.sort_values("g").reset_index(drop=True)


def _build_bars_block(tape, bar_sec):
    per = RTH_SECS // bar_sec
    df = pd.DataFrame({
        "sess": tape["sess"],
        "b": (tape["sec"] // bar_sec).astype(np.int64).clip(0, per - 1),
        "p": tape["price"].astype(np.float64),
        "q": tape["size"].astype(np.int64),
        "sq": tape["side"].astype(np.int64) * tape["size"].astype(np.int64),
    })
    g = df.groupby(["sess", "b"], sort=True)
    bars = pd.DataFrame({
        "open": g["p"].first(), "high": g["p"].max(),
        "low": g["p"].min(), "close": g["p"].last(),
        "vol": g["q"].sum(), "delta": g["sq"].sum(),
    }).reset_index()
    # reindex to full grid per session
    full = []
    for s, chunk in bars.groupby("sess", sort=True):
        chunk = chunk.set_index("b").reindex(range(per))
        chunk["sess"] = s
        chunk["close"] = chunk["close"].ffill().bfill()
        for c in ("open", "high", "low"):
            chunk[c] = chunk[c].fillna(chunk["close"])
        chunk[["vol", "delta"]] = chunk[["vol", "delta"]].fillna(0)
        chunk = chunk.reset_index().rename(columns={"index": "b"})
        full.append(chunk)
    return pd.concat(full, ignore_index=True)


def footprint_5m(tape, chunk_sessions=25):
    """Per (sess, 5m bar, tick level): bid vol (-1) and ask vol (+1).
    Session-chunked for memory."""
    out = [_footprint_block(blk)
           for blk in _tape_session_chunks(tape, chunk_sessions)]
    return pd.concat(out, ignore_index=True)


def _footprint_block(tape):
    df = pd.DataFrame({
        "sess": tape["sess"],
        "b": (tape["sec"] // 300).astype(np.int64).clip(0, B5_PER_SESS - 1),
        "lvl": np.round(tape["price"] / TICK).astype(np.int64),
        "s": tape["side"],
        "q": tape["size"].astype(np.int64),
    })
    piv = df.groupby(["sess", "b", "lvl", "s"])["q"].sum().unstack("s", fill_value=0)
    for col in (-1, 1):
        if col not in piv.columns:
            piv[col] = 0
    piv = piv.rename(columns={-1: "bid", 1: "ask"}).reset_index()
    return piv


def stacked_imbalances(fp, ratio, min_big=20, stack=3):
    """Diagonal imbalance stacks per 5m bar. Ask-diagonal: ask[L] vs bid[L-1tick].
    Returns DataFrame (sess, b, dir) where dir=+1 buy-stack, -1 sell-stack."""
    rows = []
    for (s, b), grp in fp.groupby(["sess", "b"], sort=True):
        grp = grp.sort_values("lvl")
        lvl = grp["lvl"].to_numpy()
        bid = grp["bid"].to_numpy().astype(float)
        ask = grp["ask"].to_numpy().astype(float)
        if lvl.size < stack + 1:
            continue
        contig = np.diff(lvl) == 1
        # ask diagonal at index i compares ask[i] vs bid[i-1]
        a_imb = np.zeros(lvl.size, bool)
        b_imb = np.zeros(lvl.size, bool)
        for i in range(1, lvl.size):
            if not contig[i - 1]:
                continue
            if ask[i] >= ratio * max(bid[i - 1], 1.0) and ask[i] >= min_big:
                a_imb[i] = True
            if bid[i - 1] >= ratio * max(ask[i], 1.0) and bid[i - 1] >= min_big:
                b_imb[i - 1] = True
        for arr, d in ((a_imb, 1), (b_imb, -1)):
            run = 0
            hit = False
            for i in range(lvl.size):
                run = run + 1 if arr[i] else 0
                if run >= stack:
                    hit = True
                    break
            if hit:
                rows.append((s, b, d))
    return pd.DataFrame(rows, columns=["sess", "b", "dir"])


def session_profiles(tape):
    """Per-session volume profile: POC, VAH, VAL (70% value area) in price."""
    df = pd.DataFrame({
        "sess": tape["sess"],
        "lvl": np.round(tape["price"] / TICK).astype(np.int64),
        "q": tape["size"],
    })
    out = {}
    for s, grp in df.groupby("sess", sort=True):
        hist = grp.groupby("lvl")["q"].sum().sort_index()
        lvls = hist.index.to_numpy()
        vols = hist.to_numpy().astype(float)
        poc_i = int(np.argmax(vols))
        total = vols.sum()
        lo = hi = poc_i
        acc = vols[poc_i]
        while acc < 0.70 * total and (lo > 0 or hi < len(vols) - 1):
            up = vols[hi + 1] if hi < len(vols) - 1 else -1.0
            dn = vols[lo - 1] if lo > 0 else -1.0
            if up >= dn:
                hi += 1; acc += up
            else:
                lo -= 1; acc += dn
        out[s] = {"poc": lvls[poc_i] * TICK, "vah": lvls[hi] * TICK,
                  "val": lvls[lo] * TICK}
    return out


def add_features(b5):
    """Cross-session rolling features on the 5m frame (ordered by g)."""
    b5 = b5.sort_values("g").reset_index(drop=True)
    b5["d_mu"] = b5["delta"].rolling(200, min_periods=100).mean()
    b5["d_sd"] = b5["delta"].rolling(200, min_periods=100).std()
    b5["dz"] = (b5["delta"] - b5["d_mu"]) / b5["d_sd"]
    tr = np.maximum(b5["high"] - b5["low"],
                    np.maximum((b5["high"] - b5["close"].shift(1)).abs(),
                               (b5["low"] - b5["close"].shift(1)).abs()))
    b5["atr"] = tr.rolling(20, min_periods=20).mean()
    b5["v_mu"] = b5["vol"].rolling(200, min_periods=100).mean()
    b5["v_sd"] = b5["vol"].rolling(200, min_periods=100).std()
    b5["vz"] = (b5["vol"] - b5["v_mu"]) / b5["v_sd"]
    for N in (20, 60):
        b5[f"ph{N}"] = b5["high"].rolling(N, min_periods=N).max().shift(1)
        b5[f"pl{N}"] = b5["low"].rolling(N, min_periods=N).min().shift(1)
    # session-scoped
    b5["cvd"] = b5.groupby("sess")["delta"].cumsum()
    b5["cvd_hi12"] = b5.groupby("sess")["cvd"].transform(
        lambda x: x.rolling(12, min_periods=12).max())
    b5["cvd_lo12"] = b5.groupby("sess")["cvd"].transform(
        lambda x: x.rolling(12, min_periods=12).min())
    b5["hi12"] = b5.groupby("sess")["high"].transform(
        lambda x: x.rolling(12, min_periods=12).max())
    b5["lo12"] = b5.groupby("sess")["low"].transform(
        lambda x: x.rolling(12, min_periods=12).min())
    b5["cvd_slope"] = b5.groupby("sess")["cvd"].transform(lambda x: x - x.shift(12))
    b5["slope_sd"] = b5["cvd_slope"].rolling(200, min_periods=100).std()
    tp = (b5["high"] + b5["low"] + b5["close"]) / 3.0
    b5["_pv"] = tp * b5["vol"]
    cs = b5.groupby("sess")[["_pv", "vol"]].cumsum()
    b5["vwap"] = cs["_pv"] / cs["vol"].replace(0, np.nan)
    b5.drop(columns=["_pv"], inplace=True)
    sgn = np.sign(b5["close"] - b5["open"])
    same3 = (sgn == sgn.shift(1)) & (sgn == sgn.shift(2)) & (sgn != 0)
    same_sess = (b5["sess"] == b5["sess"].shift(2))
    b5["leg3"] = np.where(same3 & same_sess, sgn, 0)
    return b5


# ----------------------------------------------------------------------------
# Signal container + unified execution
# ----------------------------------------------------------------------------

@dataclass
class Sig:
    sess: int
    m: int              # entry 1m bar index within session
    dir: int            # +1 / -1
    stop_pts: float
    tp_pts: float | None   # absolute pts to target (None = time exit only)
    max_bars: int          # 1m bars incl. entry bar


def _b1_matrix(b1):
    """Dense per-session arrays for fast walking: open/high/low/close [sess][390]."""
    n_sess = int(b1["sess"].max()) + 1
    O = np.full((n_sess, M_PER_SESS), np.nan)
    H = np.full_like(O, np.nan)
    L = np.full_like(O, np.nan)
    C = np.full_like(O, np.nan)
    O[b1["sess"], b1["b"]] = b1["open"]
    H[b1["sess"], b1["b"]] = b1["high"]
    L[b1["sess"], b1["b"]] = b1["low"]
    C[b1["sess"], b1["b"]] = b1["close"]
    return O, H, L, C


def execute(signals, mats, sess_filter=None):
    """Chronological, one-position-at-a-time per family-cell. Conservative
    same-bar adjudication (stop first). Returns trades DataFrame."""
    O, H, L, C = mats
    sigs = sorted(signals, key=lambda s: (s.sess, s.m))
    busy_until = (-1, -1)
    rows = []
    for s in sigs:
        if sess_filter is not None and s.sess not in sess_filter:
            continue
        if s.m >= M_PER_SESS or s.m < 0:
            continue
        if (s.sess, s.m) <= busy_until:
            continue
        e = O[s.sess, s.m]
        if not np.isfinite(e):
            continue
        stop = e - s.dir * s.stop_pts
        tgt = e + s.dir * s.tp_pts if s.tp_pts is not None else None
        last = min(s.m + s.max_bars - 1, M_PER_SESS - 1)
        exit_px, exit_m, kind = C[s.sess, last], last, "time"
        for m in range(s.m, last + 1):
            h, l = H[s.sess, m], L[s.sess, m]
            hit_stop = (l <= stop) if s.dir > 0 else (h >= stop)
            hit_tgt = tgt is not None and ((h >= tgt) if s.dir > 0 else (l <= tgt))
            if hit_stop:                       # conservative: stop first
                exit_px, exit_m, kind = stop, m, "stop"
                break
            if hit_tgt:
                exit_px, exit_m, kind = tgt, m, "tp"
                break
        fric = FRICTION_STOP if kind == "stop" else FRICTION_RT
        pnl = s.dir * (exit_px - e) - fric
        rows.append((s.sess, s.m, s.dir, e, exit_px, exit_m, kind, pnl))
        busy_until = (s.sess, exit_m)
    return pd.DataFrame(rows, columns=["sess", "m", "dir", "entry", "exit",
                                       "exit_m", "kind", "pnl"])


# ----------------------------------------------------------------------------
# Stats: HAC t, DSR, MCPT
# ----------------------------------------------------------------------------

def daily_series(trades, sessions):
    y = np.zeros(len(sessions))
    pos = {s: i for i, s in enumerate(sessions)}
    if len(trades):
        for s, p in trades.groupby("sess")["pnl"].sum().items():
            if s in pos:
                y[pos[s]] += p
    return y


def hac_t(y, lags=5):
    n = len(y)
    if n < 10 or np.allclose(y, 0):
        return 0.0
    mu = y.mean()
    e = y - mu
    g0 = (e @ e) / n
    s = g0
    for l in range(1, min(lags, n - 1) + 1):
        w = 1 - l / (lags + 1)
        s += 2 * w * (e[l:] @ e[:-l]) / n
    se = math.sqrt(max(s, 1e-12) / n)
    return mu / se


def _norm_cdf(x):
    return 0.5 * (1 + math.erf(x / math.sqrt(2)))


def _norm_ppf(p):
    # Acklam rational approximation
    if p <= 0 or p >= 1:
        return math.copysign(8.0, p - 0.5)
    a = [-3.969683028665376e+01, 2.209460984245205e+02, -2.759285104469687e+02,
         1.383577518672690e+02, -3.066479806614716e+01, 2.506628277459239e+00]
    b = [-5.447609879822406e+01, 1.615858368580409e+02, -1.556989798598866e+02,
         6.680131188771972e+01, -1.328068155288572e+01]
    c = [-7.784894002430293e-03, -3.223964580411365e-01, -2.400758277161838e+00,
         -2.549732539343734e+00, 4.374664141464968e+00, 2.938163982698783e+00]
    d = [7.784695709041462e-03, 3.224671290700398e-01, 2.445134137142996e+00,
         3.754408661907416e+00]
    pl, ph = 0.02425, 1 - 0.02425
    if p < pl:
        q = math.sqrt(-2 * math.log(p))
        return (((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5]) / \
               ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1)
    if p > ph:
        q = math.sqrt(-2 * math.log(1 - p))
        return -(((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5]) / \
               ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1)
    q = p - 0.5
    r = q * q
    return (((((a[0]*r+a[1])*r+a[2])*r+a[3])*r+a[4])*r+a[5])*q / \
           (((((b[0]*r+b[1])*r+b[2])*r+b[3])*r+b[4])*r+1)


def dsr(y, n_trials):
    """Deflated Sharpe (Bailey & Lopez de Prado) on the per-session series."""
    n = len(y)
    if n < 10:
        return 0.0
    sd = y.std(ddof=1)
    if sd <= 0:
        return 0.0
    sr = y.mean() / sd
    s = pd.Series(y)
    g3 = float(s.skew())
    g4 = float(s.kurt()) + 3.0  # raw kurtosis
    v = (1 - g3 * sr + (g4 - 1) / 4 * sr * sr) / (n - 1)
    v = max(v, 1e-12)
    sr0 = math.sqrt(v) * ((1 - EM_GAMMA) * _norm_ppf(1 - 1.0 / n_trials)
                          + EM_GAMMA * _norm_ppf(1 - 1.0 / (n_trials * math.e)))
    return _norm_cdf((sr - sr0) / math.sqrt(v))


def mcpt(signals, mats, sessions, n_perm=500, seed=99):
    """Within-session circular time-shift of entries (direction labels kept,
    stop/TP distances kept). p = P(perm total >= observed total)."""
    rng = np.random.default_rng(seed)
    obs = execute(signals, mats, sess_filter=set(sessions))["pnl"].sum()
    ge = 0
    for _ in range(n_perm):
        offs = {s: int(rng.integers(6, M_PER_SESS - 6)) for s in sessions}
        perm = [Sig(s.sess, (s.m + offs.get(s.sess, 0)) % M_PER_SESS, s.dir,
                    s.stop_pts, s.tp_pts, s.max_bars)
                for s in signals if s.sess in offs]
        tot = execute(perm, mats, sess_filter=set(sessions))["pnl"].sum()
        if tot >= obs - 1e-12:
            ge += 1
    return (1 + ge) / (1 + n_perm), obs


# ----------------------------------------------------------------------------
# OF-1 preregistered families (frozen grids — 34 cells total)
# ----------------------------------------------------------------------------

def _exit_variants():
    return [("2R", 2 * STOP_PTS, 60), ("t60", None, 60)]


def fam_F1(b5, N, theta, tp_pts, max_bars):
    """Delta-confirmed level break: close > prior-N high AND dz >= theta."""
    out = []
    for _, r in b5.iterrows():
        if r["b"] < 3 or not np.isfinite(r["dz"]) or not np.isfinite(r[f"ph{N}"]):
            continue
        if r["close"] > r[f"ph{N}"] and r["dz"] >= theta:
            out.append(Sig(int(r["sess"]), int((r["b"] + 1) * 5), 1,
                           STOP_PTS, tp_pts, max_bars))
        elif r["close"] < r[f"pl{N}"] and r["dz"] <= -theta:
            out.append(Sig(int(r["sess"]), int((r["b"] + 1) * 5), -1,
                           STOP_PTS, tp_pts, max_bars))
    return out


def fam_F2(b5, theta, tp_pts, max_bars):
    """CVD divergence fade: new 60-min price high, CVD short of its 60-min
    high by >= theta * sigma_delta; mirror for lows."""
    out = []
    for _, r in b5.iterrows():
        if not np.isfinite(r["cvd_hi12"]) or not np.isfinite(r["d_sd"]):
            continue
        if r["high"] >= r["hi12"] and (r["cvd_hi12"] - r["cvd"]) >= theta * r["d_sd"]:
            out.append(Sig(int(r["sess"]), int((r["b"] + 1) * 5), -1,
                           STOP_PTS, tp_pts, max_bars))
        elif r["low"] <= r["lo12"] and (r["cvd"] - r["cvd_lo12"]) >= theta * r["d_sd"]:
            out.append(Sig(int(r["sess"]), int((r["b"] + 1) * 5), 1,
                           STOP_PTS, tp_pts, max_bars))
    return out


def fam_F3(b5, q, tp_pts, max_bars):
    """Absorption fade: 3-bar leg, then vol z>=2, |delta|/vol<=q, range<=0.5*ATR."""
    out = []
    for _, r in b5.iterrows():
        d = r["leg3"]
        if d == 0 or not np.isfinite(r["vz"]) or not np.isfinite(r["atr"]):
            continue
        if r["vol"] <= 0:
            continue
        if (r["vz"] >= 2.0 and abs(r["delta"]) / r["vol"] <= q
                and (r["high"] - r["low"]) <= 0.5 * r["atr"]):
            out.append(Sig(int(r["sess"]), int((r["b"] + 1) * 5), int(-d),
                           STOP_PTS, tp_pts, max_bars))
    return out


def fam_F4(b5, stacks, tp_pts, max_bars):
    """Stacked-imbalance continuation: enter with stack direction next bar."""
    out = []
    keyed = {(int(r["sess"]), int(r["b"])): int(r["dir"])
             for _, r in stacks.iterrows()}
    for _, r in b5.iterrows():
        d = keyed.get((int(r["sess"]), int(r["b"])))
        if d is None or r["b"] < 2:
            continue
        out.append(Sig(int(r["sess"]), int((r["b"] + 1) * 5), d,
                       STOP_PTS, tp_pts, max_bars))
    return out


def fam_F5(b5, theta, tp_pts, max_bars):
    """CVD-aligned VWAP pullback: slope filter + touch of VWAP band, close beyond."""
    out = []
    for _, r in b5.iterrows():
        if (not np.isfinite(r["cvd_slope"]) or not np.isfinite(r["slope_sd"])
                or not np.isfinite(r["vwap"]) or not np.isfinite(r["atr"])):
            continue
        band = 0.25 * r["atr"]
        if (r["cvd_slope"] >= theta * r["slope_sd"] and r["cvd_slope"] > 0
                and r["low"] <= r["vwap"] + band and r["close"] > r["vwap"]):
            out.append(Sig(int(r["sess"]), int((r["b"] + 1) * 5), 1,
                           STOP_PTS, tp_pts, max_bars))
        elif (r["cvd_slope"] <= -theta * r["slope_sd"] and r["cvd_slope"] < 0
              and r["high"] >= r["vwap"] - band and r["close"] < r["vwap"]):
            out.append(Sig(int(r["sess"]), int((r["b"] + 1) * 5), -1,
                           STOP_PTS, tp_pts, max_bars))
    return out


def fam_F6(b5, profiles, variant):
    """Value-area rules vs prior session profile.
    variant 'rule80': open outside prior VA, first two 5m closes back inside ->
      enter bar 3 toward far edge, target far edge, stop 5, exit session end.
    variant 'edgefade': cross above VAH then close back below -> short to POC
      (mirror at VAL)."""
    out = []
    for s in sorted(b5["sess"].unique()):
        if s - 1 not in profiles:
            continue
        pr = profiles[s - 1]
        d = b5[b5["sess"] == s].sort_values("b")
        if variant == "rule80":
            o = d.iloc[0]["open"]
            if o > pr["vah"]:
                inside = (d.iloc[0]["close"] < pr["vah"]) and (d.iloc[1]["close"] < pr["vah"])
                if inside:
                    e_m = 2 * 5
                    ep = d.iloc[1]["close"]
                    out.append(Sig(int(s), e_m, -1, STOP_PTS,
                                   max(ep - pr["val"], TICK), M_PER_SESS))
            elif o < pr["val"]:
                inside = (d.iloc[0]["close"] > pr["val"]) and (d.iloc[1]["close"] > pr["val"])
                if inside:
                    e_m = 2 * 5
                    ep = d.iloc[1]["close"]
                    out.append(Sig(int(s), e_m, 1, STOP_PTS,
                                   max(pr["vah"] - ep, TICK), M_PER_SESS))
        else:  # edgefade
            for i in range(1, len(d)):
                r0, r1 = d.iloc[i - 1], d.iloc[i]
                if r0["close"] > pr["vah"] and r1["close"] < pr["vah"]:
                    out.append(Sig(int(s), int((r1["b"] + 1) * 5), -1, STOP_PTS,
                                   max(r1["close"] - pr["poc"], TICK), 120))
                    break
                if r0["close"] < pr["val"] and r1["close"] > pr["val"]:
                    out.append(Sig(int(s), int((r1["b"] + 1) * 5), 1, STOP_PTS,
                                   max(pr["poc"] - r1["close"], TICK), 120))
                    break
    return out


def fam_F7(tape, pctl, tp_pts, max_bars, trailing_sess=5):
    """Sweep momentum: per-second same-side size sum >= trailing percentile.
    Enter next 1m bar in sweep direction. Cap 5/side/session."""
    df = pd.DataFrame({
        "sess": tape["sess"],
        "sec": tape["sec"].astype(np.int64),
        "s": tape["side"],
        "q": tape["size"],
    })
    df["sq_a"] = np.where(df["s"] > 0, df["q"], 0)
    df["sq_b"] = np.where(df["s"] < 0, df["q"], 0)
    g = df.groupby(["sess", "sec"])[["sq_a", "sq_b"]].sum().reset_index()
    g["mx"] = g[["sq_a", "sq_b"]].max(axis=1)
    sessions = sorted(g["sess"].unique())
    out = []
    for s in sessions:
        prior = g[(g["sess"] >= s - trailing_sess) & (g["sess"] < s)]["mx"]
        if len(prior) < 1000:
            continue
        thr = float(np.percentile(prior, pctl))
        cur = g[g["sess"] == s]
        a = cur["sq_a"].to_numpy()
        bv = cur["sq_b"].to_numpy()
        sc = cur["sec"].to_numpy()
        d = np.where((a >= thr) & (a > bv), 1,
                     np.where((bv >= thr) & (bv > a), -1, 0))
        hits = np.flatnonzero(d != 0)
        n_up = n_dn = 0
        for i in hits:
            di = int(d[i])
            if (di > 0 and n_up >= 5) or (di < 0 and n_dn >= 5):
                continue
            m = int(sc[i] // 60) + 1
            if m >= M_PER_SESS:
                continue
            out.append(Sig(int(s), m, di, STOP_PTS, tp_pts, max_bars))
            if di > 0:
                n_up += 1
            else:
                n_dn += 1
    return out


def fam_F8(b5, theta, tp_pts, trailing=60, min_hist=10):
    """Opening-drive delta: first-15m delta z vs trailing sessions' first-15m
    deltas. Enter 09:45 bar, exit 11:00 (75 x 1m bars) or stop/TP."""
    first15 = (b5[b5["b"] < 3].groupby("sess")["delta"].sum()).sort_index()
    out = []
    sessions = first15.index.to_list()
    for i, s in enumerate(sessions):
        hist = first15.iloc[max(0, i - trailing):i]
        if len(hist) < min_hist or hist.std() <= 0:
            continue
        z = (first15.loc[s] - hist.mean()) / hist.std()
        if z >= theta:
            out.append(Sig(int(s), 15, 1, STOP_PTS, tp_pts, 75))
        elif z <= -theta:
            out.append(Sig(int(s), 15, -1, STOP_PTS, tp_pts, 75))
    return out


# ----------------------------------------------------------------------------
# OF-1 cell registry (frozen)
# ----------------------------------------------------------------------------

def build_all_cells(tape):
    """Returns {cell_name: [Sig,...]} for all 34 preregistered cells."""
    b1 = build_bars(tape, 60)
    b5 = add_features(build_bars(tape, 300))
    fp = footprint_5m(tape)
    profiles = session_profiles(tape)
    cells = {}
    for N in (20, 60):
        for th in (1.5, 2.5):
            for tag, tp, mb in _exit_variants():
                cells[f"F1_N{N}_z{th}_{tag}"] = fam_F1(b5, N, th, tp, mb)
    for th in (0.5, 1.5):
        for tag, tp, mb in _exit_variants():
            cells[f"F2_div{th}_{tag}"] = fam_F2(b5, th, tp, mb)
    for q in (0.10, 0.20):
        for tag, tp, mb in _exit_variants():
            cells[f"F3_q{q}_{tag}"] = fam_F3(b5, q, tp, mb)
    for ratio in (3.0, 4.0):
        stacks = stacked_imbalances(fp, ratio)
        for tag, tp, mb in _exit_variants():
            cells[f"F4_r{ratio:.0f}_{tag}"] = fam_F4(b5, stacks, tp, mb)
    for th in (0.0, 1.0):
        for tag, tp, mb in _exit_variants():
            cells[f"F5_s{th}_{tag}"] = fam_F5(b5, th, tp, mb)
    cells["F6_rule80"] = fam_F6(b5, profiles, "rule80")
    cells["F6_edgefade"] = fam_F6(b5, profiles, "edgefade")
    for p in (99.5, 99.9):
        for tag, tp, mb in (("2R", 2 * STOP_PTS, 15), ("t15", None, 15)):
            cells[f"F7_p{p}_{tag}"] = fam_F7(tape, p, tp, mb)
    for th in (1.0, 2.0):
        for tag, tp in (("2R", 2 * STOP_PTS), ("t75", None)):
            cells[f"F8_z{th}_{tag}"] = fam_F8(b5, th, tp)
    mats = _b1_matrix(b1)
    return cells, mats, b5


def evaluate_cells(cells, mats, sessions, n_trials, mcpt_perms=500,
                   mcpt_t_gate=2.0):
    rows = []
    for name, sigs in cells.items():
        tr = execute(sigs, mats, sess_filter=set(sessions))
        y = daily_series(tr, sessions)
        t = hac_t(y)
        d = dsr(y, n_trials)
        p = np.nan
        if t >= mcpt_t_gate and len(tr) >= 10:   # one-sided: only positive cells matter
            p, _ = mcpt(sigs, mats, sessions, n_perm=mcpt_perms)
        rows.append({"cell": name, "n_trades": len(tr),
                     "net_pts": tr["pnl"].sum() if len(tr) else 0.0,
                     "pts_per_trade": tr["pnl"].mean() if len(tr) else 0.0,
                     "hac_t": t, "dsr": d, "mcpt_p": p})
    return pd.DataFrame(rows)

