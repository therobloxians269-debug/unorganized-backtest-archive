"""ROUTER v2 — trend leg unchanged (pullback into the move). MR leg fixed: don't fade the
IB-edge TOUCH, fade a confirmed REJECTION of it (5m wick pierces, body closes back inside),
and enter at the 50% of that wick. One trade a day."""
import numpy as np, pandas as pd, warnings; warnings.filterwarnings('ignore')
TICK=0.25; FLAT=959
def run(df, thr=0.40, decide=630, pbk=0.5, trRR=2.0, mrRR=2.0, ce=0.5,
        pv=2.0, comm=1.50, wickmin=0.4):
    m=(df.index.hour*60+df.index.minute)
    r=df[(m>=570)&(m<960)].copy(); r['tod']=m[(m>=570)&(m<960)]; r['day']=r.index.normalize()
    out=[]
    for day,b in r.groupby('day'):
        if len(b)<300: continue
        o=b.o.iloc[0]; pre=b[b.tod<=decide]
        if len(pre)<30: continue
        ibh=pre.h.max(); ibl=pre.l.min(); ib=ibh-ibl
        if ib<=0: continue
        pc=pre.c.iloc[-1]; ib_de=abs(pc-o)/ib
        post=b[b.tod>decide]
        if len(post)<30: continue
        H=post.h.values; L=post.l.values; C=post.c.values; O=post.o.values; T=post.tod.values; n=len(post)
        trend = ib_de>=thr
        lim=stp=tgt=np.nan; d=0; start=0
        if trend:
            d = 1 if pc>o else -1
            lim = pc - d*pbk*ib
            stp = (ibl-TICK*2) if d==1 else (ibh+TICK*2)
            if (d==1 and stp>=lim) or (d==-1 and stp<=lim): continue
            tgt = lim + d*trRR*abs(lim-stp)
        else:
            # 5m rejection of an IB edge: wick pierces, body closes back inside
            g=post.copy(); g['g5']=np.arange(n)//5
            agg=g.groupby('g5').agg(h=('h','max'),l=('l','min'),o=('o','first'),c=('c','last'))
            sig=None
            for gi,row in agg.iterrows():
                rng=row.h-row.l
                if rng<=0: continue
                if row.h>ibh and row.c<ibh:                       # bearish rejection of IBH
                    w=row.h-max(row.o,row.c)
                    if w>=wickmin*rng: sig=(gi,-1,row.h,max(row.o,row.c)); break
                if row.l<ibl and row.c>ibl:                       # bullish rejection of IBL
                    w=min(row.o,row.c)-row.l
                    if w>=wickmin*rng: sig=(gi,1,row.l,min(row.o,row.c)); break
            if sig is None: continue
            gi,d,ext,body=sig
            lim = ext + ce*(body-ext)                             # the 50% of the wick
            stp = ext - d*TICK*2
            if (d==1 and stp>=lim) or (d==-1 and stp<=lim): continue
            tgt = lim + d*mrRR*abs(lim-stp)
            start = (gi+1)*5                                      # only after that 5m bar closes
        risk=abs(lim-stp)
        if risk<TICK: continue
        fill=-1
        for k in range(start,n):
            if T[k]>=FLAT: break
            if (L[k]<=lim) if d==1 else (H[k]>=lim): fill=k; break
        if fill<0:
            out.append(dict(t=day,type='TREND' if trend else 'MEANREV',filled=0,pnl=0.0,R=np.nan)); continue
        for k in range(fill+1,n):
            last=T[k]>=FLAT or k==n-1
            hs=(L[k]<=stp) if d==1 else (H[k]>=stp)
            ht=(H[k]>=tgt) if d==1 else (L[k]<=tgt)
            if hs: px=stp-d*TICK; why='stop'
            elif ht: px=tgt; why='tgt'
            elif last: px=C[k]; why='time'
            else: continue
            pnl=d*(px-lim)*pv-comm
            out.append(dict(t=day,type='TREND' if trend else 'MEANREV',filled=1,d=d,
                            pnl=pnl,R=pnl/(risk*pv),why=why,risk=risk)); break
    return pd.DataFrame(out)

