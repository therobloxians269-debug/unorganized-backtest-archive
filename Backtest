#!/usr/bin/env python3
"""OCEAN family f08_swing_donchian — multi-day Donchian swing on the RTH session series.

PRE-REGISTERED CONFIG (defaults):
  LONG-ONLY. Enter long at the 16:00 session close when today's close > max of the
  prior N=20 session HIGHS. Exit at the 16:00 close when close < min of the prior
  M=N/2=10 session LOWS, or after K=20 sessions held, or at the final session of the
  window. One position at a time; no same-close re-entry after an exit; no intraday or
  overnight stop (position HOLDS OVERNIGHT unprotected — gap risk reported honestly).
  Both fills are market orders at the close: friction = fric("eod") = 0.66 pt round trip.

Causality: entry signal uses only the prior N days' highs plus today's completed close;
fill at that same close. Exit signal likewise close-based. No intraday state crosses
sessions except aggregated past-day OHLC.

Roll-gap sensitivity (spliced front-month series): overnight P&L on nights landing in
month {3,6,9,12} dom 8-19 is zeroed and the whole stats block recomputed ("NR" numbers).
DEV diagnostic showed roll-window mean overnight gap -1.1 to -2.0 pts vs +0.3..+1.4
elsewhere, confirming splice pollution sits in that window.

Windows: dev = sessions <= 2022-12-31 (series truncated, nothing later is loaded);
holdout = entries only 2023-01-01.., signals may warm up on earlier history; all = both.
"""
import sys, os, json, argparse, datetime as dt
import numpy as np
sys.path.insert(0, "/Users/kaveh/mes_mim")
import omni2_lib as L
from omni2_lib import fric, DPP

DEV_END = dt.date(2022, 12, 31)
HOLDOUT_START = dt.date(2023, 1, 1)
FRIC = fric("eod")           # 0.66 pt round trip (entry market + exit market)
ENTRY_FRIC = 0.41            # entry-side share charged on entry day for daily MTM
RESULTS_DIR = "/Users/kaveh/mes_mim/ocean/results"

# ---- pre-registered parameters ----
PR = dict(dirs="L", N=20, K=20)          # M = N//2 = 10 by family spec


def build_daily(S):
    return dict(dates=np.array([s["date"] for s in S]),
                o=np.array([s["o"][0] for s in S]),
                h=np.array([s["h"].max() for s in S]),
                l=np.array([s["l"].min() for s in S]),
                c=np.array([s["c"][-1] for s in S]))


def is_roll_week(d):
    return d.month in (3, 6, 9, 12) and 8 <= d.day <= 19


def simulate(D, N, K, dirs, entry_ok):
    """Session-close loop. Returns (trades, daily MTM pts net of friction,
    daily roll-week overnight component). Exit checked before entry; no same-close
    re-entry. Stops: none (family spec — unprotected overnight holds)."""
    dates, o, h, l, c = D["dates"], D["o"], D["h"], D["l"], D["c"]
    n = len(dates); M = N // 2
    trades = []
    mtm = np.zeros(n)
    on_roll = np.zeros(n)
    pos = 0; entry_px = np.nan; entry_i = -1; worst_on = 0.0; on_roll_trade = 0.0
    for t in range(N, n):
        exited = False
        if pos != 0:
            gap = pos * (o[t] - c[t - 1])
            intr = pos * (c[t] - o[t])
            mtm[t] += gap + intr
            worst_on = min(worst_on, gap)
            if is_roll_week(dates[t]):
                on_roll[t] += gap; on_roll_trade += gap
            held = t - entry_i
            hi_M = h[t - M:t].max(); lo_M = l[t - M:t].min()
            sig_exit = (c[t] < lo_M) if pos > 0 else (c[t] > hi_M)
            if sig_exit or held >= K or t == n - 1:
                net = pos * (c[t] - entry_px) - FRIC
                mtm[t] -= (FRIC - ENTRY_FRIC)
                trades.append(dict(edate=dates[entry_i], xdate=dates[t], side=pos,
                                   net=net, held=held, worst_on=worst_on,
                                   on_roll=on_roll_trade))
                pos = 0; exited = True
        if pos == 0 and not exited and entry_ok[t] and t < n - 1:
            side = 0
            if "L" in dirs and c[t] > h[t - N:t].max(): side = 1
            elif "S" in dirs and c[t] < l[t - N:t].min(): side = -1
            if side:
                pos = side; entry_px = c[t]; entry_i = t
                worst_on = 0.0; on_roll_trade = 0.0
                mtm[t] -= ENTRY_FRIC
    return trades, mtm, on_roll


def stats(trades, mtm, on_roll, dates, wmask):
    if not trades:
        return None
    net = np.array([tr["net"] for tr in trades])
    m = mtm[wmask]; d = dates[wmask]
    eq = np.cumsum(m) * DPP
    dd = float((eq - np.maximum.accumulate(eq)).min())
    tot = float(net.sum() * DPP)
    mar = tot / abs(dd) if dd < 0 else float("inf")
    yrs = np.array([x.year for x in d])
    yearly = {int(y): round(float(m[yrs == y].sum() * DPP), 2) for y in np.unique(yrs)}
    mo = np.array([x.year * 100 + x.month for x in d])
    msum = [m[mo == k].sum() * DPP for k in np.unique(mo)]
    top3 = float(sum(sorted(msum, reverse=True)[:3]) / tot) if tot > 0 else float("nan")
    # roll-week sensitivity: zero overnight P&L on roll-week nights
    tot_nr = float((net - np.array([tr["on_roll"] for tr in trades])).sum() * DPP)
    m_nr = (mtm - on_roll)[wmask]
    eq2 = np.cumsum(m_nr) * DPP
    dd_nr = float((eq2 - np.maximum.accumulate(eq2)).min())
    mar_nr = tot_nr / abs(dd_nr) if dd_nr < 0 else float("inf")
    return dict(trades=len(trades), net_usd=round(tot, 2), mar=round(mar, 3),
                maxdd_usd=round(dd, 2), hit=round(float((net > 0).mean()), 4),
                expectancy_pts=round(float(net.mean()), 3),
                avg_hold_days=round(float(np.mean([tr["held"] for tr in trades])), 2),
                yearly=yearly, top3_month_share=round(top3, 4),
                net_usd_rollzeroed=round(tot_nr, 2), mar_rollzeroed=round(mar_nr, 3),
                maxdd_usd_rollzeroed=round(dd_nr, 2),
                worst_overnight_pts=round(float(min(tr["worst_on"] for tr in trades)), 2),
                worst_overnight_usd=round(float(min(tr["worst_on"] for tr in trades)) * DPP, 2))


def run_window(window, N, K, dirs):
    S = L.load()
    if window == "dev":
        S = [s for s in S if s["date"] <= DEV_END]        # FIREWALL: holdout never loaded
    D = build_daily(S)
    if window == "holdout":
        entry_ok = np.array([d >= HOLDOUT_START for d in D["dates"]])
        wmask = entry_ok.copy()
    else:
        entry_ok = np.ones(len(D["dates"]), dtype=bool)
        wmask = entry_ok.copy()
    tr, mtm, onr = simulate(D, N, K, dirs, entry_ok)
    return stats(tr, mtm, onr, D["dates"], wmask), D


def sweep_dev():
    """Full pre-registration sweep — 18 configs, DEV only. Printed for the referee."""
    S = [s for s in L.load() if s["date"] <= DEV_END]
    D = build_daily(S)
    entry_ok = np.ones(len(D["dates"]), dtype=bool)
    wmask = entry_ok.copy()
    print("\nSWEEP (DEV only, 18 configs tested; M=N/2 fixed by family spec)")
    print(f"{'cfg':>3} {'dir':>3} {'N':>3} {'K':>4} | {'trd':>4} {'net$':>7} {'MAR':>6} {'maxDD$':>7} "
          f"{'hit':>4} {'hold':>5} {'yr+':>5} {'mxYrShr':>7} | {'netNR$':>7} {'marNR':>6} {'worstON':>7}")
    i = 0
    for dirs in ("L", "LS"):
        for N in (10, 20, 55):
            for K in (10, 20, 10 ** 9):
                i += 1
                trd, mtm, onr = simulate(D, N, K, dirs, entry_ok)
                st = stats(trd, mtm, onr, D["dates"], wmask)
                ks = "inf" if K > 1000 else str(K)
                if st is None:
                    print(f"{i:3d} {dirs:>3} {N:3d} {ks:>4} | no trades"); continue
                ypos = sum(1 for v in st["yearly"].values() if v > 0)
                mxshr = (max(st["yearly"].values()) / st["net_usd"]) if st["net_usd"] > 0 else float("nan")
                mark = " <== PRE-REGISTERED" if (dirs, N, K) == (PR["dirs"], PR["N"], PR["K"]) else ""
                print(f"{i:3d} {dirs:>3} {N:3d} {ks:>4} | {st['trades']:4d} {st['net_usd']:7.0f} {st['mar']:6.2f} "
                      f"{st['maxdd_usd']:7.0f} {st['hit']:4.2f} {st['avg_hold_days']:5.1f} "
                      f"{ypos:2d}/{len(st['yearly']):2d} {mxshr:7.2f} | {st['net_usd_rollzeroed']:7.0f} "
                      f"{st['mar_rollzeroed']:6.2f} {st['worst_overnight_pts']:7.1f}{mark}")
    print("plateau: pre-registered (L,20,20); neighbors N=10/N=55 (same K) and K=10/K=inf")
    print("(same N) all DEV-net-positive. Long-only chosen: every LS config fails the bar.")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--window", choices=["dev", "holdout", "all"], default="dev")
    ap.add_argument("--N", type=int, default=PR["N"])
    ap.add_argument("--K", type=int, default=PR["K"])
    ap.add_argument("--dirs", type=str, default=PR["dirs"])
    a = ap.parse_args()

    st, D = run_window(a.window, a.N, a.K, a.dirs)
    print(f"f08_swing_donchian  window={a.window}  config: dir={a.dirs} N={a.N} M={a.N//2} K={a.K}")
    print(f"sessions in series: {len(D['dates'])}  {D['dates'][0]} .. {D['dates'][-1]}")
    if st is None:
        print("NO TRADES")
        out = dict(net_usd=0.0, mar=0.0, trades=0, hit=0.0, maxdd_usd=0.0, yearly={},
                   top3_month_share=0.0, expectancy_pts=0.0)
    else:
        print(f"trades          : {st['trades']}   (avg hold {st['avg_hold_days']:.1f} sessions)")
        print(f"net_usd         : {st['net_usd']:+.0f}   expectancy {st['expectancy_pts']:+.2f} pts/trade   hit {st['hit']:.2f}")
        print(f"maxDD (daily MTM): {st['maxdd_usd']:.0f}   MAR {st['mar']:.2f}")
        print(f"yearly $        : " + "  ".join(f"{y}:{v:+.0f}" for y, v in sorted(st["yearly"].items())))
        print(f"top3 month share: {st['top3_month_share']:.2f}")
        print(f"ROLL SENSITIVITY (overnight P&L zeroed in roll weeks mid Mar/Jun/Sep/Dec):")
        print(f"  net_usd {st['net_usd_rollzeroed']:+.0f}   MAR {st['mar_rollzeroed']:.2f}   "
              f"(edge is an artifact if this dies)")
        print(f"GAP RISK (no overnight stop): worst single overnight move against a held "
              f"position = {st['worst_overnight_pts']:.1f} pts (${st['worst_overnight_usd']:.0f} on 1 MES)")
        out = {k: st[k] for k in ("net_usd", "mar", "trades", "hit", "maxdd_usd",
                                  "top3_month_share", "expectancy_pts",
                                  "net_usd_rollzeroed", "mar_rollzeroed",
                                  "worst_overnight_pts", "worst_overnight_usd",
                                  "avg_hold_days")}
        out["yearly"] = {str(y): v for y, v in sorted(st["yearly"].items())}
    out["params"] = dict(dirs=a.dirs, N=a.N, M=a.N // 2, K=a.K, friction_pts=FRIC)
    os.makedirs(RESULTS_DIR, exist_ok=True)
    path = os.path.join(RESULTS_DIR, f"f08_swing_donchian_{a.window}.json")
    with open(path, "w") as f:
        json.dump(out, f, indent=2)
    print(f"json -> {path}")

    if a.window == "dev":
