#!/usr/bin/env python3
"""
run.py — assemble the causal context and backtest the ICT models.

Pipeline (every stage strictly causal):
    load 1m -> resample to exec TF -> swings -> structure(BOS/CHoCH)
    -> FVGs -> reference & equal-high/low liquidity -> sweeps
    -> HTF bias -> per-session volume profiles -> build setups -> engine -> report

Examples:
    python run.py --data mes_1m.csv --secondary mnq_1m.csv
    python run.py --data mes_1m.csv --models ict2022,silver_bullet --tf 5m --htf 1h
    python run.py --data mes_1m.csv --min-score 2 --require-smt --out-trades trades.csv
"""
from __future__ import annotations

import argparse
import numpy as np
import pandas as pd

from ict import data as D
from ict.structure import find_swings, track_structure
from ict.imbalance import find_fvgs
from ict.indicators import rolling_atr_array
from ict.liquidity import reference_levels, equal_highs_lows, find_sweeps
from ict.bias import htf_bias_series
from ict.volume_profile import build_profile
from ict.smt import align
from ict.models import Context, PRESETS, build_setups
from ict.confidence import build_confidence_setups, grade_to_min_score
from ict.risk import EngineConfig
from ict.engine import run_backtest
from ict import metrics
from dataclasses import replace


def build_context(args) -> Context:
    base = D.load(args.data)
    if getattr(args, "start", None):
        base = base[base.index >= pd.Timestamp(args.start, tz="UTC")]
    if getattr(args, "end", None):
        base = base[base.index <= pd.Timestamp(args.end, tz="UTC")]
    if base.empty:
        raise SystemExit("no bars in the requested --start/--end window")
    exec_df = D.resample(base, args.tf)
    exec_ny = D.to_ny(exec_df)
    sdates = D.session_date(exec_ny)

    swings = find_swings(exec_df, args.swing_left, args.swing_right)
    events = track_structure(exec_df, swings)
    fvgs = find_fvgs(exec_df, args.fvg_min_atr, args.atr_period)
    atr_arr = rolling_atr_array(exec_df, args.atr_period)

    levels = reference_levels(exec_ny, sdates)
    levels += equal_highs_lows(swings, tol=args.eqh_ticks * args.tick)
    sweeps = find_sweeps(exec_df, levels, expiry_bars=args.sweep_expiry, tol=0.0)

    bias = htf_bias_series(exec_df, args.htf, args.swing_left, args.swing_right).to_numpy()

    # Secondary instrument for SMT — reindexed onto the exec grid.
    secondary = None
    if args.secondary:
        sec_base = D.load(args.secondary)
        sec_exec = D.resample(sec_base, args.tf)
        secondary = sec_exec.reindex(exec_df.index).ffill()

    # Per-session volume profiles (used causally: a bar sees only prior sessions).
    codes, _ = pd.factorize(sdates.to_numpy())
    n_sessions = int(codes.max()) + 1 if len(codes) else 0
    profiles = []
    for o in range(n_sessions):
        positions = np.where(codes == o)[0]
        profiles.append(build_profile(exec_df, positions, bin_size=args.vp_ticks * args.tick))

    return Context(
        df=exec_df, df_ny=exec_ny, bias=bias, swings=swings, events=events,
        sweeps=sweeps, fvgs=fvgs, levels=levels, atr=atr_arr, tick=args.tick,
        secondary=secondary, session_ord=codes, profiles=profiles,
    )


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--data", required=True, help="primary 1m OHLCV CSV or Parquet")
    ap.add_argument("--secondary", help="correlated instrument for SMT (CSV or Parquet)")
    ap.add_argument("--start", help="ISO date to start (UTC), e.g. 2022-01-01")
    ap.add_argument("--end", help="ISO date to end (UTC), e.g. 2024-12-31")
    ap.add_argument("--models", default="ict2022,silver_bullet,judas",
                    help="comma list of presets: " + ",".join(PRESETS) + ",confluence")
    ap.add_argument("--min-grade", default="C",
                    help="confluence engine: min grade to trade (A+/A/B/C/D/F or a 0-100 number)")
    ap.add_argument("--tf", default="5m", help="execution timeframe")
    ap.add_argument("--htf", default="1h", help="higher timeframe for bias")
    ap.add_argument("--swing-left", type=int, default=2)
    ap.add_argument("--swing-right", type=int, default=2)
    ap.add_argument("--atr-period", type=int, default=14)
    ap.add_argument("--fvg-min-atr", type=float, default=0.0)
    ap.add_argument("--eqh-ticks", type=float, default=4.0)
    ap.add_argument("--vp-ticks", type=float, default=4.0)
    ap.add_argument("--sweep-expiry", type=int, default=300)
    ap.add_argument("--entry", default="ce", choices=["edge", "ce", "far"],
                    help="FVG fill: edge=first touch, ce=midpoint, far=deep fill")
    # engine / risk
    ap.add_argument("--tick", type=float, default=0.25)
    ap.add_argument("--point-value", type=float, default=5.0)
    ap.add_argument("--risk", type=float, default=100.0)
    ap.add_argument("--commission", type=float, default=0.62)
    ap.add_argument("--slippage-ticks", type=float, default=1.0)
    ap.add_argument("--no-partial", action="store_true")
    ap.add_argument("--partial-rr", type=float, default=1.0)
    ap.add_argument("--partial-frac", type=float, default=0.5)
    # filters
    ap.add_argument("--min-score", type=int, default=0)
    ap.add_argument("--require-smt", action="store_true")
    ap.add_argument("--require-ote", action="store_true")
    ap.add_argument("--require-pd", action="store_true", help="require discount/premium")
    ap.add_argument("--out-trades", help="write trade blotter CSV")
    args = ap.parse_args()

    ctx = build_context(args)

    all_setups = []
    for name in [m.strip() for m in args.models.split(",") if m.strip()]:
        if name in ("confluence", "engine"):
            # Fused SMC/ICT confidence engine: don't hard-gate on any single
            # confluence — let the 0-100 grade decide which signals to trade.
            base = replace(PRESETS["ict2022"], name="confluence", require_bias=False,
                           require_smt=False, require_ote=False,
                           require_discount_premium=False, min_score=0,
                           entry_mode=args.entry)
            all_setups += build_confidence_setups(ctx, base,
                                                  min_score=grade_to_min_score(args.min_grade))
            continue
        if name not in PRESETS:
            raise SystemExit(f"unknown model {name!r}; choose from {list(PRESETS)}")
        cfg = PRESETS[name]
        cfg.min_score = args.min_score
        cfg.entry_mode = args.entry
        cfg.require_smt = cfg.require_smt or args.require_smt
        cfg.require_ote = cfg.require_ote or args.require_ote
        cfg.require_discount_premium = cfg.require_discount_premium or args.require_pd
        all_setups += build_setups(ctx, cfg)

    ecfg = EngineConfig(
        risk_per_trade=args.risk, point_value=args.point_value, tick=args.tick,
        commission_per_contract=args.commission, slippage_ticks=args.slippage_ticks,
        partial_enabled=not args.no_partial, partial_rr=args.partial_rr,
        partial_frac=args.partial_frac,
    )
    result = run_backtest(ctx.df, all_setups, ecfg)
    trades = result["trades"]

    span = f"{ctx.df.index[0]} -> {ctx.df.index[-1]} UTC"
    print(f"data   : {args.data}   ({len(ctx.df):,} {args.tf} bars)")
    print(f"span   : {span}")
    print(f"models : {args.models}   htf-bias={args.htf}")
    print(f"setups : {len(all_setups)} armed  |  sweeps={len(ctx.sweeps)} "
          f"events={len(ctx.events)} fvgs={len(ctx.fvgs)} levels={len(ctx.levels)}")
    print()
    print(metrics.format_report(trades, title=f"ICT engine — {args.models}"))

    # Time-ordered out-of-sample split — the honest robustness check.
    if not trades.empty:
        t = trades.sort_values("entry_time")
        cut = t["entry_time"].quantile(0.70)
        is_, oos = t[t["entry_time"] <= cut], t[t["entry_time"] > cut]
        if len(is_) and len(oos):
            print()
            print(metrics.format_report(is_, title="IN-SAMPLE  (first 70% by time)"))
            print()
            print(metrics.format_report(oos, title="OUT-OF-SAMPLE  (last 30% by time)"))

    if args.out_trades and not trades.empty:
        trades.to_csv(args.out_trades, index=False)
        print(f"\nwrote blotter -> {args.out_trades}")


if __name__ == "__main__":
    main()

