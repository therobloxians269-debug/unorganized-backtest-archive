"""
TWO BLOCKS — clean-room frame builder.

For each RTH session build, causally:
  · pre-open features (known at 09:30:00, nothing from today's RTH)
  · IB = 09:30-10:30, the "already printed" candidate extremes
  · the BREAK: first post-10:30 bar taking out an IB edge  (time-stamped, causal)
  · everything known AT the break bar
  · the realised remaining travel of the UNPRINTED extreme after the break
  · minute arrays post-break for a path-accurate simulator

No feature may use information dated after the timestamp it is attached to.
Audited by audit_causal() at the bottom.
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')

RTH0, RTH1 = 570, 960          # 09:30, 16:00 ET in minutes
IBLEN      = 60                # the full first hour (30 min is much weaker - measured)


def load(which):
    if which == 'ES':
        d = pd.read_parquet('/Users/kaveh/overnight_premium_engine/data/es_front_1m.parquet')
        d = d[['open', 'high', 'low', 'close', 'volume']].copy()
    else:
        f = '/Users/kaveh/qt_cascade/nq.parquet' if which == 'NQ' else '/Users/kaveh/qt_cascade/mnq.parquet'
        d = pd.read_parquet(f)[['o', 'h', 'l', 'c', 'v']]
        d.columns = ['open', 'high', 'low', 'close', 'volume']
    d = d[~d.index.duplicated(keep='first')].sort_index()
    return d


def build(d, adrlen=14, iblen=IBLEN):
    tod = d.index.hour * 60 + d.index.minute
    d = d.assign(tod=tod, rth=(tod >= RTH0) & (tod < RTH1), day=d.index.normalize())
    r = d[d.rth]
    g = r.groupby('day')

    day = pd.DataFrame({'o930': g['open'].first(), 'hi': g['high'].max(),
                        'lo': g['low'].min(), 'cl': g['close'].last(), 'n': g.size()})
    day = day[day.n >= 300]                       # full sessions only, no half days
    day['rng']  = day.hi - day.lo
    day['ADR']  = day.rng.shift(1).rolling(adrlen).mean()   # today EXCLUDED
    # leak check at the only place the unfiltered series exists: ADR[i] must be the
    # mean of ranges i-adrlen .. i-1 and must never touch rng[i].
    _rv = day.rng.values
    _chk = np.array([np.nan if i < adrlen else _rv[i - adrlen:i].mean() for i in range(len(_rv))])
    day['_adr_ok'] = np.isclose(day.ADR.values, _chk, atol=1e-9, equal_nan=True)
    day['prevC']   = day.cl.shift(1)
    day['prevRng'] = day.rng.shift(1)

    # overnight block = bars between prior RTH close and this RTH open
    ov = d[~d.rth].copy()
    rd = day.index
    pos  = np.searchsorted(rd.values, ov.index.normalize().values, side='left')
    idx  = np.where(ov.tod.values < RTH0, pos, pos + 1)
    ok   = idx < len(rd)
    ov, idx = ov[ok], idx[ok]
    ov['tgt'] = rd[idx]
    og = ov.groupby('tgt')
    day['onH'] = og['high'].max()
    day['onL'] = og['low'].min()
    day['onV'] = og['volume'].sum()

    day = day.dropna(subset=['ADR', 'onH', 'onL', 'prevC', 'prevRng'])
    day = day[day.ADR > 0]
    A = day.ADR

    # ── pre-open features, all known at 09:30:00 ──
    day['f_onr']  = (day.onH - day.onL) / A
    day['f_onlo'] = (day.o930 - day.onL) / A
    day['f_onhi'] = (day.onH - day.o930) / A
    day['f_gap']  = (day.o930 - day.prevC) / A
    day['f_pdr']  = day.prevRng / A
    day['f_dow']  = day.index.dayofweek / 4.0
    # realised full-session travel from the open (the unconditional fan's target)
    day['y_lo'] = (day.o930 - day.lo) / A
    day['y_hi'] = (day.hi - day.o930) / A

    # ── IB + the break, per session ──
    rec, paths = [], {}
    for dd, b in r.groupby('day'):
        if dd not in day.index:
            continue
        H, L, O, C, T = (b.high.values, b.low.values, b.open.values,
                         b.close.values, b.tod.values)
        m = T < RTH0 + iblen
        if m.sum() < iblen * 0.8:
            continue
        ibh, ibl = H[m].max(), L[m].min()
        post = np.flatnonzero(~m)
        if len(post) < 30:
            continue
        up = post[H[post] >= ibh]
        dn = post[L[post] <= ibl]
        iu  = up[0] if len(up) else 10 ** 9
        idn = dn[0] if len(dn) else 10 ** 9
        if iu == 10 ** 9 and idn == 10 ** 9:
            brk, k = 'none', -1
        elif iu < idn:
            brk, k = 'up', iu
        elif idn < iu:
            brk, k = 'dn', idn
        else:                                     # same bar takes out both edges
            brk, k = 'both', iu

        row = dict(day=dd, ibh=ibh, ibl=ibl, ib_rng=ibh - ibl, brk=brk,
                   k=k, brk_tod=T[k] if k >= 0 else np.nan,
                   hi_in_ib=abs(H.max() - ibh) < 1e-9,
                   lo_in_ib=abs(L.min() - ibl) < 1e-9)

        if brk in ('up', 'dn'):
            # everything below is known at the CLOSE of bar k, nothing later
            row['brk_px'] = ibh if brk == 'up' else ibl
            row['brk_c']  = C[k]
            row['ib_vol'] = b.volume.values[m].sum()
            # travel of the unprinted extreme AFTER the break bar (bar k+1 onward)
            nxt = post[post > k]
            if len(nxt) < 5:
                continue
            row['post_hi'] = H[nxt].max()
            row['post_lo'] = L[nxt].min()
            paths[dd] = dict(H=H[nxt], L=L[nxt], T=T[nxt], C=C[nxt])
        rec.append(row)

    ib = pd.DataFrame(rec).set_index('day')
    day = day.join(ib, how='inner')
    day['either_in_ib'] = day.hi_in_ib | day.lo_in_ib
    return day, paths, r


def audit_causal(day):
    """Every feature must be computable from data strictly before its timestamp."""
    bad = []
    if (day.ADR <= 0).any():
        bad.append('ADR<=0')
    if not day._adr_ok.all():
        bad.append('ADR leak')
    if (day.brk_tod.dropna() < RTH0 + IBLEN).any():
        bad.append('break inside IB')
    return bad

