"""Stage 2: reconstruct the L3 limit-order book from MBO and test whether book imbalance /
microprice predict short-horizon MES returns better than trade flow did (Stage 1: IC 0.014,
sub-cost). One day at a time (14M+ records) to stay tractable.

Apply Add/Cancel/Modify/cleaR to maintain per-order book -> aggregate to price levels ->
snapshot top-of-book on a 1s grid with: best bid/ask + sizes, book imbalance, microprice
tilt, and trade OFI. Then IC + quintiles vs forward MID returns. Sanity-checks the
reconstruction (mean spread should be ~1 tick = 0.25).

    PYTHONPATH=. python3 research/l3_book_alpha.py [YYYYMMDD]
"""
from __future__ import annotations

import glob
import sys

import numpy as np
import pandas as pd
import databento as db

MBO_GLOB = "data/mbo/GLBX-20260607-8MCA89KCJQ/*.mbo.dbn.zst"
TICK = 0.25
GRID_NS = 1_000_000_000        # 1-second snapshot grid


def _codes(arr):
    """Normalize a databento char column (bytes 'S1' or small int) to int ordinals."""
    if arr.dtype.kind in ("S", "a"):
        return np.frombuffer(arr.tobytes(), dtype=np.uint8)
    return arr.astype(np.int64)


def reconstruct(path):
    store = db.DBNStore.from_file(path)
    arr = store.to_ndarray()                       # raw struct, fast
    iid = arr["instrument_id"]
    front = np.bincount(iid).argmax()              # most-active contract = front month
    ts_all = arr["ts_event"].astype("int64")
    day_idx = ts_all // 86_400_000_000_000         # UTC day index
    target_day = np.bincount(day_idx - day_idx.min()).argmax() + day_idx.min()
    m = (iid == front) & (day_idx == target_day)   # front contract, dominant session only
    a = arr[m]
    n = len(a)
    action = _codes(a["action"]).tolist()
    side = _codes(a["side"]).tolist()
    price = (a["price"].astype(np.float64) / 1e9).tolist()
    size = a["size"].astype(np.int64).tolist()
    oid = a["order_id"].tolist()
    ts = a["ts_event"].astype(np.int64).tolist()
    A, C, M, R, T, F = ord("A"), ord("C"), ord("M"), ord("R"), ord("T"), ord("F")
    BID, ASK = ord("B"), ord("A")

    orders = {}                                    # oid -> (side, price, size)
    bid, ask = {}, {}                              # price -> total size
    snaps = []
    next_grid = (ts[0] // GRID_NS + 1) * GRID_NS
    buyv = sellv = 0                               # trade flow within current grid bucket

    def best():
        bb = max(bid) if bid else np.nan
        aa = min(ask) if ask else np.nan
        return bb, aa

    for i in range(n):
        ac, sd, p, sz, oi, t = action[i], side[i], price[i], size[i], oid[i], ts[i]
        if t >= next_grid:                         # emit snapshot(s)
            bb, aa = best()
            if bb == bb and aa == aa and aa > bb:
                bs, as_ = bid.get(bb, 0), ask.get(aa, 0)
                snaps.append((next_grid, bb, aa, bs, as_, buyv, sellv))
            buyv = sellv = 0
            next_grid += GRID_NS
            while t >= next_grid:                  # skip idle seconds (carry book)
                bb, aa = best()
                if bb == bb and aa == aa and aa > bb:
                    snaps.append((next_grid, bb, aa, bid.get(bb, 0), ask.get(aa, 0), 0, 0))
                next_grid += GRID_NS
        if ac == A:
            orders[oi] = (sd, p, sz)
            lv = bid if sd == BID else ask
            lv[p] = lv.get(p, 0) + sz
        elif ac == C:
            o = orders.pop(oi, None)
            if o:
                lv = bid if o[0] == BID else ask
                r = lv.get(o[1], 0) - o[2]
                if r > 0:
                    lv[o[1]] = r
                else:
                    lv.pop(o[1], None)
        elif ac == M:
            o = orders.pop(oi, None)
            if o:
                lv = bid if o[0] == BID else ask
                r = lv.get(o[1], 0) - o[2]
                if r > 0:
                    lv[o[1]] = r
                else:
                    lv.pop(o[1], None)
            orders[oi] = (sd, p, sz)
            lv = bid if sd == BID else ask
            lv[p] = lv.get(p, 0) + sz
        elif ac == F:                              # fill: partial reduction of a resting order
            o = orders.get(oi)
            if o:
                lv = bid if o[0] == BID else ask
                r = lv.get(o[1], 0) - sz
                if r > 0:
                    lv[o[1]] = r
                else:
                    lv.pop(o[1], None)
                ns = o[2] - sz
                if ns > 0:
                    orders[oi] = (o[0], o[1], ns)
                else:
                    orders.pop(oi, None)
        elif ac == R:
            orders.clear(); bid.clear(); ask.clear()
        elif ac == T:
            bb, aa = best()
            mid = (bb + aa) / 2 if (bid and ask) else p
            if p > mid:
                buyv += sz
            elif p < mid:
                sellv += sz
    return pd.DataFrame(snaps, columns=["ts", "bid", "ask", "bidsz", "asksz", "buyv", "sellv"]), front, n


def main():
    day = sys.argv[1] if len(sys.argv) > 1 else None
    files = sorted(glob.glob(MBO_GLOB))
    path = next((f for f in files if day and day in f), files[-1])
    print(f"file: {path}")
    df, front, nrec = reconstruct(path)
    df.index = pd.to_datetime(df["ts"])
    df = df.between_time("13:30", "20:00")
    spread = (df["ask"] - df["bid"])
    print(f"front instrument_id={front} | {nrec:,} records -> {len(df):,} 1s snapshots")
    print(f"SANITY: mean spread {spread.mean():.4f} (1 tick={TICK}) | "
          f"frac 1-tick {(np.abs(spread-TICK)<1e-6).mean()*100:.1f}% | "
          f"mean bidsz {df['bidsz'].mean():.0f} asksz {df['asksz'].mean():.0f}")

    mid = (df["bid"] + df["ask"]) / 2
    tot = (df["bidsz"] + df["asksz"]).replace(0, np.nan)
    imb = (df["bidsz"] - df["asksz"]) / tot                    # book imbalance [-1,1]
    micro = (df["ask"] * df["bidsz"] + df["bid"] * df["asksz"]) / tot
    micro_tilt = (micro - mid) / TICK                          # microprice tilt in ticks
    ofi = (df["buyv"] - df["sellv"]) / (df["buyv"] + df["sellv"]).replace(0, np.nan)
    feats = {"book_imb": imb, "micro_tilt": micro_tilt, "trade_ofi": ofi}

    print("\nIC vs forward MID return (bps spread Q5-Q1):")
    print(f"  {'signal':>11} " + " ".join(f"{'fwd'+str(h):>16}" for h in (10, 30, 60, 300)))
    for name, sig in feats.items():
        cells = []
        for h in (10, 30, 60, 300):
            fwd = (mid.shift(-h) / mid - 1.0)
            s = pd.concat([sig, fwd], axis=1).dropna()
            ic = s.iloc[:, 0].corr(s.iloc[:, 1])
            try:
                q = pd.qcut(s.iloc[:, 0], 5, labels=False, duplicates="drop")
                sp = s.groupby(q).iloc[:, 1].mean() if False else s.iloc[:, 1].groupby(q).mean()
                spr = (sp.iloc[-1] - sp.iloc[0]) * 1e4
            except Exception:
                spr = float("nan")
            cells.append(f"{ic:+.3f}/{spr:+5.2f}bp")
        print(f"  {name:>11} " + " ".join(f"{c:>16}" for c in cells))
    print("\n(cost wall: MES round-trip ~0.7-1.0 bps; need Q5-Q1 >> that to trade by crossing)")


if __name__ == "__main__":
    main()

