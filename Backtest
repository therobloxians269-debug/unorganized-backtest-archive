"""Is the day's TYPE knowable early? Classify trend vs mean-reversion ex-post,
then hunt for causal predictors known by a decision time (10:30 / 11:00 ET)."""
import numpy as np, pandas as pd, warnings; warnings.filterwarnings('ignore')

def build(df, decide=630):          # 630 = 10:30 ET
    m=(df.index.hour*60+df.index.minute)
    r=df[(m>=570)&(m<960)].copy(); r['tod']=m[(m>=570)&(m<960)]; r['day']=r.index.normalize()
    rows=[]
    for day,b in r.groupby('day'):
        if len(b)<300: continue
        o=b.o.iloc[0]; h=b.h.max(); l=b.l.min(); c=b.c.iloc[-1]; rng=h-l
        if rng<=0: continue
        # ── ex-post day type ──
        de = abs(c-o)/rng                                   # directional efficiency
        # how much of the range was traversed AFTER the extreme was set (ping-pong-ness)
        ih=b.h.values.argmax(); il=b.l.values.argmin()
        first_ext = min(ih,il); last_ext=max(ih,il)
        rows.append(dict(day=day, rng=rng, de=de, close_pos=(c-l)/rng,
                         ext_gap=(last_ext-first_ext)/len(b),
                         hi_t=ih/len(b), lo_t=il/len(b)))
        # ── causal state at the decision time ──
        pre=b[b.tod<=decide]
        if len(pre)<30: rows.pop(); continue
        ibh=pre.h.max(); ibl=pre.l.min(); ib=ibh-ibl
        pc=pre.c.iloc[-1]
        rows[-1].update(ib=ib, ib_pos=(pc-ibl)/max(ib,1e-9),
                        ib_de=abs(pc-o)/max(ib,1e-9),
                        broke_up=float(pre.h.max()>=ibh), )
        # opening 30m efficiency + where we sit vs the IB edges
        o30=b[b.tod<600]
        if len(o30)>5:
            rows[-1]['de30']=abs(o30.c.iloc[-1]-o30.o.iloc[0])/max(o30.h.max()-o30.l.min(),1e-9)
        else: rows[-1]['de30']=np.nan
    R=pd.DataFrame(rows).dropna()
    R['ADR']=R.rng.shift(1).rolling(14).mean()
    R['ib_adr']=R.ib/R.ADR
    R['rng_adr']=R.rng/R.ADR
    return R.dropna()

for f,tag in [('nq_v6.parquet','NQ 2023-25'),('mnq_v6.parquet','MNQ 2026')]:
    R=build(pd.read_parquet(f))
    # trend day = high directional efficiency; MR day = low
    hi=R.de.quantile(.66); lo=R.de.quantile(.33)
    R['type']=np.where(R.de>=hi,'TREND',np.where(R.de<=lo,'MEANREV','mixed'))
    print(f'=== {tag}  n={len(R)} sessions ===')
    print(f'  DE terciles: MR <= {lo:.2f}   TREND >= {hi:.2f}')
    print(f'  {"predictor (known 10:30)":26s} {"MR mean":>9s} {"TREND mean":>11s} {"spread":>8s} {"AUC":>6s}')
    for feat in ['ib_adr','ib_de','ib_pos','de30','rng_adr']:
        a=R[R.type=='MEANREV'][feat]; b=R[R.type=='TREND'][feat]
        if feat=='ib_pos':
            a=(a-0.5).abs(); b=(b-0.5).abs()
        # AUC via rank statistic
        allv=np.concatenate([a,b]); rk=pd.Series(allv).rank().values
        auc=(rk[len(a):].sum()-len(b)*(len(b)+1)/2)/(len(a)*len(b))
        print(f'  {feat:26s} {a.mean():9.3f} {b.mean():11.3f} {b.mean()-a.mean():+8.3f} {auc:6.3f}')
    print(f'  base rate TREND among non-mixed: {(R[R.type!="mixed"].type=="TREND").mean()*100:.1f}%')
    print(f'  range on TREND days {R[R.type=="TREND"].rng.median():.0f}  vs MR days {R[R.type=="MEANREV"].rng.median():.0f}')
    print()

