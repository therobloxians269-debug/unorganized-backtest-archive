            best = min(best, nq_l[j]) if side == "short" else max(best, nq_h[j])
            if ((e - best) if side == "short" else (best - e)) > 0:
                ns = best + tatr * atr[j] if side == "short" else best - tatr * atr[j]
                stop = min(stop, ns) if side == "short" else max(stop, ns)
            j += 1
        if exit_px is None:
