# ============================================================================ loading
def _prep(df, name):
    df = df.copy()
    df.index.name = "ts"
    idx = df.index
    d = {}
    d["name"] = name
    d["df"] = df
    d["n"] = len(df)
    d["o"] = df["o"].to_numpy(np.float64)
    d["h"] = df["h"].to_numpy(np.float64)
    d["l"] = df["l"].to_numpy(np.float64)
    d["c"] = df["c"].to_numpy(np.float64)
    # clock minutes of day (ET)
    d["tod"] = (idx.hour * 60 + idx.minute).to_numpy(np.int32)
    # integer day-cycle id
    dc = pd.Series(pd.factorize(df["daycycle"].astype(str))[0], index=idx)
    d["day"] = dc.to_numpy(np.int64)
    d["daylabel"] = df["daycycle"].astype(str).to_numpy()
    # last bar of the cycle at or before 16:59 -> hard flatten bar
    tod = d["tod"]
    ok = tod <= 16 * 60 + 59
    pos = np.arange(d["n"])
    flat = np.full(d["n"], -1, np.int64)
    tmp = pd.DataFrame({"day": d["day"], "pos": pos, "ok": ok})
    lastok = tmp[tmp.ok].groupby("day")["pos"].max()
    m = tmp["day"].map(lastok)
    flat = m.fillna(-1).to_numpy(np.int64)
    d["flat"] = flat
    # causal true range / ATR on 1-min
    c = df["c"]
    pc = c.shift(1)
    tr = np.maximum(df["h"] - df["l"],
                    np.maximum((df["h"] - pc).abs(), (df["l"] - pc).abs()))
    d["tr"] = tr
    for w in (15, 30, 60, 120, 390):
        d[f"atr{w}"] = tr.rolling(w, min_periods=max(5, w // 3)).mean().shift(1).to_numpy(np.float64)
    # prior-20-daycycle mean RTH (09:30-15:59) range, known at cycle start
    rth = df[(df.index.hour * 60 + df.index.minute >= 570) &
             (df.index.hour * 60 + df.index.minute <= 959)]
    rng = rth.groupby(rth["daycycle"].astype(str)).apply(lambda g: g["h"].max() - g["l"].min())
    rng = rng.reindex(pd.Index(pd.unique(df["daycycle"].astype(str))))
    prior = rng.shift(1).rolling(20, min_periods=5).mean()
    d["dayrange"] = pd.Series(df["daycycle"].astype(str).map(prior).to_numpy(), index=idx) \
        .ffill().to_numpy(np.float64)
    return d


_CACHE = {}
def load(name):
    if name in _CACHE:
        return _CACHE[name]
    if name == "IS":
        df = pd.read_parquet(f"{BASE}/nq_v5.parquet")
        df = df[(df.index >= "2023-01-01") & (df.index < "2025-01-01")]
        d = _prep(df, "NQ")
    elif name == "OOS1":
        df = pd.read_parquet(f"{BASE}/nq_v5.parquet")
        df = df[df.index >= "2025-01-01"]
        d = _prep(df, "NQ")
    elif name == "OOS2":
        df = pd.read_parquet(f"{BASE}/mnq_v5.parquet")
