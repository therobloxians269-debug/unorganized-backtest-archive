"""M3b: MAE/MFE geometry. Where does the trade actually go before it works?
   Measured from entry = o[i+1], path from bar i+1 forward. No stop, no target."""
import pandas as pd, numpy as np
from m0_data import load, NQ
from engine import prep
d = prep(load(NQ)); K=10
o,h,l,c = d.o.values,d.h.values,d.l.values,d.c.values
sid,tod = d.sid.values,d.tod.values
disp,vn,lok,atr = d.disp.values,d.vn.values,d.lo_k.values,d.atr.values
n=len(d); rows=[]
for i in range(n-1):
    if not (disp[i]<0 and vn[i]>=2.0 and tod[i]<=15*60+30 and np.isfinite(vn[i])
            and np.isfinite(atr[i]) and sid[i+1]==sid[i]): continue
    e = o[i+1]; j0=i+1; j1=i+1
    while j1<n and sid[j1]==sid[i] and (j1-i)<=60: j1+=1
    if j1-j0 < 10: continue
    seg_h, seg_l = h[j0:j1], l[j0:j1]
    mfe = seg_h.max()-e; mae = e-seg_l.min()
    rows.append(dict(i=i, atr=atr[i], entry=e, imp_low=lok[i],
                     dist_to_low=e-lok[i], imp_size=-disp[i],
                     mfe=mfe, mae=mae, mfe_a=mfe/atr[i], mae_a=mae/atr[i],
                     dl_a=(e-lok[i])/atr[i], fwd30=c[min(j0+29,j1-1)]-e))
M = pd.DataFrame(rows)
print(f'signals={len(M):,}  (NQ dev, vn>=2.0, down-impulse)\n')
print('=== how far is entry above the impulse low? (this is the old stop distance) ===')
print((M.dist_to_low.describe(percentiles=[.1,.25,.5,.75,.9])).round(2).to_string())
print(f'\n  median dist-to-low = {M.dist_to_low.median():.1f} NQ pts '
      f'= {M.dl_a.median():.3f} ATR   -> risk was TINY, noise ate it\n')
print('=== MAE (how far it goes AGAINST you before working), in ATR units ===')
for q in [.5,.6,.7,.75,.8,.85,.9,.95]:
    print(f'   p{int(q*100):>2d}  MAE={M.mae_a.quantile(q):.4f} ATR = {M.mae.quantile(q):6.1f} NQ pts')
print('\n=== MFE (how far it goes FOR you), in ATR units ===')
for q in [.25,.5,.6,.75,.9]:
    print(f'   p{int(q*100):>2d}  MFE={M.mfe_a.quantile(q):.4f} ATR = {M.mfe.quantile(q):6.1f} NQ pts')
print(f'\n  median MFE/MAE ratio = {(M.mfe_a.median()/M.mae_a.median()):.2f}')
print(f'  mean 30-bar fwd = {M.fwd30.mean():+.2f} NQ pts   (= ${M.fwd30.mean()*2:+.2f} on MNQ)')

print('\n=== if stop = X*ATR below entry, what fraction survive to reach Y*ATR? ===')
print(f'  {"stop":>7s} {"risk$":>7s} | ' + ' '.join(f'{f"tgt{y}":>9s}' for y in [0.05,0.10,0.15,0.20]))
for xs in [0.05,0.10,0.15,0.20,0.30,0.40]:
    surv = (M.mae_a > xs)
    line=[]
    for y in [0.05,0.10,0.15,0.20]:
        # crude: reached target AND did not exceed stop first is unknown here;
        # report unconditional hit rates to size the geometry, exact race comes next
        line.append(f'{((M.mfe_a>=y)&(~surv)).mean():>9.1%}')
    print(f'  {xs:>7.2f} {xs*M.atr.median()*2:>7.0f} | ' + ' '.join(line))
