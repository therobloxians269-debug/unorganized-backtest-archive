#!/usr/bin/env python3
"""
prep_data.py — decode Databento GLBX ohlcv-1m DBN files into lead-contract
continuous 1-minute CSVs for the Judas Swing Sentinel backtest.

Lead selection: per CME session date (18:00 ET boundary), keep only the
outright contract (no spreads) with the highest session volume. No
back-adjustment — the strategy is intraday-only and never holds through a
roll; levels are built from <=2 days of lookback, so roll-day basis jumps
touch at most a handful of sessions per year.

Usage:
    python3 prep_data.py --dbn <file.dbn.zst> --out data/es_1m.csv [--start 2019-05-05]
"""
from __future__ import annotations

import argparse

import databento as db
import pandas as pd

ET = "America/New_York"


def decode_lead(dbn_path: str, start: str | None, end: str | None) -> pd.DataFrame:
    store = db.DBNStore.from_file(dbn_path)
    df = store.to_df(map_symbols=True)  # index=ts_event (UTC), cols incl. symbol
    df = df.reset_index()

    # outrights only — spreads carry '-' in the raw symbol
    df = df[~df["symbol"].str.contains("-", na=False)]

    if start:
        df = df[df["ts_event"] >= pd.Timestamp(start, tz="UTC")]
    if end:
        df = df[df["ts_event"] <= pd.Timestamp(end, tz="UTC")]

    et = df["ts_event"].dt.tz_convert(ET)
    # CME session date: 18:00 ET rolls into the next calendar day
    df["session"] = (et + pd.Timedelta(hours=6)).dt.date

    vol = df.groupby(["session", "symbol"])["volume"].sum()
    lead = vol.groupby(level=0).idxmax().map(lambda t: t[1])  # session -> symbol
    df["lead"] = df["session"].map(lead)
    df = df[df["symbol"] == df["lead"]]

    out = df[["ts_event", "open", "high", "low", "close", "volume", "symbol"]].copy()
    out = out.rename(columns={"ts_event": "timestamp"})
    out = out.sort_values("timestamp").reset_index(drop=True)
    # occasional duplicate minute prints across publishers — keep last
    out = out.drop_duplicates(subset="timestamp", keep="last")
    return out


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--dbn", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--start", default=None)
    ap.add_argument("--end", default=None)
    args = ap.parse_args()

    df = decode_lead(args.dbn, args.start, args.end)
    df.to_csv(args.out, index=False)
    print(f"{args.out}: {len(df)} bars, {df['timestamp'].iloc[0]} -> {df['timestamp'].iloc[-1]}, "
          f"{df['symbol'].nunique()} contracts")


if __name__ == "__main__":
    main()

