import yfinance as yf
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# --- 1. CONFIGURATION & DATA ---
SYMBOL = 'MES=F'
START_BAL = 1000.0
RISK_PER_TRADE = 0.01
SLIPPAGE_PTS = 0.25
COMMISSION = 2.10
MULTIPLIER = 5.0

def run_production_vnm():
    # Download Data
    df = yf.download(SYMBOL, period='2y', interval='1h', auto_adjust=True)
    if isinstance(df.columns, pd.MultiIndex): df.columns = df.columns.get_level_values(0)

    # --- 2. INDICATOR ENGINE ---
    # Calculate log returns for stability score
    df['Log_Ret'] = np.log(df['Close'] / df['Close'].shift(1))
    
    # ATR for stop distance
    tr = pd.concat([
        (df['High'] - df['Low']),
        abs(df['High'] - df['Close'].shift()),
        abs(df['Low'] - df['Close'].shift())
    ], axis=1).max(axis=1)
    df['ATR'] = tr.rolling(14).mean()

    # SIGNAL GENERATION (With 1-period lag to prevent look-ahead bias)
    df['Signal_Score'] = (df['Log_Ret'].rolling(20).mean() / df['Log_Ret'].rolling(20).std()).shift(1)
    df['Lagged_ATR'] = df['ATR'].shift(1)
    
    df.dropna(inplace=True)

    # --- 3. BACKTEST ENGINE ---
    bal = START_BAL
    history = []
    pos, ent, qty = 0, 0.0, 0
    
    prices = df['Close'].values
    scores = df['Signal_Score'].values
    atrs = df['Lagged_ATR'].values

    for i in range(len(df)):
        # Exit Logic
        if pos != 0:
            pnl_raw = (prices[i] - ent) if pos == 1 else (ent - prices[i])
            # Logic: Exit if momentum flips or 3*ATR stop hit
            if (pos == 1 and scores[i] < -0.2) or (pos == -1 and scores[i] > 0.2) or (abs(pnl_raw) > 3*atrs[i]):
                net_pnl = ((pnl_raw - SLIPPAGE_PTS) * MULTIPLIER * qty) - (qty * COMMISSION)
                bal += net_pnl
                pos = 0

        # Entry Logic (Risk Parity Sizing)
        if pos == 0:
            if abs(scores[i]) > 0.5:
                # Size based on 3-ATR stop distance representing 1% risk
                stop_dist = max(atrs[i] * 3, 5.0)
                risk_amt = bal * RISK_PER_TRADE
                qty = max(1, int(risk_amt / (stop_dist * MULTIPLIER)))

                pos = 1 if scores[i] > 0.5 else -1
                # Entry price adjusted for slippage
                ent = prices[i] + SLIPPAGE_PTS if pos == 1 else prices[i] - SLIPPAGE_PTS

        history.append(bal)

    df['Final_VNM_Balance'] = history
    return df

# Execute and Visualize
final_df = run_production_vnm()
print(f"Final Account Balance: ${final_df['Final_VNM_Balance'].iloc[-1]:,.2f}")

plt.figure(figsize=(12, 6))
plt.plot(final_df.index, final_df['Final_VNM_Balance'], color='navy', lw=2)
plt.title('Final Validated VNM Strategy: MES=F (2-Year Backtest)')
plt.ylabel('Equity ($)')
plt.grid(True, alpha=0.3)
plt.show()

