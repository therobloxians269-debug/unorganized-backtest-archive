            lvl = lvl * (1 + displace / 100 * (1 if side == "short" else -1))
            fill = np.flatnonzero(hi >= lvl) if side == "short" else np.flatnonzero(lo <= lvl)
            if not len(fill):
                continue
            f = fill[0]
            stop = lvl * (1 + stop_pct / 100) if side == "short" else lvl * (1 - stop_pct / 100)
            r = abs(stop - lvl)
            tgt = lvl - target_r * r if side == "short" else lvl + target_r * r
            fh, fl = hi[f:], lo[f:]
