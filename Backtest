    return S.groupby(pd.DatetimeIndex(S.day).normalize()).pnl.sum()
def mc(d,mics,n=20000,maxd=250,seed=3):
    rng=np.random.default_rng(seed); D=d.values; p=b=0; days=[]; d30=0
    for _ in range(n):
        eq=0.0; pk=0.0
        for k in range(maxd):
            eq+=rng.choice(D)*mics; pk=max(pk,eq)
            if eq<=pk-THRESH: b+=1; break
            if eq>=TARGET: p+=1; days.append(k+1); d30+=(k+1)<=30; break
    return p/n*100,b/n*100,(np.median(days) if days else np.nan),d30/n*100
