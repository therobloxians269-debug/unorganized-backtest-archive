"""
NEW-SLEEVE GAUNTLET — test the two strongest UNtested additive candidates honestly.
Goal: can a genuinely-good, uncorrelated sleeve push the program Sharpe above 1.90?

Candidates (both documented effects, NOT data-mined):
  A) FUTURES cross-sectional momentum (12-1): rank the 14 roots by 12m-ex-1m return, long top third /
     short bottom third, vol-scaled, dollar-neutral, weekly, ~2bps (futures are cheap). Distinct from
     the existing TS-trend sleeve.
  B) CRYPTO time-series / absolute momentum: own coins in their own uptrend (past-90d>0), inv-vol,
     soft regime, 25bps. Distinct construction from the XS-momentum sleeve.

For each: standalone Sharpe (net cost), OOS split, correlation to existing M (crypto XS mom) and T
(futures trend), and net effect added to the full program at several weights. Adopt only if it
clears cost, holds OOS, is genuinely uncorrelated, AND lifts the program.

    PYTHONPATH=/Users/kaveh/mim_research python3 new_sleeve_gauntlet.py
"""
from __future__ import annotations
import numpy as np
import pandas as pd
from lib_perf import perf_stats
from pit_backtest import PX, ANN
from momentum_ensemble import build_elig

CSTART = pd.Timestamp("2018-01-01")


def stat(r):
    return perf_stats(r.dropna(), ANN)


def show(tag, r, turn=None):
    s = stat(r)
    t = f" | turn {turn.mean()*ANN:5.1f}x" if turn is not None else ""
    print(f"  {tag:30} Sharpe {s['sharpe']:5.2f} | CAGR {s['cagr']*100:6.1f}% | "
          f"vol {s['vol']*100:4.0f}% | maxDD {s['maxdd']*100:6.1f}%{t}")


def oos(r):
    a = r[(r.index.year >= 2018) & (r.index.year <= 2022)] if r.index.min().year < 2023 else r[r.index.year <= 2022]
    b = r[r.index.year >= 2023]
    print(f"     OOS:  pre-2023 Sharpe {stat(a)['sharpe']:5.2f}  |  2023+ Sharpe {stat(b)['sharpe']:5.2f}")


# ---------------------------------------------------------------- A) futures XS momentum
def futures_xs_mom(lb=252, skip=21, cost_bps=2.0):
    fp = pd.read_parquet("futures_panel.parquet"); fp["date"] = pd.to_datetime(fp["date"])
    px = fp.pivot_table(index="date", columns="root", values="fclose")
    ret = fp.pivot_table(index="date", columns="root", values="fret")
    mom = (px.shift(skip) / px.shift(lb) - 1).shift(1)            # 12-1 momentum, known yesterday
    av = (ret.rolling(60).std() * np.sqrt(ANN)).shift(1)
    n_t = mom.notna().sum(axis=1)
    k_t = np.maximum(2, (n_t // 3)).astype(float)
    longs = mom.rank(axis=1, ascending=False).le(k_t, axis=0).astype(float)
    shorts = mom.rank(axis=1, ascending=True).le(k_t, axis=0).astype(float)
    wl = (longs / av).replace([np.inf, -np.inf], np.nan).fillna(0.0)
    ws = (shorts / av).replace([np.inf, -np.inf], np.nan).fillna(0.0)
    wl = wl.div(wl.abs().sum(axis=1).replace(0, np.nan), axis=0).fillna(0.0)
    ws = ws.div(ws.abs().sum(axis=1).replace(0, np.nan), axis=0).fillna(0.0)
    w = (0.5 * wl - 0.5 * ws).shift(1)
    w = w.resample("W").last().reindex(px.index, method="ffill").fillna(0.0)
    turn = w.diff().abs().sum(axis=1)
    net = ((w * ret.fillna(0.0)).sum(axis=1) - turn * cost_bps * 1e-4).dropna()
    return net[net.index >= "2012-01-01"], turn


# ---------------------------------------------------------------- B) crypto TS/absolute momentum
def crypto_ts_mom(px, elig, lb=90, cost_bps=25.0):
    rets = px.pct_change()
    av = (rets.rolling(60).std() * np.sqrt(ANN)).shift(1)
    sig = px.pct_change(lb).shift(1).where(elig)
    longs = (sig > 0).astype(float)                              # own only coins in their own uptrend
    w = (longs / av).replace([np.inf, -np.inf], np.nan).fillna(0.0)
    w = w.div(w.abs().sum(axis=1).replace(0, np.nan), axis=0).fillna(0.0)
    mret = rets.where(elig).mean(axis=1).fillna(0.0)
    idx = (1 + mret).cumprod()
    soft = (idx > idx.rolling(100).mean()).shift(1).fillna(True).replace(False, 0.3).replace(True, 1.0).astype(float)
    w = w.mul(soft, axis=0).shift(1)
    w = w.resample("W").last().reindex(px.index, method="ffill").fillna(0.0)
    turn = w.diff().abs().sum(axis=1)
    net = ((w * rets.fillna(0.0)).sum(axis=1) - turn * cost_bps * 1e-4).dropna()
    return net[net.index >= CSTART], turn


def main():
    px = pd.read_parquet(PX); px.index = pd.to_datetime(px.index).tz_localize(None)
    elig = build_elig(px)
    M = pd.read_parquet("pit_net.parquet")["net"]
    T = pd.read_parquet("trend_all.parquet")["net"]
    from pm_dd_pack import build
    base_port, j, comp, tC1, tC2 = build()
    bs = stat(base_port)

    def program_add(sleeve, wgt):
        s = sleeve.reindex(j.index).fillna(0.0)
        return ((1 - wgt) * comp.sum(axis=1) + wgt * s).dropna()

    print("=" * 100)
    print(f"NEW-SLEEVE GAUNTLET — can we beat program Sharpe {bs['sharpe']:.2f}? (baseline 4-sleeve)")
    print("=" * 100)

    for label, sleeve, turn, other in [
        ("A) FUTURES XS MOMENTUM (12-1)", *futures_xs_mom(), None),
        ("B) CRYPTO TS/ABS MOMENTUM (90d)", *crypto_ts_mom(px, elig), None),
    ]:
        print(f"\n{label}")
        show("  standalone", sleeve, turn)
        oos(sleeve)
        df = pd.concat([sleeve.rename("NEW"), M.rename("MOM"), T.rename("TREND")], axis=1, sort=True).dropna()
        c = df.corr()["NEW"]
        print(f"     corr to MOM {c['MOM']:+.2f} | corr to TREND {c['TREND']:+.2f}  (overlap {len(df)}d)")
        print("     added to program:")
        bestp = (bs["sharpe"], 0.0)
        for wgt in (0.05, 0.10, 0.15):
            p = program_add(sleeve, wgt); s = stat(p)
            flag = "  <-LIFT" if s["sharpe"] > bs["sharpe"] + 0.01 else ""
            print(f"       +{int(wgt*100):>2}% : Sharpe {s['sharpe']:.2f} | CAGR {s['cagr']*100:5.1f}% | maxDD {s['maxdd']*100:6.1f}%{flag}")
            if s["sharpe"] > bestp[0]:
                bestp = (s["sharpe"], wgt)
        print(f"     >>> best program Sharpe with this sleeve: {bestp[0]:.2f} (at {int(bestp[1]*100)}% wgt)  vs baseline {bs['sharpe']:.2f}")

    print("\n" + "=" * 100)
    print(f"VERDICT line: anything that prints best program Sharpe > {bs['sharpe']+0.05:.2f} AND holds OOS")
    print("AND is corr<~0.4 to MOM is a REAL push. Otherwise the additive-sleeve space on this data is")
    print("also exhausted and 1.90 stands.")
    print("=" * 100)


if __name__ == "__main__":
    main()

