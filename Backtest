"""Honest backtest of the original VPIN script's strategy on REAL MES trades.

Thesis (decoded from the user's script): VPIN = |buy-sell|/vol per volume bucket; go LONG
when VPIN z-score < -1 ("clean flow"), target +2 ticks. The original assumed every signal
= guaranteed +$1.71 (commission-only cost, no spread). Here we run it for real: enter long
at the next trade, exit on a +2/-2 tick bracket or a time stop, and charge the MEASURED
MES round-trip cost. We report it under the script's fantasy cost AND the real cost.

    PYTHONPATH=. python3 research/vpin_mes.py
"""
from __future__ import annotations

import glob

import numpy as np
import pandas as pd
import databento as db

from research.l3_book_alpha import _codes

TICK, POINT = 0.25, 5.0            # MES: 0.25 pt tick, $5/pt -> $1.25/tick
TARGET_TK, STOP_TK = 2, 2          # +2 / -2 tick bracket (script targeted +2)
TIMEOUT_S = 120                    # time stop (seconds)
BUCKET = 500                       # VPIN volume bucket (contracts), per original
ZWIN = 50                          # rolling buckets for the z-score
COMM_RT = 0.79                     # round-trip commission (user's broker, TradingView micros)
SPREAD_RT = 1.29                   # round-trip spread CROSSED, measured from L3 (~1.04 ticks)
N_DAYS = 5


def load_mes_trades(path):
    arr = db.DBNStore.from_file(path).to_ndarray()
    action = _codes(arr["action"]); iid = arr["instrument_id"]
    ts = arr["ts_event"].astype("int64")
    front = np.bincount(iid).argmax()
    day = ts // 86_400_000_000_000
    target = np.bincount(day - day.min()).argmax() + day.min()
    m = (action == ord("T")) & (iid == front) & (day == target)
    a = arr[m]
    df = pd.DataFrame({"price": a["price"].astype(np.float64) / 1e9,
                       "size": a["size"].astype(np.int64)},
                      index=pd.to_datetime(a["ts_event"].astype("int64")))
    df = df.between_time("13:30", "20:00")
    tick = np.sign(df["price"].diff()).replace(0, np.nan).ffill().fillna(0)
    df["signed"] = tick * df["size"]                  # +buy / -sell by tick rule
    return df


def vpin_signals(df):
    """Return integer row positions where VPIN z-score < -1 (the long signal)."""
    cum = df["size"].cumsum()
    bucket = (cum // BUCKET).to_numpy()
    g = pd.DataFrame({"b": df["signed"].clip(lower=0), "s": (-df["signed"]).clip(lower=0),
                      "v": df["size"], "bk": bucket})
    agg = g.groupby("bk").agg(b=("b", "sum"), s=("s", "sum"), v=("v", "sum"))
    agg["vpin"] = (agg["b"] - agg["s"]).abs() / agg["v"].replace(0, np.nan)
    z = (agg["vpin"] - agg["vpin"].rolling(ZWIN).mean()) / agg["vpin"].rolling(ZWIN).std()
    hot = set(agg.index[z < -1.0])                    # buckets flagged "clean flow"
    # signal fires on the FIRST row of each flagged bucket (causal entry next row)
    first_rows = pd.Series(np.arange(len(df))).groupby(bucket).first()
    return [int(first_rows[bk]) for bk in hot if bk in first_rows.index]


def bracket(price, ts, start):
    """From row `start`, enter long at next trade; exit on +2/-2 tick or time stop.
    Returns (gross_$ per contract, exit_row)."""
    i = start + 1
    if i >= len(price):
        return None
    entry = price[i]
    tp, sl = entry + TARGET_TK * TICK, entry - STOP_TK * TICK
    deadline = ts[i] + TIMEOUT_S * 1_000_000_000
    j = i + 1
    while j < len(price):
        if price[j] >= tp:
            return (TARGET_TK * TICK) * POINT, j
        if price[j] <= sl:
            return (-STOP_TK * TICK) * POINT, j
        if ts[j] >= deadline:
            return (price[j] - entry) * POINT, j
        j += 1
    return (price[-1] - entry) * POINT, len(price) - 1


def main():
    files = sorted(glob.glob("data/mbo/GLBX-20260607-8MCA89KCJQ/*.mbo.dbn.zst"))[-N_DAYS:]
    gpc = []                                           # gross $ per contract, per trade
    for f in files:
        df = load_mes_trades(f)
        price = df["price"].to_numpy(); ts = df.index.values.astype("int64")
        last_exit = -1
        for r in sorted(vpin_signals(df)):
            if r <= last_exit:
                continue                               # no overlapping trades
            out = bracket(price, ts, r)
            if out:
                gpc.append(out[0]); last_exit = out[1]
    g = np.array(gpc)
    n = len(g)
    print(f"sessions: {len(files)} | VPIN long signals taken: {n}\n")
    if n == 0:
        return
    wins = g > 0
    print(f"win rate (gross +2/-2 bracket): {wins.mean()*100:.1f}%   "
          f"(non-directional signal -> expect ~50%)")
    print(f"avg gross $/trade: {g.mean():+.3f}  (target win=+$2.50, stop loss=-$2.50)\n")
    for label, c in [
        (f"script's assumption: commission only ${COMM_RT:.2f}, spread IGNORED", COMM_RT),
        (f"reality: ${COMM_RT:.2f} commission + ${SPREAD_RT:.2f} spread crossed "
         f"= ${COMM_RT+SPREAD_RT:.2f}", COMM_RT + SPREAD_RT)]:
        net = g - c
        tot = net.sum()
        print(f"{label}:")
        print(f"   net $/trade {net.mean():+.3f} | total over {n} trades {tot:+.2f} | "
              f"end equity from $1000 = ${1000+tot:.2f}")


if __name__ == "__main__":
    main()

