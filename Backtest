"""
Deployable futures TREND signal + DISCRETE-contract sizing (master-prompt compliant:
real micros, real margin, integer contracts, vol-target, drawdown-halt). Shows what each
account size actually produces -- exposing the contract-granularity wall on small accounts.

Basket -> micros: ES->MES, NQ->MNQ, GC->MGC, CL->MCL, 6E->M6E (liquid, ~uncorrelated sectors).

    python3 build_futures_trend.py
"""
from __future__ import annotations
import numpy as np
import pandas as pd

PANEL = "/Users/kaveh/mim_research/futures_panel.parquet"
ANN, TVOL = 252, 0.15
HALT_DD, RESUME_DD = 0.30, 0.20
# micro: (root, multiplier $/pt, overnight margin $, round-turn cost $)
MICRO = {"MES": ("ES", 5, 1400, 1.5), "MNQ": ("NQ", 2, 2400, 1.5),
         "MGC": ("GC", 10, 1100, 1.5), "MCL": ("CL", 100, 1300, 2.0),
         "M6E": ("6E", 12500, 300, 1.5)}


def main():
    p = pd.read_parquet(PANEL)
    F = p.pivot_table(index="date", columns="root", values="fret").sort_index()
    C = p.pivot_table(index="date", columns="root", values="fclose").reindex(F.index).ffill()
    roots = [v[0] for v in MICRO.values()]
    F, C = F[roots], C[roots]
    AV = (F.rolling(63).std() * np.sqrt(ANN)).shift(1)
    P = (1 + F.fillna(0)).cumprod()
    z = sum((P / P.shift(L) - 1) / (AV * np.sqrt(L / ANN)) for L in (63, 126, 252)) / 3
    sign = np.sign(z).shift(1).fillna(0)                       # lagged direction, no lookahead

    micros = list(MICRO)
    mult = np.array([MICRO[m][1] for m in micros])
    marg = np.array([MICRO[m][2] for m in micros])
    cost = np.array([MICRO[m][3] for m in micros])

    # per-contract daily $ P&L and its rolling vol (lagged)
    dpnl1 = pd.DataFrame({MICRO[m][0]: F[MICRO[m][0]] * mult[i] * C[MICRO[m][0]]
                          for i, m in enumerate(micros)})
    dvol1 = dpnl1.rolling(63).std().shift(1)

    print("Per-1-contract annualized $ vol (latest) -- the granularity unit:")
    for i, m in enumerate(micros):
        print(f"  {m}: ${dvol1[MICRO[m][0]].iloc[-1]*np.sqrt(ANN):,.0f}/yr  (margin ${marg[i]:,})")

    def run(equity0):
        eq = equity0; hwm = equity0; halted = False
        held = np.zeros(len(micros)); curve = []
        idx = F.index
        for t in range(260, len(idx)):
            d = idx[t]
            dd = eq / hwm - 1
            if dd <= -HALT_DD:
                halted = True
            if halted and dd >= -RESUME_DD:
                halted = False
            sgn = sign.loc[d].values
            dv = dvol1.loc[d].values
            if halted or np.isnan(dv).all():
                tgt = np.zeros(len(micros))
            else:
                active = (sgn != 0) & np.isfinite(dv) & (dv > 0)
                na = max(active.sum(), 1)
                budget = (TVOL * eq / np.sqrt(ANN)) / np.sqrt(na)   # risk-parity vol budget/mkt
                tgt = np.where(active, np.round(budget / dv) * sgn, 0.0)
            # margin cap (keep 20% buffer)
            need = np.sum(np.abs(tgt) * marg)
            if need > 0.8 * eq:
                tgt = np.floor(tgt * (0.8 * eq / need))
            # P&L from positions held into today
            pnl = np.nansum(held * (F.loc[d, [MICRO[m][0] for m in micros]].values * mult * C.loc[d, [MICRO[m][0] for m in micros]].values))
            trade = np.abs(tgt - held)
            pnl -= np.sum(trade * cost)
            eq += pnl
            hwm = max(hwm, eq)
            held = tgt
            curve.append((d, eq, np.abs(held).sum()))
        cu = pd.DataFrame(curve, columns=["date", "eq", "ncon"]).set_index("date")
        r = cu["eq"].pct_change().dropna()
        yrs = len(r) / ANN
        cagr = (cu["eq"].iloc[-1] / equity0) ** (1 / yrs) - 1
        vol = r.std() * np.sqrt(ANN)
        dd = (cu["eq"] / cu["eq"].cummax() - 1).min()
        sh = r.mean() / r.std() * np.sqrt(ANN) if r.std() > 0 else 0
        return cagr, vol, dd, sh, cu["ncon"].mean()

    print(f"\nDiscrete-contract trend, target {TVOL*100:.0f}% vol, DD-halt at {HALT_DD*100:.0f}%:")
    print(f"  {'account':>9} {'realizedVol':>11} {'CAGR':>7} {'maxDD':>7} {'Sharpe':>6} {'avg #con':>8}")
    for e0 in (5_000, 10_000, 25_000, 50_000, 100_000):
        cagr, vol, dd, sh, nc = run(e0)
        flag = "  <- ~hits 15% vol" if 0.12 < vol < 0.19 else ("  <- WAY over target" if vol > 0.30 else "")
        print(f"  ${e0:>8,} {vol*100:10.0f}% {cagr*100:6.1f}% {dd*100:6.0f}% {sh:6.2f} {nc:7.1f}{flag}")

    # live sizing today
    print("\nLIVE sizing at $50k (today's signals):")
    d = F.index[-1]
    eq = 50_000
    for i, m in enumerate(micros):
        s = sign.loc[d].values[i]; dv = dvol1.loc[d].values[i]
        n = int(np.round((TVOL * eq / np.sqrt(ANN)) / np.sqrt((sign.loc[d].values != 0).sum()) / dv)) if dv > 0 and s != 0 else 0
        print(f"  {m}: {'LONG' if s>0 else 'SHORT' if s<0 else 'flat'} {abs(n)*int(s!=0)} contract(s)")


if __name__ == "__main__":
    main()

