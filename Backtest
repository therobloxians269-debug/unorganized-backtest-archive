BARS = 78; EOD = 77
COST = 2 * 0.625 + 1.24 / 5.0
FLOOR = 5.0
EMA_N = 20; ER_N = 24; ATR_N = 24

# ------------------------- tape generator -------------------------
def gen_days(n_days, planted, seed):
    """Self-test worlds. PLANTED: classifiable regimes + one conditional alpha per
