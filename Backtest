#!/usr/bin/env python3
"""SIGMABLOCK — PING PONG. Two blocks, trade from one to the other.

The spec, exactly:
  · two rejection blocks per session — the session LOW block and the session HIGH
    block, each anchored on its exact tick and confirmed at `--confirm` minutes
  · ENTRY  price touches a block's near edge
  · STOP   just beyond that block's TICK (tight — the block is the risk)
  · TARGET the OPPOSITE block's near edge
  · GATE   only taken if R:R >= --rr  (known before entry, so it costs nothing)
  · on a trend day the pullback block is the one price comes back to, and it
    targets the block on the other side — same rule, no special case needed
  · flat -> re-arm -> the other side can fire. That is the ping pong.

No look-ahead anywhere. The race starts on the bar AFTER entry. A bar that spans
both target and stop counts as a LOSS. Placebo displaces both blocks by --placebo
x ATR, keeping the same geometry.

    python3 pingpong.py
    python3 pingpong.py --rr 3 --confirm 60
    python3 pingpong.py --bars ~/qt_cascade/mnq_v6.parquet
"""
from __future__ import annotations

import argparse

import numpy as np
import pandas as pd

import sigmablock as S

BUF = S.TICK * 4


def session_trades(d: pd.DataFrame, confirm_min: int, rr_min: float, shift: float, tgt_frac: float = 0.5):
    """Every ping-pong trade in one session, in order, no overlap."""
    open_t = d.index[0].replace(hour=9, minute=30, second=0, microsecond=0)
    mins = (d.index - open_t).total_seconds() / 60.0
    arm = int(np.searchsorted(mins, confirm_min))
    if arm >= len(d) - 4:
        return []
    sub = d.iloc[:arm + 1]
    if float(sub["dev"].iloc[-1]) == 0:
        return []

    # the two blocks, fixed once at confirm time
    li = sub["low"].idxmin()
    hi = sub["high"].idxmax()
    lo_bot, lo_top = S.bounds(sub.loc[li], True)      # bullish block, tick = lo_bot
    hi_bot, hi_top = S.bounds(sub.loc[hi], False)     # bearish block, tick = hi_top
    lo_bot += shift; lo_top += shift
    hi_bot += shift; hi_top += shift
    if hi_bot <= lo_top:                              # blocks overlap — no room
        return []

    fwd = d.iloc[arm + 1:]
    H = fwd["high"].to_numpy(); L = fwd["low"].to_numpy()
    n = len(H)
    gap = hi_bot - lo_top
    out = []
    # each block fires ONCE. Without this the block re-arms after every stop-out and
    # the same level is re-entered all session — it faked 18.78 trades/day.
    done = {"L": False, "S": False}
    i = 0
    while i < n:
        side = None
        if not done["L"] and L[i] <= lo_top:
            side = "L"
        elif not done["S"] and H[i] >= hi_bot:
            side = "S"
        if side is None:
            i += 1
            continue
        done[side] = True
        long = side == "L"
        if long:
            e, sp, tg = lo_top, lo_bot - BUF, lo_top + tgt_frac * gap
        else:
            e, sp, tg = hi_bot, hi_top + BUF, hi_bot - tgt_frac * gap
        risk = abs(e - sp); rew = abs(tg - e)
        if risk <= 0 or rew / risk < rr_min:
            i += 1
            continue
        r = 0
        j = i + 1
        while j < n:
            hs = (L[j] <= sp) if long else (H[j] >= sp)
            ht = (H[j] >= tg) if long else (L[j] <= tg)
            if hs:
                r = -1
                break
            if ht:
                r = 1
                break
            j += 1
        out.append({"side": side, "r": r, "risk": risk, "rew": rew, "rr": rew / risk})
        i += 1
    return out


def run(df, tf, confirm, rr_min, shift_atr, label, tgt_frac=0.5):
    bars = S.to_tf(df, tf, "clv")
    rows = []
    for day in sorted(set(bars.index.date)):
        d = S.session_frame(bars[bars.index.date == day])
        if d.empty or len(d) < S.EXT_LEN:
            continue
        atr = (d["high"] - d["low"]).rolling(14, min_periods=3).mean().shift(1).bfill()
        a = float(atr.iloc[min(len(atr) - 1, 12)])
        sh = shift_atr * a if np.isfinite(a) else 0.0
        for t in session_trades(d, confirm, rr_min, sh, tgt_frac):
            t["day"] = day
            rows.append(t)
    T = pd.DataFrame(rows)
    if T.empty:
        print(f"  {label:<30} no trades")
        return None
    res = T[T["r"] != 0]
    if len(res) < 20:
        print(f"  {label:<30} n={len(res)} — too few to judge")
        return None
    wr = (res["r"] > 0).mean()
    mrr = res["rr"].median()
    # expectancy in POINTS, using each trade's own risk/reward
    pts = np.where(res["r"] > 0, res["rew"], -res["risk"]).mean()
    be = 1 / (1 + mrr)
    print(f"  {label:<30} n={len(res):<5} WR {100 * wr:5.1f}%  breakeven {100 * be:5.1f}%"
          f"  median RR {mrr:5.1f}  EV {pts:+7.2f} pts  ({len(res) / len(set(T['day'])):.2f}/day)")
    return dict(n=len(res), wr=wr, be=be, ev=pts, rr=mrr)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--bars", default="/Users/kaveh/qt_cascade/nq_v6.parquet")
    ap.add_argument("--tf", type=int, default=5)
    ap.add_argument("--confirm", type=int, default=60)
    ap.add_argument("--rr", type=float, default=3.0)
    ap.add_argument("--placebo", type=float, default=1.5)
    ap.add_argument("--tgt", type=float, default=0.5, help="target as a fraction of the block-to-block gap")
    a = ap.parse_args()

    df = pd.read_parquet(a.bars)[["o", "h", "l", "c", "v"]]
    df.columns = ["open", "high", "low", "close", "volume"]
    df.index = df.index.tz_convert("America/New_York")

    print(f"\nPING PONG — block to block, R:R >= {a.rr}, confirm {a.confirm}min, tf {a.tf}m")
    print(f"{a.bars.split('/')[-1]}   {df.index.min().date()} -> {df.index.max().date()}\n")
    run(df, a.tf, a.confirm, a.rr, 0.0, "REAL blocks", a.tgt)
    run(df, a.tf, a.confirm, a.rr, a.placebo, f"PLACEBO (+{a.placebo}xATR)", a.tgt)
    print()


if __name__ == "__main__":
    main()

