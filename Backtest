# ============================================================================ engine
@njit(cache=True)
def _sim(sig_i, sig_d, sig_risk, flat, o, h, l, c,
         rr, trail_type, trail_p, trail_arr_lo, trail_arr_hi, atr_e,
         be_at, timeout, slip, pv, comm, max_per_day, day, cooldown):
    """Sequential single-position simulator. Returns per-signal outcome arrays.
    trail_type: 0 none, 1 chandelier(k*atr_at_entry), 2 donchian(prev trail_p bar extreme)
    rr <= 0  -> no fixed target
    timeout  -> max bars held (0 = none)
    """
    m = len(sig_i)
    ei = np.full(m, -1, np.int64)     # entry bar
    xi = np.full(m, -1, np.int64)     # exit bar
    epx = np.zeros(m)
    xpx = np.zeros(m)
    netR = np.zeros(m)
    netD = np.zeros(m)
    riskp = np.zeros(m)
    mfeR = np.zeros(m)
    maeR = np.zeros(m)
    reason = np.full(m, -1, np.int8)  # 0 stop, 1 target, 2 trail, 3 flat/time
    taken = np.zeros(m, np.int8)

    busy_until = -1
    cool_until = -1
    cur_day = -1
    n_today = 0

    for s in range(m):
        i0 = sig_i[s]
        if i0 <= busy_until or i0 < cool_until:
            continue
        if day[i0] != cur_day:
            cur_day = day[i0]
            n_today = 0
        if max_per_day > 0 and n_today >= max_per_day:
            continue
        fi = flat[i0]
        if fi <= i0:
            continue
        r = sig_risk[s]
        if not (r > 0.0) or np.isnan(r):
            continue
        dd = sig_d[s]
        entry = o[i0] + slip * dd
        stop = entry - dd * r
        targ = entry + dd * r * rr if rr > 0 else 0.0
        run_ext = entry
        ex = -1
        xp = 0.0
        why = 3
        mx = 0.0
        mn = 0.0
        last = fi
        if timeout > 0 and i0 + timeout < last:
            last = i0 + timeout
        for t in range(i0, last + 1):
            # favourable / adverse excursion (in points, signed by direction)
            fav = (h[t] - entry) * dd if dd > 0 else (entry - l[t]) * -dd * -1.0
            if dd > 0:
                fav = h[t] - entry
                adv = entry - l[t]
            else:
                fav = entry - l[t]
                adv = h[t] - entry
            if fav > mx:
                mx = fav
            if adv > mn:
                mn = adv
            # 1) stop first (stop-before-target rule)
            if dd > 0:
                hit_stop = l[t] <= stop
            else:
                hit_stop = h[t] >= stop
            if hit_stop:
                ex = t
                xp = stop - dd * slip
                why = 2 if trail_type > 0 or be_at > 0 else 0
                if abs(stop - (entry - dd * r)) < 1e-9:
                    why = 0
                break
            # 2) target
            if rr > 0:
                if dd > 0:
                    hit_t = h[t] >= targ
                else:
                    hit_t = l[t] <= targ
                if hit_t:
                    ex = t
                    xp = targ
                    why = 1
                    break
            # 3) hard flatten / timeout
            if t == last:
                ex = t
                xp = c[t]
                why = 3
                break
            # 4) update trail using this bar
            if dd > 0:
                if h[t] > run_ext:
                    run_ext = h[t]
            else:
                if l[t] < run_ext:
                    run_ext = l[t]
            newstop = stop
            if trail_type == 1:
                cand = run_ext - dd * trail_p * atr_e[s]
                if dd > 0:
                    if cand > newstop:
                        newstop = cand
                else:
                    if cand < newstop:
                        newstop = cand
            elif trail_type == 2:
                if dd > 0:
                    cand = trail_arr_lo[t]
                    if cand > newstop and cand < c[t]:
                        newstop = cand
                else:
                    cand = trail_arr_hi[t]
                    if cand < newstop and cand > c[t]:
                        newstop = cand
            if be_at > 0.0 and mx >= be_at * r:
                if dd > 0:
                    if entry > newstop:
                        newstop = entry
                else:
                    if entry < newstop:
                        newstop = entry
            stop = newstop

        if ex < 0:
            continue
        gross = (xp - entry) * dd * pv
        net = gross - comm
        ei[s] = i0
        xi[s] = ex
        epx[s] = entry
        xpx[s] = xp
        riskp[s] = r
        netD[s] = net
        netR[s] = net / (r * pv)
        mfeR[s] = mx / r
        maeR[s] = mn / r
        reason[s] = why
        taken[s] = 1
        busy_until = ex
        cool_until = ex + cooldown
        n_today += 1
    return ei, xi, epx, xpx, riskp, netD, netR, mfeR, maeR, reason, taken


def rollmax(a, w):
    return pd.Series(a).rolling(w, min_periods=w).max().to_numpy(np.float64)

def rollmin(a, w):
    return pd.Series(a).rolling(w, min_periods=w).min().to_numpy(np.float64)


_TRAILC = {}
def trail_arrays(d, p):
    k = (id(d), p)
    if k not in _TRAILC:
        lo = pd.Series(d["l"]).rolling(p, min_periods=p).min().shift(1).to_numpy(np.float64)
        hi = pd.Series(d["h"]).rolling(p, min_periods=p).max().shift(1).to_numpy(np.float64)
        lo = np.nan_to_num(lo, nan=-1e12)
        hi = np.nan_to_num(hi, nan=1e12)
        _TRAILC[k] = (lo, hi)
    return _TRAILC[k]


def run(d, sig_i, sig_d, risk, cfg):
    """cfg keys: rr, trail(0/1/2), trail_p, be, timeout, max_per_day, cooldown"""
    cost = COST[d["name"]]
    tt = cfg.get("trail", 0)
    tp = float(cfg.get("trail_p", 0))
    if tt == 2:
        lo, hi = trail_arrays(d, int(tp))
    else:
        lo = np.zeros(1); hi = np.zeros(1)
        lo = np.full(d["n"], -1e12); hi = np.full(d["n"], 1e12)
    atr_e = d[f"atr{cfg.get('trail_atr', 30)}"][sig_i] if tt == 1 else np.zeros(len(sig_i))
    atr_e = np.nan_to_num(atr_e, nan=0.0)
    res = _sim(sig_i.astype(np.int64), sig_d.astype(np.float64), risk.astype(np.float64),
               d["flat"], d["o"], d["h"], d["l"], d["c"],
               float(cfg.get("rr", 0.0)), int(tt), tp, lo, hi, atr_e,
               float(cfg.get("be", 0.0)), int(cfg.get("timeout", 0)),
               cost["slip"], cost["pv"], cost["comm"],
               int(cfg.get("max_per_day", 0)), d["day"], int(cfg.get("cooldown", 0)))
    ei, xi, epx, xpx, riskp, netD, netR, mfeR, maeR, reason, taken = res
    k = taken == 1
    tr = pd.DataFrame(dict(
        ei=ei[k], xi=xi[k], entry=epx[k], exit=xpx[k], risk=riskp[k],
        netD=netD[k], netR=netR[k], mfeR=mfeR[k], maeR=maeR[k], reason=reason[k]))
    if len(tr):
        tr["ts"] = d["df"].index[tr.ei.to_numpy()]
        tr["day"] = d["day"][tr.ei.to_numpy()]
        tr["dir"] = sig_d[k]
    return tr


def stats(tr, d, label=""):
    ndays = len(np.unique(d["day"]))
    if len(tr) == 0:
        return dict(label=label, n=0, tpd=0.0, avgR=0.0, dpt=0.0, wr=0.0,
                    tot=0.0, maxdd=0.0, drop3=0.0, mfe_med=0.0, pf=0.0, t=0.0)
    eq = tr.sort_values("ei")["netD"].cumsum().to_numpy()
    peak = np.maximum.accumulate(np.concatenate([[0.0], eq]))
    dd = (np.concatenate([[0.0], eq]) - peak).min()
    r = tr["netR"].to_numpy()
    drop3 = np.sort(r)[:-3].mean() if len(r) > 3 else float("nan")
    wins = tr.netD[tr.netD > 0].sum()
    loss = -tr.netD[tr.netD <= 0].sum()
    se = r.std(ddof=1) / math.sqrt(len(r)) if len(r) > 1 else np.nan
    return dict(label=label, n=int(len(tr)), tpd=len(tr) / ndays,
                avgR=float(r.mean()), dpt=float(tr.netD.mean()),
                wr=float((tr.netD > 0).mean()), tot=float(tr.netD.sum()),
                maxdd=float(dd), drop3=float(drop3),
                mfe_med=float(tr.mfeR.median()),
                pf=float(wins / loss) if loss > 0 else float("inf"),
                t=float(r.mean() / se) if se and se > 0 else 0.0)


def fmt(s):
    return (f"{s['label']:<34s} n={s['n']:5d} tpd={s['tpd']:.2f} avgR={s['avgR']:+.4f} "
            f"$/tr={s['dpt']:+8.2f} wr={s['wr']*100:5.1f}% tot=${s['tot']:+9.0f} "
            f"dd=${s['maxdd']:+8.0f} d3R={s['drop3']:+.4f} t={s['t']:+.2f}")


# ============================================================================ signals
def risk_vec(d, idx, cfg):
    mode = cfg.get("risk_mode", "atr")
    if mode == "atr":
        a = d[f"atr{cfg.get('atr_w',30)}"][idx]
        r = cfg["risk_k"] * a
    else:
        r = cfg["risk_k"] * d["dayrange"][idx]
    lo = cfg.get("rmin", 8.0)
    hi = cfg.get("rmax", 400.0)
    return np.clip(r, lo, hi)


def window_mask(d, cfg):
    tod = d["tod"]
    a, b = cfg.get("win", (570, 955))
    if a <= b:
        return (tod >= a) & (tod <= b)
    return (tod >= a) | (tod <= b)


def sig_donch(d, cfg):
    lb = cfg["lb"]
    hi = pd.Series(d["h"]).rolling(lb, min_periods=lb).max().shift(1).to_numpy()
    lo = pd.Series(d["l"]).rolling(lb, min_periods=lb).min().shift(1).to_numpy()
    c = d["c"]
    up = c > hi
    dn = c < lo
    fresh = cfg.get("fresh", True)
    if fresh:
        up = up & ~np.concatenate([[False], up[:-1]])
        dn = dn & ~np.concatenate([[False], dn[:-1]])
    w = window_mask(d, cfg)
    up &= w; dn &= w
    # entry is NEXT bar open -> shift index by 1
    iu = np.where(up)[0] + 1
    idn = np.where(dn)[0] + 1
    n = d["n"]
    iu = iu[iu < n]; idn = idn[idn < n]
    idx = np.concatenate([iu, idn])
    dr = np.concatenate([np.ones(len(iu)), -np.ones(len(idn))])
    o = np.argsort(idx, kind="stable")
    return idx[o], dr[o]


def tf_frame(d, tf):
    """causal resampled bars; each tf bar's features become valid on the 1-min bar AFTER close"""
    key = f"_tf{tf}"
    if key in d:
        return d[key]
    df = d["df"]
    r = df.resample(f"{tf}min", label="left", closed="left").agg(
        {"o": "first", "h": "max", "l": "min", "c": "last"}).dropna()
    d[key] = r
    return r


def _tf_to_min(d, s, tf):
    """map a tf-indexed series to 1-min index, valid from the bar AFTER the tf bar closes."""
    s2 = s.shift(1)                       # value of the previous closed tf bar
    return s2.reindex(d["df"].index, method="ffill")


def sig_pullback(d, cfg):
    tf = cfg["tf"]
    r = tf_frame(d, tf)
    ef = r["c"].ewm(span=cfg["ef"], adjust=False).mean()
    es = r["c"].ewm(span=cfg["es"], adjust=False).mean()
    slope = es.diff(cfg.get("slope_n", 3))
    up_tr = (ef > es) & (slope > 0)
    dn_tr = (ef < es) & (slope < 0)
    # pullback: bar dips to/through fast MA but closes back on the trend side
    trig_up = up_tr & (r["l"] <= ef) & (r["c"] > ef)
    trig_dn = dn_tr & (r["h"] >= ef) & (r["c"] < ef)
    if cfg.get("need_close_gt_open", False):
        trig_up &= (r["c"] > r["o"])
        trig_dn &= (r["c"] < r["o"])
    su = _tf_to_min(d, trig_up.astype(float), tf).fillna(0).to_numpy() > 0.5
    sd = _tf_to_min(d, trig_dn.astype(float), tf).fillna(0).to_numpy() > 0.5
    # only the FIRST 1-min bar carrying a new tf signal fires
    su = su & ~np.concatenate([[False], su[:-1]])
    sd = sd & ~np.concatenate([[False], sd[:-1]])
    w = window_mask(d, cfg)
    su &= w; sd &= w
    iu = np.where(su)[0]; idn = np.where(sd)[0]
    idx = np.concatenate([iu, idn])
    dr = np.concatenate([np.ones(len(iu)), -np.ones(len(idn))])
    o = np.argsort(idx, kind="stable")
    return idx[o], dr[o]


def sig_tsmom(d, cfg):
    N = cfg["N"]
    c = pd.Series(d["c"])
    ret = (c - c.shift(N)).to_numpy()
    a = d[f"atr{cfg.get('atr_w',30)}"]
    thr = cfg["k"] * a * math.sqrt(N / 30.0)
    up = ret > thr
    dn = ret < -thr
    up = up & ~np.concatenate([[False], up[:-1]])
    dn = dn & ~np.concatenate([[False], dn[:-1]])
    w = window_mask(d, cfg)
    up &= w; dn &= w
    iu = np.where(up)[0] + 1; idn = np.where(dn)[0] + 1
    n = d["n"]
    iu = iu[iu < n]; idn = idn[idn < n]
    idx = np.concatenate([iu, idn])
    dr = np.concatenate([np.ones(len(iu)), -np.ones(len(idn))])
    o = np.argsort(idx, kind="stable")
    return idx[o], dr[o]


# ------------------------------------------------------------------ opening-drive gate
def drive_table(d, or_end=600):
    """per daycycle: 09:30 open, OR high/low over 09:30..or_end, drive dir & strength.
    All measured by or_end so usable from or_end onward."""
    key = f"_drive{or_end}"
    if key in d:
        return d[key]
    tod = d["tod"]
    m = (tod >= 570) & (tod < or_end)
    df = pd.DataFrame(dict(day=d["day"], o=d["o"], h=d["h"], l=d["l"], c=d["c"]))[m]
    g = df.groupby("day")
    t = pd.DataFrame(dict(op=g["o"].first(), hi=g["h"].max(), lo=g["l"].min(), cl=g["c"].last()))
    t["rng"] = t.hi - t.lo
    t["net"] = t.cl - t.op
    t["er"] = t.net.abs() / t.rng.replace(0, np.nan)
    t["pos"] = (t.cl - t.lo) / t.rng.replace(0, np.nan)   # close position in OR
    d[key] = t
    return t


def apply_drive_gate(d, idx, dr, cfg):
    or_end = cfg.get("or_end", 600)
    t = drive_table(d, or_end)
    mode = cfg.get("gate", "drive")
    day = d["day"][idx]
    er = t["er"].reindex(day).to_numpy()
    net = t["net"].reindex(day).to_numpy()
    pos = t["pos"].reindex(day).to_numpy()
    hi = t["hi"].reindex(day).to_numpy()
    lo = t["lo"].reindex(day).to_numpy()
    thr = cfg.get("gate_thr", 0.5)
    keep = np.ones(len(idx), bool)
    keep &= d["tod"][idx] >= or_end                      # only after the OR window
    if mode == "drive":
        gd = np.sign(net)
        keep &= (er >= thr) & (dr == gd)
    elif mode == "drive_pos":
        gd = np.where(pos >= 1 - thr, 1.0, np.where(pos <= thr, -1.0, 0.0))
        keep &= (dr == gd)
    elif mode == "orbreak":
        # direction must agree with which side of the opening range price is on
        px = d["c"][idx]
        gd = np.where(px > hi, 1.0, np.where(px < lo, -1.0, 0.0))
        keep &= (dr == gd)
    return idx[keep], dr[keep]


FAMS = {"D": sig_donch, "P": sig_pullback, "T": sig_tsmom}

def build(d, cfg):
    idx, dr = FAMS[cfg["fam"]](d, cfg)
    if cfg.get("gate"):
        idx, dr = apply_drive_gate(d, idx, dr, cfg)
    if len(idx) == 0:
        return idx, dr, np.zeros(0)
    risk = risk_vec(d, idx, cfg)
    ok = np.isfinite(risk) & (risk > 0)
    return idx[ok], dr[ok], risk[ok]


def backtest(d, cfg):
    idx, dr, risk = build(d, cfg)
    if len(idx) == 0:
        return pd.DataFrame()
    return run(d, idx, dr, risk, cfg)


# ============================================================================ placebo
def placebo(d, cfg, seeds=8, per_trade=False):
    """Rebuild the same entries at randomly shifted timestamps (offset U[120,1440] bars),
    same direction and same stop/target logic (risk recomputed by the same rule at the new bar)."""
    idx, dr, _ = build(d, cfg)
    if len(idx) == 0:
        return []
    n = d["n"]
    out = []
    for s in range(seeds):
        rng = np.random.default_rng(1000 + s)
        if per_trade:
            off = rng.integers(120, 1441, size=len(idx))
        else:
            off = np.full(len(idx), rng.integers(120, 1441))
        j = idx + off
        keep = j < n - 1
        j = j[keep]; dj = dr[keep]
        if len(j) == 0:
            continue
        o = np.argsort(j, kind="stable")
        j = j[o]; dj = dj[o]
        risk = risk_vec(d, j, cfg)
        ok = np.isfinite(risk) & (risk > 0)
        j = j[ok]; dj = dj[ok]; risk = risk[ok]
        tr = run(d, j, dj, risk, cfg)
        out.append(stats(tr, d, f"placebo s{s}"))
    return out


# ============================================================================ stages
def stage_selftest():
    d = load("IS")
    print(f"IS bars={d['n']} daycycles={len(np.unique(d['day']))}")
    # 1. flatten integrity
    fl = d["flat"]
    bad = (d["tod"][fl[fl >= 0]] > 16 * 60 + 59).sum()
    print("T1 flatten bars after 16:59 :", bad, "(want 0)")
    # 2. cost check: a forced 1-bar trade must lose exactly comm + slip*2
    idx = np.array([5000]); dr = np.array([1.0]); risk = np.array([50.0])
    tr = run(d, idx, dr, risk, dict(rr=0, timeout=1))
    exp = (d["c"][5001] - (d["o"][5000] + 0.25)) * 20 - 4.0
    print(f"T2 pnl {tr.netD.iloc[0]:.4f} vs expected {exp:.4f}  diff={abs(tr.netD.iloc[0]-exp):.6f}")
    # 3. stop-before-target inside a bar
    # find a bar with a wide range, set tiny stop+target -> must resolve as stop
    rngs = d["h"] - d["l"]
    i = int(np.argmax(rngs[1000:2000])) + 1000
    tr = run(d, np.array([i]), np.array([1.0]), np.array([1.0]), dict(rr=1.0))
    print("T3 wide-bar tiny-bracket reason (0=stop expected):", int(tr.reason.iloc[0]),
          f" netR={tr.netR.iloc[0]:.3f}")
    # 4. causality of tf mapping
    r5 = tf_frame(d, 5)
    s = _tf_to_min(d, r5["c"], 5)
    df = d["df"]
    j = 3000
    ts = df.index[j]
    # the mapped value at 1-min bar ts must come from a 5m bar that CLOSED at or before ts
    v = s.iloc[j]
    cand = r5[r5["c"] == v]
    if len(cand):
        lbl = cand.index[-1]
        print(f"T4 at {ts} mapped 5m close from bar labelled {lbl} "
              f"(closes {lbl + pd.Timedelta(minutes=5)}) -> causal={lbl + pd.Timedelta(minutes=5) <= ts}")
    # 5. random-entry null should be ~0 after costs is impossible (costs bite) - check it is negative
    rs = np.random.default_rng(0)
    ii = np.sort(rs.choice(np.arange(500, d["n"] - 500), 4000, replace=False))
    dd = np.where(rs.random(4000) > .5, 1.0, -1.0)
    rk = np.clip(3.0 * d["atr30"][ii], 8, 400)
    tr = run(d, ii, dd, rk, dict(rr=2.0))
    print("T5 random-entry 1:2 null:", fmt(stats(tr, d, "rand-null")))
    print("    (must be negative by roughly the cost drag; a positive here = engine bias)")
    # 6. zero-cost random null should be ~0
    save = COST["NQ"].copy()
