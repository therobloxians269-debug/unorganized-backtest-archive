is_ph = np.zeros(n, bool); is_pl = np.zeros(n, bool)
for i in range(PVL, n - PVR):
    w = slice(i - PVL, i + PVR + 1)
    if h[i] == h[w].max() and (h[w] == h[i]).sum() == 1: is_ph[i] = True
    if l[i] == l[w].min() and (l[w] == l[i]).sum() == 1: is_pl[i] = True
