COT (Commitment of Traders) sleeve -- free CFTC positioning data, a NON-price alpha source.
Signal = COT index of net positioning (z-score vs trailing 3yr). Tests both a-priori
directions: follow-commercials (smart money / fade specs) vs follow-specs (positioning
momentum). Checks Sharpe, correlation to trend, and whether stacking lifts the program.

    python3 cot_sleeve.py
"""
from __future__ import annotations
import time
import numpy as np
import pandas as pd
import requests
from lib_perf import perf_stats

PANEL = "/Users/kaveh/mim_research/futures_panel.parquet"
CACHE = "/Users/kaveh/mim_research/cot_raw.parquet"
BASE = "https://publicreporting.cftc.gov/resource/6dca-aqww.json"
ANN = 252

# root -> (LIKE pattern, [exclude patterns])
COTMAP = {
    "ES": ("E-MINI S&P 500", ["MICRO"]),
    "NQ": ("NASDAQ 100", ["MICRO"]),
    "GC": ("GOLD", ["MICRO", "INDEX", "KILO"]),
    "SI": ("SILVER", ["MICRO", "1000", "MINI"]),
    "HG": ("COPPER", ["MICRO"]),
    "CL": ("CRUDE OIL, LIGHT", []),
    "NG": ("NATURAL GAS", ["E-MINI", "E-MINY", "ALBERTA", "PENULT", "FINL", "HENRY"]),
    "ZC": ("CORN", ["MINI", "SYRUP"]),
    "ZS": ("SOYBEANS", ["MINI"]),
    "6E": ("EURO FX", ["XRATE", "/"]),
    "6J": ("JAPANESE YEN", ["XRATE", "/", "EURO"]),
    "ZN": ("10-YEAR U.S. TREASURY NOTES", ["ULTRA"]),
    "ZF": ("5-YEAR U.S. TREASURY NOTES", []),
    "ZB": ("U.S. TREASURY BONDS", ["ULTRA"]),
}
COLS = ("report_date_as_yyyy_mm_dd,open_interest_all,comm_positions_long_all,"
        "comm_positions_short_all,noncomm_positions_long_all,noncomm_positions_short_all,"
        "market_and_exchange_names")


def fetch():
    import os
    if os.path.exists(CACHE):
        return pd.read_parquet(CACHE)
    parts = []
    for root, (like, excl) in COTMAP.items():
        where = f"market_and_exchange_names like '%{like}%' AND report_date_as_yyyy_mm_dd >= '2010-01-01'"
        for e in excl:
            where += f" AND market_and_exchange_names not like '%{e}%'"
        r = requests.get(BASE, params={"$select": COLS, "$where": where, "$limit": 5000}, timeout=30)
        d = pd.DataFrame(r.json())
        d["root"] = root
        parts.append(d)
        print(f"  {root}: {len(d)} weekly rows")
        time.sleep(0.1)
    df = pd.concat(parts, ignore_index=True)
    df["date"] = pd.to_datetime(df["report_date_as_yyyy_mm_dd"])     # parse BEFORE numeric coercion
    skip = ("market_and_exchange_names", "root", "report_date_as_yyyy_mm_dd", "date")
    for c in [c for c in df.columns if c not in skip]:
        df[c] = pd.to_numeric(df[c], errors="coerce")
    # per (root,date) keep the row with max OI (the main contract; handles renames/variants)
    df = df.sort_values("open_interest_all").groupby(["root", "date"]).tail(1)
    df.to_parquet(CACHE)
    return df


def signal_panel(df, kind):
    """kind='comm' -> follow commercials; 'spec' -> follow speculators. Returns weekly z panel."""
    df = df.copy()
    df["net_comm"] = (df["comm_positions_long_all"] - df["comm_positions_short_all"]) / df["open_interest_all"]
    df["net_spec"] = (df["noncomm_positions_long_all"] - df["noncomm_positions_short_all"]) / df["open_interest_all"]
    x = "net_comm" if kind == "comm" else "net_spec"
    df = df.sort_values(["root", "date"])
    g = df.groupby("root")[x]
    mu = g.transform(lambda s: s.rolling(156, min_periods=52).mean())
    sd = g.transform(lambda s: s.rolling(156, min_periods=52).std())
    df["z"] = (df[x] - mu) / sd
    return df.pivot_table(index="date", columns="root", values="z")


def build_sleeve(zw, F, AV):
    # weekly z -> daily, lag 5 business days (Tue report released Fri -> tradeable next wk)
    z = zw.reindex(F.index, method="ffill").shift(5)
    w = np.tanh(z) / AV
    w = w.div(w.abs().sum(axis=1).replace(0, np.nan), axis=0).fillna(0.0).clip(-0.2, 0.2)
    sc = (0.12 / ((w * F).sum(axis=1).rolling(63).std() * np.sqrt(ANN))).shift(1).clip(0, 3).fillna(0.0)
    w = w.mul(sc, axis=0)
    turn = w.diff().abs().sum(axis=1)
    return ((w * F).sum(axis=1) - turn * 3.0 * 1e-4).dropna(), turn.mean() * ANN


def sh(r):
    r = r.dropna(); return r.mean() / r.std() * np.sqrt(ANN) if len(r) > 20 and r.std() > 0 else np.nan


def main():
    df = fetch()
    p = pd.read_parquet(PANEL)
    F = p.pivot_table(index="date", columns="root", values="fret").sort_index()
    AV = (F.rolling(63).std() * np.sqrt(ANN)).shift(1)
    zw0 = signal_panel(df, "comm")
    cols = [str(c) for c in F.columns if str(c) in {str(x) for x in zw0.columns}]
    F, AV = F.reindex(columns=cols), AV.reindex(columns=cols)
    print(f"\nfutures {F.index[0].date()}->{F.index[-1].date()}, {len(cols)} markets with COT\n")

    trend = pd.read_parquet("/Users/kaveh/mim_research/trend_all.parquet")["net"]
    best = None
    for kind in ("comm", "spec"):
        zw = signal_panel(df, kind).reindex(columns=cols)
        net, turn = build_sleeve(zw, F, AV)
        oos = net[net.index >= "2018-01-01"]
        j = pd.concat([trend.rename("T"), net.rename("C")], axis=1).dropna()
        rho = j["T"].corr(j["C"])
        print(f"  COT-{kind:4s}: Sharpe {sh(net):+.2f} (OOS {sh(oos):+.2f}) | turn {turn:.0f}x "
              f"| CAGR {perf_stats(net,ANN)['cagr']*100:+.1f}% | corr-to-trend {rho:+.2f}")
        if kind == "comm":
            best = (net, j, rho)

    # stack the (a-priori) follow-commercials sleeve with trend
    net, j, rho = best
    uT = j["T"] / j["T"].std(); uC = j["C"] / j["C"].std()
    combo = (uT + uC) / 2
    print(f"\n  STACK trend+COT(comm): trend {sh(j['T']):+.2f} | COT {sh(j['C']):+.2f} | "
          f"COMBO {sh(combo):+.2f}  (corr {rho:+.2f})")
    if sh(combo) > sh(j["T"]):
        combo.to_frame("net").to_parquet("/Users/kaveh/mim_research/trend_cot_combo.parquet")
        print("  -> COT ADDS: combo beats trend; saved trend_cot_combo.parquet for Apex re-sim")
    else:
        print("  -> COT does not lift the combo")


if __name__ == "__main__":
    main()

