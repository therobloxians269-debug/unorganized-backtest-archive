"""Frozen trend engine -- the single source of truth for the tear sheet.

Multi-timescale (63/126/252) vol-normalized tanh time-series momentum, inverse-vol sized,
gross-exposure normalized, then portfolio vol-targeted. This is the validated edge
(diversified daily trend, Sharpe ~0.74 on the 16-ETF basket); the parameters are FROZEN --
no tuning from here, so the out-of-sample test stays honest.

    cfg = TrendConfig()                       # frozen defaults
    bt = backtest(prices, cfg, cost_bp=ETF_COST_BP)
    bt.net            # net daily returns      bt.weights   # vol-targeted weights
    trades = extract_trades(bt.weights, bt.rets, ETF_COST_BP)

Cost convention: `cost_bp` is the ONE-WAY cost in basis points charged on traded notional,
i.e. cost_t = sum_i |dw_{i,t}| * cost_bp_i * 1e-4. Accepts a scalar or a per-symbol mapping.
"""
from __future__ import annotations

from dataclasses import dataclass
from typing import Mapping, Union

import numpy as np
import pandas as pd

CostSpec = Union[float, Mapping[str, float]]

# --- the two tracks ---------------------------------------------------------
ETF_BASKET = ["SPY", "QQQ", "IWM", "EFA", "EEM", "TLT", "IEF", "LQD", "HYG", "EMB",
              "GLD", "SLV", "DBC", "USO", "VNQ", "UUP"]

# Realistic retail ETF one-way costs (bps): ~half-spread + slippage (most brokers $0 comm).
ETF_COST_BP = {"SPY": 0.3, "QQQ": 0.4, "IWM": 0.5, "EFA": 0.8, "EEM": 1.0, "TLT": 0.6,
               "IEF": 0.8, "LQD": 1.5, "HYG": 1.5, "EMB": 2.5, "GLD": 0.5, "SLV": 1.5,
               "DBC": 2.0, "USO": 2.0, "VNQ": 1.0, "UUP": 1.5}

# Futures-implementable subset: ETF proxy -> CME future (same underlying, tradeable today).
FUT_MAP = {"SPY": "MES", "QQQ": "MNQ", "IWM": "M2K", "TLT": "ZB", "IEF": "ZN", "GLD": "MGC"}

# Futures one-way costs (bps). SPY/MES is MEASURED from L3 MBO (0.66bp round-trip / 2);
# the rest are conservative estimates pending their own MBO study.
FUT_COST_BP = {"SPY": 0.33, "QQQ": 0.40, "IWM": 0.60, "TLT": 0.50, "IEF": 0.40, "GLD": 0.80}

ANN = 252.0


@dataclass(frozen=True)
class TrendConfig:
    """FROZEN strategy parameters. Changing these invalidates the out-of-sample claim."""
    looks: tuple = (63, 126, 252)     # momentum lookbacks (trading days)
    vol_window: int = 63              # realized-vol estimation window
    vol_target: float = 0.10          # annualized portfolio vol target
    scale_cap: float = 3.0            # max leverage from vol-targeting
    n_params: int = 5                 # honest free-parameter count (3 looks + vol_window + target)


@dataclass
class BacktestResult:
    net: pd.Series                    # net daily returns (after cost)
    gross: pd.Series                  # gross daily returns (before cost)
    weights: pd.DataFrame             # vol-targeted weights actually held
    turnover: pd.Series               # one-way turnover sum_i|dw_i| per day
    rets: pd.DataFrame                # per-asset daily returns (aligned)
    cost: pd.Series                   # daily cost drag


def _cost_per_asset(dw: pd.DataFrame, cost_bp: CostSpec) -> pd.DataFrame:
    """Per-asset daily cost as a fraction of notional: |dw| * cost_bp * 1e-4."""
    if isinstance(cost_bp, (int, float)):
        return dw * float(cost_bp) * 1e-4
    cb = pd.Series({c: float(cost_bp[c]) for c in dw.columns if c in cost_bp}, dtype=float)
    missing = [c for c in dw.columns if c not in cb.index]
    if missing:
        raise ValueError(f"cost_bp missing entries for: {missing}")
    return dw.mul(cb, axis=1) * 1e-4


def trend_weights(prices: pd.DataFrame, cfg: TrendConfig = TrendConfig()) -> pd.DataFrame:
    """Vol-targeted weights. Causal: every weight at t uses only data through t-1."""
    rets = prices.pct_change()
    av = (rets.rolling(cfg.vol_window).std() * np.sqrt(ANN)).shift(1)        # ann vol, lagged
    z = sum(prices.pct_change(L) / (av * np.sqrt(L / ANN)) for L in cfg.looks) / len(cfg.looks)
    w = np.tanh(z).shift(1) / av                                            # signal lagged 1 day
    w = w.div(w.abs().sum(axis=1).replace(0, np.nan), axis=0)               # gross-exposure = 1
    g = (w * rets).sum(axis=1)
    scale = (cfg.vol_target / (g.rolling(cfg.vol_window).std() * np.sqrt(ANN))
             ).shift(1).clip(0, cfg.scale_cap).fillna(0.0)
    return w.mul(scale, axis=0)


def backtest(prices: pd.DataFrame, cfg: TrendConfig = TrendConfig(),
             cost_bp: CostSpec = 1.0) -> BacktestResult:
    """Run the frozen trend strategy on a price panel; return net/gross/weights/turnover."""
    rets = prices.pct_change()
    w = trend_weights(prices, cfg)
    dw = w.diff().abs()
    cost_asset = _cost_per_asset(dw, cost_bp)
    cost = cost_asset.sum(axis=1)
    gross = (w * rets).sum(axis=1)
    net = (gross - cost).dropna()
    idx = net.index
    return BacktestResult(net=net, gross=gross.reindex(idx), weights=w.reindex(idx),
                          turnover=dw.sum(axis=1).reindex(idx), rets=rets.reindex(idx),
                          cost=cost.reindex(idx))


def extract_trades(weights: pd.DataFrame, rets: pd.DataFrame,
                   cost_bp: CostSpec = 0.0) -> pd.DataFrame:
    """Decompose continuous weights into discrete per-asset trades.

    A trade = a maximal run where an asset's weight keeps the same nonzero sign. Its P&L is
    the summed net contribution (w*ret - cost) over the run. Returns one row per trade with
    symbol/entry/exit/bars/side/ret/gross_ret -- the basis for win-rate, profit factor, etc.
    """
    dw = weights.diff().abs()
    net_contrib = weights * rets - _cost_per_asset(dw, cost_bp)
    gross_contrib = weights * rets
    sign = np.sign(weights).fillna(0.0)
    rows = []
    for col in weights.columns:
        s = sign[col]
        run = (s != s.shift()).cumsum()
        for _, idx in s.groupby(run).groups.items():
            if s.loc[idx[0]] == 0:
                continue
            rows.append({
                "symbol": col, "entry": idx[0], "exit": idx[-1], "bars": len(idx),
                "side": int(s.loc[idx[0]]),
                "ret": float(net_contrib[col].loc[idx].sum()),
                "gross_ret": float(gross_contrib[col].loc[idx].sum()),
            })
    return pd.DataFrame(rows, columns=["symbol", "entry", "exit", "bars", "side",
                                       "ret", "gross_ret"])

