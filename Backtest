    vw =vfade(V,sessions=(1,2),reentry=True,k=1.5,pv=pv,comm=cm)[['t','pnl']].assign(s='VWAP')
    LV=build_levels(df); R=rejections(df,LV,minConf=1)
    z=R[(R.n>=4)&(R.names.str.contains('POC',regex=False))]
    rej=ctrade(df,z,rr=4.0,pv=pv,comm=cm)[['t','pnl']].assign(s='REJ')
