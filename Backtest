"""
smt.py — Smart Money Technique (SMT) divergence across correlated instruments.

ES and NQ (MES and MNQ) are driven by the same risk engine, so at a genuine
reversal they *disagree*: one raids its liquidity while the other refuses to
follow. If MES prints a fresh lower low but MNQ holds a higher low, sell-side was
swept in one but not the other — a bullish SMT divergence, one of ICT's most
respected confirmations because it is very hard to fake across two books.

The check is deliberately causal: it only looks at bars up to `i`.
"""
from __future__ import annotations

import numpy as np
import pandas as pd


def align(a: pd.DataFrame, b: pd.DataFrame) -> tuple[pd.DataFrame, pd.DataFrame]:
    """Restrict two feeds to their shared timestamps, same ordering."""
    idx = a.index.intersection(b.index)
    return a.loc[idx].sort_index(), b.loc[idx].sort_index()


def smt_confirms(primary: pd.DataFrame, secondary: pd.DataFrame, i: int,
                 direction: int, lookback: int = 30, recent: int = 4) -> bool:
    """True if a `direction` SMT divergence is present at bar `i`.

    bullish (direction +1): primary makes a new low over the last `recent` bars
      (vs the prior window) while secondary does NOT — secondary held.
    bearish (direction -1): primary makes a new high while secondary does not.
    """
    if secondary is None:
        return False
    lo = i - lookback
    if lo < recent + 1 or i >= len(primary) or i >= len(secondary):
        return False

    pl = primary["low"].to_numpy(); ph = primary["high"].to_numpy()
    sl = secondary["low"].to_numpy(); sh = secondary["high"].to_numpy()

    if direction > 0:
        p_now = pl[i - recent + 1:i + 1].min()
        p_prior = pl[lo:i - recent + 1].min()
        s_now = sl[i - recent + 1:i + 1].min()
        s_prior = sl[lo:i - recent + 1].min()
        primary_new_low = p_now < p_prior
        secondary_new_low = s_now < s_prior
        return primary_new_low and not secondary_new_low
    else:
        p_now = ph[i - recent + 1:i + 1].max()
        p_prior = ph[lo:i - recent + 1].max()
        s_now = sh[i - recent + 1:i + 1].max()
        s_prior = sh[lo:i - recent + 1].max()
        primary_new_high = p_now > p_prior
        secondary_new_high = s_now > s_prior
        return primary_new_high and not secondary_new_high

