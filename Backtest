"""
sessions.py — time is the fourth dimension of ICT.

ICT holds that the interbank algorithm delivers price on a schedule: liquidity is
engineered during quiet hours and raided during the "killzones". Trading the same
setup at 10:15 ET (prime NY killzone / Silver Bullet) versus 13:30 ET (lunch
doldrums) is a completely different expectancy. All windows below are New York
local time and DST-aware because the index carried through is tz-aware.

Windows (ET):
    Asian range        20:00–00:00   accumulation; defines the overnight pool
    London killzone    02:00–05:00   first manipulation of the day (Judas)
    NY AM killzone     07:00–10:00   primary intraday expansion
    Silver Bullet AM   10:00–11:00   the highest-probability 1h window
    London close       10:00–12:00   reversal / profit-taking window
    Silver Bullet PM   14:00–15:00   secondary expansion
    NY PM killzone     13:30–16:00   afternoon trend / continuation
"""
from __future__ import annotations

from datetime import time
import pandas as pd

# name -> (start, end) in New York local time. End is exclusive.
KILLZONES = {
    "asia": (time(20, 0), time(23, 59, 59)),
    "london": (time(2, 0), time(5, 0)),
    "ny_am": (time(7, 0), time(10, 0)),
    "silver_bullet_am": (time(10, 0), time(11, 0)),
    "london_close": (time(10, 0), time(12, 0)),
    "silver_bullet_pm": (time(14, 0), time(15, 0)),
    "ny_pm": (time(13, 30), time(16, 0)),
}

# Regular Trading Hours for the equity index futures (ET).
RTH_OPEN = time(9, 30)
RTH_CLOSE = time(16, 0)

# ICT "true day" open used for Power-of-3 / Judas reference.
MIDNIGHT_OPEN = time(0, 0)


def _in_window(t: time, start: time, end: time) -> bool:
    if start <= end:
        return start <= t < end
    return t >= start or t < end  # wraps past midnight


def in_killzone(ts: pd.Timestamp, name: str) -> bool:
    """True if a NY-time timestamp falls in the named killzone."""
    start, end = KILLZONES[name]
    return _in_window(ts.time(), start, end)


def killzone_mask(index_ny: pd.DatetimeIndex, name: str) -> pd.Series:
    """Vectorised killzone membership for a NY-time index."""
    start, end = KILLZONES[name]
    t = index_ny.time
    if start <= end:
        vals = [(x >= start) and (x < end) for x in t]
    else:
        vals = [(x >= start) or (x < end) for x in t]
    return pd.Series(vals, index=index_ny)


def in_rth(ts: pd.Timestamp) -> bool:
    return RTH_OPEN <= ts.time() < RTH_CLOSE


def active_killzones(ts: pd.Timestamp) -> list[str]:
    """All killzones a timestamp belongs to (they overlap by design)."""
    return [name for name in KILLZONES if in_killzone(ts, name)]

