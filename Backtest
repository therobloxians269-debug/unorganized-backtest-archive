"""Full institutional tear sheet for the validated trend strategy (Sharpe ~0.74/0.78).

Multi-timescale (63/126/252) vol-normalized tanh momentum, inverse-vol sized, portfolio
vol-targeted, 16-ETF basket, net of cost. Reports every metric a fund / Quantiacs / QC
screens on, including PSR vs 1.0 and beta/alpha vs SPY.

    PYTHONPATH=. python3 research/trend_stats.py
"""
from __future__ import annotations

import numpy as np
import pandas as pd

from ope.validation import probabilistic_sharpe_ratio

BASKET = ["SPY", "QQQ", "IWM", "EFA", "EEM", "TLT", "IEF", "LQD", "HYG", "EMB",
          "GLD", "SLV", "DBC", "USO", "VNQ", "UUP"]
TGT, COST_BP, LOOKS = 0.10, 1.0, (63, 126, 252)


def trend(px):
    rets = px.pct_change()
    av = (rets.rolling(63).std() * np.sqrt(252)).shift(1)
    z = sum(px.pct_change(L) / (av * np.sqrt(L / 252.0)) for L in LOOKS) / len(LOOKS)
    w = np.tanh(z).shift(1) / av
    w = w.div(w.abs().sum(axis=1).replace(0, np.nan), axis=0)
    g = (w * rets).sum(axis=1)
    scale = (TGT / (g.rolling(63).std() * np.sqrt(252))).shift(1).clip(0, 3).fillna(0.0)
    w = w.mul(scale, axis=0)
    turn = w.diff().abs().sum(axis=1)
    net = ((w * rets).sum(axis=1) - turn * COST_BP * 1e-4).dropna()
    return net, w.reindex(net.index), turn.reindex(net.index)


def longest_dd(dd):
    run = best = 0
    for x in dd < -1e-9:
        run = run + 1 if x else 0
        best = max(best, run)
    return best


def main():
    import yfinance as yf
    raw = yf.download(BASKET, start="2006-01-01", auto_adjust=True, progress=False)["Close"]
    px = raw.dropna(how="all").dropna(axis=1, thresh=int(len(raw) * 0.4))
    net, w, turn = trend(px)
    spy = px["SPY"].pct_change().reindex(net.index)

    yrs = (net.index[-1] - net.index[0]).days / 365.25
    cagr = (1 + net).prod() ** (1 / yrs) - 1
    vol = net.std() * np.sqrt(252)
    sharpe = net.mean() / net.std() * np.sqrt(252)
    sortino = net.mean() * 252 / (net[net < 0].std() * np.sqrt(252))
    eq = (1 + net).cumprod()
    dd = eq / eq.cummax() - 1
    mo = net.resample("ME").apply(lambda x: (1 + x).prod() - 1)
    yr = net.resample("YE").apply(lambda x: (1 + x).prod() - 1)
    b = pd.concat([net, spy], axis=1).dropna()
    beta = b.cov().iloc[0, 1] / b.iloc[:, 1].var()
    alpha = (net.mean() - beta * spy.mean()) * 252

    P = lambda x: f"{x*100:.2f}%"
    print("================ TREND STRATEGY — FULL TEAR SHEET ================")
    print(f"period {net.index[0].date()} -> {net.index[-1].date()} | {yrs:.1f}y, {len(net)} days | {len(px.columns)} ETFs, vol-target {TGT*100:.0f}%")
    print("\n-- RETURNS --")
    print(f"  total return     {P((1+net).prod()-1)}")
    print(f"  CAGR             {P(cagr)}")
    print(f"  ann volatility   {P(vol)}")
    print(f"  best / worst day {P(net.max())} / {P(net.min())}")
    print(f"  best / worst mo  {P(mo.max())} / {P(mo.min())}")
    print("\n-- RISK-ADJUSTED --")
    print(f"  Sharpe           {sharpe:.2f}")
    print(f"  Sortino          {sortino:.2f}")
    print(f"  Calmar (MAR)     {cagr/abs(dd.min()):.2f}")
    print(f"  PSR vs 0         {probabilistic_sharpe_ratio(net,0.0)*100:.1f}%")
    print(f"  PSR vs 1.0       {probabilistic_sharpe_ratio(net,1.0/np.sqrt(252))*100:.1f}%   (fund bar >=95%)")
    print(f"  Sharpe (2010+)   {(net[net.index>='2010-06-01'].mean()/net[net.index>='2010-06-01'].std()*np.sqrt(252)):.2f}")
    print("\n-- DRAWDOWN --")
    print(f"  max drawdown     {P(dd.min())}")
    print(f"  avg drawdown     {P(dd[dd<0].mean())}")
    print(f"  longest DD       {longest_dd(dd)} trading days")
    print(f"  time in drawdown {P((dd<-1e-9).mean())}")
    print("\n-- TAIL / DISTRIBUTION --")
    print(f"  daily VaR 95/99  {P(net.quantile(0.05))} / {P(net.quantile(0.01))}")
    print(f"  daily CVaR 95    {P(net[net<=net.quantile(0.05)].mean())}")
    print(f"  skew {net.skew():+.2f}  kurtosis {net.kurt():+.2f}")
    print("\n-- CONSISTENCY --")
    print(f"  daily win        {P((net>0).mean())}")
    print(f"  monthly win      {P((mo>0).mean())}")
    print(f"  positive years   {(yr>0).sum()}/{len(yr)}  | best {P(yr.max())} worst {P(yr.min())}")
    print("\n-- MARKET (alpha vs SPY) --")
    print(f"  correlation SPY  {b.corr().iloc[0,1]:+.2f}")
    print(f"  beta to SPY      {beta:+.2f}")
    print(f"  annualized alpha {P(alpha)}")
    print("\n-- ACTIVITY --")
    print(f"  avg gross expo   {w.abs().sum(axis=1).mean():.2f}x")
    print(f"  ann turnover     {turn.mean()*252:.1f}x/yr (one-way)")
    print("\n-- YEARLY RETURNS --")
    print("  " + "  ".join(f"{t.year}:{v*100:+.0f}%" for t, v in yr.items()))
    print("\n-- MONTHLY RETURNS (%) --")
    grid = mo.copy()
    grid.index = [(d.year, d.month) for d in grid.index]
    tbl = grid.unstack() if False else None
    by = {}
    for (y, m), v in grid.items():
        by.setdefault(y, {})[m] = v * 100
    hdr = "  year " + " ".join(f"{m:>5}" for m in range(1, 13)) + "   YEAR"
    print(hdr)
    for y in sorted(by):
        row = " ".join(f"{by[y].get(m, float('nan')):5.1f}" for m in range(1, 13))
        print(f"  {y} {row} {yr[[i for i in yr.index if i.year==y][0]]*100:+6.1f}")


if __name__ == "__main__":
    main()

