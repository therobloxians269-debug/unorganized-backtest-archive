"""JudasSwingSentinel — the event-driven signal state machine.

Bearish flow (longs mirror):
  1. SWEEP   — in the 08:30–11:00 ET window, a signal-instrument 1m bar
               trades above an unswept 1H buy-side pool (the Judas raid).
  2. REJECT  — within `reject_bars`, a 1m close back below the raided level
               (a genuine breakout never comes back -> no trade).
  3. SMT     — at rejection time, the reference instrument has NOT swept its
               own corresponding 1H pool within `smt_tol_min` before the
               signal sweep (through decision time): cracked correlation.
  4. MSS     — a 1m close below the most recent confirmed 1m swing low
               (the structure that carried price into the raid).
  5. FVG     — the displacement leg leaves a bearish 1m FVG; emit a limit
               order at its 50% level (consequent encroachment), stop above
               the Judas high, target at rr * risk.

The sentinel only *emits* OrderIntents; fills, brackets, and cash live in
the execution layer (backtest.py / sentinel_live.py).
"""
from __future__ import annotations

from dataclasses import dataclass
from datetime import datetime, time, timedelta

from .config import Config
from .pools import BSL, SSL, PoolTracker
from .structure import StructureTracker


@dataclass
class Bar:
    ts: datetime      # bar OPEN time, tz-aware (ET expected by the sentinel)
    open: float
    high: float
    low: float
    close: float
    volume: float = 0.0


@dataclass
class OrderIntent:
    ts: datetime          # decision bar timestamp
    side: int             # +1 buy, -1 sell
    limit: float          # FVG 50% level, tick-rounded
    stop: float
    target: float
    ttl_bars: int
    tag: str              # audit trail: pool level, judas extreme, fvg


def _hhmm(s: str) -> time:
    h, m = s.split(":")
    return time(int(h), int(m))


def _round_tick(px: float, tick: float) -> float:
    return round(round(px / tick) * tick, 10)


class JudasSwingSentinel:
    """Feed completed 1m bars for both instruments via on_bar(); collect
    OrderIntents from the return value of signal-instrument bars."""

    def __init__(self, cfg: Config):
        self.cfg = cfg
        self.pools_sig = PoolTracker(cfg.pool_fractal_k, cfg.pool_max_age_hours)
        self.pools_ref = PoolTracker(cfg.pool_fractal_k, cfg.pool_max_age_hours)
        self.struct = StructureTracker(cfg.swing_k_1m)
        self._w0 = _hhmm(cfg.window_start)
        self._w1 = _hhmm(cfg.window_end)
        self._reset_day(None)

    # ------------------------------------------------------------------
    def _reset_day(self, d) -> None:
        self._day = d
        self._setups_today = 0
        self._reset_state()

    def _reset_state(self) -> None:
        self.state = "IDLE"          # IDLE -> SWEPT -> ARMED -> (intent emitted)
        self.direction = 0           # -1 bearish setup, +1 bullish setup
        self.raid_level = None
        self.judas_extreme = None
        self.sweep_ts = None
        self.bars_since_sweep = 0
        self.bars_since_armed = 0
        self.bars_since_mss = 0
        self.mss_swing = None
        self.mss_ts = None

    # ------------------------------------------------------------------
    def on_bar(self, symbol: str, bar: Bar) -> OrderIntent | None:
        if symbol == self.cfg.reference.symbol:
            self.pools_ref.on_1m_bar(bar.ts, bar.high, bar.low)
            return None
        if symbol != self.cfg.signal.symbol:
            return None

        if bar.ts.date() != self._day:
            self._reset_day(bar.ts.date())

        # the bar has CLOSED: structure (swings/FVGs) may include it in the
        # decision. Pools update after _step so the raid bar cannot mark its
        # own target pool swept before sweep detection runs.
        self.struct.on_1m_bar(bar.ts, bar.open, bar.high, bar.low, bar.close)
        intent = self._step(bar)
        self.pools_sig.on_1m_bar(bar.ts, bar.high, bar.low)
        return intent

    # ------------------------------------------------------------------
    def _in_window(self, ts: datetime) -> bool:
        t = ts.time()
        return self._w0 <= t < self._w1

    def _step(self, bar: Bar) -> OrderIntent | None:
        cfg = self.cfg

        if self.state == "IDLE":
            if not self._in_window(bar.ts) or self._setups_today >= cfg.max_setups_per_day:
                return None
            # a raid means the level traded through within THIS bar
            bsl = [p for p in self.pools_sig.unswept(BSL, bar.ts)
                   if bar.high > p.level >= bar.low]
            ssl = [p for p in self.pools_sig.unswept(SSL, bar.ts)
                   if bar.low < p.level <= bar.high]
            if bsl:
                self.state, self.direction = "SWEPT", -1
                self.raid_level = max(p.level for p in bsl)
                self.judas_extreme = bar.high
                self.sweep_ts = bar.ts
                self.bars_since_sweep = 0
            elif ssl:
                self.state, self.direction = "SWEPT", +1
                self.raid_level = min(p.level for p in ssl)
                self.judas_extreme = bar.low
                self.sweep_ts = bar.ts
                self.bars_since_sweep = 0
            return None

        if self.state == "SWEPT":
            self.bars_since_sweep += 1
            if self.direction == -1:
                self.judas_extreme = max(self.judas_extreme, bar.high)
                rejected = bar.close < self.raid_level
            else:
                self.judas_extreme = min(self.judas_extreme, bar.low)
                rejected = bar.close > self.raid_level
            if not rejected:
                if self.bars_since_sweep > cfg.reject_bars:
                    self._reset_state()      # real breakout, stand down
                return None
            if not self._in_window(bar.ts):
                self._reset_state()
                return None
            # --- SMT gate -------------------------------------------------
            side = BSL if self.direction == -1 else SSL
            t0 = self.sweep_ts - timedelta(minutes=cfg.smt_tol_min)
            ref_swept = self.pools_ref.swept_between(side, t0, bar.ts)
            ok = {"divergence": not ref_swept,   # reference failed to follow
                  "invert": ref_swept,           # placebo: require confluence
                  "off": True}[cfg.smt_mode]
            if not ok:
                self._reset_state()
                return None
            # --- arm: find the structure MSS must break --------------------
            if self.direction == -1:
                self.mss_swing = self.struct.last_swing_low_below(bar.close, bar.ts)
            else:
                self.mss_swing = self.struct.last_swing_high_above(bar.close, bar.ts)
            if self.mss_swing is None:
                self._reset_state()
                return None
            self.state = "ARMED"
            self.bars_since_armed = 0
            return None

        if self.state == "ARMED":
            self.bars_since_armed += 1
            if self.direction == -1:
                self.judas_extreme = max(self.judas_extreme, bar.high)
                mss = bar.close < self.mss_swing.level
            else:
                self.judas_extreme = min(self.judas_extreme, bar.low)
                mss = bar.close > self.mss_swing.level
            if self.bars_since_armed > cfg.mss_expiry_bars or not self._in_window(bar.ts):
                self._reset_state()
                return None
            if not mss:
                return None
            self.state = "MSS"
            self.bars_since_mss = 0
            self.mss_ts = bar.ts
            # fall through to FVG check on this same bar
            return self._try_fvg(bar)

        if self.state == "MSS":
            self.bars_since_mss += 1
            if self.bars_since_mss > cfg.fvg_wait_bars or not self._in_window(bar.ts):
                self._reset_state()
                return None
            return self._try_fvg(bar)

        return None

    # ------------------------------------------------------------------
    def _try_fvg(self, bar: Bar) -> OrderIntent | None:
        cfg = self.cfg
        # FVG must belong to the displacement leg: third candle at/after MSS
        # minus a small backstep so the gap that *caused* the break counts
        since = self.mss_ts - timedelta(minutes=3)
        fvg = self.struct.recent_fvg(self.direction, since)
        if fvg is None:
            return None
        tick = cfg.signal.tick
        limit = _round_tick(fvg.mid, tick)
        if self.direction == -1:
            stop = _round_tick(self.judas_extreme + cfg.stop_buffer_ticks * tick, tick)
            risk = stop - limit
            target = _round_tick(limit - cfg.rr * risk, tick)
        else:
            stop = _round_tick(self.judas_extreme - cfg.stop_buffer_ticks * tick, tick)
            risk = limit - stop
            target = _round_tick(limit + cfg.rr * risk, tick)
        if risk <= 0:
            self._reset_state()
            return None
        self._setups_today += 1
        intent = OrderIntent(
            ts=bar.ts, side=self.direction, limit=limit, stop=stop, target=target,
            ttl_bars=cfg.order_ttl_bars,
            tag=(f"raid={self.raid_level:.2f} judas={self.judas_extreme:.2f} "
                 f"mss={self.mss_swing.level:.2f} fvg=[{fvg.bottom:.2f},{fvg.top:.2f}]"),
        )
        self._reset_state()
        return intent

