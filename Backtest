            d_=1 if pte[i]>0 else -1
            trades.append((years[i], d_*yv[i]*MES-RT))
            pdy[sess[i]]=pdy.get(sess[i],0)+1; ou=xb[i]
    if not trades: print(f"{label:26} no trades"); return
