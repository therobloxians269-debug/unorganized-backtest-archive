    la_ok    = np.isclose(s0_close, s1_prior, rtol=1e-9)
    print(f"\n  Lookahead test: {'PASSED ✓' if la_ok else 'FAILED ✗'}")
    print(f"  Schema valid  : {validate_module1_output(processed)}")
    print(f"\n{SEP}\n  Module 1 complete.\n{SEP}\n")
    return processed


if __name__ == "__main__":
    df_m1 = run_module1_demo("MES")

