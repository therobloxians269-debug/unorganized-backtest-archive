#!/usr/bin/env python3
"""Does a regime gate repair the trend engine's full-history curve?
Thesis (mechanistic, not fitted): an ORB+VWAP TREND engine should only take
trades when the tape is actually TRENDING. omni2_lib already ships a causal
efficiency ratio ER(24) (2h trendiness on 5-min bars). Gate entries: only fire
when ER at the entry bar >= thr. Sweep thr for robustness (not a magic number)."""
import numpy as np, pandas as pd
import omni2_lib as L
from omni2_lib import ORN, FLOOR, fric, DPP

def trend_day(s, er_thr, stop_atr=1.5, max_entries=3):
    h, l, c, atr, vwap, er = s["h"], s["l"], s["c"], s["atr"], s["vwap"], s["er"]
    orh, orl = s["or_hi"], s["or_lo"]
    pos = 0; entry = stop = np.nan; ebar = -1; risk0 = np.nan; broke = 0; n = 0; res = []
    for b in range(ORN, 78):
        if pos == 0 and n < max_entries and er[b] >= er_thr:      # <-- regime gate
            above = c[b] > vwap[b]; below = c[b] < vwap[b]; side = 0
            if broke == 0:
                if c[b] > orh and above: side = 1; broke = 1
                elif c[b] < orl and below: side = -1; broke = -1
            else:
                if broke == 1 and above and l[b] <= vwap[b] + 0.5*atr[b] and c[b] > c[b-1]: side = 1
                elif broke == -1 and below and h[b] >= vwap[b] - 0.5*atr[b] and c[b] < c[b-1]: side = -1
            if side != 0:
                pos = side; entry = c[b]; ebar = b
                stop = c[b] - side*max(stop_atr*atr[b], FLOOR); risk0 = abs(entry-stop); n += 1
            continue
        if pos != 0 and b > ebar:
            if (l[b] <= stop) if pos > 0 else (h[b] >= stop):
                g = pos*(stop-entry); res.append((s["date"], g-fric("stop"), risk0)); pos = 0; continue
            if b == 77:
                g = pos*(c[b]-entry); res.append((s["date"], g-fric("eod"), risk0)); pos = 0
    return res

def era(tr):
    tr = tr.copy(); tr["yr"] = pd.to_datetime(tr["date"]).dt.year
    def one(d):
        if len(d) < 5: return "        —"
        net = d["net"].to_numpy(); eq = np.cumsum(net)*DPP
        dd = (eq-np.maximum.accumulate(eq)).min()
        rr = net.sum()*DPP/abs(dd) if dd < 0 else float("inf")
        return f"n={len(d):4d} ${net.sum()*DPP:>6.0f} hit={100*(net>0).mean():4.1f} rr={rr:+5.2f}"
    return (f"ALL[{one(tr)}]  pre18[{one(tr[tr.yr<2018])}]  "
            f"18-21[{one(tr[(tr.yr>=2018)&(tr.yr<=2021)])}]  22+[{one(tr[tr.yr>=2022])}]")

def main():
    S = L.load()
    print("efficiency-ratio gate sweep (ER at entry >= thr); EOD-ride, 1 MES, net friction\n")
    for thr in [0.00, 0.20, 0.30, 0.35, 0.40, 0.45, 0.50, 0.55]:
        rows = [dict(date=d, net=net, risk=r) for s in S for d, net, r in trend_day(s, thr)]
        tr = pd.DataFrame(rows)
        print(f"thr={thr:.2f}  {era(tr)}")

if __name__ == "__main__":
    main()

