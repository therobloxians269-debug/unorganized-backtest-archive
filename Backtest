import pandas as pd, numpy as np, sys
from engine import *

def run(df, ext_tf=15, int_tf=5, L=1, R=1, ref='either',
        ext_window=240, int_window=120, entry_window=60,
        max_stop=60.0, buf=2.0, rr=2.0, one_per_day=True,
        require_sweep=True, tick=0.25, point_val=20.0, comm=4.00,
        slip_ticks=1.0, sess_filter=None, max_hold=None, verbose=False):
    """returns trades df + counters"""
    ext_ev = smt_events(rs(df,ext_tf),L,R,ref)
    int_ev = smt_events(rs(df,int_tf),L,R,ref)
    ext = pd.DataFrame(ext_ev,columns=['t','d']).set_index('t') if ext_ev else pd.DataFrame(columns=['d'])
    ie  = pd.DataFrame(int_ev,columns=['t','d']).set_index('t') if int_ev else pd.DataFrame(columns=['d'])
    # events are known at CLOSE of that resampled bar
    ext_time = {}; int_time = {}
    for t,d in ext_ev: ext_time.setdefault(t+pd.Timedelta(minutes=ext_tf),[]).append(d)
    for t,d in int_ev: int_time.setdefault(t+pd.Timedelta(minutes=int_tf),[]).append(d)

    idx=df.index; o=df['o'].values; h=df['h'].values; l=df['l'].values; c=df['c'].values
    TDO=df['TDO'].values; dh=df['dhigh'].values; dl=df['dlow'].values
    cb=df['cisd_bear'].values; cl_=df['cisd_bull'].values
    day=df['daycycle'].values; sess=df['sess'].values
    n=len(df)
    slip=slip_ticks*tick

    armed_ext={-1:None,1:None}; armed_int={-1:None,1:None}
    traded_day=set(); trades=[]; in_pos=None
    cnt=dict(ext=0,intn=0,cascade=0,skipped_wide=0,taken=0,no_sweep=0)

    for i in range(n):
        t=idx[i]
        # ---- manage open position on this bar
        if in_pos is not None:
            p=in_pos
            hit_stop = (h[i]>=p['stop']) if p['d']==-1 else (l[i]<=p['stop'])
            hit_tgt  = (l[i]<=p['tgt'])  if p['d']==-1 else (h[i]>=p['tgt'])
            exit_px=None; why=None
            if hit_stop: exit_px=p['stop']; why='stop'          # stop first if both
            elif hit_tgt: exit_px=p['tgt']; why='target'
            elif day[i]!=p['day'] or (max_hold and (t-p['tin']).total_seconds()/60>=max_hold):
                exit_px=o[i]; why='time'
            if exit_px is not None:
                px_out = exit_px - slip*(-p['d'])*(1 if why=='stop' else 0)  # extra slip on stops
                px_out = exit_px + (slip if (why=='stop' and p['d']==-1) else (-slip if (why=='stop' and p['d']==1) else 0))
                if why=='time':
                    px_out = exit_px + (slip if p['d']==-1 else -slip)
                gross = (p['entry']-px_out)*point_val if p['d']==-1 else (px_out-p['entry'])*point_val
                trades.append(dict(tin=p['tin'],tout=t,d=p['d'],entry=p['entry'],exit=px_out,
                                   stop=p['stop'],tgt=p['tgt'],why=why,risk_pts=p['risk'],
                                   pnl=gross-comm, R=(gross-comm)/(p['risk']*point_val)))
                in_pos=None

        # ---- new external arms
        if t in ext_time:
            for d in ext_time[t]:
                armed_ext[d]=i; cnt['ext']+=1
        # ---- new internal arms (must follow external, same dir, within window)
        if t in int_time:
            for d in int_time[t]:
                e=armed_ext[d]
                if e is not None and 0<= (i-e) <= ext_window:
                    armed_int[d]=i; cnt['intn']+=1
        # ---- entry check
        if in_pos is None:
            for d in (-1,1):
                a=armed_int[d]
                if a is None: continue
                if (i-a)>int_window: armed_int[d]=None; continue
                if one_per_day and day[i] in traded_day: continue
                if sess_filter is not None and sess[i] not in sess_filter: continue
                # literal panel step 1: swept above TDO (short) / below TDO (long)
                if require_sweep:
                    if d==-1 and not (dh[i] > TDO[i]): cnt['no_sweep']+=1; continue
                    if d== 1 and not (dl[i] < TDO[i]): cnt['no_sweep']+=1; continue
                lvl = cb[i] if d==-1 else cl_[i]
                if np.isnan(lvl): continue
                fired = (c[i]<lvl) if d==-1 else (c[i]>lvl)
                prev_ok = (c[i-1]>=lvl) if d==-1 else (c[i-1]<=lvl)
                if not (fired and prev_ok and i+1<n): continue
                cnt['cascade']+=1
                # stop: extreme since internal arm + buffer
                if d==-1: stop=max(h[a:i+1].max(), h[i])+buf
                else:     stop=min(l[a:i+1].min(), l[i])-buf
                entry=o[i+1] + (-slip if d==-1 else slip)   # next-bar open, adverse slip
                risk=abs(stop-entry)
                if risk>max_stop or risk<tick*4:
                    cnt['skipped_wide']+=1; armed_int[d]=None; armed_ext[d]=None; continue
                tgt = entry - rr*risk if d==-1 else entry + rr*risk
                in_pos=dict(tin=idx[i+1],d=d,entry=entry,stop=stop,tgt=tgt,risk=risk,day=day[i])
                traded_day.add(day[i]); cnt['taken']+=1
                armed_int[d]=None; armed_ext[d]=None; armed_int[-d]=None; armed_ext[-d]=None
                break
    tr=pd.DataFrame(trades)
    return tr,cnt

def stats(tr,label=''):
    if len(tr)==0: return f'{label}: NO TRADES'
    w=(tr.pnl>0).mean(); pf = tr.pnl[tr.pnl>0].sum()/max(1e-9,-tr.pnl[tr.pnl<0].sum())
    eq=tr.pnl.cumsum(); dd=(eq-eq.cummax()).min()
    t=tr.pnl.mean()/tr.pnl.std()*np.sqrt(len(tr)) if tr.pnl.std()>0 else 0
    return (f'{label}: n={len(tr):4d} WR={w*100:5.1f}% avgR={tr.R.mean():+.3f} $/tr={tr.pnl.mean():+7.2f} '
            f'net=${tr.pnl.sum():+9.0f} PF={pf:.2f} maxDD=${dd:.0f} t={t:.2f}')

