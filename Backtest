"""Breaker blocks and Balanced Price Ranges (BPR).

Breaker block, standard definition (LuxAlgo / ICT):
  A BEARISH order block (the last up-close candle before a swing high) that
  price later CLOSES ABOVE is invalidated as resistance and becomes a
  BULLISH BREAKER.  It is traded on the retest from above.
  Mirrored for the bearish breaker.

Everything is strictly causal:
  * a pivot at bar p is only registered at bar p+piv (it cannot be known before),
  * a zone can only break after it is registered,
  * a retest can only fire after the break bar.
Zones are deleted when closed through (invalidated) or when they age out,
matching the page's "removed the instant it is invalidated or filled".

BPR = the overlap of an unfilled bullish FVG and an unfilled bearish FVG.

`shift` on breaker_signals is the PLACEBO control: it displaces every zone by a
fixed number of points at creation, so the count, width and timing of the zones
are preserved but their price location is meaningless.  A real level must beat
its own displaced twin.
"""
import numpy as np
from numba import njit

MAXZ = 64
MAXF = 24  # FVG pool cap for BPR


@njit(cache=True)
def breaker_signals(o, h, l, c, piv, ob_lookback, max_age, shift=0.0):
    """Returns (bull_retest, bear_retest, bull_lo, bull_hi, bear_lo, bear_hi)."""
    N = len(c)
    bull_sig = np.zeros(N, dtype=np.bool_)
    bear_sig = np.zeros(N, dtype=np.bool_)
    bull_lo = np.full(N, np.nan); bull_hi = np.full(N, np.nan)
    bear_lo = np.full(N, np.nan); bear_hi = np.full(N, np.nan)

    # bear-OB pool -> BULLISH breaker once closed above
    bz_lo = np.zeros(MAXZ); bz_hi = np.zeros(MAXZ)
    bz_st = np.zeros(MAXZ, np.int64); bz_bt = np.zeros(MAXZ, np.int64); bz_n = 0
    # bull-OB pool -> BEARISH breaker once closed below
    lz_lo = np.zeros(MAXZ); lz_hi = np.zeros(MAXZ)
    lz_st = np.zeros(MAXZ, np.int64); lz_bt = np.zeros(MAXZ, np.int64); lz_n = 0

    for i in range(1, N):
        # ---- pivots confirmed on this bar sit at p = i - piv ----
        p = i - piv
        if p - piv >= 0:
            is_ph = True
            is_pl = True
            for j in range(p - piv, p + piv + 1):
                if j == p:
                    continue
                if h[j] >= h[p]:
                    is_ph = False
                if l[j] <= l[p]:
                    is_pl = False
            if is_ph:
                k = -1
                lo_b = max(0, p - ob_lookback)
                for j in range(p, lo_b - 1, -1):
                    if c[j] > o[j]:
                        k = j
                        break
                if k >= 0:
                    if bz_n == MAXZ:            # drop oldest
                        for z in range(MAXZ - 1):
                            bz_lo[z] = bz_lo[z + 1]; bz_hi[z] = bz_hi[z + 1]
                            bz_st[z] = bz_st[z + 1]; bz_bt[z] = bz_bt[z + 1]
                        bz_n -= 1
                    bz_lo[bz_n] = l[k] + shift; bz_hi[bz_n] = h[k] + shift
                    bz_st[bz_n] = 0; bz_bt[bz_n] = i; bz_n += 1
            if is_pl:
                k = -1
                lo_b = max(0, p - ob_lookback)
                for j in range(p, lo_b - 1, -1):
                    if c[j] < o[j]:
                        k = j
                        break
                if k >= 0:
                    if lz_n == MAXZ:
                        for z in range(MAXZ - 1):
                            lz_lo[z] = lz_lo[z + 1]; lz_hi[z] = lz_hi[z + 1]
                            lz_st[z] = lz_st[z + 1]; lz_bt[z] = lz_bt[z + 1]
                        lz_n -= 1
                    lz_lo[lz_n] = l[k] - shift; lz_hi[lz_n] = h[k] - shift
                    lz_st[lz_n] = 0; lz_bt[lz_n] = i; lz_n += 1

        # ---- bear-OB pool: candidate bullish breakers ----
        w = 0
        for z in range(bz_n):
            keep = True
            if i - bz_bt[z] > max_age:
                keep = False
            elif bz_st[z] == 0:
                if c[i] > bz_hi[z]:
                    bz_st[z] = 1
                    bz_bt[z] = i
            else:
                if c[i] < bz_lo[z]:
                    keep = False
                elif l[i] <= bz_hi[z] and h[i] >= bz_lo[z]:
                    if not bull_sig[i]:
                        bull_sig[i] = True
                        bull_lo[i] = bz_lo[z]; bull_hi[i] = bz_hi[z]
                    keep = False
            if keep:
                bz_lo[w] = bz_lo[z]; bz_hi[w] = bz_hi[z]
                bz_st[w] = bz_st[z]; bz_bt[w] = bz_bt[z]; w += 1
        bz_n = w

        # ---- bull-OB pool: candidate bearish breakers ----
        w = 0
        for z in range(lz_n):
            keep = True
            if i - lz_bt[z] > max_age:
                keep = False
            elif lz_st[z] == 0:
                if c[i] < lz_lo[z]:
                    lz_st[z] = 1
                    lz_bt[z] = i
            else:
                if c[i] > lz_hi[z]:
                    keep = False
                elif h[i] >= lz_lo[z] and l[i] <= lz_hi[z]:
                    if not bear_sig[i]:
                        bear_sig[i] = True
                        bear_lo[i] = lz_lo[z]; bear_hi[i] = lz_hi[z]
                    keep = False
            if keep:
                lz_lo[w] = lz_lo[z]; lz_hi[w] = lz_hi[z]
                lz_st[w] = lz_st[z]; lz_bt[w] = lz_bt[z]; w += 1
        lz_n = w

    return bull_sig, bear_sig, bull_lo, bull_hi, bear_lo, bear_hi


@njit(cache=True)
def bpr_signals(h, l, c, max_age):
    """Balanced Price Range: overlap of an unfilled bullish and bearish FVG."""
    N = len(c)
    bull_sig = np.zeros(N, dtype=np.bool_)
    bear_sig = np.zeros(N, dtype=np.bool_)
    bull_lo = np.full(N, np.nan); bull_hi = np.full(N, np.nan)
    bear_lo = np.full(N, np.nan); bear_hi = np.full(N, np.nan)

    ul_lo = np.zeros(MAXF); ul_hi = np.zeros(MAXF); ul_bt = np.zeros(MAXF, np.int64); ul_n = 0
    dl_lo = np.zeros(MAXF); dl_hi = np.zeros(MAXF); dl_bt = np.zeros(MAXF, np.int64); dl_n = 0

    for i in range(2, N):
        if l[i] > h[i - 2]:
            if ul_n == MAXF:
                for z in range(MAXF - 1):
                    ul_lo[z] = ul_lo[z + 1]; ul_hi[z] = ul_hi[z + 1]; ul_bt[z] = ul_bt[z + 1]
                ul_n -= 1
            ul_lo[ul_n] = h[i - 2]; ul_hi[ul_n] = l[i]; ul_bt[ul_n] = i; ul_n += 1
        if h[i] < l[i - 2]:
            if dl_n == MAXF:
                for z in range(MAXF - 1):
                    dl_lo[z] = dl_lo[z + 1]; dl_hi[z] = dl_hi[z + 1]; dl_bt[z] = dl_bt[z + 1]
                dl_n -= 1
            dl_lo[dl_n] = h[i]; dl_hi[dl_n] = l[i - 2]; dl_bt[dl_n] = i; dl_n += 1

        for a in range(ul_n):
            for b in range(dl_n):
                lo = max(ul_lo[a], dl_lo[b])
                hi = min(ul_hi[a], dl_hi[b])
                if hi <= lo:
                    continue
                if l[i] <= hi and h[i] >= lo:
                    if ul_bt[a] > dl_bt[b]:
                        if not bull_sig[i]:
                            bull_sig[i] = True; bull_lo[i] = lo; bull_hi[i] = hi
                    else:
                        if not bear_sig[i]:
                            bear_sig[i] = True; bear_lo[i] = lo; bear_hi[i] = hi

        w = 0
        for a in range(ul_n):
            if i - ul_bt[a] <= max_age and l[i] > ul_lo[a]:
                ul_lo[w] = ul_lo[a]; ul_hi[w] = ul_hi[a]; ul_bt[w] = ul_bt[a]; w += 1
        ul_n = w
        w = 0
        for b in range(dl_n):
            if i - dl_bt[b] <= max_age and h[i] < dl_hi[b]:
                dl_lo[w] = dl_lo[b]; dl_hi[w] = dl_hi[b]; dl_bt[w] = dl_bt[b]; w += 1
        dl_n = w

    return bull_sig, bear_sig, bull_lo, bull_hi, bear_lo, bear_hi

