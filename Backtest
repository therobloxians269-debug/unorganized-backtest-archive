# 4. STATS
# ============================================================================
def maxdd(x):
    eq = np.cumsum(np.asarray(x, float))
    peak = np.maximum.accumulate(np.concatenate([[0.0], eq]))
    return float(np.max(peak - np.concatenate([[0.0], eq])))


def stats(tr, ncyc):
    if tr is None or len(tr) == 0:
        return dict(n=0, tpd=0.0, avgR=np.nan, dpt=np.nan, wr=np.nan,
                    d3=np.nan, tot=0.0, dd=np.nan, ddm=np.nan, t=np.nan, pf=np.nan)
    R = tr["R"].values
    n = len(R)
    d3 = np.nan
    if n > 3:
        srt = np.sort(R)[:-3]
        d3 = float(srt.mean())
    win = tr["usd"].values
    pos = win[win > 0].sum(); neg = -win[win < 0].sum()
    return dict(
        n=n, tpd=n / max(ncyc, 1), avgR=float(R.mean()),
        dpt=float(tr["usd"].mean()), wr=float((R > 0).mean()), d3=d3,
        tot=float(tr["usd"].sum()), dd=maxdd(tr["usd"].values),
        ddm=maxdd(tr["usd_micro"].values),
        t=float(R.mean() / (R.std(ddof=1) / math.sqrt(n))) if n > 2 and R.std(ddof=1) > 0 else np.nan,
        pf=float(pos / neg) if neg > 0 else np.inf,
    )


def fmt(s, lbl=""):
    if s["n"] == 0:
        return f"{lbl:>10s} n=0"
    return (f"{lbl:>10s} n={s['n']:5d} tpd={s['tpd']:5.2f} avgR={s['avgR']:+.4f} "
            f"$/tr={s['dpt']:+8.2f} wr={s['wr']:.3f} d3R={s['d3']:+.4f} "
            f"t={s['t']:+5.2f} PF={s['pf']:.2f} DD1mic=${s['ddm']:.0f}")


