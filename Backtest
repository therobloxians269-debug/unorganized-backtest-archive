#!/usr/bin/env python3
"""$1,000-account survival engineering. Same validated trend engine, but wrap it in
HARD risk overlays that cap the left tail (the only thing a tiny account needs):
  - daily stop        : 1 losing trade ends the day
  - monthly breaker   : down $Lmonth on the calendar month => flat till the 1st
  - account floor      : if equity <= $floor, stop for good (ruin)
Report the REAL chronological equity path (honest maxDD), MAR, and a monthly
bootstrap for P(ruin)/P(under). Risk overlays shape the distribution; they cannot
manufacture edge — so if the ratio doesn't bend, that is the honest answer."""
import numpy as np, pandas as pd
import omni2_lib as L
from omni2_lib import ORN, FLOOR, fric, DPP

def day_trades(s, er_thr, max_entries, atr_mult=1.5):
    """Return list of (net_pts, risk_pts) for one session; daily stop after 1 loss."""
    h, l, c, atr, vwap, er = s["h"], s["l"], s["c"], s["atr"], s["vwap"], s["er"]
    orh, orl = s["or_hi"], s["or_lo"]
    pos = 0; entry = stop = np.nan; ebar = -1; risk0 = np.nan
    broke = 0; n = 0; res = []; stopped = False
    for b in range(ORN, 78):
        if pos == 0 and n < max_entries and not stopped and er[b] >= er_thr and b < 77:
            above = c[b] > vwap[b]; below = c[b] < vwap[b]; side = 0
            if broke == 0:
                if c[b] > orh and above: side = 1; broke = 1
                elif c[b] < orl and below: side = -1; broke = -1
            else:
                if broke == 1 and above and l[b] <= vwap[b] + 0.5*atr[b] and c[b] > c[b-1]: side = 1
                elif broke == -1 and below and h[b] >= vwap[b] - 0.5*atr[b] and c[b] < c[b-1]: side = -1
            if side != 0:
                pos = side; entry = c[b]; ebar = b
                stop = c[b] - side*max(atr_mult*atr[b], FLOOR); risk0 = abs(entry-stop); n += 1
            continue
        if pos != 0 and b > ebar:
            hit = (l[b] <= stop) if pos > 0 else (h[b] >= stop)
            if hit: g = pos*(stop-entry) - fric("stop")
            elif b == 77: g = pos*(c[b]-entry) - fric("eod")
            else: continue
            res.append((g, risk0)); pos = 0
            if g < 0: stopped = True
    return res

def equity_path(S, er_thr, max_entries, Lmonth, start=1000.0, floor=0.0, y0=2022):
    """Chronological equity with monthly breaker + account floor. Returns (day_usd, ruined)."""
    eq = start; peak = start; maxdd = 0.0; usd_days = []; ruined = False
    cur_month = None; month_pnl = 0.0; broken = False
    for s in S:
        if s["date"].year < y0: continue
        ym = (s["date"].year, s["date"].month)
        if ym != cur_month:
            cur_month = ym; month_pnl = 0.0; broken = False
        if broken or ruined:
            usd_days.append(0.0); continue
        day_usd = sum(g for g, _ in day_trades(s, er_thr, max_entries)) * DPP
        # apply monthly breaker at the day boundary (can't unwind mid-day)
        month_pnl += day_usd; eq += day_usd
        usd_days.append(day_usd)
        peak = max(peak, eq); maxdd = min(maxdd, eq - peak)
        if eq <= floor: ruined = True
        if month_pnl <= -Lmonth: broken = True
    return np.array(usd_days), eq - start, maxdd, ruined

def month_pnls(day_usd, dates):
    df = pd.DataFrame({"u": day_usd, "ym": [(d.year, d.month) for d in dates]})
    return df.groupby("ym")["u"].sum().to_numpy()

def mc_month(mpnl, start=1000, horizon_months=54, n=20000, seed=11):
    rng = np.random.default_rng(seed)
    under = ruin = 0; worst = np.empty(n)
    for i in range(n):
        seq = rng.choice(mpnl, size=horizon_months, replace=True)
        eq = start + np.cumsum(seq); mn = eq.min()
        worst[i] = mn - start; under += mn < start; ruin += mn <= 0
    return dict(p_under=under/n, p_ruin=ruin/n, med_worst=float(np.median(worst)),
                p05_worst=float(np.percentile(worst, 5)))

def main():
    S = L.load()
    dates = [s["date"] for s in S if s["date"].year >= 2022]
    print("$1,000-account engineering: daily stop + MONTHLY BREAKER, real chronological path, 2022-26\n")
    print(f"{'gate/ent/breaker':24s} {'ret$':>6} {'maxDD$':>7} {'MAR':>5} {'trdDays':>7} | "
          f"{'P(under)':>8} {'P(ruin)':>7} {'medWorst':>8} {'p5Worst':>7}")
    for er_thr in [0.40, 0.55]:
        for me in [1, 3]:
            for Lm in [100, 150, 250, 10_000]:   # 10k = effectively no breaker
                du, ret, mdd, ruined = equity_path(S, er_thr, me, Lm)
                mp = month_pnls(du, dates); m = mc_month(mp)
                mar = ret/abs(mdd) if mdd < 0 else 9.99
                tag = f"g{er_thr:.2f} e{me} L{'∞' if Lm>9999 else Lm}"
                print(f"{tag:24s} {ret:6.0f} {mdd:7.0f} {mar:5.2f} {int((du!=0).sum()):7d} | "
                      f"{m['p_under']:8.1%} {m['p_ruin']:7.1%} {m['med_worst']:8.0f} {m['p05_worst']:7.0f}")

if __name__ == "__main__":
    main()

