#!/usr/bin/env python3
"""
record_daily.py -- append ONE hash-chained daily mark to the forward track record.

Reads:
  .paper.json                          (Co-Invest paper portfolio JSON, written by the daily job)
  mim_research/logs/shadow_ledger.csv  (full 4-sleeve "1.9 book" shadow mark, from report.py)
Writes:
  ledger.csv      append-only, each row SHA-256-chained to the previous (tamper-evident)
  TRACK_RECORD.md auto-rendered summary

Tamper-evidence: row_hash = sha256(payload | prev_hash). Editing/inserting/deleting any past
row breaks every subsequent hash -> verify_chain.py detects it. Daily git commits add an
independent timestamp. Idempotent per date (re-running the same day replaces today's row).

NOTE: this is a PAPER/SHADOW forward record (proves no backfill), NOT live-audited P&L.
The paper-account column is the genuinely-executed sleeve; shadow_* is a proxy of the full book.
"""
import json, csv, os, hashlib, datetime as dt

HERE   = os.path.dirname(os.path.abspath(__file__))
LEDGER = os.path.join(HERE, "ledger.csv")
PAPER  = os.path.join(HERE, ".paper.json")
SHADOW = "/Users/kaveh/mim_research/logs/shadow_ledger.csv"
MD     = os.path.join(HERE, "TRACK_RECORD.md")
COLS   = ["date","paper_equity","shadow_prog_equity","shadow_prog_ret","C1","C2","M","T","prev_hash","row_hash"]
PAYLOAD_KEYS = ["date","paper_equity","shadow_prog_equity","shadow_prog_ret","C1","C2","M","T"]


def fnum(x, d=float("nan")):
    try: return float(x)
    except (TypeError, ValueError): return d

def read_paper():
    if not os.path.exists(PAPER): return float("nan")
    try:
        a = json.load(open(PAPER)).get("account", {})
        return fnum(a.get("equity") or a.get("account_value"))
    except Exception: return float("nan")

def read_shadow():
    if not os.path.exists(SHADOW): return {}
    try:
        rows = list(csv.DictReader(open(SHADOW)))
        return rows[-1] if rows else {}
    except Exception: return {}

def row_hash(row, prev):
    payload = "|".join(str(row.get(k, "")) for k in PAYLOAD_KEYS) + "|" + prev
    return hashlib.sha256(payload.encode()).hexdigest()

def render(rows):
    pe = [(r["date"], fnum(r["paper_equity"])) for r in rows if fnum(r["paper_equity"]) == fnum(r["paper_equity"])]
    lines = ["# Program v3.2 — Forward Track Record  *(tamper-evident, hash-chained)*",
             f"*Auto-generated {dt.date.today()} · {len(rows)} daily marks · PAPER/SHADOW (not live-audited)*", ""]
    if pe:
        d0, e0 = pe[0]; d1, e1 = pe[-1]
        ret = (e1/e0 - 1)*100 if e0 else 0.0
        lines += [f"- **Paper account (executed sleeve):** ${e1:,.2f}  ({ret:+.2f}% since {d0}, {len(pe)} marks)"]
        if len(pe) >= 30:
            import statistics as stt
            eq = [e for _, e in pe]
            rets = [eq[i]/eq[i-1]-1 for i in range(1, len(eq)) if eq[i-1]]
            mu = sum(rets)/len(rets) if rets else 0.0
            sd = stt.pstdev(rets) if len(rets) > 1 else 0.0
            sh = mu/sd*(365**0.5) if sd > 0 else 0.0
            lines += [f"- **Live paper Sharpe:** {sh:.2f}  (vol {sd*(365**0.5)*100:.1f}%)"]
        else:
            lines += [f"- Live stats withheld until ≥30 marks ({len(pe)}/30) — small-N is noise."]
    sh_last = rows[-1].get("shadow_prog_equity", "") if rows else ""
    if sh_last:
        lines += [f"- **Shadow full 4-sleeve book (proxy):** ${fnum(sh_last):,.2f}  (base $10,000)"]
    lines += ["", "- Integrity: `python3 verify_chain.py` · last hash `{}`".format(rows[-1]["row_hash"][:16] if rows else "—"),
              "", "**Disclosures:** paper/shadow forward record — proves no backfill, NOT live-audited P&L. "
              "Shadow = report.py proxy of the full book; paper account is the only real-fill sleeve. "
              "Backtest (Sharpe 1.90) overstates live; expected live band ~1.0–1.4 with a disclosed venue/counterparty tail."]
    open(MD, "w").write("\n".join(lines) + "\n")

def main():
    date = dt.date.today().isoformat()
    sh = read_shadow()
    row = {"date": date, "paper_equity": f"{read_paper():.2f}",
           "shadow_prog_equity": sh.get("prog_equity", ""), "shadow_prog_ret": sh.get("prog_ret", ""),
           "C1": sh.get("C1", ""), "C2": sh.get("C2", ""), "M": sh.get("M", ""), "T": sh.get("T", "")}
    rows = list(csv.DictReader(open(LEDGER))) if os.path.exists(LEDGER) else []
    rows = [r for r in rows if r["date"] != date]            # idempotent per date
    prev = rows[-1]["row_hash"] if rows else "GENESIS"
    row["prev_hash"] = prev
    row["row_hash"] = row_hash(row, prev)
    rows.append(row)
    with open(LEDGER, "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=COLS); w.writeheader(); w.writerows(rows)
    render(rows)
    print(f"[track_record] {date}  paper=${fnum(row['paper_equity']):,.2f}  "
          f"shadow_eq={row['shadow_prog_equity'] or 'n/a'}  hash={row['row_hash'][:12]}  chain_len={len(rows)}")


if __name__ == "__main__":
    main()

