def backtest(need, trail_atr, stop_cycle="90min", cap_pct=0.30):
    """Fire when `need` cycles align; stop at that cycle's quarter extreme; trail out."""
    trades = []
    i = 0
    last_day = None
    fired_today = 0
    while i < n - 5:
        if sdate[i] != last_day:
            last_day = sdate[i]
            fired_today = 0
        if tmin[i] > FLAT_MIN - 30 or fired_today >= 2 or not np.isfinite(atr[i]) or atr[i] <= 0:
            i += 1
            continue
        side = None
        if align_bear[i] >= need and align_bear[i - 1] < need:
            side = "short"
        elif align_bull[i] >= need and align_bull[i - 1] < need:
