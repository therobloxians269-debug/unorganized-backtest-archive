"""ONE rejection per day: take the single highest-confluence wick of each session.
Measures top-tick quality (max adverse excursion) as well as P&L."""
import numpy as np, pandas as pd, warnings; warnings.filterwarnings('ignore')
from crs import build_levels, rejections
FLAT=959
def trade_mae(df,R,rr=4.0,buf=2.0,max_hold=240,max_stop=60.,min_stop=1.5,
              pv=2.,comm=1.50,slip=0.25,displace=None,seed=0,cooldown=5):
    o,h,l=df.o.values,df.h.values,df.l.values
    m=(df.index.hour*60+df.index.minute).values; n=len(df)
    rng=np.random.default_rng(seed); out=[]; last=-10**9
    for _,b in R.iterrows():
        i=int(b.i); d=int(b.dir)
        if i<=last+cooldown or i+2>=n: continue
        if FLAT<=m[i]<1080: continue
        top,bot=b.top,b.bot
        if displace is not None:
            sh=displace*(1 if rng.random()<.5 else -1); top+=sh; bot+=sh
        ep=o[i+1]+(slip if d==1 else -slip)
        st=(bot-buf) if d==1 else (top+buf)
        if (d==1 and st>=ep) or (d==-1 and st<=ep): continue
        risk=abs(ep-st)
        if risk>max_stop or risk<min_stop: continue
        tg=ep+rr*risk if d==1 else ep-rr*risk
        e=min(i+1+max_hold,n); mm=m[i+1:e]
        fl=np.where((mm>=FLAT)&(mm<1080))[0]
        e2=i+1+int(fl[0]) if len(fl) else e
        hs=h[i+1:e2]; ls=l[i+1:e2]
        if len(hs)==0: continue
        sh_=(hs>=st) if d==-1 else (ls<=st)
        th=(ls<=tg) if d==-1 else (hs>=tg)
        si=int(sh_.argmax()) if sh_.any() else 10**9
        ti=int(th.argmax()) if th.any() else 10**9
        if si==10**9 and ti==10**9: k=e2-1; px=o[k]; w='time'
        elif si<=ti: k=i+1+si; px=st+(slip if d==-1 else -slip); w='stop'
        else: k=i+1+ti; px=tg; w='tgt'
        # ── top-tick quality: worst price seen against us before the exit ──
        seg_h=h[i+1:k+1]; seg_l=l[i+1:k+1]
        if len(seg_h)==0: mae=0.0; mfe=0.0
        elif d==1: mae=max(0.0,ep-seg_l.min()); mfe=max(0.0,seg_h.max()-ep)
        else:      mae=max(0.0,seg_h.max()-ep); mfe=max(0.0,ep-seg_l.min())
        pts=(ep-px) if d==-1 else (px-ep)
        out.append(dict(t=df.index[i+1],d=d,n=b.n,R=(pts*pv-comm)/(risk*pv),
                        pnl=pts*pv-comm,why=w,mins=k-i,risk=risk,mae=mae,mfe=mfe,
                        mae_tk=mae/0.25)); last=k
    return pd.DataFrame(out)

def one_per_day(R, df):
    """the single best wick of each session: highest confluence, then biggest wick."""
    R=R.copy()
    R['day']=pd.DatetimeIndex(R.t).normalize()
    R['wickfrac']=(R.top-R.bot).abs()
    R=R.sort_values(['day','n','wickfrac'],ascending=[True,False,False])
    return R.groupby('day',as_index=False).first().sort_values('i').reset_index(drop=True)

