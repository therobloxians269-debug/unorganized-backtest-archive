#!/usr/bin/env python3
"""Pre-specified EXIT variants for the two ICT modules on real 24h front-month ES.
No parameter sweeping: a fixed small menu of exits, judged OOS by era.
SB exits: 2R (baseline) / 1R / 12-bar time-stop / trail-to-BE+runner.
MOF: extreme-stretch entry filter (× daily ATR) × {anchor target, EMA-cross trail}."""
import numpy as np, pandas as pd
import ict_backtest as ib

FRIC = ib.FRIC; DPP = ib.DPP; TICK = ib.TICK
EOD = 15*3600 + 45*60   # 15:45 ET hard flat

def load():
    o = ib.load_front()[0]
    o = ib.add_5m(o)
    o = ib.add_bias(o)
    g = o.set_index("et")
    d = pd.DataFrame({"high": g["high"].resample("1D").max(), "low": g["low"].resample("1D").min(),
                      "close": g["close"].resample("1D").last()}).dropna()
    pc = d["close"].shift(1)
    tr = np.maximum(d["high"]-d["low"], np.maximum((d["high"]-pc).abs(), (d["low"]-pc).abs()))
    d["datr"] = ib.rma(tr, 14).shift(1)      # prior-day ATR (causal)
    dmap = {k.date(): v for k, v in d["datr"].items()}
    o["datr"] = o["date"].map(dmap)
    # precompute per-day arrays once
    sessions = []
    for dte, gg in o.groupby("date", sort=True):
        gg = gg.reset_index(drop=True)
        sessions.append((dte, dict(
            O=gg["open"].to_numpy(), H=gg["high"].to_numpy(), L=gg["low"].to_numpy(),
            C=gg["close"].to_numpy(), sod=gg["sod"].to_numpy(), atr1=gg["atr1"].to_numpy(),
            rsi5=gg["rsi5"].to_numpy(), atr5=gg["atr5"].to_numpy(),
            xup=gg["xup"].to_numpy(), xdn=gg["xdn"].to_numpy(), bias=gg["bias"].to_numpy(),
            datr=float(gg["datr"].iloc[0]) if pd.notna(gg["datr"].iloc[0]) else np.nan)))
    return sessions

# ------------------------------------------------------ Silver Bullet exits
def sb_manage(sdir, entry, stop, risk, H, L, C, sod, s, mode):
    reached = False; maxfav = 0.0
    tgt2 = entry + sdir*2*risk; tgt1 = entry + sdir*1*risk
    n = len(H)
    for j in range(s, n):
        hi = H[j]; lo = L[j]
        if (lo <= stop) if sdir > 0 else (hi >= stop):            # stop first (conservative)
            return sdir*(stop-entry)-FRIC, "stop"
        if mode == "2R" and ((hi >= tgt2) if sdir > 0 else (lo <= tgt2)):
            return sdir*(tgt2-entry)-FRIC, "tp"
        if mode == "1R" and ((hi >= tgt1) if sdir > 0 else (lo <= tgt1)):
            return sdir*(tgt1-entry)-FRIC, "tp"
        if sod[j] >= EOD:
            return sdir*(C[j]-entry)-FRIC, "flat"
        fav = (hi-entry) if sdir > 0 else (entry-lo)
        if mode == "time12":
            if fav >= risk and not reached:
                reached = True; stop = entry                      # move to BE at +1R
            if (not reached) and (j - s + 1) >= 12:
                return sdir*(C[j]-entry)-FRIC, "time"
        if mode == "trail1R":
            maxfav = max(maxfav, fav)
            if maxfav >= risk:
                if not reached:
                    reached = True; stop = entry
                trail = entry + maxfav - risk if sdir > 0 else entry - maxfav + risk
                stop = max(stop, trail) if sdir > 0 else min(stop, trail)
    return sdir*(C[n-1]-entry)-FRIC, "flat"

def sb_run(sessions, mode, use_bias=False):
    out = []
    for dte, a in sessions:
        O,H,L,C,sod,A,B = a["O"],a["H"],a["L"],a["C"],a["sod"],a["atr1"],a["bias"]
        liq = (sod >= 7200) & (sod < 34200)
        if liq.sum() < 30: continue
        sH = H[liq].max(); sL = L[liq].min()
        win = np.flatnonzero((sod >= 36000) & (sod < 39600))
        if win.size < 5: continue
        n = len(H); i = win[0]
        swept=False; sdir=0; structHi=structLo=np.nan; dispLo=np.inf; dispHi=-np.inf
        mss=False; ordered=False; wait=0; obar=-1; entry=stop=np.nan; fillbar=-1
        while i < n and sod[i] < 39600 + 3600:
            if not swept:
                if L[i] < sL and (not use_bias or B[i] >= 0):
                    swept=True; sdir=1; structHi=H[max(0,i-5):i].max(); dispLo=L[i]
                elif H[i] > sH and (not use_bias or B[i] <= 0):
                    swept=True; sdir=-1; structLo=L[max(0,i-5):i].min(); dispHi=H[i]
            elif not mss:
                if sdir==1:
                    dispLo=min(dispLo,L[i])
                    if C[i] > structHi and (C[i]-O[i]) >= 1.5*A[i]: mss=True
                else:
                    dispHi=max(dispHi,H[i])
                    if C[i] < structLo and (O[i]-C[i]) >= 1.5*A[i]: mss=True
            elif not ordered:
                if sdir==1 and i>=2 and L[i] > H[i-2] and (L[i]-H[i-2]) > 0.25*A[i]:
                    entry=L[i]; stop=dispLo-2*TICK; ordered=True; wait=0; obar=i
                elif sdir==-1 and i>=2 and H[i] < L[i-2] and (L[i-2]-H[i]) > 0.25*A[i]:
                    entry=H[i]; stop=dispHi+2*TICK; ordered=True; wait=0; obar=i
            else:
                if i > obar:
                    wait += 1
                    if (sdir==1 and L[i]<=entry) or (sdir==-1 and H[i]>=entry):
                        fillbar=i; break
                    if wait > 5: break
            i += 1
        if fillbar >= 0:
            risk = abs(entry-stop)
            if risk > 0:
                pts, kind = sb_manage(sdir, entry, stop, risk, H, L, C, sod, fillbar+1, mode)
                out.append((dte, pts, kind))
    return pd.DataFrame(out, columns=["date","pts","kind"])

# ------------------------------------------------------ Midnight Fade variants
def mof_run(sessions, stretch_mult, exit_mode):
    out = []
    for dte, a in sessions:
        O,H,L,C,sod = a["O"],a["H"],a["L"],a["C"],a["sod"]
        R,A5,xup,xdn,datr = a["rsi5"],a["atr5"],a["xup"],a["xdn"],a["datr"]
        m0 = np.flatnonzero(sod == 0)
        if m0.size == 0: continue
        mid = O[m0[0]]
        need = (stretch_mult * datr) if (stretch_mult > 0 and not np.isnan(datr)) else 0.0
        armL=armS=False; pos=0; entry=stop=np.nan; nT=0; n=len(C)
        for i in range(n):
            if pos != 0:
                hitS = L[i] <= stop if pos > 0 else H[i] >= stop
                if hitS:
                    out.append((dte, -abs(entry-stop)-FRIC, "sl")); pos=0; continue
                if exit_mode == "anchor":
                    if (H[i] >= mid) if pos > 0 else (L[i] <= mid):
                        out.append((dte, abs(mid-entry)-FRIC, "tp")); pos=0; continue
                else:  # ema_trail: exit when momentum flips back
                    flip = xup[i] if pos < 0 else xdn[i]
                    if flip:
                        out.append((dte, pos*(C[i]-entry)-FRIC, "trail")); pos=0; continue
                if sod[i] >= EOD:
                    out.append((dte, pos*(C[i]-entry)-FRIC, "flat")); pos=0; continue
            if not ((sod[i] >= 30600) & (sod[i] < 41400)): continue
            disc = C[i] < mid; prem = C[i] > mid
            if disc and not np.isnan(R[i]) and R[i] < 30: armL = True
            if prem and not np.isnan(R[i]) and R[i] > 70: armS = True
            if pos == 0 and nT < 2:
                strL = (mid - C[i]) >= need
                strS = (C[i] - mid) >= need
                if armL and disc and xup[i] and strL and not np.isnan(A5[i]):
                    pos=1; entry=C[i]; stop=C[i]-1.5*A5[i]; armL=False; nT+=1
                elif armS and prem and xdn[i] and strS and not np.isnan(A5[i]):
                    pos=-1; entry=C[i]; stop=C[i]+1.5*A5[i]; armS=False; nT+=1
    return pd.DataFrame(out, columns=["date","pts","kind"])

# ------------------------------------------------------ report
def line(lbl, d):
    if len(d) < 5: return f"  {lbl:12s} n={len(d):5d}  (too few)"
    p = d["pts"]
    return (f"  {lbl:12s} n={len(d):5d}  net_pt={p.mean():+.3f}  gross={p.mean()+FRIC:+.3f}  "
            f"hit={ (p>0).mean():.3f}  tot$={p.sum()*DPP:>8.0f}  ann$={p.sum()/(len(d)/252)*DPP:>7.0f}")

def report(tr, name):
    if len(tr) == 0: print(f"\n{name}: no trades"); return
    tr = tr.copy(); tr["yr"] = pd.to_datetime(tr["date"]).dt.year
    print(f"\n### {name}  ({len(tr)} trades)  exits={tr['kind'].value_counts().to_dict()}")
    print(line("ALL", tr))
    print(line("pre-2020", tr[tr.yr < 2020]))
    print(line("2020-2021", tr[(tr.yr>=2020)&(tr.yr<=2021)]))
    print(line("2022+", tr[tr.yr >= 2022]))

def main():
    S = load()
    print(f"loaded {len(S)} sessions")
    print("\n========== SILVER BULLET — exit menu (entry identical) ==========")
    for mode in ["2R","1R","time12","trail1R"]:
        report(sb_run(S, mode, use_bias=False), f"SB {mode}")
    print("\n========== MIDNIGHT FADE — stretch filter × exit ==========")
    for sm in [0.0, 0.5, 1.0]:
        for ex in ["anchor","ema_trail"]:
            report(mof_run(S, sm, ex), f"MOF stretch{sm}×dATR {ex}")

if __name__ == "__main__":
    main()

