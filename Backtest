#!/usr/bin/env python3
"""
sleeve1.py -- SLEEVE-1 CANDIDATE: integrated cross-sectional VALUE + DEFENSIVE + CARRY
on a liquid futures panel, run through a standalone gate (no-false-negative matched
test + no-false-positive battery). Momentum is intentionally EXCLUDED to stay
orthogonal to an existing momentum/trend book.

It is ONE integrated book (factors netted at the security level), not a stack of
sleeves. It is "sleeve 1" only if it clears: net Sharpe >= 0.7, OOS t > 1.5,
bootstrap CI lower bound > 0, DSR > 0.9 at HONEST N, stable walk-forward, and a flat
parameter neighborhood (no collapse off the base lookback).

Run:  python sleeve1.py            # synthetic self-test (proves the gate discriminates)
      python sleeve1.py --run      # real run AFTER you implement load_panel()
"""
from __future__ import annotations
import numpy as np, math, sys
from scipy.stats import skew as sk, kurtosis as ku, norm, ttest_1samp
ANN=math.sqrt(252)

# ----- helpers -----
def _z(X):
    mu=np.nanmean(X,1,keepdims=True); sd=np.nanstd(X,1,keepdims=True); sd[sd==0]=1e-9
    return (X-mu)/sd
def _shift(a,k):
    out=np.full_like(a,np.nan)
    if 0<k<a.shape[0]: out[k:]=a[:-k]
    elif k==0: out=a.copy()
    return out
def sharpe(x):
    x=x[np.isfinite(x)]; return x.mean()/x.std(ddof=1)*ANN if len(x)>1 and x.std()>0 else 0.0
def calmar(x):
    x=x[np.isfinite(x)]; eq=np.cumsum(x); dd=(eq-np.maximum.accumulate(eq)).min()
    return (x.mean()*252)/abs(dd) if dd<0 else float('inf')
def _rollvol(prices,win=63):
    r=np.vstack([np.zeros((1,prices.shape[1])),np.diff(np.log(prices),axis=0)])
    v=np.full_like(prices,np.nan)
    for t in range(win,prices.shape[0]): v[t]=r[t-win:t].std(0)
    return v

def carry_from_term_structure(near, far, days_far_minus_near):
    """annualized roll yield = ln(near/far) / years-between-expiries.
       near,far: (T,N) settles of nearest & 2nd contract; days_*: (N,) or (T,N)."""
    yrs=np.asarray(days_far_minus_near)/365.0
    return (np.log(near)-np.log(far))/np.where(yrs==0,np.nan,yrs)

# ----- factors (momentum intentionally excluded) -----
def _factors(prices,carry,Lval=504):
    value     = -_z(_shift(np.log(prices),Lval//2)-_shift(np.log(prices),Lval))  # long-term reversal
    defensive = -_z(_rollvol(prices))                                            # low-vol
    car       =  _z(carry)                                                       # roll yield
    rets=np.vstack([np.zeros((1,prices.shape[1])),np.diff(np.log(prices),axis=0)])
    return value,defensive,car,rets

def build_book(rets,score,target_vol=0.10/ANN,vol_win=63):
    T,N=rets.shape; W=np.zeros_like(score)
    for t in range(T):
        s=score[t]
        if np.all(np.isnan(s)): continue
        s=np.where(np.isnan(s),0.0,s); s=s-s.mean()
        iv=1.0/(np.nanstd(rets[max(0,t-vol_win):t+1],0)+1e-9)
        ws=s*iv; g=np.abs(ws).sum()
        if g>0: ws/=g
        W[t]=ws
    Wl=np.roll(W,1,0); Wl[0]=0; port=np.nansum(Wl*rets,1)
    sd=port[np.isfinite(port)].std()
    if sd>0: port*=target_vol/sd
    return port,W

def integrated_sleeve(prices,carry,w=(0.34,0.33,0.33),Lval=504):
    val,defn,car,rets=_factors(prices,carry,Lval); wv,wd,wc=w
    S=wv*np.nan_to_num(val)+wd*np.nan_to_num(defn)+wc*np.nan_to_num(car); S[:Lval]=np.nan
    port,W=build_book(rets,S); return port,W,rets

def apply_costs(rets,W,cost_bps=1.0):
    dw=np.abs(np.diff(W,axis=0,prepend=W[:1])).sum(1)
    Wl=np.roll(W,1,0); Wl[0]=0; gross=np.nansum(Wl*rets,1)
    return gross-dw*(cost_bps*1e-4), gross, dw.mean()

# ----- battery -----
def direct_test(port,split):
    IS,OOS=port[:split],port[split:]
    return dict(ISs=sharpe(IS),ISt=float(ttest_1samp(IS[np.isfinite(IS)],0).statistic),
                OOSs=sharpe(OOS),OOSt=float(ttest_1samp(OOS[np.isfinite(OOS)],0).statistic))
def walk_forward(port,k=6,emb=5):
    n=len(port); seg=n//k
    return [sharpe(port[i*seg+(emb if i>0 else 0):((i+1)*seg if i<k-1 else n)]) for i in range(k)]
def param_neighborhood(prices,carry,fracs=(-.3,-.2,0,.2,.3)):
    out={}
    for f in fracs:
        L=max(63,int(504*(1+f))); p,_,_=integrated_sleeve(prices,carry,Lval=L); out[L]=sharpe(p)
    return out
def regime_slices(port,dates,periods):
    return {nm:sharpe(port[(dates>=np.datetime64(a))&(dates<np.datetime64(b))]) for nm,(a,b) in periods.items()}
def block_bootstrap(port,block=20,n=1000,seed=0):
    p=port[np.isfinite(port)]; m=len(p); rng=np.random.default_rng(seed); nb=int(np.ceil(m/block)); sh=np.empty(n)
    for i in range(n):
        st=rng.integers(0,m,nb); idx=(st[:,None]+np.arange(block)[None,:]).ravel()[:m]%m; sh[i]=sharpe(p[idx])
    return float(np.percentile(sh,5)),float(np.percentile(sh,95))
def dsr(port,n_trials):
    p=port[np.isfinite(port)]; sd=p.std(ddof=1); srd=p.mean()/sd if sd>0 else 0
    emax=(1-np.euler_gamma)*norm.ppf(1-1/n_trials)+np.euler_gamma*norm.ppf(1-1/(n_trials*math.e))
    sr0=emax/math.sqrt(len(p)); den=math.sqrt(max(1e-9,1-float(sk(p))*srd+(float(ku(p,fisher=False))-1)/4*srd**2))
    return float(norm.cdf((srd-sr0)*math.sqrt(len(p)-1)/den))

# ----- gate -----
def gate(prices,carry,dates,*,split,n_trials,bar=0.7,cost_bps=1.0,periods=None):
    port,W,rets=integrated_sleeve(prices,carry)
    net,gross,turn=apply_costs(rets,W,cost_bps)
    print(f"\n===== SLEEVE-1 GATE: value+defensive+carry (integrated)   bar: net Sharpe >= {bar} =====")
    print(f"  full     gross Sh={sharpe(gross):.2f}  NET Sh={sharpe(net):.2f}  Calmar={calmar(net):.2f}  turnover={turn:.3f}/d")
    dt=direct_test(net,split); print(f"  matched  IS Sh={dt['ISs']:.2f}(t={dt['ISt']:.1f})   OOS Sh={dt['OOSs']:.2f}(t={dt['OOSt']:.1f})")
    wf=walk_forward(net); print(f"  walkfwd  {[round(x,2) for x in wf]}")
    print(f"  paramN   {{{', '.join(f'{k}:{v:.2f}' for k,v in param_neighborhood(prices,carry).items())}}}")
    if periods: print(f"  regimes  {{{', '.join(f'{k}:{v:.2f}' for k,v in regime_slices(net,dates,periods).items())}}}")
    lo,hi=block_bootstrap(net); print(f"  bootCI   90% Sharpe [{lo:.2f}, {hi:.2f}]")
    d=dsr(net,n_trials); print(f"  DSR      N={n_trials} -> {d:.2f}")
    ok=(sharpe(net)>=bar and dt['OOSt']>1.5 and lo>0 and d>0.9 and min(wf)>-0.5)
    print(f"  VERDICT  {'PASS - sleeve 1 locked' if ok else 'FAIL - not a sleeve'}")
    return ok

# ----- DATA INTERFACE: implemented from the local Databento-derived panel -----
def load_panel():
    """Build (prices, carry, dates, names) from mim_research/futures_panel.parquet.

    Provenance: panel was built from Databento GLBX.MDP3 by Program v3. Per (root,date)
    it has front settle `fclose`, roll-adjusted front return `fret`, 2nd-contract settle
    `nclose`, and annualized roll yield `carry_ann`.
      prices  : ratio BACK-ADJUSTED continuous = 100*cumprod(1+fret). `fret` is verified
                roll-adjusted (matches raw pct-change on non-roll days, strips the gap on
                roll days), so this is a proper back-adjusted series for the value factor.
      carry   : `carry_ann` (annualized term-structure roll yield), ffilled within a
                market's active span (rates carry is sparse -> see printout).
    Markets with <8y history are dropped.
    """
    import pandas as pd
    PATH = "/Users/kaveh/mim_research/futures_panel.parquet"
    P = pd.read_parquet(PATH); P["date"] = pd.to_datetime(P["date"])
    ret = P.pivot_table(index="date", columns="root", values="fret").sort_index()
    car = P.pivot_table(index="date", columns="root", values="carry_ann").sort_index()

    kept, dropped = [], []
    for c in ret.columns:
