"""Macro-surprise momentum on 16yr ES 1m — the pre-registered reconciliation test.

PRIOR (why this design, decided BEFORE running):
  * systematic_terminal's claims->momentum edge (the program's ONE OOS survivor, n=34,
    2024-26): big |release-hour move| on claims Thursdays -> ride sign(move) ~2h. No stop.
  * mes_mim/catalyst_momentum.py (16yr, DEAD): same-day reaction momentum with a 4-pt
    stop and FIXED-POINT magnitude filter — all cells negative.
  * Reconciliation hypothesis: the drift is real but (a) tight stops inside release-day
    noise destroy it, (b) fixed-point gates are era-inconsistent. So: era-normalized
    magnitude gate (trailing tercile), NO tight stop (0.5% disaster stop only), 2h hold.

PRE-REGISTERED SPEC (no grid search; robustness variants reported, never selected):
  detection: 08:31-bar volume >= 3x trailing-250-session median of that minute (causal).
             Thursday => CLAIMS class; other weekdays => OTHER8:30 class (CPI/PPI/NFP/...).
             FOMC class: 14:01-bar volume >= 5x trailing median (rarer, sharper).
  signal:    R = close(09:00)/close(08:30) - 1 (bars right-labeled; both known at time).
             gate: |R| in top tercile of trailing 52 same-class event |R|s (min 12 obs).
  trade:     enter at open of the 09:01-labeled bar, direction sign(R);
             exit at close of the 11:00-labeled bar; disaster stop 0.5% of entry
             (intrabar; filled at stop +1 tick slip). FOMC: react 14:00->14:15,
             enter 14:16 open, exit at 16:00 close, stop identical.
  costs:     $1.24 RT commission + 0.25 pt slip per market side (MES $5/pt).
  report:    full + eras + chronological H1/H2, hit, avg $/trade, plain t (trades are
             non-overlapping), maxDD; CONTROL = event-class days that FAIL the tercile
             gate (bottom tercile) traded identically; FADE mirror of the primary.
  bar:       full net>0 AND H2 net>0 AND t>=1.5 (primary claims, or pooled-8:30).
             Regime-conditional positivity (2024-26) => live-small + forward-test.

    PYTHONPATH=. python3 -m research.factory.events
"""
from __future__ import annotations

import datetime as dt
from pathlib import Path

import numpy as np
import pandas as pd

ROOT = Path(__file__).resolve().parents[2]
POINT = 5.0
COMM_RT = 1.24
SLIP_PT = 0.25          # 1 tick per market side
STOP_FRAC = 0.005
TRAIL_MED = 250         # sessions for the volume-median baseline
VOLX_830 = 3.0
VOLX_FOMC = 5.0
GATE_WIN = 52           # trailing same-class events for the tercile gate
GATE_MIN = 12

ERAS = [("2010-15", 2010, 2015), ("2016-19", 2016, 2019), ("2020-21", 2020, 2021),
        ("2022-23", 2022, 2023), ("2024-26", 2024, 2026)]


def minute_frame(fr: pd.DataFrame, hh: int, mm: int) -> pd.DataFrame:
    """One row per session for the bar labeled hh:mm ET (right-closed)."""
    sub = fr[(fr.index.hour == hh) & (fr.index.minute == mm)]
    return sub.groupby("session_date").first()   # at most one per session


def session_slice(fr, sd):
    return fr[fr["session_date"] == sd]


def build_events(fr: pd.DataFrame):
    """Detect event days + reaction features, fully causally. Returns a per-event frame."""
    v831 = minute_frame(fr, 8, 31)["volume"].astype(float)
    med831 = v831.rolling(TRAIL_MED, min_periods=100).median().shift(1)
    volx = v831 / med831

    c830 = minute_frame(fr, 8, 30)["close"]
    c900 = minute_frame(fr, 9, 0)["close"]

    v1401 = minute_frame(fr, 14, 1)["volume"].astype(float)
    med1401 = v1401.rolling(TRAIL_MED, min_periods=100).median().shift(1)
    volx14 = v1401 / med1401
    c1400 = minute_frame(fr, 14, 0)["close"]
    c1415 = minute_frame(fr, 14, 15)["close"]

    rows = []
    for sd in v831.index:
        wd = pd.Timestamp(sd).weekday()
        x = volx.get(sd, np.nan)
        if np.isfinite(x) and x >= VOLX_830 and sd in c830.index and sd in c900.index:
            R = c900[sd] / c830[sd] - 1.0
            cls = "CLAIMS" if wd == 3 else "OTHER830"
            rows.append((sd, cls, R, x))
        x14 = volx14.get(sd, np.nan)
        if np.isfinite(x14) and x14 >= VOLX_FOMC and sd in c1400.index and sd in c1415.index:
            R = c1415[sd] / c1400[sd] - 1.0
            rows.append((sd, "FOMC", R, x14))
    ev = pd.DataFrame(rows, columns=["session_date", "cls", "R", "volx"])

    # causal trailing-tercile gate per class (positional: session dates can repeat
    # when one day carries both an 08:30 event and FOMC)
    ev["gate"] = False
    ev["lowgate"] = False   # bottom tercile = control
    for cls in ev["cls"].unique():
        pos = np.flatnonzero((ev["cls"] == cls).values)
        absr = ev["R"].abs().iloc[pos]
        hi = absr.rolling(GATE_WIN, min_periods=GATE_MIN).quantile(2 / 3).shift(1)
        lo = absr.rolling(GATE_WIN, min_periods=GATE_MIN).quantile(1 / 3).shift(1)
        ev.iloc[pos, ev.columns.get_loc("gate")] = (absr >= hi).values
        ev.iloc[pos, ev.columns.get_loc("lowgate")] = (absr <= lo).values
    return ev.set_index("session_date")


def simulate(fr, ev, mask, sign_mult=1):
    """Trade each masked event per the pre-registered spec; return trade frame."""
    out = []
    for sd, e in ev[mask].iterrows():
        day = session_slice(fr, sd)
        if e["cls"] == "FOMC":
            t_ent, t_exit = dt.time(14, 16), dt.time(16, 0)
        else:
            t_ent, t_exit = dt.time(9, 1), dt.time(11, 0)
        tod = day.index.time
        ent_bar = day[tod == t_ent]
        if ent_bar.empty:
            continue
        entry = float(ent_bar["open"].iloc[0])
        d = int(np.sign(e["R"])) * sign_mult
        if d == 0:
            continue
        stop = entry * (1 - STOP_FRAC) if d > 0 else entry * (1 + STOP_FRAC)
        win = day[(tod >= t_ent) & (tod <= t_exit)]
        exit_px, kind = None, "time"
        for _, b in win.iterrows():
            if d > 0 and b["low"] <= stop:
                exit_px, kind = stop - SLIP_PT, "stop"; break
            if d < 0 and b["high"] >= stop:
                exit_px, kind = stop + SLIP_PT, "stop"; break
        if exit_px is None:
            last = win.iloc[-1]
            exit_px = float(last["close"]) - (SLIP_PT if d > 0 else -SLIP_PT)
        entry_f = entry + (SLIP_PT if d > 0 else -SLIP_PT)      # market entry slip
        gross_pt = d * (exit_px - entry_f)
        out.append(dict(session_date=sd, cls=e["cls"], year=pd.Timestamp(sd).year,
                        dir=d, entry=entry_f, exit=exit_px, kind=kind,
                        gross_pt=gross_pt, net=gross_pt * POINT - COMM_RT))
    return pd.DataFrame(out)


def table(tr: pd.DataFrame, label: str):
    if tr.empty:
        print(f"  {label:<28} (no trades)")
        return
    def row(sub, tag):
        if sub.empty:
            print(f"    {tag:<10} n=   0"); return
        n = len(sub); net = sub["net"]
        t = net.mean() / net.std(ddof=1) * np.sqrt(n) if n > 1 and net.std() > 0 else np.nan
        eq = net.cumsum(); dd = (eq - eq.cummax()).min()
        print(f"    {tag:<10} n={n:>4} net=${net.sum():>8.0f} avg=${net.mean():>7.2f} "
              f"hit={(net > 0).mean()*100:>4.1f}% t={t:>5.2f} maxDD=${dd:>8.0f} "
              f"stops={(sub['kind']=='stop').sum()}")
    print(f"  {label}")
    row(tr, "FULL")
    for tag, y0, y1 in ERAS:
        row(tr[(tr["year"] >= y0) & (tr["year"] <= y1)], tag)
    half = len(tr) // 2
    row(tr.iloc[:half], "H1")
    row(tr.iloc[half:], "H2  <-OOS")


def main():
    fr = pd.read_parquet(ROOT / "data" / "es_front_1m.parquet")
    ev = build_events(fr)
    print(f"events detected: {len(ev)}  by class: {ev['cls'].value_counts().to_dict()}")
    print(f"gated (top-tercile): {ev['gate'].sum()}  control (bottom-tercile): {ev['lowgate'].sum()}\n")

    print("=" * 88)
    print("PRIMARY — CLAIMS momentum (top-tercile |R|, ride 2h, 0.5% disaster stop)")
    print("=" * 88)
    tr = simulate(fr, ev, (ev["cls"] == "CLAIMS") & ev["gate"])
    table(tr, "claims / momentum")

    print("\nSECONDARY — pooled OTHER 8:30 releases (CPI/PPI/NFP/retail...)")
    tr2 = simulate(fr, ev, (ev["cls"] == "OTHER830") & ev["gate"])
    table(tr2, "other830 / momentum")

    print("\nSECONDARY — FOMC 14:00")
    tr3 = simulate(fr, ev, (ev["cls"] == "FOMC") & ev["gate"])
    table(tr3, "fomc / momentum")

    print("\nCONTROL — bottom-tercile |R| days traded identically (should be ~0/noise)")
    trc = simulate(fr, ev, (ev["cls"] != "FOMC") & ev["lowgate"])
    table(trc, "control / momentum")

    print("\nFADE mirror of primary (should be ~ -primary if drift is real)")
    trf = simulate(fr, ev, (ev["cls"] == "CLAIMS") & ev["gate"], sign_mult=-1)
    table(trf, "claims / FADE")

    outp = ROOT / "data" / "event_trades.parquet"
    pd.concat([tr.assign(fam="claims"), tr2.assign(fam="other830"),
               tr3.assign(fam="fomc")]).to_parquet(outp)
    print(f"\ntrades saved -> {outp.name}")


if __name__ == "__main__":
    main()

