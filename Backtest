"""GATE 1 feasibility spike -- is there an intraday *pulse* (revert OR follow)? (NOT validation)

Runs the M1+/M2' pipeline on the existing 1-month ES trades pilot and asks whether a
causal stretch signal has any edge net of modeled MES round-turn cost, in either
direction:

    revert : fade the extension   (short stretch>=K, long stretch<=-K)
    follow : ride the extension   (long  stretch>=K, short stretch<=-K)

Optional order-flow gate: for `revert`, require flow NOT to confirm the move
(exhaustion); for `follow`, require flow TO confirm it. Enter next bar open, exit
`horizon` bars later at the open, never across the session close. All point-in-time.

One month (~23 sessions) is an in-sample smoke test ONLY, and scanning revert/follow x
K x H x flow = 36 configs invites multiple-testing luck -- so we look for a *plateau*
of agreeing configs, not a single hero. A pulse only gates whether to BUY multi-regime
data for the real M7 gauntlet.

    PYTHONPATH=. python3 research/feasibility_spike.py
"""
from __future__ import annotations

from pathlib import Path

import numpy as np
import pandas as pd

from ope.features import build_features
from ope.instruments import get_market
from ope.tick_data import load_trades, trades_to_bars

PILOT = Path(__file__).resolve().parents[1] / "all_trades.parquet"


def _signal(df: pd.DataFrame, *, k: float, horizon: int, use_flow: bool, mode: str):
    up = df["stretch"] >= k
    dn = df["stretch"] <= -k
    sig = pd.Series(0, index=df.index, dtype="int64")
    if mode == "revert":
        sig[up] = -1
        sig[dn] = 1
        if use_flow:  # keep only when flow does NOT confirm the extension
            sig[up & (df["ofi"] > 0)] = 0
            sig[dn & (df["ofi"] < 0)] = 0
    else:  # follow
        sig[up] = 1
        sig[dn] = -1
        if use_flow:  # keep only when flow confirms the extension
            sig[up & (df["ofi"] < 0)] = 0
            sig[dn & (df["ofi"] > 0)] = 0

    entry = df["open"].shift(-1)
    exit_ = df["open"].shift(-(1 + horizon))
    sd = df["session_date"]
    valid = (
        (sig != 0) & entry.notna() & exit_.notna()
        & (sd.shift(-1) == sd) & (sd.shift(-(1 + horizon)) == sd)
    )
    gross = sig * (exit_ / entry - 1.0)
    return gross[valid]


def main() -> None:
    if not PILOT.exists():
        raise SystemExit(f"pilot parquet not found: {PILOT}")

    print(f"loading pilot trades: {PILOT.name}")
    trades = load_trades(PILOT)
    bars = trades_to_bars(trades, "1min", rth_only=True)
    df = bars.join(build_features(bars))
    print(f"RTH bars: {len(df):,} across {df['session_date'].nunique()} sessions "
          f"[{df.index.min().date()} -> {df.index.max().date()}]")

    mes = get_market("SP500").micro
    mean_px = float(df["close"].mean())
    cost_bp = mes.round_turn_cost() / (mean_px * mes.point_multiplier) * 1e4
    print(f"modeled MES round-turn cost ~ {cost_bp:.2f} bp\n")

    header = f"{'mode':>7} {'K':>4} {'H':>3} {'flow':>5} {'n':>6} {'gross_bp':>9} {'net_bp':>8} {'hit%':>6} {'t':>6}"
    print(header)
    print("-" * len(header))
    rows = []
    for mode in ("revert", "follow"):
        for use_flow in (False, True):
            for k in (1.5, 2.0, 2.5):
                for horizon in (5, 15, 30):
                    gross = _signal(df, k=k, horizon=horizon, use_flow=use_flow, mode=mode)
                    n = len(gross)
                    if n < 30:
                        continue
                    g_bp = gross.to_numpy() * 1e4
                    net_bp = g_bp - cost_bp
                    t = float(g_bp.mean() / (g_bp.std(ddof=1) / np.sqrt(n)))
                    hit = float((net_bp > 0).mean() * 100)
                    rows.append((mode, k, horizon, use_flow, n, float(g_bp.mean()),
                                 float(net_bp.mean()), hit, t))
                    print(f"{mode:>7} {k:>4} {horizon:>3} {str(use_flow):>5} {n:>6} "
                          f"{g_bp.mean():>9.2f} {net_bp.mean():>8.2f} {hit:>6.1f} {t:>6.2f}")

    print("\n--- read ---")
    for mode in ("revert", "follow"):
        mr = [r for r in rows if r[0] == mode]
        pos = [r for r in mr if r[6] > 0 and r[8] >= 2.0 and r[4] >= 50]
        best = max(mr, key=lambda r: r[6]) if mr else None
        tag = f"{mode:>7}: {len(pos)}/{len(mr)} net-positive with t>=2, n>=50"
        if best:
            tag += (f" | best net {best[6]:+.2f} bp (K={best[1]}, H={best[2]}, "
                    f"flow={best[3]}, t={best[8]:.2f}, n={best[4]})")
        print(tag)
    print("\nNOTE: 1 month, in-sample, 36 configs scanned -> a plateau is evidence, a lone "
          "config is not. A pulse only gates whether to SPEND on the M7 gauntlet.")


if __name__ == "__main__":
    main()

