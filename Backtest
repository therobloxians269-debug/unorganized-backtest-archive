"""FIB .618-rejection with displacement, rebuilt from the settled spec in memory.
15m legs, 0.618 zone, tap + close back through + displacement body, stop past the zone, 1R."""
import numpy as np, pandas as pd, warnings; warnings.filterwarnings('ignore')
def rs15(d):
    o=d.o.resample('15min',label='left',closed='left').first()
    h=d.h.resample('15min',label='left',closed='left').max()
    l=d.l.resample('15min',label='left',closed='left').min()
    c=d.c.resample('15min',label='left',closed='left').last()
    return pd.DataFrame({'o':o,'h':h,'l':l,'c':c}).dropna()
def run(df, pv=2.0, comm=0.74, slip=0.25, swing=5, minLeg=1.0, fib=0.618, zoneATR=0.15,
        dispATR=0.5, stopATR=0.1, rr=1.0, maxhold=120):
    b=rs15(df)
    tr=pd.concat([b.h-b.l,(b.h-b.c.shift()).abs(),(b.l-b.c.shift()).abs()],axis=1).max(axis=1)
    atr=tr.ewm(alpha=1/14,adjust=False).mean().shift(1)
    H,L,O,C=b.h.values,b.l.values,b.o.values,b.c.values
    A=atr.values; n=len(b)
    tod=(b.index.hour*60+b.index.minute).values
    ph=np.full(n,np.nan); pl=np.full(n,np.nan)
    for i in range(swing,n-swing):
        if H[i]==H[i-swing:i+swing+1].max(): ph[i+swing]=H[i]
        if L[i]==L[i-swing:i+swing+1].min(): pl[i+swing]=L[i]
    PH=pd.Series(ph).ffill().values; PL=pd.Series(pl).ffill().values
    out=[]; busy_until=-1
    for i in range(swing*2+14,n-1):
        if i<=busy_until: continue
        if not np.isfinite(A[i]) or A[i]<=0: continue
        if not (570<=tod[i]<=900): continue          # entries 09:30-15:00
        if not np.isfinite(PH[i]) or not np.isfinite(PL[i]): continue
        leg=PH[i]-PL[i]
        if leg<minLeg*A[i]: continue
        body=abs(C[i]-O[i])
        if body<dispATR*A[i]: continue
        # LONG: retrace down into 0.618 of an up-leg, close back above it
        lvl=PH[i]-fib*leg
        zl,zh=lvl-zoneATR*A[i], lvl+zoneATR*A[i]
        if L[i]<=zh and L[i]>=zl-1.0*A[i] and C[i]>lvl and C[i]>O[i]:
            ent=C[i]+slip; stp=min(L[i],zl)-stopATR*A[i]; risk=ent-stp
            if risk>0:
                tgt=ent+rr*risk; d=1
                for k in range(i+1,min(i+maxhold,n)):
                    if tod[k]>=955: px=O[k]-slip; break
                    if L[k]<=stp: px=stp-slip; break
                    if H[k]>=tgt: px=tgt; break
                else: k=min(i+maxhold,n)-1; px=C[k]
                out.append(dict(t=b.index[i],d=1,pnl=(px-ent)*pv-comm,R=((px-ent)*pv-comm)/(risk*pv)))
                busy_until=k; continue
        # SHORT: mirror
        lvl2=PL[i]+fib*leg
        zl2,zh2=lvl2-zoneATR*A[i], lvl2+zoneATR*A[i]
        if H[i]>=zl2 and H[i]<=zh2+1.0*A[i] and C[i]<lvl2 and C[i]<O[i]:
            ent=C[i]-slip; stp=max(H[i],zh2)+stopATR*A[i]; risk=stp-ent
            if risk>0:
                tgt=ent-rr*risk
                for k in range(i+1,min(i+maxhold,n)):
                    if tod[k]>=955: px=O[k]+slip; break
                    if H[k]>=stp: px=stp+slip; break
                    if L[k]<=tgt: px=tgt; break
                else: k=min(i+maxhold,n)-1; px=C[k]
                out.append(dict(t=b.index[i],d=-1,pnl=(ent-px)*pv-comm,R=((ent-px)*pv-comm)/(risk*pv)))
                busy_until=k
    return pd.DataFrame(out)
if __name__=='__main__':
    for f,tag,yrs in [('nq_v6.parquet','NQ 2023-25',None),('mnq_v6.parquet','MNQ 2026',None)]:
        df=pd.read_parquet(f)
        D=pd.DatetimeIndex(df.index).normalize().nunique()
        for rr in [1.0,3.0]:
            T=run(df,rr=rr)
            if len(T)<20: continue
            print(f'{tag:11s} rr {rr:.0f}R  n={len(T):4d}  {len(T)/D:4.2f}/day  '
                  f'WR {(T.pnl>0).mean()*100:5.1f}%  avgR {T.R.mean():+.3f}  $/tr {T.pnl.mean():+7.2f}  '
                  f'PF {T.pnl[T.pnl>0].sum()/max(1e-9,-T.pnl[T.pnl<0].sum()):4.2f}')

