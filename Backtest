import yfinance as yf
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

def  run_v3_without_ema(symbol='MES=F', z_thresh=2.0):
    price_df = yf.download(symbol, period='2y', interval='1h', auto_adjust=True)
    price_df.columns = [col[0] if isinstance(col, tuple) else col for col in price_df.columns]
    
    # Indicators
    df = price_df.copy()
    df['Mean'] = df['Close'].rolling(20).mean()
    df['Std'] = df['Close'].rolling(20).std()
    df['Z'] = (df['Close'] - df['Mean']) / df['Std']
    
    # ATR for Vol-Adjusted Risk
    high_low = df['High'] - df['Low']
    high_cp = np.abs(df['High'] - df['Close'].shift())
    low_cp = np.abs(df['Low'] - df['Close'].shift())
    df['ATR'] = pd.concat([high_low, high_cp, low_cp], axis=1).max(axis=1).rolling(14).mean()
    df = df.dropna()

    bal = 1000
    equity, trades, pos = [bal], [], 0
    
    for i in range(1, len(df)):
        row = df.iloc[i]
        prev = df.iloc[i-1]
        
        if pos == 0:
            # Reverted: Entry based only on Z-Score (Oversold)
            if prev['Z'] < -z_thresh:
                pos, entry = 1, row['Open']
                sl = entry - (prev['ATR'] * 2)
                tp = entry + (prev['ATR'] * 1.5)
        
        elif pos == 1:
            if row['High'] >= tp or row['Close'] >= prev['Mean']:
                exit_p = max(tp, prev['Mean'])
                pnl = (exit_p - entry) * 5 - 6.40
                bal += pnl
                trades.append(pnl)
                pos = 0
            elif row['Low'] <= sl:
                pnl = (sl - entry) * 5 - 6.40
                bal += pnl
                trades.append(pnl)
                pos = 0
        
        equity.append(bal)
    
    return equity, trades

eq_no_ema, tr_no_ema = run_v3_without_ema()

plt.figure(figsize=(12, 5))
plt.plot(eq_no_ema, color='blue', label='V3 (No EMA Filter)')
plt.title('Strategy V3: Pure Mean Reversion (EMA Filter Removed)')
plt.ylabel('Balance ($)')
plt.legend()
plt.show()

print(f'Final Balance (No EMA): ${eq_no_ema[-1]:,.2f}')
print(f'Total Trades: {len(tr_no_ema)}')
if tr_no_ema: print(f'Win Rate: {(sum(1 for t in tr_no_ema if t > 0)/len(tr_no_ema)*100):.2f}%')

