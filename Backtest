"""Corrected geometry from the user's own price labels: TINY stop (~28-63 pts on NQ) and a
target 500+ pts away = R:R 9-18:1. Entry at the top of a small zone at a swing low.
At 18:1 you only need a ~6% hit rate. Test it."""
import numpy as np, pandas as pd, warnings; warnings.filterwarnings('ignore')
TICK=0.25
def run(m, pv=2.0, comm=1.50, lb=2, zonePts=30.0, minRR=8.0, maxRR=40.0,
        majorLB=12, trendMA=100, maxwait=48, maxhold=2000, longonly=True):
    o,h,l,c=m.open.values,m.high.values,m.low.values,m.close.values
    n=len(m); idx=np.arange(n)//5
    H5=pd.Series(h).groupby(idx).max().values; L5=pd.Series(l).groupby(idx).min().values
    C5=pd.Series(c).groupby(idx).last().values
    pl=np.full(len(L5),np.nan); PH=np.full(len(H5),np.nan)
    for i in range(lb,len(L5)-lb):
        if L5[i]==L5[i-lb:i+lb+1].min(): pl[i+lb]=L5[i]
    for i in range(majorLB,len(H5)-majorLB):           # MAJOR swing high = the distant target
        if H5[i]==H5[i-majorLB:i+majorLB+1].max(): PH[i+majorLB]=H5[i]
    PHf=pd.Series(PH).ffill().values
    ma=pd.Series(C5).rolling(trendMA).mean().values
    out=[]
    for gi in range(max(trendMA,majorLB)+lb, len(L5)-1):
        if not np.isfinite(pl[gi]) or not np.isfinite(PHf[gi]) or not np.isfinite(ma[gi]): continue
        if longonly and C5[gi]<=ma[gi]: continue
        low=pl[gi]
        ent=low+zonePts; stp=low-2.0                    # entry at the TOP of the zone
        tgt=PHf[gi]
        risk=ent-stp
        if risk<TICK or tgt<=ent: continue
        rr=(tgt-ent)/risk
        if rr<minRR or rr>maxRR: continue
        st=gi*5+5
        if st>=n: break
        fill=-1
        for k in range(st,min(st+maxwait*5,n)):
            if l[k]<=ent: fill=k; break
        if fill<0: continue
        for k in range(fill+1,min(fill+maxhold,n)):
            if l[k]<=stp: px=stp-TICK; why='STOP'; break
            if h[k]>=tgt: px=tgt; why='TARGET'; break
            if k==min(fill+maxhold,n)-1: px=c[k]; why='time'; break
        else: continue
        out.append(dict(t=m.index[fill],entry=round(ent,1),stop=round(stp,1),target=round(tgt,1),
                        rr=round(rr,1),result=why,pnl=round((px-ent)*pv-comm,2)))
    return pd.DataFrame(out)
SP=[('NQ 2023-24','nq_v6.parquet',(2023,2024)),('NQ 2025','nq_v6.parquet',(2025,2025)),
    ('MNQ 2026','mnq_v6.parquet',(2026,2026))]
raw={}
for f in {x[1] for x in SP}:
    df=pd.read_parquet(f).rename(columns={'o':'open','h':'high','l':'low','c':'close'})
    raw[f]=df[['open','high','low','close']]
print(f'{"split":11s} {"zone":>5s} {"minRR":>6s} {"n":>4s} {"/day":>5s} {"WR%":>5s} {"medRR":>6s} {"$/tr":>8s} {"$/day":>7s} {"net$":>8s}')
for zone in [30.0,60.0]:
    for mrr in [8.0,12.0]:
        for nm,f,y in SP:
            df=raw[f]; s=df[(pd.DatetimeIndex(df.index).year>=y[0])&(pd.DatetimeIndex(df.index).year<=y[1])]
            T=run(s,zonePts=zone,minRR=mrr)
            if len(T)<10: print(f'{nm:11s} {zone:5.0f} {mrr:6.1f}  thin ({len(T)})'); continue
            D=pd.DatetimeIndex(s.index).normalize().nunique()
            print(f'{nm:11s} {zone:5.0f} {mrr:6.1f} {len(T):4d} {len(T)/D:5.2f} {(T.pnl>0).mean()*100:5.1f} '
                  f'{T.rr.median():6.1f} {T.pnl.mean():+8.2f} {T.pnl.sum()/D:+7.2f} {T.pnl.sum():+8.0f}')
        print()

