ANN = 365


def fetch_one(coin, max_pages=70):
    inst = f"{coin}-USDT-SWAP"
    out, after = [], None
    for _ in range(max_pages):
        params = {"instId": inst, "limit": 100}
        if after:
            params["after"] = after
        try:
            r = requests.get(URL, params=params, timeout=10).json()
        except Exception:
            break
        data = r.get("data", [])
        if not data:
            break
        out += data
        after = min(int(d["fundingTime"]) for d in data)
        time.sleep(0.12)
    df = pd.DataFrame(out)
    if df.empty:
        return df
    df["coin"] = coin
    df["t"] = pd.to_datetime(df["fundingTime"].astype("int64"), unit="ms")
    df["funding"] = df["fundingRate"].astype(float)
    return df[["t", "coin", "funding"]]


def load():
    import os
    if os.path.exists(CACHE):
        return pd.read_parquet(CACHE)
    parts = []
    for c in COINS:
        d = fetch_one(c)
        print(f"  {c}: {len(d)} funding records" + (f"  {d['t'].min().date()}->{d['t'].max().date()}" if len(d) else ""))
        if len(d):
            parts.append(d)
    allf = pd.concat(parts, ignore_index=True)
    allf.to_parquet(CACHE)
    return allf


def main():
    f = load()
    f["date"] = f["t"].dt.normalize()
    # daily funding per coin (sum of the 3x/8h intervals)
    daily = f.groupby(["date", "coin"])["funding"].sum().unstack()
    print(f"\nfunding panel: {daily.shape[1]} coins, {daily.index.min().date()} -> {daily.index.max().date()}")
    print("median annualized funding by coin (positive => longs pay shorts => short-perp harvests):")
    print((daily.median() * ANN * 100).round(1).sort_values(ascending=False).to_string())

    # ---- harvest sleeve: receive funding (short perp when funding>0), delta-neutral ----
    # position on perp = -sign(trailing 7d mean funding), lagged; pnl = -pos_perp*funding = receive
    sig = -np.sign(daily.rolling(7).mean()).shift(1)
    pnl_coin = (-sig) * daily                       # receiving side earns |funding| when aligned
    # equal-weight across available coins each day
