We already KILLED reallocation-between-sleeves (carry mirage). This is different: keep the
sleeve weights exactly as they are, but scale the WHOLE book up/down by forecast portfolio vol.
Rationale (Harvey et al 2018, Moreira-Muir): vol is forecastable, returns are not, so sizing by
vol harvests the vol-clustering premium and trims left-tail drawdowns. Works OOS for the right
reasons — it's a structural property, not a fitted parameter.

Honesty guards:
  - NO lookahead: forecast vol uses only data up to t-1, applied to the return at t.
  - MATCHED VOL: Sharpe is scale-free; for CAGR/maxDD we rescale the targeted series to the SAME
    full-sample vol as baseline, so it's "same risk, better shape?" not "you just levered up."
  - REAL leverage-change cost: changing exposure trades the book; we charge bps on |d(leverage)|.
  - MULTIPLE estimators (rolling 20/40/60, EWMA): if only one window helps, it's overfit.
  - OOS split 2020-2023 vs 2024-2026: must help (or not hurt) in BOTH halves.

    PYTHONPATH=/Users/kaveh/mim_research python3 voltarget_study.py
"""
from __future__ import annotations
import numpy as np
import pandas as pd
from scipy.stats import skew
from pm_dd_pack import build, ANN
from lib_perf import perf_stats, psr


def sharpe(r):
    r = r.dropna()
    return r.mean() / r.std() * np.sqrt(ANN) if r.std() > 0 else np.nan


def monthly_skew(r):
    m = r.resample("ME").apply(lambda x: (1 + x).prod() - 1).dropna()
    return skew(m)


def forecast_vol(port, kind, win):
    if kind == "ewma":
        # RiskMetrics-style; win is the center-of-mass in days
        fc = port.ewm(span=win, min_periods=10).std()
    else:
        fc = port.rolling(win).std()
    return fc.shift(1)  # only known at start of day t


def vol_target(port, kind="roll", win=40, lev_cap=2.0, cost_bps=5.0):
    """Scale book by target/forecast_vol. target = baseline full-sample daily vol (matched risk)."""
    target = port.std()
    fc = forecast_vol(port, kind, win)
    lev = (target / fc).clip(upper=lev_cap)
    lev = lev.fillna(1.0)                       # before the window warms up, no scaling
    scaled = lev * port
    turn = lev.diff().abs().fillna(0.0)         # fraction of book retraded to re-lever
    scaled = scaled - turn * (cost_bps / 1e4)
    return scaled.dropna(), lev, turn


def rescale_to(r, target_vol):
    """Rescale a return series to a target daily vol (for fair CAGR/maxDD at matched risk)."""
    s = r.std()
    return r * (target_vol / s) if s > 0 else r


def show(tag, r, base_vol=None):
    s = perf_stats(r, ANN)
    extra = ""
    if base_vol is not None:
        rr = rescale_to(r, base_vol)
        sm = perf_stats(rr, ANN)
        extra = f" | @matched-vol CAGR {sm['cagr']*100:5.1f}% maxDD {sm['maxdd']*100:6.1f}%"
    print(f"  {tag:30} Sharpe {s['sharpe']:5.2f} | CAGR {s['cagr']*100:5.1f}% | "
          f"vol {s['vol']*100:4.1f}% | maxDD {s['maxdd']*100:6.1f}% | mSkew {monthly_skew(r):+.2f}{extra}")


def main():
    port, j, comp, tC1, tC2 = build()
    port = port.dropna()
    base_vol = port.std()
    base_sh = sharpe(port)
    print("=" * 110)
    print(f"PORTFOLIO VOL-TARGETING — Program v3 baseline Sharpe {base_sh:.2f}, "
          f"ann vol {base_vol*np.sqrt(ANN)*100:.1f}%, {len(port)/ANN:.1f}y")
    print("=" * 110)

    print("\n[1] BASELINE")
    show("baseline (no vol target)", port, base_vol)

    print("\n[2] ESTIMATOR SWEEP  (lev cap 2.0, cost 5bps per unit leverage turnover)")
    print("    if this is real, MOST rows beat baseline — not just one cherry-picked window")
    configs = [("roll", 20), ("roll", 40), ("roll", 60), ("ewma", 20), ("ewma", 40), ("ewma", 60)]
    results = {}
    for kind, win in configs:
        r, lev, turn = vol_target(port, kind, win)
        results[(kind, win)] = (r, lev, turn)
        lturn = turn.mean() * ANN
        show(f"{kind}-{win} (lev turn {lturn:4.1f}x/y)", r, base_vol)

    print("\n[3] LEVERAGE-CAP SENSITIVITY  (roll-40; does it need crazy leverage to work?)")
    for cap in (1.25, 1.5, 2.0, 3.0):
        r, lev, turn = vol_target(port, "roll", 40, lev_cap=cap)
        show(f"cap {cap:.2f}x (max used {lev.max():.2f})", r, base_vol)

    print("\n[4] COST SENSITIVITY  (roll-40, cap 2.0; survive higher slippage on re-levering?)")
    for c in (0.0, 5.0, 10.0, 20.0):
        r, lev, turn = vol_target(port, "roll", 40, cost_bps=c)
        show(f"cost {c:4.1f} bps", r, base_vol)

    print("\n[5] OUT-OF-SAMPLE SPLIT  (roll-40, cap 2.0, 5bps) — must hold in BOTH halves")
    r, lev, turn = vol_target(port, "roll", 40)
    for lbl, a, b in (("2020-2023", 2020, 2023), ("2024-2026", 2024, 2026)):
        seg_b = port[(port.index.year >= a) & (port.index.year <= b)]
        seg_v = r[(r.index.year >= a) & (r.index.year <= b)]
        print(f"  {lbl}:  baseline Sharpe {sharpe(seg_b):5.2f}  ->  vol-target Sharpe {sharpe(seg_v):5.2f}  "
              f"(delta {sharpe(seg_v)-sharpe(seg_b):+.2f})")

    print("\n[6] SIGNIFICANCE  (PSR vs Sharpe=baseline; is the lift statistically real?)")
    r, *_ = vol_target(port, "roll", 40)
    p = psr(r, base_sh, ANN)
    print(f"  vol-target (roll-40) Sharpe {sharpe(r):.2f}; PSR vs baseline {base_sh:.2f} = {p*100:.1f}% "
          f"(P that true Sharpe actually exceeds baseline)")

    print("\n" + "=" * 110)
    print("READ: lift is real iff (a) most estimators beat baseline, (b) it survives realistic cost &")
    print("low leverage caps, (c) it holds in BOTH OOS halves. If it only works at one window / huge")
    print("leverage / zero cost, it's a mirage and we drop it like we dropped reallocation.")
    print("=" * 110)


if __name__ == "__main__":
    main()

