        o = df.o.to_numpy(float); h = df.h.to_numpy(float); l = df.l.to_numpy(float)
        c = df.c.to_numpy(float)
        idx = np.arange(len(df))

        # A1. true opens == open of first bar of their period, period start <= t
        for col, keycols in [("TMSO", ["daycycle", "q90"]), ("TSO", ["daycycle", "sess"]),
                             ("TDO", ["daycycle"])]:
            g = df.groupby(keycols, sort=False)
            first_open = g.o.transform("first").to_numpy()
            bad = np.abs(df[col].to_numpy() - first_open) > 1e-9
            print(f"  A1 {col:5s}: mismatch vs first-bar-open of its own period = {bad.sum()}"
                  f"  ({'PASS' if bad.sum()==0 else 'FAIL'})")

        # A2. dhigh/dlow are causal running extremes within the daycycle
        g = df.groupby("daycycle", sort=False)
        cm = g.h.cummax().to_numpy(); cn = g.l.cummin().to_numpy()
        print(f"  A2 dhigh causal cummax mismatch = {(np.abs(df.dhigh.to_numpy()-cm)>1e-9).sum()}"
              f" | dlow cummin mismatch = {(np.abs(df.dlow.to_numpy()-cn)>1e-9).sum()}")

        # A3. HTF ATR: compare stored atrK against (i) causal = last CLOSED K-min bar,
        #     (ii) leaky = includes the K-min bar currently in progress.
        for K, col in [(15, "atr15"), (30, "atr30"), (60, "atr60")]:
            r = df[["o", "h", "l", "c"]].resample(f"{K}min", label="left", closed="left").agg(
                {"o": "first", "h": "max", "l": "min", "c": "last"}).dropna()
            pc = r.c.shift(1)
            tr_ = np.maximum(r.h - r.l, np.maximum((r.h - pc).abs(), (r.l - pc).abs()))
            atr = tr_.rolling(14).mean()
            leaky = atr.reindex(df.index, method="ffill").to_numpy()
            causal = atr.shift(1).reindex(df.index, method="ffill").to_numpy()
            stored = df[col].to_numpy()
            m = np.isfinite(stored)
            e_leak = np.nanmax(np.abs(stored[m] - leaky[m])) if m.any() else np.nan
            e_caus = np.nanmax(np.abs(stored[m] - causal[m])) if m.any() else np.nan
            frac_diff = float(np.mean(np.abs(leaky[m] - causal[m]) > 1e-9))
            verdict = "CAUSAL(shift1) OK" if (e_caus < 1e-6 and e_leak > 1e-6) else (
                      "LEAKY!!" if e_leak < 1e-6 else "unknown recipe")
            print(f"  A3 {col}: maxerr vs causal={e_caus:.3e}  vs leaky={e_leak:.3e} "
                  f"(they differ on {frac_diff:.1%} of rows) -> {verdict}")

        # A4. no bar past 16:59 inside a daycycle; daycycle starts 18:00
        hh = df.index.hour.to_numpy(); mm = df.index.minute.to_numpy()
        firsts = df.groupby("daycycle", sort=False).head(1)
        lasts = df.groupby("daycycle", sort=False).tail(1)
        print(f"  A4 daycycle first-bar hours: {pd.Series(firsts.index.hour).value_counts().to_dict()}")
        print(f"     daycycle last-bar hours : {pd.Series(lasts.index.hour).value_counts().to_dict()}")
        bad = ((hh == 17)).sum()
        print(f"     bars stamped 17:00-17:59 (must be 0) = {bad}")


def audit_signal_truncation(B, signal_fn, nsample=200, seed=0):
    """GOLD-STANDARD CAUSALITY TEST: recompute the signal on a frame TRUNCATED at bar i.
    If the signal at i changes when future bars are deleted, it used the future."""
    sig, drn, stp = signal_fn(B)
    rng = np.random.default_rng(seed)
    if len(sig) == 0:
        return 0, 0
    pick = rng.choice(len(sig), size=min(nsample, len(sig)), replace=False)
    bad = 0
    for k in pick:
        i = int(sig[k])
        sub = B.df.iloc[: i + 1]
        Bs = Bundle(sub, "trunc")
        s2, d2, p2 = signal_fn(Bs)
        if len(s2) == 0 or s2[-1] != i or d2[-1] != drn[k] or abs(p2[-1] - stp[k]) > 1e-9:
            bad += 1
    return bad, len(pick)


# --------------------------------------------------------------------------------------
# STAGE: EXPLORE  (no trading -- raw conditional structure, IS only)
# --------------------------------------------------------------------------------------
def q_starts(B, kind):
    """bar indices that are the FIRST bar of each 90-min quarter / 6h session / daycycle."""
    if kind == "TMSO":
        m = B.q_first == np.arange(B.n)
    elif kind == "TSO":
        m = B.s_first == np.arange(B.n)
    else:
        m = B.dc_codes != np.concatenate([[-1], B.dc_codes[:-1]])
    return np.where(m)[0]


def stage_explore():
    B = bundles()["IS"]
    print("=" * 110)
    print("EXPLORE (IS ONLY, no costs) -- raw conditional structure")
    print("=" * 110)
    print(f"IS bars={B.n} daycycles={B.ndays}")
    for a in ["atr15", "atr30", "atr60"]:
        v = getattr(B, a)
        print(f"  {a}: median={np.nanmedian(v):.1f}pt  p10={np.nanpercentile(v,10):.1f} "
              f"p90={np.nanpercentile(v,90):.1f}")

    # ---------- H1/H2/H3 DRIFT ----------
    print("\n" + "-" * 110)
    print("H1-H3 DRIFT: sign of first N min after a true open -> forward move to period end")
    print("  fwd measured in ATR15 units, signed by the drift direction. >0 = drift persists.")
    print("-" * 110)
    for kind, plen, Ns in [("TMSO", 90, [3, 5, 10, 15, 20, 30, 45]),
                           ("TSO", 360, [15, 30, 45, 60, 90, 120, 180]),
                           ("TDO", 1380, [30, 60, 90, 120, 180, 240])]:
        st = q_starts(B, kind)
        endarr = {"TMSO": B.q_last, "TSO": B.s_last, "TDO": B.dc_last}[kind]
        print(f"\n  == {kind} (period {plen}m, {len(st)} periods)")
        for N in Ns:
            i0 = st
            iN = i0 + N - 1
            ok = iN < B.n
            i0, iN = i0[ok], iN[ok]
            same = (B.qcodes[iN] == B.qcodes[i0]) if kind == "TMSO" else (
                   (B.scodes[iN] == B.scodes[i0]) if kind == "TSO" else
                   (B.dc_codes[iN] == B.dc_codes[i0]))
            i0, iN = i0[same], iN[same]
            end = endarr[iN]
            atr = B.atr15[i0]
            good = np.isfinite(atr) & (atr > 0) & (end > iN)
            i0, iN, end, atr = i0[good], iN[good], end[good], atr[good]
            openpx = B.o[i0]
            d = np.sign(B.c[iN] - openpx)
            m = d != 0
            i0, iN, end, atr, d = i0[m], iN[m], end[m], atr[m], d[m]
            fwd = d * (B.c[end] - B.c[iN]) / atr
            # barrier race at +-0.5 ATR from the post-N price
            se = fwd.std(ddof=1) / math.sqrt(len(fwd))
            print(f"    N={N:4d}  n={len(fwd):5d}  fwd(ATR)={fwd.mean():+.4f} +-{se:.4f} "
                  f"t={fwd.mean()/se:+5.2f}  P(fwd>0)={np.mean(fwd>0):.3f}  "
                  f"med={np.median(fwd):+.4f}")

    # ---------- H4 BIAS: above/below true open ----------
    print("\n" + "-" * 110)
    print("H4 BIAS: price above/below the true open -> forward 30/60/90m move (signed by bias)")
    print("-" * 110)
    for col, nm in [(B.TDO, "TDO"), (B.TSO, "TSO"), (B.TMSO, "TMSO")]:
        for HOR in [30, 60, 90]:
            j = np.arange(B.n)
            fut = j + HOR
            ok = (fut < B.n) & (B.dc_codes[np.minimum(fut, B.n - 1)] == B.dc_codes)
            atr = B.atr15
            ok &= np.isfinite(atr) & (atr > 0)
            d = np.sign(B.c - col)
            ok &= d != 0
            jj = j[ok]
            fwd = d[ok] * (B.c[jj + HOR] - B.c[jj]) / atr[jj]
            se = fwd.std(ddof=1) / math.sqrt(len(fwd))
            print(f"   {nm} h={HOR:3d}m  n={len(fwd):7d} fwd={fwd.mean():+.5f} t={fwd.mean()/se:+5.2f}"
                  f"  P>0={np.mean(fwd>0):.4f}")

    # ---------- H5 FADE ----------
    print("\n" + "-" * 110)
    print("H5 FADE: first time |c - trueopen| >= X*ATR15 in a period -> forward move TOWARD open")
    print("  fwd>0 means it reverted (good for the fade).")
    print("-" * 110)
    for kind, col in [("TMSO", B.TMSO), ("TSO", B.TSO), ("TDO", B.TDO)]:
        endarr = {"TMSO": B.q_last, "TSO": B.s_last, "TDO": B.dc_last}[kind]
        codes = {"TMSO": B.qcodes, "TSO": B.scodes, "TDO": B.dc_codes}[kind]
        print(f"\n  == {kind}")
        for X in [0.25, 0.5, 0.75, 1.0, 1.5, 2.0]:
            atr = B.atr15
            dev = (B.c - col) / np.where(atr > 0, atr, np.nan)
            trig = np.abs(dev) >= X
            trig &= np.isfinite(dev)
            # first trigger per period
            dfp = pd.DataFrame({"code": codes, "trig": trig, "i": np.arange(B.n)})
            first = dfp[dfp.trig].groupby("code").i.min().to_numpy()
            if len(first) == 0:
                continue
            end = endarr[first]
            d = -np.sign(dev[first])                      # fade direction
            fwd = d * (B.c[end] - B.c[first]) / atr[first]
            m = np.isfinite(fwd) & (end > first)
            fwd = fwd[m]
            se = fwd.std(ddof=1) / math.sqrt(len(fwd))
            print(f"    X={X:4.2f}  n={len(fwd):5d}  fwd_to_end={fwd.mean():+.4f} t={fwd.mean()/se:+5.2f}"
                  f"  P(revert)={np.mean(fwd>0):.3f}")


