        pts = (e - exit_px) if side == "short" else (exit_px - e)
        out.append(dict(side=side, R=pts / r, r_pts=r, ct=ct,
                        dollars=(pts - COST_PTS) * MNQ_PT * ct, t=df.index[i]))
        i = j + 1
    return pd.DataFrame(out)


