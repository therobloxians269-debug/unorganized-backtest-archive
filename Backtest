"""
FORCED FLOW · F1 — does the READ hold up, layer by layer?

Discovery on ES TRAIN (2010-2019) only. ES DEV and NQ/MNQ are confirmation.

Each layer must clear three bars:
  1. lift    — day-clustered mean forward return, signed toward the trade
  2. inverse — the OPPOSITE condition must NOT score the same. If "result without
               effort" pays like "effort without result", we are not measuring
               absorption, we are measuring something both share.
  3. placebo — random bars matched on time of day AND on the same conditioning
               subset. Matching the subset is essential: below-VWAP and above-VWAP
               bars have opposite expected signs, so an unmatched placebo hands the
               trigger credit for the context.
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')
import data as D, absorb as AB


def build(which, **kw):
    import os
    tag = '_'.join(f'{k}{v}' for k, v in sorted(kw.items())) or 'base'
    p = f'/Users/kaveh/terminus/cache_abs_{which}_{tag}.parquet'
    if os.path.exists(p):
        return pd.read_parquet(p)
    d = D.load(which)
    day, r = D.sessions(d)
    rb = D.rth_bars(r)
    s = AB.states(day, rb, **kw)
    s.to_parquet(p)
    return s


if __name__ == '__main__':
    print('FORCED FLOW F1 — the readable model, layer by layer')
    print('=' * 100)
    s_es = build('ES')
    tr = s_es[s_es.day <= '2019-12-31'].reset_index(drop=True)
    print(f'  ES TRAIN {tr.day.min().date()}..{tr.day.max().date()}  '
          f'{tr.day.nunique():,} sessions  {len(tr):,} 5m bars')
    print(f'  ABSORPTION (az>=1.5) fires on {tr.absorb.mean():.2%} of bars, '
          f'{tr[tr.absorb].day.nunique()/tr.day.nunique():.1%} of sessions have >=1')
    print(f'  LEAN-low (>=65% of session below VWAP) on {tr.lean_lo.mean():.2%} of bars')

    below, above = tr.below.values, (~tr.below).values

    print(f'\n{"-"*100}\n  BASELINE — what does the CONTEXT alone pay? (this is what the'
          f' trigger must beat)\n{"-"*100}')
    AB.report(tr, tr.below, 'below VWAP          -> long', sign=+1, placebo=False)
    AB.report(tr, ~tr.below, 'above VWAP          -> short', sign=-1, placebo=False)
    AB.report(tr, tr.below & tr.lean_lo, 'below + LEAN        -> long', sign=+1, placebo=False)

    print(f'\n{"-"*100}\n  LAYER 1 — does ABSORPTION add anything to the context?\n{"-"*100}')
    AB.report(tr, tr.absorb & tr.below, 'ABSORB below VWAP   -> long', sign=+1, cond=below)
    AB.report(tr, tr.anti & tr.below, 'INVERSE below VWAP  -> long', sign=+1, cond=below)
    print()
    AB.report(tr, tr.absorb & ~tr.below, 'ABSORB above VWAP   -> short', sign=-1, cond=above)
    AB.report(tr, tr.anti & ~tr.below, 'INVERSE above VWAP  -> short', sign=-1, cond=above)

    print(f'\n{"-"*100}\n  decomposition — is it volume, is it range, or is it the residual?\n{"-"*100}')
    AB.report(tr, tr.heavy & tr.below, 'heavy volume only   -> long', sign=+1, cond=below)
    AB.report(tr, tr.tight & tr.below, 'tight range only    -> long', sign=+1, cond=below)

    print(f'\n{"-"*100}\n  az deciles below VWAP (is the response monotone in absorption?)\n{"-"*100}')
    b = tr[tr.below].copy()
    b['d'] = pd.qcut(b.az, 10, labels=False, duplicates='drop')
    print(f'    {"decile":<9}{"n":>7}{"mean y":>11}{"t(day)":>9}{"med az":>9}')
    for i in sorted(b.d.dropna().unique()):
        g = b[b.d == i]
        mu, t, n = AB.daycluster(g.y, g.day)
