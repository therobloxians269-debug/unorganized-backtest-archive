"""
Is the MNQ calibration miss real, or is it inside the error bar?

Checkpoint rows are NOT independent — ~17 of them come from each session, so the
naive binomial SE understates uncertainty badly. The right error bar is a bootstrap
that resamples WHOLE SESSIONS. Also checks the direction of the miss: a model that
under-states survival is conservative (it under-trades), which is a different animal
from one that over-states it.
"""
import numpy as np, pandas as pd, warnings, pickle
warnings.filterwarnings('ignore')
import data as D, feats as F
from m1_model import Model, build_events

rng = np.random.default_rng(11)

ev = {w: build_events(w) for w in ('ES', 'NQ', 'MNQ')}
es = ev['ES']
tr = es[es.day <= '2019-12-31']
full = Model().fit(tr)

print('Day-clustered bootstrap of calibration error in the traded (p>=0.80) region')
print('=' * 78)
for name in ('ES DEV', 'NQ hold', 'MNQ hold'):
    d = ev['ES'][ev['ES'].day >= '2020-01-01'] if name == 'ES DEV' else ev[name.split()[0]]
    p = full.predict(d)
    y = d.surv.values.astype(float)
    days = d.day.values
    m = p >= 0.80
    ud = np.unique(days[m])
    obs = float(y[m].mean() - p[m].mean())

    boot = np.empty(2000)
    idx_by_day = {dd: np.flatnonzero(m & (days == dd)) for dd in ud}
    for i in range(2000):
        pick = rng.choice(ud, size=len(ud), replace=True)
        ii = np.concatenate([idx_by_day[dd] for dd in pick])
        boot[i] = y[ii].mean() - p[ii].mean()
    lo, hi = np.percentile(boot, [2.5, 97.5])
    z = obs / (boot.std() + 1e-12)
    print(f'  {name:<9} sessions={len(ud):>5}  bias(actual-pred) {obs:+.4f}  '
          f'95% CI [{lo:+.4f}, {hi:+.4f}]  z={z:+.2f}  '
          f'{"CONSERVATIVE" if obs > 0 else "OPTIMISTIC"}')

print()
print('Is MNQ 2026 simply a different regime? survival base rate by market/year')
print('=' * 78)
for w in ('ES', 'NQ', 'MNQ'):
    e = ev[w]
    g = e.assign(yr=e.day.dt.year).groupby('yr').agg(
        sessions=('day', 'nunique'), surv=('surv', 'mean'))
    print(f'  {w}: ' + '  '.join(f'{int(y)}:{r.surv:.3f}(n{int(r.sessions)})'
                                 for y, r in g.iterrows()))

