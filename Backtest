"""Opening Range Breakout (Zarattini-Barbon-Aziz 2024) on 16yr ES front-month 1-min.

Honest caveat: the paper's strong results are on *Stocks in Play* (single stocks with
news), which we can't replicate on a broad index. This is the weaker index version.

Rule per session (causal):
  * opening range = first `or_min` minutes; ORH/ORL = its high/low
  * direction = sign of the opening-range return (open -> end of OR)
  * enter at ORH (long) / ORL (short) on the first breakout after the OR
  * stop at the opposite range end; exit at the stop or the session close (let it run)
  * each trade risks 1 unit; result is an R-multiple (so Sharpe == the 1%-risk account Sharpe)

    PYTHONPATH=. python3 research/validate_orb.py
"""
from __future__ import annotations

import datetime as dt
from pathlib import Path

import numpy as np
import pandas as pd

from ope.instruments import get_market
from ope.validation import gauntlet_summary, perf_stats

ROOT = Path(__file__).resolve().parents[1]
CACHE = ROOT / "data" / "es_outright_1m.parquet"
N_YEARS = 16.0


def front_month_bars() -> pd.DataFrame:
    df = pd.read_parquet(CACHE)
    et = (pd.DatetimeIndex(pd.to_datetime(df["ts_event"], utc=True))
          + pd.Timedelta(minutes=1)).tz_convert("America/New_York")
    df = df.assign(_t=et, session_date=et.date, _time=et.time)
    rth = df[(df["_time"] > dt.time(9, 30)) & (df["_time"] <= dt.time(16, 0))]
    vol = rth.groupby(["instrument_id", "session_date"], as_index=False)["volume"].sum()
    front = vol.loc[vol.groupby("session_date")["volume"].idxmax(), ["session_date", "instrument_id"]]
    front = front.rename(columns={"instrument_id": "front_iid"})
    fb = rth.merge(front, on="session_date")
    fb = fb[fb["instrument_id"] == fb["front_iid"]].sort_values("_t")
    return fb[["session_date", "open", "high", "low", "close"]]


def orb_session(o: np.ndarray, h: np.ndarray, low: np.ndarray, c: np.ndarray,
                or_min: int, cost_pts: float) -> float:
    if len(o) <= or_min:
        return 0.0
    orh, orl = h[:or_min].max(), low[:or_min].min()
    direction = 1 if c[or_min - 1] > o[0] else -1
    risk = orh - orl
    if risk <= 0:
        return 0.0
    H, L, C = h[or_min:], low[or_min:], c[or_min:]
    entry = stop = side = None
    j = 0
    for i in range(len(H)):
        if direction > 0 and H[i] >= orh:
            entry, stop, side, j = orh, orl, 1, i
            break
        if direction < 0 and L[i] <= orl:
            entry, stop, side, j = orl, orh, -1, i
            break
    if entry is None:
        return 0.0
    exitp = C[-1]
    for k in range(j, len(H)):
        if side > 0 and L[k] <= stop:
            exitp = stop
            break
        if side < 0 and H[k] >= stop:
            exitp = stop
            break
    return side * (exitp - entry) / risk - cost_pts / risk


def run_orb(bars: pd.DataFrame, or_min: int, cost_pts: float) -> pd.Series:
    out = {}
    for sd, b in bars.groupby("session_date", sort=True):
        out[sd] = orb_session(b["open"].to_numpy(), b["high"].to_numpy(),
                               b["low"].to_numpy(), b["close"].to_numpy(), or_min, cost_pts)
    return pd.Series(out, name=f"orb{or_min}")


def main() -> None:
    bars = front_month_bars()
    mes = get_market("SP500").micro
    cost_pts = mes.round_turn_cost() / mes.point_multiplier
    print(f"front-month bars: {len(bars):,} rows, {bars['session_date'].nunique()} sessions; "
          f"cost {cost_pts:.3f} pts/round-turn\n")

    grid = {f"orb{m}": run_orb(bars, m, cost_pts) for m in (5, 15, 30, 60)}
    primary = "orb5"

    print(f"{'config':>8} {'trades':>6} {'win%':>6} {'meanR':>7} {'annSh':>6} {'ann%':>7} {'maxDD-R':>8}")
    print("-" * 56)
    for n, r in grid.items():
        tr = r[r != 0]
        tpy = len(tr) / N_YEARS
        sh = float(tr.mean() / tr.std() * np.sqrt(tpy)) if len(tr) > 1 and tr.std() > 0 else 0.0
        ann = tr.mean() * tpy * 100  # each trade risks 1% -> account % per year
        dd = (r.cumsum() - r.cumsum().cummax()).min()
        print(f"{n:>8} {len(tr):>6} {(tr > 0).mean()*100:>6.1f} {tr.mean():>7.3f} "
              f"{sh:>6.2f} {ann:>7.1f} {dd:>8.1f}")

    # era + holdout robustness on the primary (trade-days only).
    tr = grid[primary][grid[primary] != 0].copy()
    tr.index = pd.to_datetime([str(d) for d in tr.index])
    pre = tr.index.year <= 2017
    def sh(x):
        return float(x.mean() / x.std() * np.sqrt(len(x) / (N_YEARS / 2))) if len(x) > 1 and x.std() > 0 else 0.0
    print(f"\n{primary} R-Sharpe: 2010-17={sh(tr[pre]):+.2f} ({int(pre.sum())} trd) | "
          f"2018-26={sh(tr[~pre]):+.2f} ({int((~pre).sum())} trd)")
    ho = tr[tr.index >= pd.Timestamp("2022-01-01")]
    print(f"  holdout 2022+: meanR={ho.mean():+.3f} win={ (ho>0).mean()*100:.0f}% n={len(ho)}")

    g = gauntlet_summary({k: v for k, v in grid.items()}, primary, n_blocks=10)
    print(f"\ngauntlet: trials={g['n_trials']} PBO={g['pbo']:.3f} PSR={g['psr']:.3f} DSR={g['dsr']:.3f}")
    print(f"VERDICT: {'PASS' if g['passed'] else 'FAIL'}")


if __name__ == "__main__":
    main()

