"""Trade engine. Guards baked in from the kill log:
   - barrier race starts at bar i+1 (never the signal bar)  [TAP-BAR LEAK]
   - same-bar stop+target ambiguity resolved as STOP        [conservative]
   - timeouts settle at market, NEVER counted as wins       [POWELL]
   - no overlapping positions -> dedupes the volume burst
   - costs: 1 tick entry slip, 1 tick stop slip, 0 on limit target, + commission
"""
import pandas as pd, numpy as np

def prep(d, K=10, WIN=60):
    d = d.copy(); d['sid'] = d.date.factorize()[0]
    g = d.groupby('sid', sort=False)
    d['disp'] = g['c'].transform(lambda s: s - s.shift(K))
    d['vol']  = g['v'].transform(lambda s: s.rolling(K).sum())
    d['lo_k'] = g['l'].transform(lambda s: s.rolling(K).min())
    piv = d.pivot_table(index='date', columns='tod', values='vol', aggfunc='mean')
    e = piv.rolling(WIN, min_periods=20).mean().shift(1).stack().rename('e').reset_index()
    d['e_vol'] = pd.DataFrame({'date':d.date.values,'tod':d.tod.values}) \
                   .merge(e, on=['date','tod'], how='left')['e'].values
    d['vn'] = d.vol / d.e_vol
    dr = d.groupby('date').agg(hi=('h','max'), lo=('l','min'))
    d['atr'] = d.date.map((dr.hi-dr.lo).rolling(20, min_periods=10).mean().shift(1))
    return d

def run(d, thr=2.5, rmult=2.0, K=10, timeout=60, buf_tick=2, tick=0.25,
        dollars_per_pt=2.0, comm=1.04, last_entry=15*60+30, invert=False):
    o,h,l,c = d.o.values, d.h.values, d.l.values, d.c.values
    sid, tod = d.sid.values, d.tod.values
    disp, vn, lok, atr = d.disp.values, d.vn.values, d.lo_k.values, d.atr.values
    hi_k = d.groupby('sid', sort=False)['h'].transform(lambda s: s.rolling(K).max()).values
    n = len(d); trades = []; i = 0
    side = -1 if invert else 1                      # invert => SHORT the same trigger
    while i < n-1:
        ok = (disp[i] < 0) and (vn[i] >= thr) and (tod[i] <= last_entry) \
             and np.isfinite(vn[i]) and np.isfinite(atr[i]) and sid[i+1] == sid[i]
        if not ok: i += 1; continue
        entry = o[i+1] + side*tick                  # market at next open, 1 tick adverse
        if side == 1:
            stop = lok[i] - buf_tick*tick
            if entry - stop <= tick: i += 1; continue
            risk = entry - stop; target = entry + rmult*risk
        else:
            stop = hi_k[i] + buf_tick*tick
            if stop - entry <= tick: i += 1; continue
            risk = stop - entry; target = entry - rmult*risk
        j = i+1; out = None
        while j < n and sid[j] == sid[i] and (j - i) <= timeout:
            if side == 1:
                if l[j] <= stop: out = (stop - tick, 'stop', j); break
                if h[j] >= target: out = (target, 'target', j); break
            else:
                if h[j] >= stop: out = (stop + tick, 'stop', j); break
                if l[j] <= target: out = (target, 'target', j); break
            j += 1
        if out is None:
            j = min(j, n-1)
            while sid[j] != sid[i]: j -= 1
            out = (c[j] - side*tick, 'timeout', j)   # settle at market, adverse tick
        px, why, jx = out
        gross = side*(px - entry)
        trades.append(dict(date=d.date.values[i], t_in=d.index[i+1], t_out=d.index[jx],
                           entry=entry, exit=px, stop=stop, target=target, risk=risk,
                           why=why, bars=jx-i, gross_pts=gross,
                           net_usd=gross*dollars_per_pt - comm, R=gross/risk,
                           vn=vn[i], atr=atr[i]))
        i = jx + 1                                   # no overlapping positions
    return pd.DataFrame(trades)

def report(t, label, ndays):
    if len(t)==0: print(f'{label}: no trades'); return None
    dd = t.groupby('date').net_usd.sum()
    tstat = dd.mean()/(dd.std(ddof=1)/np.sqrt(len(dd)))
    eq = t.net_usd.cumsum(); mdd = (eq.cummax()-eq).max()
    wr = (t.net_usd>0).mean(); tgt=(t.why=='target').mean()
    pf = t.net_usd[t.net_usd>0].sum()/max(1e-9,-t.net_usd[t.net_usd<0].sum())
    print(f'  {label:<26s} n={len(t):>5d} {len(t)/ndays:>4.1f}/day  '
          f'net=${t.net_usd.mean():+6.2f}/tr  t={tstat:+5.2f}  WR={wr:5.1%}  '
          f'PF={pf:4.2f}  tot=${t.net_usd.sum():+9,.0f}  maxDD=${mdd:,.0f}  '
          f'tgt/stop/to={tgt:.0%}/{(t.why=="stop").mean():.0%}/{(t.why=="timeout").mean():.0%}')
    return dict(n=len(t), per_day=len(t)/ndays, net=t.net_usd.mean(), t=tstat,
                wr=wr, pf=pf, total=t.net_usd.sum(), mdd=mdd)

