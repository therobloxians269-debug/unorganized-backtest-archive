"""
IGNITION — HONEST validation of a trend-aligned volatility-expansion continuation breakout.
Fixes vs draft: (1) NO lookahead — signal confirmed at bar i close, enter at bar i+1 OPEN.
                (2) costs: commission-only here; entry & exit slippage live in the fills.
                (3) valid inversion placebo. (4) real prior-day RTH close for trend gate.
                (5) IS(2010-19)/OOS(2020-26) split + per-era read.

Gates (long; short symmetric):
  ignition : opening 5m candle range > qualify_pct * prior-day box range
  trend    : signal bar closes on trend side of session VWAP AND vs prior-day RTH close
  momentum : signal bar is an expansion bar (range>expanding-mean) closing in its trend third
Trigger    : first OR-range break after the OR window that passes the active gates.
Entry      : next bar OPEN +/- 1 tick slip.   Stop: opposite side of the opening range.
Manage     : leg A -> +1R partial ; leg B -> chandelier trail (or EOD flat).
Bar to clear: netR/contract > +0.20R  (naive ORB here ~ -0.1R; apex_eval logged -0.08R).
"""
import pandas as pd, numpy as np
from strategy import POINT, TICK, SLIP_TICKS, COMMISSION_RT

BARS = pd.read_parquet("/Users/kaveh/box_theory/bars5.parquet")
BOXES = pd.read_parquet("/Users/kaveh/box_theory/boxes.parquet")
IS_END = pd.Timestamp("2020-01-01", tz="America/New_York")
COMM_PTS = COMMISSION_RT / POINT          # commission only; slippage is in the fills
SLIP = SLIP_TICKS * TICK

# real prior-day RTH close for the trend gate
_rthclose = BARS.groupby("day").close.last()
PRIOR_CLOSE = _rthclose.shift(1).to_dict()

class Cfg:
    def __init__(s, **k):
        s.qualify_pct=k.get("qualify_pct",0.20); s.or_bars=k.get("or_bars",3)
        s.gate_ign=k.get("gate_ign",True); s.gate_trend=k.get("gate_trend",True); s.gate_mom=k.get("gate_mom",True)
        s.trail_mult=k.get("trail_mult",1.0); s.max_risk_frac=k.get("max_risk_frac",0.6)
        s.invert=k.get("invert",False); s.eod=k.get("flat_by",pd.Timestamp("15:55").time())

def _legpnl(direction, entry, stop, t1, g, ientry, cfg, atr):
    """return (legA_pnl_pts, legB_pnl_pts) net of exit slippage (not commission)."""
    n=len(g); legA=legB=None; ext=entry
    for j in range(ientry+1, n):
        b=g.iloc[j]; cutoff=b.et.time()>=cfg.eod
        hit_stop=(b.low<=stop) if direction>0 else (b.high>=stop)
        if legA is None:
            hitT=(b.high>=t1) if direction>0 else (b.low<=t1)
            if hit_stop and not hitT: legA=direction*(stop-entry)-SLIP
            elif hitT:                legA=direction*(t1-entry)
            elif cutoff:              legA=direction*(b.close-entry)-SLIP
        ext = max(ext,b.close) if direction>0 else min(ext,b.close)
        trail = ext - direction*cfg.trail_mult*atr.iloc[j]
        if legB is None:
            hit_trail=(b.close<=trail) if direction>0 else (b.close>=trail)
            if hit_stop:    legB=direction*(stop-entry)-SLIP
            elif hit_trail: legB=direction*(b.close-entry)-SLIP
            elif cutoff:    legB=direction*(b.close-entry)-SLIP
        if legA is not None and legB is not None: break
    return legA, legB

def run(cfg):
    rows=[]
    for day, g in BARS.groupby("day"):
        if day not in BOXES.index: continue
        box=BOXES.loc[day]
        if not np.isfinite(box.box_range) or box.box_range<=0: continue
        pc=PRIOR_CLOSE.get(day)
        if cfg.gate_trend and (pc is None or not np.isfinite(pc)): continue
        g=g.reset_index(); n=len(g)
        if n<cfg.or_bars+3: continue
        oc=g.iloc[0]
        if cfg.gate_ign and (oc.high-oc.low)<=cfg.qualify_pct*box.box_range: continue
        orh=g.high.iloc[:cfg.or_bars].max(); orl=g.low.iloc[:cfg.or_bars].min()
        tp=(g.high+g.low+g.close)/3.0
        vwap=(tp*g.volume).cumsum()/g.volume.cumsum().replace(0,np.nan)
        atr=(g.high-g.low).expanding().mean()
        sig=None
        for i in range(cfg.or_bars, n-2):   # need i+1 for entry
            b=g.iloc[i]
            for dirn,brk,lvl,orstop in [(+1,b.high>=orh,orh,orl),(-1,b.low<=orl,orl,orh)]:
                if not brk: continue
                if cfg.gate_trend:
                    if dirn>0 and not (b.close>vwap.iloc[i] and b.close>pc): continue
                    if dirn<0 and not (b.close<vwap.iloc[i] and b.close<pc): continue
                if cfg.gate_mom:
                    br=b.high-b.low
                    if br<=0 or br<atr.iloc[i]: continue
                    pos=(b.close-b.low)/br
                    if dirn>0 and pos<0.66: continue
                    if dirn<0 and pos>0.34: continue
                sig=(i,dirn,orstop); break
            if sig: break
        if sig is None: continue
        i,dirn,orstop=sig
        if cfg.invert: dirn=-dirn
        # honest entry: NEXT bar open + slip
        entry=g.iloc[i+1].open + dirn*SLIP
        risk=abs(entry-orstop)
        if risk<=TICK or risk>cfg.max_risk_frac*box.box_range: continue
        stop=entry-dirn*risk           # symmetric structural risk (adverse side)
        t1=entry+dirn*risk
        a,bp=_legpnl(dirn,entry,stop,t1,g,i+1,cfg,atr)
        for pnl in (a,bp):
            if pnl is None: continue
            rows.append({"day":day,"R":(pnl-COMM_PTS)/risk})
    if not rows: return None
    df=pd.DataFrame(rows)
    def agg(d):
        if len(d)==0: return dict(legs=0)
        return dict(legs=len(d), R=round(d.R.mean(),3), win=round((d.R>0).mean()*100,1), totR=round(d.R.sum(),1))
    return {"all":agg(df), "IS":agg(df[df.day<IS_END]), "OOS":agg(df[df.day>=IS_END]),
            "ntrades":df.day.nunique()}

def show(name,r):
    if r is None: print(f"  {name:<30} no trades"); return
    a=r["all"]; mark="CLEARS +0.20R" if a["R"]>0.20 else ("marginal" if a["R"]>0 else "FAILS")
    def f(x): return f"R={x['R']:+.3f} win={x['win']:>4.1f}% ({x['legs']})" if x.get('legs') else "n/a"
    print(f"  {name:<30} ALL {f(a):<26} | IS {f(r['IS']):<26} | OOS {f(r['OOS']):<26} [{mark}]")

if __name__=="__main__":
    print("="*140)
    print("IGNITION ablation (NO lookahead, next-bar entry) — real ES 1m 2010-26, MES costs. Clear bar: netR/contract > +0.20R")
    print("="*140)
    show("naive (no gates)",      run(Cfg(gate_ign=False,gate_trend=False,gate_mom=False)))
    show("+ ignition only",       run(Cfg(gate_ign=True, gate_trend=False,gate_mom=False)))
    show("+ trend(VWAP) only",    run(Cfg(gate_ign=False,gate_trend=True, gate_mom=False)))
    show("+ momentum only",       run(Cfg(gate_ign=False,gate_trend=False,gate_mom=True)))
    show("+ ignition + trend",    run(Cfg(gate_ign=True, gate_trend=True, gate_mom=False)))
    show("FULL (ign+trend+mom)",  run(Cfg()))
    print("  --- controls ---")
    show("FULL inverted (fade)",  run(Cfg(invert=True)))

