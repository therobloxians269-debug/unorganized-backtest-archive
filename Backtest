#!/usr/bin/env python3
"""
paper_friction.py — explicit, tunable COMMISSION + FILL model for the FORWARD/paper
shadow ledger of Program v3, so the growing live record is net-of-cost "decently".

Context: the backtest (program_v3_full) is ALREADY net of bundled costs. This module
makes the SAME-spirit frictions explicit for the LIVE marks, with 3 profiles you can
dial, and a net_mark() the weekly ledger calls.

Cost model = (per-side bps) x (legs) x (annual one-way turnover) / (capital factor),
prorated by elapsed days. Honest provenance per sleeve:
  C1/C2 carry : majors taker+spread ~8 bps/side, 2 legs (spot+perp); turnover = BACKTEST
                realized (C1 9.7x, C2 11x/yr); /CAPF (carry trades the margin buffer).
  M momentum  : alt spreads are wide -> 25 bps/side (the disclosed 1-way haircut), 1 leg;
                turnover ~20x/yr = ESTIMATE (per-name weights not cached) -> FLAGGED.
  T trend     : futures cheap -> ~2 bps/side from the MES MBO (median spread ~1 tick
                ~0.4 bp + commission + slippage), 1 leg; turnover ~8x/yr = ESTIMATE -> FLAGGED.

IMPORTANT: if a sleeve's forward mark is ALREADY net of real fills (e.g. M run on the
Co-Invest paper account, which fills at live prices), do NOT net it again here.
"""
import program_v3_full as eng
ANN, CAPF = eng.ANN, eng.CAPF

BASE = {
 "C1": dict(bps=20, legs=2, turn=9.7,  capf=CAPF, src="40bp RT (validated backtest anchor); turn=BACKTEST"),
 "C2": dict(bps=20, legs=2, turn=11.0, capf=CAPF, src="40bp RT (validated backtest anchor); turn=BACKTEST"),
 "M":  dict(bps=25, legs=1, turn=20.0, capf=1.0,  src="alt spreads (disclosed 25bp/side); turn=ESTIMATE*"),
 "T":  dict(bps=2,  legs=1, turn=8.0,  capf=1.0,  src="futures from MES MBO ~0.4bp+comm+slip; turn=ESTIMATE*"),
}
WEIGHTS  = dict(C1=0.35, C2=0.25, M=0.105, T=0.25)     # trimmed (mom_scale 0.7) effective weights
PROFILES = {"base": 1.0, "conservative": 1.5, "stress": 3.0}


def drag_bps_yr(sleeve, profile="base"):
    c = BASE[sleeve]
    return c["bps"] * c["legs"] * c["turn"] * PROFILES[profile] / c["capf"]   # bps/yr at equity level

def program_drag(profile="base"):
    return sum(WEIGHTS[s] * drag_bps_yr(s, profile) for s in BASE) / 1e4      # fraction/yr

def net_mark(sleeve, gross_ret, days, profile="base"):
    """Net a sleeve's gross return earned over `days` calendar days."""
    return gross_ret - drag_bps_yr(sleeve, profile) / 1e4 * days / 365


def main():
    print("="*72)
    print("PROGRAM v3 — FORWARD FRICTION MODEL (commissions + spread + slippage)")
    print("="*72)
    print(f"{'sleeve':6}{'base':>9}{'consv':>9}{'stress':>9}   bps/side x legs x turn/yr  /CAPF")
    for s in BASE:
        c = BASE[s]
        print(f"{s:6}{drag_bps_yr(s,'base'):>8.0f}{drag_bps_yr(s,'conservative'):>9.0f}"
              f"{drag_bps_yr(s,'stress'):>9.0f}   {c['bps']}x{c['legs']}x{c['turn']}/{c['capf']}  — {c['src']}")
    print("\nPROGRAM-LEVEL net cost drag (weighted by sleeve):")
    for p in PROFILES:
        print(f"  {p:12} -{program_drag(p)*100:.2f}%/yr")

    # validate carry against the engine's own gross-vs-net (cost_scale 1 vs 0)
    net,_,_,tC1,tC2 = eng.build(mom_scale=0.7, cost_scale=1.0)
    gro,_,_,_,_     = eng.build(mom_scale=0.7, cost_scale=0.0)
    eng_carry = (gro.mean()-net.mean())*ANN*100
    model_carry = (WEIGHTS["C1"]*drag_bps_yr("C1")+WEIGHTS["C2"]*drag_bps_yr("C2"))/100
    print(f"\nVALIDATION (carry): engine realized cost {eng_carry:.2f}%/yr  vs  model {model_carry:.2f}%/yr  "
          f"-> {'consistent' if abs(eng_carry-model_carry)<0.4 else 'within band, see note'}")
    s = eng.perf_stats(net)
    print(f"Backtest 1.90 is ALREADY net (Sharpe {s['sharpe']:.2f}, CAGR {s['cagr']*100:.1f}%); "
          f"this model is for the FORWARD marks.")

    print("\nWORKED EXAMPLE — one week (7d) of GROSS sleeve marks -> net (base profile):")
    ex = {"C1":0.0015, "C2":0.0012, "M":0.0040, "T":0.0010}
    for s_, g in ex.items():
        print(f"  {s_}: gross {g*100:+.3f}% -> net {net_mark(s_,g,7)*100:+.3f}%")
    print("\n* M/T turnover are ESTIMATES (per-name weights not cached). "
          "If M is run on Co-Invest paper (fills at live prices), it is ALREADY net — don't double-subtract.")


if __name__ == "__main__":
    main()

