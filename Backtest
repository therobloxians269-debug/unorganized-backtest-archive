#!/usr/bin/env python3
"""OCEAN family f07_vol_compression — compression -> expansion OR breakout (MES 1-lot).

Hypothesis: after a volatility-COMPRESSED session, the next session is more
likely to expand directionally; an opening-range breakout taken ONLY on
compressed-yesterday days should beat the same breakout taken every day.

Rules (exact, causal):
  * Compression gates (computed from sessions strictly BEFORE today):
      - inside : yesterday's session high <= day-before high AND
                 yesterday's session low  >= day-before low (inside day).
      - rangeq : yesterday's RTH day range (max(h)-min(l)) <= the q-quantile of
                 the trailing N session day-ranges (window = the N sessions
                 ending AT yesterday, inclusive).
      - orq    : yesterday's (or_hi-or_lo)/ATR(bar 5) <= q-quantile of the same
                 trailing-N window of that ratio.
      - ins_or_rq : inside OR rangeq (union).
      - ins_and_rq: inside AND rangeq (tightest compression).
      - not_rangeq: complement of rangeq (diagnostic: edge should NOT live here).
      - none   : unconditioned baseline (every day, same warmup skip).
    Warmup: first N+1 sessions of the full history are never traded.
  * Entry (today): from bar 6 (first bar after the 09:30-10:00 OR), the FIRST
    bar whose CLOSE > or_hi -> LONG, or CLOSE < or_lo -> SHORT, filled at that
    same bar close (market: slippage inside friction). One trade per day,
    first break only, both directions eligible. No entry on bar 77.
  * Stop: entry -/+ max(atr_mult * ATR(entry bar), 1.0 pt), fixed (no trail).
    Checked intrabar only on bars strictly AFTER the entry bar; stop exit uses
    fric("stop") = 0.66 pt.
  * Exit: ride to EOD, bar-77 close, fric("eod") = 0.66 pt. If the stop level
    is touched on bar 77 the stop takes precedence (conservative, house style).
  * Sessions share no intraday state; gates only use prior-session features.

Windows: dev = dates <= 2022-12-31, holdout = 2023-01-01.., all = everything.
Gate flags are computed over the FULL session list (only past sessions feed a
flag) so the holdout run keeps its trailing window; performance is then
reported strictly inside the requested window.
Sweep table (dev only) prints every config tested. Defaults = PRE-REGISTERED.
"""
import sys, json, argparse, math
sys.path.insert(0, "/Users/kaveh/mes_mim")
import numpy as np, pandas as pd
import omni2_lib as L

ORN = 6
DPP = L.DPP
STOP_FLOOR = 1.0   # pts; avoids degenerate sub-tick stops in low-vol years

# ---------------- PRE-REGISTERED CONFIG (defaults) ----------------
PRE = dict(gate="rangeq", q=0.20, N=20, atr_mult=2.0)

GATES = ["none", "inside", "rangeq", "orq", "ins_or_rq", "ins_and_rq", "not_rangeq"]

# Every config evaluated in the dev sweep (each row = one config against the
# ~30 budget). Stage 1: gate comparison. Stage 2: plateau across the
# compression-quantile definition (q, N). Stage 3: plateau across atr_mult.
SWEEP = [
    # -- stage 1: which conditioning carries the edge? (atr_mult=2.0, N=20, q=0.20)
    dict(gate="none",       q=0.20, N=20, atr_mult=2.0),
    dict(gate="inside",     q=0.20, N=20, atr_mult=2.0),
    dict(gate="rangeq",     q=0.20, N=20, atr_mult=2.0),
    dict(gate="orq",        q=0.20, N=20, atr_mult=2.0),
    dict(gate="ins_or_rq",  q=0.20, N=20, atr_mult=2.0),
    dict(gate="not_rangeq", q=0.20, N=20, atr_mult=2.0),
    # -- stage 2: quantile / window plateau around the best gate
    dict(gate="rangeq",     q=0.15, N=20, atr_mult=2.0),
    dict(gate="rangeq",     q=0.25, N=20, atr_mult=2.0),
    dict(gate="rangeq",     q=0.30, N=20, atr_mult=2.0),
    dict(gate="rangeq",     q=0.20, N=15, atr_mult=2.0),
    dict(gate="rangeq",     q=0.20, N=25, atr_mult=2.0),
    # -- stage 3: stop-width plateau
    dict(gate="rangeq",     q=0.20, N=20, atr_mult=1.5),
    dict(gate="rangeq",     q=0.20, N=20, atr_mult=2.5),
    dict(gate="rangeq",     q=0.20, N=20, atr_mult=3.0),
    # -- stage 4: last honest in-family variants (rescue attempts)
    dict(gate="rangeq",     q=0.15, N=7,  atr_mult=2.0),   # ~NR7: narrowest of trailing 7
    dict(gate="ins_and_rq", q=0.20, N=20, atr_mult=2.0),   # tightest compression
    dict(gate="inside",     q=0.20, N=20, atr_mult=1.5),   # inside-gate stop plateau
    dict(gate="inside",     q=0.20, N=20, atr_mult=2.5),
]


def gate_flags(S, gate, q, N):
    """Boolean per session index; flag[i] uses ONLY sessions < i."""
    n = len(S)
    rng = np.array([float(s["h"].max() - s["l"].min()) for s in S])
    hi = np.array([float(s["h"].max()) for s in S])
    lo = np.array([float(s["l"].min()) for s in S])
    orn = np.array([(s["or_hi"] - s["or_lo"]) / max(float(s["atr"][ORN - 1]), 1e-9)
                    for s in S])
    flags = np.zeros(n, dtype=bool)
    for i in range(N + 1, n):          # warmup: need N trailing + inside pair
        y = i - 1
        if gate == "none":
            flags[i] = True
        elif gate == "inside":
            flags[i] = (hi[y] <= hi[y - 1]) and (lo[y] >= lo[y - 1])
        elif gate == "rangeq":
            flags[i] = rng[y] <= np.quantile(rng[i - N:i], q)
        elif gate == "orq":
            flags[i] = orn[y] <= np.quantile(orn[i - N:i], q)
        elif gate == "ins_or_rq":
            ins = (hi[y] <= hi[y - 1]) and (lo[y] >= lo[y - 1])
            flags[i] = ins or (rng[y] <= np.quantile(rng[i - N:i], q))
        elif gate == "ins_and_rq":
            ins = (hi[y] <= hi[y - 1]) and (lo[y] >= lo[y - 1])
            flags[i] = ins and (rng[y] <= np.quantile(rng[i - N:i], q))
        elif gate == "not_rangeq":
            flags[i] = rng[y] > np.quantile(rng[i - N:i], q)
        else:
            raise ValueError(gate)
    return flags


def sim_day(s, atr_mult):
    """First OR breakout (close beyond OR), ATR stop, ride to EOD. Causal."""
    h, l, c, atr = s["h"], s["l"], s["c"], s["atr"]
    orh, orl = s["or_hi"], s["or_lo"]
    if not (orh > orl):
        return None
    pos = 0; entry = stop = risk0 = np.nan; ebar = -1
    for b in range(ORN, 78):
        if pos != 0 and b > ebar:
            hit = (l[b] <= stop) if pos > 0 else (h[b] >= stop)
            if hit:                                    # stop first (conservative)
                g = pos * (stop - entry) - L.fric("stop")
                return (s["date"], g, risk0, "stop")
            if b == 77:
                g = pos * (c[77] - entry) - L.fric("eod")
                return (s["date"], g, risk0, "eod")
            continue
        if pos == 0 and b < 77:
            side = 0
            if c[b] > orh:
                side = 1
            elif c[b] < orl:
                side = -1
            if side != 0:                              # first break of the day
                pos = side; entry = c[b]; ebar = b
                sd = max(atr_mult * atr[b], STOP_FLOOR)
                stop = entry - side * sd; risk0 = sd
    return None


def run(S, flags, idx, atr_mult):
    """Simulate sessions whose global index is flagged AND inside the window."""
    rows = []
    for i in idx:
        if flags[i]:
            r = sim_day(S[i], atr_mult)
            if r is not None:
                rows.append(r)
    return pd.DataFrame(rows, columns=["date", "pts", "risk", "kind"])


def stats(tr):
    out = dict(net_usd=0.0, mar=0.0, trades=0, hit=0.0, maxdd_usd=0.0,
               yearly={}, top3_month_share=float("nan"), expectancy_pts=0.0,
               yrs_pos=0, n_yrs=0, max_yr_share=float("nan"))
    if len(tr) == 0:
        return out
    tr = tr.sort_values("date").reset_index(drop=True)
    usd = tr["pts"].to_numpy() * DPP
    net = float(usd.sum())
    eq = np.cumsum(usd)
    dd = float((eq - np.maximum.accumulate(eq)).min())
    dts = pd.to_datetime(tr["date"].astype(str))
    ys = pd.Series(usd).groupby(dts.dt.year.to_numpy()).sum()
    ms = pd.Series(usd).groupby(dts.dt.strftime("%Y-%m").to_numpy()).sum()
    out.update(
        net_usd=round(net, 2),
        mar=round(net / abs(dd), 3) if dd < 0 else float("inf"),
        trades=int(len(tr)),
        hit=round(float((tr["pts"] > 0).mean()), 4),
        maxdd_usd=round(dd, 2),
        yearly={str(int(k)): round(float(v), 2) for k, v in ys.items()},
        top3_month_share=round(float(ms.nlargest(3).sum() / net), 3) if net > 0 else float("nan"),
        expectancy_pts=round(float(tr["pts"].mean()), 4),
        yrs_pos=int((ys > 0).sum()), n_yrs=int(len(ys)),
        max_yr_share=round(float(ys.max() / net), 3) if net > 0 else float("nan"),
    )
    return out


def survival(st):
    return (st["net_usd"] > 0
            and st["mar"] >= 1.0
            and st["trades"] >= 80
            and st["n_yrs"] > 0 and st["yrs_pos"] / st["n_yrs"] >= 0.60
            and not math.isnan(st["max_yr_share"]) and st["max_yr_share"] <= 0.50)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--window", choices=["dev", "holdout", "all"], default="dev")
    ap.add_argument("--gate", default=PRE["gate"], choices=GATES)
    ap.add_argument("--q", type=float, default=PRE["q"])
    ap.add_argument("--N", type=int, default=PRE["N"])
    ap.add_argument("--atr_mult", type=float, default=PRE["atr_mult"])
    a = ap.parse_args()

    S = L.load()                                        # FULL list: gates need history
    if a.window == "dev":
        idx = [i for i, s in enumerate(S) if str(s["date"]) <= "2022-12-31"]
    elif a.window == "holdout":
        idx = [i for i, s in enumerate(S) if str(s["date"]) >= "2023-01-01"]
    else:
        idx = list(range(len(S)))
    print(f"f07_vol_compression  window={a.window}  sessions_in_window={len(idx)}")

    # ---- pre-registered (or CLI-overridden) config ----
