        dataset="GLBX.MDP3", schema="ohlcv-1m",
        symbols=["ES.v.0"], stype_in="continuous",
        start=start, end=pd.Timestamp.utcnow().strftime("%Y-%m-%d"))
    df = data.to_df()
    df = df.rename(columns=str.lower)[["open", "high", "low", "close", "volume"]]
    for c in ("open", "high", "low", "close"):
        if df[c].dtype == "int64":
            df[c] = df[c] / 1e9     # fixed-precision guard
    return df

def load_file(path):
    df = pd.read_parquet(path) if path.endswith((".parquet", ".pq")) else pd.read_csv(path)
    tcol = next(c for c in df.columns if c.lower() in ("ts_event", "ts", "timestamp", "datetime", "time"))
    df[tcol] = pd.to_datetime(df[tcol], utc=True)
    df = df.set_index(tcol).rename(columns=str.lower)
    return df[["open", "high", "low", "close", "volume"]]

# ------------------------- adapter: 1m UTC -> harness days -------------------------
def build_days(df1m, verbose=True):
    df = df1m.copy()
    df.index = df.index.tz_convert(TZ)
    df = df.sort_index()
    t = df.index.time
    import datetime as dt
    RTH_O, RTH_C = dt.time(9, 30), dt.time(16, 0)
    rth = df[(t >= RTH_O) & (t < RTH_C)]
    # 5m RTH bars, stamped at bar start
    b5 = rth.resample("5min", label="left", closed="left").agg(
        {"open": "first", "high": "max", "low": "min", "close": "last", "volume": "sum"}).dropna(subset=["open"])
    b5 = b5[(b5.index.time >= RTH_O) & (b5.index.time < RTH_C)]
    days, skipped = [], 0
    prev = None           # dict(hi, lo, close_ts) of most recent RTH session (any length)
    dates = sorted(set(rth.index.date))
    for d in dates:
        r1 = rth[rth.index.date == d]
        g5 = b5[b5.index.date == d]
        hi, lo = float(r1["high"].max()), float(r1["low"].min())
        close_ts = r1.index.max()
        if prev is not None and len(g5) == 78:
            on = df[(df.index > prev["close_ts"]) & (df.index < g5.index.min())]
            if len(on):
                on_hi, on_lo = float(on["high"].max()), float(on["low"].min())
            else:
                on_hi, on_lo = -1e18, 1e18
            days.append(dict(
                o=g5["open"].to_numpy(float), h=g5["high"].to_numpy(float),
                l=g5["low"].to_numpy(float), c=g5["close"].to_numpy(float),
                v=g5["volume"].to_numpy(float),
                prev_hi=prev["hi"], prev_lo=prev["lo"],
                spent_hi=bool(on_hi >= prev["hi"]), spent_lo=bool(on_lo <= prev["lo"]),
                dtype="real", date=str(d)))
        elif prev is not None:
            skipped += 1
        prev = dict(hi=hi, lo=lo, close_ts=close_ts)
    if verbose:
        print(f"[adapter] sessions={len(dates)} traded_days={len(days)} skipped(non-78-bar)={skipped} "
              f"range={days[0]['date']}..{days[-1]['date']}" if days else "[adapter] no days built")
    return days

# ------------------------- adapter self-test (offline, spans DST) -------------------------
def selftest():
    import datetime as dt
    rows = []
    base_dates = pd.date_range("2025-03-05", "2025-03-20", freq="D")   # DST: Sun 2025-03-09
    weekdays = [d for d in base_dates if d.weekday() < 5]
    half_day = pd.Timestamp("2025-03-13").date()
    poke_hi_day = pd.Timestamp("2025-03-12").date()
    poke_lo_day = pd.Timestamp("2025-03-18").date()
    for k, d in enumerate(weekdays):
        base = 100.0 + 0.1 * k                        # tiny drift: overnight stays inside prev RTH range
        base_prev = 100.0 + 0.1 * (k - 1)
        end_h = 13 if d.date() == half_day else 16
        for hh in range(3, 17):
            for mm in range(60):
                ts = pd.Timestamp(d.year, d.month, d.day, hh, mm, tz=TZ)
                tt = ts.time()
                in_rth = dt.time(9, 30) <= tt < dt.time(end_h, 0)
                if not in_rth and not (tt < dt.time(9, 30) or tt >= dt.time(16, 0)):
                    continue
                px = base
                if in_rth:
                    hi_, lo_ = base + 1, base - 1     # RTH range +-1
                else:
                    hi_, lo_ = base + 0.25, base - 0.25   # quiet overnight, strictly inside prev range
                vol = 100.0
                if in_rth and tt == dt.time(9, 30):
                    vol = 999999.0
                if not in_rth:
                    if d.date() == poke_hi_day and tt == dt.time(5, 0):
                        hi_ = base_prev + 1 + 3       # poke above prev_hi = base_prev + 1
                    if d.date() == poke_lo_day and tt == dt.time(5, 0):
                        lo_ = base_prev - 1 - 3       # poke below prev_lo = base_prev - 1
                rows.append((ts.tz_convert("UTC"), px, hi_, lo_, px, vol))
    df = pd.DataFrame(rows, columns=["ts", "open", "high", "low", "close", "volume"]).set_index("ts")
    days = build_days(df, verbose=False)
    by_date = {d["date"]: d for d in days}
    ok = True
    def chk(cond, msg):
        nonlocal ok
        print(("  PASS " if cond else "  FAIL ") + msg)
        ok = ok and cond
    chk(str(half_day) not in by_date, "half day skipped as trading day")
    chk(str(weekdays[0].date()) not in by_date, "first session excluded (no prev)")
    exp_traded = len(weekdays) - 2   # minus first session and half day
    chk(len(days) == exp_traded, f"traded day count == {exp_traded} (got {len(days)})")
    chk(all(len(d["c"]) == 78 for d in days), "78 five-min bars per traded day")
    pre_dst, post_dst = by_date.get("2025-03-07"), by_date.get("2025-03-10")
    chk(pre_dst is not None and pre_dst["v"][0] >= 999999, "bar0 = 09:30 ET before DST switch")
    chk(post_dst is not None and post_dst["v"][0] >= 999999, "bar0 = 09:30 ET after DST switch")
    d_after_half = by_date.get("2025-03-14")
    chk(d_after_half is not None and abs(d_after_half["prev_hi"] - (100.0 + 0.1 * weekdays.index(pd.Timestamp(half_day)) + 1)) < 1e-9,
        "half day still supplies prev-day levels")
    dh = by_date.get(str(poke_hi_day)); dl = by_date.get(str(poke_lo_day))
    chk(dh is not None and dh["spent_hi"] and not dh["spent_lo"], "overnight poke sets spent_hi only")
    chk(dl is not None and dl["spent_lo"] and not dl["spent_hi"], "overnight poke sets spent_lo only")
    others = [d for d in days if d["date"] not in (str(poke_hi_day), str(poke_lo_day))]
    chk(all((not d["spent_hi"]) and (not d["spent_lo"]) for d in others), "no false spent flags elsewhere")
    print("ADAPTER SELF-TEST:", "PASS" if ok else "FAIL")
    return 0 if ok else 1

# ------------------------- secondary (non-gating) reports -------------------------
def replicate_selection(tr_days):
    sel = {}
    for book in oh.PRIORITY:
        best, best_r = None, -9
        for params in oh.GRIDS[book]:
            t = oh.run_book(tr_days, book, params)
            r = np.mean([x["net"] / x["risk"] for x in t]) if len(t) >= 10 else -9
            if r > best_r:
                best, best_r = params, r
        sel[book] = best
    return sel

def run_ensemble_capped(days, sel, cap):
    trades, width_hist = [], []
    for day in days:
        f = oh.features(day)
        w = f["fh_hi"][12] - f["fh_lo"][12]
        sq = oh.squeeze_ok(width_hist, w)
        pos_until = -1; n_today = 0
        for b in range(1, oh.BARS - 1):
            if b <= pos_until or n_today >= 3:
                continue
            for book in oh.PRIORITY:
                p = sel[book]
                sig = oh.trig_break(day, f, b, sq, p) if book == "BREAK" else oh.TRIGS[book](day, f, b, p)
                if sig:
                    entry = day["c"][b]; side = sig["side"]; stop = sig["stop"]
                    if side * (entry - stop) < oh.FLOOR:
                        stop = entry - side * oh.FLOOR
                    if side * (entry - stop) > cap:
                        break                         # skip this bar entirely (mirrors Pine v1.2 skip)
                    t = oh.execute(day, f, b, sig)
                    t["book"] = book
                    trades.append(t); pos_until = t["exit_bar"]; n_today += 1
                    break
        width_hist.append(w)
    return trades

def dollars(trades):
    return sum(t["net"] for t in trades) * DPP

def secondary(days):
    n = len(days); cut = int(n * 0.70)
    tr, ho = days[:cut], days[cut:]
    sel = replicate_selection(tr)
    print("\n=== SECONDARY (non-gating): dollars @ $5/pt on 1-lot MES, holdout ===")
    for book in oh.PRIORITY:
        t = oh.run_book(ho, book, sel[book])
        r = np.array([x["net"] / x["risk"] for x in t]) if t else np.array([0.0])
        print(f"  {book:8s} sel={sel[book]}  n={len(t):4d}  netR/t={r.mean():+.3f}  Sigma$={dollars(t):+9.2f}")
    ens = oh.run_ensemble(ho, sel)
    r = np.array([x["net"] / x["risk"] for x in ens]) if ens else np.array([0.0])
    print(f"  {'ENSEMBLE':8s} n={len(ens):4d}  netR/t={r.mean():+.3f} (bar +0.15R)  "
          f"Sigma$={dollars(ens):+9.2f}  trades/day={len(ens)/len(ho):.2f}")
    cap_t = run_ensemble_capped(ho, sel, CAP)
    rc = np.array([x["net"] / x["risk"] for x in cap_t]) if cap_t else np.array([0.0])
    print(f"  ENS+cap{CAP:.0f}pt n={len(cap_t):4d}  netR/t={rc.mean():+.3f}  Sigma$={dollars(cap_t):+9.2f}  "
          f"[account-overlay sensitivity; NOT a gate, NOT selected on]")

# ------------------------- main -------------------------
if __name__ == "__main__":
    args = sys.argv[1:]
    if "--selftest" in args:
        sys.exit(selftest())
    # integrity fingerprint of the frozen harness
    assert oh.NT == 11 and len(oh.GRIDS["TAKEOUT"]) == 4, "harness fingerprint mismatch - wrong omni_harness.py"
    if "--file" in args:
        df = load_file(args[args.index("--file") + 1])
    elif "--api" in args:
        start = args[args.index("--start") + 1] if "--start" in args else "2017-01-01"
        df = load_api(start)
    else:
        sys.exit("need --selftest, --file <path>, or --api")
    days = build_days(df)
    assert len(days) >= 1000, f"only {len(days)} traded days - check data range/quality before the one run"
    oh.verdict(days, "MES-VERDICT")
    secondary(days)
    print("\nVERDICT COMPLETE - one run, final. Do not re-run on this or modified data.")

