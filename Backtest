"""
TERMINUS · path-accurate trade simulator (retracement entry).

WHY NOT ENTER AT THE CHECKPOINT
-------------------------------
Measured, v1 of this file: entering at the checkpoint close with the stop under the
day's low produced R:R < 1 on essentially every signal, because by the time the model
is confident the low is in, price has already travelled away from it. Risk = the whole
way back to the low, reward = the sliver left to the other end. The 66 ES trades that
did clear a 0.5 gate ran 71.4% WR at -$282/trade. That is the fill paradox again: the
level is the STOP, so entry has to come to the level, not chase away from it.

THE SETUP
---------
    running LOW probably final  AND  running HIGH probably not
      -> bullish state. Bid a retracement into the swing, stop under the low,
         target beyond the opposite extreme.
    (mirror for shorts)

    swing = rh - rl
    entry = rl + f * swing          limit order, must be BELOW current price
    stop  = rl - b * ADR
    tgt   = rh + p * ADR
    R:R  ~= (1-f)/f, so f is the R:R dial. The model's probability is what makes
    bidding deep (small f) survivable.

HARNESS RULES (each one a scar):
  · fill search starts at bar k+1, never the checkpoint bar
  · the barrier race starts at fill_bar+1, never the fill bar
  · stop and entry inside the same minute -> AMBIGUOUS, charged as a LOSS
  · target and stop inside the same minute -> AMBIGUOUS, charged as a LOSS
  · unfilled orders are reported as a FILL RATE, never silently dropped
  · timeouts are marked to market and reported separately; WR is quoted resolved-only
  · costs charged in points on both sides of every filled trade
"""
import numpy as np, pandas as pd

COST_PTS = {'ES': 0.05 + 0.50, 'NQ': 0.125 + 0.50, 'MNQ': 0.62 + 0.50}
PT_VALUE = {'ES': 50.0, 'NQ': 20.0, 'MNQ': 2.0}


def _first(idx):
    return idx[0] if len(idx) else 10 ** 9


def simulate_one(H, L, C, k, long, entry, stop, tgt):
    """
    Returns (outcome, pts_gross, fill_bar).
    outcome in {win, loss, ambig, timeout, nofill}
    pts_gross is in points, signed, before costs.
    """
    Hf, Lf = H[k + 1:], L[k + 1:]
    if len(Hf) < 3:
        return 'nofill', 0.0, -1

    # --- leg 1: does the limit fill before the stop is violated? ---
    if long:
        fi = _first(np.flatnonzero(Lf <= entry))
        si = _first(np.flatnonzero(Lf <= stop))
    else:
        fi = _first(np.flatnonzero(Hf >= entry))
        si = _first(np.flatnonzero(Hf >= stop))
    if fi == 10 ** 9:
        return 'nofill', 0.0, -1
    if si < fi:                       # stop taken out before we were ever filled
        return 'nofill', 0.0, -1
    if si == fi:                      # same minute holds both -> pessimistic
        return 'ambig', -(entry - stop) if long else -(stop - entry), fi

    # --- leg 2: barrier race, starting strictly AFTER the fill bar ---
    Hr, Lr = Hf[fi + 1:], Lf[fi + 1:]
    if len(Hr) == 0:
        px_end = C[-1]
        return 'timeout', (px_end - entry) if long else (entry - px_end), fi
    if long:
        ti = _first(np.flatnonzero(Hr >= tgt))
        xi = _first(np.flatnonzero(Lr <= stop))
    else:
        ti = _first(np.flatnonzero(Lr <= tgt))
        xi = _first(np.flatnonzero(Hr >= stop))

    if ti == 10 ** 9 and xi == 10 ** 9:
        px_end = C[-1]
        return 'timeout', (px_end - entry) if long else (entry - px_end), fi
    if ti < xi:
        return 'win', (tgt - entry) if long else (entry - tgt), fi
    if xi < ti:
        return 'loss', -((entry - stop) if long else (stop - entry)), fi
    return 'ambig', -((entry - stop) if long else (stop - entry)), fi


def trades(day, rb, ev, which, thr_in=0.85, thr_out=0.55, f=0.33, b=0.05, p=0.10,
           rr_gate=0.0, min_swing=0.30, one_per_day=True, last_entry=930):
    cost = COST_PTS[which]
    piv = (ev.pivot_table(index=['day', 't'], columns='side', values='p',
                          aggfunc='first')
             .rename(columns={'hi': 'p_hi', 'lo': 'p_lo'}).dropna())

    out = []
    for dd, g in piv.groupby(level=0):
        bb = rb.get(dd)
        if bb is None or dd not in day.index:
            continue
        H, L, C, T = bb['H'], bb['L'], bb['C'], bb['T']
        A = float(day.at[dd, 'ADR'])
        taken = False
        for (_, t), row in g.iterrows():
            if taken and one_per_day:
                break
            if t > last_entry:
                break
            k = int(np.searchsorted(T, t, side='right')) - 1
            if k < 30 or k >= len(H) - 5:
                continue
            rh = float(H[:k + 1].max()); rl = float(L[:k + 1].min())
            px = float(C[k]); swing = rh - rl
            if swing < min_swing * A:
                continue

            for long in (True, False):
                pin = row.p_lo if long else row.p_hi
                pout = row.p_hi if long else row.p_lo
                if not (pin >= thr_in and pout <= thr_out):
                    continue
                entry = (rl + f * swing) if long else (rh - f * swing)
                # the limit must be a genuine retracement, i.e. away from price
                if (long and entry >= px) or ((not long) and entry <= px):
                    continue
                stop = (rl - b * A) if long else (rh + b * A)
                tgt = (rh + p * A) if long else (rl - p * A)
                R = (entry - stop) if long else (stop - entry)
                rew = (tgt - entry) if long else (entry - tgt)
                if R <= 0 or rew <= 0:
                    continue
                rr = rew / R
                if rr < rr_gate:
                    continue

                oc, pts, fb = simulate_one(H, L, C, k, long, entry, stop, tgt)
                if oc == 'nofill':
                    out.append(dict(day=dd, t=t, side='long' if long else 'short',
                                    entry=entry, stop=stop, tgt=tgt, R=R, rr=rr,
                                    p_in=pin, p_out=pout, outcome='nofill',
                                    pts=0.0, Rmult=0.0, usd=0.0, ADR=A, filled=False))
                else:
                    net = pts - cost
                    out.append(dict(day=dd, t=t, side='long' if long else 'short',
                                    entry=entry, stop=stop, tgt=tgt, R=R, rr=rr,
                                    p_in=pin, p_out=pout, outcome=oc,
                                    pts=net, Rmult=net / R, usd=net * PT_VALUE[which],
                                    ADR=A, filled=True))
                taken = True
                break
    return pd.DataFrame(out)


def summarise(tr, label='', n_days=None):
    if not len(tr):
        return dict(label=label, n=0, nfill=0)
    fl = tr[tr.filled]
    d = dict(label=label, n=len(tr), nfill=len(fl),
             fill_rate=float(tr.filled.mean()),
             med_rr=float(tr.rr.median()))
    if not len(fl):
        return d
    res = fl[fl.outcome != 'timeout']
    d.update(wr_resolved=float((res.outcome == 'win').mean()) if len(res) else np.nan,
             timeout_share=float((fl.outcome == 'timeout').mean()),
             ambig_share=float((fl.outcome == 'ambig').mean()),
             avgR=float(fl.Rmult.mean()), medR=float(fl.Rmult.median()),
             totR=float(fl.Rmult.sum()), avg_usd=float(fl.usd.mean()),
             tot_usd=float(fl.usd.sum()))
    d['t_stat'] = float(fl.Rmult.mean() / (fl.Rmult.std(ddof=1) / np.sqrt(len(fl)))) \
        if len(fl) > 2 and fl.Rmult.std(ddof=1) > 0 else np.nan
    if n_days:
        d['per_day'] = len(fl) / float(n_days)
    return d


def fmt(s):
    if not s.get('nfill'):
        return f'  {s["label"]:<24} signals={s.get("n",0):>5}  filled=0'
    return (f'  {s["label"]:<24} sig={s["n"]:>5} fill {s["fill_rate"]:>5.1%} '
            f'n={s["nfill"]:>5}  avgR {s["avgR"]:+.3f}  t {s["t_stat"]:+5.2f}  '
            f'WR(res) {s["wr_resolved"]:>5.1%}  TO {s["timeout_share"]:>5.1%}  '
            f'RR {s["med_rr"]:>4.2f}  ${s["avg_usd"]:+7.2f}/tr  ${s["tot_usd"]:+9.0f}')

