def clean_membership(snaps):
    """date -> ordered list of eligible symbols (top TOPN after exclusions)."""
    memb = {}
    for d, rows in sorted(snaps.items()):
        syms = []
        for x in sorted(rows, key=lambda r: r.get("rank") or 999):
            s = x["symbol"]
            if s in STABLES or s in WRAPPED or s is None:
                continue
            if s not in syms:
                syms.append(s)
            if len(syms) >= TOPN:
                break
        memb[d] = syms
    return memb


def download_prices(memb):
    every = sorted({s for v in memb.values() for s in v})
    print(f"unique symbols ever in top-{TOPN}: {len(every)}")
    cands = {s: SPECIAL.get(s, [f"{s}-USD"]) for s in every}
    flat = sorted({t for v in cands.values() for t in v})
    import yfinance as yf
    px = yf.download(flat, start="2016-10-01", auto_adjust=True, progress=False)["Close"]
    px = px.dropna(how="all", axis=1)
    # resolve: first candidate with >=100 rows
    col = {}
    for s, tl in cands.items():
