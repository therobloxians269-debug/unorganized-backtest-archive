"""
FlowLab self-test: planted-effect vs null tape.
PASS criteria:
  1) On the PLANTED tape (genuine flow->price drift injected on the F1
     mechanism), the F1 cells matching the planted parameters must clear
     the gates (HAC t >= 3, DSR ~ 1 even at conservative N, MCPT p small).
  2) On the NULL tape (identical generator, zero drift), NO cell may pass
     all gates — the machinery must kill noise.
  3) Specificity: non-planted families should not light up on the planted tape.
This validates the MACHINERY ONLY. Synthetic results are never a verdict.
"""
import time
import numpy as np
import pandas as pd
import flowlab as fl

N_SESSIONS = 250
N_TRIALS_CONSERVATIVE = 300   # placeholder cumulative-N floor for self-test
PERMS = 500

pd.set_option("display.width", 160)
pd.set_option("display.max_rows", 100)


def run(tag, drift, seed):
    t0 = time.time()
    tape = fl.make_tape(N_SESSIONS, seed=seed, planted_drift_pts=drift)
    cells, mats, b5 = fl.build_all_cells(tape)
    sessions = sorted(np.unique(tape["sess"]).tolist())
    res = fl.evaluate_cells(cells, mats, sessions,
                            n_trials=N_TRIALS_CONSERVATIVE,
                            mcpt_perms=PERMS)
    res["tape"] = tag
    print(f"\n=== {tag} tape ({time.time()-t0:.0f}s, "
          f"{tape['sec'].size:,} trades, {len(cells)} cells) ===")
    show = res.sort_values("hac_t", ascending=False).copy()
    for c in ("net_pts", "pts_per_trade", "hac_t", "dsr"):
        show[c] = show[c].round(3)
    print(show[["cell", "n_trades", "net_pts", "pts_per_trade",
                "hac_t", "dsr", "mcpt_p"]].to_string(index=False))
    return res


if __name__ == "__main__":
    planted = run("PLANTED(drift=16pt/300s)", 16.0, seed=7)
    null = run("NULL(drift=0)", 0.0, seed=11)

    print("\n================ VERDICT ================")
    gate = lambda r: (r["net_pts"] > 0) and (r["hac_t"] >= 3.0) and \
                     (r["dsr"] >= 0.95) and \
                     (pd.notna(r["mcpt_p"]) and r["mcpt_p"] <= 0.05)
    p_pass = planted[planted.apply(gate, axis=1)]
    n_pass = null[null.apply(gate, axis=1)]
    f1_planted_hot = p_pass[p_pass["cell"].str.contains(r"F1_N(?:20|60)_z1.5")]
    print(f"Planted tape cells passing ALL gates: {len(p_pass)} "
          f"-> {p_pass['cell'].tolist()}")
    print(f"  (planted mechanism = F1 delta-confirmed break z1.5; detected: "
          f"{len(f1_planted_hot) > 0})")
    print(f"Null tape cells passing ALL gates:    {len(n_pass)} "
          f"-> {n_pass['cell'].tolist()}")
    ok = (len(f1_planted_hot) > 0) and (len(n_pass) == 0)
    print(f"\nSELF-TEST {'PASS' if ok else 'FAIL'}: planted effect "
          f"{'detected' if len(f1_planted_hot) else 'MISSED'}, "
          f"null {'correctly killed' if len(n_pass)==0 else 'FALSE POSITIVE'}")

