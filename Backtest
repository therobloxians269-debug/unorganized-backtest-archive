"""
CONTINUATION AT THE EXTREME — the one hypothesis the ground-truth screen produced.

WHERE IT CAME FROM (this is the point — it was not invented, it was observed)
    In 28 sessions of true aggressor prints, every "exhaustion at the extreme"
    hypothesis failed, and all of them failed the same way:
        sellers absorb an UP bar          z -1.84 / -1.89 / -2.07
        sell absorption AT a new high     z -1.08 / -2.47 / -2.01
        big-lot BUY into a new high       z -1.60 / -0.96 / -2.16
        big-lot SELL into a new low       z -0.86 / -2.09 / -2.62
          same event, CONTINUATION        z +0.83 / +2.10 / +2.46
    Real aggression at a fresh extreme CONTINUES. It does not exhaust.

THE CANDLE PROXY (readable, no order flow needed to trade it)
    A bar that (a) makes a NEW session extreme, (b) on heavy volume, and (c) closes
    at that extreme — i.e. the aggressor never got pushed off it. That is the visible
    footprint of the flow the tape showed.

    "New low, big volume, closed on the low, no tail — they're not done selling."

TESTED HERE ON 16 YEARS, because 28 sessions cannot settle anything. Discovery bar:
ES TRAIN. Confirmation: ES DEV, then NQ and MNQ never trained.
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')
import data as D, sim as S

rng = np.random.default_rng(101)
RTH0, RTH1 = 570, 960


def events(day, rb, vol_q=0.70, close_frac=0.25, win=12, checks=(600, 930)):
    """
    One row per 5-min bar that makes a new session extreme on heavy volume and closes
    into that extreme. Forward return measured from the bar close, signed toward
    CONTINUATION.
    """
    rows = []
    for dd, row in day.iterrows():
        b = rb.get(dd)
        if b is None:
            continue
        A = float(row.ADR)
        H1, L1, C1, O1, V1, T1 = b['H'], b['L'], b['C'], b['O'], b['V'], b['T']
        if not (A > 0) or len(C1) < 300:
            continue
        n5 = (len(C1) // 5) * 5
        ix = np.arange(n5).reshape(-1, 5)
        H, L = H1[ix].max(1), L1[ix].min(1)
        C, O = C1[ix[:, -1]], O1[ix[:, 0]]
        V, T = V1[ix].sum(1), T1[ix[:, -1]]
        end = ix[:, -1]
        m = len(C)
        if m < win + 8:
            continue
        cmaxH = np.maximum.accumulate(H)
        cminL = np.minimum.accumulate(L)
        vmu = pd.Series(V).rolling(win, min_periods=6).mean().shift(1).values
        vsd = pd.Series(V).rolling(win, min_periods=6).std().shift(1).values
        vz = (V - vmu) / np.where(vsd > 0, vsd, np.nan)
        rngb = np.maximum(H - L, 1e-9)
        # where in the bar did it close?
        loc_hi = (H - C) / rngb          # 0 = closed on the high
        loc_lo = (C - L) / rngb          # 0 = closed on the low

        for i in range(win, m - 4):
            if T[i] < checks[0] or T[i] > checks[1] or not np.isfinite(vz[i]):
                continue
            j = int(end[i])
            for side in ('hi', 'lo'):
                if side == 'hi':
                    if not (H[i] >= cmaxH[i - 1] - 1e-9 and loc_hi[i] <= close_frac):
                        continue
                    sgn = +1.0
                else:
                    if not (L[i] <= cminL[i - 1] + 1e-9 and loc_lo[i] <= close_frac):
                        continue
                    sgn = -1.0
                px = float(C[i])
                fw = {}
                for k, lbl in ((6, 'f30'), (12, 'f60'), (24, 'f120')):
                    kk = min(j + k * 5, len(C1) - 1)
                    fw[lbl] = sgn * (float(C1[kk]) - px) / A
                fw['fcl'] = sgn * (float(C1[-1]) - px) / A
                # path extremes for a stop/target sim
                Hf, Lf = H1[j + 1:], L1[j + 1:]
                if len(Hf) < 6:
                    continue
                mfe = (float(Hf.max()) - px) / A if sgn > 0 else (px - float(Lf.min())) / A
                mae = (px - float(Lf.min())) / A if sgn > 0 else (float(Hf.max()) - px) / A
                rows.append(dict(day=dd, t=int(T[i]), side=side, sgn=sgn, px=px, j=j,
                                 ADR=A, vz=float(vz[i]),
                                 loc=float(loc_hi[i] if side == 'hi' else loc_lo[i]),
                                 mfe=mfe, mae=mae, **fw))
    return pd.DataFrame(rows)


def dayt(x):
    x = np.asarray(x, dtype=float); x = x[np.isfinite(x)]
    if len(x) < 20:
        return np.nan, np.nan, len(x)
    return float(x.mean()), float(x.mean() / (x.std(ddof=1) / np.sqrt(len(x)))), len(x)


def dayclust(df, col):
    g = df.groupby('day')[col].mean()
    if len(g) < 15:
        return np.nan, np.nan, len(df)
    return float(g.mean()), float(g.mean() / (g.std(ddof=1) / np.sqrt(len(g)))), len(df)


def report(df, label, cols=('f30', 'f60', 'f120', 'fcl')):
    if len(df) < 30:
        print(f'  {label:<30} n={len(df)}'); return
    out = f'  {label:<30} n={len(df):>6}'
    for c in cols:
        mu, t, _ = dayclust(df, c)
        out += f'   {c} {mu:>+7.4f} t{t:>+6.2f}'
    print(out)


def placebo(df, all_ev, col='f60', n=300):
    """Time-matched control drawn from ALL new-extreme bars (not only heavy ones)."""
    counts = df.groupby('t').size()
    pool = {t: g.index.values for t, g in all_ev.groupby('t')}
    out = []
    for _ in range(n):
        pick = [rng.choice(pool[t], size=min(c, len(pool[t])), replace=False)
                for t, c in counts.items() if t in pool and len(pool[t])]
        if not pick:
            continue
        g = all_ev.loc[np.concatenate(pick)]
        mu, _, _ = dayclust(g, col)
        out.append(mu)
    out = np.array([o for o in out if np.isfinite(o)])
    return (out.mean(), out.std()) if len(out) else (np.nan, np.nan)

