"""Two questions:
(1) When price returns to the ALREADY-PRINTED extreme (the IB edge that held), does it REJECT?
(2) For the UNKNOWN extreme, does the calibrated fan actually contain it?"""
import numpy as np, pandas as pd, pickle, warnings; warnings.filterwarnings('ignore')
SCR='/private/tmp/claude-501/-Users-kaveh/d5ce5738-dd59-4ca2-bd9c-e9b02fe3107c/scratchpad'
esday,esrth,nqday,nqrth=pickle.load(open(f'{SCR}/ladder_feats.pkl','rb'))
from ladder import pred, QS
M=pickle.load(open(f'{SCR}/ladder_M.pkl','rb'))

for D,RT,tag in [(esday,esrth,'ES 2010-2026'),(nqday,nqrth,'NQ 2023-2025')]:
    P=pred(M,D); di={d:i for i,d in enumerate(D.index)}
    ret=[]; fan=[]
    for d,b in RT.groupby('day'):
        if d not in di or len(b)<300: continue
        i=di[d]; o=D.at[d,'o930']; A=D.at[d,'ADR']
        H=b['high'].values; L=b['low'].values; T=b['tod'].values
        ib=T<630
        if ib.sum()<48: continue
        ibh=H[ib].max(); ibl=L[ib].min(); ibr=ibh-ibl
        if ibr<=0: continue
        post=np.flatnonzero(~ib)
        up=[k for k in post if H[k]>=ibh]; dn=[k for k in post if L[k]<=ibl]
        iu=up[0] if up else 10**9; idn=dn[0] if dn else 10**9
        if min(iu,idn)==10**9: continue
        upfirst=iu<idn; k0=min(iu,idn)
        # (1) does price RETURN to the printed extreme's block, and does it hold?
        edge = ibl if upfirst else ibh                    # the printed extreme
        blk  = 0.15*ibr                                   # block thickness
        if upfirst:
            touch=[k for k in range(k0,len(H)) if L[k]<=edge+blk]
        else:
            touch=[k for k in range(k0,len(H)) if H[k]>=edge-blk]
        if touch:
            t0=touch[0]
            broke = (L[t0:].min()<edge) if upfirst else (H[t0:].max()>edge)
            # reaction size from the touch bar +1
            if t0+1<len(H):
                react = (H[t0+1:].max()-L[t0])/ibr if upfirst else (H[t0]-L[t0+1:].min())/ibr
            else: react=0.0
            ret.append(dict(day=d,returned=1,broke=int(broke),react=react))
        else:
            ret.append(dict(day=d,returned=0,broke=0,react=np.nan))
        # (2) does the fan contain the UNKNOWN extreme?
        if upfirst:
            trav=(H.max()-o)/A
            fan.append(dict(side='hi', **{f'q{int(q*100)}':int(trav<P[('hi',q)][i]) for q in QS}))
        else:
            trav=(o-L.min())/A
            fan.append(dict(side='lo', **{f'q{int(q*100)}':int(trav<P[('lo',q)][i]) for q in QS}))
    R=pd.DataFrame(ret); F=pd.DataFrame(fan)
    print(f'=== {tag}  n={len(R)} ===')
    r=R[R.returned==1]
    print(f'  (1) THE PRINTED BLOCK — block = IB edge +/- 0.15 x IB range')
    print(f'      price returns to it at all:        {R.returned.mean()*100:5.1f}% of days  (n={len(r)})')
    print(f'      given a return, it HOLDS (rejects): {(1-r.broke.mean())*100:5.1f}%')
    print(f'      given a return, it BREAKS:          {r.broke.mean()*100:5.1f}%')
    print(f'      median reaction off a HOLD:         {r[r.broke==0].react.median():.2f} IB ranges')
    print(f'  (2) THE UNKNOWN EXTREME vs the calibrated fan (coverage should match nominal):')
    print('      ' + '  '.join(f'q{int(q*100)} {F[f"q{int(q*100)}"].mean():.2f}' for q in QS))
    print()

