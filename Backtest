    print(f"[load_panel] T={len(dates)}  {dates[0]}..{dates[-1]}  N={len(names)}")
    print(f"[load_panel] carry coverage %: {cov}   (rates ZF/ZN/ZB sparse -> ffilled, weaker carry tilt)")
    return prices.values.astype(float), carry.values.astype(float), dates, names

