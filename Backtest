"""
TERMINUS · M0 — the data spine.

Loads ES / NQ / MNQ 1-minute bars into one schema and refuses to hand back a frame
that has not passed integrity checks. Every known data defect in this program has a
guard here:

  · MES_true1min.csv is contaminated with crude prices        -> that file is never loaded
  · NQ csv is CLOSE-stamped (needs -1min before joining ES)   -> corr check on the ES columns
  · silent price-scale corruption                             -> band check per instrument
  · duplicated / unsorted index                               -> deduped and sorted

Split policy (fixed here so it cannot drift later in the build):

    TRAIN    ES  2010-2019      fit only
    DEV      ES  2020-2026      gates, tuning, every decision
    HOLD_NQ  NQ  2022-2025      never trained, different market
    HOLD_MNQ MNQ 2026           never trained, different market, forward in time

NQ/MNQ are the shipped instruments and are never used to fit anything.
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')

RTH0, RTH1 = 570, 960          # 09:30, 16:00 ET, in minutes past midnight

SRC = {
    'ES':  '/Users/kaveh/overnight_premium_engine/data/es_front_1m.parquet',
    'NQ':  '/Users/kaveh/qt_cascade/nq.parquet',
    'MNQ': '/Users/kaveh/qt_cascade/mnq.parquet',
}

# plausible price band per instrument over its lifetime — a scale corruption
# (crude oil prices pasted into an equity file) trips this immediately
# NQ traded to ~30.8k by mid-2026; band widened after verifying the series is
# continuous (max 1m return 1.5%, max daily gap 4.4%, ES corr 0.937)
BAND = {'ES': (900, 8500), 'NQ': (9000, 45000), 'MNQ': (9000, 45000)}

# contract spec: point value, tick, and the round-turn cost we hold ourselves to
SPEC = {
    'ES':  dict(pt=50.0,  tick=0.25,  rt_cost=2.50),
    'NQ':  dict(pt=20.0,  tick=0.25,  rt_cost=2.50),
    'MNQ': dict(pt=2.0,   tick=0.25,  rt_cost=1.24),
}

SPLITS = {
    'TRAIN':    ('ES',  '2010-01-01', '2019-12-31'),
    'DEV':      ('ES',  '2020-01-01', '2026-12-31'),
    'HOLD_NQ':  ('NQ',  '2000-01-01', '2026-12-31'),
    'HOLD_MNQ': ('MNQ', '2000-01-01', '2026-12-31'),
}


class IntegrityError(Exception):
    """Raised when a data check fails. The build stops rather than trading on it."""


def load(which):
    """Return 1m bars as open/high/low/close/volume, ET-indexed, deduped, sorted."""
    d = pd.read_parquet(SRC[which])
    if which == 'ES':
        d = d[['open', 'high', 'low', 'close', 'volume']].copy()
    else:
        keep = ['o', 'h', 'l', 'c', 'v']
        extra = [c for c in ('es_high', 'es_low', 'es_close') if c in d.columns]
        d = d[keep + extra].copy()
        d.columns = ['open', 'high', 'low', 'close', 'volume'] + extra
    d = d[~d.index.duplicated(keep='first')].sort_index()
    d.index.name = 'et'
    check_bars(d, which)
    return d


def check_bars(d, which):
    lo, hi = BAND[which]
    px = d.close
    frac = ((px < lo) | (px > hi)).mean()
    if frac > 0.001:
        raise IntegrityError(f'{which}: {frac:.3%} of closes outside band {lo}-{hi} '
                             f'(min {px.min():.1f} max {px.max():.1f}) — wrong instrument?')
    bad = (d.high < d.low) | (d.high < d.close) | (d.low > d.close)
    if bad.mean() > 0.0001:
        raise IntegrityError(f'{which}: {bad.mean():.4%} of bars violate OHLC ordering')
    if not d.index.is_monotonic_increasing:
        raise IntegrityError(f'{which}: index not monotonic after sort')
    return True


def check_es_alignment(d, which, min_corr=0.75):
    """
    The NQ/MNQ files carry ES columns. If they are stamped on a different convention
    the 1m return correlation collapses (this exact bug once read 0.054 instead of
    0.920). Cross-market work in M4 is only legal if this passes.
    """
    if 'es_close' not in d.columns:
        return None
    a = np.log(d.close).diff()
    b = np.log(d.es_close).diff()
    m = np.isfinite(a) & np.isfinite(b) & (a != 0) & (b != 0)
    c = float(np.corrcoef(a[m], b[m])[0, 1])
    if c < min_corr:
        raise IntegrityError(f'{which}: NQ-vs-ES 1m return corr {c:.3f} < {min_corr} — '
                             f'timestamp convention mismatch, do NOT join these')
    return c


def sessions(d, adrlen=14, min_bars=300):
    """
    One row per RTH session with the day's realised extremes and a causal ADR.
    ADR[i] is the mean of ranges i-adrlen..i-1 and is audited to never touch rng[i].
    """
    tod = d.index.hour * 60 + d.index.minute
    d = d.assign(tod=tod, rth=(tod >= RTH0) & (tod < RTH1), day=d.index.normalize())
    r = d[d.rth]
    g = r.groupby('day')

    day = pd.DataFrame({'o930': g['open'].first(), 'hi': g['high'].max(),
                        'lo': g['low'].min(), 'cl': g['close'].last(),
                        'n': g.size(), 'rvol': g['volume'].sum()})
    day = day[day.n >= min_bars]                    # full sessions only, no half days
    day['rng'] = day.hi - day.lo
    day['ADR'] = day.rng.shift(1).rolling(adrlen).mean()
    day['prevC'] = day.cl.shift(1)
    day['prevRng'] = day.rng.shift(1)
    day['prevHi'] = day.hi.shift(1)          # PDH / PDL, the classic pools
    day['prevLo'] = day.lo.shift(1)

    rv = day.rng.values
    chk = np.array([np.nan if i < adrlen else rv[i - adrlen:i].mean()
                    for i in range(len(rv))])
    if not np.isclose(day.ADR.values, chk, atol=1e-9, equal_nan=True).all():
        raise IntegrityError('ADR leak: rolling window touches the current day')

    # overnight block = bars between the prior RTH close and this RTH open,
    # attributed forward to the session they precede
    ov = d[~d.rth].copy()
    rd = day.index
    pos = np.searchsorted(rd.values, ov.index.normalize().values, side='left')
    idx = np.where(ov.tod.values < RTH0, pos, pos + 1)
    ok = idx < len(rd)
    ov, idx = ov[ok], idx[ok]
    ov['tgt'] = rd[idx]
    og = ov.groupby('tgt')
    day['onH'] = og['high'].max()
    day['onL'] = og['low'].min()
    day['onV'] = og['volume'].sum()

    day = day.dropna(subset=['ADR', 'prevC', 'prevRng', 'prevHi', 'prevLo', 'onH', 'onL'])
    day = day[day.ADR > 0]
    return day, r


def rth_bars(r):
    """Per-session minute arrays for the path-accurate simulator."""
    out = {}
    for dd, b in r.groupby('day'):
        out[dd] = dict(H=b.high.values, L=b.low.values, O=b.open.values,
                       C=b.close.values, T=b.tod.values, V=b.volume.values)
    return out


def split(day, name):
    _, a, b = SPLITS[name]
    return day[(day.index >= a) & (day.index <= b)]

