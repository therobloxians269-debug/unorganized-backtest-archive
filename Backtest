"""Improve the diversified daily trend: multi-timescale, vol-normalized tanh signal,
portfolio vol-targeting. Grid the (pre-specified) variants and gauntlet them so the
improvement is robust, not mined.

    PYTHONPATH=. python3 research/improved_trend.py
"""
from __future__ import annotations

import numpy as np
import pandas as pd

from ope.validation import gauntlet_summary, perf_stats

SYMS = ["SPY", "QQQ", "IWM", "EFA", "EEM", "TLT", "IEF", "GLD", "DBC", "UUP"]
TGT, COST_BP = 0.10, 1.0


def trend_net(px, looks, response="tanh", port_vt=True):
    rets = px.pct_change()
    ann_vol = (rets.rolling(63).std() * np.sqrt(252)).shift(1)
    z = sum(px.pct_change(L) / (ann_vol * np.sqrt(L / 252.0)) for L in looks) / len(looks)
    strength = np.sign(z) if response == "sign" else np.tanh(z)
    w = strength.shift(1) / ann_vol
    w = w.div(w.abs().sum(axis=1).replace(0, np.nan), axis=0)   # normalize gross exposure to 1x
    if port_vt:
        gross = (w * rets).sum(axis=1)
        scale = (TGT / (gross.rolling(63).std() * np.sqrt(252))).shift(1).clip(0, 3).fillna(0.0)
        w = w.mul(scale, axis=0)
    port = (w * rets).sum(axis=1)
    net = port - w.diff().abs().sum(axis=1) * COST_BP * 1e-4
    return net.dropna()


def show(name, net):
    s = perf_stats(net)
    e = {lab: perf_stats(net[m])["sharpe"] for lab, m in
         (("06-14", net.index.year <= 2014), ("15-21", (net.index.year >= 2015) & (net.index.year <= 2021)),
          ("22+", net.index.year >= 2022))}
    print(f"{name:>26} Sh={s['sharpe']:.2f} ann={s['ann_return']*100:4.1f}% "
          f"DD={s['max_drawdown']*100:6.1f}% | eras {e['06-14']:+.2f}/{e['15-21']:+.2f}/{e['22+']:+.2f}")
    return net


def main():
    import yfinance as yf
    px = yf.download(SYMS, start="2006-01-01", auto_adjust=True, progress=False)["Close"]
    px = px.dropna(how="all").dropna(axis=1, thresh=int(len(px) * 0.5))
    print(f"basket {list(px.columns)} | {px.index[0].date()}->{px.index[-1].date()}\n")

    variants = {
        "baseline sign(252)": trend_net(px, [252], "sign", port_vt=False),
        "multi sign": trend_net(px, [21, 63, 126, 252], "sign", port_vt=False),
        "multi tanh": trend_net(px, [21, 63, 126, 252], "tanh", port_vt=False),
        "multi tanh +portVT": trend_net(px, [21, 63, 126, 252], "tanh", port_vt=True),
        "slow tanh +portVT": trend_net(px, [63, 126, 252], "tanh", port_vt=True),
        "fast tanh +portVT": trend_net(px, [21, 63, 126], "tanh", port_vt=True),
    }
    for n, v in variants.items():
        show(n, v)

    common = pd.concat(variants, axis=1).dropna()
    g = gauntlet_summary({k: common[k] for k in variants}, "multi tanh +portVT", n_blocks=10)
    print(f"\ngauntlet over {g['n_trials']} variants: PBO={g['pbo']:.3f} PSR={g['psr']:.3f} "
          f"DSR={g['dsr']:.3f} -> {'PASS' if g['passed'] else 'FAIL'}")


if __name__ == "__main__":
    main()

