# ------------------------- feature engine (causal) -------------------------
def features(day):
    o, h, l, c, v = day['o'], day['h'], day['l'], day['c'], day['v']
    n = BARS
    ema = np.zeros(n); er = np.zeros(n); atr = np.zeros(n)
    vwap = np.zeros(n); sd = np.zeros(n)
    fh_hi = np.zeros(n); fh_lo = np.zeros(n)
    e = c[0]; a = h[0] - l[0]; vn = 0.0; vd = 0.0
    devs = []
    hh, ll = -1e9, 1e9
    for b in range(n):
        e += 2.0 / (EMA_N + 1) * (c[b] - e); ema[b] = e
        tr = h[b] - l[b] if b == 0 else max(h[b] - l[b], abs(h[b] - c[b-1]), abs(l[b] - c[b-1]))
        a += (tr - a) / ATR_N; atr[b] = a
        vn += (h[b] + l[b] + c[b]) / 3 * v[b]; vd += v[b]; vwap[b] = vn / vd
        devs.append(c[b] - vwap[b])
        sd[b] = np.std(devs[-24:]) if len(devs) >= 12 else 0.0
        if b >= ER_N:
            den = np.sum(np.abs(np.diff(c[b - ER_N:b + 1])))
            er[b] = abs(c[b] - c[b - ER_N]) / den if den > 0 else 0.0
        if b < 12:
            hh = max(hh, h[b]); ll = min(ll, l[b])
        fh_hi[b] = hh; fh_lo[b] = ll
    rangep = np.zeros(n, dtype=int)
    for b in range(n):
        rangep[b] = (rangep[b-1] + 1) if (b >= ER_N and er[b] <= 0.13) else 0
    return dict(ema=ema, er=er, atr=atr, vwap=vwap, sd=sd, fh_hi=fh_hi, fh_lo=fh_lo, rangep=rangep)

def regime(f, b, c):
    if b < ER_N: return 'NEUTRAL', 0
    if f['er'][b] >= 0.35:
        return 'TREND', (1 if c[b] > c[b - ER_N] else -1)
    if f['er'][b] <= 0.13:   # random-walk ER24 = 1/sqrt(24) ~= 0.204; RANGE must sit below the RW null
        return 'RANGE', 0
    return 'NEUTRAL', 0

# ------------------------- book triggers -------------------------
def trig_trend(day, f, b, params):
    reg, tdir = regime(f, b, day['c'])
    if reg != 'TREND' or b < EMA_N + 2: return None
    c, h, l = day['c'], day['h'], day['l']
    touched = (tdir == 1 and l[b-1] <= f['ema'][b-1]) or (tdir == -1 and h[b-1] >= f['ema'][b-1])
    resume  = (tdir == 1 and c[b] > f['ema'][b] and c[b] > c[b-1]) or \
              (tdir == -1 and c[b] < f['ema'][b] and c[b] < c[b-1])
    if touched and resume:
        stop = l[max(0, b-12):b+1].min() if tdir == 1 else h[max(0, b-12):b+1].max()
        return dict(side=tdir, stop=stop, tgt_mode=params['exit'])
    return None

def trig_mr(day, f, b, params):
    reg, _ = regime(f, b, day['c'])
    if reg != 'RANGE' or f['sd'][b] <= 0: return None
    if f['rangep'][b] < 6: return None          # regime persistence: kill classifier flicker
    c = day['c']; z = (c[b] - f['vwap'][b]) / f['sd'][b]
    if params['z'] <= abs(z) <= 3.5:            # fade stretch, not runaways
        side = -1 if z > 0 else 1
        stop = c[b] - side * max(1.2 * f['atr'][b], FLOOR)
        return dict(side=side, stop=stop, tgt_mode='VWAP')
    return None

def trig_break(day, f, b, sq_ok, params):
    if not sq_ok or b < 12 or b > 40: return None
    c = day['c']
    if c[b] > f['fh_hi'][b]:
        return dict(side=1, stop=f['fh_lo'][b], tgt_mode=params['exit'])
    if c[b] < f['fh_lo'][b]:
        return dict(side=-1, stop=f['fh_hi'][b], tgt_mode=params['exit'])
    return None

def trig_takeout(day, f, b, params):
    reg, _ = regime(f, b, day['c'])
    if reg == 'TREND': return None   # never fade a level inside an active trend regime
    h, l, c = day['h'], day['l'], day['c']
    ph, pl = day['prev_hi'], day['prev_lo']
    fresh = params.get('fresh', False)
    if h[b] > ph and h[b] - ph <= 0.5 * f['atr'][b] and c[b] < ph - 1.0:
        if not (fresh and day['spent_hi']):
            return dict(side=-1, stop=h[b], tgt_mode=params['tgt'], mid=(ph + pl) / 2)
    if l[b] < pl and pl - l[b] <= 0.5 * f['atr'][b] and c[b] > pl + 1.0:
        if not (fresh and day['spent_lo']):
            return dict(side=1, stop=l[b], tgt_mode=params['tgt'], mid=(ph + pl) / 2)
    return None

# ------------------------- trade execution -------------------------
def execute(day, f, b, sig):
    c, h, l = day['c'], day['h'], day['l']
    side = sig['side']; entry = c[b]
    stop = sig['stop']
    if side * (entry - stop) < FLOOR:
        stop = entry - side * FLOOR
    risk = side * (entry - stop)
    tm = sig['tgt_mode']
    if tm == '2R':      tgt = entry + side * 2 * risk
    elif tm == '1.5R':  tgt = entry + side * 1.5 * risk
    elif tm == 'VWAP':  tgt = None  # dynamic
    elif tm == 'MID':   tgt = sig['mid']
    else:               tgt = None
    for j in range(b + 1, BARS):
        if j == EOD:
            px = c[j]; break
        if side == 1 and l[j] <= stop: px = stop; break
        if side == -1 and h[j] >= stop: px = stop; break
        if tm == 'VWAP':
            if (side == 1 and h[j] >= f['vwap'][j]) or (side == -1 and l[j] <= f['vwap'][j]):
                px = f['vwap'][j]; break
        elif tgt is not None:
            if side == 1 and h[j] >= tgt: px = tgt; break
            if side == -1 and l[j] <= tgt: px = tgt; break
    else:
        px = c[EOD]
    gross = side * (px - entry)
    return dict(gross=gross, net=gross - COST, risk=risk, exit_bar=j)

# ------------------------- book/ensemble runners -------------------------
PRIORITY = ['TAKEOUT', 'BREAK', 'TREND', 'MR']
GRIDS = {
    'TREND':   [dict(exit='EOD'), dict(exit='2R')],
    'MR':      [dict(z=2.0), dict(z=2.5)],
    'BREAK':   [dict(exit='EOD'), dict(exit='2R')],
    'TAKEOUT': [dict(tgt='2R', fresh=False), dict(tgt='MID', fresh=False),
                dict(tgt='2R', fresh=True),  dict(tgt='MID', fresh=True)],
}
TRIGS = {'TREND': trig_trend, 'MR': trig_mr, 'BREAK': trig_break, 'TAKEOUT': trig_takeout}

def squeeze_ok(width_hist, w):
    if len(width_hist) < 20: return False
    return w <= np.percentile(width_hist[-20:], 25)

def run_book(days, book, params):
    trades = []; width_hist = []
    for day in days:
        f = features(day)
        w = f['fh_hi'][12] - f['fh_lo'][12]
        sq = squeeze_ok(width_hist, w)
        pos_until = -1
        for b in range(1, BARS - 1):
            if b <= pos_until: continue
            sig = trig_break(day, f, b, sq, params) if book == 'BREAK' else TRIGS[book](day, f, b, params)
            if sig:
                t = execute(day, f, b, sig)
                trades.append(t); pos_until = t['exit_bar']
                break  # one trade per book per day (books tested standalone)
        width_hist.append(w)
    return trades

def run_ensemble(days, sel):
    trades = []; width_hist = []
    for day in days:
        f = features(day)
        w = f['fh_hi'][12] - f['fh_lo'][12]
        sq = squeeze_ok(width_hist, w)
        pos_until = -1; n_today = 0
        for b in range(1, BARS - 1):
            if b <= pos_until or n_today >= 3: continue
            for book in PRIORITY:
                p = sel[book]
                sig = trig_break(day, f, b, sq, p) if book == 'BREAK' else TRIGS[book](day, f, b, p)
                if sig:
                    t = execute(day, f, b, sig)
                    t['book'] = book
                    trades.append(t); pos_until = t['exit_bar']; n_today += 1
                    break
        width_hist.append(w)
    return trades

# ------------------------- stats -------------------------
def hac_t(x, L=2):
    n = len(x)
    if n < 5: return 0.0
    mu = x.mean(); xc = x - mu
    S = (xc @ xc) / n
    for j in range(1, min(L, n - 1) + 1):
        S += 2 * (1 - j / (L + 1)) * ((xc[j:] @ xc[:-j]) / n)
    se = math.sqrt(max(S, 1e-18) / n)
    return mu / se if se > 0 else 0.0

def dsr(x, ntrials):
    n = len(x); s = x.std()
    if s == 0 or n < 20: return 0.0
    sr = x.mean() / s
    g3 = sst.skew(x); g4 = sst.kurtosis(x, fisher=False); em = 0.5772156649
    sr0 = math.sqrt(1 / (n - 1)) * ((1 - em) * sst.norm.ppf(1 - 1 / ntrials) + em * sst.norm.ppf(1 - 1 / (ntrials * math.e)))
    den = math.sqrt(max(1 - g3 * sr + (g4 - 1) / 4 * sr * sr, 1e-12))
    return float(sst.norm.cdf((sr - sr0) * math.sqrt(n - 1) / den))

def mcpt(gross, n_perm=1000, seed=1):
    rng = np.random.default_rng(seed); g = np.array(gross)
    if len(g) < 5: return 1.0
    obs = g.mean(); cnt = 0
    for _ in range(n_perm):
        if (g * rng.choice([-1, 1], len(g))).mean() >= obs: cnt += 1
    return (1 + cnt) / (1 + n_perm)

NT = 11
def gate(trades):
    if len(trades) < 20: return dict(netR=0, t=0, d=0, p=1, n=len(trades), PASS=False)
    r = np.array([t['net'] / t['risk'] for t in trades])
    g = [t['gross'] for t in trades]
    t = hac_t(r); d = dsr(r, NT); p = mcpt(g)
    return dict(netR=float(r.mean()), t=t, d=d, p=p, n=len(r), PASS=(t >= 2 and d >= 0.95 and p < 0.05))

def verdict(days, label):
    n = len(days); cut = int(n * 0.70)
    tr, ho = days[:cut], days[cut:]
    sel = {}; results = {}; n_pass = 0
    for book in PRIORITY:
        best, best_r = None, -9
        for params in GRIDS[book]:
            t = run_book(tr, book, params)
            r = np.mean([x['net'] / x['risk'] for x in t]) if len(t) >= 10 else -9
            if r > best_r: best, best_r = params, r
        sel[book] = best
        res = gate(run_book(ho, book, best))
        results[book] = res; n_pass += res['PASS']
        print(f"[{label}] {book:8s} sel={best} | HO: n={res['n']:4d} netR={res['netR']:+.3f} t={res['t']:.2f} DSR={res['d']:.3f} p={res['p']:.4f} {'PASS' if res['PASS'] else 'fail'}")
    ens = gate(run_ensemble(ho, sel))
    tpd = ens['n'] / len(ho)
    print(f"[{label}] ENSEMBLE          | HO: n={ens['n']:4d} netR={ens['netR']:+.3f} t={ens['t']:.2f} DSR={ens['d']:.3f} p={ens['p']:.4f} trades/day={tpd:.2f} {'PASS' if ens['PASS'] else 'fail'}")
    return n_pass, ens['PASS']

if __name__ == "__main__":
    print("=== SELF-TEST: PLANTED (independent alpha per book) ===")
    bp, ep = verdict(gen_days(2500, True, 21), "PLANTED")
    print("=== SELF-TEST: NULL (same structure, zero conditional drift) ===")
    bn, en = verdict(gen_days(2500, False, 22), "NULL")
    ok = bp == 4 and ep and bn == 0 and not en
    print(f"SELF-TEST: {'PASS' if ok else 'FAIL'} (planted books {bp}/4, planted ensemble {ep}; null books {bn}/4, null ensemble {en})")

