#!/usr/bin/env python3
"""5-minute Opening-Range Breakout on real ES 1-min bars (2010-2026).
OHLCV only. Measures NET of MES friction before any claim. Small, pre-specified
structural grid (no PnL-tuned params); reports every cell incl. losers, on
full sample AND a post-2018 out-of-sample split, with HAC-t and hit stats."""
import math, sys
import numpy as np, pandas as pd

FRIC = 0.75      # MES round-trip friction (pts); ~$3.74
PT_USD = 5.0

def hac_t(y, lags=5):
    y=np.asarray(y,float); n=y.size
    if n<10 or np.allclose(y,0): return 0.0
    e=y-y.mean(); s=(e@e)/n
    for l in range(1,min(lags,n-1)+1): s+=2*(1-l/(lags+1))*(e[l:]@e[:-l])/n
    return float(y.mean()/math.sqrt(max(s,1e-12)/n))

def load():
    df = pd.read_parquet("/Users/kaveh/mim_research/es_front_rth_1m.parquet")
    df["date"]=pd.to_datetime(df["date"]).dt.date
    hm = df["hm"].str.split(":", expand=True)
    df["mos"] = (hm[0].astype(int)*60 + hm[1].astype(int)) - (9*60+30)  # minutes-of-session
    df = df[(df["mos"]>=0) & (df["mos"]<390)]
    return df

def run_day(o,h,l,c,mos, W, entry_mode, target_R, fric):
    """One session. mos: minute offset array (0..389). Returns net pts or None."""
    idx = {int(m):i for i,m in enumerate(mos)}
    orbars=[idx[m] for m in range(0,W) if m in idx]
    if len(orbars)<W: return None
    oh=float(np.max(h[orbars])); ol=float(np.min(l[orbars]))
    o0=float(o[idx[0]]); cW=float(c[orbars[-1]])
    walk=[idx[m] for m in range(W,390) if m in idx]
    if not walk: return None
    # ---- entry ----
    if entry_mode=="candle":
        d = 1 if cW>o0 else -1 if cW<o0 else 0
        if d==0: return None
        entry=float(o[walk[0]]); start=0
    else:  # OR break: first bar to pierce OR_high(long)/OR_low(short)
        d=0; entry=np.nan; start=None
        for k,i in enumerate(walk):
            hi=float(h[i]); lo=float(l[i])
            up = hi>=oh; dn = lo<=ol
            if up and not dn: d=1; entry=oh; start=k; break
            if dn and not up: d=-1; entry=ol; start=k; break
            if up and dn:  # engulfing bar: take the open-side first (conservative)
                if float(o[i])>=oh: d=1; entry=oh
                else: d=-1; entry=ol
                start=k; break
        if d==0: return None
    stop = ol if d>0 else oh
    risk = abs(entry-stop)
    if risk<=0: return None
    tgt = entry + d*target_R*risk if target_R else None
    # ---- walk to stop/target/EOD ----
    seg=walk[start:] if entry_mode=="break" else walk
    exit_px=float(c[seg[-1]]); kind="eod"
    for i in seg:
        hi=float(h[i]); lo=float(l[i])
        hit_stop = (lo<=stop) if d>0 else (hi>=stop)
        hit_tgt  = tgt is not None and ((hi>=tgt) if d>0 else (lo<=tgt))
        if hit_stop: exit_px=stop; kind="stop"; break
        if hit_tgt:  exit_px=tgt;  kind="tp";   break
    return d*(exit_px-entry)-fric

def backtest(df, W, entry_mode, target_R, fric=FRIC):
    pnl=[]; dates=[]
    for dte,g in df.groupby("date", sort=True):
        g=g.sort_values("mos")
        r=run_day(g["open"].to_numpy(),g["high"].to_numpy(),g["low"].to_numpy(),
                  g["close"].to_numpy(),g["mos"].to_numpy(), W, entry_mode, target_R, fric)
        if r is not None: pnl.append(r); dates.append(dte)
    return np.array(pnl), np.array(dates)

def summ(pnl, label):
    n=pnl.size
    if n<10: return {"cell":label,"n":n}
    win=pnl[pnl>0]; los=pnl[pnl<=0]
    aw=win.mean() if win.size else 0; al=los.mean() if los.size else 0
    pf=(win.sum()/abs(los.sum())) if los.size and los.sum()!=0 else float('inf')
    return {"cell":label,"n":n,"net_pt":round(float(pnl.mean()),4),
            "net_tot":round(float(pnl.sum()),1),"ann_usd":round(float(pnl.sum()/(n/252)*PT_USD),0),
            "hit":round(float((pnl>0).mean()),3),"avgW":round(float(aw),2),"avgL":round(float(al),2),
            "pf":round(float(pf),2),"hac_t":round(hac_t(pnl),2)}

def main():
    df=load()
    yrs=pd.Series([d.year for d in df["date"].unique()])
    print(f"Loaded {df['date'].nunique()} ES sessions {min(df['date'])}..{max(df['date'])}  "
          f"friction={FRIC}pt RT\n")
    rows=[]
    grid=[(W,em,tr) for W in (5,15,30) for em in ("break","candle") for tr in (None,10)]
    for W,em,tr in grid:
        pnl,dts=backtest(df,W,em,tr)
        yr=np.array([d.year for d in dts])
        tag=f"OR{W}m_{em}_{'EOD' if tr is None else f'{tr}R'}"
        full=summ(pnl,tag+" FULL")
        oos =summ(pnl[yr>=2018],tag+" 2018+ OOS")
        rows+=[full,oos]
    out=pd.DataFrame(rows)
    pd.set_option("display.width",220)
    print(out.to_string(index=False))
    print(f"\nFriction hurdle {FRIC}pt/trade. 'real' = net_pt>0 on BOTH full & OOS, "
          f"HAC-t>=2, and not a lone cell. {len(grid)} cells tested (multiple-testing aware).")

if __name__=="__main__":
    main()

