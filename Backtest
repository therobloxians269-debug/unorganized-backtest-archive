"""
CANDIDATE BATTERY -- falsify every ranked intraday anomaly on real ES data.
For each: HAC-t regression on the continuous predictor + a no-parameter sign rule,
gross AND net of MES retail cost, FULL sample AND post-2018 OOS.
No parameter optimization (that's how you fool yourself).

    python3 all_candidates.py
"""
from __future__ import annotations
import numpy as np
import pandas as pd

BARS = "/Users/kaveh/mim_research/es_front_rth_1m.parquet"
PUB = pd.Timestamp("2018-07-01")
PT = 5.0
COST = (1.78 + 2 * 1.25) / PT          # ~0.856 pt round-turn (base retail)


def hac_t(y, x, lags=10):
    x = np.asarray(x, float); y = np.asarray(y, float)
    m = np.isfinite(x) & np.isfinite(y); x, y = x[m], y[m]
    X = np.column_stack([np.ones_like(x), x])
    b, *_ = np.linalg.lstsq(X, y, rcond=None)
    r = y - X @ b
    XtXi = np.linalg.inv(X.T @ X); S = X * r[:, None]; cov = S.T @ S
    for L in range(1, lags + 1):
        G = S[L:].T @ S[:-L]; cov += (1 - L / (lags + 1)) * (G + G.T)
    V = XtXi @ cov @ XtXi
    return b[1], b[1] / np.sqrt(V[1, 1]), 1 - r.var() / y.var()


def evalrule(name, df, pos_col, pnlpts_col, pred_col=None, tgt_col=None):
    """df indexed by date; pos in {-1,0,1}; pnlpts_col = signed gross pts when traded."""
    def block(d, tag):
        d = d[d[pos_col] != 0].dropna(subset=[pnlpts_col])
        if len(d) < 50:
            return f"{name:26s} {tag:5s} N={len(d):<5} too few"
        g = d[pnlpts_col].values
        net = g - COST
        yrs = (d.index.max() - d.index.min()).days / 365.25
        tpy = len(d) / yrs
        gsh = g.mean() / g.std(ddof=1) * np.sqrt(tpy)
        nsh = net.mean() / net.std(ddof=1) * np.sqrt(tpy)
        t = g.mean() / (g.std(ddof=1) / np.sqrt(len(g)))
        pf = net[net > 0].sum() / -net[net < 0].sum() if (net < 0).any() else np.inf
        reg = ""
        if pred_col and tgt_col:
            b, tb, r2 = hac_t(d[tgt_col].values, d[pred_col].values)
            reg = f" | reg t={tb:+.2f} R2={r2*100:.2f}%"
        return (f"{name:26s} {tag:5s} N={len(d):<5} gross {g.mean():+.3f}pt (t={t:+.2f}) "
                f"net {net.mean():+.3f}pt nSh={nsh:+.2f} PF={pf:.2f}{reg}")
    print(block(df, "FULL"))
    print(block(df[df.index >= PUB], "OOS"))
    print()


def main():
    b = pd.read_parquet(BARS)
    b = b.sort_values(["date", "hm"])
    # wide close/open by minute
    C = b.pivot_table(index="date", columns="hm", values="close", aggfunc="last")
    O = b.pivot_table(index="date", columns="hm", values="open", aggfunc="first")
    HI = b.groupby("date")["high"].max(); LO = b.groupby("date")["low"].min()
    front = b.groupby("date")["front"].first()

    def col(W, hm): return W[hm] if hm in W.columns else pd.Series(index=W.index, dtype=float)
    d = pd.DataFrame(index=C.index)
    d["front"] = front
    d["o0930"] = col(O, "09:30"); d["c0959"] = col(C, "09:59")
    d["c1100"] = col(C, "11:00"); d["c1200"] = col(C, "12:00")
    d["c1500"] = col(C, "15:00"); d["o1530"] = col(O, "15:30"); d["c1559"] = col(C, "15:59")
    d["hi"] = HI; d["lo"] = LO
    d["prevc"] = d.groupby("front")["c1559"].shift(1)          # same-contract prev close
    d["roll"] = d["front"] != d["front"].shift(1)
    d["pdh"] = d["hi"].shift(1); d["pdl"] = d["lo"].shift(1)
    # opening range (first 30 min) high/low
    fr = b[(b["hm"] >= "09:30") & (b["hm"] <= "09:59")]
    d["orh"] = fr.groupby("date")["high"].max(); d["orl"] = fr.groupby("date")["low"].min()
    # VWAP to 15:00
    upto = b[b["hm"] <= "15:00"].copy()
    upto["tp"] = (upto["high"] + upto["low"] + upto["close"]) / 3
    upto["tpv"] = upto["tp"] * upto["volume"]
    vw = upto.groupby("date").agg(tpv=("tpv", "sum"), v=("volume", "sum"))
    d["vwap1500"] = vw["tpv"] / vw["v"]

    print(f"days={len(d)}  cost={COST:.3f} pt  OOS>= {PUB.date()}\n")
    print("=" * 110)

    # ---- C3 GAP FADE: fade the overnight gap, hold open->close ----
    g = d[~d["roll"]].copy()
    g["pred"] = g["o0930"] / g["prevc"] - 1
    g["tgt"] = g["c1559"] / g["o0930"] - 1
    g["pos"] = -np.sign(g["pred"])
    g["pnl"] = g["pos"] * (g["c1559"] - g["o0930"])
    evalrule("C3 gap-fade (open->close)", g, "pos", "pnl", "pred", "tgt")

    # ---- C3b GAP FADE large gaps only (|gap|>0.4%) ----
    gl = g[(g["pred"].abs() > 0.004)].copy()
    evalrule("C3b gap-fade |gap|>0.4%", gl, "pos", "pnl", "pred", "tgt")

    # ---- C5 INTO-CLOSE MOMENTUM (LETF rebalance): day-so-far -> last 30 ----
    m = d.copy()
    m["pred"] = m["o1530"] / m["o0930"] - 1
    m["tgt"] = m["c1559"] / m["o1530"] - 1
    m["pos"] = np.sign(m["pred"])
    m["pnl"] = m["pos"] * (m["c1559"] - m["o1530"])
    evalrule("C5 into-close momentum", m, "pos", "pnl", "pred", "tgt")

    # ---- C8 ORB: first-30 range, breakout by 11:00, hold to close ----
    o = d.copy()
    up = o["c1100"] > o["orh"]; dn = o["c1100"] < o["orl"]
    o["pos"] = np.where(up, 1, np.where(dn, -1, 0))
    o["entry"] = o["c1100"]
    o["pnl"] = o["pos"] * (o["c1559"] - o["entry"])
    evalrule("C8 ORB(30m,brk by11,hold)", o, "pos", "pnl")

    # ---- C9 LUNCH REVERSION: fade the morning (09:30->12:00) in afternoon ----
    l = d.copy()
    l["pred"] = l["c1200"] / l["o0930"] - 1
    l["tgt"] = l["c1559"] / l["c1200"] - 1
    l["pos"] = -np.sign(l["pred"])
    l["pnl"] = l["pos"] * (l["c1559"] - l["c1200"])
    evalrule("C9 lunch-reversion(pm)", l, "pos", "pnl", "pred", "tgt")

    # ---- C7 VWAP REVERSION: at 15:00 fade deviation from VWAP, hold to close ----
    v = d.copy()
    v["dev"] = v["c1500"] - v["vwap1500"]
    v["pred"] = v["dev"] / v["c1500"]
    v["tgt"] = v["c1559"] / v["c1500"] - 1
    v["pos"] = -np.sign(v["dev"])
    v["pnl"] = v["pos"] * (v["c1559"] - v["c1500"])
    evalrule("C7 VWAP-reversion(last hr)", v, "pos", "pnl", "pred", "tgt")

    # ---- C12 PDH/PDL SWEEP FADE: failed breakout of prior-day extreme by 15:00 ----
    # FIX: use intraday high/low BEFORE 15:00 only (full-day hi/lo = lookahead into trade window)
    pre = b[b["hm"] <= "15:00"]
    d["hi15"] = pre.groupby("date")["high"].max(); d["lo15"] = pre.groupby("date")["low"].min()
    s = d.copy()
    swept_up = (s["hi15"] > s["pdh"]) & (s["c1500"] < s["pdh"])    # poked above PDH pre-15:00, back below
    swept_dn = (s["lo15"] < s["pdl"]) & (s["c1500"] > s["pdl"])
    s["pos"] = np.where(swept_up, -1, np.where(swept_dn, 1, 0))
    s["pnl"] = s["pos"] * (s["c1559"] - s["c1500"])
    evalrule("C12 PDH/PDL sweep-fade", s, "pos", "pnl")

    # ---- X1 INTRADAY REVERSAL: fade first-30 over rest of day (opposite of MIM) ----
    r = d.copy()
    r["pred"] = r["c0959"] / r["o0930"] - 1
    r["tgt"] = r["c1559"] / r["c0959"] - 1
    r["pos"] = -np.sign(r["pred"])
    r["pnl"] = r["pos"] * (r["c1559"] - r["c0959"])
    evalrule("X1 first30-reversal(restday)", r, "pos", "pnl", "pred", "tgt")

    print("=" * 110)
    print("Reminder: 8 candidates x 2 windows = 16 tests -> any single t>2 must clear OOS + net + DSR.")


if __name__ == "__main__":
    main()

