def run_cfg(F, d, cfg, mode, pv, comm_pts, comm, ndays, st_override=None, label=""):
    trig = F.trigA(cfg["K2"]) if cfg["trig"] == "A" else F.trigB(cfg["span"], cfg["z"])
    if st_override is None:
        er, sg = F.er(cfg["K"])
        st = _state_machine(er, d["sess"], d["dc"], cfg["hi"], cfg["lo"])
    else:
        st = st_override
    sig = make_sig(st, trig, mode, cfg["cool"], d["n"])
    risk = cfg["s"] * d[cfg["atr"]]
    e_i, x_i, dr, nr, npts, why = simulate(sig, d["o"], d["h"], d["l"], d["c"], risk,
                                           d["fe"], cfg["mh"], cfg["rr"], SLIP,
                                           comm_pts, 5)
    s = stats(e_i, x_i, dr, nr, npts, why, d, pv, comm, ndays, label)
    s["_nr"] = nr
    s["_e"] = e_i
    s["_dir"] = dr
    s["_st"] = st
    return s


def slice_d(d, mask):
    out = {}
    for k in ("o", "h", "l", "c", "atr15", "atr30", "atr60", "sess", "dc", "ts"):
        out[k] = d[k][mask]
    out["idx"] = d["idx"][mask]
    out["n"] = int(mask.sum())
    out["fe"] = _forced_exit_idx(out["idx"])
    out["dc"] = pd.factorize(pd.Series(out["dc"]))[0].astype(np.int64)
    return out


