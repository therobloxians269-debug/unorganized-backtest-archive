#!/usr/bin/env python3
"""
backtester.py
═══════════════════════════════════════════════════════════════════════════════
Intraday Net-GEX Gamma-Flip Strategy ─ Institutional-Grade Backtest Engine
═══════════════════════════════════════════════════════════════════════════════

Strategy
────────
  · Long  SPY when Net GEX crosses  negative → positive  (Bullish Gamma Flip)
  · Short SPY when Net GEX crosses  positive → negative  (Bearish Gamma Flip)
  · Hold the position until the next opposing flip or 15:45 EST hard stop

Anti-Look-Ahead Discipline
──────────────────────────
  · Signal evaluated at the CLOSE of bar[i]
  · Execution filled at the OPEN of bar[i+1]  →  zero look-ahead bias

Friction Model
──────────────
  · $0.50 per option contract equivalent, applied each side (round-trip = $1.00/contract)
  · 1% slippage on every fill price (longs pay more, shorts receive less)

Performance Metrics
───────────────────
  Cumulative Return  |  Win Rate  |  Max Drawdown  |  Annualised Sharpe Ratio
  Profit Factor      |  Avg Win   |  Avg Loss      |  Total Commissions Paid

Dependencies: numpy, pandas  (stdlib only — no broker APIs)
"""

from __future__ import annotations

import warnings
from dataclasses import dataclass, asdict
from datetime import time
from typing import Optional

import numpy as np
import pandas as pd

warnings.filterwarnings("ignore")


# ─────────────────────────────────────────────────────────────────────────────
# §1  CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

@dataclass(frozen=True)
class BacktestConfig:
    """
    Immutable strategy and simulation parameters.
    Modify here to run different scenarios without touching engine code.
    """

    # ── Universe ──────────────────────────────────────────────────────────────
    ticker:                str   = "SPY"
    start_date:            str   = "2024-01-02"
    end_date:              str   = "2024-12-31"

    # ── Capital & position sizing ─────────────────────────────────────────────
    initial_capital:       float = 100_000.0
    contracts:             int   = 10           # option-contract equivalents per trade
    shares_per_contract:   int   = 100          # OCC standard multiplier

    # ── Friction ──────────────────────────────────────────────────────────────
    fee_per_contract:      float = 0.50         # USD, applied each side of the trade
    slippage_pct:          float = 0.01         # 1% adverse fill on every execution

    # ── Session timing (all times in EST) ─────────────────────────────────────
    market_open:           time  = time(9, 30)
    force_close_time:      time  = time(15, 45) # hard intraday stop — no overnight holds
    bar_interval_min:      int   = 5

    # ── Benchmark (for Sharpe) ────────────────────────────────────────────────
    risk_free_rate:        float = 0.05         # annualised risk-free rate
    trading_days_year:     int   = 252


# ─────────────────────────────────────────────────────────────────────────────
# §2  SYNTHETIC DATA GENERATOR
# ─────────────────────────────────────────────────────────────────────────────

def generate_synthetic_data(cfg: BacktestConfig, seed: int = 42) -> pd.DataFrame:
    """
    Produce a realistic 5-minute SPY OHLCV DataFrame co-registered with a Net
    GEX indicator stream.

    SPY price  →  Geometric Brownian Motion (GBM)
    Net GEX    →  Ornstein–Uhlenbeck process (mean-reverting around zero,
                  reset with fresh positioning at each market open to simulate
                  daily options dealer re-hedging behaviour)

    The OU parameters are tuned to generate ~4–8 zero-crossings per session,
    consistent with intraday gamma-flip literature.

    Parameters
    ──────────
    cfg   : BacktestConfig
    seed  : int  — RNG seed for reproducibility

    Returns
    ───────
    pd.DataFrame with DatetimeIndex and columns:
        open, high, low, close, volume, net_gex
    """
    rng = np.random.default_rng(seed)

    # ── Timestamp grid: all 5-min bars for every business day ─────────────────
    biz_days  = pd.bdate_range(cfg.start_date, cfg.end_date)
    bar_times = pd.date_range("09:30", "15:55", freq="5min").time  # 78 bars/day

    timestamps = [
        pd.Timestamp(f"{day.date()} {bt}")
        for day in biz_days
        for bt in bar_times
    ]
    n = len(timestamps)

    # ── SPY price via GBM ─────────────────────────────────────────────────────
    S0        = 470.0           # approximate SPY level at start of 2024
    mu_ann    = 0.12            # 12% annual expected drift
    sigma_ann = 0.16            # 16% annual vol  (approx VIX/√252)
    dt        = cfg.bar_interval_min / (60.0 * 6.5 * cfg.trading_days_year)  # fraction of trading day

    log_returns  = rng.normal(mu_ann * dt, sigma_ann * np.sqrt(dt), n)
    close        = S0 * np.exp(np.cumsum(log_returns))

    bar_std      = sigma_ann * np.sqrt(dt) * close     # per-bar 1σ price move
    open_arr     = np.empty(n, dtype=np.float64)
    open_arr[0]  = S0
    open_arr[1:] = close[:-1]                          # open = prev bar's close

    high = np.maximum(open_arr, close) + np.abs(rng.normal(0, 0.35 * bar_std, n))
    low  = np.minimum(open_arr, close) - np.abs(rng.normal(0, 0.35 * bar_std, n))
    low  = np.maximum(low, 0.01)                       # floor at one penny

    volume = rng.integers(500_000, 8_000_000, n)

    # ── Net GEX via Ornstein–Uhlenbeck ────────────────────────────────────────
    # Parameters
    ou_theta = 0.045    # mean-reversion speed  (strength of pull toward μ)
    ou_mu    = 0.0      # long-run mean          (zero = balanced gamma positioning)
    ou_sigma = 0.30     # per-bar OU noise magnitude

    gex      = np.empty(n, dtype=np.float64)
    gex[0]   = rng.uniform(-4.0, 4.0)   # random initial positioning

    for i in range(1, n):
        if pd.Timestamp(timestamps[i]).time() == cfg.market_open:
            # Market open: fresh dealer positioning (random sign & magnitude)
            gex[i] = rng.uniform(-4.0, 4.0)
        else:
            mean_pull = ou_theta * (ou_mu - gex[i - 1])
            noise     = rng.normal(0.0, ou_sigma)
            gex[i]    = gex[i - 1] + mean_pull + noise

    df = pd.DataFrame(
        {
            "open":    open_arr,
            "high":    high,
            "low":     low,
            "close":   close,
            "volume":  volume,
            "net_gex": gex,
        },
        index=pd.DatetimeIndex(timestamps, name="datetime"),
    )
    return df


# ─────────────────────────────────────────────────────────────────────────────
# §3  SIGNAL ENGINE  ·  zero-cross detection, strictly no look-ahead
# ─────────────────────────────────────────────────────────────────────────────

def compute_signals(df: pd.DataFrame, cfg: BacktestConfig) -> pd.DataFrame:
    """
    Detect Net GEX zero-crossings (gamma flips) using vectorised pandas/numpy.

    Gamma Flip Semantics
    ────────────────────
      +1  Bullish Flip  →  Net GEX crosses  negative → positive
      -1  Bearish Flip  →  Net GEX crosses  positive → negative
       0  No crossing;  or first bar of session (cross-day comparisons nullified)

    No Look-Ahead Guarantee
    ───────────────────────
      Signal is stored on bar[i] using only information available at bar[i]'s
      CLOSE. Execution against this signal occurs at bar[i+1]'s OPEN in the
      backtest engine.

    Parameters
    ──────────
    df   : raw OHLCV + net_gex DataFrame (output of generate_synthetic_data)
    cfg  : BacktestConfig

    Returns
    ───────
    df with added columns: gex_sign, raw_signal, is_market_open
    """
    df = df.copy()

    gex           = df["net_gex"]
    gex_sign      = np.sign(gex)           # vectorised: +1, 0, or -1
    prev_gex_sign = gex_sign.shift(1)      # prior bar's sign (NaN at index 0)

    # Boolean masks for each crossing direction
    bull_flip = (prev_gex_sign < 0) & (gex_sign > 0)
    bear_flip = (prev_gex_sign > 0) & (gex_sign < 0)

    # Nullify any crossing that falls on a market-open bar:
    # comparing prev-day's final GEX to today's first GEX is economically
    # meaningless — different positioning regimes.
    is_mkt_open  = pd.Series(df.index.time == cfg.market_open, index=df.index)
    bull_flip   &= ~is_mkt_open
    bear_flip   &= ~is_mkt_open

    df["gex_sign"]       = gex_sign.values
    df["raw_signal"]     = np.where(bull_flip, 1, np.where(bear_flip, -1, 0)).astype(int)
    df["is_market_open"] = is_mkt_open.values

    return df


# ─────────────────────────────────────────────────────────────────────────────
# §4  FILL PRICE & COMMISSION UTILITIES
# ─────────────────────────────────────────────────────────────────────────────

def apply_slippage(price: float, action: int, slippage_pct: float) -> float:
    """
    Apply directional slippage to simulate adverse retail fills:

      action = +1  (buying  — long entry or short cover)
               → pay  price × (1 + slippage_pct)   [pays more]

      action = -1  (selling — long exit or short entry)
               → recv price × (1 – slippage_pct)   [receives less]

    This 1% penalty broadly represents wide bid-ask spreads, price impact,
    and the structural disadvantage of trading against faster participants.
    """
    return price * (1.0 + action * slippage_pct)


def round_trip_commission(cfg: BacktestConfig) -> float:
    """
    Total commission for one complete round-trip trade (entry side + exit side).
    = fee_per_contract × contracts × 2
    """
    return cfg.fee_per_contract * cfg.contracts * 2.0


# ─────────────────────────────────────────────────────────────────────────────
# §5  TRADE RECORD
# ─────────────────────────────────────────────────────────────────────────────

@dataclass
class TradeRecord:
    """Immutable snapshot of a single completed round-trip trade."""

    entry_time:   pd.Timestamp     # bar datetime of fill (bar[i+1] open)
    exit_time:    pd.Timestamp     # bar datetime of close fill
    direction:    int              # +1 = long, -1 = short
    entry_fill:   float            # slippage-adjusted entry price
    exit_fill:    float            # slippage-adjusted exit price
    gross_pnl:    float            # P&L before commissions (USD)
    fees:         float            # round-trip commissions (USD)
    net_pnl:      float            # P&L after commissions (USD)
    exit_reason:  str              # "signal_flip" | "force_close" |
                                   # "eod_safety"  | "end_of_data"


# ─────────────────────────────────────────────────────────────────────────────
# §6  CORE BACKTEST ENGINE
# ─────────────────────────────────────────────────────────────────────────────

def run_backtest(
    df: pd.DataFrame,
    cfg: BacktestConfig,
) -> tuple[pd.DataFrame, list[TradeRecord]]:
    """
    Bar-by-bar simulation of the Net-GEX gamma-flip strategy.

    Execution Priority Order (evaluated every bar)
    ───────────────────────────────────────────────
    [1] New trading day detected  →  emergency close if position still open
        (safety net; should not fire if Rule [2] functioned correctly)
    [2] Bar time == 15:45 EST    →  hard force-close any open position
    [3] Bar time >= 15:45 EST    →  trading embargo (no new entries)
    [4] Signal from previous bar's close:
          a. Signal reverses current position  →  close existing, then open reversed
          b. Signal matches current direction  →  hold (no action)
          c. Position flat                     →  open new position

    Slippage is applied at every fill. Commissions are deducted when a
    position is closed (round-trip basis).

    Parameters
    ──────────
    df   : signal-enriched DataFrame (output of compute_signals)
    cfg  : BacktestConfig

    Returns
    ───────
    (result_df, trades)
      result_df  : input df with appended "equity" column (bar-level curve)
      trades     : list of TradeRecord for every completed round-trip
    """
    notional = cfg.contracts * cfg.shares_per_contract   # dollar multiplier per $1/share move
    rt_fee   = round_trip_commission(cfg)
    slip     = cfg.slippage_pct

    # ── Mutable state ─────────────────────────────────────────────────────────
    equity:     float                   = cfg.initial_capital
    position:   int                     = 0      # +1 long | -1 short | 0 flat
    entry_fill: Optional[float]         = None
    entry_time: Optional[pd.Timestamp]  = None

    trades:       list[TradeRecord] = []
    equity_curve: np.ndarray        = np.full(len(df), cfg.initial_capital, dtype=np.float64)

    # ── Pre-extract arrays for minimal per-bar overhead ───────────────────────
    opens        = df["open"].to_numpy(dtype=np.float64)
    raw_sigs     = df["raw_signal"].to_numpy(dtype=np.int32)
    bar_times    = df.index.time                            # array of datetime.time
    mkt_open_fl  = df["is_market_open"].to_numpy(dtype=bool)
    index        = df.index                                 # DatetimeIndex

    # ── Nested helpers (close over mutable state via nonlocal) ───────────────

    def _close(idx: int, reason: str) -> None:
        """
        Close the open position at bar[idx]'s open price.
        Computes slippage-adjusted fill, gross/net P&L, and appends a TradeRecord.
        """
        nonlocal position, entry_fill, entry_time, equity
        # Closing action is the OPPOSITE of the position direction
        close_action = -position                                   # cover long → buy; cover short → sell
        fill         = apply_slippage(opens[idx], close_action, slip)
        gross_pnl    = (fill - entry_fill) * position * notional   # +ve for profit
        net_pnl      = gross_pnl - rt_fee
        trades.append(TradeRecord(
            entry_time  = entry_time,   # type: ignore[arg-type]
            exit_time   = index[idx],
            direction   = position,
            entry_fill  = entry_fill,   # type: ignore[arg-type]
            exit_fill   = fill,
            gross_pnl   = gross_pnl,
            fees        = rt_fee,
            net_pnl     = net_pnl,
            exit_reason = reason,
        ))
        equity     += net_pnl
        position    = 0
        entry_fill  = None
        entry_time  = None

    def _open(idx: int, direction: int) -> None:
        """
        Open a new position at bar[idx]'s open price with directional slippage.
        direction: +1 = long, -1 = short
        """
        nonlocal position, entry_fill, entry_time
        # Buying a long → +1 action; entering a short → -1 action (sell)
        fill       = apply_slippage(opens[idx], direction, slip)
        position   = direction
        entry_fill = fill
        entry_time = index[idx]

    # ── Main simulation loop ──────────────────────────────────────────────────
    for i in range(1, len(df)):
        bt = bar_times[i]

        # ── Rule [1]: Emergency overnight safety close ─────────────────────────
        # Triggered if somehow a position survived to the next session's open.
        # Under normal operation this should never fire; the force-close at 15:45
        # should always flatten the book before session end.
        if position != 0 and mkt_open_fl[i]:
            _close(i, "eod_safety")

        # ── Rule [2]: Hard force-close at 15:45 EST bar open ──────────────────
        # Executes at the OPEN of the 15:45 bar — i.e. exactly 15:45 EST.
        # This eliminates overnight margin risk and tail-event exposure.
        if position != 0 and bt == cfg.force_close_time:
            _close(i, "force_close")

        # ── Rule [3]: Trading embargo from 15:45 onward ───────────────────────
        # No new position may be opened at or after the force-close time, or on
        # the first bar of a new session (which would use a stale prior signal).
        trading_halted = (bt >= cfg.force_close_time) or mkt_open_fl[i]

        # ── Rule [4]: Execute signal from the PREVIOUS bar's close ─────────────
        # raw_sigs[i-1] is the signal stamped at close of bar[i-1];
        # we act on it at bar[i]'s open — this is the anti-look-ahead mechanism.
        signal = int(raw_sigs[i - 1])

        if signal != 0 and not trading_halted:
            # Sub-rule (a): reversal — close existing position before opening new
            if position != 0 and position != signal:
                _close(i, "signal_flip")
            # Sub-rules (b)/(c): open if flat; hold if same direction
            if position == 0:
                _open(i, signal)

        equity_curve[i] = equity

    # ── End-of-data cleanup ───────────────────────────────────────────────────
    if position != 0:
        _close(len(df) - 1, "end_of_data")
        equity_curve[-1] = equity

    result_df           = df.copy()
    result_df["equity"] = equity_curve
    return result_df, trades


# ─────────────────────────────────────────────────────────────────────────────
# §7  PERFORMANCE ANALYTICS
# ─────────────────────────────────────────────────────────────────────────────

def compute_metrics(
    df:     pd.DataFrame,
    trades: list[TradeRecord],
    cfg:    BacktestConfig,
) -> dict:
    """
    Derive institutional-grade performance statistics from the equity curve
    and trade-level records.

    Metrics
    ───────
    Cumulative Return (%)  — total return on initial capital
    Win Rate (%)           — fraction of trades with net_pnl > 0
    Max Drawdown (%)       — peak-to-trough decline on the equity curve
    Sharpe Ratio           — annualised, excess-return basis (daily resampled)
    Profit Factor          — gross profit ÷ gross loss
    Avg Win ($)            — average winning trade P&L
    Avg Loss ($)           — average losing trade P&L  (negative value)
    Total Fees ($)         — sum of all round-trip commissions paid
    Final Equity ($)       — terminal portfolio value

    Parameters
    ──────────
    df      : result DataFrame with "equity" column (output of run_backtest)
    trades  : list of TradeRecord
    cfg     : BacktestConfig

    Returns
    ───────
    Ordered dict of metric_label → value
    """
    equity = df["equity"].to_numpy(dtype=np.float64)

    # ── Cumulative Return ─────────────────────────────────────────────────────
    cum_ret_pct = (equity[-1] / cfg.initial_capital - 1.0) * 100.0

    # ── Annualised Sharpe Ratio ───────────────────────────────────────────────
    # Resample bar-level equity to end-of-day snapshots → daily return series
    eq_daily   = df["equity"].resample("1B").last().dropna()
    daily_rets = eq_daily.pct_change().dropna()
    daily_rf   = cfg.risk_free_rate / cfg.trading_days_year  # per-day risk-free

    if len(daily_rets) > 1 and daily_rets.std() > 1e-10:
        excess_rets = daily_rets - daily_rf
        sharpe      = excess_rets.mean() / excess_rets.std() * np.sqrt(cfg.trading_days_year)
    else:
        sharpe = np.nan

    # ── Maximum Drawdown ──────────────────────────────────────────────────────
    # Vectorised peak-tracking via cumulative maximum
    running_max  = np.maximum.accumulate(equity)
    safe_max     = np.where(running_max > 0, running_max, 1.0)
    drawdown_pct = (equity - running_max) / safe_max * 100.0
    max_dd_pct   = float(drawdown_pct.min())

    # ── Trade-level Statistics ────────────────────────────────────────────────
    n_trades = len(trades)
    if n_trades > 0:
        pnls         = np.array([t.net_pnl for t in trades], dtype=np.float64)
        winners      = pnls[pnls >  0]
        losers       = pnls[pnls <  0]
        win_rate     = float(len(winners)) / n_trades * 100.0
        avg_win      = float(winners.mean())     if len(winners) > 0 else 0.0
        avg_loss     = float(losers.mean())      if len(losers)  > 0 else 0.0
        gross_profit = float(winners.sum())      if len(winners) > 0 else 0.0
        gross_loss   = float(abs(losers.sum()))  if len(losers)  > 0 else 0.0
        pf           = gross_profit / gross_loss if gross_loss   > 0 else np.inf
        total_fees   = float(sum(t.fees for t in trades))
        n_long       = sum(1 for t in trades if t.direction ==  1)
        n_short      = sum(1 for t in trades if t.direction == -1)
        n_force      = sum(1 for t in trades if t.exit_reason == "force_close")
    else:
        win_rate = avg_win = avg_loss = gross_profit = gross_loss = total_fees = pf = 0.0
        n_long = n_short = n_force = 0

    return {
        "Total Trades":          n_trades,
        "Long Trades":           n_long,
        "Short Trades":          n_short,
        "Force-Closed Trades":   n_force,
        "Cumulative Return (%)": round(cum_ret_pct, 4),
        "Win Rate (%)":          round(win_rate, 2),
        "Max Drawdown (%)":      round(max_dd_pct, 4),
        "Sharpe Ratio":          round(float(sharpe), 4) if not np.isnan(sharpe) else "N/A",
        "Profit Factor":         round(pf, 4)            if not np.isinf(pf)      else "∞",
        "Avg Win ($)":           round(avg_win,    2),
        "Avg Loss ($)":          round(avg_loss,   2),
        "Total Fees ($)":        round(total_fees, 2),
        "Final Equity ($)":      round(float(equity[-1]), 2),
    }


