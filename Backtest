"""Contract specs, realistic retail friction, and margin for the $1k-fit test.

Sources of truth for a robustness-first backtest:
- point value / tick from CME micro contract specs
- commission: conservative all-in retail micro RT (Tradovate/AMP/NinjaTrader ~$0.74-1.24)
- slippage: 1 tick PER SIDE on stop/market entries+exits (2 ticks RT) -- aggressive
  entries (breakouts) really do give this up; limit-entry setups get 1 tick RT (set per family).
- margins: typical discount-broker intraday (day-trade) and overnight (initial/SPAN).
"""

# per-instrument: point_usd = $ per 1.00 index-point move; tick = min price increment
SPECS = {
    "MES": dict(point_usd=5.0,  tick=0.25, comm_rt=1.24, dm_intraday=500,  m_overnight=2455),
    "MNQ": dict(point_usd=2.0,  tick=0.25, comm_rt=1.24, dm_intraday=100,  m_overnight=2220),
    "MYM": dict(point_usd=0.5,  tick=1.0,  comm_rt=1.24, dm_intraday=50,   m_overnight=1050),
    "MCL": dict(point_usd=100.0,tick=0.01, comm_rt=1.24, dm_intraday=100,  m_overnight=1600),
    # full-size aliases map to the micro used to *trade* them on a $1k account:
    "ES":  dict(point_usd=5.0,  tick=0.25, comm_rt=1.24, dm_intraday=500,  m_overnight=2455),  # traded as MES
    "NQ":  dict(point_usd=2.0,  tick=0.25, comm_rt=1.24, dm_intraday=100,  m_overnight=2220),  # traded as MNQ
    "YM":  dict(point_usd=0.5,  tick=1.0,  comm_rt=1.24, dm_intraday=50,   m_overnight=1050),  # traded as MYM
}

# map a data symbol we actually HAVE 1m bars for, per tradable micro
DATA_FOR = {
    "MES": "MES", "ES": "MES",
    "MNQ": "MNQ", "NQ": "MNQ",
    "MYM": "MYM", "YM": "MYM",
}

ACCOUNT = 1000.0            # the account under test
DD_LIMIT_USD = 350.0       # G3: max peak-to-trough $ drawdown a $1k acct can survive (~35%)
SLIP_TICKS_RT_MARKET = 2   # breakout / stop entries: 1 tick each side
SLIP_TICKS_RT_LIMIT = 1    # limit / pullback entries: ~half a tick each side, round to 1


def friction_usd(sym, entry_style="market"):
    """Round-trip $ friction for 1 micro: commission + slippage."""
    s = SPECS[sym]
    slip_ticks = SLIP_TICKS_RT_MARKET if entry_style == "market" else SLIP_TICKS_RT_LIMIT
    return s["comm_rt"] + slip_ticks * s["tick"] * s["point_usd"]


def usd(sym, points):
    return points * SPECS[sym]["point_usd"]

