"""
metrics.py — honest performance statistics, in R.

Everything a discretionary trader should stare at before believing a model:
expectancy per trade, profit factor, win rate, max drawdown (in R), and a
per-trade Sharpe proxy. Broken out by model and by exit reason so you can see
*how* the money is made (targets vs break-evens vs stops), not just the total.
"""
from __future__ import annotations

import numpy as np
import pandas as pd


def summarize(trades: pd.DataFrame) -> dict:
    if trades is None or trades.empty:
        return {"trades": 0}
    R = trades["R"].to_numpy()
    wins = R[R > 0]
    losses = R[R <= 0]
    gross_win = wins.sum()
    gross_loss = -losses.sum()
    equity = np.cumsum(R)
    peak = np.maximum.accumulate(equity)
    dd = equity - peak
    std = R.std(ddof=1) if len(R) > 1 else 0.0

    return {
        "trades": int(len(R)),
        "win_rate": float((R > 0).mean()),
        "expectancy_R": float(R.mean()),
        "total_R": float(R.sum()),
        "total_dollars": float(trades["dollars"].sum()),
        "avg_win_R": float(wins.mean()) if len(wins) else 0.0,
        "avg_loss_R": float(losses.mean()) if len(losses) else 0.0,
        "profit_factor": float(gross_win / gross_loss) if gross_loss > 0 else float("inf"),
        "max_drawdown_R": float(dd.min()) if len(dd) else 0.0,
        "sharpe_per_trade": float(R.mean() / std) if std > 0 else 0.0,
        "avg_bars_held": float(trades["bars_held"].mean()),
        "best_R": float(R.max()),
        "worst_R": float(R.min()),
    }


def by_model(trades: pd.DataFrame) -> pd.DataFrame:
    if trades is None or trades.empty:
        return pd.DataFrame()
    g = trades.groupby("model")["R"]
    out = pd.DataFrame({
        "trades": g.count(),
        "total_R": g.sum(),
        "expectancy_R": g.mean(),
        "win_rate": trades.groupby("model")["R"].apply(lambda x: (x > 0).mean()),
    })
    return out.sort_values("total_R", ascending=False)


def by_reason(trades: pd.DataFrame) -> pd.DataFrame:
    if trades is None or trades.empty:
        return pd.DataFrame()
    g = trades.groupby("reason")["R"]
    return pd.DataFrame({"count": g.count(), "total_R": g.sum(), "avg_R": g.mean()})


def format_report(trades: pd.DataFrame, title: str = "ICT engine") -> str:
    s = summarize(trades)
    lines = [f"===== {title} =====", ""]
    if s.get("trades", 0) == 0:
        lines.append("no trades generated.")
        return "\n".join(lines)
    lines += [
        f"trades           {s['trades']}",
        f"win rate         {s['win_rate']*100:5.1f}%",
        f"expectancy       {s['expectancy_R']:+.3f} R / trade",
        f"total            {s['total_R']:+.1f} R   (${s['total_dollars']:,.0f})",
        f"profit factor    {s['profit_factor']:.2f}",
        f"avg win / loss   {s['avg_win_R']:+.2f} R / {s['avg_loss_R']:+.2f} R",
        f"max drawdown     {s['max_drawdown_R']:.1f} R",
        f"sharpe/trade     {s['sharpe_per_trade']:.2f}",
        f"avg hold         {s['avg_bars_held']:.0f} bars",
        f"best / worst     {s['best_R']:+.2f} R / {s['worst_R']:+.2f} R",
        "",
        "by model:",
        by_model(trades).to_string(),
        "",
        "by exit reason:",
        by_reason(trades).to_string(),
    ]
    return "\n".join(lines)

