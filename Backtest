import numpy as np, pandas as pd, microbt as M

df = M.load('/Users/kaveh/omni_x/es_front_2017_24h_1m.parquet', tf='5min')
NY = 'America/New_York'
ldf = df.tz_convert(NY)
o = df['open'].to_numpy(); h = df['high'].to_numpy(); l = df['low'].to_numpy(); c = df['close'].to_numpy()
lt = ldf.index

# map each bar to (date, time)
dates = lt.normalize()
tmin = lt.hour*60 + lt.minute

# daily ATR from daily bars (prior days), in points
day = ldf.groupby(dates).agg(hi=('high','max'), lo=('low','min'), cl=('close','last'))
day['pc'] = day['cl'].shift(1)
tr = pd.concat([day['hi']-day['lo'], (day['hi']-day['pc']).abs(), (day['lo']-day['pc']).abs()], axis=1).max(axis=1)
atr = tr.rolling(14).mean().shift(1)   # ATR known before today

O930 = 9*60+30
T1000 = 10*60
CLOSE = 16*60
LAST = 15*60+55   # last RTH 5min bar opens 15:55, closes 16:00

trades = []
udates = pd.unique(dates)
# index position map
pos = np.arange(len(lt))
for dt in udates:
    a = float(atr.get(pd.Timestamp(dt), np.nan)) if pd.Timestamp(dt) in atr.index else np.nan
    if not np.isfinite(a) or a <= 0: continue
    mask = dates == dt
    di = pos[mask]
    dtm = tmin[mask]
    # need bar at 09:30, signal bar 09:55, entry bar 10:00
    def bar_at(minute):
        w = np.where(dtm == minute)[0]
        return di[w[0]] if len(w) else None
    b0930 = bar_at(O930)
    b0955 = bar_at(T1000-5)
    b1000 = bar_at(T1000)
    if b0930 is None or b0955 is None or b1000 is None: continue
    open_0930 = o[b0930]
    price_1000 = c[b0955]          # move measured to 09:55 close (causal for 10:00 entry)
    move = price_1000 - open_0930
    if move == 0: continue
    d = -1 if move > 0 else 1       # fade the opening move
    entry_bar = b1000
    entry_px = o[entry_bar]
    target = open_0930
    stop = entry_px - d*0.8*a       # beyond entry against the trade
    # walk bars from entry to last RTH bar
    rth = di[(dtm >= T1000) & (dtm <= LAST)]
    rth = rth[rth >= entry_bar]
    exit_bar = rth[-1]
    for b in rth:
        if b == entry_bar: continue
        hb, lb = h[b], l[b]
        if d == 1:
            hit_stop = lb <= stop
            hit_tgt = hb >= target
        else:
            hit_stop = hb >= stop
            hit_tgt = lb <= target
        if hit_stop or hit_tgt:
            exit_bar = b
            break
    trades.append((int(entry_bar), int(exit_bar), int(d)))

r = M.evaluate(df, trades, name='open-drive-fade-daily')
M.show(r)
import json
yrs = None
tt = pd.DataFrame([(df.index[e], ) for e,x,d in trades])
print('NUMTRADES', len(trades))
print(json.dumps(r, default=str))

