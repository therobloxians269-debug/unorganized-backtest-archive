# ─────────────────────────────────────────────────────────────────────────────
# SIGNAL 1 — INFORMED FLOW RESIDUAL (IFR)
# ─────────────────────────────────────────────────────────────────────────────

class IFREngine:
    """
    IFR_t = OFI_t × sign(ΔOI_t) × |ΔOI_t|^0.5

    ● sign(OFI) == sign(ΔOI)  → informed directional entry
    ● sign(OFI) != sign(ΔOI)  → covering / hedging (uninformed noise)

    The √ dampens outlier sensitivity (Lévy-stable power law,
    consistent with Hu et al. 2025 OU/Lévy formulation for index futures).
    """

    def __init__(self, cfg: StrategyConfig) -> None:
        self.cfg = cfg
        self._ifr_buf: List[float] = []
        self._prev_oi: float = 0.0

    # -- multi-level OFI (Cont, Kukanov & Stoikov 2014) --------------------
    @staticmethod
    def compute_ofi_multilevel(
        bid_prices_now: np.ndarray,  bid_vols_now: np.ndarray,
        ask_prices_now: np.ndarray,  ask_vols_now: np.ndarray,
        bid_prices_prev: np.ndarray, bid_vols_prev: np.ndarray,
        ask_prices_prev: np.ndarray, ask_vols_prev: np.ndarray,
    ) -> float:
        """
        OFI = Σᵢ [ ΔBid_vol_i × 1(ΔBid_price_i > 0)
                  − ΔAsk_vol_i × 1(ΔAsk_price_i < 0) ]
        """
        ofi = 0.0
        for i in range(len(bid_prices_now)):
            if bid_prices_now[i] > bid_prices_prev[i]:
                ofi += bid_vols_now[i]
            elif bid_prices_now[i] == bid_prices_prev[i]:
                ofi += bid_vols_now[i] - bid_vols_prev[i]

            if ask_prices_now[i] < ask_prices_prev[i]:
                ofi -= ask_vols_now[i]
            elif ask_prices_now[i] == ask_prices_prev[i]:
                ofi -= ask_vols_now[i] - ask_vols_prev[i]
        return ofi

    # -- core IFR formula --------------------------------------------------
    def compute(self, ofi: float, oi: float) -> float:
        """IFR_t = OFI_t × sign(ΔOI_t) × |ΔOI_t|^0.5"""
        delta_oi = oi - self._prev_oi
        self._prev_oi = oi
        if delta_oi == 0:
            return 0.0
        return ofi * np.sign(delta_oi) * np.sqrt(abs(delta_oi))

    # -- 20-day rolling z-score --------------------------------------------
    def zscore(self, ifr: float) -> float:
        self._ifr_buf.append(ifr)
        w = self.cfg.ifr_norm_window
        if len(self._ifr_buf) < w + 1:
            return 0.0
        arr = np.array(self._ifr_buf[-w:])
        std = arr.std(ddof=1)
        return (ifr - arr.mean()) / std if std > 1e-8 else 0.0

    def reset_for_roll(self) -> None:
        """Full state flush on contract roll (OI history invalidated)."""
        self._ifr_buf.clear()
        self._prev_oi = 0.0


# ─────────────────────────────────────────────────────────────────────────────
# KALMAN FILTER — 2-STATE  (Level + Trend)
# ─────────────────────────────────────────────────────────────────────────────

class KalmanFilter2State:
    """
    State:       X_t = [B̂_t, ΔB̂_t]'   (basis level + trend)
    Measurement: z_t = B_adj_t = H·X_t + ε

    Forward-recursive only — no Rauch-Tung-Striebel smoother.
    State persists across restarts (critical for live deployment).
    """

    def __init__(self, q: float = 1e-4, r: float = 1e-2) -> None:
        self.F = np.array([[1.0, 1.0], [0.0, 1.0]])   # state transition
        self.H = np.array([[1.0, 0.0]])                # measurement
        self.Q = q * np.eye(2)                         # process noise
        self.R = np.array([[r]])                       # measurement noise
        self.x = np.zeros((2, 1))                      # state estimate
        self.P = np.eye(2)                             # state covariance
        self._residuals: List[float] = []

    def step(self, measurement: float) -> Tuple[float, float]:
        """
        One Kalman step.
        Returns (filtered_level, adaptive_σ̂)

        K_t = P_{t|t−1}·H' (H·P_{t|t−1}·H' + R)⁻¹
        x_{t|t} = x_{t|t−1} + K_t (z_t − H·x_{t|t−1})
        """
        # Predict
        xp = self.F @ self.x
        Pp = self.F @ self.P @ self.F.T + self.Q

        # Update
        z = np.array([[measurement]])
        innov = z - self.H @ xp
        S = self.H @ Pp @ self.H.T + self.R
        K = Pp @ self.H.T @ np.linalg.inv(S)
        self.x = xp + K @ innov
        self.P = (np.eye(2) - K @ self.H) @ Pp

        self._residuals.append(float(innov[0, 0]))
        if len(self._residuals) > 60:
            self._residuals.pop(0)

        sigma = np.std(self._residuals) if len(self._residuals) >= 10 else 1.0
        return float(self.x[0, 0]), max(sigma, 1e-8)


# ─────────────────────────────────────────────────────────────────────────────
# SIGNAL 2 — FUNDING-STRIPPED BASIS DIVERGENCE (FSBD)
# ─────────────────────────────────────────────────────────────────────────────

class FSBDEngine:
    """
    Step 1 — Theoretical basis:
        F*_t = S_t × exp((r_t − q_t) × T_t)
        B_t  = ln(F_t / F*_t)

    Step 2 — Strip funding via 60-day rolling OLS:
        B_adj_t = B_t − α̂₁·SOFR_OIS_t − α̂₂·TED_t

    Step 3 — Kalman filter (level + trend):
        FSBD_t = (B_adj_t − B̂_{t|t}) / σ̂_t

    FSBD > +1.5 → basis too high → SHORT
    FSBD < −1.5 → basis too low  → LONG
    """

    def __init__(self, cfg: StrategyConfig) -> None:
        self.cfg = cfg
        self.kf = KalmanFilter2State(q=cfg.kalman_q, r=cfg.kalman_r)
        self._basis_buf:    List[float] = []
        self._sofr_buf:     List[float] = []
        self._ted_buf:      List[float] = []
        self._alpha1: float = 0.0
        self._alpha2: float = 0.0

    @staticmethod
    def log_basis(spot: float, futures: float,
                  rf: float, q: float, tte: float) -> float:
        fair = spot * np.exp((rf - q) * tte)
        return np.log(futures / fair) if fair > 0 and futures > 0 else 0.0

    def _ols_strip(self, raw_basis: float,
                   sofr_ois: float, ted: float) -> float:
        """60-day rolling OLS projection of funding components."""
        self._basis_buf.append(raw_basis)
        self._sofr_buf.append(sofr_ois)
        self._ted_buf.append(ted)

        n = self.cfg.fsbd_ols_window
        if len(self._basis_buf) > n * 2:
            self._basis_buf.pop(0)
            self._sofr_buf.pop(0)
            self._ted_buf.pop(0)

        if len(self._basis_buf) >= n:
            B = np.array(self._basis_buf[-n:])
            X = np.column_stack([
                np.ones(n),
                np.array(self._sofr_buf[-n:]),
                np.array(self._ted_buf[-n:]),
            ])
            try:
                beta, *_ = np.linalg.lstsq(X, B, rcond=None)
                self._alpha1, self._alpha2 = beta[1], beta[2]
            except np.linalg.LinAlgError:
                pass

        return raw_basis - self._alpha1 * sofr_ois - self._alpha2 * ted

    def compute(self, spot: float, futures: float, rf: float, q: float,
                tte: float, sofr_ois: float, ted: float) -> float:
        raw_b  = self.log_basis(spot, futures, rf, q, tte)
        b_adj  = self._ols_strip(raw_b, sofr_ois, ted)
        level, sigma = self.kf.step(b_adj)
        return (b_adj - level) / sigma


# ─────────────────────────────────────────────────────────────────────────────
# SIGNAL 3 — COT POSITIONING EXTREMITY (CPE)
# ─────────────────────────────────────────────────────────────────────────────

class CPEEngine:
    """
    CPE_t = (Spec_net_{t−5d} − μ̂₅₂w) / σ̂₅₂w

    At ±2σ extremes managed money is overexposed and will be forced to
    rebalance by internal risk managers — structural flow prediction,
    NOT a sentiment signal (Harvey & Mazzoleni 2025).

    size_mult = 1.0 + 0.3 × max(0, |CPE_t| − 2.0)
    """

    def __init__(self, cfg: StrategyConfig) -> None:
        self.cfg = cfg
        self._net_buf: List[float] = []

    def compute(self, mm_long: float, mm_short: float) -> Tuple[float, float]:
        """Returns (cpe_z, size_amplifier)."""
        net = mm_long - mm_short
        self._net_buf.append(net)

        lag  = self.cfg.cpe_pub_lag
        need = self.cfg.cpe_lookback + lag + 1
        if len(self._net_buf) < need:
            return 0.0, 1.0

        lagged = self._net_buf[-(lag + 1)]
        window = np.array(self._net_buf[-(self.cfg.cpe_lookback + lag) : -lag])
        mu, std = window.mean(), window.std(ddof=1)
        if std < 1e-8:
            return 0.0, 1.0

        cpe_z = (lagged - mu) / std
        excess = max(0.0, abs(cpe_z) - self.cfg.cpe_threshold)
        amplifier = 1.0 + self.cfg.cpe_size_amplifier * excess
        return cpe_z, amplifier


# ─────────────────────────────────────────────────────────────────────────────
# REGIME DETECTION — STATISTICAL JUMP MODEL (Shu, Yu & Mulvey 2024)
# ─────────────────────────────────────────────────────────────────────────────

class RegimeDetector:
    """
    Minimise:  Σ_t ‖X_t − μ_{s_t}‖² + λ × Σ_t 1[s_t ≠ s_{t−1}]

    Features:  [r₁d, σ₅d, σ/σ̄, ΔVIX_slope, BA_spread_norm]

    Solved via Viterbi-style DP.  Cluster centres updated via EM.
    λ ≈ 5–20 (expanding-window CV on IS data only).
    Minimum 5-day dwell before any regime switch is accepted.
    """

    _FEATURE_DIM = 5

    def __init__(self, cfg: StrategyConfig) -> None:
        self.cfg = cfg
        self.centers: Optional[np.ndarray] = None
        self._label_map: Dict[int, Regime] = {}
        self.regime: Regime = Regime.NEUTRAL
        self._dwell: int = 0
        self._candidate: Optional[Regime] = None
        self._cand_dwell: int = 0
        self._history: List[Regime] = []

    # -- batch fit on IS data only ----------------------------------------
    def fit(self, feature_matrix: np.ndarray) -> None:
        """
        Initialise centres then run jump-penalised DP assignment.
        Called ONCE on IS data.  Never called on OOS or holdout.
        """
        if feature_matrix.ndim != 2 or feature_matrix.shape[0] < 20:
            return
        self._init_centers(feature_matrix)
        self._jump_dp(feature_matrix)   # EM loop inside

    def _init_centers(self, F: np.ndarray) -> None:
        """Percentile-bootstrap: sort by return, split into thirds."""
        idx = np.argsort(F[:, 0])
        n = len(idx)
        q1, q2 = n // 5, 4 * n // 5
        self.centers = np.stack([
            F[idx[-q1:]].mean(axis=0),       # Bull  → top returns
            F[idx[q1:q2]].mean(axis=0),      # Neutral
            F[idx[:q1]].mean(axis=0),        # Crisis → bottom returns
        ])
        self._label_map = {0: Regime.BULL, 1: Regime.NEUTRAL, 2: Regime.CRISIS}

    def _jump_dp(self, F: np.ndarray, n_iter: int = 10) -> np.ndarray:
        """Viterbi DP + EM to jointly optimise labels and centres."""
        n, k = len(F), self.cfg.n_regimes
        lam = self.cfg.jump_penalty
        labels = np.zeros(n, dtype=int)

        for _ in range(n_iter):
            # E-step: DP assignment
            D = np.array([[np.dot(F[t] - self.centers[j],
                                  F[t] - self.centers[j])
                           for j in range(k)]
                          for t in range(n)])

            V = np.full((n, k), np.inf)
            path = np.zeros((n, k), dtype=int)
            V[0] = D[0]

            for t in range(1, n):
                for j in range(k):
                    costs = V[t-1] + lam * (np.arange(k) != j)
                    bp = int(np.argmin(costs))
                    V[t, j] = costs[bp] + D[t, j]
                    path[t, j] = bp

            labels[-1] = int(np.argmin(V[-1]))
            for t in range(n - 2, -1, -1):
                labels[t] = path[t + 1, labels[t + 1]]

            # M-step: update centres
            for j in range(k):
                m = F[labels == j]
                if len(m) > 0:
                    self.centers[j] = m.mean(axis=0)

        # Sort centres so index-0 has highest mean return (Bull)
        order = np.argsort(-self.centers[:, 0])
        self.centers = self.centers[order]
        inv_order = np.argsort(order)
        self._label_map = {
            int(inv_order[0]): Regime.BULL,
            int(inv_order[1]): Regime.NEUTRAL,
            int(inv_order[2]): Regime.CRISIS,
        }
        return labels

    # -- online update with dwell constraint ------------------------------
    def update(self, feature: Optional[np.ndarray]) -> Regime:
        if feature is None or self.centers is None:
            return self.regime

        dists = np.sum((self.centers - feature) ** 2, axis=1)
        raw = self._label_map.get(int(np.argmin(dists)), Regime.NEUTRAL)

        if raw == self.regime:
            self._dwell += 1
            self._candidate, self._cand_dwell = None, 0
        else:
            if self._candidate == raw:
                self._cand_dwell += 1
            else:
                self._candidate, self._cand_dwell = raw, 1

            if self._cand_dwell >= self.cfg.regime_min_dwell:
                self.regime = raw
                self._dwell = self._cand_dwell
                self._candidate, self._cand_dwell = None, 0

        self._history.append(self.regime)
        return self.regime

    # -- feature constructor ----------------------------------------------
    @staticmethod
    def features(
        ret_series:  np.ndarray,
        vix:         float,
        vix_series:  np.ndarray,
        ba_spread:   float,
        avg_ba:      float,
    ) -> Optional[np.ndarray]:
        if len(ret_series) < 22 or len(vix_series) < 5:
            return None
        r1d      = ret_series[-1]
        vol5     = ret_series[-5:].std() * np.sqrt(252)
        vol20    = ret_series[-20:].std() * np.sqrt(252)
        vol_ratio = vol5 / (vol20 + 1e-8)
        vix_slope = float(np.polyfit(np.arange(len(vix_series[-10:])),
                                     vix_series[-10:], 1)[0])
        ba_norm  = ba_spread / (avg_ba + 1e-8)
        return np.array([r1d, vol5, vol_ratio, vix_slope, ba_norm])


# ─────────────────────────────────────────────────────────────────────────────
# ΔFLOW COMPOSITE
# ─────────────────────────────────────────────────────────────────────────────

class DeltaFlowComposite:
    """
    ΔFLOW_t = w₁·IFR_z − w₂·FSBD − w₃·CPE_z

    Sign convention:
      +IFR  → directional (informed flow predicts continuation)
      −FSBD → mean-reversion (high basis → short)
      −CPE  → contrarian fade (crowded longs → expect reversal)

    Final 20-day rolling z-score: entry when |ΔFLOW_z| > 1.2.
    """

    def __init__(self, cfg: StrategyConfig) -> None:
        self.cfg = cfg
        self._buf: List[float] = []

    def compute(self, ifr_z: float, fsbd: float,
                cpe_z: float, regime: Regime) -> Tuple[float, float]:
        """Returns (raw_composite, z_scored_composite)."""
        w = self.cfg.regime_weights[regime]
        raw = w["w_ifr"] * ifr_z - w["w_fsbd"] * fsbd - w["w_cpe"] * cpe_z
        self._buf.append(raw)

        wn = self.cfg.norm_window
        if len(self._buf) < wn + 1:
            return raw, 0.0

        arr = np.array(self._buf[-wn:])
        std = arr.std(ddof=1)
        if std < 1e-8:
            return raw, 0.0
        return raw, (raw - arr.mean()) / std


# ─────────────────────────────────────────────────────────────────────────────
# POSITION SIZER — HALF-KELLY + VOL TARGETING
# ─────────────────────────────────────────────────────────────────────────────

class PositionSizer:
    """
    f = 0.5 × f_Kelly × (σ_target / σ̂_t)     clipped to [0, 0.15]

    f_Kelly = μ̂ / σ̂_t²

    μ̂ is read from an IS-calibrated expected-return table indexed
    by |ΔFLOW_z| band.  In production: replace with a proper
    signal-conditional return regression.
    """

    # IS-calibrated expected-return table  (annualised gross)
    _RET_TABLE = [(1.2, 1.5, 0.08), (1.5, 2.0, 0.14),
                  (2.0, 2.5, 0.20), (2.5, 3.0, 0.26), (3.0, 9e9, 0.32)]

    def __init__(self, cfg: StrategyConfig) -> None:
        self.cfg = cfg

    def _mu_hat(self, z: float) -> float:
        za = abs(z)
        for lo, hi, ret in self._RET_TABLE:
            if lo <= za < hi:
                return ret
        return 0.0

    def size(self, delta_flow_z: float,
             realised_vol: float, cpe_amp: float = 1.0) -> float:
        if abs(delta_flow_z) < self.cfg.entry_threshold:
            return 0.0
        rv = max(realised_vol, 0.01)
        mu = self._mu_hat(delta_flow_z)
        f_kelly = mu / (rv ** 2)
        f = self.cfg.kelly_fraction * f_kelly * (self.cfg.vol_target / rv)
        f *= min(cpe_amp, 1.5)       # cap CPE amplification at +50%
        return float(np.clip(f, 0.0, self.cfg.max_position))


# ─────────────────────────────────────────────────────────────────────────────
# RISK ENGINE
# ─────────────────────────────────────────────────────────────────────────────

class RiskEngine:
    """
    Tier-1  Signal Reversal Stop  — ΔFLOW flips sign AND |z| > 0.8
    Tier-2  Price Adverse Stop    — −1.5σ → reduce 50%, −2.5σ → full exit
    Tier-3  Correlation Stop      — ρ drop > 0.35 over 5 days
    Tier-4  Time Stop             — Day 4 (configurable)

    Circuit Breakers:
        Monthly  DD > 8%  → reduce to 40%
        Daily  loss > 3%  → halt new entries 24h
        VIX        > 40   → switch to Crisis mode
        Annual   DD > 18% → full strategy pause
    """

    def __init__(self, cfg: StrategyConfig) -> None:
        self.cfg = cfg
        self.rs = RiskState()

    # ── Tier-1 ────────────────────────────────────────────────────────────
    def signal_reversal(self, pos: Position,
                        df: float, df_z: float) -> bool:
        flip = (np.sign(df) != pos.direction) and (df != 0)
        return flip and (abs(df_z) > self.cfg.signal_reversal_min_z)

    # ── Tier-2 ────────────────────────────────────────────────────────────
    def price_stop(self, pos: Position, price: float) -> str:
        pnl_pct = pos.unrealised_pnl_pct(price)
        daily_vol = pos.entry_vol / np.sqrt(252)
        sigma_moves = pnl_pct / (daily_vol + 1e-8)
        if sigma_moves < -self.cfg.price_stop_2:
            return "full_exit"
        if sigma_moves < -self.cfg.price_stop_1:
            return "reduce_50"
        return "hold"

    # ── Tier-3 ────────────────────────────────────────────────────────────
    def corr_stop(self, ret_a: np.ndarray, ret_b: np.ndarray) -> bool:
        w = self.cfg.corr_break_window
        if len(ret_a) < w + 10:
            return False
        recent   = np.corrcoef(ret_a[-w:], ret_b[-w:])[0, 1]
        baseline = np.corrcoef(ret_a[-(w + 20):-w],
                               ret_b[-(w + 20):-w])[0, 1]
        return (baseline - recent) > self.cfg.corr_break_threshold

    # ── Tier-4 ────────────────────────────────────────────────────────────
    def time_stop(self, pos: Position) -> bool:
        return pos.days_held >= self.cfg.time_stop_days

    # ── Circuit breakers ──────────────────────────────────────────────────
    def circuit_breakers(self, nav: float,
                         daily_ret: float, vix: float) -> Dict[str, bool]:
        m_dd = (nav - self.rs.monthly_start_nav) / (self.rs.monthly_start_nav + 1e-8)
        a_dd = (nav - self.rs.annual_start_nav)  / (self.rs.annual_start_nav  + 1e-8)
        return {
            "monthly_dd": m_dd < -self.cfg.monthly_dd_limit,
            "daily_loss": daily_ret < -self.cfg.daily_loss_limit,
            "vix_crisis": vix > self.cfg.vix_crisis_level,
            "annual_dd":  a_dd < -self.cfg.annual_dd_limit,
        }

    # ── Master evaluator ──────────────────────────────────────────────────
    def evaluate(self, pos: Position, price: float,
                 df: float, df_z: float,
                 nav: float, daily_ret: float, vix: float) -> str:
        if self.signal_reversal(pos, df, df_z):
            return "full_exit"
        action = self.price_stop(pos, price)
        if action != "hold":
            return action
        if self.time_stop(pos):
            return "full_exit"
        cb = self.circuit_breakers(nav, daily_ret, vix)
        if cb["annual_dd"] or cb["monthly_dd"]:
            return "full_exit"
        if cb["daily_loss"]:
            return "reduce_50"
        return "hold"


# ─────────────────────────────────────────────────────────────────────────────
# SYNTHETIC MARKET DATA GENERATOR
# ─────────────────────────────────────────────────────────────────────────────

class SyntheticMarket:
    """
    Produces a self-consistent panel of:
      prices · open-interest · OFI · funding spreads ·
      VIX · bid-ask · COT managed-money · basis

    Regime dynamics use a 3-state Markov chain to generate realistic
    clustering of volatility regimes (GFC, COVID-style crises, bull runs).

    ──────────────────────────────────────────────────────────────
    PRODUCTION NOTE:  Replace entirely with live feeds:
      ● OFI      → CME MDP 3.0 multicast (5-level LOB, 100 ms)
      ● OI       → CME Globex (5-min aggregated)
      ● COT      → CFTC.gov disaggregated, Fri 3:30 pm ET
      ● SOFR-OIS → Bloomberg BSOFRS3M / DTCC
      ● TED      → Federal Reserve H.15
      ● VIX      → CBOE daily settlement
    ──────────────────────────────────────────────────────────────
    """

    # Regime transition matrix (daily)
    _P = np.array([[0.97, 0.03, 0.00],   # Bull
                   [0.02, 0.95, 0.03],   # Neutral
                   [0.00, 0.08, 0.92]])  # Crisis

    _REGIME_PARAMS = {
        0: dict(mu=0.0009,  sig=0.010, name="Bull"),     # ~23% ann, 16% vol
        1: dict(mu=0.0001,  sig=0.013, name="Neutral"),   # ~2.5%,   20% vol
        2: dict(mu=-0.0012, sig=0.026, name="Crisis"),    # −30%,    41% vol
    }

    def __init__(self, seed: int = 42) -> None:
        np.random.seed(seed)

    def generate(self, n_days: int = 2500) -> pd.DataFrame:
        dates = pd.bdate_range("2010-01-02", periods=n_days)

        # ── Regime sequence via Markov chain ──────────────────────────────
        reg = [1]
        for _ in range(n_days - 1):
            reg.append(int(np.random.choice(3, p=self._P[reg[-1]])))
        reg = np.array(reg)

        # ── Returns ───────────────────────────────────────────────────────
        ret = np.array([
            np.random.normal(self._REGIME_PARAMS[r]["mu"],
                             self._REGIME_PARAMS[r]["sig"])
            for r in reg
        ])

        # ── Prices ────────────────────────────────────────────────────────
        spot = 4000.0 * np.exp(np.cumsum(ret))

        # ── Open interest  (grows in trending regimes) ────────────────────
        oi_delta = np.where(
            ret > 0.004,  np.random.uniform(3_000, 25_000, n_days),
            np.where(ret < -0.004, np.random.uniform(-15_000, 5_000, n_days),
                     np.random.normal(0, 6_000, n_days))
        )
        oi = np.clip(1_800_000 + np.cumsum(oi_delta), 400_000, 6_000_000)

        # ── OFI: partially predictive of forward returns ──────────────────
        # Use a 5-day smoothed return as the "informed" component
        smooth5 = pd.Series(ret).ewm(span=5).mean().values
        ofi = smooth5 * 1.2e6 + 0.3 * ret * 1e6 + np.random.normal(0, 6_000, n_days)

        # ── Funding spreads ───────────────────────────────────────────────
        sofr_ois = np.abs(0.002 + np.cumsum(np.random.normal(0, 0.0002, n_days)))
        ted       = np.abs(0.005 + np.cumsum(np.random.normal(0, 0.0003, n_days)))

        # Quarter-end funding stress spikes
        for i in range(62, n_days, 63):
            sofr_ois[i:i+3] *= np.random.uniform(1.5, 5.0)
            ted[i:i+3]      *= np.random.uniform(1.5, 3.5)

        # ── VIX ───────────────────────────────────────────────────────────
        vix_base = 14 + 9 * (reg == 2).astype(float) + 4 * (reg == 1).astype(float)
        vix = np.clip(vix_base + np.random.normal(0, 2.5, n_days), 8, 90)

        # ── Bid-ask spread ────────────────────────────────────────────────
        ba = 0.20 + 0.55 * (reg == 2) + np.random.exponential(0.10, n_days)

        # ── COT managed-money net ─────────────────────────────────────────
        mm_net = np.zeros(n_days)
        trend20 = pd.Series(ret).rolling(20).sum().fillna(0).values
        for t in range(1, n_days):
            mm_net[t] = 0.92 * mm_net[t-1] + 0.08 * trend20[t] * 4e6 \
                        + np.random.normal(0, 4_000)

        # ── Futures basis (information + funding contamination) ───────────
        info_basis = np.random.normal(0, 0.0018, n_days)
        funding_noise = 0.45 * sofr_ois + 0.28 * ted \
                        + np.random.normal(0, 0.0008, n_days)
        raw_basis = info_basis + funding_noise

        # ── Rates and carry ───────────────────────────────────────────────
        rf = np.clip(0.05 + np.cumsum(np.random.normal(0, 0.0001, n_days)), 0.01, 0.12)
        div_yield = np.full(n_days, 0.015)
        tte = (np.linspace(0.25, 0.005, n_days) % 0.245) + 0.005  # quarterly rolls

        futures = spot * np.exp(raw_basis) * np.exp((rf - div_yield) * tte)

        df = pd.DataFrame({
            "spot":         spot,
            "futures":      futures,
            "ret":          ret,
            "oi":           oi,
            "ofi":          ofi,
            "sofr_ois":     sofr_ois,
            "ted":          ted,
            "vix":          vix,
            "ba":           ba,
            "mm_long":      np.maximum(mm_net, 0),
            "mm_short":     np.maximum(-mm_net, 0),
            "rf":           rf,
            "div_yield":    div_yield,
            "tte":          tte,
            "true_regime":  reg,
        }, index=dates)

        return df


# ─────────────────────────────────────────────────────────────────────────────
# PERFORMANCE ANALYTICS
# ─────────────────────────────────────────────────────────────────────────────

class Analytics:
    """
    Institutional analytics: Sharpe, Sortino, Calmar, max DD,
    hit rate, profit factor, tail ratio, DSR.
    """

    @staticmethod
    def max_drawdown(nav: pd.Series) -> float:
        peak = nav.expanding().max()
        return float((nav / peak - 1).min())

    @staticmethod
    def sharpe(ret: pd.Series, rf_annual: float = 0.05) -> float:
        er = ret - (1 + rf_annual) ** (1 / 252) + 1
        return float(er.mean() / (ret.std(ddof=1) + 1e-8) * np.sqrt(252))

    @staticmethod
    def sortino(ret: pd.Series, rf_annual: float = 0.05) -> float:
        daily_rf = (1 + rf_annual) ** (1 / 252) - 1
        down = ret[ret < daily_rf]
        dv = down.std(ddof=1) * np.sqrt(252) if len(down) > 1 else ret.std() * np.sqrt(252)
        ann = (1 + ret).prod() ** (252 / len(ret)) - 1
        return (ann - rf_annual) / (dv + 1e-8)

    @staticmethod
    def deflated_sharpe(sr: float, n: int, n_trials: int = 15,
                        skew: float = -0.5, kurt: float = 3.0) -> float:
        """
        Deflated Sharpe Ratio — Harvey, Liu & Zhu (2016).
        Adjusts for implicit strategy trials during development.
        Acceptance threshold: DSR > 0.70.
        """
        from scipy.stats import norm
        se = np.sqrt((1 - skew * sr + (kurt - 1) / 4 * sr ** 2) / max(n - 1, 1))
        gc = 0.5772156649
        E_max = (1 - gc) * norm.ppf(1 - 1 / n_trials) \
              + gc       * norm.ppf(1 - 1 / (n_trials * np.e))
        return float(np.clip(norm.cdf((sr - E_max) / (se + 1e-8)), 0, 1))

    @classmethod
    def report(cls, ret: pd.Series, label: str,
               regime_series: Optional[pd.Series] = None) -> Dict:
        nav  = (1 + ret).cumprod()
        ann  = float((1 + ret).prod() ** (252 / max(len(ret), 1)) - 1)
        vol  = float(ret.std(ddof=1) * np.sqrt(252))
        sr   = cls.sharpe(ret)
        dsr  = cls.deflated_sharpe(sr, len(ret))
        mdd  = cls.max_drawdown(nav)
        cal  = ann / (-mdd + 1e-8) if mdd < 0 else np.inf
        sort = cls.sortino(ret)

        wins  = ret[ret > 0]
        loss  = ret[ret < 0]
        hit   = len(wins) / (len(wins) + len(loss) + 1e-8)
        pf    = wins.sum() / (-loss.sum() + 1e-8)
        wl    = wins.mean() / (-loss.mean() + 1e-8) if len(loss) > 0 else np.inf
        tail  = abs(float(np.percentile(ret, 95))) / (abs(float(np.percentile(ret, 5))) + 1e-8)

        metrics = dict(
            ann_ret=ann, vol=vol, sharpe=sr, dsr=dsr,
            sortino=sort, calmar=cal, max_dd=mdd,
            hit_rate=hit, profit_factor=pf, win_loss=wl,
            tail_ratio=tail, skew=float(ret.skew()), kurt=float(ret.kurtosis()),
        )

        bar = "═" * 62
        print(f"\n  ╔{bar}╗")
        print(f"  ║  {label:<60}║")
        print(f"  ║  {ret.index[0].date()} → {ret.index[-1].date()}  ({len(ret):,d} days){' ' * (35 - len(str(len(ret))))  }║")
        print(f"  ╠{bar}╣")
        rows = [
            ("Annual Return",    f"{ann:+.2%}"),
            ("Annual Volatility",f"{vol:.2%}"),
            ("Sharpe Ratio",     f"{sr:.3f}"),
            ("Deflated Sharpe",  f"{dsr:.3f}  (accept if > 0.70)"),
            ("Sortino Ratio",    f"{sort:.3f}"),
            ("Calmar Ratio",     f"{cal:.3f}"),
            ("Max Drawdown",     f"{mdd:.2%}"),
            ("Hit Rate",         f"{hit:.2%}"),
            ("Profit Factor",    f"{pf:.3f}"),
            ("Win/Loss Ratio",   f"{wl:.3f}"),
            ("Tail Ratio",       f"{tail:.3f}"),
            ("Skewness",         f"{ret.skew():.3f}"),
            ("Excess Kurtosis",  f"{ret.kurtosis():.3f}"),
        ]
        for k, v in rows:
            print(f"  ║  {k:<26}{v:<34}║")

        if regime_series is not None:
            print(f"  ╠{bar}╣")
            print(f"  ║  {'Regime-Conditional':<60}║")
            for rname in ["Bull", "Neutral", "Crisis"]:
                mask = regime_series == rname
                if mask.sum() < 5:
                    continue
                rr = ret[mask]
                rsr  = float(rr.mean() / (rr.std(ddof=1) + 1e-8) * np.sqrt(252))
                rann = float((1 + rr).prod() ** (252 / len(rr)) - 1)
                rhit = float((rr > 0).mean())
                print(f"  ║    [{rname:<7}]  Ann={rann:+.2%}  Sharpe={rsr:.2f}"
                      f"  Hit={rhit:.1%}  N={mask.sum():>4}{' ' * 4}║")

        print(f"  ╚{bar}╝\n")
        return metrics


# ─────────────────────────────────────────────────────────────────────────────
# BACKTESTING ENGINE
# ─────────────────────────────────────────────────────────────────────────────

class DeltaFlowBacktester:
    """
    Strict-PIT event-driven backtester.

    Backtest hygiene checklist (per the 8-step protocol):
      ✓ Parameters from economics, NOT IS optimisation
      ✓ PIT: no future data used in any signal computation
      ✓ COT: mandatory 5-day publication lag enforced
      ✓ Kalman: forward-recursive only (no smoother)
      ✓ Regime model: fit on IS only, then frozen
      ✓ Full cost waterfall before performance claim
      ✓ DSR acceptance threshold > 0.70
    """

    def __init__(self, cfg: Optional[StrategyConfig] = None) -> None:
        self.cfg = cfg or StrategyConfig()
        self._init_engines()
        self.trade_log: List[Dict] = []

    def _init_engines(self) -> None:
        self.ifr     = IFREngine(self.cfg)
        self.fsbd    = FSBDEngine(self.cfg)
        self.cpe     = CPEEngine(self.cfg)
        self.regime  = RegimeDetector(self.cfg)
        self.comp    = DeltaFlowComposite(self.cfg)
        self.sizer   = PositionSizer(self.cfg)
        self.risk    = RiskEngine(self.cfg)

    # ── Pre-fit regime model on IS features ──────────────────────────────
    def fit_regime_model(self, is_data: pd.DataFrame) -> None:
        print("  Fitting regime model on IS data… ", end="", flush=True)
        features = []
        for i in range(25, len(is_data)):
            r   = is_data["ret"].iloc[max(0, i-22):i].values
            vix = float(is_data["vix"].iloc[i])
            vhist = is_data["vix"].iloc[max(0, i-12):i].values
            ba  = float(is_data["ba"].iloc[i])
            avg = float(is_data["ba"].iloc[max(0, i-20):i].mean())
            f   = RegimeDetector.features(r, vix, vhist, ba, avg)
            if f is not None:
                features.append(f)
        if features:
            self.regime.fit(np.array(features))
        print(f"done ({len(features)} feature vectors).")

    # ── TC waterfall ─────────────────────────────────────────────────────
    def _tc(self, size: float) -> float:
        return (self.cfg.commission_rt + self.cfg.slippage
                + self.cfg.kyle_lambda * size) * size

    # ── Main loop ─────────────────────────────────────────────────────────
    def run(self, data: pd.DataFrame,
            contract: str = "ES",
            verbose: bool = True) -> pd.DataFrame:

        warmup = max(self.cfg.fsbd_ols_window,
                     self.cfg.cpe_lookback + self.cfg.cpe_pub_lag + 5,
                     self.cfg.norm_window * 2) + 30

        nav = 1.0
        position: Optional[Position] = None
        records: List[Dict] = []

        print(f"  Running backtest: {contract}  |  {len(data)} days  "
              f"|  warmup={warmup}\n")

        for i, (date, row) in enumerate(data.iterrows()):
            price   = float(row["spot"])
            futures = float(row["futures"])
            vix     = float(row["vix"])
            ret_d   = float(row["ret"])

            # ── warmup ────────────────────────────────────────────────────
            if i < warmup:
                # still feed FSBD / CPE to warm up their states
                self.fsbd.compute(price, futures, float(row["rf"]),
                                  float(row["div_yield"]),
                                  float(row["tte"]),
                                  float(row["sofr_ois"]),
                                  float(row["ted"]))
                self.cpe.compute(float(row["mm_long"]),
                                 float(row["mm_short"]))
                records.append(dict(date=date, nav=nav, ret=0.0,
                                    pos=0, df_z=0.0, regime="Neutral",
                                    ifr_z=0.0, fsbd=0.0, cpe_z=0.0,
                                    cb=False))
                continue

            ret_win  = data["ret"].iloc[max(0, i-62):i].values
            vix_hist = data["vix"].iloc[max(0, i-12):i].values
            ba_avg   = float(data["ba"].iloc[max(0, i-20):i].mean())

            # ── Regime ────────────────────────────────────────────────────
            feat   = RegimeDetector.features(ret_win, vix, vix_hist,
                                             float(row["ba"]), ba_avg)
            regime = self.regime.update(feat)

            # ── Signals (strict PIT) ──────────────────────────────────────
            # IFR
            ofi    = float(row["ofi"])
            oi     = float(row["oi"])
            oi_lag = float(data["oi"].iloc[i - 1])
            delta_oi = oi - oi_lag
            ifr_raw  = ofi * np.sign(delta_oi) * np.sqrt(max(abs(delta_oi), 1.0))
            ifr_z    = self.ifr.zscore(ifr_raw)

            # FSBD
            fsbd_v = self.fsbd.compute(
                price, futures, float(row["rf"]),
                float(row["div_yield"]), float(row["tte"]),
                float(row["sofr_ois"]), float(row["ted"]))

            # CPE (5-day lag built in)
            cpe_z, cpe_amp = self.cpe.compute(
                float(row["mm_long"]), float(row["mm_short"]))

            # ΔFLOW composite + z-score
            df_raw, df_z = self.comp.compute(ifr_z, fsbd_v, cpe_z, regime)

            # Realised vol for sizing
            rv = max(float(np.std(ret_win[-10:]) * np.sqrt(252))
                     if len(ret_win) >= 10 else 0.15, 0.04)

            # ── Circuit breakers ──────────────────────────────────────────
            cb = self.risk.circuit_breakers(nav, ret_d, vix)
            halt = any(cb.values())

            # ── Manage existing position ──────────────────────────────────
            pos_ret = 0.0
            if position is not None:
                position.days_held += 1
                action = self.risk.evaluate(
                    position, price, df_raw, df_z, nav, ret_d, vix)

                if action in ("full_exit", "reduce_50"):
                    tc = self._tc(position.size)
                    nav *= (1 - tc)
                    self.trade_log.append(dict(
                        date=date, action=action, price=price,
                        nav_after=nav, days_held=position.days_held,
                        pnl_pct=position.unrealised_pnl_pct(price)))
                    if action == "full_exit":
                        position = None
                    else:
                        position.size *= 0.5

            if position is not None:
                pos_ret = position.direction * ret_d * position.size

            # ── New entry ─────────────────────────────────────────────────
            if (position is None
                    and abs(df_z) > self.cfg.entry_threshold
                    and not halt):
                sz  = self.sizer.size(df_z, rv, cpe_amp)
                dir = int(np.sign(df_raw))
                if sz > 5e-4 and dir != 0:
                    nav *= (1 - self._tc(sz))
                    position = Position(
                        contract=contract, direction=dir,
                        entry_price=price, entry_date=date,
                        size=sz, entry_delta_flow_z=df_z, entry_vol=rv)
                    self.trade_log.append(dict(
                        date=date, action="entry", direction=dir,
                        size=sz, price=price, df_z=df_z,
                        regime=regime.value, ifr_z=ifr_z,
                        fsbd=fsbd_v, cpe_z=cpe_z))

            # ── NAV update ────────────────────────────────────────────────
            nav *= (1 + pos_ret)

            # ── Monthly / annual NAV tracking ─────────────────────────────
            if i > 0:
                prev = data.index[i - 1]
                if prev.month != date.month:
                    self.risk.rs.monthly_start_nav = nav
                if prev.year != date.year:
                    self.risk.rs.annual_start_nav = nav

            records.append(dict(
                date=date, nav=nav, ret=pos_ret,
                pos=position.direction * position.size if position else 0.0,
                df_z=df_z, regime=regime.value,
                ifr_z=ifr_z, fsbd=fsbd_v, cpe_z=cpe_z, cb=halt))

            if verbose and i % 400 == 0 and i > warmup:
                status = f"[{date.date()}] NAV={nav:.4f}  {regime.value:<7}  " \
                         f"ΔFLOW_z={df_z:+.2f}  pos={position.direction * position.size if position else 0.0:+.3f}" \
                         f"  trades={len(self.trade_log)}"
                print(f"  {status}")

        return pd.DataFrame(records).set_index("date")

    # ── Signal diagnostics ────────────────────────────────────────────────
    def signal_diagnostics(self, results: pd.DataFrame, horizon: int = 5) -> None:
        fwd = results["ret"].shift(-1)
        fwd5 = results["ret"].rolling(horizon).sum().shift(-horizon)

        print(f"\n  ── Signal Predictive Correlations ─────────────────────")
        print(f"  {'Signal':<14} {'1-day IC':>10} {'5-day IC':>10}  Interpretation")
        print(f"  {'-'*62}")
        for sig, col, interp in [
            ("IFR_z",   "ifr_z", "pos = informed buying predicts gain"),
            ("FSBD",    "fsbd",  "neg = high basis → short (mean-revert)"),
            ("CPE_z",   "cpe_z", "neg = crowded → reversal"),
            ("ΔFLOW_z", "df_z",  "pos = composite signal works"),
        ]:
            if col not in results.columns:
                continue
            ic1 = float(results[col].corr(fwd))
            ic5 = float(results[col].corr(fwd5))
            flag = "✓" if abs(ic1) > 0.01 else "·"
            print(f"  {sig:<14} {ic1:>+10.4f} {ic5:>+10.4f}  {flag} {interp}")

    # ── Trade summary ─────────────────────────────────────────────────────
    def trade_summary(self) -> None:
        entries = [t for t in self.trade_log if t["action"] == "entry"]
        exits   = [t for t in self.trade_log if "exit" in t.get("action", "")]
        if not entries:
            print("  No trades executed.")
            return

        dirs   = [e.get("direction", 0) for e in entries]
        sizes  = [e.get("size", 0)      for e in entries]
        zs     = [abs(e.get("df_z", 0)) for e in entries]
        reg    = [e.get("regime", "?")  for e in entries]
        reg_ct = {r: reg.count(r) for r in set(reg)}

        print(f"\n  ── Trade Summary ───────────────────────────────────────")
        print(f"  Total entries   : {len(entries)}")
        print(f"  Long / Short    : {dirs.count(1)} / {dirs.count(-1)}")
        print(f"  Avg position sz : {np.mean(sizes):.3f}  "
              f"(max={max(sizes):.3f})")
        print(f"  Avg |ΔFLOW_z|   : {np.mean(zs):.3f}")
        print(f"  Full exits      : {sum(1 for e in exits if 'full' in e['action'])}")
        print(f"  Reduce 50% exits: {sum(1 for e in exits if 'reduce' in e['action'])}")
        print(f"\n  Entries by Regime:")
        for r, ct in sorted(reg_ct.items()):
            print(f"    {r:<10} {ct:>4}  ({ct/len(entries)*100:.1f}%)")


# ─────────────────────────────────────────────────────────────────────────────
# MAIN
# ─────────────────────────────────────────────────────────────────────────────

