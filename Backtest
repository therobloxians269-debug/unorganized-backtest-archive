"""SIGMABLOCK — the two branches, measured causally.

Every session gets both blocks (session high + session low, confirmed at `--confirm`
minutes). 97.9% of sessions touch at least one. At the touch NOTHING is known about
whether it will hold or break, so both branches are specified in advance and the
market decides:

  REVERSION   enter at the block edge on the touch, stop beyond the TICK.
              This is the ping-pong branch.
  TREND       only after the reversion stop is hit -- i.e. the block actually broke,
              which is known at that moment and not before -- re-enter on the pullback
              to the broken tick and ride the break.

⚠️ The first version of this file classified hold-vs-break using the REST OF THE DAY
and then traded the "hold" set with a stop the selection guaranteed could never be
hit. It printed 100.0% WR at every R:R. That is the tell for outcome selection, not an
edge. Nothing here is allowed to know the future.

Races start on the bar AFTER entry. If a bar spans both target and stop, it counts as
a LOSS. Placebo = the same geometry on a block displaced by `--placebo` points.

    python3 breakout.py
    python3 breakout.py --confirm 60 --placebo 40
"""
from __future__ import annotations

import argparse

import numpy as np
import pandas as pd

import sigmablock as S

BUF = S.TICK * 2


def race(fwd: pd.DataFrame, entry: float, risk: float, long: bool, rr: float):
    """First touch from the bar after entry. +1 target, -1 stop, 0 unresolved.
    Also returns the max favourable excursion in POINTS."""
    tgt = entry + rr * risk if long else entry - rr * risk
    stp = entry - risk if long else entry + risk
    mfe = 0.0
    for h, l in zip(fwd["high"].to_numpy(), fwd["low"].to_numpy()):
        mfe = max(mfe, (h - entry) if long else (entry - l))
        ht = (h >= tgt) if long else (l <= tgt)
        hs = (l <= stp) if long else (h >= stp)
        if hs:
            return -1, mfe
        if ht:
            return 1, mfe
    return 0, mfe


def session(d: pd.DataFrame, confirm_min: int, rr_list, shift: float):
    open_t = d.index[0].replace(hour=9, minute=30, second=0, microsecond=0)
    mins = (d.index - open_t).total_seconds() / 60.0
    arm = int(np.searchsorted(mins, confirm_min))
    if arm >= len(d) - 4:
        return []
    sub = d.iloc[:arm + 1]
    dev = float(sub["dev"].iloc[-1])
    if dev == 0:
        return []
    out = []
    for bull in (True, False):
        i = sub["low"].idxmin() if bull else sub["high"].idxmax()
        bot, top = S.bounds(sub.loc[i], bull)
        bot += shift
        top += shift
        tick = bot if bull else top
        edge = top if bull else bot
        fwd = d.iloc[arm + 1:]
        if len(fwd) < 4:
            continue
        hit = (fwd["low"] <= top) if bull else (fwd["high"] >= bot)
        r = {"bull": bull, "confirmed": (dev > 0) if bull else (dev < 0),
             "touched": bool(hit.any()), "width": max(top - bot, S.TICK * 2)}
        if not hit.any():
            out.append(r)
            continue

        # ── REVERSION: entered at the touch, no knowledge of what happens next
        after = fwd.loc[hit.idxmax():]
        rev_stop = (tick - BUF) if bull else (tick + BUF)
        rev_risk = max(abs(edge - rev_stop), S.TICK)
        run = after.iloc[1:]
        if not len(run):
            out.append(r)
            continue
        for rr in rr_list:
            v, m = race(run, edge, rev_risk, bull, rr)
            r[f"rev_{rr}"] = v
            r[f"rev_mfe"] = m
        r["rev_risk"] = rev_risk

        # ── TREND: only once the reversion stop is actually hit
        stopped = (run["low"] <= rev_stop) if bull else (run["high"] >= rev_stop)
        r["broke"] = bool(stopped.any())
        if stopped.any():
            post = run.loc[stopped.idxmax():]
            long = not bull                     # bearish block breaks UP -> long
            entry = tick
            t_stop = (top + BUF) if bull else (bot - BUF)
            t_risk = max(abs(entry - t_stop), S.TICK)
            pull = (post["high"] >= entry) if bull else (post["low"] <= entry)
            r["retest"] = bool(pull.any())
            if pull.any():
                trun = post.loc[pull.idxmax():].iloc[1:]
                if len(trun):
                    for rr in rr_list:
                        v, m = race(trun, entry, t_risk, long, rr)
                        r[f"trend_{rr}"] = v
                        r["trend_mfe"] = m
                    r["trend_risk"] = t_risk
        out.append(r)
    return out


def report(R, rr_list, tag):
    print(f"\n───── {tag} ─────")
    R["touched"] = R["touched"].astype(bool)
    grp = np.arange(len(R)) // 2
    print(f"  EITHER block touched per session  {100 * R.groupby(grp)['touched'].any().mean():5.1f}%")
    T = R[R["touched"]].copy()
    if not len(T):
        return
    T["broke"] = T["broke"].fillna(False).astype(bool)
    print(f"  block breaks (stop actually hit)  {100 * T['broke'].mean():5.1f}%")
    for name, sub in (("REVERSION (ping-pong)", T), ("TREND (break + pullback)", T[T["broke"]])):
        print(f"\n  {name}   n={len(sub)}")
        key = "rev" if name.startswith("REV") else "trend"
        if key == "trend" and "retest" in sub:
            print(f"    pulls back into the block  {100 * sub['retest'].fillna(False).astype(bool).mean():.1f}%")
        for rr in rr_list:
            c = sub.get(f"{key}_{rr}")
            if c is None:
                continue
            c = c.dropna()
            res = c[c != 0]
            if not len(res):
                continue
            wr = (res > 0).mean()
            be = 1 / (1 + rr)
            ev = wr * rr - (1 - wr)
            risk = sub[f"{key}_risk"].dropna().median()
            print(f"    {rr}R: n={len(res):<4} WR {100 * wr:5.1f}%  breakeven {100 * be:5.1f}%"
                  f"  EV {ev:+.3f}R  ({ev * risk:+6.1f} pts, median risk {risk:.1f})")
        m = sub.get(f"{key}_mfe")
        if m is not None and len(m.dropna()):
            m = m.dropna()
            print(f"    MFE pts:  p50 {m.median():5.1f}   p75 {m.quantile(.75):5.1f}"
                  f"   p90 {m.quantile(.9):5.1f}   ≥100pt {100 * (m >= 100).mean():4.1f}%"
                  f"   ≥200pt {100 * (m >= 200).mean():4.1f}%")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--bars", default="/Users/kaveh/qt_cascade/nq_v6.parquet")
    ap.add_argument("--tf", type=int, default=5)
    ap.add_argument("--confirm", type=int, default=60)
    ap.add_argument("--placebo", type=float, default=40.0)
    a = ap.parse_args()
    rr_list = [1, 2, 3, 5]

    df = pd.read_parquet(a.bars)[["o", "h", "l", "c", "v"]]
    df.columns = ["open", "high", "low", "close", "volume"]
    df.index = df.index.tz_convert("America/New_York")
    bars = S.to_tf(df, a.tf, "clv")
    days = sorted(set(bars.index.date))
    print(f"\nSIGMABLOCK — two branches   confirm={a.confirm}min  tf={a.tf}m  sessions={len(days)}")

    for shift, tag in ((0.0, "REAL BLOCK"), (a.placebo, f"PLACEBO — block displaced {a.placebo:+.0f} pts")):
        rows = []
        for day in days:
            d = S.session_frame(bars[bars.index.date == day])
            if d.empty or len(d) < S.EXT_LEN:
                continue
            rows += session(d, a.confirm, rr_list, shift)
        report(pd.DataFrame(rows), rr_list, tag)
    print()


if __name__ == "__main__":
    main()

