def resample(df, tf):
    return (df.resample(tf, label="left", closed="left")
              .agg({"open": "first", "high": "max", "low": "min",
                    "close": "last", "volume": "sum"})
              .dropna(subset=["open"]))


# ---------------- Sleeve A: bull-regime overnight drift ----------------
def sleeve_overnight(df1):
    b = resample(df1, "30min")
    hh, mm = b.index.hour.to_numpy(), b.index.minute.to_numpy()
    o, c = b["open"].to_numpy(), b["close"].to_numpy()
    daily = df1["close"].resample("1D").last().dropna()
    ma = daily.rolling(200).mean().shift(1)                     # through yesterday: causal at 16:00
    ma_by_day = ma.reindex(b.index.normalize()).to_numpy()
    close_bars = np.where((hh == 16) & (mm == 0))[0]
    open_bars  = np.where((hh == 9) & (mm == 0))[0]
    rows = []
    for e in close_bars:
        if not np.isfinite(ma_by_day[e]) or o[e] <= ma_by_day[e]:
            continue
        nxt = open_bars[open_bars > e]
        if not len(nxt):
            continue
        x = nxt[0]
        if (b.index[x] - b.index[e]).total_seconds() <= 24 * 3600:
            rows.append((b.index[x], (c[x] - o[e]) * MES - RT))  # exit 09:30, pnl on exit date
    return pd.DataFrame(rows, columns=["t", "pnl"]).assign(sleeve="overnight")


# ---------------- Sleeve B: overreaction fade ----------------
def sleeve_fade(df1):
    b = resample(df1, "15min")
    mins = b.index.hour * 60 + b.index.minute
    rth = b[(mins >= 570) & (mins < 960)]                        # 09:30 .. 15:45 bars
    day = rth.index.normalize()
    sess = rth.groupby(day).agg(o=("open", "first"), h=("high", "max"),
                                l=("low", "min"), c=("close", "last"), n=("close", "size"))
    sess = sess[sess.n >= 20]                                    # full sessions only
    pc = sess.c.shift(1)
    tr = pd.concat([sess.h - sess.l, (sess.h - pc).abs(), (sess.l - pc).abs()], axis=1).max(axis=1)
    sess["atr"] = tr.rolling(14).mean()                          # through signal day; used NEXT day
    sess["move"] = sess.c - sess.o
    sig = sess[(sess.atr > 0) & (sess.move.abs() > 1.2 * sess.atr)]

    rows = []
    days = sess.index.to_list()
    nxt = {d: days[i + 1] for i, d in enumerate(days[:-1])}
    grouped = dict(tuple(rth.groupby(day)))
    for d, srow in sig.iterrows():
        nd = nxt.get(d)
        if nd is None or nd not in grouped:
            continue
        g = grouped[nd]
        direc = -1 if srow.move > 0 else 1                       # fade yesterday's direction
        entry = g["open"].iloc[0]                                # 09:30 open
        tgt = entry + direc * 0.5 * srow.atr
        stp = entry - direc * 0.7 * srow.atr
        px = g["close"].iloc[-1]                                 # default: flat at close
        for cl in g["close"].to_numpy():
            if (direc == 1 and cl >= tgt) or (direc == -1 and cl <= tgt):
                px = cl; break
            if (direc == 1 and cl <= stp) or (direc == -1 and cl >= stp):
                px = cl; break
        rows.append((nd, direc * (px - entry) * MES - RT))
    return pd.DataFrame(rows, columns=["t", "pnl"]).assign(sleeve="fade")


# ---------------- Sleeve C: pre-FOMC drift ----------------
def sleeve_fomc(df1):
    s = df1["close"]
    tz = s.index.tz

    def price_at(ts):
        pos = s.index.searchsorted(ts, side="right") - 1
        if pos < 0 or ts - s.index[pos] > pd.Timedelta(minutes=20):
            return None
        return float(s.iloc[pos])

    rows = []
    for d in FOMC:
        D = pd.Timestamp(d, tz=tz)
        if D > s.index.max():
            continue
        pe = price_at((D - pd.Timedelta(days=1)).replace(hour=16, minute=0))
        px = price_at(D.replace(hour=13, minute=59))
        if pe is None or px is None:
            continue
        rows.append((D.normalize(), (px - pe) * MES - RTF))
    return pd.DataFrame(rows, columns=["t", "pnl"]).assign(sleeve="fomc")


# ---------------- portfolio metrics ----------------
def metrics(dailer, trades_n, label, cap=CAP):
    """dailer: daily pnl Series on the full session calendar (zeros when flat)."""
    p = dailer.to_numpy()
    eq = cap + np.cumsum(p)
    mdd = float(-(eq - np.maximum.accumulate(eq)).min())
    yrs = (dailer.index[-1] - dailer.index[0]).days / 365.25
    ann = p.sum() / yrs
    sharpe = p.mean() / p.std() * np.sqrt(252) if p.std() > 0 else 0
    return dict(label=label, n=trades_n, ann=ann, ann_pct=100 * ann / cap, maxDD=mdd,
                calmar=ann / mdd if mdd > 0 else np.inf, sharpe=sharpe,
                perwk=trades_n / (yrs * 52.18), eq=eq, yrs=yrs)


def rolling_calmar(dailer, cap=CAP, win_years=3):
    out = []
    idx = dailer.index
    starts = pd.date_range(idx[0], idx[-1] - pd.DateOffset(years=win_years), freq="MS", tz=idx.tz)
    for s0 in starts:
        w = dailer[(idx >= s0) & (idx < s0 + pd.DateOffset(years=win_years))]
        if len(w) < 700:
            continue
        p = w.to_numpy(); eq = cap + np.cumsum(p)
        mdd = float(-(eq - np.maximum.accumulate(eq)).min())
        ann = p.sum() / win_years
        out.append(dict(start=s0, calmar=ann / mdd if mdd > 0 else np.inf, ann=ann, mdd=mdd))
    return pd.DataFrame(out)


def mc_ruin(pnl_daily, cap, paths=10000, seed=0):
    rng = np.random.default_rng(seed)
    p = pnl_daily[pnl_daily != 0].to_numpy()
    return sum((cap + np.cumsum(rng.permutation(p)) <= 0).any() for _ in range(paths)) / paths


def tstat(x):
    return float(x.mean() / x.std() * np.sqrt(len(x))) if len(x) > 4 and x.std() > 0 else 0.0


