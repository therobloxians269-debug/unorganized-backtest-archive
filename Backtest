"""Can ANYTHING knowable BEFORE 09:30 predict whether today trends or reverts?
Features: prior day / 2d / 3d / week / month, overnight, the pre-open hour, volatility term
structure (Chan), daily autocorrelation, Hurst on daily closes, trend position, calendar.
Label: TODAY's RTH directional efficiency. Predictor and label windows do not overlap at all."""
import numpy as np, pandas as pd, warnings; warnings.filterwarnings('ignore')

def hurst(x):
    x=np.asarray(x,float); n=len(x)
    if n<64: return np.nan
    ns=[];rs=[];w=8
    while w<=n//2:
        k=n//w; v=[]
        for i in range(k):
            s=x[i*w:(i+1)*w]; z=s-s.mean(); c=np.cumsum(z)
            S=s.std(ddof=1)
            if S>0: v.append((c.max()-c.min())/S)
        if v: ns.append(w); rs.append(np.mean(v))
        w*=2
    return np.polyfit(np.log(ns),np.log(rs),1)[0] if len(ns)>=3 else np.nan

def build(df):
    m=(df.index.hour*60+df.index.minute)
    d=df.copy(); d['tod']=m; d['day']=d.index.normalize()
    rth=d[(d.tod>=570)&(d.tod<960)]
    g=rth.groupby('day')
    D=pd.DataFrame({'o':g.o.first(),'h':g.h.max(),'l':g.l.min(),'c':g.c.last(),
                    'v':g.v.sum(),'n':g.size()})
    D=D[D.n>=300]
    D['rng']=D.h-D.l
    D['de']=(D.c-D.o).abs()/D.rng                      # TODAY's label source
    D['ret']=np.log(D.c/D.c.shift())
    D['cpos']=(D.c-D.l)/D.rng
    # intraday extreme timing (prior days only, used as a feature)
    ht=g.apply(lambda b: float(np.argmax(b.h.values))/len(b))
    lt=g.apply(lambda b: float(np.argmin(b.l.values))/len(b))
    D['hi_t']=ht.reindex(D.index); D['lo_t']=lt.reindex(D.index)
    D['ADR']=D.rng.shift(1).rolling(14).mean()
    # overnight + pre-open hour
    ov=d[(d.tod>=1080)|(d.tod<570)].copy()
    ov['tgt']=np.where(ov.tod>=1080, (ov.index+pd.Timedelta('1D')).normalize(), ov['day'])
    og=ov.groupby('tgt')
    D['on_h']=og.h.max().reindex(D.index); D['on_l']=og.l.min().reindex(D.index)
    D['on_o']=og.o.first().reindex(D.index); D['on_c']=og.c.last().reindex(D.index)
    pre=d[(d.tod>=510)&(d.tod<570)].groupby('day')
    D['pre_h']=pre.h.max().reindex(D.index); D['pre_l']=pre.l.min().reindex(D.index)
    D['pre_o']=pre.o.first().reindex(D.index); D['pre_c']=pre.c.last().reindex(D.index)
    F=pd.DataFrame(index=D.index)
    A=D.ADR
    # ── prior day / 2 / 3 ──
    for k in [1,2,3]:
        F[f'de_d{k}']   = D.de.shift(k)
        F[f'rng_d{k}']  = D.rng.shift(k)/A
        F[f'ret_d{k}']  = D.ret.shift(k)
        F[f'cpos_d{k}'] = D.cpos.shift(k)
    F['hi_t_d1']=D.hi_t.shift(1); F['lo_t_d1']=D.lo_t.shift(1)
    F['vol_d1']=(D.v.shift(1)/D.v.shift(1).rolling(20).mean())
    # ── prior week / month ──
    F['de_w']   = D.de.shift(1).rolling(5).mean()
    F['de_m']   = D.de.shift(1).rolling(20).mean()
    F['rng_w']  = (D.rng.shift(1).rolling(5).mean())/A
    F['rng_m']  = (D.rng.shift(1).rolling(20).mean())/A
    F['ret_w']  = D.ret.shift(1).rolling(5).sum()
    F['ret_m']  = D.ret.shift(1).rolling(20).sum()
    F['rv5']    = D.ret.shift(1).rolling(5).std()
    F['rv20']   = D.ret.shift(1).rolling(20).std()
    F['vts']    = F.rv5/F.rv20                       # volatility term structure (Chan)
    F['adr_ts'] = (D.rng.shift(1).rolling(5).mean())/(D.rng.shift(1).rolling(20).mean())
    # ── daily autocorrelation & Hurst on the daily series ──
    F['ac1_d']  = D.ret.shift(1).rolling(20).apply(lambda x: pd.Series(x).autocorr(1), raw=False)
    F['hurst_d']= D.c.shift(1).rolling(80).apply(hurst, raw=True)
    # ── trend position ──
    for k in [5,20,50]:
        F[f'vs_sma{k}'] = (D.c.shift(1)-D.c.shift(1).rolling(k).mean())/A
    F['streak'] = np.sign(D.ret.shift(1)).groupby((np.sign(D.ret.shift(1))!=np.sign(D.ret.shift(2))).cumsum()).cumcount()+1
    # ── overnight + pre-open hour ──
    F['on_rng']=(D.on_h-D.on_l)/A
    F['on_de'] =(D.on_c-D.on_o).abs()/(D.on_h-D.on_l).replace(0,np.nan)
    F['gap']   =(D.o-D.c.shift(1))/A
    F['gap_abs']=F.gap.abs()
    F['pre_rng']=(D.pre_h-D.pre_l)/A
    F['pre_de']=(D.pre_c-D.pre_o).abs()/(D.pre_h-D.pre_l).replace(0,np.nan)
    F['o_vs_onrange']=(D.o-D.on_l)/(D.on_h-D.on_l).replace(0,np.nan)
    # ── calendar ──
    F['dow']=D.index.dayofweek; F['dom']=D.index.day
    F['y']=D.de
    return F.replace([np.inf,-np.inf],np.nan).dropna(subset=['y'])

def auc(x,y):
    ok=np.isfinite(x); x,y=x[ok],y[ok]   # per-feature sample, so one long window can't empty the table
    a=x[~y]; b=x[y]
    if len(a)<15 or len(b)<15: return np.nan
    rk=pd.Series(np.concatenate([a,b])).rank().values
    return (rk[len(a):].sum()-len(b)*(len(b)+1)/2)/(len(a)*len(b))

allres={}
for f,tag in [('nq_v6.parquet','NQ'),('mnq_v6.parquet','MNQ26')]:
    F=build(pd.read_parquet(f))
    y=(F.y>=F.y.median()).values
    cols=[c for c in F.columns if c!='y']
    r={c:auc(F[c].values,y) for c in cols}
    allres[tag]=pd.Series(r)
    print(f'{tag}: n={len(F)} sessions, {len(cols)} pre-open features')
R=pd.DataFrame(allres)
print('\n=== NQ ALONE (655 sessions) — all 40 pre-open features, sorted by |AUC-0.5| ===')
nq=allres['NQ'].dropna().sort_values(key=lambda v:(v-0.5).abs(),ascending=False)
for c,v in nq.items():
    flag='  <-- beats chance' if abs(v-0.5)>0.076 else ''    # ~2 sigma at n=655
    print(f'  {c:16s} {v:6.3f}{flag}')
print(f'\n2-sigma band at n=655 is 0.5 +/- 0.076; features outside it: {(nq.sub(0.5).abs()>0.076).sum()} of {len(nq)}')
print(f'expected outside by pure chance: {len(nq)*0.05:.1f}')
R=R.dropna()
R['absdev']=((R.NQ-0.5).abs()+(R.MNQ26-0.5).abs())/2
R['agree']=np.sign(R.NQ-0.5)==np.sign(R.MNQ26-0.5)
print('\n=== TOP 15 by average |AUC-0.5|, both markets ===')
print(f'{"feature":16s} {"AUC NQ":>8s} {"AUC MNQ26":>10s} {"agree":>6s}')
for c,row in R.sort_values('absdev',ascending=False).head(15).iterrows():
    print(f'{c:16s} {row.NQ:8.3f} {row.MNQ26:10.3f} {str(bool(row.agree)):>6s}')
print(f'\nfeatures with |AUC-0.5| > 0.05 on NQ (n={len(R)}): {(R.NQ.sub(0.5).abs()>0.05).sum()}')
print(f'expected by chance at p<0.05 with n~700: about {len(R)*0.05:.1f}')

