"""Quarterly Theory, tested honestly.
   Day cycle 18:00->18:00. Four 6h sessions. Each session = four 90m quarters.
   AMD claim: Q2 sweeps Q1's range (manipulation), Q3 then runs the OTHER way."""
import pandas as pd, numpy as np, warnings; warnings.filterwarnings('ignore')
FLAT=1019

def prep(df):
    o=df.copy()
    m=o.index.hour*60+o.index.minute
    o['minofday']=m
    f18=(m-1080+1440)%1440
    o['q90']=f18//90                 # 0..15 within the day cycle
    o['qtr']=o['q90']%4              # 0=Q1 1=Q2 2=Q3 3=Q4
    o['sesskey']=o['daycycle'].astype(str)+'_'+(o['q90']//4).astype(str)
    o['qkey']=o['daycycle'].astype(str)+'_'+o['q90'].astype(str)
    return o

def amd_table(b):
    """One row per session: Q1 range, which side Q2 swept, what Q3 then did."""
    rows=[]
    for sk,g in b.groupby('sesskey',sort=True):
        q={k:v for k,v in g.groupby('qtr')}
        if not all(k in q for k in (0,1,2)): continue
        if len(q[0])<30 or len(q[1])<30 or len(q[2])<30: continue
        q1h,q1l=q[0]['h'].max(),q[0]['l'].min()
        sw_up = q[1]['h'].max()>q1h
        sw_dn = q[1]['l'].min()<q1l
        if sw_up==sw_dn: continue                 # need exactly one side swept
        q3o,q3c=q[2]['o'].iloc[0],q[2]['c'].iloc[-1]
        q3h,q3l=q[2]['h'].max(),q[2]['l'].min()
        rows.append(dict(sesskey=sk, t0=q[2].index[0], sess=int(g['sess'].iloc[0]),
                         sweep=1 if sw_up else -1, q1h=q1h, q1l=q1l,
                         q3ret=q3c-q3o, q3o=q3o, q3h=q3h, q3l=q3l,
                         q2h=q[1]['h'].max(), q2l=q[1]['l'].min(),
                         rng=q1h-q1l))
    return pd.DataFrame(rows)

