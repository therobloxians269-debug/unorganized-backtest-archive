"""
risk.py — position sizing and the money-management rules.

Everything downstream is expressed in **R** (multiples of the money risked on the
trade), because that is how a disciplined discretionary trader actually thinks:
"I'm risking 1R to make 3R." Dollars are a thin wrapper on top (R x risk_per_trade),
so the same backtest reads identically whether you trade 1 micro or 50.
"""
from __future__ import annotations

from dataclasses import dataclass


@dataclass
class EngineConfig:
    risk_per_trade: float = 100.0       # dollars risked per trade (defines 1R)
    point_value: float = 5.0            # $/index point (MES=5, MNQ=2, MYM=0.5, MCL=100)
    tick: float = 0.25
    commission_per_contract: float = 0.62   # per side, per contract
    slippage_ticks: float = 1.0             # per side
    # Trade management
    partial_enabled: bool = True
    partial_rr: float = 1.0             # take a scale-out at +partial_rr R
    partial_frac: float = 0.5           # fraction of position closed at the scale-out
    breakeven_after_partial: bool = True
    max_contracts: float = 50.0
    stop_priority: bool = True          # if a bar hits stop AND target, assume stop


def contracts_for(risk_points: float, cfg: EngineConfig) -> float:
    """Fractional contracts implied by risking `risk_per_trade` over `risk_points`."""
    if risk_points <= 0:
        return 0.0
    per_contract = risk_points * cfg.point_value
    if per_contract <= 0:
        return 0.0
    return min(cfg.max_contracts, cfg.risk_per_trade / per_contract)


def round_trip_cost_R(risk_points: float, cfg: EngineConfig) -> float:
    """Commissions + slippage for the trade, expressed in R."""
    contracts = contracts_for(risk_points, cfg)
    comm = cfg.commission_per_contract * 2 * contracts
    slip = cfg.slippage_ticks * cfg.tick * cfg.point_value * 2 * contracts
    risk_dollars = cfg.risk_per_trade if cfg.risk_per_trade > 0 else 1.0
    return (comm + slip) / risk_dollars

