"""
MOMENTUM MULTI-LOOKBACK ENSEMBLE — lever #3, honest test.

The deployed momentum sleeve uses ONE lookback (90d). Specification risk: 90d is a choice, and a
single choice can quietly be lucky. Standard robust fix: blend several lookbacks into ONE signal
(average the cross-sectional momentum RANK across 30/60/90/120/180d), select top-third on the blend.
Everything else identical to the deployed engine (inv-vol, weekly rebal, soft regime, 25bps).

This reduces variance of the signal without adding a tunable knob we then optimize — the ensemble
is the un-optimized "I don't know which lookback is right so use all of them" choice.

Honesty guards:
  - same eligibility (point-in-time top-30), same cost, same rebal, same regime filter
  - reproduce the deployed 90d sleeve exactly as the baseline
  - SWEEP single lookbacks too: ensemble must beat the AVERAGE single and rival the best — if one
    short window dominates, that's a different (riskier, turnover-heavy) story, not robustness
  - OOS split 2018-2022 vs 2023-2026
  - then plug the winner into the FULL program to see the net effect at 15% sleeve weight

    PYTHONPATH=/Users/kaveh/mim_research python3 momentum_ensemble.py
"""
from __future__ import annotations
import json
import numpy as np
import pandas as pd
from lib_perf import perf_stats
from pit_backtest import PX, MEMB, ANN, COST, START, SURV

ME_START = pd.Timestamp(START)


def build_elig(px):
    memb = json.load(open(MEMB))
    snaps = sorted(memb.items())
    elig = pd.DataFrame(False, index=px.index, columns=px.columns)
    for i, (d, syms) in enumerate(snaps):
        d0 = pd.Timestamp(d)
        d1 = pd.Timestamp(snaps[i + 1][0]) if i + 1 < len(snaps) else px.index[-1] + pd.Timedelta(days=1)
        cols = [s for s in syms[:30] if s in px.columns]
        elig.loc[(elig.index >= d0) & (elig.index < d1), cols] = True
    return elig


def run_lookbacks(px, elig, lookbacks):
    """Deployed engine, but the momentum score is the AVERAGE cross-sectional rank over `lookbacks`."""
    rets = px.pct_change()
    av = (rets.rolling(60).std() * np.sqrt(ANN)).shift(1)
    # average the cross-sectional rank across lookbacks -> one blended score
    rank_sum, n = None, 0
    for lb in lookbacks:
        mom = px.pct_change(lb).shift(1).where(elig)
        rk = mom.rank(axis=1, ascending=False)
        rank_sum = rk if rank_sum is None else rank_sum.add(rk, fill_value=np.nan)
        n += 1
    blended = rank_sum / n
    n_t = blended.notna().sum(axis=1)
    k_t = np.maximum(3, (n_t // 3)).astype(float)
    rank = blended.rank(axis=1, ascending=True)              # lower blended rank = stronger
    sel = rank.le(k_t, axis=0).astype(float)
    w = (sel / av).replace([np.inf, -np.inf], np.nan).fillna(0.0)
    w = w.div(w.abs().sum(axis=1).replace(0, np.nan), axis=0).fillna(0.0)
    mret = rets.where(elig).mean(axis=1).fillna(0.0)
    idx = (1 + mret).cumprod()
    soft = (idx > idx.rolling(100).mean()).shift(1).fillna(True).replace(False, 0.3).replace(True, 1.0).astype(float)
    w = w.mul(soft, axis=0).shift(1)
    w = w.resample("W").last().reindex(px.index, method="ffill").fillna(0.0)
    turn = w.diff().abs().sum(axis=1)
    net = ((w * rets.fillna(0.0)).sum(axis=1) - turn * COST * 1e-4).dropna()
    return net[net.index >= ME_START], turn[turn.index >= ME_START]


def stat(r):
    return perf_stats(r, ANN)


def show(tag, r, turn=None):
    s = stat(r)
    t = f" | turn {turn.mean()*ANN:5.1f}x" if turn is not None else ""
    print(f"  {tag:26} Sharpe {s['sharpe']:5.2f} | CAGR {s['cagr']*100:6.1f}% | "
          f"maxDD {s['maxdd']*100:6.1f}% | Calmar {s['calmar']:4.2f}{t}")


def oos(tag, r):
    a = r[(r.index.year >= 2018) & (r.index.year <= 2022)]
    b = r[(r.index.year >= 2023) & (r.index.year <= 2026)]
    print(f"  {tag:18} 2018-2022 Sharpe {stat(a)['sharpe']:5.2f}  |  2023-2026 Sharpe {stat(b)['sharpe']:5.2f}")


def main():
    px = pd.read_parquet(PX); px.index = pd.to_datetime(px.index).tz_localize(None)
    elig = build_elig(px)

    print("=" * 100)
    print("MOMENTUM SLEEVE — single lookback vs multi-lookback ensemble (point-in-time, net 25bps)")
    print("=" * 100)

    print("\n[1] SINGLE-LOOKBACK SWEEP  (90d is the deployed one)")
    singles = {}
    for lb in (30, 60, 90, 120, 180):
        r, t = run_lookbacks(px, elig, [lb])
        singles[lb] = r
        show(f"single {lb}d" + ("  <-deployed" if lb == 90 else ""), r, t)
    avg_single = np.mean([stat(r)['sharpe'] for r in singles.values()])
    best_single = max(stat(r)['sharpe'] for r in singles.values())
    print(f"  --> avg single Sharpe {avg_single:.2f} | best single {best_single:.2f}")

    print("\n[2] ENSEMBLES  (blend = average rank across the listed lookbacks)")
    ensembles = {
        "60+120": [60, 120],
        "30+90+180": [30, 90, 180],
        "60+90+120": [60, 90, 120],
        "30+60+90+120+180": [30, 60, 90, 120, 180],
    }
    ens_r = {}
    for name, lbs in ensembles.items():
        r, t = run_lookbacks(px, elig, lbs)
        ens_r[name] = r
        show(f"ens {name}", r, t)

    print("\n[3] OOS SPLIT  (deployed 90d vs broad ensemble) — ensemble should be steadier")
    oos("single 90d", singles[90])
    oos("ens 30..180", ens_r["30+60+90+120+180"])

    print("\n[4] NET EFFECT IN FULL PROGRAM  (swap M sleeve, keep everything else; 15% nominal weight)")
    try:
        from pm_dd_pack import build
        import pm_dd_pack as ddp

        def program_with_M(M_series):
            # mirror build() exactly but inject a custom momentum net series
            port0, j, comp, tC1, tC2 = build()
            M = M_series.reindex(j.index).fillna(0.0)
            comp2 = comp.copy(); comp2["M"] = 0.15 * M
            return comp2.sum(axis=1).dropna()

        base_port, *_ = build()
        bs = stat(base_port)
        print(f"  baseline program (deployed 90d M):  Sharpe {bs['sharpe']:.2f} | "
              f"CAGR {bs['cagr']*100:.1f}% | maxDD {bs['maxdd']*100:.1f}%")
        for name in ("single 90d (rebuilt)", "ens 30+60+90+120+180"):
            Ms = singles[90] if name.startswith("single") else ens_r["30+60+90+120+180"]
            p = program_with_M(Ms); s = stat(p)
            print(f"  {name:30}  Sharpe {s['sharpe']:.2f} | CAGR {s['cagr']*100:.1f}% | maxDD {s['maxdd']*100:.1f}%")
    except Exception as e:
        print("  (full-program injection skipped:", e, ")")

    print("\n" + "=" * 100)
    print("READ: ensemble is a real win iff its Sharpe rivals the BEST single while beating the AVERAGE")
    print("single, holds in BOTH OOS halves, AND lifts (or doesn't hurt) the full program. Robustness,")
    print("not a new optimized knob.")
    print("=" * 100)


if __name__ == "__main__":
