"""AMD-X / X-AMD with DYNAMIC phase assignment.
   Any 90m quarter can be the manipulation. Identify it by behaviour:
   it sweeps the prior quarter(s) range and closes back inside.
   Then trade the NEXT quarter as the distribution leg."""
import pandas as pd, numpy as np, warnings; warnings.filterwarnings('ignore')
FLAT=1019
def prep(df):
    o=df.copy(); m=(o.index.hour*60+o.index.minute).values
    o['minofday']=m; f18=(m-1080+1440)%1440
    o['q90']=f18//90; o['qtr']=o['q90']%4
    o['qkey']=o['daycycle'].astype(str)+'_'+o['q90'].astype(str)
    o['skey']=o['daycycle'].astype(str)+'_'+(o['q90']//4).astype(str)
    r=o.resample('60min',label='left',closed='left').agg({'h':'max','l':'min','c':'last'}).dropna()
    tr=pd.concat([r.h-r.l,(r.h-r.c.shift()).abs(),(r.l-r.c.shift()).abs()],axis=1).max(axis=1)
    o['atr60']=tr.rolling(14).mean().shift(1).reindex(o.index,method='ffill')
    return o

def amdx_setups(b, lookback_q=2, min_sweep_atr=0.10, need_reclaim=True):
    """scan every 90m quarter; flag it manipulation if it sweeps the prior
       `lookback_q` quarters' range and closes back inside. Trade the next quarter."""
    Q=b.groupby('qkey',sort=False).agg(t0=('o','size'),o=('o','first'),h=('h','max'),
                                       l=('l','min'),c=('c','last'))
    Q['start']=b.groupby('qkey',sort=False).apply(lambda g: g.index[0])
    Q=Q.sort_values('start').reset_index()
    out=[]
    for k in range(lookback_q, len(Q)-1):
        prior=Q.iloc[k-lookback_q:k]
        pH,pL=prior.h.max(),prior.l.min()
        cur=Q.iloc[k]; nxt=Q.iloc[k+1]
        seg=b[b.qkey==cur.qkey]
        if len(seg)<45: continue
        a=seg.atr60.iloc[-1]
        if not np.isfinite(a) or a<=0: continue
        swU = cur.h > pH + min_sweep_atr*a
        swD = cur.l < pL - min_sweep_atr*a
        if swU==swD: continue                       # need exactly one side
        if need_reclaim:
            if swU and cur.c > pH: continue         # must close back INSIDE
            if swD and cur.c < pL: continue
        nseg=b[b.qkey==nxt.qkey]
        if len(nseg)<10: continue
        i=b.index.get_loc(nseg.index[0])
        out.append(dict(qkey=cur.qkey,t=nseg.index[0],i=i,
                        dir=-1 if swU else 1, ext=cur.h if swU else cur.l,
                        pH=pH,pL=pL,atr=a,qtr=int(seg.qtr.iloc[0])))
    return pd.DataFrame(out)

def trade(b,P,rr=4.0,buf=2.0,max_hold=270,pv=20.,comm=4.,slip=0.25,
          tgt='R',displace=None,seed=0,qtrs=(0,1,2,3)):
    o,h,l=b.o.values,b.h.values,b.l.values; m=b['minofday'].values; n=len(b)
    rng=np.random.default_rng(seed); out=[]
    for _,p in P.iterrows():
        if p.qtr not in qtrs: continue
        i=int(p.i); d=int(p.dir)
        if i+2>=n or (FLAT<=m[i]<1080): continue
        ext=p.ext; pH=p.pH; pL=p.pL
        if displace is not None:
            sh=displace*(1 if rng.random()<.5 else -1); ext+=sh; pH+=sh; pL+=sh
        ep=o[i+1]+(slip if d==1 else -slip)
        st=(ext-buf) if d==1 else (ext+buf)
        if (d==1 and st>=ep) or (d==-1 and st<=ep): continue
        risk=abs(ep-st)
        if risk<1.0 or risk>4*p.atr: continue
        tg=(ep+rr*risk if d==1 else ep-rr*risk) if tgt=='R' else (pH if d==1 else pL)
        e=min(i+1+max_hold,n); mm=m[i+1:e]
        fl=np.where((mm>=FLAT)&(mm<1080))[0]
        e2=i+1+int(fl[0]) if len(fl) else e
        hs=h[i+1:e2]; ls=l[i+1:e2]
        if len(hs)==0: continue
        sh_=(hs>=st) if d==-1 else (ls<=st)
        th=(ls<=tg) if d==-1 else (hs>=tg)
        si=int(sh_.argmax()) if sh_.any() else 10**9
        ti=int(th.argmax()) if th.any() else 10**9
        if si==10**9 and ti==10**9: k=e2-1; px=o[k]; w='time'
        elif si<=ti: k=i+1+si; px=st+(slip if d==-1 else -slip); w='stop'
        else: k=i+1+ti; px=tg; w='tgt'
        pts=(ep-px) if d==-1 else (px-ep)
        out.append(dict(t=b.index[i+1],d=d,qtr=p.qtr,R=(pts*pv-comm)/(risk*pv),
                        pnl=pts*pv-comm,rr=abs(tg-ep)/risk,why=w))
    return pd.DataFrame(out)

