      f"{'mean fwd R':>11}   split-A acc  split-B acc")
print("-" * 88)


def auc(score, y):
    """Mann-Whitney AUC of `score` for the binary outcome y in {0,1}."""
    m = np.isfinite(score) & np.isfinite(y)
    s, yy = score[m], y[m]
    if yy.sum() == 0 or yy.sum() == len(yy):
        return np.nan
    r = pd.Series(s).rank().to_numpy()
    n1 = yy.sum(); n0 = len(yy) - n1
    return (r[yy == 1].sum() - n1 * (n1 + 1) / 2) / (n1 * n0)


rowsA = []
for tf in run.TFS:
    for lm in ["forward", "published"]:
        st = run.build(df, tf, lm, key="nq")
        c = st["c"]; a = st["atr"]; idx = st["bars"].index
        pred = st["m"]["pred"]; filt = st["m"]["filt"]
        mA = run.split_mask(idx, *data.SPLITS["A_2023"])
        mB = run.split_mask(idx, *data.SPLITS["B_2024_25"])
        for H in [4, 12, 30, 60]:
            fwd = np.full(len(c), np.nan)
            fwd[:-H] = c[H:] - c[:-H]
            base = filt & (pred != 0) & np.isfinite(fwd) & (a > 0)
            base[:3000] = False
            m = base & (np.sign(fwd) != 0)
            if m.sum() < 50:
                continue
            acc = (np.sign(pred[m]) == np.sign(fwd[m])).mean()
            au = auc(pred[m], (fwd[m] > 0).astype(float))
            mfr = (np.sign(pred[m]) * fwd[m] / a[m]).mean()
            aA = (np.sign(pred[m & mA]) == np.sign(fwd[m & mA])).mean() if (m & mA).sum() > 50 else np.nan
            aB = (np.sign(pred[m & mB]) == np.sign(fwd[m & mB])).mean() if (m & mB).sum() > 50 else np.nan
            print(f"{tf:>4} {lm:<10} {H:>4} {m.sum():>8} {acc:>7.4f} {au:>7.4f} "
                  f"{mfr:>11.4f}   {aA:>10.4f}   {aB:>10.4f}")
            rowsA.append(dict(tf=tf, lm=lm, H=H, n=int(m.sum()), acc=acc, auc=au,
                              mean_fwd_R=mfr, accA=aA, accB=aB))
pd.DataFrame(rowsA).to_csv("diag_info.csv", index=False)

# ------------------------------------------------------------------ B
print("\n\nB) THE ONE CELL THAT LOOKED ALIVE: NQ 5m, breaker gate, wide stop")
print("-" * 112)
st = run.build(df, 5, "forward", key="nq")
