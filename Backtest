"""Batch 1 — ES/YM lead-lag + divergence family (+ baselines).

Motivation: the ICT-Judas wrapper died, but its SMT-divergence gate showed a
clean monotonic control (div > off > invert). Strip the wrapper and test the
raw cross-instrument relationship: does the ES/YM lead-lag or divergence carry
tradable timing in ES itself?
"""
from __future__ import annotations

import numpy as np
import pandas as pd

import harness as H


def _ret(s: pd.Series, k: int) -> pd.Series:
    return s / s.shift(k) - 1.0


# --- signals (all causal: use only info up to bar t) ------------------------
def ym_leads(df, k=3):
    """YM recent return predicts ES next move (Dow-leads-S&P)."""
    return _ret(df["ym_close"], k)


def es_leads(df, k=3):
    """ES momentum (baseline; MIM-style, expected dead)."""
    return _ret(df["es_close"], k)


def es_meanrev(df, k=3):
    return -_ret(df["es_close"], k)


def divergence_mr(df, k=5):
    """Normalized ES-YM return spread; when ES lags YM, buy ES (catch-up)."""
    er, yr = _ret(df["es_close"], k), _ret(df["ym_close"], k)
    ez = (er - er.rolling(120).mean()) / (er.rolling(120).std() + 1e-9)
    yz = (yr - yr.rolling(120).mean()) / (yr.rolling(120).std() + 1e-9)
    return yz - ez            # >0: YM outran ES -> expect ES to catch up (long ES)


def divergence_mom(df, k=5):
    er, yr = _ret(df["es_close"], k), _ret(df["ym_close"], k)
    ez = (er - er.rolling(120).mean()) / (er.rolling(120).std() + 1e-9)
    yz = (yr - yr.rolling(120).mean()) / (yr.rolling(120).std() + 1e-9)
    return ez - yz            # ES-leads-continuation framing


def combined_mom(df, k=3):
    return _ret(df["es_close"], k) + _ret(df["ym_close"], k)


def smt_fade(df, k=15):
    """ES prints a new k-min high but YM does NOT -> nonconfirmation, fade ES."""
    es_new_hi = df["es_close"] >= df["es_close"].rolling(k).max()
    ym_new_hi = df["ym_close"] >= df["ym_close"].rolling(k).max()
    es_new_lo = df["es_close"] <= df["es_close"].rolling(k).min()
    ym_new_lo = df["ym_close"] <= df["ym_close"].rolling(k).min()
    sig = pd.Series(0.0, index=df.index)
    sig[es_new_hi & ~ym_new_hi] = -1.0     # unconfirmed high -> short
    sig[es_new_lo & ~ym_new_lo] = +1.0     # unconfirmed low -> long
    return sig


BATCH = [
    ("ym_leads_es",      ym_leads,     [{"k": k} for k in (1, 2, 3, 5, 10)], (0.0,)),
    ("es_momentum",      es_leads,     [{"k": k} for k in (1, 3, 5, 10, 30)], (0.0,)),
    ("es_meanrev",       es_meanrev,   [{"k": k} for k in (1, 3, 5, 10, 30)], (0.0,)),
    ("divergence_mr",    divergence_mr,[{"k": k} for k in (3, 5, 10, 20)], (0.0, 0.5, 1.0)),
    ("divergence_mom",   divergence_mom,[{"k": k} for k in (3, 5, 10, 20)], (0.0, 0.5, 1.0)),
    ("combined_mom",     combined_mom, [{"k": k} for k in (1, 3, 5, 10)], (0.0,)),
    ("smt_fade",         smt_fade,     [{"k": k} for k in (10, 15, 30, 60)], (0.5,)),
]


def main():
    results = []
    for name, fn, grid, thr in BATCH:
        r = H.screen(name, fn, grid, rth_only=True, thr_grid=thr)
        results.append(r)
        print(f"  ran {name:16s} -> test SR {r.get('te_sharpe',0):+.2f} [{r['status']}]")
    print("\n" + H.leaderboard(results))
    surv = [r for r in results if r["status"] == "SURVIVE"]
    print(f"\nSURVIVORS: {len(surv)}")
    for r in surv:
        print("  ", r)


if __name__ == "__main__":
    main()

