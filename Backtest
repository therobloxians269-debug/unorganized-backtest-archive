QS=[0.20,0.40,0.60,0.80,0.90,0.95]; F=['f_onlo','f_onhi','f_gap','f_pdr','f_dow']

def har(D, tr_end):
    X=D.copy(); lr=np.log(X.rng)
    X['lr1']=lr.shift(1); X['lr5']=lr.shift(1).rolling(5).mean(); X['lr22']=lr.shift(1).rolling(22).mean()
    X=X.dropna(subset=['lr1','lr5','lr22'])
    TR=X[X.index.year<=tr_end]
    A=np.c_[TR[['lr1','lr5','lr22']].values,np.ones(len(TR))]
    b=np.linalg.lstsq(A,np.log(TR.rng.values),rcond=None)[0]
    X['fc']=np.exp(np.c_[X[['lr1','lr5','lr22']].values,np.ones(len(X))]@b)
    return X,b

out={}
for D,tag,tr_end in [(esday,'ES',2017),(nqday,'NQ',2024)]:
    X,hb=har(D,tr_end)
    TR=X[X.index.year<=tr_end].copy(); TE=X[X.index.year>tr_end].copy()
    for c in ['f_onlo','f_onhi','f_gap']:
        TR[c]=TR[c]*TR.ADR/TR.fc; TE[c]=TE[c]*TE.ADR/TE.fc
    print(f'=== {tag}  train {len(TR)}  test {len(TE)} ===')
    res={}
    for side,ycol in [('lo',lambda d:(d.o930-d.lo)/d.fc),('hi',lambda d:(d.hi-d.o930)/d.fc)]:
        ytr=ycol(TR); yte=ycol(TE)
