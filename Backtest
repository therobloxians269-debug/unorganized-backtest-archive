#!/usr/bin/env python3
"""Shared substrate for the regime-routed multi-style MES indicator study.
Builds (and caches) causal 5-min features on real front-month ES 2010-2026:
  per-day: o,h,l,c,v, session VWAP, Wilder ATR(14), continuous efficiency ratio
  ER(24), opening-range hi/lo (09:30-10:00), prior-day hi/lo/close.
All features are CAUSAL (ER/ATR continuous across days; VWAP/OR anchored intraday).
Friction = Tradovate limit model: 0.16pt commission + 0.25pt slippage per MARKET
fill (limit-target exits pay 0 slippage). $5/pt (MES 1-lot)."""
import os, pickle
import numpy as np, pandas as pd

SRC = "/Users/kaveh/mim_research/es_front_rth_1m.parquet"
CACHE_PKL = "/Users/kaveh/mes_mim/omni2_sessions.pkl"
CACHE_PARQ = "/Users/kaveh/omni_x/omni2_features.parquet"   # flat, for verifier agents
COMM, SLIP, DPP, FLOOR = 0.16, 0.25, 5.0, 5.0
ORN = 6          # opening range = first 6 five-min bars (09:30-10:00)
ER_N = 24        # efficiency-ratio window (bars)

def fric(exit_kind):
    """entry always market (signal-at-close); exit market unless a limit target."""
    return COMM + SLIP + (0.0 if exit_kind == "target" else SLIP)

def _build():
    df = pd.read_parquet(SRC)
    df["date"] = pd.to_datetime(df["date"]).dt.date
    hm = df["hm"].str.split(":", expand=True)
    df["mos"] = (hm[0].astype(int)*60 + hm[1].astype(int)) - (9*60+30)
    df = df[(df["mos"] >= 0) & (df["mos"] < 390)].copy()
    df["b5"] = df["mos"] // 5
    g = df.groupby(["date", "b5"])
    b = pd.DataFrame({"open": g["open"].first(), "high": g["high"].max(), "low": g["low"].min(),
                      "close": g["close"].last(), "vol": g["volume"].sum()}).reset_index()
    b = b.sort_values(["date", "b5"]).reset_index(drop=True)
    cl = b["close"].to_numpy()
    # continuous Wilder ATR(14)
    pc = np.concatenate([[cl[0]], cl[:-1]])
    tr = np.maximum(b["high"].to_numpy()-b["low"].to_numpy(),
                    np.maximum(np.abs(b["high"].to_numpy()-pc), np.abs(b["low"].to_numpy()-pc)))
    b["atr"] = pd.Series(tr).ewm(alpha=1/14, adjust=False).mean().to_numpy()
    # continuous efficiency ratio ER(24)
    cumd = np.concatenate([[0.0], np.cumsum(np.abs(np.diff(cl)))])
    er = np.zeros(len(cl))
    den = cumd[ER_N:] - cumd[:-ER_N]
    num = np.abs(cl[ER_N:] - cl[:-ER_N])
    er[ER_N:] = np.where(den > 0, num/den, 0.0)
    b["er"] = er
    # per-day sessions
    sessions = []
    prev_hi = prev_lo = prev_close = None
    for d, gg in b.groupby("date", sort=True):
        gg = gg.sort_values("b5")
        if len(gg) != 78:
            if len(gg):
                prev_hi = float(gg["high"].max()); prev_lo = float(gg["low"].min()); prev_close = float(gg["close"].iloc[-1])
            continue
        o = gg["open"].to_numpy(); h = gg["high"].to_numpy(); l = gg["low"].to_numpy()
        c = gg["close"].to_numpy(); v = gg["vol"].to_numpy(); atr = gg["atr"].to_numpy(); erd = gg["er"].to_numpy()
        tp = (h+l+c)/3.0; vwap = np.cumsum(tp*v)/np.maximum(np.cumsum(v), 1)
        sessions.append(dict(date=d, o=o, h=h, l=l, c=c, v=v, vwap=vwap, atr=atr, er=erd,
                             or_hi=float(h[:ORN].max()), or_lo=float(l[:ORN].min()),
                             prev_hi=prev_hi, prev_lo=prev_lo, prev_close=prev_close))
        prev_hi = float(h.max()); prev_lo = float(l.min()); prev_close = float(c[-1])
    return sessions

def load(rebuild=False):
    if (not rebuild) and os.path.exists(CACHE_PKL):
        with open(CACHE_PKL, "rb") as f:
            return pickle.load(f)
    s = _build()
    with open(CACHE_PKL, "wb") as f:
        pickle.dump(s, f)
    # flat parquet for verifier agents
    rows = []
    for d in s:
        for i in range(78):
            rows.append((str(d["date"]), i, d["o"][i], d["h"][i], d["l"][i], d["c"][i], d["v"][i],
                         d["vwap"][i], d["atr"][i], d["er"][i], d["or_hi"], d["or_lo"],
                         np.nan if d["prev_hi"] is None else d["prev_hi"],
                         np.nan if d["prev_lo"] is None else d["prev_lo"]))
    pd.DataFrame(rows, columns=["date", "b5", "o", "h", "l", "c", "v", "vwap", "atr", "er",
                                "or_hi", "or_lo", "prev_hi", "prev_lo"]).to_parquet(CACHE_PARQ, index=False)
    return s

def report(tr, name):
    """tr: DataFrame with columns date, net, risk, kind (net already net of friction, in points)."""
    if len(tr) < 20:
        print(f"{name:34s} n={len(tr):4d} (too few)"); return {}
    tr = tr.copy(); tr["yr"] = pd.to_datetime(tr["date"]).dt.year
    res = {}
    def one(d, lbl):
        if len(d) < 5:
            print(f"    {lbl:9s} —"); return
        net = d["net"].to_numpy(); eq = np.cumsum(net)*DPP; dd = (eq-np.maximum.accumulate(eq)).min()
        rr = net.sum()*DPP/abs(dd) if dd < 0 else float("inf")
        R = (net/d["risk"].clip(lower=1e-9)).mean()
        res[lbl] = dict(n=len(d), net_usd=float(net.sum()*DPP), netR=float(R), hit=float((net > 0).mean()),
                        maxdd=float(dd), rr=float(rr))
        print(f"    {lbl:9s} n={len(d):5d} netR={R:+.3f} hit={(net>0).mean():.2f} "
              f"${net.sum()*DPP:>8.0f} maxDD=${dd:>8.0f} ret/DD={rr:>5.2f}")
    print(name)
    one(tr, "ALL"); one(tr[tr.yr < 2020], "pre-2020"); one(tr[(tr.yr>=2020)&(tr.yr<=2021)], "2020-21"); one(tr[tr.yr >= 2022], "2022+")
    return res

if __name__ == "__main__":
    s = load(rebuild=True)
    print(f"built {len(s)} sessions {s[0]['date']}..{s[-1]['date']}; cached -> {CACHE_PKL} + {CACHE_PARQ}")
    er = np.concatenate([d["er"] for d in s])
    print(f"ER(24) distribution: p10={np.percentile(er,10):.3f} p50={np.percentile(er,50):.3f} p90={np.percentile(er,90):.3f} "
          f"| frac trend(>=.35)={np.mean(er>=0.35):.3f} frac range(<=.13)={np.mean(er<=0.13):.3f}")

