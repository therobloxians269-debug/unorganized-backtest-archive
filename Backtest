   each with Bullish / Bearish  Active-or-Inactive, NQ vs ES/YM."""
import pandas as pd,numpy as np
NY='America/New_York'
def anchored(df,rule,anchor):
    a={'o':'first','h':'max','l':'min','c':'last','es_high':'max','es_low':'min',
       'ym_high':'max','ym_low':'min'}
    return df.resample(rule,origin=anchor,label='left',closed='left').agg(a).dropna()

def state(r,name,L=2,R=2,ref='either'):
    h=r['h'].values;l=r['l'].values;c=r['c'].values
    eh=r['es_high'].values;el=r['es_low'].values;yh=r['ym_high'].values;yl=r['ym_low'].values
    n=len(r);ph=np.zeros(n,bool);pl=np.zeros(n,bool)
    for i in range(L,n-R):
        if h[i]==max(h[i-L:i+R+1]) and h[i]>h[i-1] and h[i]>h[i+R]: ph[i]=True
        if l[i]==min(l[i-L:i+R+1]) and l[i]<l[i-1] and l[i]<l[i+R]: pl[i]=True
    bear=np.zeros(n,bool);bull=np.zeros(n,bool)
    lph=lpl=-1;bi=np.nan;ui=np.nan;bs=bl=False
    for j in range(n):
        k=j-R
        if k>=0 and ph[k]: lph=k
        if k>=0 and pl[k]: lpl=k
        if bs and c[j]>bi: bs=False
        if bl and c[j]<ui: bl=False
        if lph>=0 and j>lph and h[j]>h[lph]:
            f=(eh[j]<=eh[lph]) or (yh[j]<=yh[lph])
            if f: bs=True; bi=h[j]
        if lpl>=0 and j>lpl and l[j]<l[lpl]:
            f=(el[j]>=el[lpl]) or (yl[j]>=yl[lpl])
            if f: bl=True; ui=l[j]
        bear[j]=bs;bull[j]=bl
    return pd.DataFrame({f'bear_{name}':bear,f'bull_{name}':bull},index=r.index)

def build_table(df):
    i0=df.index[0]
    a18=i0.normalize()+pd.Timedelta(hours=18)
    if a18>i0: a18-=pd.Timedelta(days=1)
    # walk back to a Sunday 18:00 for the weekly anchor
    aw=a18-pd.Timedelta(days=(a18.weekday()+1)%7)
    specs=[('micro','1350s',a18),('m90','90min',a18),('daily','1440min',a18),
           ('weekly','168h',aw),('monthly','672h',aw)]
    out=[]
    for nm,rule,anc in specs:
        r=anchored(df,rule,anc)
        out.append(state(r,nm).reindex(df.index,method='ffill').fillna(False))
    T=pd.concat(out,axis=1)
    T['bear_score']=T[[c for c in T if c.startswith('bear_')]].sum(axis=1)
    T['bull_score']=T[[c for c in T if c.startswith('bull_')]].sum(axis=1)
    return T

