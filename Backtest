"""Sweep 2: is the loss caused by costs, by the stop size, or by the signal?

  (a) GROSS (zero cost) vs NET  - separates the cost floor from the signal
  (b) ATR multiplier sweep      - a stop too tight for 1m noise would show here
  (c) inversion                 - a signal that scores the same inverted is
                                  measuring nothing (see ICT octants post-mortem)
"""
import numpy as np, pandas as pd
import data, engine, run

df = data.load_nq_main()
COST = data.cost_points("MNQ")
rows = []

for tf in run.TFS:
    st = run.build(df, tf, "forward", key="nq")
    for k in [0.5, 1.0, 1.5, 2.0, 3.0]:
        for cost, cname in [(0.0, "GROSS"), (COST, "net")]:
            for inv, iname in [(False, "as-published"), (True, "INVERTED")]:
                r = run.backtest(st, gate="breaker", k=k, mode=engine.MODE_FULL,
                                 tf=tf, cost=cost, invert=inv)
                s = engine.stats(r[7], r[6], 2.0,
                                 f"{tf:>2}m k={k:<4} {cname:<5} {iname:<12}")
                s.update(tf=tf, k=k, cost=cname, inv=iname)
                rows.append(s)

R = pd.DataFrame(rows)
R.to_csv("sweep2.csv", index=False)
for tf in run.TFS:
    print(f"\n{'='*112}\n  NQ {tf}m   LDC bias + breaker retest + 1:2 plan\n{'='*112}")
    for _, x in R[R.tf == tf].iterrows():
        print(engine.fmt(x.to_dict()))

