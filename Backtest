"""Bolt the calibrated Range Map onto THE PAIR as a room-to-extreme geometry filter."""
import numpy as np, pandas as pd, pickle, warnings; warnings.filterwarnings('ignore')
from orb import build as obuild, or_levels, trade as otrade
from vfast import build24, fade as vfade
from crs import build_levels, rejections
from crs_test import trade as ctrade
from ladder import build, pred, QS
SCR='/private/tmp/claude-501/-Users-kaveh/d5ce5738-dd59-4ca2-bd9c-e9b02fe3107c/scratchpad'
M=pickle.load(open(f'{SCR}/ladder_M.pkl','rb'))

def sleeve_trades(df, pv=2.0, cm=1.50):
    V=build24(df)
    vw=vfade(V,sessions=(1,2),reentry=True,k=1.5,pv=pv,comm=cm)[['t','d','pnl','R']].assign(s='VWAP')
    LV=build_levels(df); R=rejections(df,LV,minConf=1)
    z=R[(R.n>=4)&(R.names.str.contains('POC',regex=False))]
    rj=ctrade(df,z,rr=4.0,pv=pv,comm=cm)[['t','d','pnl','R']].assign(s='REJ')
    return pd.concat([vw,rj]).sort_values('t').reset_index(drop=True)

def room_frame(df):
    """per-1m-bar causal room-to-extreme, in ADR units, from the 09:30-frozen map."""
    x=df.rename(columns={'o':'open','h':'high','l':'low','c':'close'})[['open','high','low','close']]
    day,rth=build(x)
    P=pred(M,day)
    di={d:i for i,d in enumerate(day.index)}
    frames=[]
    for d,bars in rth.groupby('day'):
        if d not in di: continue
        i=di[d]; o=day.at[d,'o930']; A=day.at[d,'ADR']
        runH=bars['high'].cummax().values; runL=bars['low'].cummin().values
        # how far each side has already travelled, in ADR
        travH=(runH-o)/A; travL=(o-runL)/A
        # which nominal band each side has already exceeded
        def bandof(t, side):
            b=np.zeros(len(t))
            for q in QS: b=np.where(t>=P[(side,q)][i], q*100, b)
            return b
        frames.append(pd.DataFrame({
            'qhi':bandof(travH,'hi'), 'qlo':bandof(travL,'lo'),
            'room_up':(P[('hi',0.95)][i]-travH), 'room_dn':(P[('lo',0.95)][i]-travL),
        }, index=bars.index))
    return pd.concat(frames).sort_index()

def attach(tr, rf):
    tt=pd.DatetimeIndex(tr['t'])
    if tt.tz is None: tt=tt.tz_localize(rf.index.tz)
    else: tt=tt.tz_convert(rf.index.tz)
    r=rf.reindex(tt, method='ffill')     # state at/just before the entry bar
    out=tr.copy()
    for c in rf.columns: out[c]=r[c].values
    # room in the direction the trade is going
    out['room']=np.where(out.d==1, out['room_up'], out['room_dn'])
    out['qband']=np.where(out.d==1, out['qhi'], out['qlo'])
    return out.dropna(subset=['room'])

def rep(t,tag):
