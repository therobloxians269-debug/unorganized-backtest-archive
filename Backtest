    print(f"saved {len(panel):,} rows -> {OUT}")
    print(f"{panel['date'].min().date()} -> {panel['date'].max().date()} | markets {panel['root'].nunique()}")
    print("\nmedian annualized carry by market (sanity: CL/energy backwardated +, GC/equities ~contango -):")
    print(panel.groupby("root")["carry_ann"].median().mul(100).round(1).sort_values(ascending=False).to_string())


