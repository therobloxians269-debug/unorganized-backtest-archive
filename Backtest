#!/usr/bin/env python3
"""
gen_data.py — synthetic but *structurally honest* 1-minute futures data.

This is NOT a claim of edge. It exists so the engine runs end-to-end with zero
external files. The generator deliberately bakes in the daily ICT anatomy the
models look for — Asian accumulation, a London "Judas" manipulation leg that
raids the overnight pool, then a NY-killzone displacement/expansion that sweeps
the manipulation extreme and leaves Fair Value Gaps behind — so that the plays
have something real to detect. Backtest numbers on this feed are a *plumbing
check*, not evidence. Point --data at your own MES/MNQ 1m CSV for anything real.

Outputs (America/New_York semantics, stored as UTC):
    mes_1m.csv   ES/MES-like, ~5000 handle
    mnq_1m.csv   NQ/MNQ-like, correlated (for SMT divergence tests)
"""
from __future__ import annotations

import argparse
import numpy as np
import pandas as pd

NY = "America/New_York"


def _session_vol(hour: int, minute: int) -> float:
    """Relative volatility multiplier across the ET clock (killzone-aware)."""
    t = hour + minute / 60.0
    if 2 <= t < 5:      # London killzone
        return 1.4
    if 7 <= t < 11:     # NY AM killzone + Silver Bullet
        return 1.7
    if 13.5 <= t < 16:  # NY PM
        return 1.2
    if 20 <= t or t < 2:  # Asia — quiet accumulation
        return 0.6
    return 0.9          # lunch / off-hours


def generate(days: int, seed: int, start: str, base_price: float,
             tick: float, daily_atr: float) -> pd.DataFrame:
    rng = np.random.default_rng(seed)

    # Weekday session timestamps: CME-ish near-24h, 18:00 ET -> next 17:00 ET.
    start_ts = pd.Timestamp(start, tz=NY)
    all_min = []
    d = start_ts.normalize()
    made = 0
    while made < days:
        if d.weekday() < 5:  # Mon–Fri sessions
            open_ts = d + pd.Timedelta(hours=18)  # Sunday-style 18:00 ET open
            rng_idx = pd.date_range(open_ts, periods=23 * 60, freq="1min", tz=NY)
            all_min.append(rng_idx)
            made += 1
        d = d + pd.Timedelta(days=1)
    index = all_min[0].append(all_min[1:]) if len(all_min) > 1 else all_min[0]

    n = len(index)
    per_min_sigma = daily_atr / np.sqrt(390) / base_price  # rough intraday scale

    # Per-day regime: a true daily direction, manipulated against first.
    session_id = np.array([ (ts - pd.Timedelta(hours=18)).normalize().value for ts in index ])
    close = np.empty(n)
    price = base_price
    day_dir = {}
    day_manip = {}

    hours = np.array([ts.hour for ts in index])
    minutes = np.array([ts.minute for ts in index])

    rets = np.empty(n)
    for i in range(n):
        sid = session_id[i]
        if sid not in day_dir:
            day_dir[sid] = rng.choice([-1.0, 1.0]) * rng.uniform(0.6, 1.4)
            day_manip[sid] = -np.sign(day_dir[sid])  # Judas pushes opposite first
        h, m = hours[i], minutes[i]
        vol = _session_vol(h, m)
        drift = 0.0
        # London killzone: manipulation leg (Judas) against the daily direction.
        if 2 <= h < 4:
            drift = day_manip[sid] * per_min_sigma * 0.9
        # NY AM: expansion in the true daily direction (creates displacement).
        elif 8 <= h < 11:
            drift = day_dir[sid] * per_min_sigma * 1.3
        noise = rng.normal(0.0, per_min_sigma * vol)
        rets[i] = drift + noise

    # Inject discrete displacement bursts inside the NY killzone to guarantee
    # Fair Value Gaps + market-structure shifts exist to be traded.
    for sid in np.unique(session_id):
        mask = (session_id == sid) & (hours >= 8) & (hours < 11)
        idxs = np.where(mask)[0]
        if len(idxs) < 10:
            continue
        n_bursts = rng.integers(1, 3)
        for _ in range(n_bursts):
            j = rng.choice(idxs[3:-3])
            burst = day_dir[sid] * per_min_sigma * rng.uniform(6, 10)
            rets[j] += burst  # a single fast candle -> imbalance / FVG

    log_price = np.log(base_price) + np.cumsum(rets)
    close = np.exp(log_price)

    # Build OHLC around the close path with realistic wicks.
    open_ = np.empty(n)
    high = np.empty(n)
    low = np.empty(n)
    open_[0] = base_price
    open_[1:] = close[:-1]
    body_hi = np.maximum(open_, close)
    body_lo = np.minimum(open_, close)
    wick = np.abs(rets) * close * rng.uniform(0.2, 0.8, n) + tick
    high = body_hi + np.abs(rng.normal(0, 1, n)) * wick * 0.5
    low = body_lo - np.abs(rng.normal(0, 1, n)) * wick * 0.5

    # Volume: killzone- and range-driven.
    rel_range = (high - low) / close
    base_vol = np.array([_session_vol(h, m) for h, m in zip(hours, minutes)])
    volume = (base_vol * 800 + rel_range / per_min_sigma * 400
              + rng.uniform(0, 200, n)).round()

    def snap(x):
        return np.round(x / tick) * tick

    df = pd.DataFrame({
        "open": snap(open_), "high": snap(high), "low": snap(low),
        "close": snap(close), "volume": volume,
    }, index=index)
    # Guard OHLC sanity.
    df["high"] = df[["open", "high", "close"]].max(axis=1)
    df["low"] = df[["open", "low", "close"]].min(axis=1)
    df.index = df.index.tz_convert("UTC")
    df.index.name = "timestamp"
    return df


def correlate(mes: pd.DataFrame, rho: float, seed: int, base_price: float,
              tick: float) -> pd.DataFrame:
    """Build a correlated instrument (NQ-like) from MES returns + idiosyncrasy."""
    rng = np.random.default_rng(seed)
    r = np.log(mes["close"]).diff().fillna(0.0).to_numpy()
    idio = rng.normal(0, r.std() * np.sqrt(max(0.0, 1 - rho * rho)), len(r))
    r2 = rho * r + idio * 1.15  # NQ slightly hotter beta
    log_price = np.log(base_price) + np.cumsum(r2)
    close = np.exp(log_price)
    open_ = np.empty_like(close)
    open_[0] = base_price
    open_[1:] = close[:-1]
    body_hi = np.maximum(open_, close)
    body_lo = np.minimum(open_, close)
    wick = np.abs(r2) * close * 0.5 + tick
    high = body_hi + np.abs(rng.normal(0, 1, len(r2))) * wick * 0.5
    low = body_lo - np.abs(rng.normal(0, 1, len(r2))) * wick * 0.5

    def snap(x):
        return np.round(x / tick) * tick

    out = pd.DataFrame({
        "open": snap(open_), "high": snap(high), "low": snap(low),
        "close": snap(close), "volume": mes["volume"].to_numpy(),
    }, index=mes.index)
    out["high"] = out[["open", "high", "close"]].max(axis=1)
    out["low"] = out[["open", "low", "close"]].min(axis=1)
    out.index.name = "timestamp"
    return out


def main():
    ap = argparse.ArgumentParser(description="generate synthetic 1m futures data")
    ap.add_argument("--days", type=int, default=120)
    ap.add_argument("--seed", type=int, default=7)
    ap.add_argument("--start", default="2024-01-02")
    ap.add_argument("--out-mes", default="mes_1m.csv")
    ap.add_argument("--out-mnq", default="mnq_1m.csv")
    args = ap.parse_args()

    mes = generate(args.days, args.seed, args.start, base_price=5000.0,
                   tick=0.25, daily_atr=55.0)
    mnq = correlate(mes, rho=0.85, seed=args.seed + 1, base_price=17500.0, tick=0.5)

    mes.to_csv(args.out_mes)
    mnq.to_csv(args.out_mnq)
    print(f"wrote {args.out_mes}  ({len(mes):,} bars)")
    print(f"wrote {args.out_mnq}  ({len(mnq):,} bars)")
    print(f"span: {mes.index[0]} -> {mes.index[-1]} UTC")


if __name__ == "__main__":
    main()

