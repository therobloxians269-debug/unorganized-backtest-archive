            if fill<0: continue
            for k in range(fill+1,n):
                last=T[k]>=FLAT or k==n-1
                hs=(L[k]<=stp) if dr==1 else (H[k]>=stp)
                ht=(H[k]>=tgt) if dr==1 else (L[k]<=tgt)
                if hs: px=stp-dr*TICK; why='stop'
                elif ht: px=tgt; why='tgt'
                elif last: px=C[k]; why='time'
                else: continue
                out.append(dict(day=day,side=side,pnl=dr*(px-lim)*pv-comm,
                                R=(dr*(px-lim)*pv-comm)/(risk*pv),why=why,risk=risk)); break
    return pd.DataFrame(out)
