"""
PING PONG — the user's spec, taken literally.

Two static boxes, drawn at 09:30 from pre-open information only, never moved:
    LOW  box = [ o930 - qb*ADR , o930 - qa*ADR ]
    HIGH box = [ o930 + qa*ADR , o930 + qb*ADR ]
Requirements he stated:
    1. BOTH boxes are touched at least once, essentially every day
    2. price ping-pongs between them
    3. they only break on trend days

(1) is fully controllable IF the fan is calibrated: the inner edge of the low box sits
at quantile qa of the low-travel distribution, so P(touched) = 1 - qa BY CONSTRUCTION.
The real question is the JOINT probability and the ORDER of the touches, which is what
decides whether a fade between them can actually be traded.
"""
import numpy as np, pandas as pd
from sklearn.linear_model import QuantileRegressor

PRE = ['f_onr', 'f_onlo', 'f_onhi', 'f_gap', 'f_pdr', 'f_dow']


def fit_pre(train, qs):
    X = train[PRE].values
    M = {}
    for side in ('lo', 'hi'):
        y = train[f'y_{side}'].values
        for q in qs:
            M[(side, q)] = QuantileRegressor(quantile=q, alpha=1e-4,
                                             solver='highs').fit(X, y)
    return M


def pred_pre(M, d, floor=0.02):
    X = d[PRE].values
    return {k: np.maximum(m.predict(X), floor) for k, m in M.items()}


def touch_stats(day, rth_by_day, M, qa, qb):
    """Measure touches, joint touches, and the ORDER in which the boxes are reached."""
    P = pred_pre(M, day)
    lo_in = day.o930.values - P[('lo', qa)] * day.ADR.values   # inner edge (nearer open)
    lo_out = day.o930.values - P[('lo', qb)] * day.ADR.values
    hi_in = day.o930.values + P[('hi', qa)] * day.ADR.values
    hi_out = day.o930.values + P[('hi', qb)] * day.ADR.values

    rows = []
    for i, (dd, row) in enumerate(day.iterrows()):
        b = rth_by_day.get(dd)
        if b is None:
            continue
        H, L, T = b['H'], b['L'], b['T']
        tl = np.flatnonzero(L <= lo_in[i])
        th = np.flatnonzero(H >= hi_in[i])
        got_l, got_h = len(tl) > 0, len(th) > 0
        rows.append(dict(day=dd, lo=got_l, hi=got_h, both=got_l and got_h,
                         t_lo=T[tl[0]] if got_l else np.nan,
                         t_hi=T[th[0]] if got_h else np.nan,
                         lo_first=(tl[0] < th[0]) if (got_l and got_h) else np.nan,
                         # did the OUTER edge hold? (i.e. box contained the extreme)
                         lo_held=row.lo >= lo_out[i], hi_held=row.hi <= hi_out[i]))
    return pd.DataFrame(rows), (lo_in, lo_out, hi_in, hi_out)

