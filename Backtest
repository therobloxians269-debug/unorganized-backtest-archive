    for i in range(1,n-2):
        if FLAT<=m[i]<1080: continue          # 16:59-18:00 closed; evening session tradable
        if ses[i] not in sessions: continue
        if not np.isfinite(sd[i]) or sd[i]<=0: continue
        if i-last < cooldown: continue
        up=c[i]>=vw[i]+k*sd[i] and c[i-1]<vw[i-1]+k*sd[i-1]
        dn=c[i]<=vw[i]-k*sd[i] and c[i-1]>vw[i-1]-k*sd[i-1]
        if not(up or dn): continue
        if not reentry:
            key=(day[i],1 if up else -1)
            if key in once: continue
