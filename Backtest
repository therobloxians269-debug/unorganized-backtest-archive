def events(df, side='hi'):
    rows=[]
    for d,b in df.groupby('day'):
        if len(b)<300: continue
        H=b['high'].values; L=b['low'].values; C=b['close'].values; O=b['open'].values
        V=b['volume'].values.astype(float); T=b['tod'].values; n=len(b)
        rng=H-L; rng[rng<=0]=np.nan
        # OHLCV buying-pressure proxy and its cumulative (CVD proxy)
        bp=(2*(C-L)/rng-1); bp=np.nan_to_num(bp)
        cvd=np.cumsum(bp*V)
        vma=pd.Series(V).rolling(30,min_periods=5).mean().shift(1).values
        run=np.maximum.accumulate(H) if side=='hi' else np.minimum.accumulate(L)
        px=H if side=='hi' else L
        newext=np.r_[True,(px[1:]>run[:-1]) if side=='hi' else (px[1:]<run[:-1])]
        idx=np.flatnonzero(newext); final=px.max() if side=='hi' else px.min()
        prev_v=np.nan; prev_cvd=np.nan; prev_px=np.nan; cnt=0
        for k in idx:
            cnt+=1
            w=(H[k]-max(O[k],C[k]))/rng[k] if side=='hi' else (min(O[k],C[k])-L[k])/rng[k]
            w=0.0 if not np.isfinite(w) else w
            vr=V[k]/vma[k] if np.isfinite(vma[k]) and vma[k]>0 else 1.0
            # volume of the last 5 bars vs the 30-bar norm (participation into the push)
            v5=V[max(0,k-4):k+1].sum()/(5*vma[k]) if np.isfinite(vma[k]) and vma[k]>0 else 1.0
            # EXHAUSTION: new extreme on LOWER volume than the previous new extreme
            vdiv = (V[k]/prev_v) if np.isfinite(prev_v) and prev_v>0 else 1.0
            # CVD DIVERGENCE: price makes a new extreme, cumulative pressure does not
            if np.isfinite(prev_cvd):
                cdiv = 1.0 if ((side=='hi' and cvd[k]<prev_cvd) or (side=='lo' and cvd[k]>prev_cvd)) else 0.0
            else: cdiv=0.0
            # climax: this bar's volume is a day-extreme
            vz = (V[k]-V[:k+1].mean())/(V[:k+1].std()+1e-9)
            rows.append(dict(day=d,k=k,tod=T[k],elapsed=(T[k]-570)/390.,
                             wick=w, vr=vr, v5=v5, vdiv=vdiv, cdiv=cdiv, vz=vz,
                             bp=bp[k], cnt=cnt,
                             is_ext=int(abs(px[k]-final)<1e-9)))
            prev_v=V[k]; prev_cvd=cvd[k]; prev_px=px[k]
    return pd.DataFrame(rows)

def auc(x,y):
    ok=np.isfinite(x); x,y=x[ok],y[ok].astype(bool)
    a=x[~y];b=x[y]
    if len(a)<20 or len(b)<20: return np.nan
    rk=pd.Series(np.concatenate([a,b])).rank().values
    return (rk[len(a):].sum()-len(b)*(len(b)+1)/2)/(len(a)*len(b))

for side in ['hi','lo']:
