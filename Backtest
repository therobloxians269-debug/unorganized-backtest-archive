    yh, yl = r["ym_high"].values, r["ym_low"].values
    n = len(r)
    ph = np.zeros(n, bool); pl = np.zeros(n, bool)
    for i in range(L, n - R):
        if h[i] == max(h[i - L:i + R + 1]) and h[i] > h[i - 1] and h[i] > h[i + R]: ph[i] = True
        if l[i] == min(l[i - L:i + R + 1]) and l[i] < l[i - 1] and l[i] < l[i + R]: pl[i] = True
    bear = np.zeros(n, bool); bull = np.zeros(n, bool)
    last_ph = last_pl = -1; bear_inval = bull_inval = np.nan; bs = bl = False
    for j in range(n):
        k = j - R
        if k >= 0 and ph[k]: last_ph = k
        if k >= 0 and pl[k]: last_pl = k
        if bs and c[j] > bear_inval: bs = False
        if bl and c[j] < bull_inval: bl = False
        if last_ph >= 0 and j > last_ph and h[j] > h[last_ph]:
            if (eh[j] <= eh[last_ph]) or (yh[j] <= yh[last_ph]): bs = True; bear_inval = h[j]
        if last_pl >= 0 and j > last_pl and l[j] < l[last_pl]:
            if (el[j] >= el[last_pl]) or (yl[j] >= yl[last_pl]): bl = True; bull_inval = l[j]
        bear[j] = bs; bull[j] = bl
    out = pd.DataFrame({f"cbear{tf}": bear, f"cbull{tf}": bull},
                       index=r.index + pd.Timedelta(minutes=tf))
    return out.reindex(df.index.union(out.index)).ffill().reindex(df.index).fillna(False)


def precompute(df):
    P = {}
    c = df["c"]; lr = np.log(c).diff().replace([np.inf, -np.inf], np.nan)
    eslr = np.log(df["es_close"]).diff().replace([np.inf, -np.inf], np.nan)
    P["rv60"] = lr.rolling(60, min_periods=40).std().values
    P["rv390"] = lr.rolling(390, min_periods=250).std().values
    P["rv1440"] = lr.rolling(1440, min_periods=900).std().values
    P["rv7800"] = lr.rolling(7800, min_periods=4000).std().values
    P["corr390"] = lr.rolling(390, min_periods=250).corr(eslr).values
    P["corr1440"] = lr.rolling(1440, min_periods=900).corr(eslr).values
    tr = pd.concat([df["h"] - df["l"], (df["h"] - c.shift()).abs(),
                    (df["l"] - c.shift()).abs()], axis=1).max(axis=1)
    P["atr30c"] = tr.rolling(30, min_periods=20).mean().values
    P["atr390c"] = tr.rolling(390, min_periods=250).mean().values
    smt = pd.DataFrame(index=df.index)
    for tf in (90, 240, 1440, 10080):
        smt = smt.join(causal_smt_state(df, tf))
    P["cbear"] = smt[[f"cbear{tf}" for tf in (90, 240, 1440, 10080)]].sum(axis=1).values.astype(float)
    P["cbull"] = smt[[f"cbull{tf}" for tf in (90, 240, 1440, 10080)]].sum(axis=1).values.astype(float)
    return P


def daily_table(df, min_bars=400):
    """RTH sessions 09:30 -> 16:59 (Apex-legal: flat by 16:59, no overnight)."""
    rth = df.between_time("09:30", "16:59")
    g = rth.groupby(rth.index.date)
    tab = pd.DataFrame({"o": g["o"].first(), "h": g["h"].max(), "l": g["l"].min(),
                        "c": g["c"].last(), "v": g["v"].sum(), "n": g.size()})
    tab["open_ts"] = g.apply(lambda x: x.index[0])
    tab["close_ts"] = g.apply(lambda x: x.index[-1])
    tab = tab[tab["n"] >= min_bars]
    tab["rng"] = tab["h"] - tab["l"]
    tab["er"] = (tab["c"] - tab["o"]).abs() / tab["rng"].replace(0, np.nan)
    tab["pos"] = (tab["c"] - tab["l"]) / tab["rng"].replace(0, np.nan)
    tab["open_pos"] = df.index.get_indexer(pd.DatetimeIndex(tab["open_ts"]))
    tab["close_pos"] = df.index.get_indexer(pd.DatetimeIndex(tab["close_ts"]))
    return tab.reset_index(drop=True)


FEAT_CORE = ["gap", "gap_abs", "on_rng", "on_er", "on_pos", "on_vol",
             "pd_er", "pd_er3", "pd_er5", "pd_rng", "pd_rng5", "pd_pos",
             "pd_ret", "pd_ret_abs", "d3_ret", "rv_ratio", "rv_ratio2",
             "rv_lvl", "corr390", "corr1440", "atr_ratio",
             "ssmt_bear", "ssmt_bull", "ssmt_net",
             "dow1", "dow2", "dow3", "dow4"]
FEAT_OR = ["or_rng", "or_er", "or_pos", "or_vol", "or_vs_on", "or_vs_pd"]


def build_features(df, P, tab, or_min=30):
    """One row per session. Everything strictly knowable at 09:30+or_min."""
    o = df["o"].values; h = df["h"].values; l = df["l"].values
    c = df["c"].values; v = df["v"].values; idx = df.index
    dclose = tab["close_pos"].values; dopen = tab["open_pos"].values
    drng = tab["rng"].values; der = tab["er"].values; dpos = tab["pos"].values
    dc = tab["c"].values; do = tab["o"].values
    anchor_pos = dopen.astype(int); anchor_ts = pd.DatetimeIndex(tab["open_ts"])
    rows = []
    for i, (p, ts) in enumerate(zip(anchor_pos, anchor_ts)):
        f = {}
        pm = p - 1
        if pm < 1: rows.append(None); continue
        k = int(np.searchsorted(dclose, pm, side="right")) - 1
        if k < 21: rows.append(None); continue
        atr_d = np.nanmean(drng[k - 19:k + 1])
        if not np.isfinite(atr_d) or atr_d <= 0: rows.append(None); continue
        a = int(dclose[k]) + 1; b = p
        if b - a < 30: rows.append(None); continue
        onh = h[a:b].max(); onl = l[a:b].min(); ono = o[a]; onc = c[b - 1]
        onr = onh - onl
        f["gap"] = (o[p] - dc[k]) / atr_d
        f["gap_abs"] = abs(f["gap"])
        f["on_rng"] = onr / atr_d
        f["on_er"] = abs(onc - ono) / onr if onr > 0 else np.nan
        f["on_pos"] = (onc - onl) / onr if onr > 0 else np.nan
        onv = v[a:b].sum(); prev_onv = []
        for j in range(1, 11):
            kk = k - j
            if kk < 1: break
            aa = int(dclose[kk]) + 1; bb = int(dopen[kk + 1])
            if bb > aa: prev_onv.append(v[aa:bb].sum())
        f["on_vol"] = onv / np.mean(prev_onv) if prev_onv else np.nan
        f["pd_er"] = der[k]; f["pd_er3"] = np.nanmean(der[k - 2:k + 1])
        f["pd_er5"] = np.nanmean(der[k - 4:k + 1])
        f["pd_rng"] = drng[k] / atr_d
        f["pd_rng5"] = np.nanmean(drng[k - 4:k + 1]) / atr_d
        f["pd_pos"] = dpos[k]
        f["pd_ret"] = (dc[k] - do[k]) / atr_d
        f["pd_ret_abs"] = abs(f["pd_ret"])
        f["d3_ret"] = (dc[k] - dc[k - 3]) / atr_d
        rv60 = P["rv60"][pm]; rv390 = P["rv390"][pm]
        rv1440 = P["rv1440"][pm]; rv7800 = P["rv7800"][pm]
        f["rv_ratio"] = rv60 / rv390 if rv390 and np.isfinite(rv390) else np.nan
        f["rv_ratio2"] = rv390 / rv7800 if rv7800 and np.isfinite(rv7800) else np.nan
        f["rv_lvl"] = rv1440 / rv7800 if rv7800 and np.isfinite(rv7800) else np.nan
        f["corr390"] = P["corr390"][pm]; f["corr1440"] = P["corr1440"][pm]
        a30 = P["atr30c"][pm]; a390 = P["atr390c"][pm]
        f["atr_ratio"] = a30 / a390 if a390 and np.isfinite(a390) else np.nan
        f["ssmt_bear"] = P["cbear"][pm]; f["ssmt_bull"] = P["cbull"][pm]
        f["ssmt_net"] = f["ssmt_bull"] - f["ssmt_bear"]
        dw = ts.weekday()
        for q in range(1, 5): f[f"dow{q}"] = 1.0 if dw == q else 0.0
        e = p + or_min
        if e > len(c): rows.append(None); continue
        if (idx[e - 1] - ts).total_seconds() > (or_min + 5) * 60: rows.append(None); continue
        orh = h[p:e].max(); orl = l[p:e].min(); orr = orh - orl
        f["or_rng"] = orr / atr_d
        f["or_er"] = abs(c[e - 1] - o[p]) / orr if orr > 0 else np.nan
        f["or_pos"] = (c[e - 1] - orl) / orr if orr > 0 else np.nan
        orv = v[p:e].sum(); povs = []
        for j in range(1, 11):
            kk = k - j + 1
            if kk < 1 or kk >= len(tab): break
            pp = int(dopen[kk]); povs.append(v[pp:pp + or_min].sum())
        f["or_vol"] = orv / np.mean(povs) if povs else np.nan
        f["or_vs_on"] = orr / onr if onr > 0 else np.nan
        f["or_vs_pd"] = orr / drng[k] if drng[k] > 0 else np.nan
        f["atr_d"] = atr_d
        rows.append(f)
    cols = FEAT_CORE + FEAT_OR + ["atr_d"]
    out = pd.DataFrame([r if r is not None else {cc: np.nan for cc in cols} for r in rows],
                       columns=cols)
    out["valid"] = [r is not None for r in rows]
    out["date"] = pd.DatetimeIndex(tab["open_ts"]).date
    out["open_ts"] = pd.DatetimeIndex(tab["open_ts"])
    out["posA"] = anchor_pos
    out["close_pos"] = tab["close_pos"].values.astype(int)
    return out


def label_er(df, p0, p1):
    h = df["h"].values; l = df["l"].values; o = df["o"].values; c = df["c"].values
    hi = h[p0:p1 + 1].max(); lo = l[p0:p1 + 1].min()
    rng = hi - lo
    if rng <= 0: return np.nan
    return abs(c[p1] - o[p0]) / rng


