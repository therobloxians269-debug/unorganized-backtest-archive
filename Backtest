RTH_OPEN = 9 * 60 + 30          # 570
FLAT_TOD = 16 * 60 + 59         # 1019


# ============================================================ causal feature builders
# Each function takes the raw 1-min frame and returns a numpy array aligned to df.index
# where element t uses ONLY bars with index <= t.  This is the property the audit checks.

def f_tr(df):
    pc = df["c"].shift(1)
    return np.maximum(df["h"] - df["l"],
                      np.maximum((df["h"] - pc).abs(), (df["l"] - pc).abs()))


def f_atr(df, w):
    """Wilder-free simple ATR of 1-min TR over w bars ENDING AT t (inclusive).
    TR[t] uses h[t],l[t],c[t-1] -> all known at the close of bar t."""
    return f_tr(df).rolling(w, min_periods=max(5, w // 2)).mean()


def f_don_hi(df, n):
    """Highest high of the n bars ENDING AT t-1 (excludes bar t)."""
    return df["h"].rolling(n, min_periods=n).max().shift(1)


def f_don_lo(df, n):
    return df["l"].rolling(n, min_periods=n).min().shift(1)


def f_trail_hi(df, n):
    """Highest high of n bars ending at t INCLUSIVE (used as a trail level for bar t+1)."""
    return df["h"].rolling(n, min_periods=1).max()


def f_trail_lo(df, n):
    return df["l"].rolling(n, min_periods=1).min()


def f_ema(df, span):
    return df["c"].ewm(span=span, adjust=False, min_periods=span).mean()


def f_ret(df, n):
    return df["c"] - df["c"].shift(n)


# ---------------------------------------------------------------- per-day reactive gate
def build_open_drive(df, probe_min, dthr, erthr, atr):
    """REACTIVE trend-day detector.
    At clock time RTH_OPEN+probe_min ('probe bar') of each day-cycle, measure
        drive = (c_probe - o_0930) / atr_probe
        er    = |c_probe - o_0930| / sum(|1-min close changes| over the window)
    If |drive| >= dthr and er >= erthr the day is flagged a trend day in sign(drive).
    The flag is broadcast ONLY to bars at or after the probe bar -> causal.
    Returns int8 array in {-1,0,+1}.
    """
    tod = (df.index.hour * 60 + df.index.minute).to_numpy()
    day = pd.factorize(df["daycycle"].astype(str))[0]
    c = df["c"].to_numpy(); o = df["o"].to_numpy()
    n = len(df)
    gate = np.zeros(n, np.int8)
    pos = np.arange(n)
    t = pd.DataFrame({"day": day, "pos": pos, "tod": tod})
    oi = t[t.tod == RTH_OPEN].groupby("day")["pos"].min()
    pi = t[t.tod == RTH_OPEN + probe_min].groupby("day")["pos"].min()
    endi = t.groupby("day")["pos"].max()
    common = pi.index.intersection(oi.index)
    if len(common) == 0:
        return gate
    pi = pi.loc[common].to_numpy(); oi2 = oi.loc[common].to_numpy()
    ee = endi.loc[common].to_numpy()
    cum_abs = np.cumsum(np.abs(np.diff(c, prepend=c[0])))
    a = atr[pi]
    move = c[pi] - o[oi2]
    path = cum_abs[pi] - cum_abs[oi2]
    with np.errstate(invalid="ignore", divide="ignore"):
        drive = move / a
        er = np.where(path > 0, np.abs(move) / path, 0.0)
    good = np.isfinite(drive) & (np.abs(drive) >= dthr) & (er >= erthr) & (pi > oi2)
    s = np.where(move > 0, 1, -1).astype(np.int8)
    for k in np.where(good)[0]:
        gate[pi[k]: ee[k] + 1] = s[k]
    return gate


# ============================================================================== engine
@njit(cache=True)
def _sim(o, h, l, c, day, tod, flatidx,
         sig, stop_pts, atr_e,
         tp_R, trail_mult, trail_lo, trail_hi, use_dtrail,
         be_at_R, time_stop, max_td, ent_lo, ent_hi,
         pv, comm, slip,
         out_ei, out_xi, out_dir, out_R, out_mfe, out_mae, out_pnl, out_xtype):
    n = len(o)
    k = 0
    i = 0
    cur_day = -1
    td = 0
    while i < n - 1:
        if day[i] != cur_day:
            cur_day = day[i]
            td = 0
        s = sig[i]
        if s == 0 or td >= max_td:
            i += 1
            continue
        if tod[i] < ent_lo or tod[i] > ent_hi:
            i += 1
            continue
        j = i + 1
        fl = flatidx[j]
        if fl < 0 or j > fl or day[j] != day[i]:
            i += 1
            continue
        sp = stop_pts[i]
        if not (sp > 0.0) or not np.isfinite(sp):
            i += 1
            continue
        d = 1.0 if s > 0 else -1.0
        ep = o[j] + d * slip
        cur_stop = ep - d * sp
        tgt = ep + d * tp_R * sp if tp_R > 0.0 else 0.0
        ae = atr_e[i]
        run_ext = ep
        mfe = 0.0
        mae = 0.0
        be_done = False
        xi = -1
        xp = 0.0
        xt = 0                                  # 0 flat,1 stop,2 target,3 time
        kk = j
        while kk <= fl:
            # excursions
            if d > 0:
                up = h[kk] - ep
                dn = ep - l[kk]
            else:
                up = ep - l[kk]
                dn = h[kk] - ep
            if up > mfe:
                mfe = up
            if dn > mae:
                mae = dn
            # stop first (conservative when both touch in one bar)
            if d > 0:
                if l[kk] <= cur_stop:
                    xi = kk; xp = cur_stop - slip; xt = 1; break
                if tp_R > 0.0 and h[kk] >= tgt:
                    xi = kk; xp = tgt; xt = 2; break
            else:
                if h[kk] >= cur_stop:
                    xi = kk; xp = cur_stop + slip; xt = 1; break
                if tp_R > 0.0 and l[kk] <= tgt:
                    xi = kk; xp = tgt; xt = 2; break
            # time stop
            if time_stop > 0 and (kk - j) >= time_stop:
                xi = kk; xp = c[kk] - d * slip; xt = 3; break
            # ---- update trailing logic for the NEXT bar (uses bar kk, closed) ----
            if d > 0:
                if h[kk] > run_ext:
                    run_ext = h[kk]
            else:
                if l[kk] < run_ext:
                    run_ext = l[kk]
            if be_at_R > 0.0 and (not be_done) and mfe >= be_at_R * sp:
                nb = ep
                if d > 0:
                    if nb > cur_stop:
                        cur_stop = nb
                else:
                    if nb < cur_stop:
                        cur_stop = nb
                be_done = True
            if trail_mult > 0.0 and np.isfinite(ae) and ae > 0.0:
                if d > 0:
                    ns = run_ext - trail_mult * ae
                    if ns > cur_stop:
                        cur_stop = ns
                else:
                    ns = run_ext + trail_mult * ae
                    if ns < cur_stop:
                        cur_stop = ns
            if use_dtrail == 1:
                if d > 0:
                    ns = trail_lo[kk]
                    if ns > cur_stop and ns < c[kk]:
                        cur_stop = ns
                else:
                    ns = trail_hi[kk]
                    if ns < cur_stop and ns > c[kk]:
                        cur_stop = ns
            kk += 1
        if xi < 0:
            xi = fl
            xp = c[fl] - d * slip
            xt = 0
        gross = (xp - ep) * d * pv
        pnl = gross - comm
        R = pnl / (sp * pv)
        out_ei[k] = j
        out_xi[k] = xi
        out_dir[k] = s
        out_R[k] = R
        out_mfe[k] = mfe / sp
        out_mae[k] = mae / sp
        out_pnl[k] = pnl
        out_xtype[k] = xt
        k += 1
        td += 1
        i = xi if xi > i else i + 1
    return k


def run_trades(D, sig, stop_pts, cfg):
    n = D["n"]
    cap = n // 3 + 16
    ei = np.zeros(cap, np.int64); xi = np.zeros(cap, np.int64)
    dr = np.zeros(cap, np.int8); R = np.zeros(cap); mfe = np.zeros(cap)
    mae = np.zeros(cap); pnl = np.zeros(cap); xt = np.zeros(cap, np.int8)
    tl = cfg.get("trail_lo_arr")
    th = cfg.get("trail_hi_arr")
    if tl is None:
        tl = np.zeros(n); th = np.zeros(n)
    k = _sim(D["o"], D["h"], D["l"], D["c"], D["day"], D["tod"], D["flat"],
             sig.astype(np.int8), stop_pts.astype(np.float64), cfg["atr_e"],
             float(cfg.get("tp_R", 0.0)), float(cfg.get("trail_mult", 0.0)),
             tl, th, int(cfg.get("use_dtrail", 0)),
             float(cfg.get("be_at_R", 0.0)), int(cfg.get("time_stop", 0)),
             int(cfg.get("max_td", 99)), int(cfg.get("ent_lo", 0)), int(cfg.get("ent_hi", 1439)),
             D["pv"], D["comm"], D["slip"],
             ei, xi, dr, R, mfe, mae, pnl, xt)
    return dict(ei=ei[:k], xi=xi[:k], dir=dr[:k], R=R[:k], mfe=mfe[:k],
                mae=mae[:k], pnl=pnl[:k], xt=xt[:k], n=k)


# ============================================================================ metrics
def stats(T, D, label=""):
    k = T["n"]
    if k == 0:
        return dict(label=label, n=0, avgR=0.0, dpt=0.0, wr=0.0, tpd=0.0,
                    drop3=0.0, tot=0.0, maxdd=0.0, pf=0.0, medmfe=0.0,
                    dd_micro=0.0, dpt_micro=0.0, tR=0.0)
    R = T["R"]; pnl = T["pnl"]
    order = np.argsort(R)
    d3 = R[order[:-3]].mean() if k > 3 else float("nan")
    eq = np.cumsum(pnl)
    dd = float(np.max(np.maximum.accumulate(np.concatenate([[0.0], eq])) -
                      np.concatenate([[0.0], eq])))
    g = pnl[pnl > 0].sum(); b = -pnl[pnl < 0].sum()
    micro = 1.0 if D["pv"] <= 2.0 else 10.0        # NQ pnl / 10 = 1 MNQ micro
    return dict(label=label, n=int(k),
                avgR=float(R.mean()), dpt=float(pnl.mean()),
                wr=float((R > 0).mean()), tpd=float(k / D["ndays"]),
                drop3=float(d3), tot=float(pnl.sum()), maxdd=dd,
                dd_micro=dd / micro, dpt_micro=float(pnl.mean()) / micro,
                pf=float(g / b) if b > 0 else float("inf"),
                medmfe=float(np.median(T["mfe"])),
                tR=float(R.mean() / (R.std(ddof=1) / np.sqrt(k))) if k > 2 and R.std() > 0 else 0.0)


def fmt(s):
    return (f"{s['label']:<10s} n={s['n']:5d} tpd={s['tpd']:5.2f} avgR={s['avgR']:+.4f} "
            f"$/tr(1micro)={s['dpt_micro']:+7.2f} wr={s['wr']*100:4.1f}% "
            f"drop3={s['drop3']:+.4f} DD1micro=${s['dd_micro']:6.0f} "
            f"PF={s['pf']:.2f} t={s['tR']:+.2f}")


# ============================================================================ loading
def load(path, name, lo=None, hi=None):
    df = pd.read_parquet(path)
    if lo is not None:
        df = df[df.index >= lo]
    if hi is not None:
        df = df[df.index < hi]
    return df


def prep(df, name):
    df = df.copy()
    idx = df.index
    n = len(df)
    tod = (idx.hour * 60 + idx.minute).to_numpy(np.int32)
    day = pd.factorize(df["daycycle"].astype(str))[0].astype(np.int64)
    ok = tod <= FLAT_TOD
    pos = np.arange(n)
    tmp = pd.DataFrame({"day": day, "pos": pos, "ok": ok})
    lastok = tmp[tmp.ok].groupby("day")["pos"].max()
    flat = tmp["day"].map(lastok).fillna(-1).to_numpy(np.int64)
    ck = COST["MNQ" if name.startswith("MNQ") else "NQ"]
    D = dict(name=name, df=df, n=n,
             o=df["o"].to_numpy(np.float64), h=df["h"].to_numpy(np.float64),
             l=df["l"].to_numpy(np.float64), c=df["c"].to_numpy(np.float64),
             tod=tod.astype(np.int32), day=day, flat=flat,
             ndays=int(pd.Series(day).nunique()),
             pv=ck["pv"], comm=ck["comm"], slip=ck["slip"], idx=idx)
    return D


def build_features(df, atrs=(15, 30, 60), dons=(15, 30, 45, 60, 90, 120, 180, 240),
                   trails=(20, 30, 45, 60, 90), emas=(20, 40, 60, 120), rets=(15, 30, 60, 120)):
    F = {}
    for w in atrs:
        F[f"atr{w}"] = f_atr(df, w).to_numpy(np.float64)
    for nn in dons:
        F[f"dhi{nn}"] = f_don_hi(df, nn).to_numpy(np.float64)
        F[f"dlo{nn}"] = f_don_lo(df, nn).to_numpy(np.float64)
    for nn in trails:
        F[f"thi{nn}"] = f_trail_hi(df, nn).to_numpy(np.float64)
        F[f"tlo{nn}"] = f_trail_lo(df, nn).to_numpy(np.float64)
    for sp in emas:
        F[f"ema{sp}"] = f_ema(df, sp).to_numpy(np.float64)
    for nn in rets:
        F[f"ret{nn}"] = f_ret(df, nn).to_numpy(np.float64)
    return F


# ============================================================== signal constructors
def sig_don(F, D, N, gate=None, dirmode="both"):
    hi = F[f"dhi{N}"]; lo = F[f"dlo{N}"]; c = D["c"]
    s = np.zeros(D["n"], np.int8)
    s[c > hi] = 1
    s[c < lo] = -1
    if dirmode == "long":
        s[s < 0] = 0
    elif dirmode == "short":
        s[s > 0] = 0
    if gate is not None:
        s = np.where(s == gate, s, 0).astype(np.int8)
    return s


def sig_tsm(F, D, N, k, aw, gate=None, dirmode="both"):
    r = F[f"ret{N}"]; a = F[f"atr{aw}"]
    s = np.zeros(D["n"], np.int8)
    thr = k * a
    s[r > thr] = 1
    s[r < -thr] = -1
    if dirmode == "long":
        s[s < 0] = 0
    elif dirmode == "short":
        s[s > 0] = 0
    if gate is not None:
        s = np.where(s == gate, s, 0).astype(np.int8)
    return s


def sig_pbk(F, D, fast, slow, depth, aw, gate=None, dirmode="both"):
    """Trend = ema_fast vs ema_slow AND ema_fast rising.
    Pullback = bar's LOW came within `depth`*ATR of ema_fast (or below it) while the
    bar CLOSED back above ema_fast -> resumption tick."""
    ef = F[f"ema{fast}"]; es = F[f"ema{slow}"]; a = F[f"atr{aw}"]
    c = D["c"]; h = D["h"]; l = D["l"]
    ef_prev = np.concatenate([[np.nan], ef[:-1]])
    up = (ef > es) & (ef > ef_prev)
    dn = (ef < es) & (ef < ef_prev)
    tol = depth * a
    s = np.zeros(D["n"], np.int8)
    s[up & (l <= ef + tol) & (c > ef)] = 1
    s[dn & (h >= ef - tol) & (c < ef)] = -1
    if dirmode == "long":
        s[s < 0] = 0
    elif dirmode == "short":
        s[s > 0] = 0
    if gate is not None:
        s = np.where(s == gate, s, 0).astype(np.int8)
    return s


# ================================================================= lookahead audit
def truncation_audit(df, ntest=120, seed=0):
    """Recompute every feature on df.iloc[:t+1] and compare the LAST element with the
    element at t from the full-history computation.  Any mismatch => the full-history
    version saw the future."""
    rng = np.random.default_rng(seed)
    lo = 1200
    ts = rng.integers(lo, len(df) - 5, ntest)
    builders = {}
    for w in (15, 30, 60):
        builders[f"atr{w}"] = (lambda d, w=w: f_atr(d, w))
    for nn in (15, 60, 180):
        builders[f"dhi{nn}"] = (lambda d, nn=nn: f_don_hi(d, nn))
        builders[f"dlo{nn}"] = (lambda d, nn=nn: f_don_lo(d, nn))
    for nn in (30, 60):
        builders[f"thi{nn}"] = (lambda d, nn=nn: f_trail_hi(d, nn))
        builders[f"tlo{nn}"] = (lambda d, nn=nn: f_trail_lo(d, nn))
    for sp in (20, 60, 120):
        builders[f"ema{sp}"] = (lambda d, sp=sp: f_ema(d, sp))
    for nn in (15, 60):
        builders[f"ret{nn}"] = (lambda d, nn=nn: f_ret(d, nn))
    full = {k: fn(df).to_numpy(np.float64) for k, fn in builders.items()}
    bad = 0; checked = 0
    worst = {}
    for t in ts:
        sub = df.iloc[: t + 1]
        for k, fn in builders.items():
            v = fn(sub).to_numpy(np.float64)[-1]
            fv = full[k][t]
            checked += 1
            if np.isnan(v) and np.isnan(fv):
                continue
            if not np.isfinite(v) or not np.isfinite(fv) or abs(v - fv) > 1e-9 * max(1.0, abs(fv)):
                bad += 1
                worst[k] = worst.get(k, 0) + 1
    return checked, bad, worst


def gate_audit(df, atr, probe_min=30, dthr=0.5, erthr=0.35, ntest=40, seed=1):
    """Same truncation logic for the reactive opening-drive gate."""
    full = build_open_drive(df, probe_min, dthr, erthr, atr)
    rng = np.random.default_rng(seed)
    tod = (df.index.hour * 60 + df.index.minute).to_numpy()
    cand = np.where((tod >= RTH_OPEN + probe_min) & (np.arange(len(df)) > 5000))[0]
    ts = rng.choice(cand, size=min(ntest, len(cand)), replace=False)
    bad = 0
    for t in ts:
        sub = df.iloc[: t + 1]
        v = build_open_drive(sub, probe_min, dthr, erthr, atr[: t + 1])[-1]
        if v != full[t]:
            bad += 1
    return len(ts), bad


def provided_atr_audit(df):
    """Structural check that the parquet's own atr60 is shifted (not reading its own hour).
    Under a correct .shift(1) build, atr60 must be CONSTANT within each clock hour."""
    g = df.groupby([df.index.floor("h")])["atr60"].nunique()
    return float((g <= 1).mean()), int((g > 1).sum())


# ==================================================================== MFE reporting
def mfe_report(T, tag):
    if T["n"] == 0:
        print(f"  {tag}: no trades"); return
    m = T["mfe"]; R = T["R"]
    qs = np.percentile(m, [50, 75, 90])
    print(f"  {tag}: n={T['n']:5d} avgR={R.mean():+.4f} MFE(R) med={qs[0]:.2f} "
          f"p75={qs[1]:.2f} p90={qs[2]:.2f} meanMFE={m.mean():.2f} | reach1R={np.mean(m>=1)*100:4.1f}% "
          f"2R={np.mean(m>=2)*100:4.1f}% 3R={np.mean(m>=3)*100:4.1f}% "
          f"| MAEmed={np.median(T['mae']):.2f}")


# ======================================================================== placebo
def placebo(D, F, sig, stop_pts, cfg, seeds=8, lo=120, hi=1440):
    """Shift every real entry signal forward by U(lo,hi) MINUTES (=rows, 1-min data),
    keep direction and identical exit logic; stop distance recomputed from the causal
    ATR at the placebo bar (same rule as real)."""
    n = D["n"]
    idxs = np.where(sig != 0)[0]
    res = []
    aw = cfg["stop_aw"]; sm = cfg["stop_mult"]
    a = F[f"atr{aw}"]
    for sd in range(seeds):
        rng = np.random.default_rng(1000 + sd)
        sh = rng.integers(lo, hi + 1, len(idxs))
        tgt = idxs + sh
        tgt = tgt[tgt < n - 2]
        ps = np.zeros(n, np.int8)
        # keep original direction of the source signal
        src = idxs[: len(tgt)] if len(tgt) == len(idxs) else idxs[np.isin(idxs + sh, tgt)]
        good = (idxs + sh) < (n - 2)
        ps[idxs[good] + sh[good]] = sig[idxs[good]]
        sp = sm * a
        T = run_trades(D, ps, sp, cfg)
        res.append(T)
    return res


