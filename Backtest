"""
gap_fill_audit.py — adversarial causal re-audit of 'gap-fill-morning'.

Rule (as specified):
  Fade days gapping > 0.75xATR vs prior RTH close.
  Enter 10:00 ET open toward full fill (target = prior RTH close).
  Stop = 0.5xATR beyond the session (09:30) open.
  Force-exit at 16:00 (last RTH 5min bar close).
  Decision made at 09:55 (all inputs known by 09:30) -> causal.

Paranoia switches:
  * ATR = 14-day simple ATR of prior COMPLETED RTH sessions only (no today).
  * Entry price = OPEN of the 10:00 bar (next-bar-open, no peek).
  * Intraday exits use exact STOP / TARGET fill prices (not bar close).
  * Same-bar ambiguity (bar range contains BOTH stop and target):
        assume STOP hit first  -> worst case, no favorable peek.
  * Entry bar itself is eligible for stop/target after its open.
  * Force-exit uses the close of the last RTH bar (15:55->16:00).
"""
import sys, json
import numpy as np, pandas as pd
sys.path.insert(0, '/Users/kaveh/ict_engine')
import microbt as M

NY   = "America/New_York"
PARQ = '/Users/kaveh/omni_x/es_front_2017_24h_1m.parquet'
MES  = 5.0
RT   = 2.5
GAP_K  = 0.75
STOP_K = 0.5
SPLIT  = '2021-06-01'

df = M.load(PARQ, tf='5min')
et  = df.index.tz_convert(NY)
mins = et.hour*60 + et.minute
day  = et.normalize()
o = df['open'].to_numpy(); h = df['high'].to_numpy()
l = df['low'].to_numpy();  c = df['close'].to_numpy()
n = len(df)
is_rth = (mins >= 570) & (mins < 960)

# ---- per-day RTH bar index lists ----
sess = {}
for i in range(n):
    if is_rth[i]:
        sess.setdefault(day[i], []).append(i)
days = sorted(sess.keys())

# ---- daily RTH OHLC for ATR ----
d_open, d_high, d_low, d_close = {}, {}, {}, {}
for dkey, idxs in sess.items():
    d_open[dkey]  = o[idxs[0]]
    d_close[dkey] = c[idxs[-1]]
    d_high[dkey]  = h[idxs].max()
    d_low[dkey]   = l[idxs].min()

# True Range per day (needs prior close)
tr = {}
for k in range(1, len(days)):
    d0, dp = days[k], days[k-1]
    pc = d_close[dp]
    tr[d0] = max(d_high[d0]-d_low[d0], abs(d_high[d0]-pc), abs(d_low[d0]-pc))

# ATR14 available at day t = mean TR of the 14 prior COMPLETED days (strictly < t)
ATRN = 14
atr = {}
tr_days = [d for d in days if d in tr]
for k in range(len(days)):
    dt = days[k]
    prior_trs = [tr[days[j]] for j in range(k) if days[j] in tr]
    if len(prior_trs) >= ATRN:
        atr[dt] = float(np.mean(prior_trs[-ATRN:]))

# ---- simulate ----
rows = []          # (entry_ts, pnl, direction, outcome)
diag = dict(gapup=0, gapdn=0, stop=0, target=0, forced=0)
for k in range(1, len(days)):
    dt, dp = days[k], days[k-1]
    if dt not in atr: continue
    A  = atr[dt]
    pc = d_close[dp]           # prior RTH close (target)
    idxs = sess[dt]
    op = o[idxs[0]]            # today's 09:30 session open (known 09:30)
    gap = op - pc
    if abs(gap) <= GAP_K * A:  # no qualifying gap
        continue
    # find 10:00 entry bar (min == 600) within this session
    entry = None
    for j in idxs:
        if mins[j] == 600:
            entry = j; break
    if entry is None:          # session missing 10:00 bar
        continue
    if gap > 0:                # gap UP -> fade short toward prior close
        d = -1; tgt = pc; stop = op + STOP_K * A; diag['gapup'] += 1
    else:                      # gap DOWN -> fade long toward prior close
        d = +1; tgt = pc; stop = op - STOP_K * A; diag['gapdn'] += 1
    entry_px = o[entry]        # next-bar open, no peek

    exit_px = None; outcome = None
    for j in idxs:
        if j < entry: continue
        hi, lo = h[j], l[j]
        if d == +1:            # long: stop below, target above
            hit_stop = lo <= stop
            hit_tgt  = hi >= tgt
        else:                  # short: stop above, target below
            hit_stop = hi >= stop
            hit_tgt  = lo <= tgt
        if hit_stop and hit_tgt:      # worst case: stop first
            exit_px = stop; outcome = 'stop'; break
        if hit_stop:
            exit_px = stop; outcome = 'stop'; break
        if hit_tgt:
            exit_px = tgt;  outcome = 'target'; break
    if exit_px is None:               # force exit at 16:00 (last RTH bar close)
        exit_px = c[idxs[-1]]; outcome = 'forced'
    diag[outcome] += 1
    pnl = d * (exit_px - entry_px) * MES - RT
    rows.append((df.index[entry], pnl, d, outcome))

# ---- stats (mirror microbt.evaluate) ----
t = pd.DataFrame(rows, columns=['t','pnl','d','oc']).sort_values('t').reset_index(drop=True)
p = t['pnl'].to_numpy()
capital = 1000.0
eq = capital + np.cumsum(p)
peak = np.maximum.accumulate(eq); mdd = float(-(eq-peak).min())
yrs = max((t['t'].iloc[-1]-t['t'].iloc[0]).days/365.25, 0.25)
ann = float(p.sum()/yrs); tpy = len(p)/yrs
ann_sharpe = float(p.mean()/p.std()*np.sqrt(tpy)) if p.std()>0 else 0.0
cut = pd.Timestamp(SPLIT, tz='UTC')
def sub(m):
    x = t[m]['pnl']
    if len(x) < 5: return None
    return dict(n=int(len(x)), exp=round(float(x.mean()),2),
                t=round(float(x.mean()/x.std()*np.sqrt(len(x))),2) if x.std()>0 else 0.0)
IS = sub(t['t']<cut); OOS = sub(t['t']>=cut)
res = dict(name='gap-fill-morning[re-audit]', trades=int(len(p)),
           win=round(float((p>0).mean()),3), exp=round(float(p.mean()),2),
           total=round(float(p.sum()),0), ann=round(ann,0), ann_pct=round(ann/capital*100,1),
           maxDD=round(mdd,0), calmar=round(ann/mdd,2) if mdd>0 else 0.0,
           skew=round(float(pd.Series(p).skew()),2), ann_sharpe=round(ann_sharpe,2),
           ruin=bool((eq<=0).any()), end_equity=round(float(eq[-1]),0), IS=IS, OOS=OOS)
print(json.dumps(res, default=str, indent=2))
print("DIAG", diag)
print("OUTCOME counts:", t['oc'].value_counts().to_dict())
# outcome-conditional exp
for oc in ['stop','target','forced']:
    xx = t[t['oc']==oc]['pnl']
    if len(xx): print(f"  {oc:7} n={len(xx):4d} exp=${xx.mean():+8.2f}")

