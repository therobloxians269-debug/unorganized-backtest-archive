"""
from __future__ import annotations
import re
import numpy as np
import pandas as pd
import databento as db

OHLCV = "/Users/kaveh/Downloads/GLBX-20260607-YKKXM4QJ9A/glbx-mdp3-20100606-20260606.ohlcv-1m.dbn.zst"
PUB = pd.Timestamp("2018-07-01")          # Gao et al. JFE publication ~mid-2018
OUTRIGHT = re.compile(r"^ES[FGHJKMNQUVXZ]\d$")   # ESM6 etc; excludes spreads (have '-')

# ---- MES retail cost model (index points per round-turn) ----
PT = 5.0                                    # $ per index point, MES
FEES_RT = 1.78                              # Tradovate free + CME micro + NFA, round-turn $
SLIP_TICK = 1.25                            # $ per tick (0.25 pt)
SLIP_BASE_RT = 2 * SLIP_TICK               # 1 tick entry + 1 tick exit  ($2.50)
SLIP_2X_RT = 4 * SLIP_TICK                 # stress: 2 ticks each side    ($5.00)
COST_BASE_PT = (FEES_RT + SLIP_BASE_RT) / PT   # ~0.856 pt
COST_2X_PT = (FEES_RT + SLIP_2X_RT) / PT       # ~1.356 pt


def load_front_month_sessions() -> pd.DataFrame:
    """Return one row per trading day with the front-month RTH anchor prices (ET)."""
    print("Loading DBN (this is the big step)...", flush=True)
    df = db.DBNStore.from_file(OHLCV).to_df()
    print(f"  raw rows: {len(df):,}  cols: {list(df.columns)}", flush=True)

    if "symbol" not in df.columns:
        raise RuntimeError("no symbol column; need symbology mapping")

    # outrights only (drop calendar spreads like ESH6-ESU6)
    df = df[df["symbol"].str.match(OUTRIGHT)]
    print(f"  outright rows: {len(df):,}", flush=True)

    # ts_event is the index (UTC). Convert to New York (DST-aware).
    idx = df.index
    if idx.tz is None:
        idx = idx.tz_localize("UTC")
    et = idx.tz_convert("America/New_York")
    df = df.assign(et=et)
    df["date"] = df["et"].dt.normalize().dt.tz_localize(None)
    df["hm"] = df["et"].dt.strftime("%H:%M")

    # keep RTH 09:30..15:59 (bar opens); 15:59 bar close == 16:00 price
    rth = df[(df["et"].dt.time >= pd.Timestamp("09:30").time()) &
             (df["et"].dt.time <= pd.Timestamp("15:59").time())]
    print(f"  RTH rows: {len(rth):,}", flush=True)

    # front month = instrument with the most RTH volume that day
    dayvol = rth.groupby(["date", "symbol"])["volume"].sum().reset_index()
    front = dayvol.sort_values("volume").groupby("date").tail(1)[["date", "symbol"]]
    front = front.rename(columns={"symbol": "front"})
    rth = rth.merge(front, on="date")
    rth = rth[rth["symbol"] == rth["front"]]                       # front-month bars only
    print(f"  front-month RTH rows: {len(rth):,}", flush=True)

    # pivot to anchor bars per day
    g = rth.set_index(["date", "hm"])
    def at(hm, field):
        s = g.xs(hm, level="hm")[field]
        return s
    out = pd.DataFrame({
        "front":      front.set_index("date")["front"],
        "open0930":   at("09:30", "open"),
        "close0959":  at("09:59", "close"),
        "open1530":   at("15:30", "open"),
        "close1559":  at("15:59", "close"),
        "vol":        rth.groupby("date")["volume"].sum(),
    }).dropna(subset=["open0930", "close0959", "open1530", "close1559"]).reset_index()

    # prev close from the SAME contract (per-contract shift) -> clean overnight, no roll jump
    c1559 = rth[rth["hm"] == "15:59"][["date", "symbol", "close"]].copy()
    c1559 = c1559.sort_values(["symbol", "date"])
    c1559["prevclose"] = c1559.groupby("symbol")["close"].shift(1)
    out = out.merge(
        c1559[["date", "symbol", "prevclose"]].rename(columns={"symbol": "front"}),
        on=["date", "front"], how="left")
    return out


def block_bootstrap_sharpe(x: np.ndarray, block=10, reps=2000, ppy=252, seed=1):
    """Circular block bootstrap -> (sharpe, p(mean>0), 95% CI on sharpe)."""
    rng = np.random.default_rng(seed)
    n = len(x)
    nb = int(np.ceil(n / block))
    sh = np.empty(reps)
    means = np.empty(reps)
    for i in range(reps):
        starts = rng.integers(0, n, nb)
        idx = (starts[:, None] + np.arange(block)[None, :]).ravel() % n
        s = x[idx][:n]
        sd = s.std(ddof=1)
        sh[i] = (s.mean() / sd * np.sqrt(ppy)) if sd > 0 else 0.0
        means[i] = s.mean()
    base_sh = x.mean() / x.std(ddof=1) * np.sqrt(ppy)
    return base_sh, float((means <= 0).mean()), (np.percentile(sh, 2.5), np.percentile(sh, 97.5))


def hac_tstat(y, x, lags=10):
    """OLS slope of y~x with Newey-West HAC t-stat. Returns (beta, t, r2)."""
    x = np.asarray(x, float); y = np.asarray(y, float)
    X = np.column_stack([np.ones_like(x), x])
    b, *_ = np.linalg.lstsq(X, y, rcond=None)
    resid = y - X @ b
    n, k = X.shape
    XtX_inv = np.linalg.inv(X.T @ X)
    S = (X * resid[:, None])
    cov = S.T @ S
    for L in range(1, lags + 1):
        w = 1 - L / (lags + 1)
        G = S[L:].T @ S[:-L]
        cov += w * (G + G.T)
    V = XtX_inv @ cov @ XtX_inv
    t = b[1] / np.sqrt(V[1, 1])
    r2 = 1 - resid.var() / y.var()
    return b[1], t, r2


def report_block(name, d, pred_col):
    """Run sign-strategy + regression for a predictor column on subframe d."""
    d = d.dropna(subset=[pred_col, "target_ret", "target_pts"])
    if len(d) < 50:
        print(f"  [{name}] too few obs ({len(d)})"); return
    pos = np.sign(d[pred_col].values)
    pnl = pos * d["target_pts"].values                          # gross points/day
    net = pnl - COST_BASE_PT
    net2 = pnl - COST_2X_PT
    beta, t, r2 = hac_tstat(d["target_ret"].values, d[pred_col].values)
    sh_g, p_g, ci_g = block_bootstrap_sharpe(pnl)
    sh_n, p_n, ci_n = block_bootstrap_sharpe(net)
    wins = pnl > 0
    pf = pnl[wins].sum() / -pnl[~wins].sum() if (~wins).any() else np.inf
    pf_n = net[net > 0].sum() / -net[net < 0].sum() if (net < 0).any() else np.inf
    print(f"\n  [{name}]  N={len(d)}  predictor={pred_col}")
    print(f"    regression target_ret ~ {pred_col}:  beta={beta:+.3f}  HAC t={t:+.2f}  R2={r2*100:.2f}%")
    print(f"    GROSS  exp={pnl.mean():+.3f} pt/trade  Sharpe={sh_g:.2f} (95%CI {ci_g[0]:.2f}..{ci_g[1]:.2f})"
          f"  p(mean>0)={p_g:.3f}  win%={wins.mean()*100:.1f}  PF={pf:.2f}")
    print(f"    NET 1x exp={net.mean():+.3f} pt/trade  Sharpe={sh_n:.2f} (95%CI {ci_n[0]:.2f}..{ci_n[1]:.2f})"
          f"  p(mean>0)={p_n:.3f}  PF={pf_n:.2f}   [cost {COST_BASE_PT:.3f} pt]")
    print(f"    NET 2x exp={net2.mean():+.3f} pt/trade  Sharpe={block_bootstrap_sharpe(net2)[0]:.2f}"
          f"   [cost {COST_2X_PT:.3f} pt]")
    return {"N": len(d), "gross_exp": pnl.mean(), "net_exp": net.mean(),
            "net_pts_year": net.mean() * 252, "gross_pts_year": pnl.mean() * 252,
            "sharpe_net": sh_n, "t": t}


def account_economics(label, capital, net_pts_year):
    """Translate per-contract net pts/yr into account-level return for 1..N contracts."""
    print(f"\n  --- {label} account: ${capital:,} ---")
    # contracts the account can run within a 30% DD budget, ~2% risk/trade at ~8pt adverse close
    # (illustrative; real sizing in M-stage). $1k -> 1 lot; $5k -> up to ~5 lots.
