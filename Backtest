    n = len(g)
    idx = []
    while len(idx) < k:
        s = rng.integers(0, n)
        idx.extend(range(s, min(s + block, n)))
    idx = np.array(idx[:k])
    bal, floor, peak = start, start - dd, start
    for j, i in enumerate(idx):
        risk = rp[i] * MNQ_PT * contracts
        cost = COST_PTS * MNQ_PT * contracts
        if bal - mae[i] * risk - cost <= floor:
