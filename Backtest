"""Cascade backtest: measure each layer of the setup separately."""
from __future__ import annotations
import numpy as np
import pandas as pd

from qtlib import (NY, NQ_TICK, COST_PTS_NQ, COST_PTS_MNQ,
                   resample, ssmt, cisd, add_true_opens)

MANIP_END = 12 * 60      # manipulation must be confirmed by 12:00
ENTRY_END = 15 * 60      # no new entries after 15:00
FLAT_BY   = 16 * 60      # time-stop
TARGETS   = (1.0, 2.0, 3.0)


def _stamp(b: pd.DataFrame) -> pd.DataFrame:
    b = b.copy()
    b["sdate"] = (b.index + pd.Timedelta(hours=6)).date
    b["tmin"] = b.index.hour * 60 + b.index.minute
    return b


def prepare(df: pd.DataFrame) -> dict:
    """Precompute the higher-timeframe SSMT layers once for the whole sample."""
    b15 = _stamp(resample(df, "15min"))
    b5 = _stamp(resample(df, "5min"))
    out = {"b15": b15, "b5": b5}
    for side in ("short", "long"):
        out[f"s15_{side}"] = ssmt(b15, lookback=12, side=side)
        out[f"s5_{side}"] = ssmt(b5, lookback=12, side=side)
    return out


def run(df: pd.DataFrame, layers: str = "L1", side: str = "short",
        internal_open: str = "tny", pre: dict | None = None) -> pd.DataFrame:
    """Walk the cascade day by day and return one row per trade.

    layers: 'L1'      external SSMT only
            'L1L2'    + internal SSMT
            'L1L2L0'  + HTF bias (price vs true week open)
    internal_open: 'tny' | 'tny_alt' | 'tmso'  -- which true open gates the internal SSMT
    """
    pre = pre or prepare(df)
    b15, b5 = pre["b15"], pre["b5"]
    s15 = pre[f"s15_{side}"]
    s5 = pre[f"s5_{side}"]

    short = side == "short"
    trades = []

    for sdate, day in df.groupby("sdate", sort=True):
        day = day[day["tmin"] <= FLAT_BY]
        if len(day) < 200:
            continue
        tdo = day["tdo"].iloc[0]
        if not np.isfinite(tdo):
            continue

        # ---- L0: HTF bias from the true week open -------------------------
        if "L0" in layers:
            two = day["two"].iloc[0]
            if not np.isfinite(two):
                continue
            ref = day["nq_close"].iloc[0]
            if short and ref > two:      # want bearish HTF for shorts
                continue
            if (not short) and ref < two:
                continue

        # ---- L1: manipulation of TDO + external 15m SSMT -------------------
        d15 = b15[(b15["sdate"] == sdate) & (b15["tmin"] <= MANIP_END)]
        if d15.empty:
            continue
        sw = s15.reindex(d15.index).fillna(False).to_numpy()
        if short:
            swept = (d15["nq_high"] > tdo).to_numpy()
        else:
            swept = (d15["nq_low"] < tdo).to_numpy()
        ok = sw & swept
        if not ok.any():
            continue
        ext_time = d15.index[np.argmax(ok)]          # first confirmed manipulation

        # ---- L2: internal SSMT above/below TNY or TMSO ---------------------
        arm_time = ext_time
        if "L2" in layers:
            d5 = b5[(b5["sdate"] == sdate) & (b5.index > ext_time) &
                    (b5["tmin"] <= ENTRY_END)]
            if d5.empty:
                continue
            lvl = day[internal_open].reindex(d5.index, method="ffill")
            if lvl.isna().all():
                continue
            iw = s5.reindex(d5.index).fillna(False).to_numpy()
            if short:
                above = (d5["nq_high"].to_numpy() > lvl.to_numpy())
            else:
                above = (d5["nq_low"].to_numpy() < lvl.to_numpy())
            ok2 = iw & above
            if not ok2.any():
                continue
            arm_time = d5.index[np.argmax(ok2)]

        # ---- L3: 1m CISD entry --------------------------------------------
        m1 = day[(day.index > arm_time) & (day["tmin"] <= ENTRY_END)]
        if len(m1) < 5:
            continue
        trig = cisd(m1, side=side).to_numpy()
        if not trig.any():
            continue
        ti = int(np.argmax(trig))
        if ti + 1 >= len(m1):
            continue

        entry_bar = m1.index[ti + 1]
        entry = day["nq_open"].loc[entry_bar]        # next-bar open, no lookahead

        # ---- stop = the manipulation extreme -------------------------------
        upto = day[(day.index >= ext_time) & (day.index <= m1.index[ti])]
        if short:
            stop = upto["nq_high"].max() + NQ_TICK
            r_pts = stop - entry
        else:
            stop = upto["nq_low"].min() - NQ_TICK
            r_pts = entry - stop
        if not np.isfinite(r_pts) or r_pts <= NQ_TICK:
            continue

        # ---- simulate forward on 1m ----------------------------------------
        fwd = day[day.index >= entry_bar]
        hi = fwd["nq_high"].to_numpy()
        lo = fwd["nq_low"].to_numpy()

        row = {"sdate": sdate, "side": side, "entry_time": entry_bar,
               "entry": entry, "stop": stop, "r_pts": r_pts}

        for T in TARGETS:
            tgt = entry - T * r_pts if short else entry + T * r_pts
            hit_stop = (hi >= stop) if short else (lo <= stop)
            hit_tgt = (lo <= tgt) if short else (hi >= tgt)
            i_s = int(np.argmax(hit_stop)) if hit_stop.any() else 10**9
            i_t = int(np.argmax(hit_tgt)) if hit_tgt.any() else 10**9
            if i_s <= i_t:                        # same-bar tie -> stop first (conservative)
                gross, xi = -1.0, min(i_s, len(hi) - 1)
            elif i_t < i_s:
                gross, xi = T, min(i_t, len(hi) - 1)
            else:                                  # neither -> time stop at the close
                last = fwd["nq_close"].iloc[-1]
                gross = (entry - last) / r_pts if short else (last - entry) / r_pts
                xi = len(hi) - 1
            # max adverse excursion over the actual holding period (in R)
            adv = (hi[:xi + 1] - entry) if short else (entry - lo[:xi + 1])
            row[f"R{T:.0f}_gross"] = gross
            row[f"R{T:.0f}_mae"] = float(np.max(adv)) / r_pts if xi >= 0 else 0.0
            row[f"R{T:.0f}_net"] = gross - COST_PTS_NQ / r_pts
            row[f"R{T:.0f}_net_mnq"] = gross - COST_PTS_MNQ / r_pts
        trades.append(row)

    return pd.DataFrame(trades)


def summarise(tr: pd.DataFrame, label: str) -> dict:
    if tr.empty:
        return {"config": label, "n": 0}
    out = {"config": label, "n": len(tr), "r_pts_med": tr["r_pts"].median()}
    for T in TARGETS:
        g = tr[f"R{T:.0f}_gross"]
        net = tr[f"R{T:.0f}_net"]
        wr = (g > 0).mean()
        se = net.std(ddof=1) / np.sqrt(len(net)) if len(net) > 1 else np.nan
        out[f"{T:.0f}R_wr"] = wr
        out[f"{T:.0f}R_gross"] = g.mean()
        out[f"{T:.0f}R_net"] = net.mean()
        out[f"{T:.0f}R_t"] = net.mean() / se if se and se > 0 else np.nan
    return out

