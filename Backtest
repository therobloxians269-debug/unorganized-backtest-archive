SWEEP = [("eod", 0.0),
         ("chan", 2.0), ("chan", 3.0), ("chan", 4.0),
         ("be", 2.0), ("be", 3.0), ("be", 4.0),
         ("time", 6.0), ("time", 12.0), ("time", 24.0),
         ("target", 1.5), ("target", 2.0), ("target", 3.0)]
NEIGHBORS = {("chan", 2.0): [("chan", 3.0)], ("chan", 3.0): [("chan", 2.0), ("chan", 4.0)],
             ("chan", 4.0): [("chan", 3.0)],
             ("be", 2.0): [("be", 3.0)], ("be", 3.0): [("be", 2.0), ("be", 4.0)],
             ("be", 4.0): [("be", 3.0)],
             ("time", 6.0): [("time", 12.0)], ("time", 12.0): [("time", 6.0), ("time", 24.0)],
             ("time", 24.0): [("time", 12.0)],
             ("target", 1.5): [("target", 2.0)], ("target", 2.0): [("target", 1.5), ("target", 3.0)],
             ("target", 3.0): [("target", 2.0)],
