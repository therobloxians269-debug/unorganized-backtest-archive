#!/usr/bin/env python3
"""How can a $1,000 account EXPRESS the one surviving edge (f08: 20d Donchian long,
exit 10d-low or 20 sessions)?  MES overnight maintenance margin ~ $1,600-1,700 =>
full swing is NOT executable at $1k. Decompose the edge and price the alternatives:

  E1 FULL SWING   : hold 1 MES continuously while state=long (needs ~$2k equity)
  E2 DAY-ONLY     : while state=long, buy 09:30 open, sell 16:00 close, every session
                    (day margin ~$50, executable at $1k TODAY, pays 0.66pt RT/day)
  E3 NIGHT-ONLY   : informational decomposition (close->open while long) — where
                    does the drift actually live?

Everything net of house friction (market RT = 0.66 pt, $5/pt, 1 MES).
Windows: DEV <=2022-12-31, HOLDOUT >=2023-01-01. State machine identical to f08."""
import sys, datetime as dt
import numpy as np
sys.path.insert(0, "/Users/kaveh/mes_mim")
import omni2_lib as L
from omni2_lib import DPP

FRIC = 0.66
N, M, K = 20, 10, 20
DEV_END = dt.date(2022, 12, 31)

S = L.load()
dates = np.array([s["date"] for s in S])
o = np.array([s["o"][0] for s in S]); h = np.array([s["h"].max() for s in S])
l = np.array([s["l"].min() for s in S]); c = np.array([s["c"][-1] for s in S])
n = len(dates)

# ---- f08 state machine (identical semantics: exit check first, entry at close) ----
state = np.zeros(n, dtype=int)          # position held INTO the close of day t (after signals)
pos = 0; entry_i = -1
for t in range(N, n):
    exited = False
    if pos == 1:
        held = t - entry_i
        if c[t] < l[t - M:t].min() or held >= K or t == n - 1:
            pos = 0; exited = True
    if pos == 0 and not exited and t < n - 1 and c[t] > h[t - N:t].max():
        pos = 1; entry_i = t
    state[t] = pos

in_pos = state[:-1] == 1                 # held from close t -> through day t+1
nights = (o[1:] - c[:-1]) * in_pos       # overnight leg (close t -> open t+1)
days   = (c[1:] - o[1:]) * in_pos        # intraday leg  (open t+1 -> close t+1)
d2     = dates[1:]
hold_mask = d2 > DEV_END

def curve(pnl_pts, mask, label, fric_per_day=0.0, active=None):
    act = in_pos if active is None else active
    net = (pnl_pts - fric_per_day * act) * DPP
    x = net[mask]
    eq = np.cumsum(x); dd = float((eq - np.maximum.accumulate(eq)).min())
    tot = float(x.sum()); mar = tot / abs(dd) if dd < 0 else float("inf")
    yrs = np.array([d.year for d in d2[mask]])
    yearly = {int(y): round(float(x[yrs == y].sum())) for y in np.unique(yrs)}
    print(f"{label:34s} net ${tot:+8.0f}  maxDD ${dd:7.0f}  MAR {mar:5.2f}  " +
          " ".join(f"{y}:{v:+d}" for y, v in yearly.items()))
    return x, tot, dd

print(f"state=long on {in_pos.mean():.0%} of sessions ({int(in_pos.sum())} of {len(in_pos)})\n")
print("== DECOMPOSITION (no expression friction, where does the drift live?) ==")
for msk, w in ((~hold_mask, "DEV"), (hold_mask, "HOLDOUT")):
    print(f"-- {w}")
    curve(nights, msk, "  E3 overnight leg (close->open)")
    curve(days,   msk, "  intraday leg (open->close)")

print("\n== EXECUTABLE EXPRESSIONS, NET OF FRICTION ==")
print("-- E1 FULL SWING (0.66pt per ~17d round trip; needs ~$2k for overnight margin)")
# full swing net: nights+days, friction charged per trade ~= negligible daily; approx from f08 jsons
print("   (per f08 referee run: HOLDOUT net +$7,543  maxDD -$2,123  MAR 3.55, 26 trades)")
print("-- E2 DAY-ONLY at $1k (buy 09:30, sell 16:00 while long; 0.66pt friction EVERY day)")
e2_dev  = curve(days, ~hold_mask, "  E2 dev",     fric_per_day=FRIC)
e2_hold = curve(days,  hold_mask, "  E2 holdout", fric_per_day=FRIC)

# buy & hold benchmark, holdout
bh = (c[1:] - c[:-1]) * DPP
x = bh[hold_mask]; eq = np.cumsum(x); dd = (eq - np.maximum.accumulate(eq)).min()
print(f"\nbenchmark buy&hold 1 MES holdout:  net ${x.sum():+.0f}  maxDD ${dd:.0f}  MAR {x.sum()/abs(dd):.2f}")

# worst nights held by E1 (the risk E2 avoids entirely)
wn = np.sort(nights[hold_mask])[:5] * DPP
print(f"worst 5 overnight moves while long (holdout): {[round(v) for v in wn]}")

# MC: monthly bootstrap, E1 from $2000 (graduated) with $250 monthly breaker; E2 from $1000
def mc(day_usd, dts, start, breaker, n_iter=20000, months=36, seed=7):
    ym = np.array([d.year * 100 + d.month for d in dts])
    mp = np.array([day_usd[ym == k].sum() for k in np.unique(ym)])
    mp = np.where(mp < -breaker, -breaker, mp)         # breaker approximation at month level
    rng = np.random.default_rng(seed)
    under = ruin = 0; worst = np.empty(n_iter)
    for i in range(n_iter):
        seq = rng.choice(mp, size=months, replace=True)
        eq = start + np.cumsum(seq); mn = eq.min()
        worst[i] = mn - start; under += mn < start; ruin += mn <= 400
    print(f"   MC start ${start} breaker ${breaker}: P(dip<start) {under/n_iter:.1%}  "
          f"P(hit $400 floor) {ruin/n_iter:.1%}  median worst dip ${np.median(worst):.0f}  "
          f"p5 worst ${np.percentile(worst, 5):.0f}  E[3y] ${np.mean(mp)*months:+.0f}")

print("\n== SURVIVAL MC (holdout-era months only) ==")
full_day = (nights + days) * DPP - 0.20 * in_pos  # swing friction amortized ~0.04pt/day*5
print("E1 full swing from $2,000 (post-graduation):")
mc(full_day[hold_mask], d2[hold_mask], 2000, 250)
print("E2 day-only from $1,000:")
mc(e2_hold[0], d2[hold_mask], 1000, 150)

