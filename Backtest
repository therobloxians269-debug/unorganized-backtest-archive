#!/usr/bin/env python3
"""
FAMILY 6 : qt-open-drift
Quarterly-Theory TRUE-OPEN drift / fade / AMD-shape.

Sub-hypotheses tested (each independently, each reported separately):
  H1 DRIFT-TMSO : direction of first N min after a 90-min true open persists to quarter end
  H2 DRIFT-TSO  : same at the 6-hour session true open
  H3 DRIFT-TDO  : same at the 18:00 true day open
  H4 BIAS       : price above/below true open = directional bias for the remainder
  H5 FADE       : price extended X*ATR from a true open reverts to that open
  H6 AMD        : manipulation leg of quarter k predicts distribution leg of quarter k+1

Splits:  IS = NQ 2023-01-01..2024-12-31 | OOS1 = NQ 2025+ | OOS2 = MNQ 2026
Costs :  NQ  pv=20 comm $4.00 RT slip 0.25pt entry + 0.25pt stop-exit
         MNQ pv=2  comm $1.50 RT same slip
Apex  :  flat by 16:59 ET (= end of the 18:00-anchored daycycle), no overnight hold past that.

Usage:  python3 f6_qt-open-drift.py <stage>
        stages: audit | explore | amd | sweep | oos | final
"""
import sys, os, json, math, itertools
import numpy as np
import pandas as pd

DIR = os.path.dirname(os.path.abspath(__file__))
OUT = os.path.join(DIR, "f6_out")
os.makedirs(OUT, exist_ok=True)

# --------------------------------------------------------------------------------------
# LOADING
# --------------------------------------------------------------------------------------
_cache = {}


def load(name):
    if name in _cache:
        return _cache[name]
    df = pd.read_parquet(os.path.join(DIR, f"{name}_v6.parquet"))
    df = df.sort_index()
    _cache[name] = df
    return df


def splits():
    nq = load("nq")
    mnq = load("mnq")
    IS = nq[(nq.index >= "2023-01-01") & (nq.index < "2025-01-01")]
    OOS1 = nq[nq.index >= "2025-01-01"]
    OOS2 = mnq
    return {"IS": IS, "OOS1": OOS1, "OOS2": OOS2}


COST = {  # point_value, commission round-turn, slippage points one-way
    "IS":   dict(pv=20.0, comm=4.00, slip=0.25),
    "OOS1": dict(pv=20.0, comm=4.00, slip=0.25),
    "OOS2": dict(pv=2.00, comm=1.50, slip=0.25),
}
MICRO = dict(pv=2.0, comm=1.50, slip=0.25)  # for max-DD-on-1-micro reporting


# --------------------------------------------------------------------------------------
# FRAME  -> numpy bundle
# --------------------------------------------------------------------------------------
class Bundle:
    """Positional numpy view of one split. All arrays share the same 0..n-1 bar index."""

    def __init__(self, df, tag):
        self.tag = tag
        self.df = df
        self.n = len(df)
        self.o = df.o.to_numpy(float)
        self.h = df.h.to_numpy(float)
        self.l = df.l.to_numpy(float)
        self.c = df.c.to_numpy(float)
        self.ts = df.index.to_numpy()
        self.minute = (df.index.view("int64") // 60_000_000_000).astype(np.int64)  # abs minutes
        self.q90 = df.q90.to_numpy(np.int64)
        self.sess = df.sess.to_numpy(np.int64)
        self.mi = df.min_into_q90.to_numpy(np.int64)
        self.TDO = df.TDO.to_numpy(float)
        self.TSO = df.TSO.to_numpy(float)
        self.TMSO = df.TMSO.to_numpy(float)
        self.dhigh = df.dhigh.to_numpy(float)
        self.dlow = df.dlow.to_numpy(float)
        self.atr15 = df.atr15.to_numpy(float)
        self.atr30 = df.atr30.to_numpy(float)
        self.atr60 = df.atr60.to_numpy(float)
        dc = df.daycycle.astype(str)
        self.dc_codes, self.dc_uniq = pd.factorize(dc)
        self.ndays = len(self.dc_uniq)
        # last bar index of each daycycle (= forced flat bar, <=16:59 ET)
        self.dc_last = np.zeros(self.n, np.int64)
        idx = np.arange(self.n)
        last_per = pd.Series(idx).groupby(self.dc_codes).max().to_numpy()
        self.dc_last = last_per[self.dc_codes]
        # quarter (daycycle,q90) grouping
        qkey = self.dc_codes.astype(np.int64) * 100 + self.q90
        self.qcodes, _ = pd.factorize(qkey)
        qidx = pd.Series(idx)
        self.q_first = qidx.groupby(self.qcodes).min().to_numpy()[self.qcodes]
        self.q_last = qidx.groupby(self.qcodes).max().to_numpy()[self.qcodes]
        # session (daycycle,sess)
        skey = self.dc_codes.astype(np.int64) * 10 + self.sess
        self.scodes, _ = pd.factorize(skey)
        self.s_first = qidx.groupby(self.scodes).min().to_numpy()[self.scodes]
        self.s_last = qidx.groupby(self.scodes).max().to_numpy()[self.scodes]

    def hour_et(self):
        return self.df.index.hour.to_numpy()


def bundles():
    s = splits()
    return {k: Bundle(v, k) for k, v in s.items()}


# --------------------------------------------------------------------------------------
# TRADE SIMULATOR  (sequential, one position at a time)
# --------------------------------------------------------------------------------------
def simulate(B, ev_sig, ev_dir, ev_stop, ev_dead, cost, sequential=True,
             slip_on_time_exit=False, targ_mult=None):
    """
    ev_sig  : bar index of the SIGNAL bar. Entry is at open of ev_sig+1.
    ev_dir  : +1 long / -1 short
    ev_stop : stop distance in POINTS (risk unit R)
    ev_dead : bar index of the last bar we may hold (time exit at its close)
    targ_mult: if not None, target = targ_mult * stop distance (bracket). Else pure time exit.
    Returns DataFrame of trades.
    """
    pv, comm, slip = cost["pv"], cost["comm"], cost["slip"]
    h, l, o, c = B.h, B.l, B.o, B.c
    rows = []
    busy_until = -1
    order = np.argsort(ev_sig, kind="stable")
    for k in order:
        sg = int(ev_sig[k])
        ent = sg + 1
        if ent >= B.n:
            continue
        if sequential and ent <= busy_until:
            continue
        dead = int(min(ev_dead[k], B.dc_last[ent], B.n - 1))
        if dead < ent:
            continue
        d = int(ev_dir[k])
        S = float(ev_stop[k])
        if not np.isfinite(S) or S <= 0:
            continue
        px = o[ent] + d * slip                      # adverse entry slippage
        stop_px = px - d * S
        targ_px = px + d * S * targ_mult if targ_mult else None
        exit_i, exit_px, why = dead, c[dead], "time"
        seg = slice(ent, dead + 1)
        hi, lo = h[seg], l[seg]
        if d > 0:
            s_hit = lo <= stop_px
            t_hit = (hi >= targ_px) if targ_mult else np.zeros(len(hi), bool)
        else:
            s_hit = hi >= stop_px
            t_hit = (lo <= targ_px) if targ_mult else np.zeros(len(hi), bool)
        si = int(np.argmax(s_hit)) if s_hit.any() else 10**9
        ti = int(np.argmax(t_hit)) if t_hit.any() else 10**9
        if si <= ti and si < 10**9:                 # stop-first tie-break
            exit_i, exit_px, why = ent + si, stop_px - d * slip, "stop"
        elif ti < 10**9:
            exit_i, exit_px, why = ent + ti, targ_px, "targ"
        else:
            if slip_on_time_exit:
                exit_px = c[dead] - d * slip
        pts = d * (exit_px - px)
        dollars = pts * pv - comm
        rows.append((sg, ent, exit_i, d, S, px, exit_px, pts, dollars, dollars / (S * pv), why,
                     B.dc_codes[ent]))
        busy_until = exit_i
    tr = pd.DataFrame(rows, columns=["sig", "ent", "exi", "dir", "stop_pts", "entry_px",
                                     "exit_px", "pts", "dollars", "R", "why", "dc"])
    return tr


def stats(tr, B, cost=None):
    if len(tr) == 0:
        return dict(n=0, avgR=np.nan, dpt=np.nan, wr=np.nan, tpd=0.0, tot=0.0,
                    maxdd=np.nan, drop3=np.nan, pf=np.nan, tstat=np.nan)
    R = tr.R.to_numpy()
    eq = np.cumsum(tr.dollars.to_numpy())
    dd = float(np.max(np.maximum.accumulate(np.concatenate([[0.0], eq])) -
                      np.concatenate([[0.0], eq])))
    # 1-micro DD (recompute dollars with micro economics from the same point P&L)
    pv_ratio = MICRO["pv"] / cost["pv"] if cost else 1.0
    md = tr.pts.to_numpy() * MICRO["pv"] - MICRO["comm"]
    eqm = np.cumsum(md)
    ddm = float(np.max(np.maximum.accumulate(np.concatenate([[0.0], eqm])) -
                       np.concatenate([[0.0], eqm])))
    srt = np.sort(R)[::-1]
    drop3 = float(srt[3:].mean()) if len(R) > 3 else np.nan
    win = tr.dollars > 0
    gp = tr.dollars[win].sum()
    gl = -tr.dollars[~win].sum()
    return dict(n=int(len(tr)), avgR=float(R.mean()), dpt=float(tr.dollars.mean()),
                wr=float(win.mean()), tpd=float(len(tr) / B.ndays), tot=float(tr.dollars.sum()),
                maxdd=dd, maxdd_micro=ddm, drop3=drop3,
                pf=float(gp / gl) if gl > 0 else np.inf,
                tstat=float(R.mean() / R.std(ddof=1) * math.sqrt(len(R))) if len(R) > 2 else np.nan)


def fmt(s):
    return (f"n={s['n']:5d} tpd={s['tpd']:4.2f} avgR={s['avgR']:+.4f} $/t={s['dpt']:+8.2f} "
            f"wr={s['wr']:.3f} pf={s['pf']:.2f} t={s['tstat']:+.2f} dd${s['maxdd']:.0f} "
            f"ddmic${s.get('maxdd_micro',float('nan')):.0f} drop3={s['drop3']:+.4f}")


