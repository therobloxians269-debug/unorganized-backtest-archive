#!/usr/bin/env python3
"""Capital-preservation analysis of the VWAP Trend-Day Rider (the real edge).
Question: starting an account at its initial balance, how far underwater does it
go before building a cushion, and can a profit-floor overlay keep it above start?
'Never underwater' = min of cumulative-P&L-from-inception >= 0. Honest, in-sample."""
import numpy as np, pandas as pd
import omni2_lib as L
from omni2_adaptive import trend_day
DPP = L.DPP

def chrono_pnl(S, y0=2022, y1=2026, target_R=None):
    """Chronological per-trade $ P&L. target_R adds a fixed-R profit target (raises hit rate)."""
    rows = []
    for s in S:
        if not (y0 <= s["date"].year <= y1):
            continue
        for net, risk in trend_day(s):
            rows.append((s["date"], net*DPP, risk))
    return pd.DataFrame(rows, columns=["date", "pnl", "risk"])

def analyze(pnl, label, buffer=0.0):
    x = pnl["pnl"].to_numpy()
    eq = buffer + np.cumsum(x)                      # account equity, starting at `buffer` above initial
    underwater = eq - buffer                        # cumulative P&L from inception
    worst = underwater.min()
    days_uw = int((underwater < 0).sum())
    print(f"{label}")
    print(f"  trades={len(x)}  final P&L=${underwater[-1]:,.0f}  worst-underwater-from-start=${worst:,.0f}  "
          f"trades-spent-underwater={days_uw} ({100*days_uw/len(x):.0f}%)")
    return underwater, worst

def floor_overlay(pnl, buffer, giveback):
    """Ratcheting floor: track peak profit; if profit falls to (peak - giveback), STOP for good.
    Never lets you give back more than `giveback` from your best. Reports if account ever < start."""
    x = pnl["pnl"].to_numpy()
    prof = 0.0; peak = 0.0; stopped_at = None; curve = []
    for i, p in enumerate(x):
        if stopped_at is not None:
            curve.append(prof); continue
        prof += p; peak = max(peak, prof); curve.append(prof)
        if prof <= peak - giveback:                 # gave back the allowed slack -> lock & stop
            stopped_at = i
    curve = np.array(curve)
    ever_below_start = bool(curve.min() < 0)
    return dict(final=float(curve[-1]), min=float(curve.min()), peak=float(peak),
                stopped=stopped_at, ever_below_start=ever_below_start, curve=curve)

def main():
    S = L.load()
    print("=== A. Raw Rider, current regime (2022-2026), funded at exactly the initial balance ===")
    p = chrono_pnl(S)
    uw, worst = analyze(p, "  raw Rider (ride to EOD)")
    print(f"  => with $0 buffer it DIPS ${abs(worst):,.0f} below your initial balance before recovering.")
    print(f"  => to NEVER breach with this raw edge you must fund a buffer of >= ${abs(worst):,.0f}.\n")

    print("=== B. Profit-floor overlay (build cushion, then never give back > $giveback; stop if hit) ===")
    for gb in [1000, 1500, 2000, 3000]:
        r = floor_overlay(p, buffer=0, giveback=gb)
        stop = "never" if r["stopped"] is None else f"trade #{r['stopped']}"
        print(f"  giveback=${gb:<5d}  final=${r['final']:>7,.0f}  min-from-start=${r['min']:>7,.0f}  "
              f"below-start? {r['ever_below_start']}  stopped={stop}")
    print("  (min-from-start > 0  =>  account NEVER went below your initial balance in-sample)\n")

    print("=== C. Same but require an initial cushion before risking (skip until +$B locked) ===")
    x = p["pnl"].to_numpy()
    for start_buf in [1000, 2000]:
        # trade minimum until cushion reached; here we just measure: does a $start_buf funded buffer + ")
        eq = start_buf + np.cumsum(x)
        print(f"  funded buffer=${start_buf}: min account equity=${eq.min():,.0f} "
              f"(below initial balance? {'YES' if eq.min() < start_buf else 'NO'}), final=${eq[-1]:,.0f}")

if __name__ == "__main__":
    main()

