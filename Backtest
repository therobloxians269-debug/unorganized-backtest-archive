"""Rejection Blocks + session VWAP + Volume Profile (POC/VAH/VAL).
   RB gives a body-to-wick stop => tight risk => high RR to a VP/VWAP target."""
import pandas as pd, numpy as np, warnings; warnings.filterwarnings('ignore')

# ---------- Volume Profile (prior-day profile = causal reference for today) ----------
def vp_daily(df, bin_pts=2.0, va_frac=0.70):
    rows=[]
    for day, g in df.groupby('daycycle', sort=True):
        lo, hi = g['l'].min(), g['h'].max()
        if not np.isfinite(lo) or hi<=lo: continue
        edges=np.arange(lo, hi+bin_pts, bin_pts)
        if len(edges)<3: continue
        # spread each bar's volume evenly across the bins it spans
        vol=np.zeros(len(edges)-1)
        gl,gh,gv=g['l'].values,g['h'].values,g['v'].values
        for k in range(len(g)):
            a=np.searchsorted(edges,gl[k])-1; b=np.searchsorted(edges,gh[k])-1
            a=max(a,0); b=min(max(b,a),len(vol)-1)
            vol[a:b+1]+=gv[k]/(b-a+1)
        if vol.sum()<=0: continue
        c=(edges[:-1]+edges[1:])/2
        p=int(vol.argmax()); poc=c[p]
        tot=vol.sum(); acc=vol[p]; lo_i=hi_i=p
        while acc < va_frac*tot and (lo_i>0 or hi_i<len(vol)-1):
            dn = vol[lo_i-1] if lo_i>0 else -1
            up = vol[hi_i+1] if hi_i<len(vol)-1 else -1
            if up>=dn: hi_i+=1; acc+=vol[hi_i]
            else:      lo_i-=1; acc+=vol[lo_i]
        rows.append(dict(daycycle=day, poc=poc, val=c[lo_i], vah=c[hi_i], dhi=hi, dlo=lo))
    vp=pd.DataFrame(rows).set_index('daycycle')
    return vp.shift(1)          # <-- today references YESTERDAY's profile. causal.

# ---------- session VWAP (causal by construction) ----------
def vwap(df, anchor_min=570):
    mins=df.index.hour*60+df.index.minute
    key=df['daycycle'].astype(str)+'_'+(mins>=anchor_min).astype(int).astype(str)
    tp=(df['h']+df['l']+df['c'])/3; pv=tp*df['v']
    g=df.groupby(key)
    cv=g['v'].cumsum(); cpv=pv.groupby(key).cumsum()
    vw=cpv/cv.replace(0,np.nan)
    d2=((tp-vw)**2*df['v']).groupby(key).cumsum()/cv.replace(0,np.nan)
    sd=np.sqrt(d2.clip(lower=0))
    return vw, sd

# ---------- Rejection Blocks ----------
def rejection_blocks(df, tf=15, wick_mult=1.5, swing=2, atr_col='atr60', min_frac=0.15):
    """Bearish RB at a swing high whose upper wick dominates the body.
       Zone = [max(open,close), high].  Known at that bar's CLOSE."""
    r=df.resample(f'{tf}min',label='left',closed='left').agg(
        {'o':'first','h':'max','l':'min','c':'last'}).dropna()
    o,h,l,c=r['o'].values,r['h'].values,r['l'].values,r['c'].values
    t=r.index; n=len(r); out=[]
    body_hi=np.maximum(o,c); body_lo=np.minimum(o,c); body=np.abs(c-o)
    up_w=h-body_hi; dn_w=body_lo-l; rng=h-l
    for i in range(swing, n-swing):
        known=t[i+swing]+pd.Timedelta(minutes=tf)   # swing confirmed only after `swing` more bars close
        # bearish: swing high + dominant upper wick
        if h[i]==h[i-swing:i+swing+1].max() and up_w[i]>wick_mult*max(body[i],1e-9) \
           and rng[i]>0 and up_w[i]/rng[i]>=min_frac and h[i]>body_hi[i]:
            out.append((known, body_hi[i], h[i], -1))
        # bullish: swing low + dominant lower wick
        if l[i]==l[i-swing:i+swing+1].min() and dn_w[i]>wick_mult*max(body[i],1e-9) \
           and rng[i]>0 and dn_w[i]/rng[i]>=min_frac and l[i]<body_lo[i]:
            out.append((known, l[i], body_lo[i], 1))
    return pd.DataFrame(out, columns=['known','bot','top','dir'])

