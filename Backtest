"""
THE STRETCH — cross-market relative value. Our concept, readable, one trade a day.

THE READ
    "NQ is up 0.9% and ES is only up 0.2%. Tech has run way ahead of its normal beta
     today. That gap closes."

MECHANISM
    NQ and ES share the same macro driver and run ~93% correlated minute to minute
    (measured on this data: 0.925 NQ, 0.937 MNQ). Intraday they decouple on sector
    flow. Index arbitrage and cross-sector rebalancing pull them back toward their
    normal relationship. This is a RELATIVE bet: we are not forecasting the market,
    only that two things which move together keep moving together.

WHY IT IS A DIFFERENT KIND OF BET
    Every concept killed today was OUTRIGHT DIRECTION on one index — the single most
    competed trade in existence. A spread is a different and far less contested
    object. And entry stays clock-fixed, so the selection bug that killed TERMINUS
    and the VWAP lean cannot appear.

NOT SMT. The program already killed SMT divergence (a swing-point pattern; it came
back BACKWARDS on NQ-vs-ES and NQ-vs-YM). This is a continuous beta-adjusted spread
sampled at a fixed clock time. The 'go with' inverse is tested explicitly because
that is exactly where SMT landed.

CAUSALITY: beta and the normalising vol come from strictly PRIOR sessions. The
spread at time T uses only bars up to T.
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')

RTH0, RTH1 = 570, 960


def session_frames(d, min_bars=300):
    """RTH sessions carrying both legs. `d` must have close + es_close."""
    tod = d.index.hour * 60 + d.index.minute
    d = d.assign(tod=tod, rth=(tod >= RTH0) & (tod < RTH1), day=d.index.normalize())
    r = d[d.rth].dropna(subset=['close', 'es_close'])
    keep = r.groupby('day').size()
    keep = keep[keep >= min_bars].index
    r = r[r.day.isin(keep)]
    out = {}
    for dd, b in r.groupby('day'):
        out[dd] = dict(C=b.close.values, E=b.es_close.values, T=b.tod.values,
                       H=b.high.values, L=b.low.values, V=b.volume.values)
    return out


def rolling_beta(frames, win=20):
    """
    Beta of NQ log-returns on ES log-returns, from the trailing `win` sessions only.
    Session d never contributes to its own beta.
    """
    days = sorted(frames)
    xs, ys = {}, {}
    for dd in days:
        f = frames[dd]
        a = np.diff(np.log(f['C'])); b = np.diff(np.log(f['E']))
        m = np.isfinite(a) & np.isfinite(b)
        xs[dd], ys[dd] = b[m], a[m]
    beta = {}
    for i, dd in enumerate(days):
        if i < win:
            beta[dd] = np.nan
            continue
        prev = days[i - win:i]
        X = np.concatenate([xs[p] for p in prev]); Y = np.concatenate([ys[p] for p in prev])
        v = float(np.var(X))
        beta[dd] = float(np.cov(X, Y)[0, 1] / v) if v > 0 else np.nan
    return pd.Series(beta)


def spreads(frames, beta, checks=tuple(range(600, 931, 15))):
    """
    Spread path per session: how far NQ has run beyond beta x ES since the 09:30 open.
    Positive = NQ is RICH.
    """
    rows = []
    days = sorted(frames)
    for dd in days:
        bt = beta.get(dd, np.nan)
        if not np.isfinite(bt):
            continue
        f = frames[dd]
        C, E, T = f['C'], f['E'], f['T']
        if len(C) < 300:
            continue
        nq = np.log(C / C[0]); es = np.log(E / E[0])
        sp = nq - bt * es
        cl_sp = float(sp[-1]); cl_nq = float(nq[-1])
        for t in checks:
            k = int(np.searchsorted(T, t, side='right')) - 1
            if k < 20 or k >= len(C) - 15:
                continue
            rows.append(dict(day=dd, t=t, beta=bt,
                             sp=float(sp[k]), nq=float(nq[k]), es=float(es[k]),
                             px=float(C[k]),
                             # forward: how much of the stretch closes, and what the
                             # single NQ leg does, both to the RTH close
                             d_sp=cl_sp - float(sp[k]),
                             d_nq=cl_nq - float(nq[k])))
    return pd.DataFrame(rows)


def normalise(sd, win=20):
    """
    z-score the spread against how big it NORMALLY is by that time of day, using only
    prior sessions. Divergence naturally grows through the session, so an unnormalised
    threshold would just be a time-of-day filter.
    """
    sd = sd.sort_values(['t', 'day']).copy()
    sd['sd_t'] = (sd.groupby('t').sp
                    .transform(lambda s: s.shift(1).rolling(win, min_periods=10).std()))
    sd['z'] = sd.sp / sd.sd_t
    return sd.dropna(subset=['z'])


def dayt(x):
    x = np.asarray(x, dtype=float); x = x[np.isfinite(x)]
    if len(x) < 15:
        return np.nan, np.nan, len(x)
    return float(x.mean()), float(x.mean() / (x.std(ddof=1) / np.sqrt(len(x)))), len(x)


def buckets(sd, col='d_sp', by='z', q=5, sign=-1, label=''):
    """sign=-1 means FADE: profit when the spread closes back toward zero."""
    g = sd.dropna(subset=[by, col]).copy()
    g['b'] = pd.qcut(g[by], q, labels=False, duplicates='drop')
    print(f'\n  {label}   ({by} quantiles, outcome {col}, signed to FADE the stretch)')
    print(f'    {"bucket":<8}{"n":>6}{"med z":>9}{"mean":>11}{"t":>8}{"win%":>8}')
    for i in sorted(g.b.dropna().unique()):
        s = g[g.b == i]
        y = sign * np.sign(s[by]) * s[col]
