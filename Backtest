"""
structure.py — swings, Break of Structure (BOS), and Change of Character
(CHoCH / Market Structure Shift).

Discretionary read this encodes:
  * A *swing high* is a candle whose high is above `left` bars before and `right`
    bars after it; a *swing low* the mirror. Crucially a swing is only *confirmed*
    `right` bars later — the engine never uses a pivot before a live trader could.
  * BOS  = a close beyond the most recent protected swing *in the trend's
    direction* → trend continuation.
  * CHoCH = the first close beyond the opposing protected swing → the earliest
    structural sign of reversal. When that CHoCH is delivered by *displacement*
    (see imbalance.displacement_at) ICT calls it a Market Structure Shift (MSS);
    that upgrade is applied in models.py where FVG context is available.
"""
from __future__ import annotations

from dataclasses import dataclass
import numpy as np
import pandas as pd


@dataclass(frozen=True)
class Swing:
    idx: int           # bar index of the pivot
    price: float
    kind: str          # 'H' or 'L'
    confirm_idx: int   # first bar index at which the pivot is known


@dataclass(frozen=True)
class StructureEvent:
    idx: int           # bar at which the break confirmed (a close)
    kind: str          # 'BOS' or 'CHoCH'
    direction: int     # +1 bullish break, -1 bearish break
    level: float       # the swing price that was broken
    broken_idx: int    # bar index of the pivot that was broken
    opp_idx: int       # opposing protected pivot at time of break (stop reference)
    opp_price: float


def find_swings(df: pd.DataFrame, left: int = 2, right: int = 2) -> list[Swing]:
    """Symmetric-fractal swing highs/lows with causal confirmation."""
    high = df["high"].to_numpy()
    low = df["low"].to_numpy()
    n = len(df)
    swings: list[Swing] = []
    for i in range(left, n - right):
        wh = high[i - left:i + right + 1]
        wl = low[i - left:i + right + 1]
        c = left  # centre offset
        if high[i] == wh.max() and (wh[:c] < high[i]).all() and (wh[c + 1:] <= high[i]).all():
            swings.append(Swing(i, float(high[i]), "H", i + right))
        if low[i] == wl.min() and (wl[:c] > low[i]).all() and (wl[c + 1:] >= low[i]).all():
            swings.append(Swing(i, float(low[i]), "L", i + right))
    swings.sort(key=lambda s: (s.confirm_idx, s.idx))
    return swings


def track_structure(df: pd.DataFrame, swings: list[Swing]) -> list[StructureEvent]:
    """Walk bars causally and emit BOS / CHoCH events.

    A protected high/low is the most-recently-confirmed pivot of each kind. A
    close beyond a protected level fires a break; whether it is BOS or CHoCH
    depends on the prevailing trend at that moment.
    """
    close = df["close"].to_numpy()
    n = len(df)

    # Map confirm_idx -> list of swings known at that bar.
    by_confirm: dict[int, list[Swing]] = {}
    for s in swings:
        by_confirm.setdefault(s.confirm_idx, []).append(s)

    events: list[StructureEvent] = []
    prot_high: Swing | None = None
    prot_low: Swing | None = None
    trend = 0  # +1 up, -1 down, 0 undetermined
    high_broken = False
    low_broken = False

    for t in range(n):
        # 1) Absorb pivots that become known exactly at bar t.
        for s in by_confirm.get(t, []):
            if s.kind == "H":
                prot_high, high_broken = s, False
            else:
                prot_low, low_broken = s, False

        c = close[t]
        # 2) Bullish break of the protected high.
        if prot_high is not None and not high_broken and c > prot_high.price:
            kind = "BOS" if trend >= 0 else "CHoCH"
            opp = prot_low if prot_low is not None else prot_high
            events.append(StructureEvent(t, kind, +1, prot_high.price,
                                         prot_high.idx, opp.idx, opp.price))
            trend = +1
            high_broken = True
        # 3) Bearish break of the protected low.
        elif prot_low is not None and not low_broken and c < prot_low.price:
            kind = "BOS" if trend <= 0 else "CHoCH"
            opp = prot_high if prot_high is not None else prot_low
            events.append(StructureEvent(t, kind, -1, prot_low.price,
                                         prot_low.idx, opp.idx, opp.price))
            trend = -1
            low_broken = True

    return events


def swing_frame(swings: list[Swing]) -> pd.DataFrame:
    """Convenience table of swings for inspection/plotting."""
    return pd.DataFrame([s.__dict__ for s in swings])

