#!/usr/bin/env python3
"""
arranged.py -- a NOVEL ARRANGEMENT of known equity factors into one integrated book.
(verbatim per spec; logic unchanged)
"""
from __future__ import annotations
import numpy as np, math
from scipy.stats import norm
from equity_factors import (_z,_shift,_logret,_rollvol,sharpe,calmar,apply_costs,
                            gate_stream,build_book)

def market_state(prices,vol_win=21):
    r=np.nanmean(_logret(prices),1); mkt=np.cumprod(1+r); dd=mkt/np.maximum.accumulate(mkt)-1
    vol=np.array([np.nanstd(r[max(0,t-vol_win):t]) for t in range(len(r))])
    stressed=(dd<-0.10)&(vol>np.nanmedian(vol[vol>0]))
    g=np.where(stressed,0.4,1.0); g=np.roll(g,1); g[0]=1.0
    return g

def arranged_score(prices,w=(0.40,0.35,0.25)):
    lp=np.log(prices)
    value =-_z(_shift(lp,252)-_shift(lp,504))
    mom   = _z(_shift(lp,21)-_shift(lp,252))
    lowvol=-_z(_rollvol(prices))
    val_c = value*(0.5+0.5*norm.cdf(np.nan_to_num(mom)))
    g     = market_state(prices)[:,None]
    wv,wm,wd=w
    S=wv*np.nan_to_num(val_c)+g*wm*np.nan_to_num(mom)+wd*np.nan_to_num(lowvol); S[:504]=np.nan
    return S

def naive_score(prices,w=(0.40,0.35,0.25)):
    lp=np.log(prices); wv,wm,wd=w
    S=(wv*np.nan_to_num(-_z(_shift(lp,252)-_shift(lp,504)))
       +wm*np.nan_to_num(_z(_shift(lp,21)-_shift(lp,252)))
       +wd*np.nan_to_num(-_z(_rollvol(prices)))); S[:504]=np.nan
    return S

def build_book_dd(prices,score,target_vol=0.10/math.sqrt(252),vol_win=63,dd_cap=0.08,floor=0.4):
    port,W=build_book(prices,score,target_vol,vol_win)
    eq=np.cumsum(port); dd=eq-np.maximum.accumulate(eq)
    sc=np.clip(1+dd/dd_cap,floor,1.0); sc=np.roll(sc,1); sc[0]=1.0
    return port*sc,W

def _mdd(x): x=x[np.isfinite(x)]; e=np.cumsum(x); return (e-np.maximum.accumulate(e)).min()*100

def run_arranged(prices,dates,split,n_trials,bar=0.7,cost_bps=5.0):
    Sa=arranged_score(prices); Sn=naive_score(prices)
    _,Wa=build_book_dd(prices,Sa); _,Wn=build_book(prices,Sn)
    print(f"\n===== ARRANGEMENT vs NAIVE  (N={prices.shape[1]} names)  bar net Sharpe>={bar} =====")
    print("  naive additive book:");                       gate_stream("naive",prices,Wn,split,n_trials,bar,cost_bps)
    print("  ARRANGED (crash+trap control + DD throttle):"); ok,net=gate_stream("arranged",prices,Wa,split,n_trials,bar,cost_bps)
    na,_,_=apply_costs(prices,Wn); ar,_,_=apply_costs(prices,Wa)
    print(f"  maxDD: naive={_mdd(na):.1f}%  arranged={_mdd(ar):.1f}%   Calmar: naive={calmar(na):.2f} arranged={calmar(ar):.2f}")
    return ok

def _selftest():
    rng=np.random.default_rng(4); T,N=2600,400
    avol=rng.uniform(0.010,0.030,N); q=rng.normal(0,0.0012,N); q+=-0.0008*(avol-avol.mean())/avol.std()
    px=np.zeros((T,N)); px[0]=50
    for t in range(1,T):
        if   1380<=t<1410: r=-0.004+rng.normal(0,avol*1.5)
        elif 1410<=t<1445: r= 0.003-2.0*q+rng.normal(0,avol*1.5)
        else:              r= q+rng.normal(0,avol)
        px[t]=px[t-1]*np.exp(r)
    print("### SELFTEST: planted momentum+lowvol edge + engineered MOMENTUM CRASH (t~1400)")
    run_arranged(px,None,1800,n_trials=10)
    print("\n### NOISE control:")
    px0=np.zeros((T,N)); px0[0]=50
    for t in range(1,T): px0[t]=px0[t-1]*np.exp(rng.normal(0,avol))
    run_arranged(px0,None,1800,n_trials=10)

if __name__=="__main__":
    _selftest()

