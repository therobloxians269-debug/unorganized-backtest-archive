"""
microbt.py — a causal micro-account backtest harness for $1k MES strategies.

A strategy is any function that returns a list of (entry_bar, exit_bar, direction)
integer positions on a resampled ES frame. The harness enters at the entry bar's
OPEN (so the signal must be known at the prior close), exits at the exit bar's
CLOSE, charges real MES round-trip cost, sizes 1 micro, and scores everything the
way a $1k account actually lives or dies: dollar drawdown, ruin, Calmar, skew, OOS.
"""
from __future__ import annotations
import numpy as np, pandas as pd

NY = "America/New_York"
MES = 5.0          # $ per index point (micro E-mini S&P)
RT  = 2.5          # round-trip cost per contract: ~$0.62/side commission + ~1 tick slip

def load(path, start=None, end=None, tf="5min"):
    df = pd.read_parquet(path)
    tc = next(c for c in df.columns if c.lower() in ('ts_event','ts','timestamp','date','datetime'))
    df = df.rename(columns={tc:'ts'})
    df['ts'] = pd.to_datetime(df['ts'], utc=True)
    df = df.set_index('ts').sort_index()
    df = df[~df.index.duplicated(keep='last')]
    df = df[['open','high','low','close','volume']].astype(float)
    if start: df = df[df.index >= pd.Timestamp(start, tz='UTC')]
    if end:   df = df[df.index <= pd.Timestamp(end, tz='UTC')]
    if tf:
        df = (df.resample(tf, label='left', closed='left')
                .agg({'open':'first','high':'max','low':'min','close':'last','volume':'sum'})
                .dropna(subset=['open']))
    return df

def evaluate(df, trades, capital=1000.0, split='2021-06-01', name='strategy'):
    o = df['open'].to_numpy(); c = df['close'].to_numpy(); idx = df.index
    n = len(c); rows = []
    for e, x, d in trades:
        if e < 0 or x >= n or x < e or d == 0: continue
        pnl = d * (c[x] - o[e]) * MES - RT
        rows.append((idx[e], pnl))
    if not rows: return {'name':name, 'trades':0}
    t = pd.DataFrame(rows, columns=['t','pnl']).sort_values('t').reset_index(drop=True)
    p = t['pnl'].to_numpy()
    eq = capital + np.cumsum(p)
    peak = np.maximum.accumulate(eq); mdd = float(-(eq-peak).min())
    yrs = max((t['t'].iloc[-1]-t['t'].iloc[0]).days/365.25, 0.25)
    ann = float(p.sum()/yrs)
    tpy = len(p)/yrs
    ann_sharpe = float(p.mean()/p.std()*np.sqrt(tpy)) if p.std()>0 else 0.0
    cut = pd.Timestamp(split, tz='UTC')
    def sub(m):
        x = t[m]['pnl']
        if len(x) < 5: return None
        return dict(n=int(len(x)), exp=round(float(x.mean()),2),
                    t=round(float(x.mean()/x.std()*np.sqrt(len(x))),2) if x.std()>0 else 0.0)
    return dict(name=name, trades=int(len(p)), win=round(float((p>0).mean()),3),
                exp=round(float(p.mean()),2), total=round(float(p.sum()),0),
                ann=round(ann,0), ann_pct=round(ann/capital*100,1),
                maxDD=round(mdd,0), calmar=round(ann/mdd,2) if mdd>0 else 0.0,
                skew=round(float(pd.Series(p).skew()),2), ann_sharpe=round(ann_sharpe,2),
                ruin=bool((eq<=0).any()), end_equity=round(float(eq[-1]),0),
                IS=sub(t['t']<cut), OOS=sub(t['t']>=cut))

def show(r):
    if r.get('trades',0)==0: print(f"{r['name']}: NO TRADES"); return
    print(f"{r['name']:28} N={r['trades']:<5} win={r['win']*100:4.1f}% exp=${r['exp']:+6.2f} "
          f"ann=${r['ann']:+6.0f}({r['ann_pct']:+5.1f}%) DD=${r['maxDD']:5.0f} "
          f"Calmar={r['calmar']:5.2f} skew={r['skew']:+5.2f} shrp={r['ann_sharpe']:+5.2f} "
          f"{'RUIN' if r['ruin'] else 'ok'}")
    if r['IS'] and r['OOS']:
        print(f"{'':28} IS exp=${r['IS']['exp']:+.2f}(t={r['IS']['t']:+.2f}) | "
              f"OOS exp=${r['OOS']['exp']:+.2f}(t={r['OOS']['t']:+.2f})")

