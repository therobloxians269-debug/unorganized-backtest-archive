rng = np.random.default_rng(42)
SCEN = {"baseline (15%)": 1.0, "trim ×0.7 (10.5%)": 0.7, "trim ×0.5 (7.5%)": 0.5}


def mc(port, n=10_000, block=8):
    w = port.resample("W").sum().dropna().values
    nn = len(w); nb = int(np.ceil(nn / block))
    sh = np.empty(n); dd = np.empty(n)
    for i in range(n):
        idx = (rng.integers(0, nn, nb)[:, None] + np.arange(block)[None, :]).ravel()[:nn] % nn
        s = w[idx]; sd = s.std()
        sh[i] = s.mean() / sd * np.sqrt(52) if sd > 0 else 0
        eq = np.cumprod(1 + s); dd[i] = (eq / np.maximum.accumulate(eq) - 1).min()
    return sh, dd


def metrics(ms):
    port, j, comp, tC1, tC2 = build(mom_scale=ms)
    s = perf_stats(port, ANN)
    m = port.resample("ME").apply(lambda x: (1 + x).prod() - 1).dropna()
    rc_ret = (comp.mean() / port.mean())
    rc_risk = comp.apply(lambda c: c.cov(port)) / port.var()
    rs12, _ = rolling_sharpe(port, 12); rs24, _ = rolling_sharpe(port, 24)
    a = perf_stats(port[port.index.year <= 2023], ANN)["sharpe"]
    b = perf_stats(port[port.index.year >= 2024], ANN)["sharpe"]
