        yrs = (sub.index[-1] - sub.index[0]).days / 365.25
        sd = sub.std(ddof=1); B = bmin(sub.mean(), sd, toll)
        # MCPT: permute the SIGN of the position, day-blocked
        rng = np.random.default_rng(1); hits = 0
        days = net.groupby(net.index.normalize()).mean()
        for _ in range(2000):
            if np.average(days * rng.choice([-1, 1], len(days))) >= days.mean(): hits += 1
        p = (hits + 1) / 2001
        d = dd_bootstrap(net); nk = kelly(net, sd)
        print(f"\n{lab}:  n={len(sub)}  days={nd}  {len(sub)/yrs:.0f}/yr  "
              f"net={net.mean():+.3f}pt  t_clust={t:.2f}  MCPT p={p:.4f}")
        print(f"   k={sub.mean()/sd:.3f}  B_min(qtr-Kelly)=${B:,.0f}  "
              f"full-Kelly n*={nk:.2f}  ->  1 MES = {1/nk:.2f}x Kelly")
        print(f"   maxDD realised={d['realised']:.0f}%  bootstrap med={d['med']:.0f}% "
              f"p90={d['p90']:.0f}% p95={d['p95']:.0f}%  P(ruin)={d['ruin']:.1f}%")
