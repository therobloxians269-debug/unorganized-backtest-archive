raw['ts'] = pd.to_datetime(raw['ts_event'], utc=True)
raw = raw.set_index('ts').sort_index()
raw = raw[~raw.index.duplicated(keep='last')]
et = raw.index.tz_convert(NY)
mins = et.hour*60 + et.minute
rth = (mins >= 570) & (mins < 960)   # 09:30 .. 16:00
r = raw[rth].copy()
r['day'] = r.index.tz_convert(NY).normalize()

BIN = 1.0  # price bin size in index points
def value_area(g):
    tp = ((g['high']+g['low']+g['close'])/3.0)
    b = np.round(tp / BIN) * BIN
    vol = g['volume'].groupby(b).sum().sort_index()
    prices = vol.index.to_numpy(); v = vol.to_numpy()
    total = v.sum()
    if total <= 0 or len(v) < 3: return None
    poc_i = int(np.argmax(v))
    lo = hi = poc_i
    acc = v[poc_i]; target = 0.70*total
    while acc < target and (lo > 0 or hi < len(v)-1):
        up = v[hi+1] if hi < len(v)-1 else -1
        dn = v[lo-1] if lo > 0 else -1
        if up >= dn:
            hi += 1; acc += v[hi]
        else:
            lo -= 1; acc += v[lo]
    return dict(POC=prices[poc_i], VAH=prices[hi], VAL=prices[lo],
                dhigh=float(g['high'].max()), dlow=float(g['low'].min()))

va = {}
for day, g in r.groupby('day'):
    res = value_area(g)
    if res: va[day] = res
days = sorted(va.keys())
# map each day -> prior day's VA
prior = {days[i]: days[i-1] for i in range(1, len(days))}

# ---- 2) execution on 5min frame ----
df = M.load(PARQ, tf='5min')
et5 = df.index.tz_convert(NY)
m5 = et5.hour*60 + et5.minute
is_rth = (m5 >= 570) & (m5 < 960)
day5 = et5.normalize()
o = df['open'].to_numpy(); h = df['high'].to_numpy(); l = df['low'].to_numpy(); c = df['close'].to_numpy()
n = len(df)

# index groups per session
sess = {}
for i in range(n):
    if is_rth[i]:
        sess.setdefault(day5[i], []).append(i)

trades = []
for day, idxs in sess.items():
    pday = prior.get(day)
    if pday is None: continue
    v = va[pday]
    VAH, VAL, POC = v['VAH'], v['VAL'], v['POC']
    pdh, pdl = v['dhigh'], v['dlow']
    first = idxs[0]
    op = o[first]                    # session open (known at 09:30)
    if op > VAH:
        d = -1; stop = pdh; tgt = POC
    elif op < VAL:
        d = +1; stop = pdl; tgt = POC
    else:
        continue
    entry = first + 1                # causal: enter next 5min bar open
    if entry not in idxs: continue
    # scan forward within session RTH bars for target/stop, exit at that bar close; else last RTH bar
    exit_bar = idxs[-1]
    for j in idxs:
        if j < entry: continue
        if d == +1:
            if l[j] <= stop or h[j] >= tgt: exit_bar = j; break
        else:
            if h[j] >= stop or l[j] <= tgt: exit_bar = j; break
    trades.append((entry, exit_bar, d))

res = M.evaluate(df, trades, name='value-area-rejection')
M.show(res)
import json
print("JSON:"+json.dumps(res, default=str))

