#!/usr/bin/env python3
"""Cushion-first analysis: which exit profile gives the best CHANCE of building a
cushion before dipping below a $1,000 start? Trend edge, current regime, various
targets/breakeven to raise win rate. Reports win%, total$, worst historical dip,
and a Monte-Carlo of the early equity path from $1,000."""
import numpy as np, pandas as pd
import omni2_lib as L
from omni2_lib import ORN, FLOOR, fric, DPP

def trend_day_v(s, exit_mode="eod", target_R=2.0, be_at=None, stop_atr=1.5):
    h, l, c, atr, vwap = s["h"], s["l"], s["c"], s["atr"], s["vwap"]
    orh, orl = s["or_hi"], s["or_lo"]
    pos = 0; entry = stop = np.nan; ebar = -1; risk0 = np.nan; broke = 0; n = 0; res = []
    tgt = None; be_done = False; maxfav = 0.0
    for b in range(ORN, 78):
        if pos == 0 and n < 3:
            above = c[b] > vwap[b]; below = c[b] < vwap[b]; side = 0
            if broke == 0:
                if c[b] > orh and above: side = 1; broke = 1
                elif c[b] < orl and below: side = -1; broke = -1
            else:
                if broke == 1 and above and l[b] <= vwap[b]+0.5*atr[b] and c[b] > c[b-1]: side = 1
                elif broke == -1 and below and h[b] >= vwap[b]-0.5*atr[b] and c[b] < c[b-1]: side = -1
            if side != 0:
                pos = side; entry = c[b]; ebar = b; be_done = False; maxfav = 0.0
                stop = c[b]-side*max(stop_atr*atr[b], FLOOR); risk0 = abs(entry-stop); n += 1
                tgt = entry + side*target_R*risk0 if exit_mode == "target" else None
            continue
        if pos != 0 and b > ebar:
            if (l[b] <= stop) if pos > 0 else (h[b] >= stop):
                g = pos*(stop-entry); res.append((g-fric("stop"), risk0)); pos = 0; continue
            fav = (h[b]-entry) if pos > 0 else (entry-l[b])
            if be_at is not None and not be_done and fav >= be_at*risk0:
                stop = entry; be_done = True                       # lock breakeven
            if tgt is not None and ((h[b] >= tgt) if pos > 0 else (l[b] <= tgt)):
                g = pos*(tgt-entry); res.append((g-fric("target"), risk0)); pos = 0; continue
            if b == 77:
                g = pos*(c[b]-entry); res.append((g-fric("eod"), risk0)); pos = 0
    return res

def collect(S, **kw):
    rows = []
    for s in S:
        if not (2022 <= s["date"].year <= 2026): continue
        for net, risk in trend_day_v(s, **kw):
            rows.append(net*DPP)
    return np.array(rows)

def mc_cushion(pnl, start=1000, cushion=500, horizon=170, n=20000, seed=1):
    """From $start, bootstrap `horizon` trades; P(build +cushion before dropping below start),
    P(min equity stays >= start), median worst dip below start."""
    rng = np.random.default_rng(seed)
    built = 0; stayed = 0; worst = []
    for _ in range(n):
        seq = rng.choice(pnl, size=horizon, replace=True)
        eq = np.cumsum(seq)                       # P&L from start
        worst.append(eq.min())
        stayed += (eq.min() >= 0)
        # race: first time reach +cushion vs first time go below 0
        hit_c = np.argmax(eq >= cushion) if (eq >= cushion).any() else 10**9
        hit_0 = np.argmax(eq < 0) if (eq < 0).any() else 10**9
        built += (hit_c < hit_0)
    return dict(p_build=built/n, p_stay=stayed/n, med_worst=float(np.median(worst)))

def main():
    S = L.load()
    variants = [
        ("EOD ride (baseline)",      dict(exit_mode="eod")),
        ("target 2R",                dict(exit_mode="target", target_R=2.0)),
        ("target 1.5R",              dict(exit_mode="target", target_R=1.5)),
        ("target 1R",                dict(exit_mode="target", target_R=1.0)),
        ("target 1R + BE@0.5R",      dict(exit_mode="target", target_R=1.0, be_at=0.5)),
        ("target 1.5R + BE@0.75R",   dict(exit_mode="target", target_R=1.5, be_at=0.75)),
        ("target 0.75R + BE@0.4R",   dict(exit_mode="target", target_R=0.75, be_at=0.4)),
    ]
    print(f"{'variant':26s} {'n':>5} {'win%':>5} {'total$':>8} {'worst_dip$':>10}  "
          f"{'P(cushion1st)':>13} {'P(stay>1k)':>10} {'med_worst$':>10}")
    for name, kw in variants:
        p = collect(S, **kw)
        eq = np.cumsum(p); worst = eq.min()
        mc = mc_cushion(p)
        print(f"{name:26s} {len(p):5d} {100*(p>0).mean():5.1f} {p.sum():8.0f} {worst:10.0f}  "
              f"{mc['p_build']:13.2%} {mc['p_stay']:10.2%} {mc['med_worst']:10.0f}")
    print("\nnote: MC bootstraps trades IID (ignores streak clustering) -> P(stay>1k) is OPTIMISTIC;")
    print("the 'worst_dip$' column is the REAL historical path (honest streak risk).")

if __name__ == "__main__":
    main()

