"""
THE CHROME MODEL — BACKTEST HARNESS.

Proving the vocabulary is profitable is the hard part, and it is hard for a reason:
with 113 terms there are 6,441 pairs and 12,882 directional cells. At that width,
PURE NOISE produces a best |t| of about 4.35. Anything that does not clear that is
a coincidence, no matter how good the equity curve looks.

Five gates, all enforced in code. A pattern that fails any one is not a roster
candidate.

  G1  MULTIPLE TESTING   must clear sqrt(2*ln(N_cells)) — the best-of-N noise floor
  G2  DRIFT NEUTRAL      scored as EXCESS over a count-matched random-entry control
                         in the SAME direction. Ranking by raw return in a bull
                         market just rediscovers beta (measured: unconditional long
                         on NQ 2023-24 = +0.114 R/day, $162/trade).
  G3  REGIME             positive in UP years AND DOWN years. This is the gate that
                         stops the harness producing another regime bet.
  G4  OUT OF SAMPLE      TRAIN -> VALIDATE -> sealed HOLDOUT, all three positive.
  G5  ECONOMICS          net positive after limit-order costs on the traded
                         instrument, with a minimum trade count.

COST MODEL (cost.py): entries and target exits are LIMITS (no spread crossed,
trade-through required); only stops are market orders. Charged on the instrument
actually traded — cost/R varies 15x between MES (0.101) and MNQ (0.0065).

USAGE
    python3 chrome_backtest.py                 # full pipeline
    python3 chrome_backtest.py --pattern SKID_LO,CLEANBOT,short
"""
import numpy as np, pandas as pd, warnings, sys, itertools
warnings.filterwarnings('ignore')
import data as D, chrome_lang as CL, cost as CT

# ─────────────────────────────────────────────────────────────────────────────
#  CONFIG
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ REGIME DISCOVERY MUST HAPPEN ON ES.
# NQ data begins 2022-12 and 2023/24/25 were ALL up years — n_down = 0. You cannot
# discover regime-robustness in a sample containing one regime, which is exactly why
# every earlier result came back a "regime bet". So:
#     REGIME  discovered on ES 2010-2026 (has 2011/2015/2018/2022 down years),
#             scored on drift-neutral EXCESS so ES's worse cost/R does not distort rank
#     MONEY   validated on MNQ, where cost/R is 15x better and the economics are real
CFG = dict(
    instrument='ES',          # regime discovery — the only sample with down years
    economics='MNQ',          # where the survivors must actually pay
    holdout='NQ',             # never used for discovery
    tf=5,                     # bar size, minutes
    stop_adr=0.35,            # stop as a fraction of ADR
    rr=2.0,                   # target in R
    entry_from=600,           # 10:00 ET
    entry_to=930,             # 15:30 ET
    min_trades=80,            # per split, per pattern
    min_fire=0.005,           # term must fire on >=0.5% of bars
    max_fire=0.60,            # and <=60%
    n_baseline=150,           # random-entry draws for the drift control
    splits=dict(TRAIN=('2010-01-01', '2019-12-31'),
                VALID=('2020-01-01', '2026-12-31')),
)


# ─────────────────────────────────────────────────────────────────────────────
#  DATA
# ─────────────────────────────────────────────────────────────────────────────
def load(which, tf=5):
    """Returns (vocabulary frame, {day: (H,L,C)} 1-minute path for execution)."""
    d = D.load(which)
    day, r = D.sessions(d)
    rb = D.rth_bars(r)
    bars = CL.build(day, rb, tf=tf)
    g, names = CL.vocabulary(bars)
    g = g[(g.t >= CFG['entry_from']) & (g.t <= CFG['entry_to'])].reset_index(drop=True)
    path = {dd: (b['H'], b['L'], b['C']) for dd, b in rb.items()}
    usable = [n for n in names if CFG['min_fire'] <= g[n].mean() <= CFG['max_fire']]
    return g, path, usable


# ─────────────────────────────────────────────────────────────────────────────
#  EXECUTION — one trade per session, first signal, path-accurate
# ─────────────────────────────────────────────────────────────────────────────
def trades(g, path, mask, direction, which,
           stop_adr=None, rr=None, entry_type='limit'):
    stop_adr = stop_adr or CFG['stop_adr']
    rr = rr or CFG['rr']
    sgn = 1.0 if direction == 'long' else -1.0
    sub = g[mask].groupby('day', as_index=False).first()
    out = []
    for dd, end, px, adr in zip(sub.day, sub.end, sub.c, sub.ADR):
        p = path.get(dd)
        if p is None:
            continue
        H, L, C = p
        j = int(end)
        if j >= len(C) - 6 or not np.isfinite(adr) or adr <= 0:
            continue
        stop = px - sgn * stop_adr * adr
        tgt = px + sgn * stop_adr * rr * adr
        res = CT.run_trade(H, L, C, j, sgn, px, stop, tgt, which,
                           entry_type=entry_type)
        if res['outcome'] == 'nofill':
            continue
        R = stop_adr * adr
        # EXTREMITY DIAGNOSTIC — where in the session's realised range did we enter?
        # Uses the completed session hi/lo, so it is hindsight: a REPORT, never a signal.
        # A long wants pos ~ 0 (bought the low), a short wants pos ~ 1 (sold the high).
        sh, sl = float(H.max()), float(L.min())
        pos = (px - sl) / (sh - sl) if sh > sl else 0.5
        cap = (1.0 - pos) if sgn > 0 else pos
        out.append((dd, res['outcome'], res['pts_net'], res['pts_net'] / R, cap))
    if not out:
        return pd.DataFrame(columns=['day', 'outcome', 'pts', 'R', 'cap'])
    return pd.DataFrame(out, columns=['day', 'outcome', 'pts', 'R', 'cap'])


def stats(t, which):
    """Day-clustered. Sessions are the independent unit, not trades."""
    if len(t) < 20:
        return None
    gday = t.groupby('day').R.mean()
    nd = len(gday)
    # standard error of the PATTERN's own mean, clustered by session
    se = float(gday.std(ddof=1) / np.sqrt(nd)) if nd > 15 else np.nan
    res = t[t.outcome != 'timeout']
    return dict(
        n=len(t), days=nd, se=se,
        avgR=float(t.R.mean()),
        t=float(gday.mean() / se) if nd > 15 and se > 0 else np.nan,
        wr=float((res.outcome == 'win').mean()) if len(res) else np.nan,
        timeout=float((t.outcome == 'timeout').mean()),
        usd=float(t.pts.mean() * CT.PT[which]),
        cap=float(t.cap.mean()),
        total_R=float(t.R.sum()),
        maxDD_R=float((gday.cumsum().cummax() - gday.cumsum()).max()),
    )


# ─────────────────────────────────────────────────────────────────────────────
#  G2 · DRIFT-NEUTRAL BASELINE
# ─────────────────────────────────────────────────────────────────────────────
def baseline(g, path, direction, which, n=None, seed=17):
    """Count-matched random-entry control in the same direction."""
    n = n or CFG['n_baseline']
    rng = np.random.default_rng(seed)
    vals = []
    for _ in range(n):
        m = np.zeros(len(g), bool)
        m[rng.choice(len(g), size=max(len(g) // 3, 1), replace=False)] = True
        s = stats(trades(g, path, m, direction, which), which)
        if s:
            vals.append(s['avgR'])
    if not vals:
        return np.nan, np.nan
    return float(np.mean(vals)), float(np.std(vals))


# ─────────────────────────────────────────────────────────────────────────────
#  G3 · REGIME GATE — positive in UP years AND DOWN years
# ─────────────────────────────────────────────────────────────────────────────
def year_direction(g):
    """Classify each calendar year as UP or DOWN from the close-to-close move."""
    dclose = g.groupby('day').c.last()
    yr = dclose.groupby(dclose.index.year).agg(['first', 'last'])
    return {int(y): ('UP' if r['last'] >= r['first'] else 'DOWN') for y, r in yr.iterrows()}


def regime_gate(t, ydir, min_years=6):
    """Returns (passed, detail). Requires >=1 down year present and both signs positive."""
    if not len(t):
        return False, {}
    x = t.copy()
    x['yr'] = pd.to_datetime(x.day).dt.year
    per = x.groupby('yr').R.mean()
    if len(per) < 3:
        return False, dict(years=len(per), note='too few years')
    up = [v for y, v in per.items() if ydir.get(y) == 'UP']
    dn = [v for y, v in per.items() if ydir.get(y) == 'DOWN']
    detail = dict(years=len(per), up_mean=float(np.mean(up)) if up else np.nan,
                  dn_mean=float(np.mean(dn)) if dn else np.nan,
                  pos_years=int((per > 0).sum()), tot_years=int(len(per)),
                  n_down=len(dn))
    passed = bool(up and dn and np.mean(up) > 0 and np.mean(dn) > 0)
    return passed, detail


# ─────────────────────────────────────────────────────────────────────────────
#  G1 · MULTIPLE-TESTING BAR
# ─────────────────────────────────────────────────────────────────────────────
def maxstat_bar(n_cells):
    """Expected best |z| over n independent cells under the null."""
    return float(np.sqrt(2.0 * np.log(max(n_cells, 2))))


# ─────────────────────────────────────────────────────────────────────────────
#  THE SCAN
# ─────────────────────────────────────────────────────────────────────────────
def scan(g, path, terms, which, pairs=True, verbose=True):
    combos = [(a, '') for a in terms]
    if pairs:
        combos += [(a, b) for i, a in enumerate(terms) for b in terms[i + 1:]]
    base = {d: baseline(g, path, d, which) for d in ('long', 'short')}
    if verbose:
        print(f'  drift baselines  long {base["long"][0]:+.4f}±{base["long"][1]:.4f}   '
              f'short {base["short"][0]:+.4f}±{base["short"][1]:.4f}')
        print(f'  scanning {len(combos):,} patterns x 2 directions = '
              f'{len(combos)*2:,} cells', flush=True)
    rows = []
    for k, (a, b) in enumerate(combos):
        m = g[a].values if b == '' else (g[a].values & g[b].values)
        if m.sum() < CFG['min_trades']:
            continue
        for d in ('long', 'short'):
            t = trades(g, path, m, d, which)
            s = stats(t, which)
            if not s or s['n'] < CFG['min_trades']:
                continue
            mu, sd = base[d]
            # ⚠️ z MUST be divided by the PATTERN's own day-clustered standard error.
            # Dividing by the spread of the BASELINE means (sd) is wrong: each baseline
            # draw carries ~2,300 trades so sd is the SE of a very precise estimate
            # (~0.011), while a pattern carries 80-300 trades (SE ~0.06-0.10). Using sd
            # inflated every z by 5-9x — it is why 2,213 of 10,230 cells "cleared" a
            # 4.30 max-stat bar when the true expectation under the null is ~1.
            # The baseline's own uncertainty is negligible by comparison, so mu enters
            # as a constant offset and only the pattern's SE belongs in the denominator.
            rows.append(dict(A=a, B=b, dir=d, **s,
                             excess=s['avgR'] - mu,
                             z=(s['avgR'] - mu) / max(s['se'], 1e-9)
                               if np.isfinite(s['se']) else np.nan))
        if verbose and k % 500 == 0 and k:
            print(f'    {k:,}/{len(combos):,}', flush=True)
    return pd.DataFrame(rows)


# ─────────────────────────────────────────────────────────────────────────────
#  FULL PIPELINE
# ─────────────────────────────────────────────────────────────────────────────
def pipeline(discovery=None, holdout=None, pairs=True):
    discovery = discovery or CFG['instrument']
    # Holdout is NQ, not MNQ: MNQ carries only ~83 sessions, so nearly every pattern
    # returns nan there and the gate silently does nothing. NQ tracks the same index
    # with a worse cost/R than MNQ, so a positive NQ net is a conservative floor.
    holdout = holdout or CFG['holdout']
    print('THE CHROME MODEL — backtest pipeline')
    print('=' * 88)
    g, path, terms = load(discovery, CFG['tf'])
    gh, path_h, _ = load(holdout, CFG['tf'])
    print(f'  {discovery}: {len(g):,} bars / {g.day.nunique()} sessions / {len(terms)} usable terms')
    print(f'  {holdout} (sealed holdout): {gh.day.nunique()} sessions')

    a, b = CFG['splits']['TRAIN']
    tr = g[(g.day >= a) & (g.day <= b)].reset_index(drop=True)
    a, b = CFG['splits']['VALID']
    va = g[(g.day >= a) & (g.day <= b)].reset_index(drop=True)
    ydir = year_direction(g)
    print(f'  TRAIN {tr.day.nunique()} sessions · VALID {va.day.nunique()} sessions')
    print(f'  year map: {ydir}')

    print(f'\n  [G1+G2] scanning TRAIN...')
    R = scan(tr, path, terms, discovery, pairs=pairs)
    bar = maxstat_bar(len(R))
    print(f'\n  cells scored {len(R):,}   multiple-testing bar |z| > {bar:.2f}')
    print(f'  cleared: {(R.z.abs() > bar).sum()}   positive excess: {(R.excess > 0).sum()} '
          f'({(R.excess > 0).mean():.0%})')
    R['clears_G1'] = R.z > bar
    cand = R[R.clears_G1].sort_values('z', ascending=False)
    print(f'  [G1] candidates: {len(cand)}')
    if not len(cand):
        print('\n  NO CANDIDATES. The vocabulary did not clear the noise floor.')
        return R, None

    print(f'\n  [G3] regime gate — must be positive in UP years AND DOWN years')
    keep = []
    for _, q in cand.iterrows():
        m = g[q.A].values if q.B == '' else (g[q.A].values & g[q.B].values)
        t_all = trades(g, path, m, q.dir, discovery)
        ok, det = regime_gate(t_all, ydir)
        if ok:
            keep.append(dict(q, **{f'rg_{k}': v for k, v in det.items()}))
    K = pd.DataFrame(keep)
    print(f'  [G3] survived regime gate: {len(K)} of {len(cand)}')
    if not len(K):
        print('\n  NO CANDIDATES survive the regime gate.')
        return R, None

    print(f'\n  [G4] out-of-sample: VALIDATE then sealed HOLDOUT')
    final = []
    for _, q in K.iterrows():
        mv = va[q.A].values if q.B == '' else (va[q.A].values & va[q.B].values)
        sv = stats(trades(va, path, mv, q.dir, discovery), discovery)
        if not sv or sv['avgR'] <= 0:
            continue
        mh = gh[q.A].values if q.B == '' else (gh[q.A].values & gh[q.B].values)
        sh = stats(trades(gh, path_h, mh, q.dir, holdout), holdout)
        final.append(dict(pattern=f'{q.A}+{q.B}' if q.B else q.A, dir=q.dir,
                          tr_R=q.avgR, tr_z=q.z, tr_n=q.n,
                          va_R=sv['avgR'], va_t=sv['t'], va_n=sv['n'],
                          ho_R=sh['avgR'] if sh else np.nan,
                          ho_t=sh['t'] if sh else np.nan,
                          ho_n=sh['n'] if sh else 0,
                          ho_usd=sh['usd'] if sh else np.nan,
                          cap=sv['cap'],
                          up=q.get('rg_up_mean'), dn=q.get('rg_dn_mean'),
                          usd=sv['usd']))
    F = pd.DataFrame(final)
    print(f'  [G4] positive on VALIDATE: {len(F)}')

    # G5 — sealed holdout must also be positive, with a real trade count
    if len(F):
        F['clears_G5'] = (F.ho_R > 0) & (F.ho_n >= 40)
        print(f'  [G5] ALSO positive on sealed {holdout} holdout '
              f'(n>=40): {int(F.clears_G5.sum())}')
        S = F[F.clears_G5].sort_values('ho_R', ascending=False)
        show = S if len(S) else F.sort_values('va_R', ascending=False)
        print(f'\n  {"SURVIVORS (all 5 gates)" if len(S) else "no G5 survivors — showing G4 leaders"}')
        print(f'\n{"pattern":<32}{"dir":>6}{"TRAIN":>9}{"VALID":>9}{"HOLD":>9}'
              f'{"ho_t":>7}{"ho_n":>6}{"UPyr":>8}{"DNyr":>8}{"cap":>6}{"$/tr":>9}')
        for _, q in show.head(30).iterrows():
            print(f'{q.pattern:<32}{q.dir:>6}{q.tr_R:>+9.3f}{q.va_R:>+9.3f}'
                  f'{q.ho_R:>+9.3f}{q.ho_t:>+7.2f}{int(q.ho_n):>6}'
                  f'{q.up:>+8.3f}{q.dn:>+8.3f}{q.cap:>6.2f}{q.ho_usd:>+9.2f}')
        F = S if len(S) else F
    return R, F


if __name__ == '__main__':
    if '--pattern' in sys.argv:
        spec = sys.argv[sys.argv.index('--pattern') + 1].split(',')
        A, B, dirn = (spec + [''])[:3] if len(spec) == 3 else (spec[0], '', spec[1])
        which = CFG['instrument']
        g, path, _ = load(which, CFG['tf'])
        m = g[A].values if not B else (g[A].values & g[B].values)
        t = trades(g, path, m, dirn, which)
        s = stats(t, which)
        ok, det = regime_gate(t, year_direction(g))
        print(f'{A}+{B} {dirn}:  {s}')
        print(f'regime gate: {"PASS" if ok else "FAIL"}  {det}')
    else:
        R, F = pipeline(pairs=True)
        if R is not None:
            R.to_parquet('chrome_scan.parquet')
        if F is not None and len(F):
            F.to_parquet('chrome_roster.parquet')
            print(f'\n  roster written: chrome_roster.parquet ({len(F)} patterns)')

