# Session boundaries: minutes since midnight ET
_RTH_OPEN  = 9  * 60 + 30   # 570  → 09:30
_RTH_CLOSE = 16 * 60         # 960  → 16:00
_POST_END  = 17 * 60         # 1020 → 17:00
_MAINT_END = 18 * 60         # 1080 → 18:00
_PRE_START = 4  * 60         # 240  → 04:00

# Signal eligibility window inside RTH
_BLACKOUT_OPEN_MIN  = 15
_BLACKOUT_CLOSE_MIN = 30
_SIG_START = _RTH_OPEN  + _BLACKOUT_OPEN_MIN   # 585 → 09:45
_SIG_END   = _RTH_CLOSE - _BLACKOUT_CLOSE_MIN  # 930 → 15:30


