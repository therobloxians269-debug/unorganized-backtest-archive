        sq = basic_stats(rq["net_ret"], _ppy("QUARTERLY"))["sharpe_ann"]
        print(f"   {k:6.3f}   |  {sa:7.2f}  |  {sq:7.2f}")

    # ---- pre-registered kill conditions on OUT-OF-SAMPLE ----
    print("\n" + "="*80); print("PRE-REGISTERED KILL CONDITIONS  (evaluated on OUT-OF-SAMPLE)")
    print("="*80)
    if oos_res is None:
        print("  insufficient OOS data to evaluate."); return
    r_oos, n_oos, d_oos, b_oos = oos_res
    # compare OOS magnitude vs IS magnitude
    is_net = cycle_returns(isamp, cfg.kappa_pts, cfg.comm_per_side_usd, cfg.instrument, cfg.legs)["net_ret"].mean() if len(isamp)>=2 else np.nan
    oos_net = r_oos["net_ret"].mean()
    frac = oos_net/is_net if (is_net and not np.isnan(is_net) and is_net>0) else np.nan
    checks = [
        ("OOS deflated Sharpe > 0.95 (honest trials)", d_oos["dsr"] > 0.95, f"DSR={d_oos['dsr']:.3f}"),
        ("OOS net Sharpe(ann) >= 0.5",                 n_oos["sharpe_ann"] >= 0.5, f"SR={n_oos['sharpe_ann']:.2f}"),
        ("OOS net mean >= 50% of in-sample",           (not np.isnan(frac)) and frac >= 0.5, f"frac={frac:.2f}" if not np.isnan(frac) else "n/a"),
        ("beta-neutral |beta| < 0.20",                 abs(b_oos["beta"]) < 0.20, f"beta={b_oos['beta']:+.3f}"),
        ("survives 2x slippage (net SR>0 at 2*kappa)", basic_stats(cycle_returns(oos,2*cfg.kappa_pts,cfg.comm_per_side_usd,cfg.instrument,cfg.legs)["net_ret"],_ppy("ALL"))["sharpe_ann"]>0, None),
    ]
    passed = 0
    for name, ok, extra in checks:
        tag = "PASS" if ok else "FAIL"
        print(f"  [{tag}] {name}" + (f"   ({extra})" if extra else ""))
        passed += int(bool(ok))
    print(f"\n  VERDICT: {passed}/{len(checks)} conditions passed -> "
          + ("PROCEED to live-cost paper trial." if passed==len(checks)
             else "EDGE NOT CONFIRMED under these conditions; do not deploy."))

# =============================================================================
# ANALYTICS UNIT TESTS  (validate the engine functions directly; no data required)
# =============================================================================
def _make_cycles(n, on_bps, rev_bps, noise_bps, seed, level=6000.0, quarterly=False, beta_mode=None):
    """Synthetic per-cycle snapshots with a known embedded edge (or known beta)."""
    rng = np.random.default_rng(seed)
    thu = np.full(n, level)*(1+rng.normal(0,0.01,n))
    if beta_mode is None:
        on  = rng.normal(on_bps/1e4,  noise_bps/1e4, n)
        rev = rng.normal(rev_bps/1e4, noise_bps/1e4, n)
        fo  = thu*(1+on); fn = fo*(1-rev)
    else:                                   # engineer strat_return ~ beta*mkt + noise
        mkt = rng.normal(0, 50/1e4, n); fn = thu*(1+mkt)
        fo  = (beta_mode*mkt*thu + thu + fn)/2.0 + thu*rng.normal(0, noise_bps/1e4, n)
    return pd.DataFrame(dict(thu_close=thu, fri_open=fo, fri_noon=fn, is_quarterly=quarterly))

def run_unittests():
    """Five tests on the SAME engine functions the production path uses:
    (A) edge recovery, (B) disguised-beta detection, (C) cost monotonicity,
    (D) deflated-Sharpe haircut grows with trials, (E) no false positive on noise."""
    print(">>> ANALYTICS UNIT TESTS (engine functions, no real data)\n")
    ok = True
    # A: recover an embedded edge (low noise) to the right magnitude
    df = _make_cycles(192, 14.3, 12.9, 3, seed=7)
    s = basic_stats(cycle_returns(df, 0.0, 0.0, "MES", "both")["gross_ret"], 12)
    a = 24 < s["mean"]*1e4 < 30
    print(f"  [A recovery]    gross {s['mean']*1e4:6.2f} bps (expect ~27)                 {'PASS' if a else 'FAIL'}"); ok &= a
    # B: flag a disguised-beta 'edge' (strat = 0.5*mkt + noise) as beta~0.5, alpha~0
    rb = cycle_returns(_make_cycles(300, 0,0, 15, seed=3, beta_mode=0.5), 0.0, 0.0, "MES", "both")
    b = beta_neutrality(rb["gross_ret"].values, rb["mkt_ret"].values)
    bok = 0.4 < b["beta"] < 0.6 and abs(b["alpha_t"]) < 2.5
    print(f"  [B disg. beta]  beta {b['beta']:+.3f} (expect ~0.5), alpha_t {b['alpha_t']:+.2f}        {'PASS' if bok else 'FAIL'}"); ok &= bok
    # C: net return falls monotonically as slippage rises
    nets = [cycle_returns(df, k, 0.20, "MES", "both")["net_ret"].mean() for k in (0.0,0.25,0.5,1.0)]
    cok = all(nets[i] > nets[i+1] for i in range(3))
    print(f"  [C cost mono]   nets {[round(float(x)*1e4,1) for x in nets]} bps          {'PASS' if cok else 'FAIL'}"); ok &= cok
    # D: deflated-Sharpe haircut grows with trial count (does not increase)
    rr = cycle_returns(df, 0.0, 0.0, "MES", "both")["gross_ret"].values
    d5, d5k = deflated_sharpe(rr, 5)["dsr"], deflated_sharpe(rr, 5000)["dsr"]
    dok = d5 >= d5k
    print(f"  [D DSR trials]  DSR(5)={d5:.3f} >= DSR(5000)={d5k:.3f}                  {'PASS' if dok else 'FAIL'}"); ok &= dok
    # E: pure noise must not produce a significant t or a high DSR
    rn = cycle_returns(_make_cycles(192, 0,0, 60, seed=11), 0.0, 0.0, "MES", "both")
    sn = basic_stats(rn["gross_ret"], 12); dd = deflated_sharpe(rn["gross_ret"].values, 20)
    eok = abs(sn["t"]) < 2.5 and dd["dsr"] < 0.95
    print(f"  [E noise]       t={sn['t']:+.2f}, DSR={dd['dsr']:.3f} (no false positive)        {'PASS' if eok else 'FAIL'}"); ok &= eok
    print("\n  UNIT TESTS:", "ALL PASS" if ok else "FAILURE")
    return ok

# =============================================================================
# SYNTHETIC SELF-TEST  (no data required) — embeds the documented effect
# =============================================================================
def synthetic_trades(seed=0, years=6, start_year=2019):
    """MES-like trades with the 3FPS effect embedded as a mean-reverting OVERLAY on a
    market random walk whose OVERNIGHT (Thu close->Fri open) and INTRADAY (Fri open->
    Fri noon) moves have EQUAL variance. Equal vol => the strategy's long-overnight and
    short-intraday market exposures cancel => beta ~ 0 by construction. This validates
    that the harness PASSES a genuine market-neutral edge (no false negative). The
    analytics core's disguised-beta detection is validated separately (test_analytics Test B)."""
    rng = np.random.default_rng(seed)
    start = datetime(start_year,1,1); end = datetime(start_year+years,1,1)
    tfs = dict(third_fridays(start, end))
    def front_con(d):
        q = ((d.month-1)//3)*3+3
        rolled = (d.month > q) or (d.month == q and d.day > 10)
        qq = q+3 if rolled else q
        yy = d.year + (1 if qq>12 else 0); qq = qq-12 if qq>12 else qq
        return f"MES{CME_MONTH[qq]}{yy%100:02d}", yy*100+qq   # (symbol, unique id)
    SIG = 0.0022    # equal overnight & intraday-to-noon market vol (~40bps)
    times = [time(9,30),time(9,31),time(10,0),time(11,0),time(12,0),time(13,30),time(15,0),time(16,0)]
    rows = []; fv_prev_close = 3000.0; day = start
    while day < end:
        if day.weekday() < 5:
            d = day.date()
            m_on    = rng.normal(0, SIG)                 # Thu close -> Fri open (market)
            m_intra = rng.normal(0, SIG)                 # Fri open  -> Fri noon (market)
            fv_open = fv_prev_close*(1+m_on)
            fv_noon = fv_open*(1+m_intra)
            fv_close= fv_noon*(1+rng.normal(0, SIG))     # noon -> close (market, irrelevant to strat)
            is_tf = d in tfs; is_q = tfs.get(d, False)
            bump = (0.00315 if is_q else 0.00143) if is_tf else 0.0  # overlay at OPEN (excess vs Thu close)
            rev  = bump                                              # full reversion by noon (residual 0)
            sym, iid = front_con(day)
            for tt in times:
                if tt <= time(9,30):  fv, ov = fv_open, bump
                elif tt <= time(12,0):
                    fr = (datetime.combine(d,tt)-datetime.combine(d,time(9,30))).total_seconds()/((12-9.5)*3600)
                    fr = min(max(fr,0),1)
                    fv = fv_open*(1+m_intra*fr); ov = (bump - rev*fr) if is_tf else 0.0
                else:
                    fr2 = (datetime.combine(d,tt)-datetime.combine(d,time(12,0))).total_seconds()/((16-12)*3600)
                    fv = fv_noon*(1+(fv_close/fv_noon-1)*min(max(fr2,0),1)); ov = (bump-rev) if is_tf else 0.0
                px = fv*(1+ov)*(1+rng.normal(0,0.00008))
                rows.append((pd.Timestamp(datetime.combine(d,tt), tz=ET), d, sym, iid, px, int(rng.integers(5,60))))
                if rng.random() < 0.04:                    # thin deferred contract for roll realism
                    fs, fiid = front_con(day+timedelta(days=95))
                    if fs != sym:
                        rows.append((pd.Timestamp(datetime.combine(d,tt), tz=ET), d, fs, fiid, px*1.004, 1))
            fv_prev_close = fv_close
        day += timedelta(days=1)
    df = pd.DataFrame(rows, columns=["ts","date","symbol","instrument_id","price","size"])
    return df.sort_values("ts").reset_index(drop=True)

def run_synthetic():
    print(">>> SYNTHETIC SELF-TEST (no real data) — pipeline + recovery check\n")
    cfg = Config(instrument="MES", kappa_pts=0.0, comm_per_side_usd=0.0, oos_split="2020-01-01", n_trials=24)
    tr = synthetic_trades(seed=1, years=10, start_year=2015)
    front = build_front_continuous(tr, cfg.roll_trail_days, cfg.front_vol_floor)
    start, end = datetime(2015,1,1), datetime(2025,1,1)
    cal = third_fridays(start, end); pcal = second_fridays(start, end)
    snap = extract_snapshots(front, cal, cfg)
    plc  = extract_snapshots(front, pcal, cfg)
    # report (gross == net since costs 0 here)
    run_report(snap, plc, cfg)
    # explicit recovery assertions
    rq = cycle_returns(snap[snap.is_quarterly], 0,0,"MES","both")["gross_ret"].mean()*1e4
    rm = cycle_returns(snap[~snap.is_quarterly], 0,0,"MES","both")["gross_ret"].mean()*1e4
    rp = cycle_returns(plc, 0,0,"MES","both")["gross_ret"].mean()*1e4
    print(f"\n[recovery] quarterly gross ~{rq:.1f}bps (embed ~63)  monthly ~{rm:.1f}bps (embed ~27)  placebo ~{rp:.1f}bps (embed ~0)")
    ok = (rq>45) and (rm>18) and (abs(rp)<8)
    print("[SELF-TEST]", "PASS" if ok else "FAIL")
    return ok

# =============================================================================
def main():
    ap = argparse.ArgumentParser(description="Third-Friday Settlement Reversal backtest (MES MBO)")
    ap.add_argument("--data", default="", help="glob for MES MBO .dbn.zst files")
    ap.add_argument("--feed-csv", default="", help="precomputed snapshot CSV (OHLCV path)")
    ap.add_argument("--instrument", default="MES", choices=["MES","ES","MYM"])
    ap.add_argument("--legs", default="both", choices=["both","overnight","reversal"])
    ap.add_argument("--kappa", type=float, default=0.25, help="slippage per crossing (index pts)")
    ap.add_argument("--comm", type=float, default=None, help="commission $/side")
    ap.add_argument("--oos-split", default="2021-01-01")
    ap.add_argument("--trials", type=int, default=24)
    ap.add_argument("--start", default="2010-01-01")
    ap.add_argument("--end", default="2026-12-31")
    ap.add_argument("--selftest", action="store_true", help="full-pipeline synthetic test")
    ap.add_argument("--unittest", action="store_true", help="analytics-core unit tests")
    a = ap.parse_args()

    if a.unittest and not a.selftest:
        sys.exit(0 if run_unittests() else 1)
    if a.selftest and not a.unittest:
        sys.exit(0 if run_synthetic() else 1)
    if not a.data and not a.feed_csv:                 # bare invocation => full self-validation
        u = run_unittests(); print("\n" + "="*80 + "\n"); s = run_synthetic()
        sys.exit(0 if (u and s) else 1)

    default_comm = {"MES":0.62,"ES":2.25,"MYM":0.52}[a.instrument]
    cfg = Config(data_glob=a.data, feed_csv=a.feed_csv, instrument=a.instrument, legs=a.legs,
                 kappa_pts=a.kappa, comm_per_side_usd=(a.comm if a.comm is not None else default_comm),
                 oos_split=a.oos_split, n_trials=a.trials)
    start, end = datetime.fromisoformat(a.start), datetime.fromisoformat(a.end)
    cal, pcal = third_fridays(start, end), second_fridays(start, end)

    if a.feed_csv:
        snap = feed_from_csv(a.feed_csv); plc = pd.DataFrame(columns=snap.columns)
    else:
        print(f"loading MES MBO trades from {a.data} ...")
        trades = load_trades_from_dbn(a.data)
        print(f"  {len(trades):,} trade events; {trades['date'].nunique()} sessions; "
              f"{trades['date'].min()}..{trades['date'].max()}")
        front = build_front_continuous(trades, cfg.roll_trail_days, cfg.front_vol_floor)
        snap = extract_snapshots(front, cal, cfg)
        plc  = extract_snapshots(front, pcal, cfg)
        print(f"  extracted {len(snap)} expiration cycles, {len(plc)} placebo cycles")
    run_report(snap, plc, cfg)

if __name__ == "__main__":
    main()

