#!/usr/bin/env python3
"""Pick the config by ROBUSTNESS, then validate once on an untouched market.

Two things this fixes about how the config was chosen so far:
  1. every parameter was picked off the NQ sweep and then "checked" on MNQ. After
     enough of those checks MNQ is no longer a holdout — it has been spent on
     selection. So the score here is min(NQ spread, MNQ spread), which rewards a
     config that works on BOTH rather than one that peaks on either.
  2. ES has not been used for anything. It is the genuinely independent test and
     is run ONCE, on the single winning config, at the end.

Everything is in R units net of cost, measured against a 1.5xATR displaced placebo.
"""
from __future__ import annotations

import numpy as np
import pandas as pd

import sigmablock as S

BUF = S.TICK * 4


def sess(d, tf, conf, f, shift, rr_min=3.0, runner=True):
    om = (d.index - d.index[0].replace(hour=9, minute=30)).total_seconds() / 60
    ok = np.where(om + tf <= conf)[0]
    if len(ok) == 0:
        return []
    arm = int(ok[-1])
    if arm >= len(d) - 4 or arm < 2:
        return []
    sub = d.iloc[:arm + 1]
    if float(sub["dev"].iloc[-1]) == 0:
        return []
    lb, lt = S.bounds(sub.loc[sub["low"].idxmin()], True)
    hb, ht = S.bounds(sub.loc[sub["high"].idxmax()], False)
    lb += shift; lt += shift; hb += shift; ht += shift
    if hb <= lt:
        return []
    fwd = d.iloc[arm + 1:]
    H = fwd["high"].to_numpy(); L = fwd["low"].to_numpy(); C = fwd["close"].to_numpy()
    n = len(H); gap = hb - lt
    out = []; done = {"L": False, "S": False}; i = 0
    while i < n:
        s = None
        if not done["L"] and L[i] <= lt:
            s = "L"
        elif not done["S"] and H[i] >= hb:
            s = "S"
        if s is None:
            i += 1
            continue
        done[s] = True
        lg = s == "L"
        e, sp = (lt, lb - BUF) if lg else (hb, ht + BUF)
        risk = abs(e - sp)
        tgt = e + f * gap if lg else e - f * gap
        if risk <= 0 or abs(tgt - e) / risk < rr_min:
            i += 1
            continue
        hitT = False; stop = sp; final = None
        for j in range(i + 1, n):
            hs = (L[j] <= stop) if lg else (H[j] >= stop)
            ht_ = (H[j] >= tgt) if lg else (L[j] <= tgt)
            if hs:
                final = (stop - e) if lg else (e - stop)
                break
            if ht_:
                if not runner:
                    final = abs(tgt - e)
                    break
                if not hitT:
                    hitT = True
                    stop = e
        if final is None:
            final = (C[-1] - e) if lg else (e - C[-1])
        out.append((final, risk))
        i += 1
    return out


def prep(path, cols, tf):
    d = pd.read_parquet(path)[cols]
    d.columns = ["open", "high", "low", "close", "volume"]
    d = d.dropna()
    d.index = d.index.tz_convert("America/New_York")
    bars = S.to_tf(d, tf, "clv")
    out = []
    for day in sorted(set(bars.index.date)):
        x = S.session_frame(bars[bars.index.date == day])
        if x.empty or len(x) < S.EXT_LEN:
            continue
        a = (x["high"] - x["low"]).rolling(14, min_periods=3).mean().shift(1).bfill()
        out.append((x, float(a.iloc[min(len(a) - 1, 12)])))
    return out


def spread(SES, tf, conf, f, cost, runner=True):
    R = []; P = []
    for d, a in SES:
        R += sess(d, tf, conf, f, 0.0, runner=runner)
        P += sess(d, tf, conf, f, 1.5 * a if np.isfinite(a) else 0.0, runner=runner)
    if len(R) < 40 or len(P) < 40:
        return None
    r = np.mean([(x[0] - cost) / x[1] for x in R])
    p = np.mean([(x[0] - cost) / x[1] for x in P])
    return dict(n=len(R), ev=r, pl=p, spread=r - p, per_day=len(R) / len(SES))


def main():
    NQ = "/Users/kaveh/qt_cascade/nq_v6.parquet"
    MNQ = "/Users/kaveh/qt_cascade/mnq_v6.parquet"
    C = ["o", "h", "l", "c", "v"]
    grid = []
    for tf in (5, 15):
        snq = prep(NQ, C, tf)
        smnq = prep(MNQ, C, tf)
        for conf in (30, 45, 60):
            for f in (0.35, 0.50, 0.75):
                a = spread(snq, tf, conf, f, 0.25)
                b = spread(smnq, tf, conf, f, 0.75)
                if a and b:
                    grid.append(dict(tf=tf, conf=conf, f=f, nq=a["spread"], mnq=b["spread"],
                                     worst=min(a["spread"], b["spread"]),
                                     nq_ev=a["ev"], mnq_ev=b["ev"], per_day=a["per_day"]))
    G = pd.DataFrame(grid).sort_values("worst", ascending=False)
    print("\nRanked by WORST-CASE spread across the two samples (robustness, not best cell)\n")
    print(f"{'tf':>3} {'conf':>5} {'tgt':>5} {'NQ spr':>9} {'MNQ spr':>9} {'WORST':>9} {'/day':>6}")
    for _, r in G.iterrows():
        print(f"{int(r.tf):>3} {int(r.conf):>5} {r.f:>5.2f} {r.nq:>+9.3f} {r.mnq:>+9.3f} {r.worst:>+9.3f} {r.per_day:>6.2f}")
    best = G.iloc[0]
    print(f"\nMOST ROBUST: tf={int(best.tf)}m  confirm={int(best.conf)}min  target={best.f:.2f}")
    print(f"  positive on both: NQ {best.nq_ev:+.3f}R, MNQ {best.mnq_ev:+.3f}R\n")

    print("── ES 2019-2026, INDEPENDENT MARKET, run ONCE on that config ──")
    ses = prep("/Users/kaveh/quant_lab/cache/es_ym_1m.parquet",
               ["es_open", "es_high", "es_low", "es_close", "es_volume"], int(best.tf))
    e = spread(ses, int(best.tf), int(best.conf), float(best.f), 0.25)
    if e:
        print(f"  n={e['n']}  {e['per_day']:.2f}/day  EV {e['ev']:+.3f}R  placebo {e['pl']:+.3f}R  spread {e['spread']:+.3f}R")
        print(f"  VERDICT: {'REPLICATES' if e['spread'] > 0 and e['ev'] > 0 else 'DOES NOT REPLICATE'}")
    else:
        print("  insufficient")
    print()


if __name__ == "__main__":
    main()

