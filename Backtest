from __future__ import annotations
import numpy as np, pandas as pd, yfinance as yf
from lib_perf import perf_stats

COINS = ["BTC-USD","ETH-USD","BNB-USD","XRP-USD","ADA-USD","SOL-USD","DOGE-USD","DOT-USD",
         "AVAX-USD","LINK-USD","LTC-USD","BCH-USD","ATOM-USD","XLM-USD","ETC-USD","TRX-USD",
         "UNI-USD","FIL-USD","ALGO-USD","VET-USD","HBAR-USD","NEAR-USD","AAVE-USD","MKR-USD",
         "EOS-USD","XTZ-USD","THETA-USD","AXS-USD","SAND-USD","MANA-USD"]
ANN, COST = 365, 25.0


def main():
    px = yf.download(COINS, start="2017-01-01", auto_adjust=True, progress=False)["Close"]
    px = px.dropna(how="all").dropna(axis=1, thresh=int(len(px)*0.20))
    rets = px.pct_change()
    av = (rets.rolling(60).std()*np.sqrt(ANN)).shift(1)
    n = px.shape[1]; k = max(3, n//3)
    rank = px.pct_change(90).shift(1).rank(axis=1, ascending=False)
    def norm(m): return m.div(m.abs().sum(axis=1).replace(0, np.nan), axis=0).fillna(0.0)
    longw = norm((rank <= k).astype(float)/av)
    shortw = norm((rank > n-k).astype(float)/av)
    eqw = norm(pd.DataFrame(1.0, index=px.index, columns=px.columns)/av)
    mkt = (1+rets.mean(axis=1)).cumprod()
    up = (mkt > mkt.rolling(100).mean()).shift(1).reindex(px.index).fillna(True)
    softlong = up.replace(False, 0.3).replace(True, 1.0).astype(float)

    def ret_of(W):
        W = W.shift(1).resample("W").last().reindex(px.index, method="ffill")
        return (((W*rets).sum(axis=1) - W.diff().abs().sum(axis=1)*COST*1e-4)).dropna()

    upm = up.astype(float)
    variants = {
        "A keeper long-only": longw.mul(softlong, axis=0),
        "B long-up/short-bottom-down": longw.mul(upm, axis=0).sub(shortw.mul(1-upm, axis=0)),
        "C long-up/short-mkt-down": longw.mul(upm, axis=0).sub(eqw.mul(1-upm, axis=0)),
        "D always long-short": longw - shortw,
    }
    print(f"momentum +/- shorts, {px.index[0].date()}->{px.index[-1].date()}\n")
    print(f"  {'variant':28s} {'CAGR':>6} {'maxDD':>7} {'Sharpe':>6} {'Calmar':>6} {'Sortino':>7}")
    res = {}
    for nm, W in variants.items():
        r = ret_of(W); res[nm] = r; s = perf_stats(r, ANN)
        print(f"  {nm:28s} {s['cagr']*100:5.0f}% {s['maxdd']*100:6.0f}% {s['sharpe']:6.2f} {s['calmar']:6.2f} {s['sortino']:7.2f}")
    print("\n  per-year (A keeper vs B short-bottom-down vs C short-mkt-down):")
    A, B, C = res["A keeper long-only"], res["B long-up/short-bottom-down"], res["C long-up/short-mkt-down"]
    yA = A.groupby(A.index.year).apply(lambda x:(1+x).prod()-1)
    yB = B.groupby(B.index.year).apply(lambda x:(1+x).prod()-1)
    yC = C.groupby(C.index.year).apply(lambda x:(1+x).prod()-1)
