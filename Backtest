"""M3 -- Market Intraday Momentum (Gao, Han, Li & Zhou, JFE 2018) signal & strategy.

The first half-hour return r1 (previous RTH close -> 10:00, which includes the overnight
move) predicts the last half-hour return rlast (15:30 -> 16:00); combining r1 with the
twelfth half-hour r12 (15:00 -> 15:30) is stronger. The strategy takes a position in the
last half hour in the *direction* of the predictor and is flat otherwise -- one decision
per day, fully known by 15:30, exited at the close. Strictly causal.

This module builds the per-session price table, the signal, and the per-day P&L from
causal RTH bars. Statistical verification lives in ope.validation (M7).
"""
from __future__ import annotations

import datetime as dt
from typing import TYPE_CHECKING

import pandas as pd

from ope.config import MIMConfig
from ope.logging_utils import get_logger

if TYPE_CHECKING:
    from ope.instruments import ContractSpec

_LOG = get_logger("mim")

TABLE_COLUMNS = ("prev_close", "open", "p1000", "p1500", "p1530", "close", "r1", "r12", "rlast")
PNL_COLUMNS = ("position", "gross", "net")
_FULL_SESSION_MIN_CLOSE = dt.time(15, 55)  # drop early-close half days


def _price_at_or_before(b: pd.DataFrame, hh: int, mm: int, col: str = "close") -> float:
    cutoff = dt.time(hh, mm)
    mask = [t.time() <= cutoff for t in b.index]
    sel = b[col][mask]
    return float(sel.iloc[-1]) if len(sel) else float("nan")


def session_price_table(bars: pd.DataFrame) -> pd.DataFrame:
    """Per-session prices and half-hour returns from causal RTH bars.

    Needs ``open``/``close``/``session_date`` (and ``in_rth`` if present). Half-day
    sessions (close before 15:55) are dropped. The first session is dropped (no
    prev_close). Index is ``session_date``.
    """
    if bars.empty:
        return pd.DataFrame(columns=list(TABLE_COLUMNS))
    rth = bars[bars["in_rth"]] if "in_rth" in bars.columns else bars

    idx: list[object] = []
    recs: list[tuple[float, ...]] = []
    for sdate, b in rth.groupby("session_date", sort=True):
        if b.index[-1].time() < _FULL_SESSION_MIN_CLOSE:
            continue
        idx.append(sdate)
        recs.append((
            float(b["open"].iloc[0]),
            _price_at_or_before(b, 10, 0),
            _price_at_or_before(b, 15, 0),
            _price_at_or_before(b, 15, 30),
            float(b["close"].iloc[-1]),
        ))

    t = pd.DataFrame(recs, index=pd.Index(idx, name="session_date"),
                     columns=["open", "p1000", "p1500", "p1530", "close"])
    t["prev_close"] = t["close"].shift(1)
    t["r1"] = t["p1000"] / t["prev_close"] - 1.0
    t["r12"] = t["p1530"] / t["p1500"] - 1.0
    t["rlast"] = t["close"] / t["p1530"] - 1.0
    return t.reindex(columns=list(TABLE_COLUMNS)).dropna(subset=["r1", "rlast"])


def mim_predictor(table: pd.DataFrame, cfg: "MIMConfig | None" = None) -> pd.Series:
    """The predictor series (r1, or r1 + r12), known by 15:30."""
    cfg = cfg or MIMConfig()
    if cfg.predictor == "r1":
        pred = table["r1"]
    else:
        pred = table["r1"] + table["r12"].fillna(0.0)
    return pred.rename("predictor")


def mim_position(table: pd.DataFrame, cfg: "MIMConfig | None" = None) -> pd.Series:
    """Last-half-hour position in {-1, 0, +1} from the predictor's sign (with deadband)."""
    cfg = cfg or MIMConfig()
    pred = mim_predictor(table, cfg)
    band = cfg.deadband_bp * 1e-4
    pos = pd.Series(0, index=table.index, dtype="int64", name="position")
    pos[pred > band] = 1
    pos[pred < -band] = -1
    return pos


def mim_pnl(table: pd.DataFrame, position: pd.Series,
            contract: "ContractSpec | None" = None,
            cfg: "MIMConfig | None" = None) -> pd.DataFrame:
    """Per-day strategy returns: gross = position * rlast; net subtracts round-turn cost."""
    cfg = cfg or MIMConfig()
    gross = (position * table["rlast"]).rename("gross")
    if cfg.use_cost and contract is not None:
        per = table["p1530"] * contract.point_multiplier
        cost = (contract.round_turn_cost() / per).where(position != 0, 0.0)
    else:
        cost = pd.Series(0.0, index=table.index)
    net = (gross - cost).rename("net")
    return pd.DataFrame({"position": position, "gross": gross, "net": net}, index=table.index)


def run_mim(bars: pd.DataFrame, contract: "ContractSpec | None" = None,
            cfg: "MIMConfig | None" = None) -> pd.DataFrame:
    """End-to-end: bars -> price table + position + per-day gross/net returns."""
    cfg = cfg or MIMConfig()
    table = session_price_table(bars)
    pos = mim_position(table, cfg)
    pnl = mim_pnl(table, pos, contract, cfg)
    out = table.join(pnl[list(PNL_COLUMNS)])
    _LOG.info("MIM over %d sessions (predictor=%s)", len(out), cfg.predictor)
    return out

