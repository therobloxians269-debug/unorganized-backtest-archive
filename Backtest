import microbt as M
import numpy as np, pandas as pd

PATH='/Users/kaveh/omni_x/es_front_2017_24h_1m.parquet'
df=M.load(PATH, tf='5min')
NY='America/New_York'
loc=df.index.tz_convert(NY)
mins=(loc.hour*60+loc.minute).to_numpy()
day=np.array(loc.strftime('%Y-%m-%d'))
# RTH bars: 09:30..15:55 (5min bars, label=left; last entry bar open 15:55, 16:00 exit)
rth=(mins>=570)&(mins<960)   # 570=9:30, 960=16:00
o=df['open'].to_numpy();h=df['high'].to_numpy();l=df['low'].to_numpy();c=df['close'].to_numpy()
n=len(df)

# precompute prior-day RTH high/low
tmp=pd.DataFrame({'day':day,'h':h,'l':l,'rth':rth})
dh=tmp[tmp.rth].groupby('day')['h'].max()
dl=tmp[tmp.rth].groupby('day')['l'].min()
uniq_days=list(dh.index)
prior_h={}; prior_l={}
for i in range(1,len(uniq_days)):
    prior_h[uniq_days[i]]=dh.iloc[i-1]
    prior_l[uniq_days[i]]=dl.iloc[i-1]

# group bar indices by day
from collections import defaultdict
byday=defaultdict(list)
for i in range(n):
    if rth[i]: byday[day[i]].append(i)

STOP_BACK_INSIDE=True

def run(stop_back=True, start_after=585):  # 585 = 09:45
    trades=[]
    for d,bars in byday.items():
        if d not in prior_h: continue
        ph=prior_h[d]; pl=prior_l[d]
        entry=None;direction=0
        # find first breakout signal on a bar with minute>=start_after (signal bar), enter next bar
        for k,bi in enumerate(bars):
            if mins[bi]<start_after: continue
            # signal: this bar closed beyond prior H or L (causal: use close of signal bar)
            if c[bi]>ph: direction=1
            elif c[bi]<pl: direction=-1
            else: continue
            # entry at next bar open, must exist same day
            if k+1>=len(bars): break
            entry=bars[k+1]
            break
        if entry is None: continue
        # exit: force 16:00 = close of last RTH bar; or stop back inside
        last=bars[-1]
        exitbar=last
        if stop_back:
            # walk forward from entry; if close crosses back inside the broken level, exit
            for j in range(bars.index(entry),len(bars)):
                bj=bars[j]
                if direction==1 and c[bj]<ph:
                    exitbar=bj; break
                if direction==-1 and c[bj]>pl:
                    exitbar=bj; break
        trades.append((entry,exitbar,direction))
    return trades

for stop in (True,False):
    tr=run(stop_back=stop)
    r=M.evaluate(df,tr,name=f'ydayRB stop={stop}')
    M.show(r)
    yrs=(df.index[-1]-df.index[0]).days/365.25
    print('  trades_per_yr=',round(len(tr)/yrs,1))

