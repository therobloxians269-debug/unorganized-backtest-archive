ticker              = 'MYM=F'
starting_balance    = 1000.00
contract_multiplier = 0.50
margin_per_contract = 50.00
COMMISSION_PER_LOT  = 1.40     # round-trip per contract (alpha variant rate)
 
# Live state
current_pos    = 0       # 1 = Long | -1 = Short | 0 = Flat
entry_price    = 0.0
current_contracts = 0
hold_time      = 0
highest_seen   = 0.0
lowest_seen    = 0.0
last_keep_alive = time.time()
 
print(f"\n--- LIVE ALPHA ENGINE STARTED ON {ticker} ---\n")
 
# ==========================================
# 4. REAL-TIME RUN LOOP
# ==========================================
while True:
    try:
        # --- Keep-alive ping every 10 minutes ---
        if time.time() - last_keep_alive > 600:
            accounts_api.list_accounts()
            last_keep_alive = time.time()
 
        # --- Pull recent hourly data ---
        df = yf.download(ticker, period='15d', interval='1h',
                         progress=False, auto_adjust=True)
        if df.empty:
            print("Data feed temporarily empty. Retrying in 10s...")
            time.sleep(10)
