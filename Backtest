class DataLoader:
    """Three ingestion paths: CSV, yfinance proxy, synthetic generator."""

    @staticmethod
    def from_csv(
        filepath:     str,
        datetime_col: str           = "datetime",
        open_col:     str           = "open",
        high_col:     str           = "high",
        low_col:      str           = "low",
        close_col:    str           = "close",
        volume_col:   str           = "volume",
        tz_input:     str           = "UTC",
        datetime_fmt: Optional[str] = None,
    ) -> pd.DataFrame:
        """
        Load 1-minute OHLCV from a CSV.

        Broker column examples
        ──────────────────────
        NinjaTrader  : datetime_col="Date", tz_input="US/Eastern",
                       datetime_fmt="%Y%m%d %H%M%S"
        TradeStation : datetime_col="Date Time", tz_input="US/Eastern"
        Rithmic      : datetime_col="Timestamp", tz_input="UTC"
        """
        if not os.path.exists(filepath):
            raise FileNotFoundError(f"File not found: {filepath}")
        raw     = pd.read_csv(filepath)
        col_map = {
            datetime_col: "datetime", open_col: "open", high_col: "high",
            low_col: "low", close_col: "close", volume_col: "volume",
        }
        missing = [k for k in col_map if k not in raw.columns]
        if missing:
            raise ValueError(f"CSV missing columns: {missing}\nAvailable: {list(raw.columns)}")
        df = raw[list(col_map)].rename(columns=col_map).copy()
        df["datetime"] = pd.to_datetime(df["datetime"], format=datetime_fmt)
        tz = ZoneInfo(tz_input)
        if df["datetime"].dt.tz is None:
            df["datetime"] = df["datetime"].dt.tz_localize(tz_input)
        df["datetime"] = df["datetime"].dt.tz_convert("UTC")
        df = df.set_index("datetime").sort_index()
        for c in ["open","high","low","close","volume"]:
            df[c] = pd.to_numeric(df[c], errors="coerce")
        logger.info(f"CSV: {len(df):,} bars from {filepath}")
        return df

    @staticmethod
    def from_yfinance(ticker: str, start: str, end: str, interval: str = "1d") -> pd.DataFrame:
        """
        ⚠  PROXY ONLY.  SPY (ES/MES), QQQ (NQ/MNQ), DIA (YM/MYM).
        Not suitable for production futures backtesting.
        """
        try:
            import yfinance as yf
        except ImportError:
            raise ImportError("Run: !pip install yfinance")
        logger.warning(f"yfinance '{ticker}' is a PROXY – not for production.")
        raw = yf.download(ticker, start=start, end=end, interval=interval,
                          progress=False, auto_adjust=True)
        if raw.empty:
            raise ValueError(f"No data: {ticker}")
        df = raw.copy()
        df.columns = [c.lower() if isinstance(c, str) else c[0].lower() for c in df.columns]
        df = df[["open","high","low","close","volume"]]
        if df.index.tzinfo is None:
            df.index = df.index.tz_localize("UTC")
        else:
            df.index = df.index.tz_convert("UTC")
        df.index.name = "datetime"
        return df

    @staticmethod
    def generate_synthetic(
        symbol:       str   = "MES",
        start:        str   = "2023-01-03",
        n_sessions:   int   = 252,
        seed:         int   = 42,
        annual_vol:   float = 0.18,
        annual_drift: float = 0.08,
        start_price:  float = 4500.0,
    ) -> pd.DataFrame:
        """
        Generate synthetic 1-minute RTH-only OHLCV using Geometric Brownian Motion.
        For module integration tests and framework validation only.
        """
        if symbol not in INSTRUMENT_SPECS:
            raise ValueError(f"Unknown symbol: {symbol}")
        spec = INSTRUMENT_SPECS[symbol]
        rng  = np.random.default_rng(seed)

        MINS_PER_YEAR = 252 * 390
        dt            = 1.0 / MINS_PER_YEAR
        vol_pm        = annual_vol * np.sqrt(dt)
        drift_pm      = (annual_drift - 0.5 * annual_vol ** 2) * dt

        def round_tick(v: float) -> float:
            return round(v / spec.tick_size) * spec.tick_size

        bars: List[dict] = []
        price      = start_price
        trade_date = pd.Timestamp(start)
        while trade_date.weekday() >= 5:
            trade_date += pd.Timedelta(days=1)

        sessions_done = 0
        while sessions_done < n_sessions:
            if trade_date.weekday() >= 5:
                trade_date += pd.Timedelta(days=1)
                continue
            price     = max(price * np.exp(rng.normal(0.0, vol_pm * 3.0)), spec.tick_size)
            t_open_et = datetime.combine(trade_date.date(), time(9, 30), tzinfo=_TZ_ET)
            n_bars    = 390
            x         = np.linspace(0.0, 1.0, n_bars)
            vol_mult  = 1.0 + 4.0 * (x - 0.5) ** 2
            base_vol  = 2_000.0 if spec.is_micro else 20_000.0
            volumes   = (vol_mult * base_vol * rng.gamma(1.0, 1.0, n_bars)).astype(int)

            for i in range(n_bars):
                bar_open  = price
                bar_close = bar_open * np.exp(drift_pm + vol_pm * rng.standard_normal())
                excursion = abs(rng.normal(0.0, bar_open * vol_pm * 1.5))
                bar_high  = max(bar_open, bar_close) + excursion
                bar_low   = min(bar_open, bar_close) - abs(rng.normal(0.0, bar_open * vol_pm))
                bar_open, bar_high, bar_low, bar_close = map(
                    round_tick, [bar_open, bar_high, bar_low, bar_close]
                )
                bar_high = max(bar_high, bar_open, bar_close, spec.tick_size)
                bar_low  = max(min(bar_low, bar_open, bar_close), spec.tick_size)
                ts_utc   = (t_open_et + timedelta(minutes=i)).astimezone(_stdlib_tz.utc)
                bars.append({
                    "datetime": ts_utc, "open": bar_open, "high": bar_high,
                    "low": bar_low, "close": bar_close, "volume": volumes[i],
                })
                price = bar_close
            sessions_done += 1
            trade_date += pd.Timedelta(days=1)

        df       = pd.DataFrame(bars).set_index("datetime")
        df.index = pd.DatetimeIndex(df.index, dtype="datetime64[ns, UTC]")
        logger.info(f"Synthetic: {len(df):,} bars | {symbol} | {n_sessions} sessions")
        return df


