        print(f"  {int(y)}: n={int(row['count']):2d}  mean {row['mean']*1e4:7.2f}bps  total {row['sum']*1e4:8.1f}bps")

    print("\n############ COST SENSITIVITY SWEEP (NET ann Sharpe) ############")
    print("  kappa(pt) |    ALL    | QUARTERLY")
    for k in cfg.cost_sweep_kappa:
        ra = cycle_returns(buckets["ALL"], k, cfg.comm_per_side_usd, cfg.instrument, cfg.legs)
        rq = cycle_returns(buckets["QUARTERLY"], k, cfg.comm_per_side_usd, cfg.instrument, cfg.legs)
