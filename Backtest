"""Continuation: price TAKES OUT a calibrated level -> go WITH it. Stop entry, real slippage."""
import numpy as np, pandas as pd, pickle
from ladder import pred

def run(day, rth, P, qe=0.60, qt=0.80, stop_adr=0.30, pv=5.0, comm=1.50, tick=0.25, flat=930, sides=('lo','hi')):
    rows=[]; di={d:i for i,d in enumerate(day.index)}
    for d,bars in rth.groupby('day'):
        if d not in di or len(bars)<300: continue
        i=di[d]; o=day.at[d,'o930']; A=day.at[d,'ADR']
        H=bars['high'].values; L=bars['low'].values; C=bars['close'].values; T=bars['tod'].values; nb=len(bars)
        for side in sides:
            dr = -1 if side=='lo' else 1          # break the LOW band -> go SHORT
            lvl = o - (1 if side=='lo' else -1)*P[(side,qe)][i]*A
            tgt = o - (1 if side=='lo' else -1)*P[(side,qt)][i]*A
            trig = (L<=lvl) if side=='lo' else (H>=lvl)
            w=np.flatnonzero(trig & (T<flat))
            if len(w)==0: continue
            k=w[0]
            ent = lvl - dr*tick*(-1)          # stop order: 1 tick of adverse slippage
            ent = lvl + dr*tick
            stp = ent - dr*stop_adr*A
            risk=abs(ent-stp)
            if risk<1e-9 or abs(tgt-ent)<1e-9 or np.sign(tgt-ent)!=np.sign(dr): continue
            R=np.nan
            for m in range(k+1,nb):
                last=(m==nb-1) or (T[m]>=959)
                hs=(L[m]<=stp) if dr==1 else (H[m]>=stp)
                ht=(H[m]>=tgt) if dr==1 else (L[m]<=tgt)
                if hs:   px=stp-dr*tick; rsn='stop'
                elif ht: px=tgt;         rsn='target'
                elif last: px=C[m];      rsn='time'
                else: continue
                R=(dr*(px-ent)*pv-comm)/(risk*pv)
                rows.append(dict(day=d,side=side,R=R,reason=rsn,risk_pts=risk,
                                 pnl=dr*(px-ent)*pv-comm)); break
    return pd.DataFrame(rows)

