import pandas as pd, numpy as np, warnings; warnings.filterwarnings('ignore')
from vp import profile, race

FLAT=1019   # 16:59 ET

def build24(df, bin_pts=2.0, anchor='sess'):
    """VWAP anchored per 6h QT session (18/00/06/12) or per RTH open; prior-day VP; 24h tradable."""
    out=df.copy()
    m=out.index.hour*60+out.index.minute
    out['minofday']=m
    if anchor=='sess':   key=out['daycycle'].astype(str)+'_'+out['sess'].astype(str)
    elif anchor=='day':  key=out['daycycle'].astype(str)
    else:                key=out['daycycle'].astype(str)+'_'+(m>=570).astype(int).astype(str)
    tp=(out['h']+out['l']+out['c'])/3; pv=tp*out['v']
    cv=out['v'].groupby(key).cumsum(); cpv=pv.groupby(key).cumsum()
    out['vwap']=cpv/cv.replace(0,np.nan)
    var=((tp-out['vwap'])**2*out['v']).groupby(key).cumsum()/cv.replace(0,np.nan)
    out['vsd']=np.sqrt(var.clip(lower=0))
    # prior-day RTH volume profile (causal)
    rth=out[(m>=570)&(m<=959)]
    rows=[]
    for day,g in rth.groupby('daycycle',sort=True):
        p=profile(g,bin_pts)
        if p: p['daycycle']=day; rows.append(p)
    vp=pd.DataFrame(rows).set_index('daycycle').sort_index().shift(1)
    for c in ['poc','val','vah']:
        out['p_'+c]=out['daycycle'].map(vp[c])
    return out

