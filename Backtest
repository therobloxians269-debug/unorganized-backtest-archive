"""Prior check: Market Intraday Momentum (Gao, Han, Li & Zhou 2018) on the ES pilot.

Paper spec (now correct):
  r1   = first half-hour return = prev_close -> 10:00   (INCLUDES overnight gap)
  r12  = twelfth half-hour      = 15:00 -> 15:30
  rlast= last half-hour         = 15:30 -> 16:00        (the trade window)

Strategy eta(r1): at 15:30 go long if r1>0 else short; exit 16:00. eta(r1+r12) uses the
combined predictor sign. Benchmarks: always-long the last half hour, and buy&hold proxy.

WARNING: 23 sessions has ~no statistical power (a Sharpe estimate from 23 days is noise).
This only checks the *sign* agrees with the literature prior and exercises the exact
spec we will validate on real intraday history.

    PYTHONPATH=. python3 research/intraday_momentum_probe.py
"""
from __future__ import annotations

import datetime as dt
from pathlib import Path

import numpy as np
import pandas as pd

from ope.instruments import get_market
from ope.tick_data import load_trades, trades_to_bars

PILOT = Path(__file__).resolve().parents[1] / "all_trades.parquet"


def _at_or_before(b: pd.DataFrame, hh: int, mm: int, col: str = "close") -> float:
    cutoff = dt.time(hh, mm)
    sel = b[[t.time() <= cutoff for t in b.index]]
    return float(sel[col].iloc[-1]) if len(sel) else float("nan")


def _session_table(bars: pd.DataFrame) -> pd.DataFrame:
    recs = []
    for sdate, b in bars.groupby("session_date", sort=True):
        recs.append({
            "session": sdate,
            "open": float(b["open"].iloc[0]),
            "p1000": _at_or_before(b, 10, 0),
            "p1500": _at_or_before(b, 15, 0),
            "p1530": _at_or_before(b, 15, 30),
            "close": float(b["close"].iloc[-1]),
        })
    t = pd.DataFrame(recs).set_index("session")
    t["prev_close"] = t["close"].shift(1)
    t["r1"] = t["p1000"] / t["prev_close"] - 1.0      # paper's first half-hour (incl overnight)
    t["r12"] = t["p1530"] / t["p1500"] - 1.0          # twelfth half-hour
    t["rlast"] = t["close"] / t["p1530"] - 1.0        # last half-hour (trade window)
    return t.dropna(subset=["r1", "rlast"])


def _strategy(name: str, pos: pd.Series, rlast: pd.Series, cost_bp: float) -> None:
    df = pd.concat([np.sign(pos).rename("p"), rlast.rename("r")], axis=1).dropna()
    df = df[df["p"] != 0]
    n = len(df)
    if n < 5:
        print(f"{name:>22}: n={n} (too few)"); return
    net = (df["p"] * df["r"]).to_numpy() * 1e4 - cost_bp
    hit = float((np.sign(df["p"]) == np.sign(df["r"])).mean() * 100)
    sharpe = float(net.mean() / net.std(ddof=1) * np.sqrt(252)) if net.std() > 0 else 0.0
    t = float(net.mean() / (net.std(ddof=1) / np.sqrt(n))) if net.std() > 0 else 0.0
    print(f"{name:>22}: n={n:>3} net={net.mean():+6.2f}bp/day hit={hit:>5.1f}% "
          f"ann.Sharpe~{sharpe:+.2f} t={t:+.2f}")


def main() -> None:
    if not PILOT.exists():
        raise SystemExit(f"pilot parquet not found: {PILOT}")
    print(f"loading {PILOT.name} ...")
    bars = trades_to_bars(load_trades(PILOT), "1min", rth_only=True)
    t = _session_table(bars)
    print(f"sessions: {len(t)} [{t.index.min()} -> {t.index.max()}]")

    mes = get_market("SP500").micro
    mean_px = float(t["close"].mean())
    cost_bp = mes.round_turn_cost() / (mean_px * mes.point_multiplier) * 1e4
    print(f"MES round-turn cost ~ {cost_bp:.2f} bp | mean ES ~ {mean_px:,.0f}\n")

    print("predictor -> last-half-hour return correlations:")
    for nm, x in (("r1 (prev_close->10:00)", t["r1"]), ("r12 (15:00->15:30)", t["r12"]),
                  ("r1+r12", t["r1"] + t["r12"])):
        d = pd.concat([x.rename("x"), t["rlast"].rename("y")], axis=1).dropna()
        print(f"  {nm:>22}: corr={d['x'].corr(d['y']):+.2f}  n={len(d)}")

    print("\nstrategies (net of MES cost):")
    _strategy("eta(r1)", t["r1"], t["rlast"], cost_bp)
    _strategy("eta(r1+r12)", t["r1"] + t["r12"], t["rlast"], cost_bp)
    _strategy("always-long", pd.Series(1.0, index=t.index), t["rlast"], cost_bp)

    print("\nNOTE: 23 sessions -> read sign/hit-rate vs the paper's 54% prior, NOT the Sharpe. "
          "Real validation needs years of intraday data (their drive, free sources, or a "
          "small cheap-OHLCV buy AFTER this looks right).")


if __name__ == "__main__":
    main()

