"""
Monte Carlo + robustness battery on the WHOLE v3 program (weekly returns).
1. Block bootstrap (preserves autocorrelation): distribution of Sharpe / CAGR / maxDD,
   confidence intervals, and tail probabilities (the 'how bad can it get' map).
2. Weight-sensitivity: perturb the 35/25/15/25 sleeve split -> is the result a plateau
   or a knife-edge?
3. Randomized null: destroy the edge, confirm the real Sharpe sits outside the null.

    PYTHONPATH=. python3 monte_carlo.py
"""
from __future__ import annotations
import numpy as np
import pandas as pd
from tear_sheet import build_v3

PPY, BLOCK, N = 52, 8, 10_000
rng = np.random.default_rng(42)


def stats(s):
    sd = s.std()
    sh = s.mean() / sd * np.sqrt(PPY) if sd > 0 else 0.0
    eq = np.cumprod(1 + s)
    dd = (eq / np.maximum.accumulate(eq) - 1).min()
    cagr = eq[-1] ** (PPY / len(s)) - 1
    return sh, cagr, dd


def pct(a, p):
    return np.percentile(a, p)


def main():
    port, j = build_v3()
    w = port.resample("W").sum().dropna().values
    jw = j.resample("W").sum().dropna()
    n = len(w)
    base_sh, base_cagr, base_dd = stats(w)
    print(f"WHOLE PROGRAM v3 — {n} weekly returns ({n/PPY:.1f}y)")
    print(f"actual: Sharpe {base_sh:.2f} | CAGR {base_cagr*100:.1f}% | maxDD {base_dd*100:.1f}%\n")

    # ---- 1. block bootstrap MC ----
    nb = int(np.ceil(n / BLOCK))
    SH = np.empty(N); CG = np.empty(N); DD = np.empty(N)
    for i in range(N):
        starts = rng.integers(0, n, nb)
        idx = (starts[:, None] + np.arange(BLOCK)[None, :]).ravel()[:n] % n
        SH[i], CG[i], DD[i] = stats(w[idx])
    print(f"MONTE CARLO ({N:,} block-bootstrap paths, {BLOCK}-wk blocks):")
    print(f"  {'metric':8s} {'5th':>8} {'median':>8} {'95th':>8}")
    print(f"  {'Sharpe':8s} {pct(SH,5):8.2f} {pct(SH,50):8.2f} {pct(SH,95):8.2f}")
    print(f"  {'CAGR':8s} {pct(CG,5)*100:7.1f}% {pct(CG,50)*100:7.1f}% {pct(CG,95)*100:7.1f}%")
    print(f"  {'maxDD':8s} {pct(DD,5)*100:7.1f}% {pct(DD,50)*100:7.1f}% {pct(DD,95)*100:7.1f}%")
    print(f"\n  tail probabilities:")
    print(f"    P(Sharpe < 1.0) = {(SH<1).mean()*100:.1f}%   P(Sharpe < 0) = {(SH<0).mean()*100:.1f}%")
    print(f"    P(maxDD worse than -20%) = {(DD<-0.20).mean()*100:.1f}%")
    print(f"    P(maxDD worse than -30%) = {(DD<-0.30).mean()*100:.1f}%")
