                  'SWEEP_AT_SOFT_HI','SWEEP_AT_SOFT_LO','SWEEP_AT_HARD_HI','SWEEP_AT_HARD_LO'],
        'SESSION': ['HOUR1','MORNING','MIDDAY','AFTNOON','CLOSING','ABOVE_OPEN','BELOW_OPEN',
