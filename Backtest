"""
nq_probe.py — MECHANISM SCREEN: does the NQ RTH session trend where ES's is driftless?

The intraday kill-ledger (53 ideas, ES+YM, ML sweep) proved equity-index INTRADAY is a
mapped empty set ON ES/YM. The one named untested lever: NQ/MNQ (trends intraday harder,
the driftless-RTH mechanism might break). This is a PRE-REGISTERED screen on free real
NQ hourly (2024-02..2026-07, yfinance) — 4 single-config probes, zero tuning, ES run as
the control (ES should be ~zero; if not, the window itself is regime-flavored).
A pass here justifies buying NQ ohlcv-1m (Databento) for a proper validation. NOT tradeable
evidence by itself: 2.4y window, 4x2 probes of multiplicity, hourly granularity.

Probes (long/short symmetric, enter/exit at bar opens, hold intraday only):
  P1 first-hour momentum : sign(10:00-09:00) -> hold 10:00->16:00
  P2 AM->PM continuation : sign(12:00-09:00) -> hold 13:00->16:00
  P3 gap continuation    : sign(09:00 - prior 16:00) -> hold 09:00->16:00
  P4 VWAP-side persist   : sign(13:00 - session VWAP) -> hold 13:00->16:00
Diagnostics: RTH drift, lag-1 autocorr of RTH hourly returns.
Costs: MNQ $2/pt $2.2 RT ; MES $5/pt $2.5 RT.
"""
import numpy as np, pandas as pd

SCRATCH = "/private/tmp/claude-501/-Users-kaveh/47ca6860-a5eb-42ef-8fcc-4f94d5b1c39c/scratchpad"
SPECS = {"nq": dict(dpp=2.0, rt=2.2), "es": dict(dpp=5.0, rt=2.5),
         "cl": dict(dpp=100.0, rt=3.0)}   # MCL: $100 per $1 of crude, ~$1.24 comm + 1-2 tick slip


def sessions(path):
    df = pd.read_parquet(path)
    df.index = pd.DatetimeIndex(df.index)
    et = df.index
    day = et.normalize()
    out = {}
    for d, g in df.groupby(day):
        hh = g.index.hour
        bars = {h: g.iloc[i] for i, h in enumerate(hh)}
        if not all(h in bars for h in (9, 10, 12, 13, 15, 16)):
            continue
        rth = g[(hh >= 9) & (hh <= 15)]
        pv = (rth["close"] * rth["volume"]).cumsum()
        vv = rth["volume"].cumsum()
        vwap13 = float(pv.iloc[3] / vv.iloc[3]) if vv.iloc[3] > 0 else np.nan  # through 12:00 bar
        out[d] = dict(o9=bars[9]["open"], o10=bars[10]["open"], o12=bars[12]["open"],
                      o13=bars[13]["open"], o16=bars[16]["open"], c15=bars[15]["close"],
                      vwap13=vwap13,
                      rth_rets=rth["close"].pct_change().dropna().to_numpy())
    return out


def tstat(x):
    x = np.asarray(x, float)
    return x.mean() / x.std() * np.sqrt(len(x)) if len(x) > 4 and x.std() > 0 else 0.0


def report(name, spec, S):
    days = sorted(S)
    dpp, rt = spec["dpp"], spec["rt"]
    rows = {p: [] for p in ("P1_first_hour_mom", "P2_am_pm_cont", "P3_gap_cont", "P4_vwap_side")}
    prev_close = None
    ac, drift = [], []
    for d in days:
        s = S[d]
        drift.append(s["o16"] - s["o9"])
        if len(s["rth_rets"]) > 2:
            r = s["rth_rets"]
            if np.std(r[:-1]) > 0 and np.std(r[1:]) > 0:
                ac.append(np.corrcoef(r[:-1], r[1:])[0, 1])
        sig1 = np.sign(s["o10"] - s["o9"])
        if sig1: rows["P1_first_hour_mom"].append(sig1 * (s["o16"] - s["o10"]) * dpp - rt)
        sig2 = np.sign(s["o12"] - s["o9"])
        if sig2: rows["P2_am_pm_cont"].append(sig2 * (s["o16"] - s["o13"]) * dpp - rt)
        if prev_close is not None:
            sig3 = np.sign(s["o9"] - prev_close)
            if sig3: rows["P3_gap_cont"].append(sig3 * (s["o16"] - s["o9"]) * dpp - rt)
        if np.isfinite(s["vwap13"]):
            sig4 = np.sign(s["o13"] - s["vwap13"])
            if sig4: rows["P4_vwap_side"].append(sig4 * (s["o16"] - s["o13"]) * dpp - rt)
        prev_close = s["c15"]
    print(f"\n{name.upper()}  ({len(days)} sessions, {days[0].date()}..{days[-1].date()}, "
          f"micro ${dpp}/pt, ${rt} RT)")
    print(f"  RTH drift 09->16: {np.mean(drift):+.2f} pts/day (t={tstat(drift):+.2f})   "
          f"lag-1 hourly autocorr: {np.mean(ac):+.3f}")
    for p, pnl in rows.items():
        pnl = np.array(pnl)
        gross = pnl + rt
        half = len(pnl) // 2
        print(f"  {p:20} n={len(pnl):3d}  net=${pnl.mean():+6.2f}/tr (t={tstat(pnl):+5.2f})  "
              f"gross=${gross.mean():+6.2f}  1st-half t={tstat(pnl[:half]):+5.2f}  "
              f"2nd-half t={tstat(pnl[half:]):+5.2f}")


if __name__ == "__main__":
    for name, spec in SPECS.items():
        report(name, spec, sessions(f"{SCRATCH}/{name}_1h.parquet"))
    print("\nNOTE: 2.4y window, 8 probe-cells of multiplicity — a PASS here only justifies "
          "buying NQ 1m data for real validation; it is not tradeable evidence.")

