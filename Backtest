"""Validate MIM on the real 16-year ES 1-min history (Databento ES.FUT parent dbn).

The purchased file is the ES.FUT parent (all expiries + calendar spreads), so we build a
continuous FRONT-MONTH series ourselves:
  1. drop calendar spreads (symbols with '-'); keep outright futures (keyed by instrument_id)
  2. shift ohlcv left-labels to right-edges (bar at HH:MM closes at HH:MM); convert to ET
  3. per session, the front contract = the outright with the most RTH volume
  4. prev_close uses the SAME front contract's prior-session close (no roll-gap pollution)

Then run the MIM config grid through the gauntlet and report the verdict.

    PYTHONPATH=. python3 research/validate_mim_real.py
"""
from __future__ import annotations

import datetime as dt
import glob
from pathlib import Path

import numpy as np
import pandas as pd

from ope.config import Config, MIMConfig
from ope.instruments import get_market
from ope.mim import mim_pnl, mim_position
from ope.validation import gauntlet_summary, perf_stats

ROOT = Path(__file__).resolve().parents[1]
DBN_GLOB = "/Users/kaveh/Downloads/GLBX-*/*ohlcv-1m*.dbn.zst"
CACHE = ROOT / "data" / "es_outright_1m.parquet"


def load_outrights() -> pd.DataFrame:
    if CACHE.exists():
        return pd.read_parquet(CACHE)
    import databento as db
    f = sorted(glob.glob(DBN_GLOB))[-1]
    print(f"decoding {Path(f).name} (one-time) ...")
    df = db.DBNStore.from_file(f).to_df().reset_index()
    df = df[~df["symbol"].str.contains("-", na=False)]  # drop calendar spreads
    df = df[["ts_event", "instrument_id", "symbol", "open", "high", "low", "close", "volume"]]
    CACHE.parent.mkdir(parents=True, exist_ok=True)
    df.to_parquet(CACHE)
    print(f"cached outrights -> {CACHE} ({len(df):,} rows)")
    return df


def front_month_table(df: pd.DataFrame) -> pd.DataFrame:
    et = (pd.DatetimeIndex(pd.to_datetime(df["ts_event"], utc=True))
          + pd.Timedelta(minutes=1)).tz_convert("America/New_York")
    df = df.assign(_t=et, session_date=et.date, _time=et.time)
    rth = df[(df["_time"] > dt.time(9, 30)) & (df["_time"] <= dt.time(16, 0))].sort_values("_t")

    key = ["instrument_id", "session_date"]
    g = rth.groupby(key, sort=False)
    per = pd.DataFrame({
        "open": g["open"].first(),
        "close": g["close"].last(),
        "volume": g["volume"].sum(),
    })

    def price_before(hh: int, mm: int) -> pd.Series:
        sub = rth[rth["_time"] <= dt.time(hh, mm)]
        return sub.groupby(key)["close"].last()

    per["p1000"] = price_before(10, 0)
    per["p1500"] = price_before(15, 0)
    per["p1530"] = price_before(15, 30)
    per = per.reset_index()

    front = per.loc[per.groupby("session_date")["volume"].idxmax()].set_index("session_date")
    close_map = per.set_index(["instrument_id", "session_date"])["close"]

    sessions = sorted(front.index)
    recs = []
    for i, sd in enumerate(sessions):
        r = front.loc[sd]
        prev_sd = sessions[i - 1] if i else None
        prev_close = close_map.get((r["instrument_id"], prev_sd)) if prev_sd else np.nan
        recs.append((sd, prev_close, r["open"], r["p1000"], r["p1500"], r["p1530"], r["close"]))

    t = pd.DataFrame(recs, columns=["session_date", "prev_close", "open", "p1000",
                                    "p1500", "p1530", "close"]).set_index("session_date")
    t["r1"] = t["p1000"] / t["prev_close"] - 1.0
    t["r12"] = t["p1530"] / t["p1500"] - 1.0
    t["rlast"] = t["close"] / t["p1530"] - 1.0
    return t.dropna(subset=["r1", "rlast"])


def main() -> None:
    table = front_month_table(load_outrights())
    mes = get_market("SP500").micro
    print(f"front-month sessions: {len(table)} [{table.index.min()} -> {table.index.max()}]\n")

    grid = {f"{p}_db{int(d)}": MIMConfig(predictor=p, deadband_bp=d, use_cost=True)
