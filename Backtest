"""
APEX PLAYBOOK: full eval -> funded economics, with the P-increasing levers, optimized for
LOW DRAWDOWN + scalable profit (run many low-vol accounts rather than one risky one).

Answers:
  - eval PASS% (with daily loss-limit lever)
  - funded SURVIVE-1yr% (don't bust the trailing DD)
  - expected ANNUAL RETURN per funded $50k (gross %, and kept $ after 90% split)
  - the low-DD frontier + multi-account scaling (the real low-risk/high-profit path)

    python3 apex_playbook.py
"""
from __future__ import annotations
import numpy as np
from apex_sim import trend_returns, START, TARGET, TRAIL, LOCK, BLOCK

TRIALS, H = 40_000, 252
SPLIT = 0.90
FEE = 150.0


def paths(z, sd, rng, losslimit):
    nb = int(np.ceil(H / BLOCK))
    s = rng.integers(0, len(z), size=(TRIALS, nb))
    gi = (s[:, :, None] + np.arange(BLOCK)[None, None, :]).reshape(TRIALS, -1)[:, :H] % len(z)
    pnl = z[gi] * sd
    if losslimit:
        pnl = np.maximum(pnl, -losslimit)
    eq = START + np.cumsum(pnl, axis=1)
    peak = np.maximum.accumulate(eq, axis=1)
    floor = np.minimum(peak - TRAIL, LOCK)
    bust = eq <= floor
    return eq, bust


def evaluate(z, vol_pct, rng, losslimit):
    sd = vol_pct * START / np.sqrt(H)                 # daily $ vol from annual vol% of 50k
    eq, bust = paths(z, sd, rng, losslimit)
    first_bust = np.where(bust.any(1), bust.argmax(1), H + 1)
    # EVAL: reach +3000 before bust
    win = eq >= TARGET
    first_win = np.where(win.any(1), win.argmax(1), H + 2)
    eval_pass = (first_win < first_bust).mean()
    # FUNDED: trade 1 yr; survive = never bust; end P&L (busted -> account lost)
    survived = ~bust.any(1)
    end_pnl = np.where(survived, eq[:, -1] - START, 0.0)        # kept profit only if survived
    e_gross_pct = end_pnl.mean() / START
    e_kept = SPLIT * np.maximum(end_pnl, 0).mean()
    return eval_pass, survived.mean(), e_gross_pct, e_kept


def main():
    net = trend_returns()
    z = (net / net.std()).values
    sh = net.mean() / net.std() * np.sqrt(252)
    dvol = net.std()
    print(f"generator: futures trend, Sharpe {sh:.2f}\n")
    # daily loss-limit at ~1.5x the daily $ vol (the validated +14pp lever); set per vol level
    rng = np.random.default_rng(11)
    print(f"  {'annual vol':>10} {'$vol/day':>9} {'EVAL pass':>10} {'FUND survive':>12} "
          f"{'ann gross':>10} {'ann kept $':>11}")
    rows = []
    for v in (0.05, 0.07, 0.09, 0.11, 0.13):
        sd = v * START / np.sqrt(H)
        ll = 1.5 * sd                                  # daily loss-limit lever
        ep, sv, gp, kept = evaluate(z, v, rng, ll)
        rows.append((v, kept, sv, ep))
        print(f"  {v*100:9.0f}% {sd:8.0f}$ {ep*100:9.1f}% {sv*100:11.1f}% "
              f"{gp*100:9.1f}% {kept:10.0f}$")

    # multi-account scaling at the low-DD sweet spot (max survive while still earning)
    v, kept, sv, ep = max(rows, key=lambda r: r[1] * r[2])     # best kept*survive
    print(f"\n  SWEET SPOT ~{v*100:.0f}% vol: eval {ep*100:.0f}% | survive {sv*100:.0f}% | "
          f"~${kept:.0f}/yr kept per funded $50k")
    print("  scale by running MANY low-vol accounts (personal risk = eval fees only):")
    print(f"    {'#accts':>7} {'funded cap':>11} {'~ann income':>12} {'personal risk':>14}")
    for n in (1, 3, 5, 10, 20):
        # P(funded eventually) ~ 1-(1-eval_p)^2 over 2 cheap tries; income = n * kept * survive-weight
        pfund = 1 - (1 - ep) ** 2
        income = n * kept * pfund
        risk = n * FEE * 2                              # ~2 eval attempts each
        print(f"    {n:6d} ${n*50_000:>9,} ${income:>10,.0f} ${risk:>12,.0f}")
    print("\n  KEY: your personal drawdown is capped at eval fees; the $50k DD is the firm's.")
    print("  Low per-account vol -> high survival -> compound by ADDING accounts, not leverage.")


if __name__ == "__main__":
