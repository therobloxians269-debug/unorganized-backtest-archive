"""M0: loader + integrity. Shared by all modules."""
import pandas as pd, numpy as np

NQ  = '/Users/kaveh/qt_cascade/nq.parquet'
MNQ = '/Users/kaveh/qt_cascade/mnq.parquet'

def load(path, rth_only=True):
    d = pd.read_parquet(path)
    d.index.name = 'ts'
    d = d[['o','h','l','c','v','es_high','es_low','es_close','ym_close']].copy()
    d = d[~d.index.duplicated(keep='first')].sort_index()
    # session date = ET calendar date of the RTH day
    d['tod'] = d.index.hour*60 + d.index.minute
    d['date'] = d.index.normalize().tz_localize(None)
    if rth_only:
        d = d[(d.tod >= 9*60+30) & (d.tod <= 16*60)]
    return d

def integrity(d, name):
    bad_hl  = (d.h < d.l).sum()
    bad_oc  = ((d.o > d.h)|(d.o < d.l)|(d.c > d.h)|(d.c < d.l)).sum()
    zero_v  = (d.v <= 0).sum()
    jumps   = d.c.pct_change().abs()
    print(f'[{name}] rows={len(d):,} sessions={d.date.nunique()} '
          f'{d.index.min()} -> {d.index.max()}')
    print(f'   bad h<l={bad_hl}  o/c outside h/l={bad_oc}  zero-vol bars={zero_v}')
    print(f'   |ret| max={jumps.max():.4%}  p99.99={jumps.quantile(0.9999):.4%}')
    bpd = d.groupby('date').size()
    print(f'   bars/session median={bpd.median():.0f} min={bpd.min()} max={bpd.max()}')
    short = (bpd < 300).sum()
    print(f'   short sessions (<300 bars, half-days): {short}')
    return dict(rows=len(d), sessions=d.date.nunique())

if __name__ == '__main__':
    for p,n in [(NQ,'NQ dev'),(MNQ,'MNQ holdout')]:
        integrity(load(p), n); print()

