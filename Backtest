"""
Does the MNQ 2026 bias survive a WARM offset?

The MNQ file begins 2026-01-15 with no prior history, so the trailing regime offset
has nothing to warm on and spends the entire 83-session sample catching up. That is
an artifact of how the two files were cut, not a property of the model: NQ and MNQ
quote the same index (NQ file ends 2025-12-11, MNQ picks up 2026-01-15), so live the
window would already be warm.

Here the two event frames are concatenated into one continuous NQ-complex series, the
causal offset is run across the join, and ONLY the 2026 slice is scored. Still fully
causal — 2026 sessions are calibrated using 2025 data, never themselves.
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')
import calib as CB
from m1_model import Model, build_events
from m2_calib import brier, bias_ci, reliability

ev = {w: build_events(w) for w in ('ES', 'NQ', 'MNQ')}
es = ev['ES']
tr = es[es.day <= '2019-12-31']
full = Model().fit(tr)

nqx = pd.concat([ev['NQ'], ev['MNQ']], ignore_index=True).sort_values(['day', 't', 'side'])
print(f'combined NQ complex: {nqx.day.min().date()} -> {nqx.day.max().date()}  '
      f'{nqx.day.nunique()} sessions  (gap at the file join: '
      f'{ev["NQ"].day.max().date()} -> {ev["MNQ"].day.min().date()})')

p = full.predict(nqx)
off = CB.rolling_offset(nqx, p, K=60)
padj = CB.apply_offset(nqx, p, off)

m26 = (nqx.day >= '2026-01-01').values
print(f'\n2026 slice: {m26.sum():,} events / {nqx[m26].day.nunique()} sessions')
print(f'offset in force during 2026: mean {off[off.index >= "2026-01-01"].mean():+.3f} '
      f'(vs {off[off.index < "2026-01-01"].mean():+.3f} before)')

for lab, pp in (('cold (file-split, as in M2)', full.predict(ev['MNQ'])),
                ('WARM (history joined)      ', padj[m26])):
    d = ev['MNQ'] if lab.startswith('cold') else nqx[m26]
    b, lo, hi, nd = bias_ci(d, pp)
    print(f'\n  {lab}  Brier {brier(d.surv.values, pp):.4f}   '
          f'traded-region bias {b:+.4f}  CI [{lo:+.4f},{hi:+.4f}]  '
          f'[{"calibrated" if lo <= 0 <= hi else "BIASED"}]')
    r = reliability(d.surv.values.astype(int), np.asarray(pp))
    for _, q in r.iterrows():
        print(f'      {q.band:<12}{q.n:>7,}{q.pred:>8.3f}{q.actual:>9.3f}{q.actual-q.pred:>+8.3f}')

