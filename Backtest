    """BSL / SSL — prior day and prior session extremes."""
    out=[]
    for key,lab in [('dkey','PDH/PDL'),('skey','PSH/PSL')]:
        g=b.groupby(key,sort=False)
        hi=g['h'].max().shift(1); lo=g['l'].min().shift(1); t0=g.apply(lambda x: x.index[0])
        for k in hi.index:
            if np.isfinite(hi.get(k,np.nan)):
                out.append(dict(kind=lab+' BSL',px=hi[k],known=t0[k]))
                out.append(dict(kind=lab+' SSL',px=lo[k],known=t0[k]))
    return pd.DataFrame(out)

def levels_fvg_ob(b, tf=15, disp_atr=1.0):
    r=b.resample(f'{tf}min',label='left',closed='left').agg(
        {'o':'first','h':'max','l':'min','c':'last'}).dropna()
    tr=pd.concat([r.h-r.l,(r.h-r.c.shift()).abs(),(r.l-r.c.shift()).abs()],axis=1).max(axis=1)
    a=tr.rolling(14).mean().values
    o,h,l,c=r['o'].values,r['h'].values,r['l'].values,r['c'].values; t=r.index; out=[]
    for i in range(3,len(r)):
        kn=t[i]+pd.Timedelta(minutes=tf)
        if l[i]>h[i-2]: out.append(dict(kind='FVG',px=(h[i-2]+l[i])/2,known=kn))
        if h[i]<l[i-2]: out.append(dict(kind='FVG',px=(h[i]+l[i-2])/2,known=kn))
        if np.isfinite(a[i]) and a[i]>0 and abs(c[i]-o[i-2])>disp_atr*a[i]:
            up=c[i]>o[i-2]
            for q in range(i-1,max(i-6,0),-1):
                if (up and c[q]<o[q]) or ((not up) and c[q]>o[q]):
                    out.append(dict(kind='OB',px=(max(o[q],c[q])+min(o[q],c[q]))/2,known=kn)); break
    return pd.DataFrame(out)

def react(b, L, barrier=0.5, displace=None, seed=0, horizon=390):
    """on first touch: does price move `barrier`*ATR AWAY before it moves that far THROUGH?"""
    idx=b.index; h=b['h'].values; l=b['l'].values; c=b['c'].values
    atr=b['atr60'].values; m=b['minofday'].values; n=len(b)
    rng=np.random.default_rng(seed); res=[]
    for _,r in L.iterrows():
        px=r.px
        if displace is not None:
            px=px+displace*(1 if rng.random()<.5 else -1)
        s=idx.searchsorted(r.known)
        if s>=n-10: continue
        e=min(s+horizon,n)
        seg_h=h[s:e]; seg_l=l[s:e]
        tp=np.where((seg_l<=px)&(seg_h>=px))[0]
        if len(tp)==0: continue
        j=s+int(tp[0])
        a=atr[j] if np.isfinite(atr[j]) and atr[j]>0 else 30.0
        bar=barrier*a; ref=c[j]
        above=ref>=px
        up_t=ref+bar; dn_t=ref-bar
        k=j+1; hit=None
        while k<e:
            if h[k]>=up_t: hit='up'; break
            if l[k]<=dn_t: hit='dn'; break
            k+=1
        if hit is None: continue
        # "react" = pushed back the way it came
        res.append((hit=='up') if above else (hit=='dn'))
    return np.array(res)

