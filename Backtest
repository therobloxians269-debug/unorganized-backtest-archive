"""
models.py — the plays.

This is where the discretionary decision tree becomes mechanical. All three
flagship ICT models are the *same* sequence with different time/where filters,
so they share one pipeline (DRY, and honest about the fact that they are cousins):

    1. DRAW / BIAS   HTF is drawing one way (bias.py). We only hunt that way.
    2. RAID          A liquidity pool is swept against the bias — the stop-run
                     that funds the move (liquidity.find_sweeps).
    3. SHIFT (MSS)   Price displaces back through structure in the bias direction,
                     leaving an FVG — a plain CHoCH upgraded by displacement into a
                     Market Structure Shift (structure.py + imbalance.displacement_at).
    4. ENTRY         A limit at the FVG's Consequent Encroachment (or the Order
                     Block), ideally in discount/premium and the 62–79% OTE.
    5. STOP          Just beyond the raid extreme (that's where it's "wrong").
    6. TARGET        The opposing draw on liquidity (old high/low, POC, value edge).

Confluences (SMT divergence, OTE, premium/discount, LVN overlap, killzone) each
add to a setup's score; a preset can *require* any of them. Presets:

    ict2022        the flagship; any killzone, any pool, bias + displacement.
    silver_bullet  restricted to the 10–11 ET (and 14–15 ET) window; bias-strict.
    judas          London-killzone raid of the Asian/London range (Power-of-3).
"""
from __future__ import annotations

from dataclasses import dataclass, field
import numpy as np
import pandas as pd

from . import sessions as _sessions
from .imbalance import FVG, displacement_at, order_block_before
from .premium_discount import current_range, in_ote
from .smt import smt_confirms
from .volume_profile import VolumeProfile


@dataclass
class ModelConfig:
    name: str
    killzones: tuple[str, ...]          # empty => any time
    pool_types: tuple[str, ...]         # empty => any pool
    require_bias: bool = True
    require_displacement: bool = True
    require_smt: bool = False
    require_ote: bool = False
    require_discount_premium: bool = False
    mss_window: int = 20                # bars from raid to accept an MSS
    entry_valid_bars: int = 40          # pending-order lifetime
    stop_buffer_ticks: float = 4.0
    min_rr: float = 2.0                 # skip setups that can't reach this
    rr_target: float = 3.0             # fallback target if no pool qualifies
    min_score: int = 0
    use_order_block_fallback: bool = True
    entry_mode: str = "ce"              # 'edge' first-touch | 'ce' 50% | 'far' deep fill


