"""
bias.py — top-down higher-timeframe bias (the "which way am I hunting" filter).

No ICT setup is taken in isolation: the entry timeframe only executes *in the
direction the higher timeframe is drawing*. This module derives a causal HTF
trend by running the same structure engine on a resampled feed, then projects it
onto every base bar using each HTF bar's *close* time (never its open) so there
is no look-ahead. Optionally it tilts with premium/discount of the HTF range.
"""
from __future__ import annotations

import numpy as np
import pandas as pd

from . import data as _data
from .structure import find_swings, track_structure


_TF_DELTA = {
    "15m": pd.Timedelta(minutes=15),
    "30m": pd.Timedelta(minutes=30),
    "1h": pd.Timedelta(hours=1),
    "4h": pd.Timedelta(hours=4),
    "1d": pd.Timedelta(days=1),
}


def htf_bias_series(base_df: pd.DataFrame, htf: str = "1h",
                    left: int = 2, right: int = 2) -> pd.Series:
    """A {+1,-1,0} bias for every base bar, from HTF structure, fully causal.

    The HTF trend flips at a structure event; that flip only becomes actionable
    once the HTF bar that produced it has *closed*, which is HTF-open + one HTF
    period. Each base bar inherits the trend in force as of its own timestamp.
    """
    htf_df = _data.resample(base_df, htf)
    if len(htf_df) < (left + right + 2):
        return pd.Series(0, index=base_df.index)

    swings = find_swings(htf_df, left, right)
    events = track_structure(htf_df, swings)

    delta = _TF_DELTA.get(htf, pd.Timedelta(hours=1))
    # Build (effective_time, trend) change-points.
    changes = []
    for ev in events:
        eff = htf_df.index[ev.idx] + delta  # bar close time
        changes.append((eff, ev.direction))
    if not changes:
        return pd.Series(0, index=base_df.index)

    change_times = pd.DatetimeIndex([c[0] for c in changes])
    change_vals = np.array([c[1] for c in changes])
    order = np.argsort(change_times.values)
    change_times = change_times[order]
    change_vals = change_vals[order]

    # For each base bar, the trend is the last change whose time <= bar time.
    pos = np.searchsorted(change_times.values, base_df.index.values, side="right") - 1
    bias = np.where(pos >= 0, change_vals[np.clip(pos, 0, len(change_vals) - 1)], 0)
    return pd.Series(bias, index=base_df.index, name=f"bias_{htf}")

