"""Paper-documented factors tested as DIVERSIFIERS to the trend+momentum core, to push the
combined program toward <10% max drawdown (diversification is the only honest DD lever).

New sleeves (all price-only, computable from data we have):
  BAB   Betting-Against-Beta      Frazzini & Pedersen (2014)   long low-beta / short high-beta
  RMOM  Residual momentum         Blitz, Huij & Martens (2011) 12-1 momentum on market residuals
  TOM   Turn-of-the-month         Ariel (1987)                 long SPY ~4 days around month-end

For each: standalone Sharpe (full/OOS), beta, and correlation to the existing combo. Then
stack the positive + uncorrelated ones risk-parity with trend+momentum and report Sharpe, DD,
PSR vs 1.0 -- and the vol-target needed to hold DD under 10%.

    PYTHONPATH=. python3 research/factor_zoo.py
"""
from __future__ import annotations

import numpy as np
import pandas as pd

from ope.trend import ETF_BASKET, ETF_COST_BP, backtest
from ope.validation import perf_stats, probabilistic_sharpe_ratio
from research.xs_equity import sp500_tickers, zscore

ANN, TGT, WIN, CAP, COST_BP = 252.0, 0.10, 63, 3.0, 3.0
OOS = "2022-01-01"


def vt_net(w, rets, cost_bp=COST_BP):
    g = (w * rets).sum(axis=1)
    sc = (TGT / (g.rolling(WIN).std() * np.sqrt(ANN))).shift(1).clip(0, CAP).fillna(0.0)
    w = w.mul(sc, axis=0)
    return ((w * rets).sum(axis=1) - w.diff().abs().sum(axis=1) * cost_bp * 1e-4).dropna()


def ls_weights(score):
    w = zscore(score).shift(1)
    w = w.sub(w.mean(axis=1), axis=0)
    return w.div(w.abs().sum(axis=1).replace(0, np.nan), axis=0)


def maxdd(r):
    eq = (1 + r).cumprod()
    return float((eq / eq.cummax() - 1).min())


def main():
    import yfinance as yf
    spx = yf.download(sp500_tickers(), start="2010-01-01", auto_adjust=True, progress=False)["Close"]
    spx = spx.dropna(how="all").dropna(axis=1, thresh=int(len(spx) * 0.6))
    spx = spx[spx.columns[spx.iloc[-1].notna()]]
    rets = spx.pct_change()
    spy = yf.download("SPY", start="2010-01-01", auto_adjust=True, progress=False)["Close"].squeeze()
    spyr = spy.pct_change().reindex(rets.index)

    # rolling 1y beta of every stock to SPY
    cov = rets.mul(spyr, axis=0).rolling(252).mean().sub(
        rets.rolling(252).mean().mul(spyr.rolling(252).mean(), axis=0))
    beta = cov.div(spyr.rolling(252).var(), axis=0)

    # --- new factors ---
    bab = vt_net(ls_weights(-beta), rets)                              # long low-beta
    resid = rets.sub(beta.shift(1).mul(spyr, axis=0))                  # market-residual returns
    cumr = resid.fillna(0).cumsum()
    rmom = vt_net(ls_weights(cumr.shift(21) - cumr.shift(252)), rets)  # 12-1 residual momentum
    # turn-of-month: long SPY on last trading day + first 3 of next month
    tdom = spyr.groupby([spyr.index.year, spyr.index.month]).cumcount()
    rev = spyr.groupby([spyr.index.year, spyr.index.month]).transform(lambda s: len(s) - 1 - np.arange(len(s)))
    tom_pos = ((rev <= 0) | (tdom <= 2)).astype(float)
    tom = (tom_pos.shift(1) * spyr).dropna()
    tom = tom * (TGT / (tom.rolling(WIN).std() * np.sqrt(ANN))).shift(1).clip(0, CAP).fillna(0.0)
    tom = tom.dropna()

    # --- existing core ---
    etf = yf.download(ETF_BASKET, start="2006-01-01", auto_adjust=True, progress=False)["Close"]
    etf = etf.dropna(how="all").dropna(axis=1, thresh=int(len(etf) * 0.4))
    trend = backtest(etf, cost_bp={k: v for k, v in ETF_COST_BP.items() if k in etf.columns}).net
    mom = vt_net(ls_weights(spx.shift(21) / spx.shift(252) - 1.0), rets)

    j = pd.concat({"trend": trend, "mom": mom}, axis=1).dropna()
    core = (0.5 * j["trend"] / j["trend"].std() + 0.5 * j["mom"] / j["mom"].std())
    core = core * (TGT / np.sqrt(ANN)) / core.std()

    print(f"period {core.index[0].date()} -> {core.index[-1].date()}\n")
    print(f"  {'sleeve':<8} {'Sharpe':>7} {'OOS':>6} {'maxDD':>7} {'beta':>6} {'corr_core':>10}")
    cand = {}
    for name, r in [("trend", trend), ("mom", mom), ("BAB", bab), ("RMOM", rmom), ("TOM", tom)]:
        rr = r.reindex(core.index).dropna()
        s, o = perf_stats(rr), perf_stats(rr[rr.index >= OOS])
        bb = pd.concat([rr, spyr], axis=1).dropna()
        beta_s = bb.cov().iloc[0, 1] / bb.iloc[:, 1].var()
        cc = pd.concat([rr, core], axis=1).dropna().corr().iloc[0, 1]
        print(f"  {name:<8} {s['sharpe']:7.2f} {o['sharpe']:6.2f} {s['max_drawdown']*100:6.1f}% "
              f"{beta_s:+6.2f} {cc:+10.2f}")
        cand[name] = rr

    # stack new sleeves that are positive AND low-correlation to the core
    add = [n for n in ("BAB", "RMOM", "TOM")
           if perf_stats(cand[n])["sharpe"] > 0.1
           and abs(pd.concat([cand[n], core], axis=1).dropna().corr().iloc[0, 1]) < 0.4]
    print(f"\n  diversifiers kept (Sharpe>0.1, |corr|<0.4): {add}")
    sleeves = ["trend", "mom"] + add
    z = pd.concat({n: cand[n] for n in sleeves}, axis=1).dropna()
    zz = z.div(z.std())
    stack = zz.mean(axis=1)
    stack = stack * (TGT / np.sqrt(ANN)) / stack.std()
    s = perf_stats(stack)
    print(f"\n  STACK {sleeves}:")
    print(f"    Sharpe {s['sharpe']:.2f} (OOS {perf_stats(stack[stack.index>=OOS])['sharpe']:.2f}) "
          f"| ann {s['ann_return']*100:.1f}% | maxDD {s['max_drawdown']*100:.1f}% "
          f"| PSR>1.0 {probabilistic_sharpe_ratio(stack,1.0/np.sqrt(ANN))*100:.1f}%")
    # vol-target so DD ~ <10%
    for vt in (0.10, 0.08, 0.06):
        sc = vt / np.sqrt(ANN) / stack.std()
        r = stack * sc
        print(f"    @ vol {vt*100:.0f}%: ann {r.mean()*ANN*100:4.1f}% | maxDD {maxdd(r)*100:5.1f}% "
              f"| Sharpe {r.mean()/r.std()*np.sqrt(ANN):.2f}")


if __name__ == "__main__":
    main()

