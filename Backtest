"""
FORCED FLOW · F2 — is the VWAP LEAN real, or is it drift wearing a costume?

The baseline "below VWAP -> long, hold to the close" printed +0.1399 ADR at t=+14.16
on ES TRAIN. Three things have to be true before that means anything:

  1. DRIFT CONTROL. ES rises over the sample. Being long at 11:00 pays something
     regardless of VWAP. The signal must beat a time-of-day-matched UNCONDITIONAL
     long — that is the honest excess.
  2. NOT ALREADY DEAD. The program killed the VWAP sigma-fade at every sigma
     ("stretched price continues"). If this is monotone in deviation it contradicts
     that; if it flips sign at large deviations it CONFIRMS it and the survivor is
     only the small-deviation region. Measure the deviation deciles.
  3. TRADEABLE. One trade per day, costs charged, TRAIN -> DEV -> NQ/MNQ.
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')
import data as D, absorb as AB, sim as S
from f1_absorb import build

rng = np.random.default_rng(31)


def excess_vs_drift(s, mask, col='y', sign=+1, n_draw=300):
    """Signal minus a time-of-day-matched UNCONDITIONAL long. The drift control."""
    fired = s[mask]
    if len(fired) < 50:
        return np.nan, np.nan, np.nan, 0
    mu, t, n = AB.daycluster(sign * fired[col], fired.day)
    counts = fired.groupby('t').size()
    pool = {tt: g.index.values for tt, g in s.groupby('t')}
    out = []
    for _ in range(n_draw):
        pick = [rng.choice(pool[tt], size=min(c, len(pool[tt])), replace=False)
                for tt, c in counts.items() if tt in pool and len(pool[tt])]
        if not pick:
            continue
        g = s.loc[np.concatenate(pick)]
        m2, _, _ = AB.daycluster(sign * g[col], g.day)
        out.append(m2)
    out = np.array([o for o in out if np.isfinite(o)])
    if not len(out):
        return mu, np.nan, np.nan, n
    return mu, float(out.mean()), (mu - out.mean()) / (out.std() + 1e-12), n


def dec_table(s, by='dev', col='y', q=10, label=''):
    d = s.dropna(subset=[by, col]).copy()
    d['b'] = pd.qcut(d[by], q, labels=False, duplicates='drop')
    print(f'\n  {label}  ({by} deciles; y = return to close, ADR units)')
    print(f'    {"dec":<5}{"n":>7}{"med "+by:>11}{"mean y":>11}{"t(day)":>9}')
    for i in sorted(d.b.dropna().unique()):
        g = d[d.b == i]
        mu, t, n = AB.daycluster(g[col], g.day)
        print(f'    {int(i)+1:<5}{n:>7}{g[by].median():>+11.3f}{mu:>+11.4f}{t:>+9.2f}')


def daytrade(s, which, dev_thr=0.0, entry_t=(600, 930), one=True):
    """
    One trade per session: the FIRST 5m close in the window that is below VWAP by at
    least dev_thr goes long (mirror for short). Exit at the session close. Costs
    charged in points.
    """
    cost = S.COST_PTS[which]; pv = S.PT_VALUE[which]
    out = []
    for dd, g in s.groupby('day'):
        g = g[(g.t >= entry_t[0]) & (g.t <= entry_t[1])].sort_values('t')
        if not len(g):
            continue
        for _, q in g.iterrows():
            long = q.dev <= -dev_thr
            short = q.dev >= dev_thr
            if not (long or short):
                continue
            sgn = 1.0 if long else -1.0
            pts = sgn * q.y * q.ADR - cost
            out.append(dict(day=dd, t=q.t, side='long' if long else 'short',
                            dev=q.dev, ADR=q.ADR, pts=pts, usd=pts * pv,
                            R=0.25 * q.ADR, Rmult=pts / (0.25 * q.ADR)))
            if one:
                break
    return pd.DataFrame(out)


def show(t, label, nd):
    if not len(t):
        print(f'  {label:<26} n=0'); return
    mu = t.pts.mean()
    g = t.groupby('day').pts.mean()
    tt = g.mean() / (g.std(ddof=1) / np.sqrt(len(g)))
    print(f'  {label:<26} n={len(t):>5}  {len(t)/nd:.2f}/day  '
          f'{mu:>+7.3f} pts  t {tt:>+6.2f}  WR {(t.pts>0).mean():>5.1%}  '
          f'${t.usd.mean():>+7.2f}/tr  ${t.usd.sum():>+9.0f}')


