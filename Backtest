                         "verdict": "PASS" if gt["passes"] else ("INSUFF" if gt["insufficient"] else "FAIL"),
                         "reason": gt["reason"]})
            v = rows[-1]["verdict"]
            print(f"[{k+1:3}/{len(grid)}] {s['id']} {s['src'][:34]:34} {s['family'] or '':16} "
