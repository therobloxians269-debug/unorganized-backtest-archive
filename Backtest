"""Typed, validated run configuration for the Overnight Premium Engine.

Python dataclasses are the single source of truth for defaults, so the scaffold runs
with only the standard library. Configs can be overridden from a mapping or JSON, and
optionally from YAML when PyYAML is installed. ``Config.save`` writes the fully
resolved config for reproducibility.
"""
from __future__ import annotations

import json
from dataclasses import asdict, dataclass, field
from datetime import date
from pathlib import Path
from typing import Any, Mapping

from ope.instruments import get_market, market_keys


def _parse_date(value: str | date | None) -> date | None:
    if value is None or isinstance(value, date):
        return value
    return date.fromisoformat(str(value))


def _jsonify(obj: Any) -> Any:
    """Recursively convert dataclass-derived structures to JSON-friendly types."""
    if isinstance(obj, dict):
        return {k: _jsonify(v) for k, v in obj.items()}
    if isinstance(obj, (list, tuple)):
        return [_jsonify(v) for v in obj]
    if isinstance(obj, date):
        return obj.isoformat()
    return obj


@dataclass
class DateWindow:
    """A closed [start, end] date range; ``None`` means open-ended."""

    start: date | None = None
    end: date | None = None

    def __post_init__(self) -> None:
        self.start = _parse_date(self.start)
        self.end = _parse_date(self.end)
        if self.start is not None and self.end is not None and self.start > self.end:
            raise ValueError(f"DateWindow start {self.start} is after end {self.end}")


@dataclass
class WindowsConfig:
    """In-sample / out-of-sample / holdout split (consumed by M7).

    Default reflects the blueprint: deep history -> 2014 in-sample, 2015-2021
    out-of-sample, and a true post-2022 holdout (market-structure shift).
    """

    in_sample: DateWindow = field(default_factory=lambda: DateWindow(end=date(2014, 12, 31)))
    out_of_sample: DateWindow = field(
        default_factory=lambda: DateWindow(date(2015, 1, 1), date(2021, 12, 31))
    )
    holdout: DateWindow = field(default_factory=lambda: DateWindow(date(2022, 1, 1), None))

    def __post_init__(self) -> None:
        self.in_sample = self._coerce(self.in_sample)
        self.out_of_sample = self._coerce(self.out_of_sample)
        self.holdout = self._coerce(self.holdout)
        self._check_contiguous()

    @staticmethod
    def _coerce(value: DateWindow | Mapping[str, Any]) -> DateWindow:
        return value if isinstance(value, DateWindow) else DateWindow(**value)

    def _check_contiguous(self) -> None:
        is_end = self.in_sample.end
        oos_start, oos_end = self.out_of_sample.start, self.out_of_sample.end
        ho_start = self.holdout.start
        if is_end and oos_start and oos_start <= is_end:
            raise ValueError("out_of_sample must start after in_sample ends")
        if oos_end and ho_start and ho_start <= oos_end:
            raise ValueError("holdout must start after out_of_sample ends")


@dataclass
class DataConfig:
    """Market-data ingestion settings (consumed by M1)."""

    primary_source: str = "yfinance"
    fallback_source: str = "stooq"
    start: date | None = field(default_factory=lambda: date(2000, 1, 1))
    end: date | None = None  # None -> latest available
    cache_format: str = "parquet"

    def __post_init__(self) -> None:
        self.start = _parse_date(self.start)
        self.end = _parse_date(self.end)
        if self.start and self.end and self.start > self.end:
            raise ValueError("data.start is after data.end")
        if self.cache_format not in {"parquet", "csv"}:
            raise ValueError("data.cache_format must be 'parquet' or 'csv'")


@dataclass
class RiskConfig:
    """Position-sizing and risk controls (consumed by M4)."""

    target_annual_vol: float = 0.10  # annualized vol target for the overnight book
    vol_lookback: int = 20           # trading days for realized-vol sizing
    max_micros_per_market: int = 50  # hard cap on contracts per market
    trading_days_per_year: int = 252
    capital: float = 100_000.0       # account equity used to convert weight -> contracts
    max_leverage: float = 3.0        # cap on vol-target exposure (calm-regime guard)

    def __post_init__(self) -> None:
        if not 0 < self.target_annual_vol < 5:
            raise ValueError("risk.target_annual_vol must be in (0, 5)")
        if self.vol_lookback < 2:
            raise ValueError("risk.vol_lookback must be >= 2")
        if self.max_micros_per_market < 1:
            raise ValueError("risk.max_micros_per_market must be >= 1")
        if self.trading_days_per_year < 200:
            raise ValueError("risk.trading_days_per_year looks wrong (<200)")
        if self.capital <= 0:
            raise ValueError("risk.capital must be > 0")
        if not 0 < self.max_leverage <= 20:
            raise ValueError("risk.max_leverage must be in (0, 20]")


@dataclass
class FeatureConfig:
    """Intraday microstructure feature settings (consumed by M2')."""

    bar_freq: str = "1min"
    rth_only: bool = True
    vwap_band_min_bars: int = 10   # bars before the VWAP sigma/stretch is trusted
    ofi_window: int = 15           # bars for rolling order-flow imbalance
    flow_window: int = 15          # bars for rolling aggressive buy/sell ratio
    absorption_window: int = 30    # bars for the absorption z-score
    divergence_window: int = 30    # bars for the price/CVD divergence window
    realized_vol_window: int = 30  # bars for intraday realized vol

    def __post_init__(self) -> None:
        windows = {
            "vwap_band_min_bars": self.vwap_band_min_bars,
            "ofi_window": self.ofi_window,
            "flow_window": self.flow_window,
            "absorption_window": self.absorption_window,
            "divergence_window": self.divergence_window,
            "realized_vol_window": self.realized_vol_window,
        }
        for name, value in windows.items():
            if value < 1:
                raise ValueError(f"feature.{name} must be >= 1")


@dataclass
class MIMConfig:
    """Market Intraday Momentum settings (consumed by ope.mim, M3).

    Predictor is the first half-hour return r1 (prev RTH close -> 10:00) optionally
    combined with the twelfth half-hour r12 (15:00 -> 15:30). The position is taken in
    the last half hour (15:30 -> 16:00) in the predictor's direction, flat otherwise.
    """

    predictor: str = "r1_r12"   # "r1" or "r1_r12"
    deadband_bp: float = 0.0    # only trade when |predictor| exceeds this (basis points)
    use_cost: bool = True       # net out modeled contract round-turn cost

    _VALID_PREDICTORS = ("r1", "r1_r12")

    def __post_init__(self) -> None:
        if self.predictor not in self._VALID_PREDICTORS:
            raise ValueError(f"mim.predictor must be one of {self._VALID_PREDICTORS}")
        if self.deadband_bp < 0:
            raise ValueError("mim.deadband_bp must be >= 0")


@dataclass
class Config:
    """Top-level run configuration."""

    run_name: str = "ope_default"
    seed: int = 7
    markets: list[str] = field(default_factory=market_keys)
    windows: WindowsConfig = field(default_factory=WindowsConfig)
    data: DataConfig = field(default_factory=DataConfig)
    risk: RiskConfig = field(default_factory=RiskConfig)
    features: FeatureConfig = field(default_factory=FeatureConfig)
    mim: MIMConfig = field(default_factory=MIMConfig)

    def __post_init__(self) -> None:
        # Coerce nested mappings (from JSON/YAML) into their dataclasses.
        self.windows = self.windows if isinstance(self.windows, WindowsConfig) else WindowsConfig(**self.windows)
        self.data = self.data if isinstance(self.data, DataConfig) else DataConfig(**self.data)
        self.risk = self.risk if isinstance(self.risk, RiskConfig) else RiskConfig(**self.risk)
        self.features = (
            self.features if isinstance(self.features, FeatureConfig)
            else FeatureConfig(**self.features)
        )
        self.mim = self.mim if isinstance(self.mim, MIMConfig) else MIMConfig(**self.mim)
        self._validate_markets()

    def _validate_markets(self) -> None:
        if not self.markets:
            raise ValueError("config.markets must list at least one market")
        for key in self.markets:
            get_market(key)  # raises KeyError on unknown market

    # ---- construction ----
    @classmethod
    def default(cls) -> Config:
        return cls()

    @classmethod
    def from_mapping(cls, mapping: Mapping[str, Any]) -> Config:
        return cls(**dict(mapping))

    @classmethod
    def from_json(cls, path: str | Path) -> Config:
        return cls.from_mapping(json.loads(Path(path).read_text()))

    @classmethod
    def from_yaml(cls, path: str | Path) -> Config:
        try:
            import yaml  # type: ignore[import-untyped]  # optional [yaml] extra
        except ModuleNotFoundError as exc:
            raise ModuleNotFoundError(
                "PyYAML is required for YAML configs: pip install "
                "'overnight-premium-engine[yaml]', or use Config.from_json."
            ) from exc
        return cls.from_mapping(yaml.safe_load(Path(path).read_text()) or {})

    # ---- serialization ----
    def to_dict(self) -> dict[str, Any]:
        return _jsonify(asdict(self))

    def to_json(self) -> str:
        return json.dumps(self.to_dict(), indent=2, sort_keys=True)

    def save(self, path: str | Path) -> Path:
        """Persist the resolved config. Format inferred from suffix (.json/.yaml/.yml)."""
        p = Path(path)
        p.parent.mkdir(parents=True, exist_ok=True)
        if p.suffix.lower() in {".yaml", ".yml"}:
            try:
                import yaml
            except ModuleNotFoundError as exc:
                raise ModuleNotFoundError("PyYAML required to save YAML; use a .json path.") from exc
            p.write_text(yaml.safe_dump(self.to_dict(), sort_keys=True))
        else:
            p.write_text(self.to_json())
        return p

