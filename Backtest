def find_entry(s):
    """Frozen base entry. Returns (ebar, side, entry_px, stop0, risk0) or None."""
    c, vwap, er, atr = s["c"], s["vwap"], s["er"], s["atr"]
    orh, orl = s["or_hi"], s["or_lo"]
    for b in range(ORN, 77):
        if er[b] < ER_THR:
            continue
        if c[b] > orh and c[b] > vwap[b]:
            side = 1
        elif c[b] < orl and c[b] < vwap[b]:
            side = -1
        else:
            continue
        sd = max(ATR_MULT * atr[b], FLOOR)
        return b, side, c[b], c[b] - side * sd, sd
    return None


def sim_exit(s, ent, scheme, p):
    """Run one exit scheme on a fixed entry. Returns (net_pts, kind, hold_bars)."""
    eb, side, entry, stop, risk0 = ent
    h, l, c, atr = s["h"], s["l"], s["c"], s["atr"]
    hwm = entry
    be_on = False
    tgt = entry + side * p * risk0 if scheme == "target" else np.nan
    tbar = int(min(eb + p, 77)) if scheme == "time" else -1
    for b in range(eb + 1, 78):
        # 1) protective stop, intrabar (level fixed on prior bars) — conservative first
        if (l[b] <= stop) if side > 0 else (h[b] >= stop):
            return side * (stop - entry) - fric("stop"), "stop", b - eb
        # 2) resting limit target
        if scheme == "target" and ((h[b] >= tgt) if side > 0 else (l[b] <= tgt)):
            return side * (tgt - entry) - fric("target"), "target", b - eb
        # 3) time stop / end of day (market at this bar's close)
        if b == 77 or b == tbar:
            return side * (c[b] - entry) - fric("eod"), "eod", b - eb
        # 4) end-of-bar trail update — binds from the NEXT bar only
        hwm = max(hwm, h[b]) if side > 0 else min(hwm, l[b])
        if scheme == "chan":
            trail = hwm - side * p * atr[b]
            stop = max(stop, trail) if side > 0 else min(stop, trail)
        elif scheme == "be":
            if not be_on and side * (hwm - entry) >= risk0:
                be_on = True
            if be_on:
                trail = hwm - side * p * atr[b]
                lvl = (max(entry, trail) if side > 0 else min(entry, trail))
                stop = max(stop, lvl) if side > 0 else min(stop, lvl)
    raise RuntimeError("unreachable")


def run_cfg(sessions_with_entry, scheme, p):
    rows = []
    for s, ent in sessions_with_entry:
        g, kind, hold = sim_exit(s, ent, scheme, p)
        rows.append((s["date"], g, kind, hold))
    df = pd.DataFrame(rows, columns=["date", "net", "kind", "hold"])
    df["usd"] = df["net"] * DPP
    df["yr"] = pd.to_datetime(df["date"]).dt.year
    return df


def net_dd_mar(usd):
    if len(usd) == 0:
        return 0.0, 0.0, 0.0
    eq = np.cumsum(usd)
    dd = float((eq - np.maximum.accumulate(eq)).min())
    net = float(usd.sum())
    mar = net / abs(dd) if dd < 0 else (float("inf") if net > 0 else 0.0)
    return net, dd, mar


def stats(df):
    net, dd, mar = net_dd_mar(df["usd"].to_numpy())
    yearly = df.groupby("yr")["usd"].sum().to_dict()
    mon = df.assign(m=pd.to_datetime(df["date"]).dt.to_period("M")).groupby("m")["usd"].sum()
    top3 = float(mon.nlargest(3).sum() / net) if net > 0 and len(mon) >= 3 else float("nan")
    return dict(net_usd=round(net, 2), mar=round(mar, 3), trades=int(len(df)),
                hit=round(float((df["net"] > 0).mean()), 4), maxdd_usd=round(dd, 2),
                yearly={str(k): round(v, 2) for k, v in sorted(yearly.items())},
                top3_month_share=round(top3, 4) if top3 == top3 else None,
                expectancy_pts=round(float(df["net"].mean()), 4),
                avg_hold_bars=round(float(df["hold"].mean()), 1))


def era_mars(df):
    out = {}
    for name, y0, y1 in ERAS:
        sub = df[(df.yr >= y0) & (df.yr <= y1)]
        out[name] = net_dd_mar(sub["usd"].to_numpy())
    return out


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--window", choices=["dev", "holdout", "all"], default="dev")
    ap.add_argument("--scheme", default=PRE_SCHEME)
    ap.add_argument("--param", type=float, default=PRE_PARAM)
