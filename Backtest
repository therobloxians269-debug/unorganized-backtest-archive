import pandas as pd, numpy as np, warnings; warnings.filterwarnings('ignore')
from vp import race, RTH_A, RTH_B

def vwap_fade2(b, k=1.5, tgt_sig=0.0, stop_sig=1.0, max_hold=180, pv=20., comm=4.,
               min_rr=0.0, hour_lo=RTH_A, hour_hi=RTH_B-30, max_per_day=99,
               vp_conf=0.0, sd_lo=0.0, sd_hi=1e9, max_risk=1e9):
    m=b['minofday'].values; c=b['c'].values; o=b['o'].values
    vw=b['vwap'].values; sd=b['vsd'].values; day=b['daycycle'].values
    poc=b['p_poc'].values; val=b['p_val'].values; vah=b['p_vah'].values
    out=[]; used=set(); cnt={}; n=len(b)
    for i in range(1,n-2):
        if not (hour_lo<=m[i]<=hour_hi): continue
        if not np.isfinite(sd[i]) or sd[i]<=0: continue
        if not (sd_lo<=sd[i]<=sd_hi): continue
        up=c[i]>=vw[i]+k*sd[i] and c[i-1]<vw[i-1]+k*sd[i-1]
        dn=c[i]<=vw[i]-k*sd[i] and c[i-1]>vw[i-1]-k*sd[i-1]
        if not(up or dn): continue
        key=(day[i], 1 if up else -1)
        if key in used: continue
        d=-1 if up else 1
        # optional Volume-Profile confluence: the band level must sit near a prior-day VP level
        if vp_conf>0:
            lv=[x for x in (poc[i],val[i],vah[i]) if np.isfinite(x)]
            if not lv or min(abs(np.array(lv)-c[i]))>vp_conf: continue
        if cnt.get(day[i],0)>=max_per_day: continue
        ep=o[i+1]
        st=vw[i]+(k+stop_sig)*sd[i] if d==-1 else vw[i]-(k+stop_sig)*sd[i]
        tg=vw[i]+tgt_sig*sd[i] if d==-1 else vw[i]-tgt_sig*sd[i]
        risk=abs(st-ep)
        if risk<=0 or risk>max_risk: continue
        if abs(tg-ep)/risk<min_rr: continue
        used.add(key); cnt[day[i]]=cnt.get(day[i],0)+1
        r=race(b,i+1,d,ep,st,tg,max_hold,pv=pv,comm=comm)
        r.update(t=b.index[i+1],d=d,rr=abs(tg-ep)/risk,sd=sd[i],mod=m[i]); out.append(r)
    return pd.DataFrame(out)

def stat(t,days,pv):
    if len(t)<10: return None
    eq=t.sort_values('t').pnl.cumsum(); dd=(eq-eq.cummax()).min()
    mic=dd/(pv/2)              # DD expressed on ONE MNQ micro
    pf=t.pnl[t.pnl>0].sum()/max(1e-9,-t.pnl[t.pnl<0].sum())
    return dict(n=len(t),tpd=len(t)/days,wr=(t.pnl>0).mean()*100,dpt=t.pnl.mean(),
                pf=pf,dd_micro=mic,net_micro=t.pnl.sum()/(pv/2))

