#!/usr/bin/env python3
"""
log_paper.py — append a Co-Invest PAPER-account snapshot to the audit log.

Feed it the JSON returned by the Co-Invest `get_portfolio` tool:
    python3 log_paper.py  < portfolio.json
    python3 log_paper.py  portfolio.json

It appends two CSVs next to this script:
  balance_history.csv    one row per snapshot  (equity / available / margin / open PnL)
  positions_history.csv  one row per open position per snapshot

Then it prints a summary and a DIFF vs the previous snapshot — opened / closed /
resized positions — so each Thursday run shows what changed since last week.

NOTE: this is a weekly *snapshot* (net positions + balance), not a live fill feed.
A position opened and closed within the same week won't appear; the net change will.
"""
import sys, json, csv, os, datetime as dt

HERE = os.path.dirname(os.path.abspath(__file__))
BAL  = os.path.join(HERE, "balance_history.csv")
POS  = os.path.join(HERE, "positions_history.csv")


def fnum(x, d=0.0):
    try:
        return float(x)
    except (TypeError, ValueError):
        return d


def load_json():
    raw = open(sys.argv[1]).read() if len(sys.argv) > 1 else sys.stdin.read()
    return json.loads(raw)


def read_rows(path):
    return list(csv.DictReader(open(path))) if os.path.exists(path) else []


def prev_positions(today):
    """{symbol: size} from the most recent snapshot on an EARLIER date (for the diff)."""
    rows = [r for r in read_rows(POS) if r["date"] != today]
    if not rows:
        return None, {}
    pdate = rows[-1]["date"]
    snap = {r["symbol"]: fnum(r["size"]) for r in rows if r["date"] == pdate}
    return pdate, snap


def main():
    p = load_json()
    acct = p.get("account", {})
    positions = p.get("positions", []) or []

    ts   = dt.datetime.now().astimezone().isoformat(timespec="seconds")
    date = dt.date.today().isoformat()

    equity  = fnum(acct.get("equity") or acct.get("account_value"))
    avail   = fnum(acct.get("available_balance"))
    margin  = fnum(acct.get("margin_used"))
    net_pnl = sum(fnum(z.get("unrealizedPnl")) for z in positions)
    npos    = len(positions)

    # capture prior-week state BEFORE we append the new snapshot
    prev_date, prev = prev_positions(date)

    # ---- write balance row (idempotent: replace any existing row for today) ----
    BAL_COLS = ["timestamp", "date", "equity", "available_balance",
                "margin_used", "net_unrealized_pnl", "n_positions"]
    keep = [r for r in read_rows(BAL) if r["date"] != date]
    with open(BAL, "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=BAL_COLS)
        w.writeheader()
        w.writerows(keep)
        w.writerow(dict(zip(BAL_COLS, [ts, date, f"{equity:.2f}", f"{avail:.2f}",
                                       f"{margin:.2f}", f"{net_pnl:.2f}", npos])))

    # ---- write position rows (idempotent: replace any existing rows for today) ----
    POS_COLS = ["timestamp", "date", "symbol", "side", "size", "entryPx", "markPx",
                "unrealizedPnl", "returnOnEquity", "leverage", "leverageType",
                "marginUsed", "liquidationPx", "tp", "sl"]
    keep = [r for r in read_rows(POS) if r["date"] != date]
    with open(POS, "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=POS_COLS)
        w.writeheader()
        w.writerows(keep)
        for z in positions:
            w.writerow({"timestamp": ts, "date": date, "symbol": z.get("symbol", ""),
                        "side": z.get("side", ""), "size": z.get("size", ""),
                        "entryPx": z.get("entryPx", ""), "markPx": z.get("markPx", ""),
                        "unrealizedPnl": z.get("unrealizedPnl", ""),
                        "returnOnEquity": z.get("returnOnEquity", ""),
                        "leverage": z.get("leverage", ""), "leverageType": z.get("leverageType", ""),
                        "marginUsed": z.get("marginUsed", ""), "liquidationPx": z.get("liquidationPx", ""),
                        "tp": z.get("tp", ""), "sl": z.get("sl", "")})

    # ---- report ----
    print(f"[logged] {ts}")
    print(f"  equity ${equity:,.2f} | available ${avail:,.2f} | "
          f"margin ${margin:,.2f} | open PnL ${net_pnl:+,.2f} | {npos} positions")

    cur = {z.get("symbol", ""): fnum(z.get("size")) for z in positions}
    if prev_date is None:
        print("  (first snapshot — no prior week to diff against)")
    else:
        opened  = [s for s in cur if s not in prev]
        closed  = [s for s in prev if s not in cur]
        resized = [s for s in cur if s in prev and abs(cur[s] - prev[s]) > 1e-12]
        print(f"  changes since {prev_date}:")
        if not (opened or closed or resized):
            print("    none — same book")
        for s in opened:  print(f"    + OPENED  {s}  size {cur[s]:g}")
        for s in closed:  print(f"    - CLOSED  {s}  (was {prev[s]:g})")
        for s in resized: print(f"    ~ RESIZED {s}  {prev[s]:g} -> {cur[s]:g}")

    print(f"  -> {BAL}")
    print(f"  -> {POS}")


if __name__ == "__main__":
    main()

