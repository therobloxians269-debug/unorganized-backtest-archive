"""
THE HUNT, on Nasdaq, with the corrected cost model.

WHY RE-RUN: the ES hunt was measured at 0.06-0.11 cost/R. On MNQ the same trade costs
0.0065-0.019 cost/R — up to 15x less drag, because Nasdaq carries 9-15x more ticks of
daily range for the same tick size. A gross edge that is invisible under ES drag can be
perfectly tradeable on MNQ. Entries and target exits are LIMITS (no spread crossed);
only stops are market orders.

SPLITS — MNQ 2026 is not touched until a candidate has already cleared TRAIN and VALIDATE.
    TRAIN     NQ  2023-01-01 .. 2024-12-31
    VALIDATE  NQ  2025-01-01 .. 2025-12-31
    HOLDOUT   MNQ 2026            (sealed)

MULTIPLE TESTING: 728 cells are searched, so the bar is the best-of-728 noise floor
(~3.6 in |t|), not 2.0. A candidate must clear that on TRAIN and then still be positive
on VALIDATE and HOLDOUT, which the search never saw.
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')
import data as D, hunt as HU, cost as CT


def sessions_for(which):
    d = D.load(which)
    day, r = D.sessions(d)
    return day, D.rth_bars(r)


def costed(arr, sess, sgn, stop_frac, rr, which, entry_type='limit'):
    """arr = list of (day, end_idx, px, ADR). One trade per row."""
    out = []
    for dd, end, px, A in arr:
        v = sess.get(dd)
        if v is None:
            continue
        H, L, C = v
        j = int(end)
        if j >= len(C) - 6:
            continue
        stop = px - sgn * stop_frac * A
        tgt = px + sgn * stop_frac * rr * A
        res = CT.run_trade(H, L, C, j, sgn, px, stop, tgt, which,
                           entry_type=entry_type)
        R = stop_frac * A
        out.append((dd, res['outcome'], res['pts_net'], res['pts_net'] / R))
    if not out:
        return None
    o = pd.DataFrame(out, columns=['day', 'outcome', 'pts', 'R'])
    fills = o[o.outcome != 'nofill']
    if len(fills) < 60:
        return None
    g = fills.groupby('day').pts.mean()
    if len(g) < 30 or g.std(ddof=1) == 0:
        return None
    res_ = fills[fills.outcome != 'timeout']
    return dict(n=len(fills), fill=len(fills) / len(o),
                avgR=float(fills.R.mean()),
                t=float(g.mean() / (g.std(ddof=1) / np.sqrt(len(g)))),
                usd=float(fills.pts.mean() * CT.PT[which]),
                wr=float((res_.outcome == 'win').mean()) if len(res_) else np.nan,
                to=float((fills.outcome == 'timeout').mean()))


def scan_all(d, sess, which, stops=(0.20, 0.35), rr=2.0, entry_type='limit',
             min_trades=60):
    cond = HU.conditions(d)
    names = list(cond)
    combos = [(a, '') for a in names] + [(a, b) for i, a in enumerate(names)
                                         for b in names[i + 1:]]
    rows = []
    for a, b in combos:
        m = cond[a] if b == '' else (cond[a] & cond[b])
        sub = d[m & (d.t <= 930)].groupby('day', as_index=False).first()
        if len(sub) < min_trades:
            continue
        arr = list(zip(sub.day, sub.end, sub.px, sub.ADR))
        for sgn in (+1.0, -1.0):
            for sf in stops:
                r_ = costed(arr, sess, sgn, sf, rr, which, entry_type)
                if r_:
                    rows.append(dict(A=a, B=b, dir='long' if sgn > 0 else 'short',
                                     stop=sf, **r_))
    return pd.DataFrame(rows)

