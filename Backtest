"""Selftest: nothing downstream is trusted until every one of these passes."""
import numpy as np
import pandas as pd
import ldc, structure, engine

rng = np.random.default_rng(7)
PASS = []


def chk(name, cond, extra=""):
    PASS.append((name, bool(cond)))
    print(f"[{'PASS' if cond else 'FAIL'}] {name} {extra}")


def synth(n=6000, seed=1):
    g = np.random.default_rng(seed)
    c = 20000 + np.cumsum(g.normal(0, 3, n))
    h = c + np.abs(g.normal(0, 2, n))
    l = c - np.abs(g.normal(0, 2, n))
    o = np.r_[c[0], c[:-1]]
    return o, h, np.maximum(h, np.maximum(o, c)), np.minimum(l, np.minimum(o, c)), c


# ---------------------------------------------------------------- indicators
o, _, h, l, c = synth()

def ref_wilder_rsi(px, n=14):
    """Independent plain-Python Wilder RSI (SMA seed), no numpy vectorisation."""
    u = [0.0]; dv = [0.0]
    for i in range(1, len(px)):
        ch = px[i] - px[i - 1]
        u.append(ch if ch > 0 else 0.0)
        dv.append(-ch if ch < 0 else 0.0)
    def rma(s):
        out = []; acc = 0.0
        for i, v in enumerate(s):
            if i < n:
                acc += v; out.append(acc / (i + 1))
            else:
                out.append(v / n + out[-1] * (1 - 1 / n))
        return out
    ru, rd = rma(u), rma(dv)
    return np.array([100.0 if rd[i] == 0 else (0.0 if ru[i] == 0 else
                     100 - 100 / (1 + ru[i] / rd[i])) for i in range(len(px))])


mine = ldc._rsi(c, 14)
ref_rsi = ref_wilder_rsi(list(c), 14)
chk("RSI matches independent Wilder reference",
    np.nanmax(np.abs(mine - ref_rsi)) < 1e-9,
    f"maxdiff={np.nanmax(np.abs(mine-ref_rsi)):.2e}")

# hand-checkable anchor: strictly rising series -> RSI 100
chk("RSI of a monotone rise == 100", abs(ldc._rsi(np.arange(200, dtype=float), 14)[-1] - 100) < 1e-9)
chk("RSI of a monotone fall == 0", abs(ldc._rsi(-np.arange(200, dtype=float), 14)[-1]) < 1e-9)

F = ldc.features(h, l, c)
chk("features finite", np.isfinite(F).all())
chk("features in [0,1]", (F >= -1e-9).all() and (F <= 1 + 1e-9).all(),
    f"min={F.min():.3f} max={F.max():.3f}")

# ---------------------------------------------------------------- KNN control
# Brute-force equivalence: the numba top-k must equal a naive numpy argsort.
gg = np.random.default_rng(5)
sf = np.ascontiguousarray(gg.random((3000, 5)))
sy = np.sign(gg.normal(size=3000))
sp = ldc.knn_predict(sf, sy, 500, 8, 4, 5)
t = 2500
cand = np.arange(t - 5 - 1, t - 500 - 1, -4)
dd = np.log1p(np.abs(sf[t] - sf[cand])).sum(1)
brute = sy[cand[np.argsort(dd, kind="stable")[:8]]].sum()
chk("KNN top-k equals brute-force argsort", abs(sp[t] - brute) < 1e-9,
    f"knn={sp[t]} brute={brute}")

# Planted control: PERSISTENT regimes, so the feature at bar i genuinely
# predicts the move over bars i+1..i+4.
n = 20000
g = np.random.default_rng(3)
blocks = g.integers(0, 2, n // 50 + 1).repeat(50)[:n]
step = np.where(blocks == 1, 1.0, -1.0) * 2.0 + g.normal(0, 0.5, n)
cc = 20000 + np.cumsum(step)
feat = np.zeros((n, 5))
feat[:, 0] = blocks * 0.8 + g.normal(0, 0.02, n)   # informative
feat[:, 1:] = g.random((n, 4))                     # noise
y = np.zeros(n)
y[: n - 4] = np.sign(cc[4:] - cc[: n - 4])
pred = ldc.knn_predict(np.ascontiguousarray(feat), y, 2000, 8, 4, 5)
m = (np.arange(n) > 2100) & (pred != 0) & (y != 0)   # k-NN ties carry no vote
acc = (np.sign(pred[m]) == y[m]).mean()
chk("KNN recovers a planted pattern", acc > 0.75, f"acc={acc:.3f} n={m.sum()}")

featn = np.ascontiguousarray(g.random((n, 5)))      # no information at all
predn = ldc.knn_predict(featn, y, 2000, 8, 4, 5)
mn = (np.arange(n) > 2100) & (predn != 0) & (y != 0)
accn = (np.sign(predn[mn]) == y[mn]).mean()
chk("KNN on pure noise is ~chance", 0.45 < accn < 0.55, f"acc={accn:.3f} n={mn.sum()}")

# ---------------------------------------------------------------- causality
o2, _, h2, l2, c2 = synth(9000, seed=11)
full = ldc.classify(h2, l2, c2, max_bars_back=500)
T = 7000
trunc = ldc.classify(h2[:T], l2[:T], c2[:T], max_bars_back=500)
same_pred = np.allclose(full["pred"][:T], trunc["pred"], atol=1e-9)
same_sig = (full["signal"][:T] == trunc["signal"]).all()
chk("LDC prediction is causal (truncation-invariant)", same_pred)
chk("LDC signal is causal (truncation-invariant)", same_sig)

fb = structure.breaker_signals(o2, h2, l2, c2, 5, 20, 500)
ft = structure.breaker_signals(o2[:T], h2[:T], l2[:T], c2[:T], 5, 20, 500)
chk("breaker signals are causal", (fb[0][:T - 10] == ft[0][:T - 10]).all())

# a future-only change must not alter past signals
c3 = c2.copy(); h3 = h2.copy(); l3 = l2.copy()
c3[T:] += 500; h3[T:] += 500; l3[T:] += 500
alt = ldc.classify(h3, l3, c3, max_bars_back=500)
chk("future perturbation leaves past untouched",
    np.allclose(full["pred"][:T], alt["pred"][:T], atol=1e-9))

# ---------------------------------------------------------------- breaker toy
# hand-built: up candle at a pivot high, price closes above it, then returns.
px = [100, 101, 102, 103, 104, 103, 102, 101, 100, 99, 98, 99, 100, 101, 102,
      106, 107, 108, 104, 103, 103.5, 104]
N = len(px)
to = np.array(px, float)
tc = np.array(px, float) + 0.4
th = np.maximum(to, tc) + 0.3
tl = np.minimum(to, tc) - 0.3
bs, br, blo, bhi, rlo, rhi = structure.breaker_signals(to, th, tl, tc, 2, 10, 500)
chk("toy series produces >=1 bullish breaker retest", bs.sum() >= 1, f"n={bs.sum()}")

# ---------------------------------------------------------------- engine
# deterministic ladder: entry at open of bar 1, target 2R must be hit, not stop
eo = np.array([100, 100, 100, 100, 100, 100.0])
eh = np.array([100, 100.5, 101.0, 102.5, 102.5, 102.5])
el = np.array([99.5, 99.8, 99.9, 99.9, 99.9, 99.9])
ec = np.array([100, 100.4, 100.9, 102.4, 102.4, 102.4])
ls = np.array([True, False, False, False, False, False])
ss = np.zeros(6, bool)
R = np.full(6, 1.0)
r = engine.run_trades(eo, eh, el, ec, ls, ss, R, 50, engine.MODE_FULL, 0.0, 0)
chk("engine: clean 2R win", len(r[6]) == 1 and abs(r[7][0] - 2.0) < 1e-9,
    f"R={r[7][0] if len(r[7]) else 'none'}")

el2 = el.copy(); el2[2] = 98.0          # stop out at 99
r2 = engine.run_trades(eo, eh, el2, ec, ls, ss, R, 50, engine.MODE_FULL, 0.0, 0)
chk("engine: clean -1R loss", len(r2[7]) == 1 and abs(r2[7][0] + 1.0) < 1e-9,
    f"R={r2[7][0] if len(r2[7]) else 'none'}")

# TAP-BAR LEAK GUARD: put the entire 2R move inside the SIGNAL bar only.
so = np.array([100, 100, 100, 100.0])
sh = np.array([102.5, 100.2, 100.2, 100.2])   # signal bar alone reaches +2R
sl_ = np.array([99.9, 99.9, 99.9, 99.9])
sc = np.array([100, 100.1, 100.1, 100.1])
ls2 = np.array([True, False, False, False])
r3 = engine.run_trades(so, sh, sl_, sc, ls2, np.zeros(4, bool), np.full(4, 1.0),
                       50, engine.MODE_FULL, 0.0, 0)
chk("engine: signal-bar high does NOT fill the target",
    len(r3[8]) == 1 and r3[8][0] != 2, f"outcome={r3[8][0] if len(r3[8]) else 'none'}")

# cost is subtracted exactly once
r4 = engine.run_trades(eo, eh, el, ec, ls, ss, R, 50, engine.MODE_FULL, 0.5, 0)
chk("engine: cost applied once", abs(r4[6][0] - (2.0 - 0.5)) < 1e-9, f"pts={r4[6][0]}")

# short symmetry
r5 = engine.run_trades(200 - eo, 200 - el, 200 - eh, 200 - ec, np.zeros(6, bool),
                       ls, R, 50, engine.MODE_FULL, 0.0, 0)
chk("engine: short mirrors long", len(r5[7]) == 1 and abs(r5[7][0] - 2.0) < 1e-9)

# no overlapping positions
many = np.ones(200, bool)
mo = np.full(200, 100.0); mh = np.full(200, 100.6); ml = np.full(200, 99.6)
mc = np.full(200, 100.0)
r6 = engine.run_trades(mo, mh, ml, mc, many, np.zeros(200, bool), np.full(200, 1.0),
                       20, engine.MODE_FULL, 0.0, 0)
ent, ex = r6[0], r6[1]
chk("engine: positions never overlap", bool((ent[1:] > ex[:-1]).all()) if len(ent) > 1 else True)

# ---------------------------------------------------------------- placebo sanity
d0 = structure.breaker_signals(o2, h2, l2, c2, 5, 20, 500)
d1 = structure.breaker_signals(o2, h2, l2, c2, 5, 20, 500, shift=25.0)
chk("displaced placebo changes the signal set", not (d0[0] == d1[0]).all(),
    f"real={d0[0].sum()} displaced={d1[0].sum()}")

print("\n" + "=" * 70)
ok = sum(p for _, p in PASS)
print(f"SELFTEST {ok}/{len(PASS)} passed")
if ok != len(PASS):
    print("FAILURES:", [n for n, p in PASS if not p])
    raise SystemExit(1)

