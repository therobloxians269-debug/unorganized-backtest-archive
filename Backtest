"""
f6_sweep-reversal.py  --  LIQUIDITY SWEEP REVERSAL / CONTINUATION family on NQ / MNQ.

Design notes
------------
* Every reference level is built from a CLOSED window and carries an explicit
  `src_last_idx` (integer position of the LAST bar used to build it).  The
  lookahead audit asserts src_last_idx < t for every bar t at which the level
  is active.  That is a direct proof of causality, not a vibe.
* Volatility unit is built from 1-min bars only (rolling window + .shift(1)).
  NO resample/reindex/ffill is used anywhere, so the v5 HTF bug cannot recur.
* Entry is ALWAYS at the open of the bar AFTER the signal bar closes.
* Stop-first if stop and target are both inside one 1-min bar.
* Flat by the last bar of the day-cycle (16:59 ET), no overnight carry.

Usage:  python3 f6_sweep-reversal.py <stage>
        stages: audit | coarse | refine | final | placebo | all
"""
import sys, os, json, time, itertools, math
import numpy as np
import pandas as pd
from numba import njit

DIR = "/Users/kaveh/qt_cascade"
OUT = os.path.join(DIR, "f6_out")
os.makedirs(OUT, exist_ok=True)

# ----------------------------------------------------------------------------- costs
COST = {
    "NQ":  dict(pv=20.0, comm=4.00, slip=0.25),
    "MNQ": dict(pv=2.0,  comm=1.50, slip=0.25),
}

# ============================================================================ LOAD
def load(which):
    f = "nq_v6.parquet" if which == "NQ" else "mnq_v6.parquet"
    df = pd.read_parquet(os.path.join(DIR, f))
    df = df.sort_index()
    return df


# ============================================================================ VOL UNIT
def build_vol(df):
    """Causal volatility unit from 1-min bars only.

    r15[t]  = (max high, min low) over bars t-14..t          (includes bar t)
    vol[t]  = mean(r15) over the previous 210 bars, SHIFTED 1 bar
              -> uses only bars with index <= t-1.  Roughly a 15-min ATR(14).
    """
    h, l = df["h"], df["l"]
    r15 = h.rolling(15).max() - l.rolling(15).min()
    vol = r15.rolling(210).mean().shift(1)
    return vol


# ============================================================================ LEVELS
def _grp_extreme(df, key):
    g = df.groupby(key, sort=False)
    return g["h"].max(), g["l"].min(), g.indices


def build_levels(df):
    """Return dict name -> DataFrame(up, dn, src_last, active_from_pos)

    up / dn      : level value per bar (NaN where not active)
    src_last     : integer position of last bar used to compute the level (per bar)
    """
    n = len(df)
    pos = np.arange(n)
    idx = df.index
    cyc = df["daycycle"].values
    tod = (idx.hour * 60 + idx.minute).values.astype(np.int64)
    # minutes since the 18:00 day-cycle anchor.  18:00->0, 09:29->929, 16:59->1379.
    # NOTE: raw tod is NOT monotone inside a cycle (it wraps at midnight); using raw
    # tod to define the overnight window silently activated ON/IB at the cycle START.
    moc = (tod - 18 * 60) % 1440
    h = df["h"].values
    l = df["l"].values

    # contiguous integer id per daycycle
    cyc_change = np.empty(n, bool); cyc_change[0] = True
    cyc_change[1:] = cyc[1:] != cyc[:-1]
    cyc_id = np.cumsum(cyc_change) - 1
    ncyc = cyc_id[-1] + 1
    cyc_start = np.zeros(ncyc, np.int64); cyc_end = np.zeros(ncyc, np.int64)
    for c in range(ncyc):
        w = np.flatnonzero(cyc_id == c)
        cyc_start[c] = w[0]; cyc_end[c] = w[-1]

    levels = {}

    def mk(name, up_val_per_cyc, dn_val_per_cyc, src_last_per_cyc, act_start_per_cyc):
        up = np.full(n, np.nan); dn = np.full(n, np.nan); src = np.full(n, -1, np.int64)
        for c in range(ncyc):
            a = act_start_per_cyc[c]
            if a < 0:
                continue
            b = cyc_end[c]
            if a > b:
                continue
            up[a:b+1] = up_val_per_cyc[c]
            dn[a:b+1] = dn_val_per_cyc[c]
            src[a:b+1] = src_last_per_cyc[c]
        levels[name] = dict(up=up, dn=dn, src=src)

    # ---- PD : prior day-cycle high / low  (source = all bars of previous cycle)
    ch = np.zeros(ncyc); cl_ = np.zeros(ncyc)
    for c in range(ncyc):
        s, e = cyc_start[c], cyc_end[c]
        ch[c] = h[s:e+1].max(); cl_[c] = l[s:e+1].min()
    up = np.full(ncyc, np.nan); dn = np.full(ncyc, np.nan)
    src = np.full(ncyc, -1, np.int64); act = np.full(ncyc, -1, np.int64)
    for c in range(1, ncyc):
        up[c] = ch[c-1]; dn[c] = cl_[c-1]
        src[c] = cyc_end[c-1]; act[c] = cyc_start[c]
    mk("PD", up, dn, src, act)

    # ---- ON : overnight (cycle start .. 09:29) high / low, active from 09:30
    up = np.full(ncyc, np.nan); dn = np.full(ncyc, np.nan)
    src = np.full(ncyc, -1, np.int64); act = np.full(ncyc, -1, np.int64)
    for c in range(ncyc):
        s, e = cyc_start[c], cyc_end[c]
        seg = np.arange(s, e+1)
        on = seg[moc[seg] < 930]          # 18:00 .. 09:29
        rt = seg[moc[seg] >= 930]         # 09:30 .. 16:59
        if len(on) == 0 or len(rt) == 0:
            continue
        up[c] = h[on].max(); dn[c] = l[on].min()
        src[c] = on[-1]; act[c] = rt[0]
    mk("ON", up, dn, src, act)

    # ---- IB : 09:30-09:59 high / low, active from 10:00
    up = np.full(ncyc, np.nan); dn = np.full(ncyc, np.nan)
    src = np.full(ncyc, -1, np.int64); act = np.full(ncyc, -1, np.int64)
    for c in range(ncyc):
        s, e = cyc_start[c], cyc_end[c]
        seg = np.arange(s, e+1)
        ib = seg[(moc[seg] >= 930) & (moc[seg] < 960)]   # 09:30 .. 09:59
        af = seg[moc[seg] >= 960]                        # 10:00 .. 16:59
        if len(ib) == 0 or len(af) == 0:
            continue
        up[c] = h[ib].max(); dn[c] = l[ib].min()
        src[c] = ib[-1]; act[c] = af[0]
    mk("IB", up, dn, src, act)

    # ---- PW : prior ISO-week high / low  (weeks keyed on the day-cycle date)
    cdates = pd.Series([pd.Timestamp(cyc[cyc_start[c]]) for c in range(ncyc)])
    wk = cdates.dt.isocalendar()
    wkey = (wk["year"].astype(int) * 100 + wk["week"].astype(int)).values
    uniq_w = []
    for w in wkey:
        if not uniq_w or uniq_w[-1] != w:
            uniq_w.append(w)
    wh, wl, wlast = {}, {}, {}
    for w in set(wkey):
        cs = np.flatnonzero(wkey == w)
        s = cyc_start[cs[0]]; e = cyc_end[cs[-1]]
        wh[w] = h[s:e+1].max(); wl[w] = l[s:e+1].min(); wlast[w] = e
    prevw = {uniq_w[i]: uniq_w[i-1] for i in range(1, len(uniq_w))}
    up = np.full(ncyc, np.nan); dn = np.full(ncyc, np.nan)
    src = np.full(ncyc, -1, np.int64); act = np.full(ncyc, -1, np.int64)
    for c in range(ncyc):
        w = wkey[c]
        if w not in prevw:
            continue
        p = prevw[w]
        up[c] = wh[p]; dn[c] = wl[p]; src[c] = wlast[p]; act[c] = cyc_start[c]
    mk("PW", up, dn, src, act)

    # ---- PS : prior 6-hour session block high / low, active for the whole block
    sess = df["sess"].values
    blk_change = np.empty(n, bool); blk_change[0] = True
    blk_change[1:] = (sess[1:] != sess[:-1]) | (cyc_id[1:] != cyc_id[:-1])
    blk_id = np.cumsum(blk_change) - 1
    nb = blk_id[-1] + 1
    bstart = np.zeros(nb, np.int64); bend = np.zeros(nb, np.int64)
    bh = np.zeros(nb); bl = np.zeros(nb)
    ptr = 0
    for b in range(nb):
        s = ptr
        while ptr < n and blk_id[ptr] == b:
            ptr += 1
        e = ptr - 1
        bstart[b] = s; bend[b] = e
        bh[b] = h[s:e+1].max(); bl[b] = l[s:e+1].min()
    up = np.full(n, np.nan); dn = np.full(n, np.nan); src = np.full(n, -1, np.int64)
    for b in range(1, nb):
        s, e = bstart[b], bend[b]
        # prior block must be inside the SAME day-cycle chain (it always is in time)
        up[s:e+1] = bh[b-1]; dn[s:e+1] = bl[b-1]; src[s:e+1] = bend[b-1]
    levels["PS"] = dict(up=up, dn=dn, src=src)

    meta = dict(cyc_id=cyc_id, cyc_start=cyc_start, cyc_end=cyc_end, tod=tod,
                moc=moc, ncyc=ncyc)
    return levels, meta


# ============================================================================ LOOKAHEAD AUDIT
def audit_levels(levels, n, verbose=True):
    """Assert every active level value at bar t was built ONLY from bars <= t-1."""
    ok = True
    lines = []
    pos = np.arange(n)
    for name, d in levels.items():
        act = ~np.isnan(d["up"]) | ~np.isnan(d["dn"])
        s = d["src"]
        bad = act & (s >= pos)
        nbad = int(bad.sum())
        lines.append(f"  {name:3s}: active bars {int(act.sum()):>8,}  "
                     f"violations(src_last>=t) {nbad}  "
                     f"min lag {int((pos[act]-s[act]).min()) if act.any() else 0} bars")
        if nbad:
            ok = False
    if verbose:
        print("LEVEL CAUSALITY AUDIT")
        for L in lines:
            print(L)
        print("  => ", "PASS" if ok else "FAIL")
    assert ok, "LOOKAHEAD in level construction"
    return lines


def audit_vol(df, vol):
    """Prove vol[t] is a function of bars <= t-1 only, by direct recomputation."""
    n = len(df)
    rng = np.random.default_rng(0)
    picks = rng.choice(np.arange(400, n), 300, replace=False)
    h = df["h"].values; l = df["l"].values
    worst = 0.0
    for t in picks:
        if not np.isfinite(vol.values[t]):
            continue
        # recompute using ONLY bars 0..t-1
        hh = h[:t]; ll = l[:t]
        s = pd.Series(hh).rolling(15).max() - pd.Series(ll).rolling(15).min()
        v = s.rolling(210).mean().values[-1]
        worst = max(worst, abs(v - vol.values[t]))
    print(f"VOL CAUSALITY AUDIT: max |vol[t] - recompute_from_bars<t| over 300 "
          f"random bars = {worst:.10f}")
    assert worst < 1e-9, "vol uses future bars"
    return worst


# ============================================================================ EPISODE SCAN (numba)
@njit(cache=True)
def scan(TH, TL, TC, TLV, VOL, cyc_id, nmax, reclaim_b, disp_b, same_bar):
    """Sweep-episode state machine in TRANSFORMED space (always an 'upper' level).

    An episode starts when TH[t] > TLV[t] (breach).  It resolves when either
      * TC[t] < TLV[t] - reclaim_b*vol   -> REVERSAL   (kind 0)
      * TC[t] > TLV[t] + disp_b*vol      -> CONTINUATION (kind 1)
    whichever happens first, within nmax bars of the breach; else TIMEOUT (kind 2).
    After any resolution the level must be closed back below TLV before re-arming.
    """
    n = TH.shape[0]
    t_out = np.empty(n, np.int64); t_brk = np.empty(n, np.int64)
    kind = np.empty(n, np.int8); ext = np.empty(n, np.float64)
    oext = np.empty(n, np.float64); epn = np.empty(n, np.int32)
    lvv = np.empty(n, np.float64)
    k = 0

    cur = -1
    armed = False
    wait = False
    bb = -1
    rmax = 0.0
    rmin = 0.0
    ep = 0

    for t in range(n):
        if cyc_id[t] != cur:
            cur = cyc_id[t]; armed = False; wait = False; ep = 0
        L = TLV[t]
        if not (L == L):     # NaN -> level inactive
            armed = False; wait = False
            continue
        v = VOL[t]
        if not (v == v) or v <= 0.0:
            continue
        if wait:
            if TC[t] < L:
                wait = False
            else:
                continue
        if not armed:
            if TH[t] > L:
                armed = True; bb = t; rmax = TH[t]; rmin = TL[t]; ep += 1
                if same_bar == 0:
                    continue
            else:
                continue
        # armed
        if TH[t] > rmax:
            rmax = TH[t]
        if TL[t] < rmin:
            rmin = TL[t]
        rev = TC[t] < L - reclaim_b * v
        con = TC[t] > L + disp_b * v
        if rev or con:
            t_out[k] = t; t_brk[k] = bb; kind[k] = 0 if rev else 1
            ext[k] = rmax; oext[k] = rmin; epn[k] = ep; lvv[k] = L
            k += 1
            armed = False
            wait = not rev          # if it closed back inside we can re-arm immediately
        elif t - bb >= nmax:
            t_out[k] = t; t_brk[k] = bb; kind[k] = 2
            ext[k] = rmax; oext[k] = rmin; epn[k] = ep; lvv[k] = L
            k += 1
            armed = False
            wait = TC[t] >= L
    return t_out[:k], t_brk[:k], kind[:k], ext[:k], oext[:k], epn[:k], lvv[:k]


# ============================================================================ TRADE RACE (numba)
@njit(cache=True)
def race(op, hi, lo, cl, ei, dirn, entry, stop, targ, dl):
    for t in range(ei, dl + 1):
        if dirn > 0:
            if lo[t] <= stop:
                return stop, t, 1
            if hi[t] >= targ:
                return targ, t, 2
        else:
            if hi[t] >= stop:
                return stop, t, 1
            if lo[t] <= targ:
                return targ, t, 2
    return cl[dl], dl, 3


@njit(cache=True)
def simulate(op, hi, lo, cl, vol, ei_arr, dir_arr, stop_arr, dl_arr,
             R, pv, comm, slip, min_risk_v, max_risk_v, one_at_a_time):
    m = ei_arr.shape[0]
    o_ei = np.empty(m, np.int64); o_xi = np.empty(m, np.int64)
    o_r = np.empty(m, np.float64); o_net = np.empty(m, np.float64)
    o_risk = np.empty(m, np.float64); o_kind = np.empty(m, np.int8)
    o_dir = np.empty(m, np.int8)
    k = 0
    busy_until = -1
    for j in range(m):
        ei = ei_arr[j]
        if one_at_a_time == 1 and ei <= busy_until:
            continue
        d = dir_arr[j]
        ef = op[ei] + d * slip
        st = stop_arr[j]
        risk = ef - st if d > 0 else st - ef
        v = vol[ei]
        if not (risk == risk) or not (v == v) or v <= 0.0:
            continue
        if risk < min_risk_v * v or risk > max_risk_v * v:
            continue
        tg = ef + d * R * risk
        xp, xi, kk = race(op, hi, lo, cl, ei, d, ef, st, tg, dl_arr[j])
        if kk == 1:
            xf = st - d * slip
        elif kk == 2:
            xf = tg
        else:
            xf = xp - d * slip
        gross = d * (xf - ef)
        net = gross * pv - comm
        o_ei[k] = ei; o_xi[k] = xi; o_risk[k] = risk
        o_net[k] = net; o_r[k] = net / (risk * pv); o_kind[k] = kk; o_dir[k] = d
        k += 1
        busy_until = xi
    return (o_ei[:k], o_xi[:k], o_r[:k], o_net[:k], o_risk[:k], o_kind[:k], o_dir[:k])


# ============================================================================ HARNESS
class Book:
    def __init__(self, which, sl=None, tag=""):
        self.which = which
        self.tag = tag
        df = load(which)
        if sl is not None:
            df = df.loc[sl]
        self.df = df
        self.n = len(df)
        self.vol = build_vol(df).values
        self.levels, self.meta = build_levels(df)
        self.op = df["o"].values.astype(np.float64)
        self.hi = df["h"].values.astype(np.float64)
        self.lo = df["l"].values.astype(np.float64)
        self.cl = df["c"].values.astype(np.float64)
        self.tod = self.meta["tod"]
        self.cyc_id = self.meta["cyc_id"].astype(np.int64)
        ce = self.meta["cyc_end"]
        self.dl = ce[self.cyc_id]                       # last bar of the day-cycle
        self.ncyc = self.meta["ncyc"]
        self.cost = COST[which]
        # cache of episode scans
        self._cache = {}

    # ------------------------------------------------------------------ episodes
    def episodes(self, lvl, side, nmax, reclaim_b, disp_b, same_bar=1):
        key = (lvl, side, nmax, reclaim_b, disp_b, same_bar)
        if key in self._cache:
            return self._cache[key]
        d = self.levels[lvl]
        if side == "up":
            TH, TL, TC, TLV, sign = self.hi, self.lo, self.cl, d["up"], 1.0
        else:
            TH, TL, TC, TLV, sign = -self.lo, -self.hi, -self.cl, -d["dn"], -1.0
        r = scan(np.ascontiguousarray(TH), np.ascontiguousarray(TL),
                 np.ascontiguousarray(TC), np.ascontiguousarray(TLV),
                 self.vol, self.cyc_id, nmax, reclaim_b, disp_b, int(same_bar))
        t_out, t_brk, kind, ext, oext, epn, lvv = r
        e = pd.DataFrame(dict(t_out=t_out, t_brk=t_brk, kind=kind,
                              ext_T=ext, oext_T=oext, ep=epn, lvl_T=lvv))
        e["sign"] = sign
        e["lvl"] = sign * lvv
        e["ext"] = sign * ext        # price extreme beyond the level (real space)
        e["oext"] = sign * oext      # opposite extreme during the episode (real space)
        e["level_name"] = lvl
        e["side"] = side
        e["vol"] = self.vol[t_out]
        e["depth"] = (ext - lvv) / e["vol"].values          # sweep depth in vol units
        e["bars"] = e["t_out"] - e["t_brk"]
        e["tod_out"] = self.tod[t_out]
        e["cyc"] = self.cyc_id[t_out]
        self._cache[key] = e
        return e

    # ------------------------------------------------------------------ build trades
    LAST_ENTRY_TOD = 16 * 60 + 45      # no new entries after 16:45 ET (Apex flat-by-16:59)

    def build_signals(self, cfg):
        """cfg -> (ei, dirn, stop) for the REAL strategy. Entry = open of bar t_out+1."""
        frames = []
        for lvl in cfg["levels"]:
            for side in ("up", "dn"):
                if side == "up" and not cfg.get("use_up", True):
                    continue
                if side == "dn" and not cfg.get("use_dn", True):
                    continue
                ep = self.episodes(lvl, side, cfg["nmax"], cfg["reclaim_b"],
                                   cfg["disp_b"], cfg.get("same_bar", 1))
                sel = ep[ep["kind"].values == (0 if cfg["mode"] == "rev" else 1)]
                sel = sel[(sel["depth"].values >= cfg["dmin"]) &
                          (sel["depth"].values <= cfg["dmax"])]
                if cfg.get("virgin") == 1:
                    sel = sel[sel["ep"].values == 1]
                elif cfg.get("virgin") == 2:
                    sel = sel[sel["ep"].values > 1]
                if cfg.get("bmax") is not None:
                    sel = sel[sel["bars"].values <= cfg["bmax"]]
                t0, t1 = cfg["tod"]
                sel = sel[(sel["tod_out"].values >= t0) & (sel["tod_out"].values <= t1)]
                if len(sel):
                    frames.append(sel)
        if not frames:
            return None
        e = pd.concat(frames).sort_values("t_out")
        t_out = e["t_out"].values
        ei = t_out + 1
        ok = (ei < self.n)
        ei_c = np.clip(ei, 0, self.n - 1)
        ok &= self.cyc_id[ei_c] == self.cyc_id[t_out]
        ok &= (self.dl[ei_c] - ei_c) >= 1
        ok &= self.tod[ei_c] <= self.LAST_ENTRY_TOD
        e = e[ok]; ei = ei[ok]
        if len(e) == 0:
            return None
        sign = e["sign"].values
        v = self.vol[ei]
        lvl_v = e["lvl"].values; ext = e["ext"].values; oext = e["oext"].values
        if cfg["mode"] == "rev":
            dirn = (-sign).astype(np.int64)                       # fade the sweep
            if cfg["stop_style"] == "struct":
                stop = ext + sign * cfg["stop_buf"] * v           # beyond the sweep extreme
            else:
                stop = self.op[ei] + sign * cfg["stop_buf"] * v   # fixed vol stop
        else:
            dirn = (sign).astype(np.int64)                        # go with the break
            if cfg["stop_style"] == "struct":
                stop = np.where(sign > 0,
                                np.minimum(oext, lvl_v) - cfg["stop_buf"] * v,
                                np.maximum(oext, lvl_v) + cfg["stop_buf"] * v)
            else:
                stop = self.op[ei] - sign * cfg["stop_buf"] * v
        return ei.astype(np.int64), dirn.astype(np.int64), stop.astype(np.float64)

    def run_signals(self, ei, dirn, stop, cfg):
        c = self.cost
        res = simulate(self.op, self.hi, self.lo, self.cl, self.vol,
                       ei, dirn, stop, self.dl[ei].astype(np.int64),
                       float(cfg["R"]), c["pv"], c["comm"], c["slip"],
                       float(cfg["min_risk_v"]), float(cfg["max_risk_v"]), 1)
        o_ei, o_xi, o_r, o_net, o_risk, o_kind, o_dir = res
        if len(o_ei) == 0:
            return None
        return pd.DataFrame(dict(ei=o_ei, xi=o_xi, r=o_r, net=o_net, risk=o_risk,
                                 kind=o_kind, dir=o_dir, vol=self.vol[o_ei]))

    def trades_for_config(self, cfg):
        s = self.build_signals(cfg)
        if s is None:
            return None
        return self.run_signals(*s, cfg)

    # ------------------------------------------------------------------ placebo
    def placebo_trades(self, cfg, seed):
        """Random-time placebo: identical logic, identical direction mix, identical
        vol-scaled risk, but the entry bar is displaced by U(120,1440) minutes.
        Stop is re-anchored at the displaced entry so the risk in vol units is the
        SAME as the real trade -- only the TIMING changes."""
        s = self.build_signals(cfg)
        if s is None:
            return None
        ei, dirn, stop = s
        c = self.cost
        ef = self.op[ei] + dirn * c["slip"]
        risk = np.where(dirn > 0, ef - stop, stop - ef)
        v0 = self.vol[ei]
        with np.errstate(invalid="ignore", divide="ignore"):
            risk_v = risk / v0
        rng = np.random.default_rng(seed)
        off = rng.integers(120, 1441, size=len(ei))
        off = off * rng.choice(np.array([-1, 1]), size=len(ei))
        ei2 = ei + off
        ok = (ei2 >= 0) & (ei2 < self.n) & np.isfinite(risk_v) & (risk_v > 0)
        ei2c = np.clip(ei2, 0, self.n - 1)
        ok &= (self.dl[ei2c] - ei2c) >= 1
        ok &= self.tod[ei2c] <= self.LAST_ENTRY_TOD
        ok &= np.isfinite(self.vol[ei2c]) & (self.vol[ei2c] > 0)
        ei2 = ei2[ok]; d2 = dirn[ok]; rv = risk_v[ok]
        if len(ei2) == 0:
            return None
        o = np.argsort(ei2, kind="stable")
        ei2 = ei2[o]; d2 = d2[o]; rv = rv[o]
        ef2 = self.op[ei2] + d2 * c["slip"]
        stop2 = ef2 - d2 * rv * self.vol[ei2]
        return self.run_signals(ei2.astype(np.int64), d2.astype(np.int64),
                                stop2.astype(np.float64), cfg)


# ============================================================================ STATS
def stats(t, ncyc, pv_note=""):
    if t is None or len(t) == 0:
        return dict(n=0, tpd=0.0, avgR=np.nan, dpt=np.nan, wr=np.nan,
                    dropTop3=np.nan, maxdd=np.nan, tstat=np.nan, best=np.nan)
    r = t["r"].values; net = t["net"].values
    eq = np.cumsum(net)
    dd = float((np.maximum.accumulate(np.concatenate([[0.0], eq])) -
                np.concatenate([[0.0], eq])).max())
    o = np.sort(r)[::-1]
    d3 = float(np.mean(o[3:])) if len(o) > 3 else np.nan
    se = r.std(ddof=1) / math.sqrt(len(r)) if len(r) > 1 else np.nan
    return dict(n=int(len(r)), tpd=len(r) / ncyc, avgR=float(r.mean()),
                dpt=float(net.mean()), wr=float((net > 0).mean()),
                dropTop3=d3, maxdd=dd,
                tstat=float(r.mean() / se) if se and se > 0 else np.nan,
                best=float(net.max()))


