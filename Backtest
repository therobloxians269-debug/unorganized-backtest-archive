                   px[s].reindex([pd.Timestamp(d)], method="ffill").notna().any())
        yrs.setdefault(d[:4], []).append(have / 30)
    for y in sorted(yrs):
        print(f"  {y}: {np.mean(yrs[y])*100:.0f}%")


if __name__ == "__main__":
