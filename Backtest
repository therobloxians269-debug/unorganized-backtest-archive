#!/usr/bin/env python3
"""
backtest.py — event-driven backtest for the Judas Swing Sentinel.

Feeds completed 1m bars for the signal and reference instruments through the
SAME JudasSwingSentinel used by the live runner, then simulates execution
conservatively:

  * limit entry fills only on strict trade-through (touch != fill)
  * stop exits pay `slip_ticks_market` adverse slippage
  * target is a limit: needs trade-through too
  * stop and target in the same bar -> stop first
  * force-flat at cfg.flat_time at bar close +/- slippage
  * commissions per side per contract

Usage:
  python3 backtest.py --signal-csv data/es_1m.csv --ref-csv data/mym_1m.csv \
      --signal MES --reference MYM --start 2019-05-06 --end 2026-06-05
"""
from __future__ import annotations

import argparse
from dataclasses import dataclass

import numpy as np
import pandas as pd

from judas import Bar, Config, JudasSwingSentinel, OrderIntent
from judas.config import InstrumentSpec

ET = "America/New_York"

SPECS = {
    "MES": InstrumentSpec("MES", 0.25, 5.0),
    "MNQ": InstrumentSpec("MNQ", 0.25, 2.0),
    "MYM": InstrumentSpec("MYM", 1.0, 0.5),
    "ES": InstrumentSpec("ES", 0.25, 50.0),
}


@dataclass
class OpenPosition:
    intent: OrderIntent
    entry_ts: pd.Timestamp
    entry: float


def load_bars(path: str, start: str | None, end: str | None) -> pd.DataFrame:
    df = pd.read_csv(path, parse_dates=["timestamp"])
    df["timestamp"] = df["timestamp"].dt.tz_convert(ET)
    if start:
        df = df[df["timestamp"] >= pd.Timestamp(start, tz=ET)]
    if end:
        df = df[df["timestamp"] <= pd.Timestamp(end, tz=ET) + pd.Timedelta(days=1)]
    return df.reset_index(drop=True)


def run(cfg: Config, sig_df: pd.DataFrame, ref_df: pd.DataFrame) -> dict:
    sig = sig_df[["timestamp", "open", "high", "low", "close", "volume"]].copy()
    ref = ref_df[["timestamp", "open", "high", "low", "close", "volume"]].copy()
    sig["sym"] = cfg.signal.symbol
    ref["sym"] = cfg.reference.symbol
    # at equal open-times both 1m bars close together; feed reference first so
    # the signal decision at that close sees the reference bar (still causal)
    ref["prio"] = 0
    sig["prio"] = 1
    feed = pd.concat([ref, sig]).sort_values(["timestamp", "prio"], kind="mergesort")

    sentinel = JudasSwingSentinel(cfg)
    tick = cfg.signal.tick
    mult = cfg.signal.multiplier * cfg.contracts
    comm = cfg.commission_per_side * cfg.contracts
    slip = cfg.slip_ticks_market * tick
    flat_t = pd.Timestamp("2000-01-01 " + cfg.flat_time).time()

    pending: OrderIntent | None = None
    pending_age = 0
    pos: OpenPosition | None = None
    trades: list[dict] = []
    intents = 0

    def close_trade(exit_ts, exit_px, reason):
        nonlocal pos
        it = pos.intent
        pts = (exit_px - pos.entry) * it.side
        risk_pts = abs(it.stop - it.limit)
        trades.append(dict(
            entry_ts=pos.entry_ts, exit_ts=exit_ts, side=it.side,
            entry=pos.entry, exit=exit_px, stop=it.stop, target=it.target,
            reason=reason, pts=pts, R=pts / risk_pts if risk_pts else np.nan,
            pnl=pts * mult - 2 * comm, tag=it.tag,
        ))
        pos = None

    for row in feed.itertuples(index=False):
        bar = Bar(row.timestamp, row.open, row.high, row.low, row.close, row.volume)

        if row.sym == cfg.signal.symbol:
            # --- manage open position (this bar can hit stop/target) -------
            if pos is not None:
                it = pos.intent
                stopped = bar.high >= it.stop if it.side == -1 else bar.low <= it.stop
                targeted = bar.low < it.target if it.side == -1 else bar.high > it.target
                if stopped:  # conservative: stop first when ambiguous
                    close_trade(bar.ts, it.stop + slip * (1 if it.side == -1 else -1), "stop")
                elif targeted:
                    close_trade(bar.ts, it.target, "target")
                elif bar.ts.time() >= flat_t:
                    close_trade(bar.ts, bar.close - slip * it.side, "flat")

            # --- manage pending limit order --------------------------------
            if pending is not None:
                pending_age += 1
                it = pending
                filled = bar.high > it.limit if it.side == -1 else bar.low < it.limit
                if filled and pos is None:
                    pos = OpenPosition(it, bar.ts, it.limit)
                    pending = None
                    # same-bar exit checks, stop first (conservative)
                    stopped = bar.high >= it.stop if it.side == -1 else bar.low <= it.stop
                    targeted = bar.low < it.target if it.side == -1 else bar.high > it.target
                    if stopped:
                        close_trade(bar.ts, it.stop + slip * (1 if it.side == -1 else -1), "stop")
                    elif targeted:
                        close_trade(bar.ts, it.target, "target")
                elif pending_age >= it.ttl_bars:
                    pending = None

        intent = sentinel.on_bar(row.sym, bar)
        if intent is not None:
            intents += 1
            if pos is None and pending is None:
                pending = intent
                pending_age = 0

    return dict(trades=pd.DataFrame(trades), intents=intents)


def report(res: dict, cfg: Config, span_days: pd.DatetimeIndex) -> str:
    tr = res["trades"]
    lines = []
    a = lines.append
    a(f"signal={cfg.signal.symbol}  reference={cfg.reference.symbol}  "
      f"smt_mode={cfg.smt_mode}  rr={cfg.rr}  window={cfg.window_start}-{cfg.window_end} ET")
    a(f"intents emitted: {res['intents']}   trades filled: {len(tr)}")
    if tr.empty:
        return "\n".join(lines + ["NO TRADES"])

    wins = tr[tr.pnl > 0]
    gross_w = tr.loc[tr.pnl > 0, "pnl"].sum()
    gross_l = -tr.loc[tr.pnl <= 0, "pnl"].sum()
    pf = gross_w / gross_l if gross_l > 0 else np.inf

    daily = tr.set_index("exit_ts").groupby(lambda t: t.date())["pnl"].sum()
    daily = daily.reindex(span_days, fill_value=0.0)
    mu, sd = daily.mean(), daily.std()
    sharpe = mu / sd * np.sqrt(252) if sd > 0 else np.nan
    eq = daily.cumsum()
    maxdd = (eq - eq.cummax()).min()

    a(f"win rate: {len(wins)}/{len(tr)} = {len(wins)/len(tr):.1%}   "
      f"avg R: {tr.R.mean():+.3f}   median R: {tr.R.median():+.3f}")
    a(f"expectancy: ${tr.pnl.mean():+.2f}/trade   total: ${tr.pnl.sum():+,.0f}   PF: {pf:.2f}")
    a(f"annualized Sharpe (all {len(span_days)} sessions): {sharpe:.2f}   "
      f"maxDD: ${maxdd:,.0f}")
    a("")
    a("by exit reason:")
    a(tr.groupby("reason")["pnl"].agg(["count", "mean", "sum"]).to_string())
    a("")
    a("by direction:")
    a(tr.assign(dir=np.where(tr.side > 0, "long", "short"))
        .groupby("dir")["pnl"].agg(["count", "mean", "sum"]).to_string())
    a("")
    a("by year:")
    yr = tr.assign(year=tr.entry_ts.dt.year).groupby("year").agg(
        n=("pnl", "count"), win=("pnl", lambda s: (s > 0).mean()),
        avgR=("R", "mean"), pnl=("pnl", "sum"))
    a(yr.to_string(float_format=lambda x: f"{x:,.2f}"))
    return "\n".join(lines)


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--signal-csv", required=True)
    ap.add_argument("--ref-csv", required=True)
    ap.add_argument("--signal", default="MES", choices=SPECS)
    ap.add_argument("--reference", default="MNQ", choices=SPECS)
    ap.add_argument("--start", default=None)
    ap.add_argument("--end", default=None)
    ap.add_argument("--smt", default="divergence", choices=["divergence", "invert", "off"])
    ap.add_argument("--rr", type=float, default=2.0)
    ap.add_argument("--no-costs", action="store_true")
    ap.add_argument("--trades-out", default=None)
    args = ap.parse_args()

    cfg = Config(signal=SPECS[args.signal], reference=SPECS[args.reference],
                 smt_mode=args.smt, rr=args.rr)
    if args.no_costs:
        cfg.commission_per_side = 0.0
        cfg.slip_ticks_market = 0

    sig_df = load_bars(args.signal_csv, args.start, args.end)
    ref_df = load_bars(args.ref_csv, args.start, args.end)
    res = run(cfg, sig_df, ref_df)

    span = pd.Index(sorted(sig_df["timestamp"].dt.date.unique()))
    span = pd.Index([d for d in span if pd.Timestamp(d).dayofweek < 5])
    print(report(res, cfg, span))

    if args.trades_out and not res["trades"].empty:
        res["trades"].to_csv(args.trades_out, index=False)
        print(f"\ntrades -> {args.trades_out}")


if __name__ == "__main__":
    main()

