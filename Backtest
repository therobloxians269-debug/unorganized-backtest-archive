#!/usr/bin/env python3
"""OCEAN family f06_pm_continuation — afternoon continuation of the morning move.

Signal:  M = close(12:00) - open(09:30), measured at the 12:00 bar close (bar 29).
         Session-scaled ATR: satr = atr5m[bar29] * sqrt(30)  (30 bars 09:30-12:00).
Entry :  if |M| >= k * satr, enter sign(M) at the ENTRY bar close (bar 29 = 12:00
         or bar 41 = 13:00), market fill.
Stop  :  entry -/+ stop_mult * atr5m[entry_bar], checked intrabar only on bars
         strictly AFTER the entry bar (house-reference causality, omni4_preserve).
Exit  :  stop (market, fric 0.66 pt) or 16:00 close (market, fric 0.66 pt).
1 MES, $5/pt. Windows: dev <= 2022-12-31 | holdout >= 2023-01-01 | all.

Sweep grid (dev only, printed in full): k in {0.75, 1.0, 1.5} x entry in {12:00,
13:00} x stop_mult in {4, 8, 12}  = 18 configs. No other configs were evaluated.
"""
import sys, os, json, argparse, datetime
sys.path.insert(0, "/Users/kaveh/mes_mim")
import numpy as np
import pandas as pd
import omni2_lib as L
from omni2_lib import fric, DPP

DEV_END = datetime.date(2022, 12, 31)
B_SIGNAL = 29            # bar closing 12:00 — M is always measured here
SQRT30 = np.sqrt(30.0)
ENTRY_BARS = {"12:00": 29, "13:00": 41}

# ---- PRE-REGISTERED CONFIG (defaults) = best DEV cell of the 18-config sweep.
# VERDICT: DEAD. Even this best cell fails the survival bar (MAR 0.42 < 1.0,
# 5/13 years positive < 60%, net driven by 2018+2022 vol regimes), and its
# immediate neighbors (k=1.0 and entry=13:00) are DEV-net-NEGATIVE => needle,
# no plateau exists anywhere in the grid. Defaults kept only so the referee can
# reproduce the family's best face.
PREREG = dict(k=0.75, entry="12:00", stop_mult=4.0)

def sim_day(s, k, entry_bar, stop_mult):
    """One session. Returns (date, net_pts, kind) or None. Causal:
    M known at 12:00 close; entry at entry-bar close (same-close fill + slippage);
    stop intrabar only on bars > entry bar; EOD at bar 77 close."""
    o, h, l, c, atr = s["o"], s["h"], s["l"], s["c"], s["atr"]
    satr = atr[B_SIGNAL] * SQRT30
    m = c[B_SIGNAL] - o[0]
    if not (satr > 0) or abs(m) < k * satr:
        return None
    side = 1.0 if m > 0 else -1.0
    eb = entry_bar
    entry = c[eb]
    stop = entry - side * stop_mult * atr[eb]
    for b in range(eb + 1, 78):
        hit = (l[b] <= stop) if side > 0 else (h[b] >= stop)
        if hit:
            return (s["date"], side * (stop - entry) - fric("stop"), "stop")
        if b == 77:
            return (s["date"], side * (c[77] - entry) - fric("eod"), "eod")
    return None

def run(S, k, entry, stop_mult):
    eb = ENTRY_BARS[entry]
    rows = []
    for s in S:
        r = sim_day(s, k, eb, stop_mult)
        if r is not None:
            rows.append(r)
    return pd.DataFrame(rows, columns=["date", "net", "kind"])

def stats(tr):
    if len(tr) == 0:
        return dict(net_usd=0.0, mar=0.0, trades=0, hit=0.0, maxdd_usd=0.0,
                    yearly={}, top3_month_share=0.0, expectancy_pts=0.0)
    tr = tr.copy()
    dts = pd.to_datetime(tr["date"])
    tr["yr"] = dts.dt.year
    tr["ym"] = dts.dt.strftime("%Y-%m")
    net = tr["net"].to_numpy()
    eq = np.cumsum(net) * DPP
    dd = float((eq - np.maximum.accumulate(eq)).min())
    net_usd = float(net.sum() * DPP)
    mar = net_usd / abs(dd) if dd < 0 else float("inf")
    yearly = {str(y): float(v * DPP) for y, v in tr.groupby("yr")["net"].sum().items()}
    mo = tr.groupby("ym")["net"].sum() * DPP
    pos_mo = mo[mo > 0].sort_values(ascending=False)
    top3 = float(pos_mo.head(3).sum() / net_usd) if net_usd > 0 and len(pos_mo) else float("nan")
    return dict(net_usd=net_usd, mar=float(mar), trades=int(len(tr)),
                hit=float((net > 0).mean()), maxdd_usd=dd, yearly=yearly,
                top3_month_share=top3, expectancy_pts=float(net.mean()))

def survival(st):
    yrs = list(st["yearly"].values())
    ny = len(yrs)
