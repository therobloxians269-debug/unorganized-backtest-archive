==============================================================================
"""Reported robustness battery for the OTHER-8:30 REVERSAL hypothesis (post-hoc, so the
whole neighborhood is REPORTED, nothing selected): on big non-claims 8:30 release days
(CPI/PPI/NFP/retail...), the 08:30->09:00 knee-jerk partially REVERSES by ~11:00.
Found (t=-3.1 momentum side, both halves |t|>2) in research/factory/events.py.

Battery (all cells printed; the hypothesis lives or dies on the WHOLE table):
  A. explicit FADE simulation x {stop: none, 0.5%, 1.0%} x {exit: 10:00, 11:00, 12:00, 15:55}
  B. tercile tiers: top / mid / bottom |R| (does size of knee-jerk matter?)
  C. weekday split of the gated fade (Fri=NFP vs midweek=CPI/PPI/retail)
  D. NON-EVENT control: same fade rule on 8:30 days with NO volume spike (volx < 1.5)
     -> is the reversal release-specific or generic morning mean-reversion?
  E. MCPT: permute trade signs (5k) -> p-value of the gated fade's total net
  F. influence: drop best-5 / worst-5 trades; era table of the headline cell
Costs: $1.24 RT + 0.25 pt slip per market side. Headline cell fixed IN ADVANCE as the
closest analogue of the discovery: fade, 0.5% stop, exit 11:00, top-tercile gate.

    PYTHONPATH=. python3 -m research.factory.fade_battery
"""
from __future__ import annotations

import datetime as dt
from pathlib import Path

import numpy as np
import pandas as pd

from research.factory.events import (build_events, minute_frame, session_slice,
                                      POINT, COMM_RT, SLIP_PT, ERAS)

ROOT = Path(__file__).resolve().parents[2]
RNG = np.random.default_rng(7)


def sim(fr, days, stop_frac, t_exit):
    """Fade the 08:30->09:00 move R on the given (session_date -> R) days."""
    out = []
    for sd, R in days.items():
        day = session_slice(fr, sd)
        tod = day.index.time
        ent_bar = day[tod == dt.time(9, 1)]
        if ent_bar.empty or R == 0:
            continue
        d = -int(np.sign(R))                       # FADE
        entry = float(ent_bar["open"].iloc[0]) + (SLIP_PT if d > 0 else -SLIP_PT)
        win = day[(tod >= dt.time(9, 1)) & (tod <= t_exit)]
        exit_px, kind = None, "time"
        if stop_frac is not None:
            stop = entry * (1 - stop_frac) if d > 0 else entry * (1 + stop_frac)
            for _, b in win.iterrows():
                if d > 0 and b["low"] <= stop:
                    exit_px, kind = stop - SLIP_PT, "stop"; break
                if d < 0 and b["high"] >= stop:
                    exit_px, kind = stop + SLIP_PT, "stop"; break
        if exit_px is None:
            last = win.iloc[-1]
            exit_px = float(last["close"]) - (SLIP_PT if d > 0 else -SLIP_PT)
        g = d * (exit_px - entry)
        out.append(dict(session_date=sd, year=pd.Timestamp(sd).year, dir=d, kind=kind,
                        gross_pt=g, net=g * POINT - COMM_RT))
    return pd.DataFrame(out)


def stat(tr):
    if tr.empty:
        return "n=0"
    n, net = len(tr), tr["net"]
    t = net.mean() / net.std(ddof=1) * np.sqrt(n) if n > 1 and net.std() > 0 else np.nan
    return (f"n={n:>3} net=${net.sum():>7.0f} avg=${net.mean():>7.2f} "
            f"hit={(net > 0).mean()*100:>4.1f}% t={t:>5.2f} stops={(tr['kind']=='stop').sum()}")


def halves(tr):
    h = len(tr) // 2
    return stat(tr.iloc[:h]), stat(tr.iloc[h:])


def main():
    fr = pd.read_parquet(ROOT / "data" / "es_front_1m.parquet")
    ev = build_events(fr)
    oth = ev[ev["cls"] == "OTHER830"]

    tiers = {
        "top": oth[oth["gate"]]["R"],
        "mid": oth[~oth["gate"] & ~oth["lowgate"]]["R"],
        "bottom": oth[oth["lowgate"]]["R"],
    }

    print("=" * 100)
    print("A. FADE grid on TOP-tercile other-8:30 days (row = stop, col = exit)")
    print("=" * 100)
    for stop in (None, 0.005, 0.010):
        for ex in (dt.time(10, 0), dt.time(11, 0), dt.time(12, 0), dt.time(15, 55)):
            tr = sim(fr, tiers["top"], stop, ex)
            tag = f"stop={'none ' if stop is None else f'{stop*100:.1f}%'} exit={ex.strftime('%H:%M')}"
            print(f"  {tag:<24} {stat(tr)}")

    print("\nB. tercile tiers (headline geometry: stop 0.5%, exit 11:00)")
    for name, days in tiers.items():
        print(f"  {name:<8} {stat(sim(fr, days, 0.005, dt.time(11, 0)))}")

    print("\nC. weekday split of the gated fade (headline geometry)")
    top = tiers["top"]
    wd = pd.Series([pd.Timestamp(sd).weekday() for sd in top.index], index=top.index)
    for w, nm in [(0, "Mon"), (1, "Tue"), (2, "Wed"), (4, "Fri=NFP")]:
        print(f"  {nm:<8} {stat(sim(fr, top[wd == w], 0.005, dt.time(11, 0)))}")

    print("\nD. NON-EVENT control: fade 8:30->9:00 move on NO-spike days (volx<1.5), |R| top-tercile of its own class")
    v831 = minute_frame(fr, 8, 31)["volume"].astype(float)
    med = v831.rolling(250, min_periods=100).median().shift(1)
    volx = v831 / med
    c830 = minute_frame(fr, 8, 30)["close"]; c900 = minute_frame(fr, 9, 0)["close"]
    quiet = volx[(volx < 1.5)].index
    Rq = (c900.reindex(quiet) / c830.reindex(quiet) - 1.0).dropna()
    hi = Rq.abs().rolling(252, min_periods=50).quantile(2 / 3).shift(1)
    Rq_top = Rq[Rq.abs() >= hi]
    print(f"  quiet-day top-tercile {stat(sim(fr, Rq_top, 0.005, dt.time(11, 0)))}")

    print("\nE. MCPT (5k sign permutations) on headline cell")
    tr = sim(fr, tiers["top"], 0.005, dt.time(11, 0))
    net = tr["net"].values
    obs = net.sum()
    # permute signs of GROSS, re-apply costs (cost part is sign-invariant)
    gross = tr["gross_pt"].values * POINT
    cost = gross - net
    perm = np.array([(gross * RNG.choice([-1, 1], len(gross)) - cost).sum() for _ in range(5000)])
    p = (perm >= obs).mean()
    print(f"  observed net ${obs:.0f} | MCPT p = {p:.4f}")

    print("\nF. influence + eras (headline cell)")
    s = tr.sort_values("net")
    print(f"  drop worst-5 {stat(pd.concat([s.iloc[5:]]))}")
    print(f"  drop best-5  {stat(s.iloc[:-5])}")
    print(f"  drop both-5  {stat(s.iloc[5:-5])}")
    for tag, y0, y1 in ERAS:
        print(f"  {tag:<8} {stat(tr[(tr['year'] >= y0) & (tr['year'] <= y1)])}")
    h1, h2 = halves(tr)
    print(f"  H1       {h1}")
    print(f"  H2 <-OOS {h2}")


if __name__ == "__main__":
    main()

