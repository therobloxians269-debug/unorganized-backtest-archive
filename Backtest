"""1-hour liquidity pool tracking.

Aggregates completed 1m bars into 1H bars (ET clock), marks 1H fractal
swing highs as buy-side liquidity (BSL) and swing lows as sell-side
liquidity (SSL), and records when subsequent trade sweeps a pool.

Causality: a fractal with half-width k is only confirmed k completed 1H
bars later; a pool is never visible before its confirmation time.
"""
from __future__ import annotations

from dataclasses import dataclass, field
from datetime import datetime, timedelta

BSL = +1  # buy-side liquidity: resting stops above a swing high
SSL = -1  # sell-side liquidity: resting stops below a swing low


@dataclass
class Pool:
    side: int              # BSL or SSL
    level: float
    formed_ts: datetime    # timestamp of the swing bar itself
    confirmed_ts: datetime # when the fractal completed (k bars later)
    swept_ts: datetime | None = None


@dataclass
class SweepEvent:
    ts: datetime
    side: int
    level: float


class PoolTracker:
    def __init__(self, fractal_k: int = 2, max_age_hours: int = 48):
        self.k = fractal_k
        self.max_age = timedelta(hours=max_age_hours)
        self._h1: list[tuple[datetime, float, float]] = []  # (open_ts, high, low)
        self._cur_hour: datetime | None = None
        self._cur_high: float | None = None
        self._cur_low: float | None = None
        self.pools: list[Pool] = []
        self.sweeps: list[SweepEvent] = []

    # ------------------------------------------------------------------
    def on_1m_bar(self, ts: datetime, high: float, low: float) -> None:
        """Feed one completed 1m bar (ts = bar open time, tz-aware ET)."""
        hour = ts.replace(minute=0, second=0, microsecond=0)
        if self._cur_hour is None:
            self._cur_hour, self._cur_high, self._cur_low = hour, high, low
        elif hour == self._cur_hour:
            self._cur_high = max(self._cur_high, high)
            self._cur_low = min(self._cur_low, low)
        else:
            self._close_hour(now=ts)
            self._cur_hour, self._cur_high, self._cur_low = hour, high, low

        self._mark_sweeps(ts, high, low)
        self._expire(ts)

    # ------------------------------------------------------------------
    def _close_hour(self, now: datetime) -> None:
        self._h1.append((self._cur_hour, self._cur_high, self._cur_low))
        if len(self._h1) > 400:
            self._h1 = self._h1[-400:]
        n = len(self._h1)
        i = n - 1 - self.k  # candidate now confirmable
        if i < self.k:
            return
        ts_i, hi_i, lo_i = self._h1[i]
        confirm_ts = now  # the k-th right-neighbour hour just closed
        neigh = self._h1[i - self.k:i] + self._h1[i + 1:i + 1 + self.k]
        if all(hi_i > h for _, h, _ in neigh):
            self.pools.append(Pool(BSL, hi_i, ts_i, confirm_ts))
        if all(lo_i < l for _, _, l in neigh):
            self.pools.append(Pool(SSL, lo_i, ts_i, confirm_ts))

    # ------------------------------------------------------------------
    def _mark_sweeps(self, ts: datetime, high: float, low: float) -> None:
        for p in self.pools:
            if p.swept_ts is not None or ts < p.confirmed_ts:
                continue
            if (p.side == BSL and high > p.level) or (p.side == SSL and low < p.level):
                p.swept_ts = ts
                self.sweeps.append(SweepEvent(ts, p.side, p.level))
        if len(self.sweeps) > 500:
            self.sweeps = self.sweeps[-500:]

    def _expire(self, ts: datetime) -> None:
        cutoff = ts - self.max_age
        self.pools = [p for p in self.pools if p.formed_ts >= cutoff]

    # ------------------------------------------------------------------
    def unswept(self, side: int, ts: datetime) -> list[Pool]:
        """Pools of `side` visible (confirmed) and unswept as of ts."""
        return [p for p in self.pools
                if p.side == side and p.swept_ts is None and p.confirmed_ts <= ts]

    def swept_between(self, side: int, t0: datetime, t1: datetime) -> bool:
        return any(s.side == side and t0 <= s.ts <= t1 for s in self.sweeps)

