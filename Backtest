"""Opening Range Breakout — every anchor, window, and mode."""
import pandas as pd, numpy as np, warnings; warnings.filterwarnings('ignore')
FLAT=1019
ANCH={'rth930':570,'ny600':360,'day1800':1080,'lon0000':0}

def build(df):
    o=df.copy(); m=(o.index.hour*60+o.index.minute).values
    o['minofday']=m
    r=o.resample('60min',label='left',closed='left').agg({'h':'max','l':'min','c':'last'}).dropna()
    tr=pd.concat([r.h-r.l,(r.h-r.c.shift()).abs(),(r.l-r.c.shift()).abs()],axis=1).max(axis=1)
    o['atr60']=tr.rolling(14).mean().shift(1).reindex(o.index,method='ffill')   # causal
    return o

def or_levels(b, anchor='rth930', win=30):
    """OR high/low per day cycle, KNOWN at the first bar after the window closes."""
    a=ANCH[anchor]; out=[]
    for day,g in b.groupby('daycycle',sort=True):
        w=g[(g.minofday>=a)&(g.minofday<a+win)]
        if len(w) < max(3, win//3): continue
        post=g[g.index>w.index[-1]]
        post=post[~((post.minofday>=FLAT)&(post.minofday<1080))]   # skip the 16:59-18:00 close
        if len(post)<30: continue
        out.append(dict(day=day,known=post.index[0],orh=w.h.max(),orl=w.l.min(),
                        w=w.h.max()-w.l.min()))
    return pd.DataFrame(out)

def trade(b, OR, mode='breakout', rr=2.0, stop_mode='mid', buf=1.0, ext=1.0, max_risk_atr=3.0, be_at=0.0,
          minw_atr=0.0, maxw_atr=99., max_hold=390, pv=20., comm=4., slip=0.25,
          one_per_day=True, retest_bars=60, displace=None, seed=0, min_rr=0.0):
    idx=b.index; h=b['h'].values; l=b['l'].values; o=b['o'].values; c=b['c'].values
    m=b['minofday'].values; atr=b['atr60'].values; n=len(b)
    rng=np.random.default_rng(seed); out=[]
    for _,R in OR.iterrows():
        orh,orl,w=R.orh,R.orl,R.w
        if displace is not None:
            sh=displace*(1 if rng.random()<.5 else -1); orh+=sh; orl+=sh
        s=idx.searchsorted(R.known)
        a0=atr[s] if s<n and np.isfinite(atr[s]) and atr[s]>0 else np.nan
        if not np.isfinite(a0) or w<=0: continue
        if not (minw_atr*a0 <= w <= maxw_atr*a0): continue
        done=False
        j=s-1
        while True:
            j+=1
            if j>=n: break
            if (FLAT<=m[j]<1080) or (j+2>=n): break
            up = h[j]>orh; dn = l[j]<orl
            if not (up or dn): continue
            d = 1 if up else -1
            if mode=='fade': d=-d
            j0=j
            if mode=='retest':
                lvl=orh if up else orl
                j0=None
                for q in range(j+1,min(j+1+retest_bars,n)):
                    if FLAT<=m[q]<1080: break
                    if (l[q]<=lvl) if up else (h[q]>=lvl): j0=q; break
                if j0 is None: break
            if j0+2>=n: break
            ep=o[j0+1]+(slip if d==1 else -slip)
            if stop_mode=='mid':  st=(orh+orl)/2
            elif stop_mode=='opp': st=orl-buf if d==1 else orh+buf
            else: st=ep-0.5*w if d==1 else ep+0.5*w
            # the stop MUST sit on the losing side of entry, else the geometry is fake
            if (d==1 and st>=ep) or (d==-1 and st<=ep): break
            risk=abs(ep-st)
            if risk<=0 or risk>max_risk_atr*a0: break
            tg = ep+rr*risk if d==1 else ep-rr*risk
            if abs(tg-ep)/risk<min_rr: break
            if be_at>0:
                # walk forward, move stop to BE once +be_at R is reached
                e0=min(j0+1+max_hold,n); cs=st; moved=False
                for q in range(j0+1,e0):
                    if (FLAT<=m[q]<1080): break
                    fav=(h[q]-ep) if d==1 else (ep-l[q])
                    if not moved and fav>=be_at*risk:
                        cs=ep; moved=True
                    hitS=(l[q]<=cs) if d==1 else (h[q]>=cs)
                    hitT=(h[q]>=tg) if d==1 else (l[q]<=tg)
                    if hitS or hitT:
                        px=(tg if hitT and not hitS else cs)+(0 if hitT else (slip if d==-1 else -slip))
                        pts=(ep-px) if d==-1 else (px-ep); net=pts*pv-comm
                        out.append(dict(t=idx[j0+1],d=d,R=net/(risk*pv),pnl=net,risk=risk,
                                        why='tgt' if hitT and not hitS else 'stop',w_atr=w/a0))
                        done=True; break
                else:
                    q=min(j0+max_hold,n-1); px=o[q]
                    pts=(ep-px) if d==-1 else (px-ep); net=pts*pv-comm
                    out.append(dict(t=idx[j0+1],d=d,R=net/(risk*pv),pnl=net,risk=risk,why='time',w_atr=w/a0))
                    done=True
                if one_per_day: break
                j=j0+1
                continue
            e=min(j0+1+max_hold,n)
            mm=m[j0+1:e]
            fl=np.where((mm>=FLAT)&(mm<1080))[0]
            e2=j0+1+int(fl[0]) if len(fl) else e
            hs=h[j0+1:e2]; ls=l[j0+1:e2]
            if len(hs)==0:
                k=j0+1; px=o[k]; wy='flat'
            else:
                sh=(hs>=st) if d==-1 else (ls<=st)
                th=(ls<=tg) if d==-1 else (hs>=tg)
                si=int(sh.argmax()) if sh.any() else 10**9
                ti=int(th.argmax()) if th.any() else 10**9
                if si==10**9 and ti==10**9:
                    k=e2-1; px=o[k]+(slip if d==-1 else -slip); wy='flat' if e2<e else 'time'
                elif si<=ti:
                    k=j0+1+si; px=st+(slip if d==-1 else -slip); wy='stop'
                else:
                    k=j0+1+ti; px=tg; wy='tgt'
            pts=(ep-px) if d==-1 else (px-ep); net=pts*pv-comm
            out.append(dict(t=idx[j0+1],d=d,R=net/(risk*pv),pnl=net,risk=risk,why=wy,w_atr=w/a0,mins=k-j0))
            done=True
            if one_per_day: break
            j = max(k, j0+1)          # genuine skip: while-loop, so this sticks
        _=done
    return pd.DataFrame(out)

def rep(t,days,lab):
    if t is None or len(t)<20: return f'{lab:40s} n={0 if t is None else len(t)}'
    pf=t.pnl[t.pnl>0].sum()/max(1e-9,-t.pnl[t.pnl<0].sum())
    R=np.sort(t.R.values)[::-1]; d3=(R.sum()-R[:3].sum())/max(1,len(R)-3)
    return (f'{lab:40s} n={len(t):4d} ({len(t)/days:4.2f}/d) WR={(t.pnl>0).mean()*100:4.1f}% '
            f'avgR={t.R.mean():+.3f} d3={d3:+.3f} $/tr={t.pnl.mean():+7.1f} PF={pf:4.2f}')

