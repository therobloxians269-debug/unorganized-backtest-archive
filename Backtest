"""
TERMINUS · state features.

At every checkpoint t in the session, for each side (hi / lo), describe the state of
the RUNNING extreme on that side. The question the model answers is not "where will
the high be" but "is the high I can already see the final one?"

Causality rule enforced throughout: a feature attached to checkpoint t may only use
bars with tod <= t, plus prior-session data. Nothing from t+1 onward. The label is
the only thing that looks forward.

Every feature is expressible in Pine with running state only — no lookahead, no
refit — because M6 has to ship this as an indicator.
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')

RTH0, RTH1 = 570, 960
CHECK = list(range(600, 956, 5))      # 10:00 -> 15:55 every 5 min

FEATS = [
    's_el',      # elapsed fraction of the session
    's_run',     # extent of THIS side's run from the open, in ADR
    's_opp',     # extent of the opposite side, in ADR
    's_used',    # range used so far / ADR
    's_room',    # (1 - used/ADR) clipped: how much typical range is left
    's_since',   # fraction of elapsed session since this extreme was set
    's_nnew',    # rate of new extremes on this side
    's_pos',     # close position vs open, signed toward this side
    's_vel',     # 30m velocity, signed toward this side
    's_retr',    # retracement away from this extreme, as a fraction of range used
    's_vwap',    # distance of close from session VWAP, signed toward this side
    's_ibb',     # has the IB edge on this side been broken
    's_onb',     # has the overnight extreme on this side been broken
    's_gap',     # opening gap in ADR, signed toward this side
    's_expa',    # today's range vs ADR at this point of day (expansion)
]


def _running(H, L, C, V):
    """Per-bar running state, all strictly backward-looking."""
    n = len(H)
    cmaxH = np.maximum.accumulate(H)
    cminL = np.minimum.accumulate(L)
    # index of the bar that set the running extreme
    ihi = np.zeros(n, dtype=np.int64)
    ilo = np.zeros(n, dtype=np.int64)
    nhi = np.zeros(n, dtype=np.int64)
    nlo = np.zeros(n, dtype=np.int64)
    for i in range(1, n):
        newh = H[i] >= cmaxH[i - 1] - 1e-9
        newl = L[i] <= cminL[i - 1] + 1e-9
        ihi[i] = i if newh else ihi[i - 1]
        ilo[i] = i if newl else ilo[i - 1]
        nhi[i] = nhi[i - 1] + int(newh)
        nlo[i] = nlo[i - 1] + int(newl)
    pv = np.cumsum(((H + L + C) / 3.0) * V)
    cv = np.cumsum(V)
    vwap = np.where(cv > 0, pv / np.maximum(cv, 1e-9), C)
    return cmaxH, cminL, ihi, ilo, nhi, nlo, vwap


def events(day, rb, checks=CHECK, iblen=60):
    """
    One row per (session, checkpoint, side).

    surv == True means the running extreme on that side was never exceeded for the
    rest of the session, i.e. it IS the day's extreme.
    """
    rows = []
    for dd, row in day.iterrows():
        b = rb.get(dd)
        if b is None:
            continue
        H, L, C, T, V = b['H'], b['L'], b['C'], b['T'], b['V']
        A, o = float(row.ADR), float(row.o930)
        if not (A > 0) or len(H) < 200:
            continue
        cmaxH, cminL, ihi, ilo, nhi, nlo, vwap = _running(H, L, C, V)
        dayH, dayL = float(H.max()), float(L.min())

        mib = T < RTH0 + iblen
        if mib.sum() < iblen * 0.8:
            continue
        ibh, ibl = float(H[mib].max()), float(L[mib].min())
        onH, onL = float(row.onH), float(row.onL)
        gap = (o - float(row.prevC)) / A

        for t in checks:
            k = int(np.searchsorted(T, t, side='right')) - 1
            if k < 30 or k >= len(H) - 5:
                continue
            rh, rl = float(cmaxH[k]), float(cminL[k])
            used = (rh - rl) / A
            el = (t - RTH0) / float(RTH1 - RTH0)
            vel = (C[k] - C[max(0, k - 30)]) / A
            vw = (C[k] - vwap[k]) / A
            expa = used / max(el, 1e-6)          # pace of range build vs a linear day

            for side in ('hi', 'lo'):
                sgn = 1.0 if side == 'hi' else -1.0
                run = (rh - o) / A if side == 'hi' else (o - rl) / A
                opp = (o - rl) / A if side == 'hi' else (rh - o) / A
                iex = ihi[k] if side == 'hi' else ilo[k]
                nnew = (nhi[k] if side == 'hi' else nlo[k]) / max(k, 1)
                lvl = rh if side == 'hi' else rl
                retr = (abs(lvl - C[k]) / A) / max(used, 1e-6)
                surv = (dayH <= rh + 1e-9) if side == 'hi' else (dayL >= rl - 1e-9)
                ibb = 1.0 if (rh > ibh + 1e-9 if side == 'hi' else rl < ibl - 1e-9) else 0.0
                onb = 1.0 if (rh > onH + 1e-9 if side == 'hi' else rl < onL - 1e-9) else 0.0

                rows.append((dd, t, side, bool(surv), lvl, A, o,
                             el, run, opp, used, max(0.0, 1.0 - used),
                             (k - iex) / max(k, 1), nnew,
                             (C[k] - o) / A * sgn, vel * sgn, retr, vw * sgn,
                             ibb, onb, gap * sgn, expa))

    cols = (['day', 't', 'side', 'surv', 'lvl', 'ADR', 'o930'] + FEATS)
    f = pd.DataFrame.from_records(rows, columns=cols)
    return f.replace([np.inf, -np.inf], np.nan).dropna(subset=FEATS)

