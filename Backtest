"""
The only question that matters for a funded account:
does this pass an eval and produce payouts, or does it blow the trailing drawdown?

Expectancy does not answer that. Path does.
"""
import numpy as np, pandas as pd
import qtlib as Q
from backtest import run, _stamp

LB, BOTH, IOPEN, LAYERS = 6, True, "tny_alt", "TNY_ALT_PLACEHOLDER"
LAYERS = "L1L2"
TARGET = 3                      # the tradeable expression
MNQ_PT = 2.0                    # $/point micro
COST_PTS = 1.12                 # all-in RT on MNQ, in NQ points

df = Q.add_true_opens(Q.load_data(verbose=False))
b15, b5 = _stamp(Q.resample(df, "15min")), _stamp(Q.resample(df, "5min"))
pre = {"b15": b15, "b5": b5}
for s in ("short", "long"):
    pre[f"s15_{s}"] = Q.ssmt(b15, lookback=LB, side=s, require_both=BOTH)
    pre[f"s5_{s}"] = Q.ssmt(b5, lookback=LB, side=s, require_both=BOTH)

tr = pd.concat([run(df, layers=LAYERS, side=s, internal_open=IOPEN, pre=pre)
                for s in ("short", "long")], ignore_index=True)
tr = tr.sort_values("entry_time").reset_index(drop=True)
print(f"[trades] n={len(tr)}  median R = {tr['r_pts'].median():.1f} NQ pts "
      f"(= ${tr['r_pts'].median()*MNQ_PT:.0f} risk per MNQ)")

g = tr[f"R{TARGET}_gross"].to_numpy()
mae = tr[f"R{TARGET}_mae"].to_numpy()
rp = tr["r_pts"].to_numpy()
print(f"[{TARGET}R] win rate={np.mean(g > 0):.3f}  gross={g.mean():+.4f}R  "
      f"median MAE={np.median(mae):.2f}R  p90 MAE={np.percentile(mae, 90):.2f}R")


def simulate(contracts, start_bal, dd_limit, target, seed, n_trades=None, block=20):
    """One account run. Trailing threshold drawdown that follows the intraday peak.

    Per trade the equity path is modelled as: dip to -MAE, then resolve to the
    outcome. MAE is measured, not assumed, so the drawdown test is honest.
    """
    rng = np.random.default_rng(seed)
    n = len(g)
    k = n_trades or n
    # stationary block bootstrap to preserve short-run streaks
    idx = []
    while len(idx) < k:
        s = rng.integers(0, n)
        idx.extend(range(s, min(s + block, n)))
    idx = np.array(idx[:k])

    bal = start_bal
    floor = start_bal - dd_limit
    peak = start_bal
    for i in idx:
        risk_d = rp[i] * MNQ_PT * contracts
        cost_d = COST_PTS * MNQ_PT * contracts
        # intra-trade dip
        low = bal - mae[i] * risk_d - cost_d
        if low <= floor:
            return "blown", bal - (bal - floor)
        bal = bal + g[i] * risk_d - cost_d
        if bal > peak:
            peak = bal
            floor = min(peak - dd_limit, start_bal)  # locks at start once buffer earned
        if bal <= floor:
            return "blown", bal
        if bal - start_bal >= target:
            return "passed", bal
    return "neither", bal


print("\n" + "=" * 88)
print("EVAL SIMULATION — $50K account, MNQ, 3R target")
print("blown = hit trailing drawdown | passed = reached profit target first")
print("=" * 88)
print(f"{'DD limit':>9} {'contracts':>10} {'risk/trade':>11} {'P(pass)':>9} "
      f"{'P(blow)':>9} {'P(neither)':>11} {'med trades':>11}")

RUNS = 2000
for dd_limit, target in ((2500, 3000), (2000, 3000)):
    for contracts in (1, 2, 3, 5, 8):
        res = [simulate(contracts, 50_000, dd_limit, target, seed=s, n_trades=250)
               for s in range(RUNS)]
        outc = pd.Series([r[0] for r in res])
        risk = np.median(rp) * MNQ_PT * contracts
        print(f"{dd_limit:>9} {contracts:>10} {risk:>10.0f}$ "
              f"{(outc=='passed').mean():>9.3f} {(outc=='blown').mean():>9.3f} "
              f"{(outc=='neither').mean():>11.3f} {'250':>11}")

print("\n" + "=" * 88)
print("REALITY CHECK — what does the historical sequence actually produce?")
print("=" * 88)
for contracts in (1, 2, 3, 5):
    risk_d = rp * MNQ_PT * contracts
    pnl = g * risk_d - COST_PTS * MNQ_PT * contracts
    eq = np.cumsum(pnl)
    dd = np.maximum.accumulate(eq) - eq
    yrs = (pd.to_datetime(tr["entry_time"].iloc[-1]) -
           pd.to_datetime(tr["entry_time"].iloc[0])).days / 365.25
    print(f"  {contracts} MNQ: total=${eq[-1]:>8,.0f}  ${eq[-1]/yrs:>7,.0f}/yr  "
          f"maxDD=${dd.max():>7,.0f}  worst trade=${pnl.min():>7,.0f}  "
          f"per-day=${eq[-1]/(yrs*252):>6,.0f}")

