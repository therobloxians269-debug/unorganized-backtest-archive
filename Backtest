"""Standardized 1-minute bar loader (ET-indexed) + session/indicator helpers.

REAL data source: /Users/kaveh/quant_lab/cache/es_ym_1m.parquet
  - real ES + YM 1-minute bars, 24h, 2019-05 .. 2026-06 (~1750 sessions)
  - ET tz-aware index; has min_of_day (ET), rth (bool), session (trade date)
We trade ES as MES ($5/pt) and YM as MYM ($0.50/pt) for the $1k-account test.
(The ict_engine/*.csv files were found to be synthetic random-walk data and are NOT used.)
"""
import functools
import numpy as np
import pandas as pd

SRC = "/Users/kaveh/quant_lab/cache/es_ym_1m.parquet"
COLS = {"MES": "es", "MYM": "ym"}          # tradable micro -> column prefix in the parquet

RTH_OPEN = 9 * 60 + 30      # 09:30 ET
RTH_CLOSE = 16 * 60         # 16:00 ET


@functools.lru_cache(maxsize=4)
def _raw():
    df = pd.read_parquet(SRC)
    df = df.sort_index()
    # session -> tz-naive normalized Timestamp
    df["date"] = pd.to_datetime(df["session"]).dt.tz_localize(None).dt.normalize() \
        if df["session"].dtype == object else pd.to_datetime(df["session"]).dt.normalize()
    return df


@functools.lru_cache(maxsize=4)
def load(sym):
    p = COLS[sym]
    raw = _raw()
    df = pd.DataFrame({
        "open": raw[f"{p}_open"], "high": raw[f"{p}_high"], "low": raw[f"{p}_low"],
        "close": raw[f"{p}_close"], "volume": raw[f"{p}_volume"],
        "mod": raw["min_of_day"].astype(int), "rth": raw["rth"].astype(bool),
        "date": raw["date"],
    }, index=raw.index)
    df = df.dropna(subset=["open", "high", "low", "close"])
    df = df[df["high"] >= df["low"]]
    df["dow"] = df.index.dayofweek
    return df


def rth(df):
    out = df[df["rth"]].copy()
    out["mos"] = out["mod"] - RTH_OPEN
    return out


def add_vwap(day):
    tp = (day["high"] + day["low"] + day["close"]) / 3.0
    v = day["volume"].clip(lower=1e-9)
    cum_v = v.cumsum()
    vwap = (tp * v).cumsum() / cum_v
    dev = tp - vwap
    var = (v * dev * dev).cumsum() / cum_v
    day = day.copy()
    day["vwap"] = vwap
    day["vwap_sd"] = np.sqrt(var.clip(lower=0))
    return day


def ema(s, n):
    return s.ewm(span=n, adjust=False).mean()


def atr(day, n=14):
    h, l, c = day["high"], day["low"], day["close"]
    pc = c.shift(1)
    tr = pd.concat([(h - l), (h - pc).abs(), (l - pc).abs()], axis=1).max(axis=1)
    return tr.ewm(span=n, adjust=False).mean()


def rsi(s, n=14):
    d = s.diff()
    up = d.clip(lower=0).ewm(alpha=1 / n, adjust=False).mean()
    dn = (-d.clip(upper=0)).ewm(alpha=1 / n, adjust=False).mean()
    rs = up / dn.replace(0, np.nan)
    return (100 - 100 / (1 + rs)).fillna(50)


if __name__ == "__main__":
    for s in ("MES", "MYM"):
        df = load(s)
        r = rth(df)
        daily = r.groupby("date")["close"].last()
        print(f"{s}: {len(df):>8} bars  {df['date'].min().date()}..{df['date'].max().date()}  "
              f"RTH days={r['date'].nunique()}  median |dayΔ close|={daily.diff().abs().median():.2f}pt  "
              f"px {df['close'].min():.0f}..{df['close'].max():.0f}")

