"""
The hot-streak->reversion finding motivates a SHORT-TERM REVERSAL sleeve. Test if it's a
positive, low-correlation stream to stack on trend (carry was uncorrelated but FLAT, so it
hurt). If reversal is positive AND uncorrelated, the combo Sharpe rises -> Apex P rises.
Honest: net of cost, full + OOS, with the multiple-testing caveat.

    python3 reversion_stack.py
"""
from __future__ import annotations
import numpy as np
import pandas as pd
from lib_perf import perf_stats

PANEL = "/Users/kaveh/mim_research/futures_panel.parquet"
ANN = 252


def sharpe(r):
    r = r.dropna(); return r.mean() / r.std() * np.sqrt(ANN) if r.std() > 0 else np.nan


def main():
    p = pd.read_parquet(PANEL)
    F = p.pivot_table(index="date", columns="root", values="fret").sort_index()
    AV = (F.rolling(63).std() * np.sqrt(ANN)).shift(1)

    # ---- cross-sectional SHORT-TERM REVERSAL: long recent losers / short recent winners ----
    for look, rebal in ((5, "W"), (10, "W"), (21, "W")):
        ret_l = F.rolling(look).sum()
        xs = ret_l.sub(ret_l.mean(axis=1), axis=0)               # cross-sectional demean
        sig = -(xs / AV)                                          # fade the move, vol-scaled
        w = sig.div(sig.abs().sum(axis=1).replace(0, np.nan), axis=0).fillna(0.0).clip(-0.2, 0.2)
        w = w.shift(1).resample(rebal).last().reindex(F.index, method="ffill")
        sc = (0.12 / ((w * F).sum(axis=1).rolling(63).std() * np.sqrt(ANN))).shift(1).clip(0, 3).fillna(0.0)
        w = w.mul(sc, axis=0)
        turn = w.diff().abs().sum(axis=1)
        net = ((w * F).sum(axis=1) - turn * 3.0 * 1e-4).dropna()
        oos = net[net.index >= "2018-01-01"]
        print(f"  XS-reversal {look:2d}d/{rebal}:  Sharpe {sharpe(net):+.2f} (OOS {sharpe(oos):+.2f}) "
              f"| turn {turn.mean()*ANN:.0f}x | CAGR {perf_stats(net,ANN)['cagr']*100:+.1f}%")

    # pick 10d as representative and stack with trend
    ret_l = F.rolling(10).sum(); xs = ret_l.sub(ret_l.mean(axis=1), axis=0)
    sig = -(xs / AV)
    w = sig.div(sig.abs().sum(axis=1).replace(0, np.nan), axis=0).fillna(0.0).clip(-0.2, 0.2)
    w = w.shift(1).resample("W").last().reindex(F.index, method="ffill")
    sc = (0.12 / ((w * F).sum(axis=1).rolling(63).std() * np.sqrt(ANN))).shift(1).clip(0, 3).fillna(0.0)
    rev = ((w.mul(sc, axis=0) * F).sum(axis=1) - (w.mul(sc, axis=0)).diff().abs().sum(axis=1) * 3e-4).dropna()

    trend = pd.read_parquet("/Users/kaveh/mim_research/trend_all.parquet")["net"]
    j = pd.concat([trend.rename("T"), rev.rename("R")], axis=1).dropna()
    rho = j["T"].corr(j["R"])
    uT = j["T"] / (j["T"].std()); uR = j["R"] / (j["R"].std())
    combo = (uT + uR) / 2
    print(f"\n  corr(trend, reversal) = {rho:+.2f}")
    print(f"  trend  Sharpe {sharpe(j['T']):+.2f} | reversal {sharpe(j['R']):+.2f} | "
          f"COMBO {sharpe(combo):+.2f}")
    if sharpe(combo) > sharpe(j["T"]):
        combo.to_frame("net").to_parquet("/Users/kaveh/mim_research/trend_rev_combo.parquet")
        print("  -> combo beats trend; saved trend_rev_combo.parquet for Apex re-sim")
    else:
        print("  -> combo does NOT beat trend alone; reversal does not help the eval generator")


