from __future__ import annotations
import time
import numpy as np
import pandas as pd
import requests
from lib_perf import perf_stats, per_year, maxdd

CACHE = "/Users/kaveh/mim_research/okx_funding.parquet"
COINS = ["BTC", "ETH", "SOL", "XRP", "DOGE", "BNB", "ADA", "AVAX", "LINK", "LTC", "DOT", "TRX"]
