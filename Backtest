"""1-minute market structure: fractal swings and Fair Value Gaps.

Swings confirm k bars after the pivot (causal). FVGs are the classic
3-candle imbalance: bullish when bar[i].low > bar[i-2].high, bearish when
bar[i].high < bar[i-2].low — detectable at the close of bar i.
"""
from __future__ import annotations

from collections import deque
from dataclasses import dataclass
from datetime import datetime


@dataclass
class Swing:
    ts: datetime
    level: float
    kind: int          # +1 swing high, -1 swing low
    confirmed_ts: datetime


@dataclass
class FVG:
    ts: datetime       # timestamp of the third candle
    direction: int     # +1 bullish gap, -1 bearish gap
    top: float
    bottom: float

    @property
    def mid(self) -> float:
        return (self.top + self.bottom) / 2.0


class StructureTracker:
    def __init__(self, swing_k: int = 2, maxlen: int = 240):
        self.k = swing_k
        self.bars: deque = deque(maxlen=maxlen)          # (ts, o, h, l, c)
        self.swing_highs: deque = deque(maxlen=60)
        self.swing_lows: deque = deque(maxlen=60)

    def on_1m_bar(self, ts: datetime, o: float, h: float, l: float, c: float) -> None:
        self.bars.append((ts, o, h, l, c))
        n = len(self.bars)
        i = n - 1 - self.k
        if i < self.k:
            return
        _, _, hi, lo, _ = self.bars[i]
        ts_i = self.bars[i][0]
        confirm_ts = ts
        neigh = [self.bars[j] for j in range(i - self.k, i)] + \
                [self.bars[j] for j in range(i + 1, i + 1 + self.k)]
        if all(hi > b[2] for b in neigh):
            self.swing_highs.append(Swing(ts_i, hi, +1, confirm_ts))
        if all(lo < b[3] for b in neigh):
            self.swing_lows.append(Swing(ts_i, lo, -1, confirm_ts))

    # ------------------------------------------------------------------
    def last_swing_low_below(self, price: float, ts: datetime) -> Swing | None:
        for s in reversed(self.swing_lows):
            if s.confirmed_ts <= ts and s.level < price:
                return s
        return None

    def last_swing_high_above(self, price: float, ts: datetime) -> Swing | None:
        for s in reversed(self.swing_highs):
            if s.confirmed_ts <= ts and s.level > price:
                return s
        return None

    # ------------------------------------------------------------------
    def recent_fvg(self, direction: int, since_ts: datetime) -> FVG | None:
        """Most recent FVG of `direction` whose third candle opened >= since_ts."""
        bars = list(self.bars)
        for i in range(len(bars) - 1, 1, -1):
            ts_i = bars[i][0]
            if ts_i < since_ts:
                break
            _, _, h1, l1, _ = bars[i - 2]
            _, _, h3, l3, _ = bars[i]
            if direction == -1 and h3 < l1:          # bearish gap
                return FVG(ts_i, -1, top=l1, bottom=h3)
            if direction == +1 and l3 > h1:          # bullish gap
                return FVG(ts_i, +1, top=l3, bottom=h1)
        return None

