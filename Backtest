import pandas as pd, numpy as np, warnings; warnings.filterwarnings('ignore')
FLAT=1019
def prep(df):
    o=df.copy(); m=(o.index.hour*60+o.index.minute).values
    o['minofday']=m; f18=(m-1080+1440)%1440
    o['q90']=f18//90; o['sess6']=f18//360
    o['dkey']=o['daycycle'].astype(str)
    o['skey']=o['dkey']+'_'+o['sess6'].astype(str)
    o['mkey']=o['dkey']+'_'+o['q90'].astype(str)
    r=o.resample('60min',label='left',closed='left').agg({'h':'max','l':'min','c':'last'}).dropna()
    tr=pd.concat([r.h-r.l,(r.h-r.c.shift()).abs(),(r.l-r.c.shift()).abs()],axis=1).max(axis=1)
    o['atr60']=tr.rolling(14).mean().shift(1).reindex(o.index,method='ffill')
    return o

def levels_true_opens(b):
    """TDO / TSO / TMSO / TWO / TMO — each valid from the moment it prints."""
    out=[]
    for key,lab in [('dkey','TDO'),('skey','TSO'),('mkey','TMSO')]:
        g=b.groupby(key,sort=False)
        first=g['o'].first(); t0=g.apply(lambda x: x.index[0])
        for k in first.index:
            out.append(dict(kind=lab,px=first[k],known=t0[k]))
    # true week open: first bar after a >12h gap
    dt=b.index.to_series().diff()
    for i in np.where(dt>pd.Timedelta(hours=12))[0]:
        out.append(dict(kind='TWO',px=b['o'].iloc[i],known=b.index[i]))
    # true month open
    mo=b.groupby(b.index.to_period('M'))
    for k,g in mo:
        out.append(dict(kind='TMO',px=g['o'].iloc[0],known=g.index[0]))
    return pd.DataFrame(out)

