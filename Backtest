def sweep(P, mkt, grid, ncyc, min_tpd=1.0, verbose=True):
    """Run a grid on one panel.  Caches the vectorised candidate arrays."""
    cache = {}
    out = []
    for i, cfg in enumerate(grid):
        key = (cfg["anchor"], cfg["k"], cfg["trigger"], cfg.get("minbar", 30))
        if key not in cache:
            cache[key] = candidates(P, *key)
        tr = simulate(P, cfg, mkt, cand=cache[key])
        s = stats(tr, ncyc)
        s.update({k: (v if not isinstance(v, tuple) else "%s%.2f" % v) for k, v in cfg.items()})
        s["cfgid"] = i
        out.append(s)
        if verbose and (i + 1) % 200 == 0:
            print(f"    ... {i+1}/{len(grid)}", flush=True)
    d = pd.DataFrame(out)
    d["_cfg"] = grid
    return d


def show(d, n=15, by="d3", tpd=1.0):
    dd = d[(d.tpd >= tpd) & (d.n > 30)].sort_values(by, ascending=False)
    cols = ["anchor", "k", "trigger", "side", "stop", "targ", "win", "filt",
            "n", "tpd", "avgR", "dpt", "wr", "d3", "t", "pf", "ddm"]
    cols = [c for c in cols if c in dd.columns]
    print(dd[cols].head(n).to_string(index=False))
    return dd

