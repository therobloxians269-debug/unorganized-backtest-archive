"""INTRINSIC TIME / DIRECTIONAL CHANGE — Glattfelder, Dupuis & Olsen (2011).
Re-clock the market by price events, not by minutes. A DC of threshold d confirms when
price retraces d from the last extreme; the OVERSHOOT is the run from that confirmation
to the next extreme. Olsen's scaling law claims E[overshoot] ~= d. Test it on NQ."""
import numpy as np, pandas as pd, warnings; warnings.filterwarnings('ignore')

def dc_events(px, d):
    """Returns events: (i_conf, dir, i_ext, ext_px, conf_px, overshoot_frac).
       dir = +1 means an UP directional change (price rose d off a low)."""
    n=len(px); ev=[]
    mode=0; ext=px[0]; i_ext=0; i_last_conf=0
    for i in range(1,n):
        p=px[i]
        if mode<=0:                                   # looking for an UP DC
            if p<=ext: ext=p; i_ext=i
            elif p>=ext*(1+d):
                ev.append((i,1,i_ext,ext,p,(px[i_last_conf]-ext)/ext if i_last_conf else np.nan))
                mode=1; i_last_conf=i; ext=p; i_ext=i
        if mode>=0:                                   # looking for a DOWN DC
            if p>=ext: ext=p; i_ext=i
            elif p<=ext*(1-d):
                ev.append((i,-1,i_ext,ext,p,(ext-px[i_last_conf])/ext if i_last_conf else np.nan))
                mode=-1; i_last_conf=i; ext=p; i_ext=i
    return ev

def analyse(px, ts, d):
    ev=dc_events(px,d)
    if len(ev)<10: return None
    rows=[]
    for k in range(len(ev)-1):
        i_c,dr,i_e,ex,cp,_=ev[k]
        i_c2,dr2,i_e2,ex2,cp2,_=ev[k+1]
        # overshoot = move from THIS confirmation to the NEXT extreme, same direction
        os_=(ex2-cp)/cp if dr==1 else (cp-ex2)/cp
        rows.append(dict(t=ts[i_c],dir=dr,conf=cp,os=os_,bars_dc=i_c-i_e,bars_os=i_e2-i_c))
    R=pd.DataFrame(rows)
    R['os_over_d']=R.os/d
    return R

for f,tag in [('nq_v6.parquet','NQ 2023-25'),('mnq_v6.parquet','MNQ 2026')]:
    df=pd.read_parquet(f)
    m=(df.index.hour*60+df.index.minute); r=df[(m>=570)&(m<960)]
    px=r.c.values; ts=r.index
    D=pd.DatetimeIndex(ts).normalize().nunique()
    print(f'=== {tag}  ({len(r):,} RTH 1m bars, {D} sessions) ===')
    print(f'  {"delta":>7s} {"events":>7s} {"ev/day":>7s} {"E[os]/d":>8s} {"median":>7s} '
          f'{"P(os>=d)":>9s} {"bars to DC":>10s} {"bars os":>8s}')
    for d in [0.0005,0.001,0.002,0.003,0.005,0.008]:
        R=analyse(px,ts,d)
        if R is None: continue
        print(f'  {d*100:6.2f}% {len(R):7d} {len(R)/D:7.2f} {R.os_over_d.mean():8.3f} '
              f'{R.os_over_d.median():7.3f} {(R.os>=d).mean()*100:8.1f}% {R.bars_dc.median():10.0f} {R.bars_os.median():8.0f}')
    print()

