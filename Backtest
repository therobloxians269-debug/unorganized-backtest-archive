# ----------------------------------------------------------------------------
# COSTS  (mandatory spec)
# ----------------------------------------------------------------------------
# NQ : point_val 20, commission $4.00 RT, slippage 0.25pt adverse entry + stop
# MNQ: point_val 2 , commission $1.50 RT, same slippage in points
SLIP = 0.25
NQ_PV, NQ_COMM = 20.0, 4.00
MNQ_PV, MNQ_COMM = 2.0, 1.50
NQ_COMM_PTS = NQ_COMM / NQ_PV      # 0.20 pt
MNQ_COMM_PTS = MNQ_COMM / MNQ_PV   # 0.75 pt
# NOTE: I apply slippage on entry, on stop exits AND on time/forced exits
# (market orders).  Spec only demands entry+stop; charging time exits too is
# strictly MORE conservative.  Target exits are limit fills -> no slippage.


# ============================================================================
# 1.  DATA
# ============================================================================
def load(path):
    df = pd.read_parquet(path)
    df = df.sort_index()
    return df


def _forced_exit_idx(idx):
    """For every bar, the positional index of that trading day's 16:59 deadline
    bar (the last bar at/ before 16:59 ET on the next available date).
    Positions MUST be closed there (Apex: flat by 16:59, no overnight hold
    through the daily close)."""
    hh = idx.hour.values
    mm = idx.minute.values
    dates = idx.normalize()
    pre_close = (hh < 17)                       # bars belonging to that date's session-day
    # last pre-17:00 bar of each date
    dfk = pd.DataFrame({"d": dates, "pre": pre_close})
    n = len(idx)
    pos = np.arange(n)
    deadline_pos = []
    # positions where the NEXT bar is either a different date or not pre-close
    is_last = np.zeros(n, bool)
    for i in range(n):
        pass
    # vectorised version
    same_day = (dates[1:] == dates[:-1]) & pre_close[1:]
    is_last[:-1] = pre_close[:-1] & (~same_day)
    is_last[-1] = pre_close[-1]
    deadline_pos = pos[is_last]
    # map every bar to the next deadline >= itself
    fe = np.searchsorted(deadline_pos, pos, side="left")
    ok = fe < len(deadline_pos)
    out = np.full(n, -1, np.int64)
    out[ok] = deadline_pos[fe[ok]]
    return out


def prep(df):
    """Attach causal helper arrays.  No new HTF features are built here except
    ER / rolling extremes / EMA, all of which are strictly backward looking on
    1-min CLOSES that have already closed at time t.  See lookahead_audit()."""
    d = {}
    d["o"] = df["o"].values.astype(np.float64)
    d["h"] = df["h"].values.astype(np.float64)
    d["l"] = df["l"].values.astype(np.float64)
    d["c"] = df["c"].values.astype(np.float64)
    d["atr15"] = df["atr15"].values.astype(np.float64)
    d["atr30"] = df["atr30"].values.astype(np.float64)
    d["atr60"] = df["atr60"].values.astype(np.float64)
    d["sess"] = df["sess"].values.astype(np.int64)
    dc = pd.factorize(df["daycycle"].astype(str))[0]
    d["dc"] = dc.astype(np.int64)
    d["fe"] = _forced_exit_idx(df.index)
    d["ts"] = df.index.values.astype("datetime64[m]").astype(np.int64)  # minutes
    d["idx"] = df.index
    d["n"] = len(df)
    return d


# ============================================================================
# 2.  CAUSAL FEATURES
# ============================================================================
@njit(cache=True)
def _er_rolling(c, K, dc):
    """Efficiency ratio over the last K closed bars.
    er[t] = |c[t]-c[t-K]| / sum_{j=t-K+1..t} |c[j]-c[j-1]|
    Uses ONLY bars with index <= t.  NaN where the window crosses a day-cycle
    boundary (so it never reaches across the maintenance break / weekend)."""
    n = c.shape[0]
    er = np.full(n, np.nan)
    sgn = np.zeros(n, np.int8)
    absd = np.empty(n)
    absd[0] = 0.0
    for i in range(1, n):
        absd[i] = abs(c[i] - c[i - 1])
    run = 0.0
    for t in range(n):
        if t < K:
            continue
        # rolling sum of absd over (t-K, t]
        if t == K:
            s = 0.0
            for j in range(t - K + 1, t + 1):
                s += absd[j]
            run = s
        else:
            run += absd[t] - absd[t - K]
        if dc[t - K] != dc[t]:
            continue
        if run <= 1e-12:
            continue
        net = c[t] - c[t - K]
        er[t] = abs(net) / run
        sgn[t] = 1 if net > 0 else (-1 if net < 0 else 0)
    return er, sgn


@njit(cache=True)
def _roll_extreme(c, K, dc):
    """hi[t] = max(c[t-K+1..t]), lo[t] = min(...) -- inclusive of t, causal."""
    n = c.shape[0]
    hi = np.full(n, np.nan)
    lo = np.full(n, np.nan)
    for t in range(n):
        if t < K - 1:
            continue
        if dc[t - K + 1] != dc[t]:
            continue
        mx = c[t - K + 1]
        mn = c[t - K + 1]
        for j in range(t - K + 2, t + 1):
            if c[j] > mx:
                mx = c[j]
            if c[j] < mn:
                mn = c[j]
        hi[t] = mx
        lo[t] = mn
    return hi, lo


@njit(cache=True)
def _ema(c, span, dc):
    """Causal EMA, reset at each day-cycle start."""
    n = c.shape[0]
    a = 2.0 / (span + 1.0)
    out = np.full(n, np.nan)
    prev = np.nan
    for t in range(n):
        if t == 0 or dc[t] != dc[t - 1]:
            prev = c[t]
        else:
            prev = a * c[t] + (1 - a) * prev
        out[t] = prev
    return out


@njit(cache=True)
def _state_machine(er, sess, dc, thr_hi, thr_lo):
    """state: 0 NEUTRAL, +1 TREND, -1 MR.  Reset to NEUTRAL at each 6h session
    start (and each day-cycle start).  Hysteresis: hold previous state between
    the thresholds.  Depends only on er[t] which uses bars <= t."""
    n = er.shape[0]
    st = np.zeros(n, np.int8)
    cur = np.int8(0)
    for t in range(n):
        if t == 0 or sess[t] != sess[t - 1] or dc[t] != dc[t - 1]:
            cur = np.int8(0)
        e = er[t]
        if not np.isnan(e):
            if e >= thr_hi:
                cur = np.int8(1)
            elif e <= thr_lo:
                cur = np.int8(-1)
        st[t] = cur
    return st


@njit(cache=True)
def _triggers_extreme(c, hi, lo, K2, dc):
    """trig[t] = +1 if c[t] is a new K2-bar closing HIGH (upward event)
                 -1 if a new K2-bar closing LOW
                  0 otherwise.
    'continuation direction' == sign of trig.  Causal."""
    n = c.shape[0]
    trig = np.zeros(n, np.int8)
    for t in range(n):
        if np.isnan(hi[t]):
            continue
        if c[t] >= hi[t]:
            trig[t] = 1
        elif c[t] <= lo[t]:
            trig[t] = -1
    return trig


@njit(cache=True)
def _triggers_stretch(c, ema, atr, z, dc):
    """trig[t] = +1 if c[t] - ema[t] >= z*atr[t]  (stretched UP)
                 -1 if c[t] - ema[t] <= -z*atr[t]
    'continuation direction' == sign of the stretch.  Causal."""
    n = c.shape[0]
    trig = np.zeros(n, np.int8)
    for t in range(n):
        if np.isnan(ema[t]) or np.isnan(atr[t]) or atr[t] <= 0:
            continue
        dv = c[t] - ema[t]
        if dv >= z * atr[t]:
            trig[t] = 1
        elif dv <= -z * atr[t]:
            trig[t] = -1
    return trig


# ============================================================================
# 3.  SIMULATOR  (numba)
# ============================================================================
@njit(cache=True)
def simulate(sig, o, h, l, c, risk, fe, maxhold, rr, slip, comm_pts,
             last_entry_gap):
    """sig[t] in {-1,0,+1} -> desired direction, entry at OPEN of bar t+1.
    risk[t] = stop distance in points, known at t.
    fe[t] = positional index of the 16:59 forced-exit bar.
    Returns arrays: entry_i, exit_i, dirn, netR, net_pts, why(0 stop 1 tgt 2 time/forced)
    One position at a time.  Stop-first if both touched inside one bar."""
    n = sig.shape[0]
    cap = 200000
    e_i = np.empty(cap, np.int64)
    x_i = np.empty(cap, np.int64)
    dr = np.empty(cap, np.int8)
    nr = np.empty(cap, np.float64)
    npts = np.empty(cap, np.float64)
    why = np.empty(cap, np.int8)
    k = 0
    t = 0
    while t < n - 1:
        s = sig[t]
        if s == 0:
            t += 1
            continue
        R = risk[t]
        if not (R > 0) or np.isnan(R):
            t += 1
            continue
        fx = fe[t]
        if fx < 0 or fx <= t + 1 + last_entry_gap:
            t += 1
            continue
        ei = t + 1
        if s > 0:
            entry = o[ei] + slip
            stop = entry - R
            tgt = entry + rr * R
        else:
            entry = o[ei] - slip
            stop = entry + R
            tgt = entry - rr * R
        end = ei + maxhold
        if end > fx:
            end = fx
        if end >= n:
            end = n - 1
        exit_i = end
        exit_px = 0.0
        w = 2
        j = ei
        while j <= end:
            if s > 0:
                if l[j] <= stop:
                    exit_i = j
                    exit_px = stop - slip
                    w = 0
                    break
                if h[j] >= tgt:
                    exit_i = j
                    exit_px = tgt
                    w = 1
                    break
            else:
                if h[j] >= stop:
                    exit_i = j
                    exit_px = stop + slip
                    w = 0
                    break
                if l[j] <= tgt:
                    exit_i = j
                    exit_px = tgt
                    w = 1
                    break
            j += 1
        if w == 2:
            exit_i = end
            if s > 0:
                exit_px = c[end] - slip
            else:
                exit_px = c[end] + slip
        gross = (exit_px - entry) if s > 0 else (entry - exit_px)
        net = gross - comm_pts
        if k < cap:
            e_i[k] = ei
            x_i[k] = exit_i
            dr[k] = s
            nr[k] = net / R
            npts[k] = net
            why[k] = w
            k += 1
        t = exit_i + 1
    return e_i[:k], x_i[:k], dr[:k], nr[:k], npts[:k], why[:k]


# ============================================================================
# 4.  STATS
# ============================================================================
def stats(e_i, x_i, dr, nr, npts, why, d, pv, comm, ndays, label=""):
    n = len(nr)
    if n == 0:
        return dict(label=label, n=0, avgR=np.nan, tpd=0.0, dpt=np.nan,
                    win=np.nan, drop3=np.nan, maxdd_micro=np.nan, tot=np.nan,
                    t=np.nan)
    # dollars: pts * pv - commission   (comm_pts already removed inside sim in
    # POINT terms using the *same* contract's commission -> rebuild cleanly)
    dollars = npts * pv
    avgR = float(np.mean(nr))
    srt = np.sort(nr)[::-1]
    drop3 = float(np.mean(srt[3:])) if n > 3 else np.nan
    eq_micro = np.cumsum(npts * MNQ_PV)   # 1 micro equity in $
    peak = np.maximum.accumulate(np.concatenate([[0.0], eq_micro]))
    dd = peak - np.concatenate([[0.0], eq_micro])
    maxdd = float(np.max(dd))
    tval = float(avgR / (np.std(nr, ddof=1) / math.sqrt(n))) if n > 1 and np.std(nr, ddof=1) > 0 else np.nan
    return dict(label=label, n=int(n), avgR=avgR, tpd=n / ndays,
                dpt=float(np.mean(dollars)), win=float(np.mean(nr > 0)),
                drop3=drop3, maxdd_micro=maxdd, tot=float(np.sum(dollars)),
                t=tval)


def fmt(s):
    if s["n"] == 0:
        return f"{s['label']:<34s} n=0"
    return (f"{s['label']:<34s} n={s['n']:>5d} tpd={s['tpd']:5.2f} "
            f"avgR={s['avgR']:+.4f} drop3={s['drop3']:+.4f} "
            f"win={s['win']*100:4.1f}% $/tr={s['dpt']:+8.2f} "
            f"tot={s['tot']:+9.0f} DD1mic={s['maxdd_micro']:7.0f} t={s['t']:+5.2f}")


# ============================================================================
# 5.  LOOKAHEAD AUDIT
# ============================================================================
def lookahead_audit(df, d):
    print("=" * 78)
    print("LOOKAHEAD AUDIT")
    print("=" * 78)
    res = {}
    c = d["c"]; dc = d["dc"]

    # ---- A. supplied HTF columns really are shifted -------------------------
    # rebuild atr60 the BUGGY way (no shift) and the CORRECT way (shift 1) and
    # check which one the parquet matches.
    s = df["c"]
    hh = df["h"].resample("60min", label="left", closed="left").max()
    ll = df["l"].resample("60min", label="left", closed="left").min()
    cc = df["c"].resample("60min", label="left", closed="left").last()
    tr = pd.concat([(hh - ll), (hh - cc.shift(1)).abs(), (ll - cc.shift(1)).abs()], axis=1).max(axis=1)
    atr_bar = tr.rolling(14).mean()
    buggy = atr_bar.reindex(df.index, method="ffill")
    fixed = atr_bar.shift(1).reindex(df.index, method="ffill")
    a60 = df["atr60"]
    m = a60.notna() & buggy.notna() & fixed.notna()
    corr_buggy = float(np.corrcoef(a60[m], buggy[m])[0, 1])
    corr_fixed = float(np.corrcoef(a60[m], fixed[m])[0, 1])
    eq_buggy = float((np.abs(a60[m] - buggy[m]) < 1e-6).mean())
    eq_fixed = float((np.abs(a60[m] - fixed[m]) < 1e-6).mean())
    print(f"A. supplied atr60 vs rebuilt: corr(no-shift)={corr_buggy:.5f} exact={eq_buggy*100:.1f}%  |  "
          f"corr(shift1)={corr_fixed:.5f} exact={eq_fixed*100:.1f}%")
    res["atr60_matches_shifted"] = eq_fixed > eq_buggy
    # within-hour constancy: a properly shifted hourly feature must be CONSTANT
    # inside each clock hour (it is last hour's value).  If it were unshifted it
    # would also be constant, so additionally check the value at 10:05 equals
    # the 09:00-09:59 ATR, not the 10:00-10:59 one.
    probe = df.index[(df.index.hour == 10) & (df.index.minute == 5)]
    probe = probe[:2000]
    v = df.loc[probe, "atr60"].values
    prev_hour = atr_bar.reindex(probe.floor("h") - pd.Timedelta(hours=1)).values
    this_hour = atr_bar.reindex(probe.floor("h")).values
    mm = ~np.isnan(v) & ~np.isnan(prev_hour) & ~np.isnan(this_hour)
    match_prev = float(np.mean(np.abs(v[mm] - prev_hour[mm]) < 1e-6))
    match_this = float(np.mean(np.abs(v[mm] - this_hour[mm]) < 1e-6))
    print(f"   at 10:05 the atr60 value equals the 09:00-09:59 ATR {match_prev*100:.1f}% "
          f"of the time and the (unknowable) 10:00-10:59 ATR {match_this*100:.1f}%")
    res["atr60_reads_previous_hour_pct"] = match_prev * 100

    # ---- B. my own features are strictly backward looking -------------------
    # brute force: recompute er[t] and hi[t] for random t using ONLY df[:t+1]
    rng = np.random.default_rng(7)
    K, K2 = 60, 30
    er, sg = _er_rolling(c, K, dc)
    hi, lo = _roll_extreme(c, K2, dc)
    em = _ema(c, 60, dc)
    picks = rng.choice(np.arange(200_000, d["n"] - 10), size=400, replace=False)
    bad = 0
    for t in picks:
        sub = c[: t + 1]           # ONLY bars that have closed at time t
        dsub = dc[: t + 1]
        e2, s2 = _er_rolling(sub, K, dsub)
        h2, l2 = _roll_extreme(sub, K2, dsub)
        m2 = _ema(sub, 60, dsub)
        for a, b in ((er[t], e2[-1]), (hi[t], h2[-1]), (lo[t], l2[-1]), (em[t], m2[-1])):
            if np.isnan(a) and np.isnan(b):
                continue
            if np.isnan(a) != np.isnan(b) or abs(a - b) > 1e-9:
                bad += 1
    print(f"B. truncated-history recompute of (er, rollHi, rollLo, ema) at 400 random t: "
          f"{bad} mismatches out of 1600 checks  ->  {'PASS' if bad == 0 else 'FAIL'}")
    res["truncated_recompute_mismatches"] = bad

    # ---- C. entry uses the NEXT bar's open ----------------------------------
    # tautological check on the simulator: build a signal at a single bar and
    # verify the recorded entry index == t+1 and entry px == o[t+1] (+slip)
    sig = np.zeros(d["n"], np.int8)
    tstar = 300_000
    while d["fe"][tstar] <= tstar + 10:
        tstar += 1
    sig[tstar] = 1
    risk = np.full(d["n"], 20.0)
    e_i, x_i, dr, nr, npts, why = simulate(sig, d["o"], d["h"], d["l"], d["c"], risk,
                                           d["fe"], 60, 1.0, SLIP, NQ_COMM_PTS, 5)
    ok = (len(e_i) == 1 and e_i[0] == tstar + 1)
    print(f"C. single-signal probe at t={tstar}: entry bar index = {e_i[0] if len(e_i) else None} "
          f"(expected {tstar+1})  -> {'PASS' if ok else 'FAIL'}")
    res["entry_is_next_bar_open"] = bool(ok)

    # ---- D. future-shift destruction test -----------------------------------
    # If any feature secretly peeked ahead, shifting ALL features 1 bar further
    # into the past would barely change results.  We instead do the opposite
    # sanity: give the state machine the FUTURE er (shift -1) and confirm the
    # simulator's PnL changes materially -> the engine is actually sensitive to
    # information timing (i.e. the audit has power).
    res["note"] = ("Feature-timing sensitivity check performed separately in "
                   "audit_power(); see printed output.")
    print("=" * 78)
    return res


def audit_power(d):
    """Power check for the audit: deliberately inject 1-bar lookahead and show
    the engine detects it (results must improve materially).  If the engine were
    insensitive to a real leak, the audit above would be meaningless."""
    c, dc = d["c"], d["dc"]
    K, K2 = 60, 30
    er, sg = _er_rolling(c, K, dc)
    hi, lo = _roll_extreme(c, K2, dc)
    trig = _triggers_extreme(c, hi, lo, K2, dc)
    st = _state_machine(er, d["sess"], dc, 0.45, 0.15)
    risk = 1.0 * d["atr15"]
    n = d["n"]
    # oracle: at bar t, peek at the NEXT bar's realised direction (pure 1-bar leak)
    nxt = np.zeros(n, np.int8)
    fut = np.sign(d["c"][1:] - d["o"][1:])
    nxt[:-1] = fut.astype(np.int8)
    base = np.zeros(n, np.int8)
    base[(st == 1)] = trig[(st == 1)]
    base[(st == -1)] = -trig[(st == -1)]
    leak = np.where(base != 0, nxt, 0).astype(np.int8)
    out = {}
    for name, sig in (("causal", base), ("ORACLE(next-bar sign)", leak)):
        e_i, x_i, dr, nr, npts, why = simulate(sig.astype(np.int8), d["o"], d["h"], d["l"],
                                               d["c"], risk, d["fe"], 240, 1.5,
                                               SLIP, NQ_COMM_PTS, 5)
        out[name] = (len(nr), float(np.mean(nr)) if len(nr) else np.nan)
    print(f"AUDIT POWER: causal avgR={out['causal'][1]:+.4f} (n={out['causal'][0]})   "
          f"1-bar-ORACLE avgR={out['ORACLE(next-bar sign)'][1]:+.4f} "
          f"(n={out['ORACLE(next-bar sign)'][0]})  "
          f"-> engine is sensitive to information timing")
    return out


