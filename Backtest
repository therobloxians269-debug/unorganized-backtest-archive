#!/usr/bin/env python3
"""Adaptive trend indicator: the ONE validated edge (VWAP trend-day continuation)
gated by a CAUSAL multi-day trailing-regime switch. When trend-continuation has
been paying lately (trailing daily trendiness high) -> trade; when the tape has
been chopping -> sit out. Survives regimes by NOT participating in the wrong one."""
import numpy as np, pandas as pd
import omni2_lib as L
from omni2_lib import ORN, FLOOR, fric, DPP

def daily_trendiness(S):
    """per-day directional efficiency = |c_last - c_first| / sum|5m diffs| (in [0,1])."""
    out = []
    for s in S:
        c = s["c"]; den = np.abs(np.diff(c)).sum()
        out.append(abs(c[-1]-c[0])/den if den > 0 else 0.0)
    return np.array(out)

def trend_day(s, stop_atr=1.5):
    """VWAP Trend-Day Rider on one session -> list of (net, risk). No day-gate here."""
    h, l, c, atr, vwap = s["h"], s["l"], s["c"], s["atr"], s["vwap"]
    orh, orl = s["or_hi"], s["or_lo"]
    pos = 0; entry = stop = np.nan; ebar = -1; risk0 = np.nan; broke = 0; n = 0; res = []
    for b in range(ORN, 78):
        if pos == 0 and n < 3:
            above = c[b] > vwap[b]; below = c[b] < vwap[b]; side = 0
            if broke == 0:
                if c[b] > orh and above: side = 1; broke = 1
                elif c[b] < orl and below: side = -1; broke = -1
            else:
                if broke == 1 and above and l[b] <= vwap[b]+0.5*atr[b] and c[b] > c[b-1]: side = 1
                elif broke == -1 and below and h[b] >= vwap[b]-0.5*atr[b] and c[b] < c[b-1]: side = -1
            if side != 0:
                pos = side; entry = c[b]; ebar = b
                stop = c[b]-side*max(stop_atr*atr[b], FLOOR); risk0 = abs(entry-stop); n += 1
            continue
        if pos != 0 and b > ebar:
            if (l[b] <= stop) if pos > 0 else (h[b] >= stop):
                g = pos*(stop-entry); res.append((g-fric("stop"), risk0)); pos = 0; continue
            if b == 77:
                g = pos*(c[b]-entry); res.append((g-fric("eod"), risk0)); pos = 0
    return res

def run(S, trail_reg, thr):
    rows = []
    for i, s in enumerate(S):
        if not (np.isnan(trail_reg[i]) or trail_reg[i] >= thr):    # multi-day regime OFF -> sit out
            continue
        for net, risk in trend_day(s):
            rows.append((s["date"], net, risk))
    return pd.DataFrame(rows, columns=["date", "net", "risk"])

def sharpe_daily(tr, S):
    """annualized Sharpe of the daily P&L$ series over ALL sessions (flat days = 0)."""
    if len(tr) == 0: return 0.0
    dd = tr.groupby("date")["net"].sum()*DPP
    idx = pd.Series(0.0, index=[s["date"] for s in S])
    idx.loc[dd.index] = dd.values
    x = idx.to_numpy()
    return float(np.sqrt(252)*x.mean()/x.std()) if x.std() > 0 else 0.0

def main():
    S = L.load()
    de = daily_trendiness(S)
    trail = pd.Series(de).shift(1).rolling(20).mean().to_numpy()     # causal trailing-20d regime
    print(f"{len(S)} sessions. daily trendiness: p25={np.nanpercentile(de,25):.3f} "
          f"p50={np.nanpercentile(de,50):.3f} p75={np.nanpercentile(de,75):.3f}")
    print(f"trailing-20d regime: p25={np.nanpercentile(trail,25):.3f} p50={np.nanpercentile(trail,50):.3f} "
          f"p75={np.nanpercentile(trail,75):.3f}\n")
    for thr in [0.0, 0.16, 0.19, 0.22, 0.25]:
        tr = run(S, trail, thr)
        days_traded = tr["date"].nunique()
        lbl = "NO gate" if thr == 0.0 else f"trail>={thr}"
        print(f"===== {lbl}  (traded days={days_traded}, trades={len(tr)}, Sharpe={sharpe_daily(tr,S):.2f}) =====")
        L.report(tr, f"  trend, {lbl}")
        print()

if __name__ == "__main__":
    main()

