"""Low-turnover day-trade harness: at most a few trades per session, so the
per-trade edge is measured against a fixed round-trip cost instead of being
buried under per-bar turnover.

A strategy is a function: session_frame -> list of Trade(entry_ts, side,
entry_px, exit_ts, exit_px). The harness books PnL in ES points net of a fixed
round-trip cost, splits OOS (train<=2022 / test>=2023), and runs a
sign-shuffle placebo (randomly flip each day's trade direction) to check the
edge isn't a coin-flip.
"""
from __future__ import annotations

from dataclasses import dataclass

import numpy as np
import pandas as pd

import harness as H

RT_COST_PTS = 2 * (0.25 + 0.62 / 5.0)     # round-trip: 1 tick slip + comm both sides ≈ 0.75 pt
TRAIN_END = H.TRAIN_END


@dataclass
class Trade:
    day: object
    side: int
    entry: float
    exit: float
    reason: str = ""

    @property
    def pts(self) -> float:
        return (self.exit - self.entry) * self.side - RT_COST_PTS


def _sessions(df: pd.DataFrame):
    for day, g in df.groupby("session"):
        yield day, g


def run_strategy(strat_fn, rth_only=True, **kw) -> pd.DataFrame:
    df = H.load()
    if rth_only:
        df = df[df["rth"]]
    trades = []
    for day, g in _sessions(df):
        if len(g) < 60:
            continue
        for t in strat_fn(g, **kw):
            trades.append(t)
    if not trades:
        return pd.DataFrame()
    return pd.DataFrame([{"day": pd.Timestamp(t.day), "side": t.side,
                          "entry": t.entry, "exit": t.exit, "pts": t.pts,
                          "reason": t.reason} for t in trades])


def _stats(tr: pd.DataFrame) -> dict:
    if tr.empty:
        return {"n": 0, "sharpe": 0.0, "pts": 0.0, "win": 0.0, "avg": 0.0}
    daily = tr.groupby(tr["day"].dt.normalize())["pts"].sum()
    sr = daily.mean() / daily.std() * np.sqrt(252) if daily.std() > 0 else 0.0
    return {"n": len(tr), "sharpe": sr, "pts": tr["pts"].sum(),
            "win": (tr["pts"] > 0).mean(), "avg": tr["pts"].mean()}


def _placebo(tr: pd.DataFrame, n=200) -> float:
    """Flip each trade's direction by a deterministic pseudo-random sign;
    distribution of resulting test Sharpes. Returns 95th percentile."""
    if tr.empty:
        return 0.0
    base = tr.copy()
    gross = (base["exit"] - base["entry"])       # signless move
    srs = []
    m = len(base)
    for i in range(n):
        signs = np.where(((np.arange(m) * (i * 7 + 3) + i) % 2) == 0, 1, -1)
        pts = gross.values * signs - RT_COST_PTS
        d = pd.Series(pts, index=base["day"].dt.normalize().values)
        daily = d.groupby(level=0).sum()
        srs.append(daily.mean() / daily.std() * np.sqrt(252) if daily.std() > 0 else 0.0)
    return float(np.percentile(srs, 95))


def screen_day(name: str, strat_fn, grid: list, **kw) -> dict:
    """Grid-search param on TRAIN by Sharpe, report on TEST + placebo."""
    best = None
    for params in grid:
        tr = run_strategy(strat_fn, **params, **kw)
        if tr.empty:
            continue
        trn = tr[tr["day"] < TRAIN_END]
        st = _stats(trn)
        if st["n"] < 60:
            continue
        if best is None or st["sharpe"] > best["tr_sr"]:
            best = {"params": params, "tr_sr": st["sharpe"], "all": tr}
    if best is None:
        return {"name": name, "status": "no-activity", "tr_sharpe": 0, "te_sharpe": 0}
    te = best["all"][best["all"]["day"] >= TRAIN_END]
    st = _stats(te)
    p95 = _placebo(te)
    survive = st["sharpe"] > 0.5 and st["sharpe"] > p95 and np.sign(st["sharpe"]) == np.sign(best["tr_sr"])
    return {"name": name, "params": best["params"],
            "tr_sharpe": round(best["tr_sr"], 2), "te_sharpe": round(st["sharpe"], 2),
            "placebo_p95": round(p95, 2), "te_n": st["n"],
            "te_win": round(st["win"], 3), "te_avg_pts": round(st["avg"], 3),
            "te_pts": round(st["pts"], 1),
            "status": "SURVIVE" if survive else "kill"}


def leaderboard(results: list[dict]) -> str:
    rows = sorted(results, key=lambda r: r.get("te_sharpe", -9), reverse=True)
    out = [f"{'strategy':26s} {'trSR':>5s} {'teSR':>5s} {'plc95':>5s} "
           f"{'n':>4s} {'win':>5s} {'avgpt':>6s} {'status':>8s}"]
    for r in rows:
        out.append(f"{r['name']:26s} {r.get('tr_sharpe',0):5.2f} {r.get('te_sharpe',0):5.2f} "
                   f"{r.get('placebo_p95',0):5.2f} {r.get('te_n',0):4d} "
                   f"{r.get('te_win',0):5.2f} {r.get('te_avg_pts',0):6.2f} {r.get('status','?'):>8s}")
    return "\n".join(out)

