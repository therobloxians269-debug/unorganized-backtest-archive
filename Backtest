#!/usr/bin/env python3
"""GEXLAB M3 — do dealer gamma levels actually reject price?

This is the question the project exists to answer, and it is the one M2 cannot
reach: M2 tests netGEX against next-day realised vol, which is a PROXY, needs a
long history we cannot buy, and yields one observation per session. This test
needs no history at all -- it starts from today's levels -- and accumulates
statistical power per TOUCH rather than per day.

THE BENCHMARK IS ALREADY MEASURED, so this is not a fishing trip.
Every PRICE-derived level family in this program (PDH/PDL, quarter highs/lows,
15m/1H/4H pivots) rejected at 48.5-48.7% across 62,000 touches against a 50.4%
displaced-level placebo -- a coin flip tilted slightly toward CONTINUATION. A
gamma strike is different in kind: it is inventory, not a drawing. The question
is whether that difference shows up. It has to beat 48.7%, measured identically.

THE DIFFERENTIAL PREDICTION IS THE REAL TEST, and it is much stronger than any
absolute rejection rate. The hedging identity says positive-gamma strikes DAMP
(desk sells rallies, buys dips -> rejection) while negative-gamma strikes
AMPLIFY (desk sells weakness, buys strength -> continuation). So:

    PINS levels must reject MORE than ACCELERATES levels.

If both reject at the same rate, the gamma SIGN carries no information and the
whole map is decoration -- regardless of how either compares to 50%. That single
comparison is self-controlling: same instrument, same sessions, same method, and
the only difference is the sign we assigned from open interest.

    python3 touch.py record     # append today's NQ 1m bars (run daily)
    python3 touch.py measure    # the rejection table + placebo + sign split
"""
from __future__ import annotations

import sys
from pathlib import Path

import numpy as np
import pandas as pd

ROOT = Path(__file__).resolve().parent
PX = ROOT / "data" / "px" / "nq_1m.parquet"
ROWS = ROOT / "data" / "pine_rows.txt"

# Barrier sizes in NQ points. A rejection has to be worth something: 10 points is
# one strike interval and is noise, 100 points is most of a session's range.
BARRIERS = (20.0, 30.0, 50.0)
MAXBARS = 240          # 4 hours to resolve a touch, else it is unresolved
N_PLACEBO = 200


# ────────────────────────────── price accumulation ──────────────────────────────
def record() -> None:
    """Append the newest NQ 1m bars, deduped. yfinance serves a rolling 7-day
    window for 1m data, so daily runs stitch an unbroken history forward while a
    single run can only ever see the last few days."""
    import yfinance as yf
    new = yf.Ticker("NQ=F").history(period="5d", interval="1m")
    if new.empty:
        print("no bars returned"); return
    new = new[["Open", "High", "Low", "Close", "Volume"]]
    new.columns = ["open", "high", "low", "close", "volume"]
    new.index.name = "ts"
    if PX.exists():
        old = pd.read_parquet(PX)
        # keep the OLD copy of any overlapping minute: a bar re-served later can
        # be revised, and silently replacing history makes past results move
        both = pd.concat([old, new[~new.index.isin(old.index)]])
    else:
        both = new
    both = both[~both.index.duplicated(keep="first")].sort_index()
    PX.parent.mkdir(parents=True, exist_ok=True)
    both.to_parquet(PX)
    span = f"{both.index[0]:%Y-%m-%d} .. {both.index[-1]:%Y-%m-%d %H:%M}"
    print(f"NQ 1m: {len(both):,} bars  {span}   (+{len(both) - (len(old) if PX.exists() and 'old' in dir() else 0)} new)")


def load_rows() -> pd.DataFrame:
    """Every session's levels, as (session, strike, gamma)."""
    if not ROWS.exists():
        raise SystemExit("no data/pine_rows.txt — run:  python3 gex.py _NDX --update")
    out = []
    for ln in ROWS.read_text().split():
        f = ln.split(",")
        if len(f) < 28:
            continue
        for j in range(10):
            k, g = f[8 + 2 * j], f[9 + 2 * j]
            if k != "na" and g != "na":
                out.append({"session": f[0], "strike": float(k), "gamma": float(g)})
    return pd.DataFrame(out)


# ──────────────────────────────── the barrier race ────────────────────────────────
def race_from(h: np.ndarray, l: np.ndarray, i: int, K: float, from_below: bool,
              R: float) -> int | None:
    """1 = rejected, 0 = continued, None = unresolved inside MAXBARS.

    STARTS AT i+1. Racing from the touch bar itself is the single worst bug in
    this program's history: the tap bar's own range straddles the level by
    construction, so whichever barrier that bar happens to reach wins, and a
    coin flip reads as 83%. The touch is information; the touch bar's outcome is
    not available at the moment of the touch.
    """
    up, dn = K + R, K - R
    for k in range(i + 1, min(i + 1 + MAXBARS, len(h))):
        hit_up, hit_dn = h[k] >= up, l[k] <= dn
        if hit_up and hit_dn:
            return None                  # same bar reached both: unresolvable
        if hit_up:
            return 0 if from_below else 1
        if hit_dn:
            return 1 if from_below else 0
    return None


def touches(px: pd.DataFrame, lv: pd.DataFrame, R: float, offset: float = 0.0):
    """First touch of each level per session, then the race. `offset` displaces
    every level by a fixed number of points -- that is the placebo."""
    h, l, c = px["high"].to_numpy(), px["low"].to_numpy(), px["close"].to_numpy()
    sess = px.index.normalize().strftime("%Y%m%d").to_numpy()
    rows = []
    for s, grp in lv.groupby("session"):
        m = np.flatnonzero(sess == s)
        if m.size < 30:
            continue
        a, b = m[0], m[-1]
        for _, r in grp.iterrows():
            K = r.strike + offset
            hit = None
            for i in range(a + 1, b + 1):
                if l[i] <= K <= h[i]:
                    hit = i
                    break
            if hit is None:
                continue
            from_below = c[hit - 1] < K
            res = race_from(h, l, hit, K, from_below, R)
            if res is None:
                continue
            rows.append({"session": s, "strike": r.strike, "gamma": r.gamma,
                         "pins": r.gamma > 0, "reject": res, "from_below": from_below})
    return pd.DataFrame(rows)


def wilson(k: int, n: int) -> tuple[float, float]:
    if n == 0:
        return (np.nan, np.nan)
    p, z = k / n, 1.96
    d = 1 + z * z / n
    ctr = (p + z * z / (2 * n)) / d
    hw = z * np.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / d
    return (ctr - hw, ctr + hw)


def measure() -> None:
    if not PX.exists():
        raise SystemExit("no price history yet — run:  python3 touch.py record")
    px = pd.read_parquet(PX)
    lv = load_rows()
    days = sorted(set(lv.session) & set(px.index.normalize().strftime("%Y%m%d")))
    print(f"price {len(px):,} 1m bars   levels for {lv.session.nunique()} session(s)   "
          f"OVERLAP: {len(days)} session(s)")
    if not days:
        print("\nNo session has BOTH levels and price yet. Both accumulate forward:")
        print("  levels  data/pine_rows.txt   (snap.py + gex.py --update, 4x/day)")
        print("  price   data/px/nq_1m.parquet (touch.py record, daily)")
        return
    print(f"benchmark: price-derived levels reject 48.5-48.7% vs a 50.4% placebo "
          f"(62k touches)\n")
    rng = np.random.default_rng(11)
    for R in BARRIERS:
        t = touches(px, lv, R)
        if t.empty:
            print(f"  ±{R:.0f}pt   no resolved touches yet"); continue
        n, k = len(t), int(t.reject.sum())
        lo, hi = wilson(k, n)
        # placebo: the same geometry at a level that is not a gamma strike
        pl = []
        for _ in range(N_PLACEBO):
            off = rng.choice([-1, 1]) * rng.uniform(2.0, 6.0) * R
            p = touches(px, lv, R, offset=off)
            if not p.empty:
                pl.append(p.reject.mean())
        pm = float(np.mean(pl)) if pl else np.nan
        pv = float(np.mean([x >= k / n for x in pl])) if pl else np.nan
        print(f"  ±{R:>3.0f}pt   n{n:>5d}   reject {k/n:>6.1%}  "
              f"[95% {lo:.1%}-{hi:.1%}]   placebo {pm:>6.1%}   p {pv:.3f}")
        # THE differential test: the sign must matter, or the map is decoration
        a, b = t[t.pins], t[~t.pins]
        if len(a) >= 10 and len(b) >= 10:
            print(f"            PINS {a.reject.mean():>6.1%} (n{len(a)})   vs   "
                  f"ACCELERATES {b.reject.mean():>6.1%} (n{len(b)})   "
                  f"gap {a.reject.mean() - b.reject.mean():+.1%}")
        else:
            print(f"            sign split needs n>=10 each (PINS {len(a)}, ACCEL {len(b)})")


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "measure"
    if cmd == "record":
        record()
    elif cmd == "measure":
        measure()
    else:
        raise SystemExit(__doc__)

