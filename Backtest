    d=df[(t>=570)&(t<960)][['open','high','low','close']].copy()
    d['tod']=t[(t>=570)&(t<960)]; d['day']=d.index.normalize()
    return d,pv
def run(d,pv,mode,stopF,rr,comm=1.50,maxwait=180):
    out=[]
    for day,b in d.groupby('day'):
        if len(b)<300: continue
        H=b.high.values; L=b.low.values; C=b.close.values; T=b.tod.values; n=len(b)
        ib=T<630
        if ib.sum()<48: continue
        ibh=H[ib].max(); ibl=L[ib].min(); ibr=ibh-ibl
        if ibr<=0: continue
        p=np.flatnonzero(~ib)
        if len(p)<30: continue
        k0=p[0]
        for side,dr,edge in [('lo',1,ibl),('hi',-1,ibh)]:
            if mode=='at_edge':   lim=edge
