"""The user's CE-50% limit entry, applied to the confluence-rejection engine (which has volume).
Compares against the current market-on-next-open entry. Causal: limit lives after the wick bar closes."""
import numpy as np, pandas as pd, warnings; warnings.filterwarnings('ignore')
from crs import build_levels, rejections
TICK=0.25; FLAT=959
def run(df,R,ce=0.5,rr=4.0,buf=2.0,pv=2.0,comm=1.50,maxwait=60,maxhold=240,
        min_stop=1.5,max_stop=60.,cooldown=5,market=False):
    o,h,l,c=df.o.values,df.h.values,df.l.values,df.c.values
    m=(df.index.hour*60+df.index.minute).values; n=len(df); out=[]; last=-10**9
    for _,b in R.iterrows():
        i=int(b.i); d=int(b.dir)
        if i<=last+cooldown or i+2>=n or FLAT<=m[i]<1080: continue
        ext = l[i] if d==1 else h[i]
        body= min(o[i],c[i]) if d==1 else max(o[i],c[i])
        lim = o[i+1]+(TICK if d==1 else -TICK) if market else ext+ce*(body-ext)
        stp = (b.bot-buf) if d==1 else (b.top+buf)
        if (d==1 and stp>=lim) or (d==-1 and stp<=lim): continue
        risk=abs(lim-stp)
        if risk>max_stop or risk<min_stop: continue
        fill=i+1 if market else -1
        if not market:
            for k in range(i+1,min(i+1+maxwait,n)):
                if m[k]>=FLAT: break
                if (l[k]<=lim) if d==1 else (h[k]>=lim): fill=k; break
            if fill<0:
                out.append(dict(t=df.index[i],d=d,filled=0,R=np.nan,pnl=0.0,why='nofill',n=b.n)); continue
        tgt=lim+d*rr*risk
        for k in range(fill+1,min(fill+maxhold,n)):
            last_=m[k]>=FLAT or k==n-1
            hs=(l[k]<=stp) if d==1 else (h[k]>=stp)
            ht=(h[k]>=tgt) if d==1 else (l[k]<=tgt)
            if hs: px=stp-d*TICK; why='stop'
            elif ht: px=tgt; why='tgt'
            elif last_: px=c[k]; why='time'
            else: continue
            pnl=d*(px-lim)*pv-comm
            out.append(dict(t=df.index[i],d=d,filled=1,R=pnl/(risk*pv),pnl=pnl,why=why,n=b.n,risk=risk))
            last=k; break
    return pd.DataFrame(out)

for f,tag in [('nq_v6.parquet','NQ 2023-25'),('mnq_v6.parquet','MNQ 2026')]:
    df=pd.read_parquet(f); LV=build_levels(df); R=rejections(df,LV,minConf=1)
