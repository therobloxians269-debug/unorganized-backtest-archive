"""
GAUNTLET: batch-test many strategies in ONE run, ranked by Calmar (return/drawdown) -- the
low-DD/high-profit objective. Add a strategy = one function; the harness scores them all with
Sharpe / CAGR / maxDD / Calmar / OOS / DSR(deflated for #strategies tested). No stopping between.

    python3 gauntlet.py
"""
from __future__ import annotations
import numpy as np
import pandas as pd
import yfinance as yf
from lib_perf import perf_stats, psr, deflated_sharpe, maxdd

COINS = ["BTC-USD","ETH-USD","BNB-USD","XRP-USD","ADA-USD","SOL-USD","DOGE-USD","DOT-USD",
         "AVAX-USD","LINK-USD","LTC-USD","BCH-USD","ATOM-USD","XLM-USD","ETC-USD","TRX-USD",
         "UNI-USD","FIL-USD","ALGO-USD","VET-USD","HBAR-USD","NEAR-USD","AAVE-USD","MKR-USD"]
ANN, VT, COST = 365, 0.35, 25.0
OOS = "2023-01-01"


def load():
    px = yf.download(COINS, start="2017-01-01", auto_adjust=True, progress=False)["Close"]
    px = px.dropna(how="all").dropna(axis=1, thresh=int(len(px) * 0.20))
    return px, px.pct_change()


def finalize(w, rets, av):
    """vol-target weights -> net return series (long/flat crypto)."""
    w = w.div(w.abs().sum(axis=1).replace(0, np.nan), axis=0).shift(1).fillna(0.0)
    g = (w * rets).sum(axis=1)
    sc = (VT / (g.rolling(60).std() * np.sqrt(ANN))).shift(1).clip(0, 3).fillna(0.0)
    w = w.mul(sc, axis=0)
    turn = w.diff().abs().sum(axis=1)
    return (((w * rets).sum(axis=1) - turn * COST * 1e-4)).dropna()


def strategies(px, rets, av):
    out = {}
    def tsig(looks):
        z = sum(px.pct_change(L) / (av * np.sqrt(L / ANN)) for L in looks) / len(looks)
        return finalize(np.tanh(z).clip(lower=0).div(av), rets, av)
    def xs(look, frac, skip=0):
        base = px.pct_change(look - skip).shift(skip + 1) if skip else px.pct_change(look).shift(1)
        rank = base.rank(axis=1, ascending=False)
        k = max(2, int(px.shape[1] * frac))
        return finalize((rank <= k).astype(float).div(av), rets, av)
    out["TS fast 30/60/120"] = tsig((30, 60, 120))
    out["TS slow 60/120/240"] = tsig((60, 120, 240))
    out["XS-mom 30d top33%"] = xs(30, 0.33)
    out["XS-mom 60d top33%"] = xs(60, 0.33)
    out["XS-mom 90d top33%"] = xs(90, 0.33)
    out["XS-mom 120d top33%"] = xs(120, 0.33)
    out["XS-mom 90d top20%"] = xs(90, 0.20)
    out["XS-mom 90d top3"] = xs(90, 0.0001)
    out["XS-mom 120-30 skip"] = xs(120, 0.33, skip=30)
    # blends
    a = xs(90, 0.33); b = tsig((60, 120, 240))
    j = pd.concat([a.rename("a"), b.rename("b")], axis=1).dropna()
    out["XS90 + TSslow 50/50"] = ((j["a"]/j["a"].std() + j["b"]/j["b"].std()) / 2)
    return out


def main():
    px, rets = load()
    av = (rets.rolling(60).std() * np.sqrt(ANN)).shift(1)
    strat = strategies(px, rets, av)
    n = len(strat)
    print(f"GAUNTLET: {n} strategies, {px.shape[1]} coins, ranked by Calmar (return/DD)\n")
    rows = []
    for name, r in strat.items():
        s = perf_stats(r, ANN)
        oos = perf_stats(r[r.index >= OOS], ANN)["sharpe"]
        dsr = deflated_sharpe(r, n, np.var([s["sharpe"]]) + 0.25, ANN)   # deflate for n trials
