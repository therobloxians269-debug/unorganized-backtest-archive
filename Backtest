            ptr=np.maximum(mm.predict(TR[F].values),0.03)
            k=np.quantile(ytr.values/ptr, q)               # TRAIN-only recalibration scalar
            pte=np.maximum(mm.predict(TE[F].values),0.03)*k
            cov_b.append((yte.values<pte).mean()); wb.append((pte*TE.fc).mean())
            res[(side,q)]=(mm.intercept_,mm.coef_.copy(),k)
        print(f'  {side}: coverage after recal  ' + ' '.join(f'{c:.3f}' for c in cov_b) +
              f'   |cal err| {np.mean(np.abs(np.array(cov_b)-np.array(QS))):.4f}'
              f'   q20-q80 width {wb[3]-wb[0]:7.2f} pts')
    out[tag]=(res,hb)
    # baseline for comparison
    for side,ycol in [('lo',lambda d:(d.o930-d.lo)/d.ADR)]:
