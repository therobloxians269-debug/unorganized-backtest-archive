def stage_prefix():
    """PREFIX-INVARIANCE: the strongest lookahead test.  Run the whole pipeline on a
    truncated copy of the data and check the trades are IDENTICAL on the overlap."""
    print("\nPREFIX-INVARIANCE AUDIT")
    df = load("NQ")
    cut = int(len(df) * 0.62)
    # cut on a day-cycle boundary
    cycs = df["daycycle"].values
    while cut < len(df) and cycs[cut] == cycs[cut - 1]:
        cut += 1
    full = Book("NQ")
    trunc = Book.__new__(Book)
    d2 = df.iloc[:cut]
    trunc.which = "NQ"; trunc.tag = "trunc"; trunc.df = d2; trunc.n = len(d2)
    trunc.vol = build_vol(d2).values
    trunc.levels, trunc.meta = build_levels(d2)
    trunc.op = d2["o"].values.astype(np.float64); trunc.hi = d2["h"].values.astype(np.float64)
    trunc.lo = d2["l"].values.astype(np.float64); trunc.cl = d2["c"].values.astype(np.float64)
    trunc.tod = trunc.meta["tod"]; trunc.cyc_id = trunc.meta["cyc_id"].astype(np.int64)
    trunc.dl = trunc.meta["cyc_end"][trunc.cyc_id]; trunc.ncyc = trunc.meta["ncyc"]
    trunc.cost = COST["NQ"]; trunc._cache = {}
    worst = 0
    for c in [cfg(levels=["PD"], mode="rev"), cfg(levels=["ON"], mode="con"),
              cfg(levels=["PW", "IB", "PS"], mode="rev", nmax=40, dmin=0.1)]:
        a = full.trades_for_config(c); b = trunc.trades_for_config(c)
        # compare only trades that both fully resolved well inside the truncation
        lim = cut - 2000
        a = a[a["xi"].values < lim]; b = b[b["xi"].values < lim]
        same = (len(a) == len(b))
        if same and len(a):
            same = (np.array_equal(a["ei"].values, b["ei"].values) and
                    np.allclose(a["net"].values, b["net"].values))
        print(f"   {c['levels']}/{c['mode']}: full n={len(a)} trunc n={len(b)} "
              f"IDENTICAL={same}")
        if not same:
            worst += 1
    print("   =>", "PASS" if worst == 0 else "FAIL")
    return worst == 0



