def run(df, blocks, conf='any', conf_tol=15.0, min_rr=2.0, buf=1.0,
        valid_bars=240, max_hold=600, flat_min=1019, max_stop=40., min_stop=1.5,
        target='nearest', pv=20., comm=4., slip=0.25, one_per_block=True):
    o,h,l,c=df['o'].values,df['h'].values,df['l'].values,df['c'].values
    vw,vsd=df['vwap'].values,df['vsd'].values
