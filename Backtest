class SessionManager:
    """
    Core session-processing pipeline for a single instrument.

    Processing order inside process()
    ──────────────────────────────────
    1. _validate_and_normalize
    2. _attach_et_columns
    3. _classify_sessions        (vectorised np.select)
    4. _build_rth_session_ids    (pd.factorize)
    5. _attach_prior_rth_ohlc    (shift(1) + map)
    6.  event flags
    7. _compute_signal_eligible
    8. _attach_quality_flags
    9. _attach_metadata
    """

    def __init__(self, symbol: str):
        if symbol not in INSTRUMENT_SPECS:
            raise ValueError(f"Unknown symbol '{symbol}'. Valid: {sorted(INSTRUMENT_SPECS)}")
        self.symbol = symbol
        self.spec   = INSTRUMENT_SPECS[symbol]
        logger.info(f"SessionManager initialised – {symbol}")

    def process(
        self,
        df:       pd.DataFrame,
        calendar: Optional[EconomicCalendar] = None,
    ) -> pd.DataFrame:
        """
        Annotate a raw OHLCV DataFrame with session metadata.
        Original DataFrame is never mutated.
        """
        df = self._validate_and_normalize(df.copy())
        df = self._attach_et_columns(df)
        df["session_type"]   = self._classify_sessions(df)
        df["rth_session_id"] = self._build_rth_session_ids(df)
        df = self._attach_prior_rth_ohlc(df)

        if calendar is not None:
            flags = calendar.compute_event_flags(df)
        else:
            logger.warning(f"[{self.symbol}] No EconomicCalendar – event_flag=False.")
            flags = pd.DataFrame(
                {"event_flag": False, "event_type_str": "", "event_impact": ""},
                index=df.index,
            )
        df["event_flag"]     = flags["event_flag"]
        df["event_type_str"] = flags["event_type_str"]
        df["event_impact"]   = flags["event_impact"]

        df["signal_eligible"] = self._compute_signal_eligible(df)
        df = self._attach_quality_flags(df)
        df = self._attach_metadata(df)
        self._log_summary(df)
        return df

    # ── Pipeline steps ─────────────────────────────────────────────────────

    def _validate_and_normalize(self, df: pd.DataFrame) -> pd.DataFrame:
        df.columns = df.columns.str.lower().str.strip()
        required   = {"open", "high", "low", "close", "volume"}
        missing    = required - set(df.columns)
        if missing:
            raise ValueError(f"[{self.symbol}] Missing columns: {missing}")
        if not isinstance(df.index, pd.DatetimeIndex):
            raise TypeError(f"[{self.symbol}] Index must be DatetimeIndex.")
        if df.empty:
            raise ValueError(f"[{self.symbol}] Empty DataFrame.")
        if not df.index.is_monotonic_increasing:
            logger.warning(f"[{self.symbol}] Unsorted index – sorting.")
            df = df.sort_index()
        n_dup = df.index.duplicated().sum()
        if n_dup:
            logger.warning(f"[{self.symbol}] {n_dup} duplicate timestamps – keeping first.")
            df = df[~df.index.duplicated(keep="first")]
        for col in required:
            df[col] = pd.to_numeric(df[col], errors="coerce")
        return df

    def _attach_et_columns(self, df: pd.DataFrame) -> pd.DataFrame:
        if df.index.tzinfo is None:
            logger.warning(f"[{self.symbol}] tz-naive index – assuming UTC.")
            df.index = df.index.tz_localize("UTC")
        else:
            df.index = df.index.tz_convert("UTC")
        et_idx        = df.index.tz_convert("America/New_York")
        df["et_date"] = et_idx.normalize().tz_localize(None)
        df["et_min"]  = et_idx.hour * 60 + et_idx.minute
        return df

    def _classify_sessions(self, df: pd.DataFrame) -> pd.Series:
        """Fully vectorised via np.select on integer minute values."""
        m = df["et_min"]
        conditions = [
            (m >= _RTH_OPEN)  & (m < _RTH_CLOSE),
            (m >= _RTH_CLOSE) & (m < _POST_END),
            (m >= _POST_END)  & (m < _MAINT_END),
            (m >= _PRE_START) & (m < _RTH_OPEN),
        ]
        choices = [
            SessionType.RTH.value,
            SessionType.POST_MARKET.value,
            SessionType.CLOSED.value,
            SessionType.PRE_MARKET.value,
        ]
        return pd.Series(
            np.select(conditions, choices, default=SessionType.OVERNIGHT.value),
            index=df.index,
            dtype="category",
        )

    def _build_rth_session_ids(self, df: pd.DataFrame) -> pd.Series:
        """Monotonic float ID per RTH trading day; NaN for non-RTH bars."""
        rth_mask = df["session_type"] == SessionType.RTH.value
        sid      = pd.Series(np.nan, index=df.index, dtype="float64")
        if rth_mask.any():
            codes, _ = pd.factorize(df.loc[rth_mask, "et_date"], sort=True)
            sid.loc[rth_mask] = codes.astype("float64")
        return sid

    def _attach_prior_rth_ohlc(self, df: pd.DataFrame) -> pd.DataFrame:
        """
        Causal: bars in session N receive session N-1's OHLC.
        Implemented via shift(1) on per-session aggregation, mapped by ID.
        Session 0 and non-RTH bars → NaN.
        """
        cols  = ["prior_rth_open", "prior_rth_high", "prior_rth_low", "prior_rth_close"]
        rth   = df.loc[df["session_type"] == SessionType.RTH.value]
        if rth.empty:
            for c in cols: df[c] = np.nan
            return df
        ohlc = rth.groupby("rth_session_id", sort=True).agg(
            s_open=("open","first"), s_high=("high","max"),
            s_low=("low","min"),   s_close=("close","last"),
        )
        prior = ohlc.shift(1)
        df["prior_rth_open"]  = df["rth_session_id"].map(prior["s_open"])
        df["prior_rth_high"]  = df["rth_session_id"].map(prior["s_high"])
        df["prior_rth_low"]   = df["rth_session_id"].map(prior["s_low"])
        df["prior_rth_close"] = df["rth_session_id"].map(prior["s_close"])
        return df

    def _compute_signal_eligible(self, df: pd.DataFrame) -> pd.Series:
        rth_ok   = df["session_type"] == SessionType.RTH.value
        time_ok  = (df["et_min"] >= _SIG_START) & (df["et_min"] <= _SIG_END)
        event_ok = ~df["event_flag"].astype(bool)
        return (rth_ok & time_ok & event_ok).astype(bool)

    def _attach_quality_flags(self, df: pd.DataFrame) -> pd.DataFrame:
        ok = (
            df[["open","high","low","close","volume"]].notna().all(axis=1)
            & (df["volume"] > 0)
            & (df["high"]  >= df["low"])
            & (df["open"]  >= df["low"])  & (df["open"]  <= df["high"])
            & (df["close"] >= df["low"])  & (df["close"] <= df["high"])
        )
        df["dq_ok"] = ok
        df.loc[~ok, "signal_eligible"] = False
        n_bad = (~ok).sum()
        if n_bad:
            logger.warning(f"[{self.symbol}] {n_bad} bars failed quality checks.")
        return df

    def _attach_metadata(self, df: pd.DataFrame) -> pd.DataFrame:
        df["meta_symbol"]      = self.symbol
        df["meta_tick_size"]   = self.spec.tick_size
        df["meta_point_value"] = self.spec.point_value
        df["meta_tick_value"]  = self.spec.tick_value
        df["meta_is_micro"]    = self.spec.is_micro
        return df

    def _log_summary(self, df: pd.DataFrame) -> None:
        rth       = (df["session_type"] == SessionType.RTH.value).sum()
        n_sess    = int(df["rth_session_id"].max() + 1) if rth > 0 else 0
        eligible  = df["signal_eligible"].sum()
        ev_blk    = df["event_flag"].sum()
        dq_fail   = (~df["dq_ok"]).sum()
        logger.info(
            f"[{self.symbol}] ✓ total={len(df):,} | rth={rth:,} | sessions={n_sess} | "
            f"eligible={eligible:,} | event-blocked={ev_blk:,} | dq-fail={dq_fail:,}"
        )


