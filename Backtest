#!/usr/bin/env python3
"""The MES Book — combined sim of the three validated sleeves on real ES 1m 2017-2026.

Sleeve A  EARLY OVERNIGHT DRIFT (core, ~3/wk): prior daily close > 200d MA ->
          long 1 MES at 16:00 ET close, exit 02:00 ET, 12-pt hard stop.
Sleeve B  OVERREACTION FADE (~13/yr): prior RTH |open->close| > 1.2 x session
          ATR(14, TR of committed RTH sessions) -> fade today's 09:30 open,
          target 0.5xATR, stop 0.7xATR, exit 12:00 ET.
Sleeve C  PRE-FOMC DRIFT (8/yr): long D-1 16:00 ET -> exit 13:55 ET FOMC day.

Overlap rule: on bull-regime FOMC D-1 nights, sleeve C takes the slot; sleeve A
entry is skipped (one contract held at a time overnight -> margin-safe at $2.5k).
Costs $2.5 RT per micro. MES $5/pt. All causal (prior-day confirmed regime).
"""
import numpy as np, pandas as pd

MES, RT = 5.0, 2.5
DATA = "/Users/kaveh/omni_x/es_front_2017_24h_1m.parquet"
NY = "America/New_York"

FOMC = """2017-02-01 2017-03-15 2017-05-03 2017-06-14 2017-07-26 2017-09-20 2017-11-01 2017-12-13
2018-01-31 2018-03-21 2018-05-02 2018-06-13 2018-08-01 2018-09-26 2018-11-08 2018-12-19
2019-01-30 2019-03-20 2019-05-01 2019-06-19 2019-07-31 2019-09-18 2019-10-30 2019-12-11
2020-01-29 2020-04-29 2020-06-10 2020-07-29 2020-09-16 2020-11-05 2020-12-16
2021-01-27 2021-03-17 2021-04-28 2021-06-16 2021-07-28 2021-09-22 2021-11-03 2021-12-15
2022-01-26 2022-03-16 2022-05-04 2022-06-15 2022-07-27 2022-09-21 2022-11-02 2022-12-14
2023-02-01 2023-03-22 2023-05-03 2023-06-14 2023-07-26 2023-09-20 2023-11-01 2023-12-13
2024-01-31 2024-03-20 2024-05-01 2024-06-12 2024-07-31 2024-09-18 2024-11-07 2024-12-18
2025-01-29 2025-03-19 2025-05-07 2025-06-18 2025-07-30 2025-09-17 2025-10-29 2025-12-10
2026-01-28 2026-03-18 2026-04-29""".split()

def load_5m():
    df = pd.read_parquet(DATA).rename(columns=str.lower)
    tc = next(c for c in df.columns if c in ("ts_event","ts","timestamp"))
    df[tc] = pd.to_datetime(df[tc], utc=True)
    df = df.set_index(tc).sort_index()
    df = df[~df.index.duplicated(keep="last")][["open","high","low","close"]]
    b = df.resample("5min", label="left", closed="left").agg(
        {"open":"first","high":"max","low":"min","close":"last"}).dropna(subset=["open"])
    b.index = b.index.tz_convert(NY)
    return b

def sleeves(b):
    o,h,l,c = (b[k].to_numpy() for k in ["open","high","low","close"])
    ts = b.index; mins = ts.hour*60 + ts.minute; day = ts.normalize()
    n = len(b)
    # causal bull regime: PRIOR day's last close vs 200d MA of daily last closes
    dc = b["close"].groupby(day).last()
    bull_d = (dc > dc.rolling(200).mean()).shift(1).fillna(False)
    bull = bull_d.reindex(day).to_numpy()
    # committed RTH sessions (09:30-16:00) for the fade's session-ATR
    rth = (mins >= 570) & (mins < 960)
    rd = pd.DataFrame({"o":o,"h":h,"l":l,"c":c,"day":day}).loc[rth]
    S = rd.groupby("day").agg(o=("o","first"), h=("h","max"), l=("l","min"), c=("c","last"))
    tr = pd.concat([S.h-S.l, (S.h-S.c.shift(1)).abs(), (S.l-S.c.shift(1)).abs()],axis=1).max(axis=1)
    S["atr"]  = tr.rolling(14).mean().shift(1)          # known before today's open
    S["pmove"] = (S.c - S.o).shift(1)                    # prior session open->close
    fomc = set(pd.Timestamp(d, tz=NY) for d in FOMC)
    fomc_prev = {}                                       # trading day before each FOMC day
    days_idx = S.index
    for f in fomc:
        prev = days_idx[days_idx < f]
        if len(prev): fomc_prev[prev[-1]] = f

    bar1600 = {d:i for i,d in zip(np.where(mins==960)[0], day[np.where(mins==960)[0]])}
    A, B, C = [], [], []

    # --- helper: walk long from bar e to first (stop hit | exit bar), return pnl$
    def walk_long(e, x_idx, stop_px=None, tgt_px=None):
        for k in range(e+1, x_idx):
            if stop_px is not None and l[k] <= stop_px: return (ts[k], (stop_px - c[e])*MES - RT, "stop")
            if tgt_px  is not None and h[k] >= tgt_px:  return (ts[k], (tgt_px  - c[e])*MES - RT, "tgt")
        return (ts[x_idx], (c[x_idx] - c[e])*MES - RT, "time")
    def walk_short(e, x_idx, stop_px=None, tgt_px=None):
        for k in range(e+1, x_idx):
            if stop_px is not None and h[k] >= stop_px: return (ts[k], (c[e] - stop_px)*MES - RT, "stop")
            if tgt_px  is not None and l[k] <= tgt_px:  return (ts[k], (c[e] - tgt_px )*MES - RT, "tgt")
        return (ts[x_idx], (c[e] - c[x_idx])*MES - RT, "time")

    for d, e in bar1600.items():                        # ---- sleeves A & C (16:00 entries)
        is_pre_fomc = d in fomc_prev
        if is_pre_fomc:                                 # C: hold to 13:55 on FOMC day
            f = fomc_prev[d]
            x = np.where((day == f) & (mins == 835))[0] # 13:55 bar
            if len(x):
                t, pnl, how = walk_long(e, int(x[0]))   # no stop
                C.append((ts[e], pnl))
            continue                                    # A skipped on pre-FOMC night
        if not bull[e]: continue
        x = np.where((ts > ts[e]) & (mins == 120))[0]   # A: next 02:00 ET bar
        if len(x)==0 or (ts[int(x[0])]-ts[e]).total_seconds() > 24*3600: continue
        t, pnl, how = walk_long(e, int(x[0]), stop_px=c[e]-12.0)
        A.append((ts[e], pnl))

    for d, row in S.iterrows():                         # ---- sleeve B (09:30 fades)
        if not np.isfinite(row.atr) or row.atr<=0 or not np.isfinite(row.pmove): continue
        if abs(row.pmove) <= 1.2*row.atr: continue
        e = np.where((day == d) & (mins == 570))[0]
        x = np.where((day == d) & (mins == 720))[0]     # exit 12:00
        if len(e)==0 or len(x)==0: continue
        e, x = int(e[0]), int(x[0])
        ent = o[e]
        if row.pmove > 0:                               # prior day up -> short fade
            t,pnl,how = walk_short(e-1, x, stop_px=ent+0.7*row.atr, tgt_px=ent-0.5*row.atr)
        else:
            t,pnl,how = walk_long(e-1, x, stop_px=ent-0.7*row.atr, tgt_px=ent+0.5*row.atr)
        B.append((ts[e], pnl))
    return [pd.DataFrame(s, columns=["ts","pnl"]) for s in (A,B,C)]

def stats(t, label, yrs):
    eq = t.pnl.cumsum(); dd = float((eq-eq.cummax()).min()) if len(t) else 0.0
    d = t.set_index("ts").pnl.resample("1D").sum().dropna()
    shp = d.mean()/d.std()*np.sqrt(252) if len(d)>2 and d.std()>0 else np.nan
    return dict(sleeve=label, n=len(t), n_yr=round(len(t)/yrs,1),
                wr=round(100*(t.pnl>0).mean(),1) if len(t) else 0,
                per_tr=round(t.pnl.mean(),2) if len(t) else 0,
                ann=round(t.pnl.sum()/yrs), maxDD=round(dd),
                skew=round(t.pnl.skew(),2) if len(t)>3 else np.nan,
                sharpe=round(shp,2))

def mc_dd(daily, n=20000, seed=7):
    rng = np.random.default_rng(seed); v = daily.to_numpy()
    mins = np.empty(n)
    for i in range(n):
        eq = np.cumsum(rng.choice(v, 252))
        peak = np.maximum.accumulate(np.maximum(eq, 0.0))
        mins[i] = (eq - peak).min()
    return mins

if __name__ == "__main__":
    b = load_5m()
    yrs = (b.index[-1]-b.index[0]).days/365.25
    A,B,C = sleeves(b)
    allt = pd.concat([A.assign(s="A"),B.assign(s="B"),C.assign(s="C")]).sort_values("ts")
    rows = [stats(A,"A overnight",yrs), stats(B,"B fade",yrs), stats(C,"C preFOMC",yrs),
            stats(allt,"BOOK",yrs)]
    print(pd.DataFrame(rows).to_string(index=False))
    # IS/OOS on the book
    half = "2021-09-01"
    print(pd.DataFrame([stats(allt[allt.ts< half],"BOOK IS  17-21",4.6),
                        stats(allt[allt.ts>=half],"BOOK OOS 21-26",4.8)]).to_string(index=False))
    tstat = lambda t: t.pnl.mean()/t.pnl.std()*np.sqrt(len(t))
    print(f"t-stats: A={tstat(A):.2f}  B={tstat(B):.2f}  C={tstat(C):.2f}  BOOK={tstat(allt):.2f}"
          f"  BOOK-OOS={tstat(allt[allt.ts>=half]):.2f}")
    # Monte-Carlo 1-yr drawdown exceedance from combined daily P&L
    d = allt.set_index("ts").pnl.resample("1D").sum().dropna()
    mm = mc_dd(d)
    for thr in (500,750,1000,1500):
        print(f"MC 1yr P(maxDD > ${thr}): {100*(mm < -thr).mean():.1f}%")
    print(f"weekly trade freq: {len(allt)/yrs/52:.1f}/wk   yearly $: {allt.pnl.sum()/yrs:,.0f}")
    for y,g in allt.groupby(allt.ts.dt.year):
        print(f"  {y}: n={len(g):4d}  ${g.pnl.sum():+8,.0f}")

