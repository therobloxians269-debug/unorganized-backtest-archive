   Core question: does a BETTER FILL turn this profitable? Signal held fixed, entry varied."""
import pandas as pd, numpy as np, warnings; warnings.filterwarnings('ignore')

# ---------- New Week Opening Gap ----------
def find_nwog(df, min_gap_hours=12):
    """Weekend gap: last bar before the break (Fri close) -> first bar after (Sun open)."""
    dt = df.index.to_series().diff()
    brk = np.where(dt > pd.Timedelta(hours=min_gap_hours))[0]
    out = []
    for i in brk:
        fri_c = df['c'].iloc[i-1]; sun_o = df['o'].iloc[i]
        lo, hi = min(fri_c, sun_o), max(fri_c, sun_o)
        out.append(dict(t=df.index[i], fri_close=fri_c, sun_open=sun_o,
                        lo=lo, hi=hi, ce=(lo+hi)/2, width=hi-lo))
    return pd.DataFrame(out)

def inside_nwog(df, nw, keep=5, tol=0.0):
    """True where price is inside any of the last `keep` NWOGs (causal)."""
    n=len(df); ins=np.zeros(n,bool)
    ce=np.full(n,np.nan); glo=np.full(n,np.nan); ghi=np.full(n,np.nan)
    h,l=df['h'].values,df['l'].values; idx=df.index
    starts=nw['t'].values
    for k in range(len(nw)):
        s=np.searchsorted(idx.values, starts[k])
        e=n if k+keep>=len(nw) else n   # NWOGs persist as reference levels
        lo,hi,c=nw['lo'].iloc[k],nw['hi'].iloc[k],nw['ce'].iloc[k]
        if hi-lo<=0: continue
        seg=slice(s,e)
        m=(l[seg]<=hi+tol)&(h[seg]>=lo-tol)
        # only the most recent `keep` gaps stay active
        if k < len(nw)-keep:
            lim=np.searchsorted(idx.values, starts[k+keep])
            m=m.copy(); m[lim-s:]=False
        w=np.where(m)[0]+s
        ins[w]=True; ce[w]=c; glo[w]=lo; ghi[w]=hi
    df=df.copy(); df['in_nwog']=ins; df['nwog_ce']=ce; df['nwog_lo']=glo; df['nwog_hi']=ghi
    return df

# ---------- 4h Fair Value Gaps (causal) ----------
def fvg4h(df, tf=240):
    """3-bar FVG on the 4h series. Bull: low[i] > high[i-2]  -> gap [high[i-2], low[i]].
       Known only at the CLOSE of bar i, so stamp it at bar i's close time."""
    r=df.resample(f'{tf}min',label='left',closed='left').agg({'h':'max','l':'min','c':'last'}).dropna()
    hi,lo=r['h'].values,r['l'].values; t=r.index
    gaps=[]
    for i in range(2,len(r)):
        if lo[i]>hi[i-2]:
            gaps.append(dict(known=t[i]+pd.Timedelta(minutes=tf),bot=hi[i-2],top=lo[i],dir=1))
        if hi[i]<lo[i-2]:
            gaps.append(dict(known=t[i]+pd.Timedelta(minutes=tf),bot=hi[i],top=lo[i-2],dir=-1))
    return pd.DataFrame(gaps)

def nearest_dol(gaps, now, price, side):
    """Nearest unfilled 4h FVG above (side=1) / below (side=-1) at time `now`."""
    g=gaps[gaps['known']<=now]
    if len(g)==0: return np.nan
    if side==1:
        c=g[g['bot']>price]
        return c['bot'].min() if len(c) else np.nan
    c=g[g['top']<price]
    return c['top'].max() if len(c) else np.nan

