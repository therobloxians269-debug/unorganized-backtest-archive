PROGRAM v3 -- single-script institutional build. Sleeves:
  C1 carry @ Binance  (delta-neutral, funding-weighted, 10% per-name cap)
  C2 carry @ Hyperliquid (cross-venue: spot leg + HL perp short + HL funding; 2023+)
  M  crypto XS-momentum (point-in-time universe, survivorship-corrected)
  T  diversified futures trend (14 CME markets)
Capital-split portfolio (no risk-parity leverage fantasies), cash yield ONLY on the
carry sleeves' margin buffer (no double count). Reports sleeve matrix, PSR vs 0/1/2,
per-year, and a full disclosure block. All data free; all caches local.

    python3 program_v3.py
"""
from __future__ import annotations
import os, time
import numpy as np
import pandas as pd
import requests
from lib_perf import perf_stats, psr, per_year

HL = "https://api.hyperliquid.xyz/info"
HLF_CACHE = "/Users/kaveh/mim_research/hl_funding.parquet"
HLK_CACHE = "/Users/kaveh/mim_research/hl_perp_1d.parquet"
COINS = ["BTC", "ETH", "SOL", "XRP", "DOGE", "ADA", "AVAX", "LINK", "LTC", "DOT"]
CAPF, LEGC, NAMECAP = 1.5, 0.0040, 0.10
CASH_Y = 0.04 / 365


def hl_post(payload, tries=3):
    for _ in range(tries):
        try:
            r = requests.post(HL, json=payload, timeout=20)
            if r.status_code == 200:
                return r.json()
        except Exception:
            pass
        time.sleep(0.7)
    return None


def fetch_hl_funding():
    if os.path.exists(HLF_CACHE):
        return pd.read_parquet(HLF_CACHE)
    rows = []
    for c in COINS:
        t0 = int(pd.Timestamp("2023-01-01").timestamp() * 1000)
        end = int(pd.Timestamp.now().timestamp() * 1000)
        n = 0
        while t0 < end:
            j = hl_post({"type": "fundingHistory", "coin": c, "startTime": t0, "endTime": end})
            if not j:
                break
            for x in j:
                rows.append({"t": int(x["time"]), "coin": c, "fr": float(x["fundingRate"])})
            n += len(j)
            if len(j) < 2:
                break
            t0 = int(j[-1]["time"]) + 1
            time.sleep(0.15)
        print(f"  HL funding {c}: {n} hourly records", flush=True)
    df = pd.DataFrame(rows)
    df["t"] = pd.to_datetime(df["t"], unit="ms")
    df.to_parquet(HLF_CACHE)
    return df


def fetch_hl_candles():
    if os.path.exists(HLK_CACHE):
        return pd.read_parquet(HLK_CACHE)
    rows = []
    t0 = int(pd.Timestamp("2023-01-01").timestamp() * 1000)
    end = int(pd.Timestamp.now().timestamp() * 1000)
    for c in COINS:
        j = hl_post({"type": "candleSnapshot", "req": {"coin": c, "interval": "1d",
                                                       "startTime": t0, "endTime": end}})
        if not j:
            print(f"  HL candles {c}: none"); continue
        for x in j:
            rows.append({"t": int(x["t"]), "coin": c, "close": float(x["c"])})
        print(f"  HL candles {c}: {len(j)} days", flush=True)
        time.sleep(0.2)
    df = pd.DataFrame(rows)
    df["t"] = pd.to_datetime(df["t"], unit="ms")
    df.to_parquet(HLK_CACHE)
    return df


def carry_sleeve(fund_daily, pnl_daily):
    """funding-weighted, 10% per-name cap, weekly, net of leg costs, on 1.5x capital."""
    tr = fund_daily.rolling(30).mean().shift(1)
    raw = tr.clip(lower=0)
    w = raw.div(raw.sum(axis=1).replace(0, np.nan), axis=0).clip(upper=NAMECAP)
    w = w.div(w.sum(axis=1).replace(0, np.nan), axis=0).fillna(0.0)     # renorm under caps
    w = w.resample("W").last().reindex(fund_daily.index, method="ffill").fillna(0.0)
    gross = (w * pnl_daily).sum(axis=1) / CAPF
    return (gross - w.diff().abs().sum(axis=1) * LEGC / CAPF + (CAPF - 1) / CAPF * CASH_Y).dropna()


def main():
    # ---- Binance legs (cached) ----
    k = pd.read_parquet("binance_klines.parquet"); k["date"] = k["t"].dt.normalize()
    f = pd.read_parquet("binance_funding.parquet"); f["date"] = f["t"].dt.normalize()
    bspot = k[k.kind == "spot"].pivot_table(index="date", columns="sym", values="close")
    bperp = k[k.kind == "perp"].pivot_table(index="date", columns="sym", values="close")
    bfund = f.groupby(["date", "sym"])["fr"].sum().unstack()
    bidx = bspot.index.intersection(bperp.index).intersection(bfund.index)
    bspot, bperp, bfund = bspot.loc[bidx], bperp.loc[bidx], bfund.reindex(bidx)
    C1 = carry_sleeve(bfund, bspot.pct_change() - bperp.pct_change() + bfund)

    # ---- Hyperliquid legs ----
    hf = fetch_hl_funding(); hk = fetch_hl_candles()
    hf["date"] = hf["t"].dt.normalize()
    hfund = hf.groupby(["date", "coin"])["fr"].sum().unstack()
    hperp = hk.assign(date=hk["t"].dt.normalize()).pivot_table(index="date", columns="coin", values="close")
    # spot leg: Binance spot (proxy for any USD spot venue), mapped BTCUSDT->BTC
    bs = bspot.copy(); bs.columns = [c.replace("USDT", "") for c in bs.columns]
    hidx = hfund.index.intersection(hperp.index).intersection(bs.index)
    cols = [c for c in COINS if c in hfund.columns and c in hperp.columns and c in bs.columns]
    hfund, hperp, hs = hfund.loc[hidx, cols], hperp.loc[hidx, cols], bs.loc[hidx, cols]
    C2 = carry_sleeve(hfund, hs.pct_change() - hperp.pct_change() + hfund)
    print(f"\nHL sleeve window: {C2.index.min().date()} -> {C2.index.max().date()} | "
          f"mean HL funding (ann): {(hfund.mean()*365*100).mean():.1f}%")

    # ---- existing sleeves ----
