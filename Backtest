"""Mechanism library. Each 'family' is ONE codified trading mechanism, parameterized
to express many named guru strategies. Every family returns a trades DataFrame:
    columns = [entry_time, exit_time, dir, entry, exit, pts, reason, style]
where pts = dir*(exit-entry) in index points (GROSS; friction applied in engine.py).

Design rules (robustness-first, matching the user's house style):
- Intraday only: every position is flat by 16:00 ET (fits a $1k day-trade margin bucket).
- No look-ahead: signals use only bars up to the decision bar; exits walk forward.
- Conservative fills: on a bar that spans both stop and target, assume STOP first.
- Entries fill at the trigger level (stop/market) or the signal close (limit), per 'style'.
"""
import numpy as np
import pandas as pd
from data import rth, add_vwap, ema, atr, rsi, RTH_OPEN, RTH_CLOSE

# ---------------------------------------------------------------- core exit walk
def _walk(h, l, c, start, eod, d, entry, stop, target):
    """Simulate bar-by-bar from `start` to `eod`. Returns (exit_px, exit_i, reason)."""
    for i in range(start, eod + 1):
        hi, lo = h[i], l[i]
        if d > 0:
            hs = lo <= stop
            ht = target is not None and hi >= target
        else:
            hs = hi >= stop
            ht = target is not None and lo <= target
        if hs:                       # stop checked first (conservative)
            return stop, i, "stop"
        if ht:
            return target, i, "target"
    return c[eod], eod, "eod"


def _mk(rows):
    cols = ["entry_time", "exit_time", "dir", "entry", "exit", "pts", "reason", "style"]
    return pd.DataFrame(rows, columns=cols)


# ---------------------------------------------------------------- per-date context
def day_context(df):
    """Per ET-date reference levels used by level/sweep/pivot families.
    Returns dict date-> {pdh,pdl,asia_hi,asia_lo,london_hi,london_lo,on_hi,on_lo,
                         midnight_open, P,R1,S1,R2,S2, cam_h3,cam_l3,cam_h4,cam_l4}."""
    r = rth(df)
    # prior RTH high/low/close per date
    daily = r.groupby("date").agg(h=("high", "max"), l=("low", "min"), c=("close", "last"),
                                  o=("open", "first"))
    daily["pdh"] = daily["h"].shift(1)
    daily["pdl"] = daily["l"].shift(1)
    daily["pdc"] = daily["c"].shift(1)
    # floor pivots from prior day
    P = (daily["pdh"] + daily["pdl"] + daily["pdc"]) / 3
    rng = daily["pdh"] - daily["pdl"]
    piv = pd.DataFrame({"P": P, "R1": 2 * P - daily["pdl"], "S1": 2 * P - daily["pdh"],
                        "R2": P + rng, "S2": P - rng,
                        "cam_h3": daily["pdc"] + rng * 1.1 / 4, "cam_l3": daily["pdc"] - rng * 1.1 / 4,
                        "cam_h4": daily["pdc"] + rng * 1.1 / 2, "cam_l4": daily["pdc"] - rng * 1.1 / 2})
    ctx = {}
    for d in daily.index:
        ctx[d] = dict(pdh=daily.at[d, "pdh"], pdl=daily.at[d, "pdl"], pdc=daily.at[d, "pdc"],
                      **{k: piv.at[d, k] for k in piv.columns})
    # overnight/session ranges. `date` is the trade SESSION: evening globex bars already
    # roll to the next session, so Asia/London for session S are just its non-RTH bars.
    g = df
    # London 02:00-05:00 ET
    lon = g[(g["mod"] >= 2 * 60) & (g["mod"] < 5 * 60)].groupby("date").agg(hi=("high", "max"), lo=("low", "min"))
    for d, row in lon.iterrows():
        if d in ctx:
            ctx[d]["london_hi"], ctx[d]["london_lo"] = row["hi"], row["lo"]
    # Asia 18:00-24:00 (prev eve, rolled into this session) + 00:00-02:00 ET
    asia = g[(g["mod"] >= 18 * 60) | (g["mod"] < 2 * 60)].groupby("date").agg(hi=("high", "max"), lo=("low", "min"))
    for d, row in asia.iterrows():
        if d in ctx:
            ctx[d]["asia_hi"], ctx[d]["asia_lo"] = row["hi"], row["lo"]
    # midnight open (00:00 ET)
    mo = g[g["mod"] == 0].groupby("date").agg(o=("open", "first"))
    for d, row in mo.iterrows():
        if d in ctx:
            ctx[d]["midnight_open"] = row["o"]
    return ctx


def _iter_days(df):
    r = rth(df)
    for d, g in r.groupby("date", sort=True):
        if len(g) >= 60:
            yield d, g


# ================================================================ FAMILIES
def orb(df, or_min=5, target_R=2.0, side="break", stop_mode="other", start_mod=RTH_OPEN,
        window_min=120, **_):
    """Opening-range breakout/fade. side: break|fade. Covers ORB, 5m/15m/30m ORB,
    ACD, London breakout (start_mod), VWAP-ORB, dual-ORB."""
    rows = []
    for d, g in _iter_days(df):
        g = g[g["mod"] >= start_mod]
        if len(g) < or_min + 5:
            continue
        o, h, l, c, mod = (g[x].to_numpy() for x in ("open", "high", "low", "close", "mod"))
        t = g.index
        m0 = mod[0]
        orb_mask = mod < m0 + or_min
        oh, ol = h[orb_mask].max(), l[orb_mask].min()
        walk = np.where(mod >= m0 + or_min)[0]
        if len(walk) == 0:
            continue
        eod = len(g) - 1
        d_dir = 0
        for k in walk:
            up, dn = h[k] >= oh, l[k] <= ol
            if up and not dn:
                d_dir, lvl = 1, oh
                break
            if dn and not up:
                d_dir, lvl = -1, ol
                break
            if up and dn:
                d_dir, lvl = (1, oh) if o[k] <= oh else (-1, ol)
                break
        else:
            continue
        if side == "fade":
            d_dir = -d_dir
            lvl = ol if d_dir > 0 else oh  # re-enter from the opposite band on fade
        entry = lvl
        risk = (oh - ol)
        if risk <= 0:
            continue
        stop = (entry - d_dir * risk) if stop_mode == "other" else (entry - d_dir * risk)
        target = entry + d_dir * target_R * risk if target_R else None
        ex, xi, rs = _walk(h, l, c, k, eod, d_dir, entry, stop, target)
        rows.append((t[k], t[xi], d_dir, entry, ex, d_dir * (ex - entry), rs, "market"))
    return _mk(rows)


def sweep_reversal(df, ref="pdh_pdl", confirm_bars=3, target_R=2.0, stop_pad_frac=0.15,
                   window=(RTH_OPEN, RTH_OPEN + 150), ctx=None, **_):
    """Liquidity sweep + reversal (ICT turtle-soup / Judas / TJR sweep / SMC MSS proxy).
    ref levels: pdh_pdl, asia, london, opening_range(first 30m). Sweep a level then
    close back inside within confirm_bars -> fade. Stop beyond the sweep extreme;
    target = opposing reference level (or fixed R fallback)."""
    if ctx is None:
        ctx = day_context(df)
    rows = []
    for d, g in _iter_days(df):
        levels = ctx.get(d, {})
        gg = g[(g["mod"] >= window[0]) & (g["mod"] < window[1])]
        if len(gg) < confirm_bars + 5:
            continue
        o, h, l, c, mod = (gg[x].to_numpy() for x in ("open", "high", "low", "close", "mod"))
        t = gg.index
        full = g
        fo, fh, fl, fc, fmod = (full[x].to_numpy() for x in ("open", "high", "low", "close", "mod"))
        eod = len(full) - 1
        if ref == "pdh_pdl":
            hi_lvl, lo_lvl = levels.get("pdh"), levels.get("pdl")
        elif ref == "asia":
            hi_lvl, lo_lvl = levels.get("asia_hi"), levels.get("asia_lo")
        elif ref == "london":
            hi_lvl, lo_lvl = levels.get("london_hi"), levels.get("london_lo")
        else:  # opening_range first 30m of the window
            orm = mod < mod[0] + 30
            hi_lvl, lo_lvl = h[orm].max(), l[orm].min()
        if hi_lvl is None or lo_lvl is None or np.isnan(hi_lvl) or np.isnan(lo_lvl):
            continue
        span = hi_lvl - lo_lvl
        if span <= 0:
            continue
        done = False
        for i in range(1, len(gg)):
            if done:
                break
            # sweep HIGH then close back below -> short
            if h[i] > hi_lvl and c[i] < hi_lvl:
                d_dir = -1
                entry = c[i]
                stop = h[i] + stop_pad_frac * span * 0.0 + (h[i] - hi_lvl) * 0  # stop at sweep high
                stop = h[i]
                target = lo_lvl if target_R is None else entry - target_R * (stop - entry)
                start_full = np.where(full.index == t[i])[0]
                if len(start_full) == 0:
                    continue
                sidx = int(start_full[0]) + 1
                ex, xi, rs = _walk(fh, fl, fc, min(sidx, eod), eod, d_dir, entry, stop, target)
                rows.append((t[i], full.index[xi], d_dir, entry, ex, d_dir * (ex - entry), rs, "limit"))
                done = True
            elif l[i] < lo_lvl and c[i] > lo_lvl:
                d_dir = 1
                entry = c[i]
                stop = l[i]
                target = hi_lvl if target_R is None else entry + target_R * (entry - stop)
                start_full = np.where(full.index == t[i])[0]
                if len(start_full) == 0:
                    continue
                sidx = int(start_full[0]) + 1
                ex, xi, rs = _walk(fh, fl, fc, min(sidx, eod), eod, d_dir, entry, stop, target)
                rows.append((t[i], full.index[xi], d_dir, entry, ex, d_dir * (ex - entry), rs, "limit"))
                done = True
    return _mk(rows)


def ema_cross(df, fast=9, slow=20, target_R=2.0, stop_atr=1.5, atr_n=14, window=(RTH_OPEN, RTH_CLOSE), **_):
    """Fast/slow EMA cross, trade in cross direction. Stop = k*ATR, target = R multiple.
    Covers 9/20, 9/21, 5/13, 8/21 EMA-cross systems."""
    rows = []
    for d, g in _iter_days(df):
        ef, es_ = ema(g["close"], fast), ema(g["close"], slow)
        a = atr(g, atr_n)
        h, l, c, mod = (g[x].to_numpy() for x in ("high", "low", "close", "mod"))
        ef, es_, a = ef.to_numpy(), es_.to_numpy(), a.to_numpy()
        t = g.index
        eod = len(g) - 1
        cross = np.sign(ef - es_)
        for i in range(slow + 1, len(g) - 3):
            if mod[i] < window[0] or mod[i] >= window[1] - 5:
                continue
            if cross[i] != cross[i - 1] and cross[i] != 0 and not np.isnan(a[i]):
                d_dir = int(cross[i])
                entry = c[i]
                rr = stop_atr * a[i]
                if rr <= 0:
                    continue
                stop = entry - d_dir * rr
                target = entry + d_dir * target_R * rr
                ex, xi, rs = _walk(h, l, c, i + 1, eod, d_dir, entry, stop, target)
                rows.append((t[i], t[xi], d_dir, entry, ex, d_dir * (ex - entry), rs, "market"))
    return _mk(rows)


def ma_pullback(df, ma=20, target_R=2.0, stop_atr=1.5, atr_n=14, trend_slope_bars=10,
                window=(RTH_OPEN + 15, RTH_CLOSE), **_):
    """Trend-pullback: price above rising MA -> buy the tag of the MA (Rayner Teo MAEE,
    Al Brooks H1/H2 pullback, 'buy the dip in uptrend'). Limit entry at MA."""
    rows = []
    for d, g in _iter_days(df):
        mline = g["close"].rolling(ma).mean()
        a = atr(g, atr_n)
        h, l, c, mod = (g[x].to_numpy() for x in ("high", "low", "close", "mod"))
        m = mline.to_numpy(); av = a.to_numpy(); t = g.index
        eod = len(g) - 1
        armed = 0
        for i in range(ma + trend_slope_bars, len(g) - 3):
            if mod[i] < window[0] or mod[i] >= window[1] - 5 or np.isnan(m[i]) or np.isnan(av[i]):
                continue
            slope = m[i] - m[i - trend_slope_bars]
            up = slope > 0 and c[i] > m[i]
            dn = slope < 0 and c[i] < m[i]
            # pullback tag: low dips to MA in uptrend
            if up and l[i] <= m[i] and c[i] > m[i]:
                d_dir = 1; entry = m[i]
            elif dn and h[i] >= m[i] and c[i] < m[i]:
                d_dir = -1; entry = m[i]
            else:
                continue
            rr = stop_atr * av[i]
            if rr <= 0:
                continue
            stop = entry - d_dir * rr
            target = entry + d_dir * target_R * rr
            ex, xi, rs = _walk(h, l, c, i + 1, eod, d_dir, entry, stop, target)
            rows.append((t[i], t[xi], d_dir, entry, ex, d_dir * (ex - entry), rs, "limit"))
    return _mk(rows)


def vwap_reversion(df, k_sd=2.0, target="vwap", stop_atr=1.5, atr_n=14, window=(RTH_OPEN + 30, RTH_CLOSE - 30), **_):
    """Fade price extended k*sd from session VWAP back toward VWAP (VWAP-bounce scalps)."""
    rows = []
    for d, g in _iter_days(df):
        g = add_vwap(g)
        a = atr(g, atr_n)
        h, l, c, mod = (g[x].to_numpy() for x in ("high", "low", "close", "mod"))
        vw, sd = g["vwap"].to_numpy(), g["vwap_sd"].to_numpy()
        av = a.to_numpy(); t = g.index; eod = len(g) - 1
        for i in range(30, len(g) - 3):
            if mod[i] < window[0] or mod[i] >= window[1] or sd[i] <= 0 or np.isnan(av[i]):
                continue
            ext = (c[i] - vw[i]) / sd[i]
            if ext >= k_sd:                    # too high -> short back to vwap
                d_dir = -1; entry = c[i]
            elif ext <= -k_sd:                 # too low -> long back to vwap
                d_dir = 1; entry = c[i]
            else:
                continue
            stop = entry - d_dir * stop_atr * av[i]
            tgt = vw[i] if target == "vwap" else entry + d_dir * 2 * stop_atr * av[i]
            ex, xi, rs = _walk(h, l, c, i + 1, eod, d_dir, entry, stop, tgt)
            rows.append((t[i], t[xi], d_dir, entry, ex, d_dir * (ex - entry), rs, "limit"))
    return _mk(rows)


def vwap_break(df, target_R=2.0, stop_atr=1.5, atr_n=14, window=(RTH_OPEN, RTH_OPEN + 120), **_):
    """VWAP reclaim/loss in the opening window -> trade the break direction."""
    rows = []
    for d, g in _iter_days(df):
        g = add_vwap(g)
        a = atr(g, atr_n)
        h, l, c, mod = (g[x].to_numpy() for x in ("high", "low", "close", "mod"))
        vw = g["vwap"].to_numpy(); av = a.to_numpy(); t = g.index; eod = len(g) - 1
        sidev = np.sign(c - vw)
        for i in range(5, len(g) - 3):
            if mod[i] < window[0] or mod[i] >= window[1] or np.isnan(av[i]):
                continue
            if sidev[i] != sidev[i - 1] and sidev[i] != 0:
                d_dir = int(sidev[i]); entry = c[i]
                rr = stop_atr * av[i]
                if rr <= 0:
                    continue
                stop = entry - d_dir * rr; target = entry + d_dir * target_R * rr
                ex, xi, rs = _walk(h, l, c, i + 1, eod, d_dir, entry, stop, target)
                rows.append((t[i], t[xi], d_dir, entry, ex, d_dir * (ex - entry), rs, "market"))
                break   # first reclaim of the day only
    return _mk(rows)


def bollinger(df, n=20, k=2.0, mode="revert", target_R=2.0, stop_atr=1.5, atr_n=14,
              window=(RTH_OPEN + 15, RTH_CLOSE - 15), **_):
    """Bollinger mean-reversion (close outside band -> revert to mid) or squeeze breakout."""
    rows = []
    for d, g in _iter_days(df):
        mid = g["close"].rolling(n).mean()
        sd = g["close"].rolling(n).std()
        up, lo = mid + k * sd, mid - k * sd
        a = atr(g, atr_n)
        h, l, c, mod = (g[x].to_numpy() for x in ("high", "low", "close", "mod"))
        mid_, up_, lo_, av = mid.to_numpy(), up.to_numpy(), lo.to_numpy(), a.to_numpy()
        t = g.index; eod = len(g) - 1
        for i in range(n + 1, len(g) - 3):
            if mod[i] < window[0] or mod[i] >= window[1] or np.isnan(av[i]) or np.isnan(up_[i]):
                continue
            if mode == "revert":
                if c[i] > up_[i]:
                    d_dir = -1; entry = c[i]; tgt = mid_[i]
                elif c[i] < lo_[i]:
                    d_dir = 1; entry = c[i]; tgt = mid_[i]
                else:
                    continue
                stop = entry - d_dir * stop_atr * av[i]
            else:  # squeeze breakout: close crosses out of band after narrow bands
                band_w = (up_[i] - lo_[i])
                narrow = band_w < np.nanmedian(up_[max(0, i - n):i] - lo_[max(0, i - n):i]) * 0.8
                if not narrow:
                    continue
                if c[i] > up_[i]:
                    d_dir = 1; entry = c[i]
                elif c[i] < lo_[i]:
                    d_dir = -1; entry = c[i]
                else:
                    continue
                stop = entry - d_dir * stop_atr * av[i]; tgt = entry + d_dir * target_R * stop_atr * av[i]
            ex, xi, rs = _walk(h, l, c, i + 1, eod, d_dir, entry, stop, tgt)
            rows.append((t[i], t[xi], d_dir, entry, ex, d_dir * (ex - entry), rs, "limit" if mode == "revert" else "market"))
    return _mk(rows)


def rsi_meanrev(df, n=2, lo=10, hi=90, trend_ma=50, target="ma", stop_atr=2.0, atr_n=14,
                window=(RTH_OPEN + 15, RTH_CLOSE - 15), **_):
    """Connors-style RSI(2) mean reversion, filtered by trend MA. Long when RSI<lo & price>trendMA."""
    rows = []
    for d, g in _iter_days(df):
        r = rsi(g["close"], n)
        tm = g["close"].rolling(trend_ma).mean()
        a = atr(g, atr_n)
        h, l, c, mod = (g[x].to_numpy() for x in ("high", "low", "close", "mod"))
        rv, tmv, av = r.to_numpy(), tm.to_numpy(), a.to_numpy(); t = g.index; eod = len(g) - 1
        for i in range(trend_ma + 1, len(g) - 3):
            if mod[i] < window[0] or mod[i] >= window[1] or np.isnan(av[i]) or np.isnan(tmv[i]):
                continue
            if rv[i] < lo and c[i] > tmv[i]:
                d_dir = 1; entry = c[i]
            elif rv[i] > hi and c[i] < tmv[i]:
                d_dir = -1; entry = c[i]
            else:
                continue
            stop = entry - d_dir * stop_atr * av[i]
            tgt = tmv[i] if target == "ma" else entry + d_dir * 2 * stop_atr * av[i]
            ex, xi, rs = _walk(h, l, c, i + 1, eod, d_dir, entry, stop, tgt)
            rows.append((t[i], t[xi], d_dir, entry, ex, d_dir * (ex - entry), rs, "limit"))
    return _mk(rows)


def donchian(df, n=20, target_R=2.0, stop_atr=1.5, atr_n=14, window=(RTH_OPEN, RTH_CLOSE - 20), **_):
    """N-bar Donchian breakout (Turtle / Qullamaggie intraday-proxy / momentum breakout)."""
    rows = []
    for d, g in _iter_days(df):
        hh = g["high"].rolling(n).max().shift(1)
        ll = g["low"].rolling(n).min().shift(1)
        a = atr(g, atr_n)
        h, l, c, mod = (g[x].to_numpy() for x in ("high", "low", "close", "mod"))
        hh_, ll_, av = hh.to_numpy(), ll.to_numpy(), a.to_numpy(); t = g.index; eod = len(g) - 1
        traded = False
        for i in range(n + 1, len(g) - 3):
            if mod[i] < window[0] or mod[i] >= window[1] or np.isnan(av[i]) or np.isnan(hh_[i]):
                continue
            if h[i] >= hh_[i]:
                d_dir = 1; entry = hh_[i]
            elif l[i] <= ll_[i]:
                d_dir = -1; entry = ll_[i]
            else:
                continue
            rr = stop_atr * av[i]
            if rr <= 0:
                continue
            stop = entry - d_dir * rr; target = entry + d_dir * target_R * rr
            ex, xi, rs = _walk(h, l, c, i, eod, d_dir, entry, stop, target)
            rows.append((t[i], t[xi], d_dir, entry, ex, d_dir * (ex - entry), rs, "market"))
            traded = True
            if traded:   # one breakout/day keeps it comparable
                break
    return _mk(rows)


def inside_bar(df, mode="strat212", target_R=2.0, stop_mode="mother", window=(RTH_OPEN + 5, RTH_CLOSE - 10), **_):
    """Inside-bar break / TheStrat 2-1-2. Bar i is inside bar i-1; break of i's range -> go."""
    rows = []
    for d, g in _iter_days(df):
        h, l, c, o, mod = (g[x].to_numpy() for x in ("high", "low", "close", "open", "mod"))
        t = g.index; eod = len(g) - 1
        for i in range(2, len(g) - 3):
            if mod[i] < window[0] or mod[i] >= window[1]:
                continue
            inside = h[i] <= h[i - 1] and l[i] >= l[i - 1]
            if not inside:
                continue
            # break of inside bar's high/low on next bars
            for j in range(i + 1, min(i + 6, len(g))):
                if h[j] >= h[i]:
                    d_dir = 1; entry = h[i]; brk = j; break
                if l[j] <= l[i]:
                    d_dir = -1; entry = l[i]; brk = j; break
            else:
                continue
            stop = l[i] if d_dir > 0 else h[i]
            risk = abs(entry - stop)
            if risk <= 0:
                continue
            target = entry + d_dir * target_R * risk
            ex, xi, rs = _walk(h, l, c, brk, eod, d_dir, entry, stop, target)
            rows.append((t[brk], t[xi], d_dir, entry, ex, d_dir * (ex - entry), rs, "market"))
    return _mk(rows)


def nbar_reversal(df, nbars=3, target_R=1.5, stop_atr=1.5, atr_n=14, window=(RTH_OPEN + 5, RTH_CLOSE - 10), **_):
    """N consecutive down(up) closes then reverse bar -> fade (Velez 2-bar/3-bar reversal)."""
    rows = []
    for d, g in _iter_days(df):
        a = atr(g, atr_n)
        h, l, c, o, mod = (g[x].to_numpy() for x in ("high", "low", "close", "open", "mod"))
        av = a.to_numpy(); t = g.index; eod = len(g) - 1
        for i in range(nbars + 1, len(g) - 3):
            if mod[i] < window[0] or mod[i] >= window[1] or np.isnan(av[i]):
                continue
            downs = all(c[i - k] < o[i - k] for k in range(1, nbars + 1))
            ups = all(c[i - k] > o[i - k] for k in range(1, nbars + 1))
            if downs and c[i] > o[i]:          # reversal up bar
                d_dir = 1; entry = c[i]
            elif ups and c[i] < o[i]:
                d_dir = -1; entry = c[i]
            else:
                continue
            rr = stop_atr * av[i]
            stop = entry - d_dir * rr; target = entry + d_dir * target_R * rr
            ex, xi, rs = _walk(h, l, c, i + 1, eod, d_dir, entry, stop, target)
            rows.append((t[i], t[xi], d_dir, entry, ex, d_dir * (ex - entry), rs, "market"))
    return _mk(rows)


def momentum_pullback(df, impulse_pct=0.15, target_R=2.0, stop_atr=1.5, atr_n=14,
                      window=(RTH_OPEN, RTH_OPEN + 120), pull_bars=3, **_):
    """Impulse + first shallow pullback continuation (Warrior micro-pullback / ABCD /
    bull-flag / gap-and-go proxy). Impulse = strong run off the open; enter on the
    first 1-3 bar pullback that holds, in the impulse direction."""
    rows = []
    for d, g in _iter_days(df):
        a = atr(g, atr_n)
        h, l, c, o, mod = (g[x].to_numpy() for x in ("high", "low", "close", "open", "mod"))
        av = a.to_numpy(); t = g.index; eod = len(g) - 1
        traded = False
        for i in range(6, len(g) - 5):
            if traded:
                break
            if mod[i] < window[0] or mod[i] >= window[1] or np.isnan(av[i]):
                continue
            run = c[i] - c[i - 5]
            thr = impulse_pct / 100 * c[i]
            if run > thr:       # up impulse -> buy first pullback
                # pullback: pull_bars of lower highs, then a bar closes back up
                if all(h[i - k] >= h[i - k + 1] for k in range(1, 1)) or True:
                    if c[i] > o[i] and l[i] < l[i - 1]:   # small dip then up close
                        d_dir = 1; entry = c[i]
                    else:
                        continue
                else:
                    continue
            elif run < -thr:
                if c[i] < o[i] and h[i] > h[i - 1]:
                    d_dir = -1; entry = c[i]
                else:
                    continue
            else:
                continue
            rr = stop_atr * av[i]
            if rr <= 0:
                continue
            stop = entry - d_dir * rr; target = entry + d_dir * target_R * rr
            ex, xi, rs = _walk(h, l, c, i + 1, eod, d_dir, entry, stop, target)
            rows.append((t[i], t[xi], d_dir, entry, ex, d_dir * (ex - entry), rs, "market"))
            traded = True
    return _mk(rows)


def open_bias(df, ref="midnight_open", hold_to=RTH_CLOSE - 1, ctx=None, target_R=None,
              entry_mod=RTH_OPEN, **_):
    """Directional bias from price vs a reference (ICT midnight-open / prev-close):
    if 09:30 price > ref -> long for the session (buy program), else short. Hold to EOD."""
    if ctx is None:
        ctx = day_context(df)
    rows = []
    for d, g in _iter_days(df):
        levels = ctx.get(d, {})
        refv = levels.get(ref if ref != "pdc" else "pdc")
        if refv is None or (isinstance(refv, float) and np.isnan(refv)):
            continue
        h, l, c, mod = (g[x].to_numpy() for x in ("high", "low", "close", "mod"))
        t = g.index; eod = len(g) - 1
        ent = np.where(mod >= entry_mod)[0]
        if len(ent) == 0:
            continue
        i = ent[0]
        d_dir = 1 if c[i] > refv else -1
        entry = c[i]
        ex = c[eod]
        rows.append((t[i], t[eod], d_dir, entry, ex, d_dir * (ex - entry), "eod", "market"))
    return _mk(rows)


def pivot_trade(df, level="S1", mode="bounce", target="P", stop_frac=0.5, ctx=None,
                window=(RTH_OPEN, RTH_CLOSE - 20), atr_n=14, target_R=1.5, stop_atr=1.5, **_):
    """Floor/Camarilla pivot bounce or breakout. Touch a pivot level -> bounce toward P,
    or break it -> continuation."""
    if ctx is None:
        ctx = day_context(df)
    rows = []
    for d, g in _iter_days(df):
        levels = ctx.get(d, {})
        lv = levels.get(level)
        if lv is None or np.isnan(lv):
            continue
        a = atr(g, atr_n)
        h, l, c, mod = (g[x].to_numpy() for x in ("high", "low", "close", "mod"))
        av = a.to_numpy(); t = g.index; eod = len(g) - 1
        support = level.startswith("S") or level.startswith("cam_l")
        for i in range(2, len(g) - 3):
            if mod[i] < window[0] or mod[i] >= window[1] or np.isnan(av[i]):
                continue
            if mode == "bounce":
                if support and l[i] <= lv and c[i] > lv:
                    d_dir = 1; entry = c[i]
                elif (not support) and h[i] >= lv and c[i] < lv:
                    d_dir = -1; entry = c[i]
                else:
                    continue
                tgt = levels.get(target, entry + d_dir * target_R * stop_atr * av[i])
                stop = entry - d_dir * stop_atr * av[i]
            else:  # breakout
                if h[i] >= lv and c[i] > lv and c[i - 1] <= lv:
                    d_dir = 1; entry = lv
                elif l[i] <= lv and c[i] < lv and c[i - 1] >= lv:
                    d_dir = -1; entry = lv
                else:
                    continue
                stop = entry - d_dir * stop_atr * av[i]; tgt = entry + d_dir * target_R * stop_atr * av[i]
            ex, xi, rs = _walk(h, l, c, i, eod, d_dir, entry, stop, tgt if tgt else None)
            rows.append((t[i], t[xi], d_dir, entry, ex, d_dir * (ex - entry), rs, "limit"))
            break
    return _mk(rows)


def fvg_entry(df, kz=(RTH_OPEN, RTH_OPEN + 90), disp_atr=1.2, target_R=2.0, stop_atr=1.0,
              atr_n=14, ctx=None, **_):
    """ICT fair-value-gap entry (proxy). In the killzone, a displacement bar (range >
    disp_atr*ATR) creates a gap between bar[i-1] and bar[i+1]; enter on retrace into the
    gap, in the displacement direction; stop beyond gap; target R multiple."""
    rows = []
    for d, g in _iter_days(df):
        a = atr(g, atr_n)
        h, l, c, o, mod = (g[x].to_numpy() for x in ("high", "low", "close", "open", "mod"))
        av = a.to_numpy(); t = g.index; eod = len(g) - 1
        traded = False
        for i in range(2, len(g) - 6):
            if traded:
                break
            if mod[i] < kz[0] or mod[i] >= kz[1] or np.isnan(av[i]) or av[i] <= 0:
                continue
            rng = h[i] - l[i]
            if rng < disp_atr * av[i]:
                continue
            up = c[i] > o[i]
            if up and l[i + 1] > h[i - 1]:        # bullish FVG between i-1 high and i+1 low
                gap_hi, gap_lo = l[i + 1], h[i - 1]
                d_dir = 1
            elif (not up) and h[i + 1] < l[i - 1]:  # bearish FVG
                gap_hi, gap_lo = l[i - 1], h[i + 1]
                d_dir = -1
            else:
                continue
            entry = gap_hi if d_dir > 0 else gap_lo   # enter at gap edge on retrace
            # wait for retrace into gap
            fill = None
            for j in range(i + 2, min(i + 12, len(g))):
                if d_dir > 0 and l[j] <= entry:
                    fill = j; break
                if d_dir < 0 and h[j] >= entry:
                    fill = j; break
            if fill is None:
                continue
            rr = stop_atr * av[i]
            stop = (gap_lo - 0) if d_dir > 0 else (gap_hi + 0)
            if abs(entry - stop) < 1e-6:
                stop = entry - d_dir * rr
            target = entry + d_dir * target_R * abs(entry - stop)
            ex, xi, rs = _walk(h, l, c, fill, eod, d_dir, entry, stop, target)
            rows.append((t[fill], t[xi], d_dir, entry, ex, d_dir * (ex - entry), rs, "limit"))
            traded = True
    return _mk(rows)


def range_break(df, hi_key="asia_hi", lo_key="asia_lo", target_R=2.0, stop_mode="other",
                stop_atr=1.5, atr_n=14, ctx=None, window=(RTH_OPEN, RTH_OPEN + 150), **_):
    """Two-sided breakout of a reference range (Asian range / London range / PDH-PDL /
    opening range) taken during the NY session. Covers London-breakout, Asian-range
    expansion, PDH/PDL breakout. Entry at the level; stop = other side (or ATR)."""
    if ctx is None:
        ctx = day_context(df)
    rows = []
    for d, g in _iter_days(df):
        lv = ctx.get(d, {})
        hi, lo = lv.get(hi_key), lv.get(lo_key)
        if hi is None or lo is None or np.isnan(hi) or np.isnan(lo) or hi <= lo:
            continue
        a = atr(g, atr_n)
        h, l, c, mod = (g[x].to_numpy() for x in ("high", "low", "close", "mod"))
        av = a.to_numpy(); t = g.index; eod = len(g) - 1
        span = hi - lo
        for i in range(1, len(g) - 3):
            if mod[i] < window[0] or mod[i] >= window[1]:
                continue
            if c[i] > hi and c[i - 1] <= hi:
                d_dir, entry = 1, hi
            elif c[i] < lo and c[i - 1] >= lo:
                d_dir, entry = -1, lo
            else:
                continue
            risk = span if stop_mode == "other" else stop_atr * (av[i] if not np.isnan(av[i]) else span)
            if risk <= 0:
                continue
            stop = entry - d_dir * risk
            target = entry + d_dir * target_R * risk
            ex, xi, rs = _walk(h, l, c, i, eod, d_dir, entry, stop, target)
            rows.append((t[i], t[xi], d_dir, entry, ex, d_dir * (ex - entry), rs, "market"))
            break
    return _mk(rows)


def range_fade(df, hi_key="R1", lo_key="S1", target_key="P", stop_atr=1.5, atr_n=14,
               ctx=None, window=(RTH_OPEN, RTH_CLOSE - 20), target_R=1.5, **_):
    """Two-sided fade at reference levels back toward a target level (Camarilla H3/L3
    reversal, floor-pivot S1/R1 fade, CBDR SD fade)."""
    if ctx is None:
        ctx = day_context(df)
    rows = []
    for d, g in _iter_days(df):
        lv = ctx.get(d, {})
        hi, lo, tgt = lv.get(hi_key), lv.get(lo_key), lv.get(target_key)
        if hi is None or lo is None or np.isnan(hi) or np.isnan(lo):
            continue
        a = atr(g, atr_n)
        h, l, c, mod = (g[x].to_numpy() for x in ("high", "low", "close", "mod"))
        av = a.to_numpy(); t = g.index; eod = len(g) - 1
        for i in range(2, len(g) - 3):
            if mod[i] < window[0] or mod[i] >= window[1] or np.isnan(av[i]):
                continue
            if h[i] >= hi and c[i] < hi:            # tag resistance -> short toward target
                d_dir, entry = -1, c[i]
                tprice = tgt if (tgt is not None and not np.isnan(tgt)) else entry - target_R * stop_atr * av[i]
            elif l[i] <= lo and c[i] > lo:          # tag support -> long
                d_dir, entry = 1, c[i]
                tprice = tgt if (tgt is not None and not np.isnan(tgt)) else entry + target_R * stop_atr * av[i]
            else:
                continue
            stop = entry - d_dir * stop_atr * av[i]
            ex, xi, rs = _walk(h, l, c, i + 1, eod, d_dir, entry, stop, tprice)
            rows.append((t[i], t[xi], d_dir, entry, ex, d_dir * (ex - entry), rs, "limit"))
            break
    return _mk(rows)


