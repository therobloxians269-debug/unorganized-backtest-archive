import yfinance as yf
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

def run_final_strategy():
    # 1. Download Data
    df = yf.download('MES=F', period='2y', interval='1h', auto_adjust=True)
    if isinstance(df.columns, pd.MultiIndex):
        df.columns = df.columns.get_level_values(0)

    # 2. Indicators
    df['Log_Ret'] = np.log(df['Close'] / df['Close'].shift(1))
    tr = pd.concat([
        (df['High'] - df['Low']),
        abs(df['High'] - df['Close'].shift()),
        abs(df['Low'] - df['Close'].shift())
    ], axis=1).max(axis=1)
    
    df['ATR'] = tr.rolling(14).mean()
    df['Signal_Score'] = (df['Log_Ret'].rolling(20).mean() / df['Log_Ret'].rolling(20).std()).shift(1)
    df['Lagged_ATR'] = df['ATR'].shift(1)
    df['Hour_UTC'] = df.index.hour
    df.dropna(inplace=True)

    # 3. Backtest Parameters
    bal = 1000.0
    comm = 1.40
    slip = 0.25
    mult = 5.0
    sig_th = 0.45
    risk_pct = 0.015
    
    history = []
    pos, ent, qty = 0, 0.0, 0

    # 4. Engine
    for i in range(len(df)):
        p = df['Close'].values[i]
        s = df['Signal_Score'].values[i]
        atr = df['Lagged_ATR'].values[i]
        hour = df['Hour_UTC'].values[i]
        
        # Exit
        if pos != 0:
            pnl = (p - ent) if pos == 1 else (ent - p)
            if (pos == 1 and s < -0.1) or (pos == -1 and s > 0.1) or (abs(pnl) > 3.5 * atr):
                bal += (pnl * mult * qty) - (qty * comm)
                pos = 0

        # Entry (US Session only)
        if pos == 0 and (hour >= 14 and hour <= 20):
            if abs(s) > sig_th:
                qty = max(1, int((bal * risk_pct) / (atr * mult)))
                pos = 1 if s > sig_th else -1
                ent = p + slip if pos == 1 else p - slip
        
        history.append(bal)

    # 5. Output
    print(f'Final Balance: ${bal:,.2f}')
    plt.figure(figsize=(10, 5))
    plt.plot(df.index, history, color='teal')
    plt.title('Final Session-Aware Strategy Equity Curve')
    plt.ylabel('Account Balance ($)')
    plt.grid(True, alpha=0.3)
    plt.show()

run_final_strategy()

