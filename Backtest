# ================================================================ ENGINE
def prep(d):
    """numpy views + per-bar bookkeeping for the trade engine"""
    P = {}
    P['o'] = d['o'].to_numpy(float); P['h'] = d['h'].to_numpy(float)
    P['l'] = d['l'].to_numpy(float); P['c'] = d['c'].to_numpy(float)
    P['atr15'] = d['atr15'].to_numpy(float)
    P['atr30'] = d['atr30'].to_numpy(float)
    hm = (d.index.hour * 60 + d.index.minute).to_numpy()
    P['hm'] = hm
    cal = d.index.normalize()
    P['cal'] = cal.astype('int64').to_numpy()
    # last bar of each calendar day at or before 16:59 -> hard flat point
    flat_ok = hm <= 16 * 60 + 59
    dfi = pd.DataFrame({'cal': P['cal'], 'i': np.arange(len(d)), 'ok': flat_ok})
    last = dfi[dfi.ok].groupby('cal')['i'].max()
    P['flat_idx'] = dfi['cal'].map(last).to_numpy()          # nan if none
    P['daycycle'] = d['daycycle'].to_numpy()
    P['idx'] = d.index
    for a in ANCHORS:
        P['vwap_' + a] = d['vwap_' + a].to_numpy(float)
        P['sd_' + a] = d['sd_' + a].to_numpy(float)
        P['nb_' + a] = d['nbar_' + a].to_numpy(float)
    return P


def resolve(P, ent, dirs, stops, targs, maxhold, slip, comm, pv):
    """Walk each trade forward. Stop-first if both touched in one bar.
    Exits: stop / target / max-hold / 16:59 flat."""
    o, h, l, c = P['o'], P['h'], P['l'], P['c']
    n = len(o)
    out = []
    for k in range(len(ent)):
        i = ent[k]; dr = dirs[k]; sp = stops[k]; tg = targs[k]
        fl = P['flat_idx'][i]
        if not np.isfinite(fl):
            continue
        end = int(min(i + maxhold, fl, n - 1))
        if end <= i:
            continue
        e = o[i] + slip * dr                      # entry slippage adverse
        R = abs(e - sp)
        if R <= 0:
            continue
        hh = h[i:end + 1]; ll = l[i:end + 1]
        if dr > 0:
            hit_s = ll <= sp
            hit_t = hh >= tg
        else:
            hit_s = hh >= sp
            hit_t = ll <= tg
        is_ = np.argmax(hit_s) if hit_s.any() else 10 ** 9
        it_ = np.argmax(hit_t) if hit_t.any() else 10 ** 9
        if is_ <= it_ and is_ < 10 ** 9:
            px = sp - slip * dr                   # stop slippage adverse
            xi = i + is_; why = 'stop'
        elif it_ < 10 ** 9:
            px = tg; xi = i + it_; why = 'targ'
        else:
            px = c[end]; xi = end; why = 'time'
        pts = (px - e) * dr
        usd = pts * pv - comm
        out.append((i, xi, dr, e, px, R, pts, usd, usd / (R * pv), why))
    cols = ['i', 'xi', 'dir', 'entry', 'exit', 'R_pts', 'pts', 'usd', 'R', 'why']
    return pd.DataFrame(out, columns=cols)


def gen_signals(P, cfg):
    """Vectorised, fully causal signal generation.
    z is evaluated on the CLOSE of bar t; entry is the OPEN of bar t+1."""
    a = cfg['anchor']
    vw = P['vwap_' + a]; sd = P['sd_' + a]; nb = P['nb_' + a]
    c = P['c']; hm = P['hm']
    z = (c - vw) / np.where(sd > 0, sd, np.nan)
    warm = nb >= cfg['warm']
    win = (hm >= cfg['t0']) & (hm <= cfg['t1'])
    ok = warm & win & np.isfinite(z) & np.isfinite(P['atr15']) & (P['atr15'] > 0)
    Z = cfg['Z']
    zp = np.nan_to_num(z, nan=0.0)
    if cfg['trig'] == 'fade':
        # first cross OUT beyond the band -> fade back toward vwap
        up = ok & (zp >= Z) & np.r_[False, zp[:-1] < Z]
        dn = ok & (zp <= -Z) & np.r_[False, zp[:-1] > -Z]
        sig = np.where(up, -1, np.where(dn, 1, 0))
    elif cfg['trig'] == 'cont':
        up = ok & (zp >= Z) & np.r_[False, zp[:-1] < Z]
        dn = ok & (zp <= -Z) & np.r_[False, zp[:-1] > -Z]
        sig = np.where(up, 1, np.where(dn, -1, 0))
    elif cfg['trig'] == 'reject':
        # went beyond band then came back INSIDE  -> classic rejection fade
        up = ok & (zp < Z) & np.r_[False, zp[:-1] >= Z]
        dn = ok & (zp > -Z) & np.r_[False, zp[:-1] <= -Z]
        sig = np.where(up, -1, np.where(dn, 1, 0))
    elif cfg['trig'] == 'reclaim':
        # cross back through VWAP after being beyond the band on this side
        beyond_dn = pd.Series(zp <= -Z).groupby(pd.Series(P['cal'])).cummax().to_numpy()
        beyond_up = pd.Series(zp >= Z).groupby(pd.Series(P['cal'])).cummax().to_numpy()
        xu = ok & (zp > 0) & np.r_[False, zp[:-1] <= 0] & beyond_dn
        xd = ok & (zp < 0) & np.r_[False, zp[:-1] >= 0] & beyond_up
        sig = np.where(xu, 1, np.where(xd, -1, 0))
    else:
        raise ValueError(cfg['trig'])
    idx = np.flatnonzero(sig != 0)
    idx = idx[idx + 1 < len(c)]
    return idx, sig[idx], z, vw, sd


def run_cfg(P, cfg, pv, comm, slip, maxtrades=2):
    idx, side, z, vw, sd = gen_signals(P, cfg)
    if len(idx) == 0:
        return pd.DataFrame()
    ent = idx + 1                                  # NEXT bar open
    dr = side
    atr = P['atr15'][idx]
    eo = P['o'][ent]
    # ---- stop
    if cfg['stopmode'] == 'atr':
        sdist = cfg['stopk'] * atr
    elif cfg['stopmode'] == 'band':
        # stop measured in VWAP-sigma units (band-relative rather than ATR)
        sdist = np.abs(cfg['stopk'] * sd[idx])
    else:
        raise ValueError
    sdist = np.maximum(sdist, 0.25)
    stop = eo - dr * sdist
    # ---- target
    if cfg['tmode'] == 'rr':
        targ = eo + dr * cfg['rr'] * sdist
    elif cfg['tmode'] == 'vwap':
        targ = vw[idx]
        bad = (targ - eo) * dr <= 0.25
        targ = np.where(bad, eo + dr * 0.5 * sdist, targ)
    elif cfg['tmode'] == 'mid':
        targ = vw[idx] + np.sign(z[idx]) * (cfg['Z'] / 2.0) * sd[idx]
        bad = (targ - eo) * dr <= 0.25
        targ = np.where(bad, eo + dr * 0.5 * sdist, targ)
    else:
        raise ValueError
    tr = resolve(P, ent, dr, stop, targ, cfg['hold'], slip, comm, pv)
    if len(tr) == 0:
        return tr
    tr['daycycle'] = P['daycycle'][tr['i'].to_numpy()]
    tr['ts'] = P['idx'][tr['i'].to_numpy()]
    # non-overlapping: keep first trade, then next entry only after prior exit
    keep = []
    last_x = -1
    per_day = {}
    for r in tr.itertuples():
        if r.i <= last_x:
            continue
        dcd = per_day.get(r.daycycle, 0)
        if dcd >= maxtrades:
            continue
        keep.append(r.Index); last_x = r.xi; per_day[r.daycycle] = dcd + 1
    return tr.loc[keep].reset_index(drop=True)


def stats(tr, ndays):
    if len(tr) < 10:
        return dict(n=0, avgR=np.nan, usd=np.nan, wr=np.nan, tpd=0,
                    drop3=np.nan, pf=np.nan, maxdd=np.nan, t=np.nan)
    R = tr['R'].to_numpy()
    s = np.sort(R)
    drop3 = np.nan if len(R) <= 4 else (np.sum(R) - np.sum(s[-3:])) / (len(R) - 3)
    eq = np.cumsum(tr['usd'].to_numpy())
    dd = float(np.max(np.maximum.accumulate(np.r_[0, eq]) - np.r_[0, eq]))
    g = tr['usd'][tr.usd > 0].sum(); b = -tr['usd'][tr.usd < 0].sum()
    mu, t, n, k = clustered(R, tr['daycycle'])
    return dict(n=len(R), avgR=R.mean(), usd=tr['usd'].mean(), wr=(R > 0).mean(),
                tpd=len(R) / max(ndays, 1), drop3=drop3, pf=(g / b if b > 0 else np.inf),
                maxdd=dd, t=t)


# ================================================================ stage 2 sweep
def cfg_grid():
    g = []
    for trig in ['fade', 'cont', 'reject', 'reclaim']:
        for anchor in ['a0930', 'a0600', 'a1800']:
            for Z in [1.0, 1.5, 2.0, 2.5, 3.0]:
                for stopmode, stopk in [('atr', 0.75), ('atr', 1.25), ('atr', 2.0),
                                        ('band', 0.5), ('band', 1.0)]:
                    for tmode, rr in [('rr', 1.0), ('rr', 1.5), ('rr', 2.0),
                                      ('vwap', 0), ('mid', 0)]:
                        for hold, (t0, t1) in itertools.product(
                                [60, 120, 240],
                                [(9 * 60 + 30, 15 * 60 + 30), (10 * 60, 15 * 60),
                                 (6 * 60, 15 * 60 + 30)]):
                            if trig in ('fade', 'reject') and tmode in ('vwap', 'mid'):
                                pass
                            if trig == 'cont' and tmode in ('vwap', 'mid'):
                                continue          # nonsense: target behind entry
                            g.append(dict(trig=trig, anchor=anchor, Z=Z,
                                          stopmode=stopmode, stopk=stopk,
                                          tmode=tmode, rr=rr, hold=hold,
                                          t0=t0, t1=t1, warm=30))
    return g


def sweep(P, grid, pv, comm, slip, ndays, tag):
    rows = []
    for i, cfg in enumerate(grid):
        tr = run_cfg(P, cfg, pv, comm, slip)
        st = stats(tr, ndays)
        rows.append({**cfg, **st})
        if (i + 1) % 500 == 0:
            print(f'  ...{i+1}/{len(grid)}', flush=True)
    r = pd.DataFrame(rows)
    r.to_csv(os.path.join(CACHE, f'sweep_{tag}.csv'), index=False)
    return r


