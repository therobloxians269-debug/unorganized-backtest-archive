"""
EXECUTION MODEL — turns "intended" paper trades into REALISTIC fills, so the shadow/paper P&L
reflects what you'd actually get live, not idealized close prices. Models, per fill:

  1. LATENCY slippage  — between signal (Thu close) and your order reaching the venue, price drifts.
     Modeled as a random walk over `latency_s` at the instrument's own vol (adverse on average,
     because you're chasing). E[latency cost] ~ 0.5 * sigma_per_sec * sqrt(latency_s) (one-sided).
  2. SPREAD cost       — you cross the book: pay half the bid/ask spread.
  3. MARKET IMPACT     — square-root law: impact_bps = k * sqrt(order_notional / ADV). Small orders
     (you, at $1k-$10k) are tiny vs ADV so this is ~0 for majors, real for illiquid alts.
  4. FEES              — taker fee per venue.
  5. PARTIAL FILLS     — if order > `max_fill_frac` * ADV in one bar, only part fills; the rest
     slips to the next bar (more latency cost). At your size this almost never triggers.

All costs are returned in bps and as $ so they can be subtracted from the shadow ledger directly.
Assumptions are conservative (taker-only, adverse latency) on purpose — better to under-promise.

    PYTHONPATH=/Users/kaveh/mim_research python3 execution.py   # self-test
"""
from __future__ import annotations
from dataclasses import dataclass
import numpy as np

SECONDS_PER_YEAR = 365 * 24 * 3600


@dataclass
class Venue:
    name: str
    spread_bps: float       # typical full bid/ask spread for majors on this venue
    taker_bps: float        # taker fee
    latency_s: float        # signal -> fill latency (manual placement is slow!)
    impact_k: float         # sqrt-law coefficient (bps at order=ADV)
    max_fill_frac: float    # max fraction of bar ADV you can take before partial fill

# Conservative real-world presets (manual/scripted retail execution, not colocated)
VENUES = {
    # crypto spot (Coinbase Advanced / Kraken): wider spreads on alts, ~25-35bps all-in taker round
    "crypto_spot": Venue("crypto_spot", spread_bps=8.0,  taker_bps=10.0, latency_s=20.0, impact_k=900, max_fill_frac=0.02),
    # Hyperliquid perp: tight majors, low fees, but funding venue
    "hl_perp":     Venue("hl_perp",     spread_bps=3.0,  taker_bps=3.5,  latency_s=10.0, impact_k=700, max_fill_frac=0.03),
    # CME micro futures (MES/MNQ/MYM/MCL): tight, cheap, but commission per contract matters at small size
    "cme_fut":     Venue("cme_fut",     spread_bps=1.5,  taker_bps=1.0,  latency_s=8.0,  impact_k=400, max_fill_frac=0.05),
}


def fill_cost_bps(venue: Venue, order_notional: float, ann_vol: float, adv_usd: float) -> dict:
    """Return per-fill cost breakdown in bps for a single order. ann_vol = instrument annualized vol
    (e.g. 0.8 for an alt, 0.15 for ES); adv_usd = average daily $ volume of the instrument."""
    # 1. latency: adverse half of a sqrt-time random walk at the instrument's vol
    sigma_per_s = ann_vol / np.sqrt(SECONDS_PER_YEAR)
    latency_bps = 0.5 * sigma_per_s * np.sqrt(max(venue.latency_s, 0.0)) * 1e4
    # 2. spread (cross half)
    spread_bps = venue.spread_bps / 2.0
    # 3. impact (sqrt law); negligible unless order is a real fraction of ADV
    frac = order_notional / adv_usd if adv_usd > 0 else 0.0
    impact_bps = venue.impact_k * np.sqrt(max(frac, 0.0))
    # 4. fees
    fee_bps = venue.taker_bps
    total = latency_bps + spread_bps + impact_bps + fee_bps
    return dict(latency=latency_bps, spread=spread_bps, impact=impact_bps, fee=fee_bps,
                total_bps=total, partial=frac > venue.max_fill_frac)


def apply_to_trades(trades, default_ann_vol=0.8, default_adv=5e7):
    """trades: list of dicts {sym, venue, notional, ann_vol?, adv_usd?}. Returns realized cost in $."""
    out, tot = [], 0.0
    for tr in trades:
        v = VENUES[tr["venue"]]
        c = fill_cost_bps(v, tr["notional"], tr.get("ann_vol", default_ann_vol), tr.get("adv_usd", default_adv))
        dollar = tr["notional"] * c["total_bps"] / 1e4
        tot += dollar
        out.append({**tr, **c, "cost_usd": dollar})
    return out, tot


if __name__ == "__main__":
    # self-test: a $1,000 book — typical fills
    print("EXECUTION COST SELF-TEST (one-way, per fill)\n" + "-" * 64)
    examples = [
        ("BTC alt-leg",   dict(sym="BTC", venue="hl_perp",     notional=300, ann_vol=0.55, adv_usd=2e10)),
        ("mid alt spot",  dict(sym="AVAX", venue="crypto_spot", notional=200, ann_vol=0.9,  adv_usd=2e8)),
        ("tiny alt spot", dict(sym="SAND", venue="crypto_spot", notional=120, ann_vol=1.1,  adv_usd=2e7)),
        ("MES micro fut", dict(sym="MES", venue="cme_fut",      notional=1300, ann_vol=0.15, adv_usd=5e10)),
    ]
    for lbl, tr in examples:
        c = fill_cost_bps(VENUES[tr["venue"]], tr["notional"], tr["ann_vol"], tr["adv_usd"])
        print(f"  {lbl:14s} [{tr['venue']:11s}] total {c['total_bps']:5.1f}bps "
              f"(lat {c['latency']:4.1f} + half-spread {c['spread']:4.1f} + impact {c['impact']:4.1f} + fee {c['fee']:4.1f})"
              + ("  PARTIAL" if c["partial"] else ""))
    print("-" * 64)
    print("Read: at $1k size, majors cost ~6-12bps/side, illiquid alts 15-40bps/side. This is what")
    print("gets subtracted from every shadow-ledger fill so paper P&L ~ live P&L.")

