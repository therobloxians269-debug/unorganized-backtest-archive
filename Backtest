"""How big are NQ's daily moves really, and how catchable is 300 points?"""
import numpy as np, pandas as pd, warnings; warnings.filterwarnings('ignore')
def analyse(f,tag):
    d=pd.read_parquet(f)
    m=(d.index.hour*60+d.index.minute); rth=d[(m>=570)&(m<960)].copy()
    rth['day']=rth.index.normalize()
    rows=[]
    for day,b in rth.groupby('day'):
        if len(b)<300: continue
        h=b.h.values; l=b.l.values
        rng=h.max()-l.min()
        # biggest single CLEAN directional leg (perfect entry AND perfect exit, one direction)
        up=(h-np.minimum.accumulate(l)).max()      # best long: buy the running low, sell any later high
        dn=(np.maximum.accumulate(h)-l).max()      # best short
        rows.append(dict(day=day,rng=rng,bestlong=up,bestshort=dn,best=max(up,dn)))
