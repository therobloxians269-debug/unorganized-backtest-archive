import numpy as np, pandas as pd
import microbt as M

df = M.load('/Users/kaveh/omni_x/es_front_2017_24h_1m.parquet', tf='5min')
ny = df.index.tz_convert('America/New_York')
mins = ny.hour*60 + ny.minute
date = ny.normalize()

# RTH mask 09:30-16:00
rth = (mins >= 570) & (mins < 960)

o = df['open'].to_numpy(); h=df['high'].to_numpy(); l=df['low'].to_numpy()
c = df['close'].to_numpy(); v = df['volume'].to_numpy()
tp = (h+l+c)/3.0

n = len(df)
# session vwap cumulative within RTH per day
dates = date.values
trades = []
# group indices by day
import collections
day_idx = collections.defaultdict(list)
for i in range(n):
    if rth[i]:
        day_idx[dates[i]].append(i)

for d, idxs in day_idx.items():
    idxs = sorted(idxs)
    m = mins[idxs]
    # cumulative vwap
    cum_pv = 0.0; cum_v = 0.0
    vwap = {}
    for i in idxs:
        cum_pv += tp[i]*v[i]; cum_v += v[i]
        vwap[i] = cum_pv/cum_v if cum_v>0 else c[i]
    # find signal bar = last bar with minute <= 660 (11:00). Signal at 11:00 -> the 10:55 bar closes at 11:00? bars are 5min label=left, closed=left. bar at 10:55 covers 10:55-11:00. We want decision at 11:00 using bar whose close is at 11:00 = the 10:55 bar. entry next bar = 11:00 bar.
    # signal bar: minute==655 (10:55) -> close at 11:00. entry bar minute==660 (11:00).
    sig = [i for i in idxs if mins[i]==655]
    ent = [i for i in idxs if mins[i]==660]
    exit_bars = [i for i in idxs if mins[i]==955]  # 15:55 bar closes at 16:00
    if not sig or not ent or not exit_bars: continue
    sb = sig[0]; eb = ent[0]; xb = exit_bars[0]
    if eb <= sb or xb < eb: continue
    dir = 1 if c[sb] > vwap[sb] else -1
    trades.append((eb, xb, dir))

r = M.evaluate(df, trades, name='vwap-side-persist')
M.show(r)
yrs = (df.index[-1]-df.index[0]).days/365.25
print('trades_per_yr', round(len(trades)/yrs,1), 'raw_trades', len(trades))
