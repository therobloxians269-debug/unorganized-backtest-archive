        "roll24 median": rs24.median(),
        "mo avg%": m.mean() * 100, "mo std%": m.std() * 100, "mo %pos": (m > 0).mean() * 100,
        "best mo%": m.max() * 100, "worst mo%": m.min() * 100,
        "skew": float(skew(m)), "kurtosis": float(kurtosis(m)),
        "VaR95%": np.percentile(m, 5) * 100, "CVaR95%": m[m <= np.percentile(m, 5)].mean() * 100,
        "VaR99%": np.percentile(m, 1) * 100, "CVaR99%": m[m <= np.percentile(m, 1)].mean() * 100,
        "ret%C1": rc_ret["C1"] * 100, "ret%M": rc_ret["M"] * 100, "ret%T": rc_ret["T"] * 100,
        "risk%C1": rc_risk["C1"] * 100, "risk%M": rc_risk["M"] * 100, "risk%T": rc_risk["T"] * 100,
        "OOS 20-23": a, "OOS 24-26": b,
