# 2. TRADE ENGINE (numba)
# ============================================================================
@njit(cache=True)
def _sim(o, h, l, c, entry_pos, direction, R0, tgt, day_end, slip):
    """returns (exit_pos, pts, hitcode) hitcode 0=stop 1=targ 2=time"""
    e = o[entry_pos] + direction * slip
    stop = e - direction * R0
    targ = e + direction * tgt * R0
    for j in range(entry_pos, day_end + 1):
        if direction == 1:
            if l[j] <= stop:
                return j, (stop - slip) - e, 0
            if h[j] >= targ:
                return j, targ - e, 1
        else:
            if h[j] >= stop:
                return j, e - (stop + slip), 0
            if l[j] <= targ:
                return j, e - targ, 1
    px = c[day_end]
    return day_end, direction * (px - e), 2


@njit(cache=True)
def run_book(o, h, l, c, vwap, cmax, cmin, start, sig_start, day_end,
             R0, tgt, ext, cool, max_tr, book, slip,
             out_pos, out_dir, out_pts, out_hit, out_exit):
    """book 0 = TREND (break of running session range), 1 = MR (fade VWAP extension)."""
    n = 0
    j = sig_start
    while j < day_end and n < max_tr:
        sig = 0
        if book == 0:
            if c[j] > cmax[j - 1]:
                sig = 1
            elif c[j] < cmin[j - 1]:
                sig = -1
        else:
            d = c[j] - vwap[j]
            if d >= ext * R0:
                sig = -1
            elif d <= -ext * R0:
                sig = 1
        if sig != 0 and (j + 1) <= day_end:
            ep = j + 1
            xp, pts, hc = _sim(o, h, l, c, ep, sig, R0, tgt, day_end, slip)
            out_pos[n] = ep; out_dir[n] = sig; out_pts[n] = pts
            out_hit[n] = hc; out_exit[n] = xp
            n += 1
            j = xp + cool
        else:
            j += 1
    return n


def gen_trades(df, sess, cfg, pv, comm, book):
    """sess: list of (start_pos, day_end_pos, R0). Returns DataFrame of trades."""
    o = df["o"].values.astype(np.float64); h = df["h"].values.astype(np.float64)
    l = df["l"].values.astype(np.float64); c = df["c"].values.astype(np.float64)
    v = df["v"].values.astype(np.float64)
    or_min = cfg["or_min"]; tgt = cfg["tgt"]; ext = cfg["ext"]
    cool = cfg["cool"]; max_tr = cfg["max_tr"]
    MX = max_tr + 2
    op = np.empty(MX, np.int64); od = np.empty(MX, np.int64)
    opt = np.empty(MX, np.float64); oh = np.empty(MX, np.int64); ox = np.empty(MX, np.int64)
    recs = []
    for si, (s, de, R0, sid) in enumerate(sess):
        seg = slice(s, de + 1)
        oo = o[seg]; hh = h[seg]; ll = l[seg]; cc = c[seg]; vv = v[seg]
        tp = (hh + ll + cc) / 3.0
        cv = np.cumsum(vv); cpv = np.cumsum(tp * vv)
        vw = np.where(cv > 0, cpv / np.maximum(cv, 1e-9), cc)
        cmx = np.maximum.accumulate(hh); cmn = np.minimum.accumulate(ll)
        m = len(cc) - 1
        sig_start = or_min
        if sig_start >= m: continue
        n = run_book(oo, hh, ll, cc, vw, cmx, cmn, 0, sig_start, m,
                     R0, tgt, ext, cool, max_tr, book, SLIP, op, od, opt, oh, ox)
        for q in range(n):
            usd = opt[q] * pv - comm
            recs.append((sid, si, s + op[q], od[q], opt[q], usd,
                         usd / (R0 * pv), oh[q], s + ox[q], R0))
    return pd.DataFrame(recs, columns=["sid", "si", "epos", "dir", "pts", "usd",
                                       "R", "hit", "xpos", "R0"])


