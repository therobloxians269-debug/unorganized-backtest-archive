"""
THE STRETCH · S1 — discovery on NQ 2023, confirmation on NQ 2024-25 and MNQ 2026.

⚠️ SAMPLE IS THIN. Aligned two-leg data only exists from 2022-12 (NQ) and 2026 (MNQ).
   TRAIN 2023 (~237 sessions) / DEV 2024-25 (~480) / HOLDOUT 2026 (~83). Stated up
   front so no result here gets read as if it had 16 years behind it.

Pre-registered gates:
  1. MONOTONE in |z| — a bigger stretch must close harder. Flat = no mechanism.
  2. BEATS ITS OWN INVERSE — 'go with the stretch' must not pay the same. This is
     where SMT divergence landed, so it is the gate that matters most.
  3. SHUFFLE NULL -> zero.
  4. The SINGLE-LEG NQ trade must survive costs, and must beat trading NQ
     unconditionally at the same clock time.
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')
import data as D, stretch as ST, sim as S

rng = np.random.default_rng(53)


def prep(which):
    d = D.load(which)
    D.check_es_alignment(d, which)
    fr = ST.session_frames(d)
    bt = ST.rolling_beta(fr)
    sd = ST.spreads(fr, bt)
    return ST.normalise(sd), fr


def leg_trade(sd, which, t_entry, z_thr, mode='fade'):
    """One trade per session at a FIXED clock time. Single leg: NQ only."""
    cost = S.COST_PTS[which]; pv = S.PT_VALUE[which]
    g = sd[(sd.t == t_entry) & (sd.z.abs() >= z_thr)].copy()
    out = []
    for _, q in g.iterrows():
        sgn = -np.sign(q.z) if mode == 'fade' else np.sign(q.z)
        if sgn == 0:
            continue
        # d_nq is a log return of the NQ leg to the close
        pts = sgn * q.d_nq * q.px - cost
        out.append(dict(day=q.day, z=q.z, side='long' if sgn > 0 else 'short',
                        pts=pts, usd=pts * pv))
    return pd.DataFrame(out)


def show(t, label, nd):
    if not len(t):
        print(f'  {label:<32} n=0'); return
    mu, tt, n = ST.dayt(t.pts)
    print(f'  {label:<32} n={n:>4}  {n/max(nd,1):.2f}/day  {mu:>+8.3f} pts  '
          f't {tt:>+6.2f}  WR {(t.pts>0).mean():>5.1%}  ${t.usd.mean():>+8.2f}/tr  '
          f'${t.usd.sum():>+9.0f}')


if __name__ == '__main__':
    print('THE STRETCH · S1 — NQ vs ES relative value, clock-fixed entry')
    print('=' * 100)
    sd_nq, fr_nq = prep('NQ')
    sd_mnq, fr_mnq = prep('MNQ')
    tr = sd_nq[sd_nq.day <= '2023-12-31']
    dv = sd_nq[sd_nq.day >= '2024-01-01']
    print(f'  TRAIN  NQ {tr.day.min().date()}..{tr.day.max().date()}  {tr.day.nunique()} sessions')
    print(f'  DEV    NQ {dv.day.min().date()}..{dv.day.max().date()}  {dv.day.nunique()} sessions')
    print(f'  HOLD  MNQ {sd_mnq.day.min().date()}..{sd_mnq.day.max().date()}  '
          f'{sd_mnq.day.nunique()} sessions')
    print(f'  beta NQ~ES: median {sd_nq.beta.median():.3f}  '
          f'range {sd_nq.beta.min():.2f}-{sd_nq.beta.max():.2f}')

    print(f'\n{"-"*100}\n  GATE 1 — does a bigger stretch close harder? (TRAIN, all clock times)'
          f'\n{"-"*100}')
