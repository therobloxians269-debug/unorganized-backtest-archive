"""Adversarial controls for the engine. If these don't behave, the 0/130 verdict is suspect.

C1 PLACEBO   : random entries should net ~ -friction (no edge), PF~1, |Sharpe|~0.
C2 FORESIGHT : trade the KNOWN end-of-day direction -> must be hugely positive (plumbing/sign).
C3 CAUSALITY : every trade must exit at or after entry; entries never use future bars.
C4 FRIC MATH : net == gross - friction, exactly.
"""
import numpy as np, pandas as pd
from data import load, rth
from specs import SPECS, friction_usd, usd
from engine import run, metrics

rng = np.random.RandomState(7)


def random_strategy(df, **_):
    from families import _mk, _iter_days
    rows = []
    for d, g in _iter_days(df):
        h, l, c = (g[x].to_numpy() for x in ("high", "low", "close"))
        t = g.index; n = len(g)
        i = rng.randint(0, n - 5); eod = n - 1
        dd = 1 if rng.rand() > 0.5 else -1
        entry, ex = c[i], c[eod]
        rows.append((t[i], t[eod], dd, entry, ex, dd * (ex - entry), "eod", "market"))
    return _mk(rows)


def foresight_strategy(df, **_):
    from families import _mk, _iter_days
    rows = []
    for d, g in _iter_days(df):
        o, c = g["open"].to_numpy(), g["close"].to_numpy()
        t = g.index; eod = len(g) - 1
        dd = 1 if c[eod] > o[0] else -1          # look-ahead ON PURPOSE (control)
        entry, ex = o[0], c[eod]
        rows.append((t[0], t[eod], dd, entry, ex, dd * (ex - entry), "eod", "market"))
    return _mk(rows)


def score(name, fn):
    from families import FAMILIES
    FAMILIES[name] = fn
    tr = run("MES", name, {})
    m = metrics(tr, "MES", name)
    return m, tr


print("=" * 62)
