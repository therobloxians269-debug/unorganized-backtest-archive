"""Stage 1 microstructure probe: does order-flow imbalance (OFI) predict short-horizon
MES/ES returns? Fast, vectorized, trades-only (no book reconstruction).

For each day: front-month outright trades -> 1s bars with signed volume (aggressor side).
Build OFI over rolling windows, measure information coefficient (IC) vs forward returns at
several horizons, pooled and per-day (stability), RTH only. Also validate the aggressor
`side` field against the tick test, and print a quintile forward-return table for the best
signal. This is a GO/NO-GO gate before building the heavy L3 book pipeline.

    PYTHONPATH=. python3 research/flow_alpha.py
"""
from __future__ import annotations

import glob

import numpy as np
import pandas as pd
import databento as db

TRADES_GLOB = "GLBX-20260606-FLPFMNB88A/*.trades.dbn.zst"
BAR = "1s"
WINDOWS = [10, 30, 60]        # OFI lookback, seconds
HORIZONS = [30, 60, 300]      # forward-return horizon, seconds
RTH = ("13:30", "20:00")      # ES regular session in UTC (EDT: 09:30-16:00 ET)


def load_day_bars(path):
    df = db.DBNStore.from_file(path).to_df()
    df = df[(df["action"] == "T") & df["side"].isin(["A", "B"])]
    # front-month outright = most-traded single contract (exclude calendar spreads w/ '-')
    sing = df.loc[~df["symbol"].str.contains("-"), "symbol"]
    if sing.empty:
        return None
    front = sing.value_counts().idxmax()
    df = df[df["symbol"] == front].copy()
    df.index = pd.to_datetime(df["ts_event"])           # exchange clock
    df = df.between_time(*RTH)
    if len(df) < 1000:
        return None
    df["signed"] = np.where(df["side"] == "B", 1, -1) * df["size"].astype("int64")
    bars = pd.DataFrame({
        "price": df["price"].resample(BAR).last(),
        "vol": df["size"].resample(BAR).sum(),
        "sgn": df["signed"].resample(BAR).sum(),
        "n": df["price"].resample(BAR).count(),
    })
    bars["price"] = bars["price"].ffill()
    bars = bars.dropna(subset=["price"])
    bars[["vol", "sgn", "n"]] = bars[["vol", "sgn", "n"]].fillna(0.0)
    # tick-test sign for validation vs the aggressor `side` field
    tick = np.sign(df["price"].diff()).replace(0, np.nan).ffill().fillna(0)
    agree = (np.sign(df["signed"]) == tick)[tick != 0].mean()
    return bars, front, float(agree)


def main():
    files = sorted(glob.glob(TRADES_GLOB))
    print(f"{len(files)} trade files | bar={BAR} | RTH {RTH[0]}-{RTH[1]} UTC\n")
    recs, agrees = [], []
    for f in files:
        out = load_day_bars(f)
        if out is None:
            continue
        bars, front, agree = out
        agrees.append(agree)
        logp = np.log(bars["price"])
        day = pd.DataFrame(index=bars.index)
        # features: OFI = signed vol / total vol over window (causal, [-1,1])
        for w in WINDOWS:
            sgn_w = bars["sgn"].rolling(w).sum()
            vol_w = bars["vol"].rolling(w).sum().replace(0, np.nan)
            day[f"ofi{w}"] = (sgn_w / vol_w).clip(-1, 1)
        # forward log returns over (t, t+h]: log p[t+h] - log p[t]
        for h in HORIZONS:
            day[f"fwd{h}"] = logp.shift(-h) - logp
        day["date"] = bars.index[0].date()
        recs.append(day.dropna())
    data = pd.concat(recs)
    print(f"valid days: {data['date'].nunique()} | pooled bars: {len(data):,} | "
          f"aggressor side vs tick-test agreement: {np.mean(agrees)*100:.1f}%\n")

    print("INFORMATION COEFFICIENT (Pearson corr, signal_t vs forward return)")
    print("  +IC => momentum (flow continues) | -IC => reversion (flow reverts)\n")
    hdr = f"  {'signal':>7} " + " ".join(f"{'fwd'+str(h):>9}" for h in HORIZONS)
    print(hdr + "    (pooled IC; [per-day %positive])")
    best = (None, 0.0)
    for w in WINDOWS:
        cells = []
        for h in HORIZONS:
            sub = data[[f"ofi{w}", f"fwd{h}"]].dropna()
            ic = sub.corr().iloc[0, 1]
            byday = data.groupby("date").apply(
                lambda d: d[f"ofi{w}"].corr(d[f"fwd{h}"]), include_groups=False)
            pos = (byday > 0).mean() * 100 if ic > 0 else (byday < 0).mean() * 100
            cells.append(f"{ic:+.3f}[{pos:2.0f}%]")
            if abs(ic) > abs(best[1]):
                best = ((w, h), ic)
        print(f"  ofi{w:>4} " + " ".join(f"{c:>14}" for c in cells))

    if best[0] is None:
        print("\nno usable signal (all IC nan)")
        return
    (w, h), ic = best
    print(f"\nBEST: ofi{w} -> fwd{h}  IC={ic:+.3f}")
    sub = data[[f"ofi{w}", f"fwd{h}"]].dropna()
    sub["q"] = pd.qcut(sub[f"ofi{w}"], 5, labels=False, duplicates="drop")
    grid = sub.groupby("q")[f"fwd{h}"].agg(["mean", "count"])
    print(f"forward {h}s return by OFI quintile (bps):")
    for q, row in grid.iterrows():
        print(f"  Q{int(q)+1}  {row['mean']*1e4:+7.2f} bps   (n={int(row['count']):,})")
    spread = (grid["mean"].iloc[-1] - grid["mean"].iloc[0]) * 1e4
    print(f"  Q5-Q1 spread: {spread:+.2f} bps  "
          f"(MES round-trip cost ~0.7-1.0 bps; need spread >> that)")


if __name__ == "__main__":
