#!/usr/bin/env python3
"""OCEAN family f03_orb_failure — Opening-range breakout FAILURE fade (MES 1-lot).

Hypothesis: the FIRST 5m close beyond the 09:30-10:00 opening range traps
breakout traders; if within K bars price closes back strictly INSIDE the range,
their liquidation fuels the reverse move. Enter toward the opposite side at the
failure-bar close; resting limit target; stop beyond the breakout extreme.

Rules (exact, causal):
  * OR = first 6 five-min bars (09:30-10:00): or_hi / or_lo from omni2_lib.
  * From bar 6 on, the first bar whose CLOSE > or_hi (up-break) or CLOSE < or_lo
    (down-break) is the day's only breakout considered (first-breakout-of-day).
  * Track breakout extreme = max high (up) / min low (down) from the breakout
    bar through the current completed bar.
  * FAILURE: within K bars after the breakout bar (bar index b with
    b - break_bar <= K), a CLOSE strictly back inside (or_lo < c < or_hi).
    Enter at that bar's close (market, slippage in friction): SHORT a failed
    up-break, LONG a failed down-break. One trade per day, first failure only.
    If no failure within K bars, or price traverses out the far side, no trade.
  * Target (resting limit, fric("target")=0.41pt): "vwap" = session VWAP value
    at the entry bar, or "or_opp" = the opposite OR bound. Sanity: target must
    sit >= 0.25 pt on the profitable side of entry, else no trade.
  * Stop: breakout extreme +/- buf*ATR(entry bar). Checked intrabar only on
    bars strictly AFTER the entry bar; stop takes precedence over target if
    both touched in one bar (conservative). fric("stop")=0.66pt.
  * EOD: exit at bar-77 close, fric("eod")=0.66pt. Sessions independent.

Windows: dev = dates <= 2022-12-31, holdout = 2023-01-01.., all = everything.
Sweep table (dev only) prints every config tested. Defaults = PRE-REGISTERED.
"""
import sys, json, argparse, math
sys.path.insert(0, "/Users/kaveh/mes_mim")
import numpy as np, pandas as pd
import omni2_lib as L

ORN = 6
DPP = L.DPP
MIN_EDGE = 0.25          # target must be >= 1 tick on the profitable side

# ---------------- PRE-REGISTERED CONFIG (defaults) ----------------
PRE = dict(K=6, buf=0.50, target="vwap")

GRID_K   = [3, 6, 9]
GRID_BUF = [0.25, 0.50, 1.00]
GRID_TGT = ["vwap", "or_opp"]

# rescue diagnostics (each is one config against the ~30 budget):
# er_max gates entry on ER(24) at the failure bar (low ER = chop, fades should
# work best); bmax requires the breakout bar to occur at/before this bar index
# (30 = before 12:00, morning traps only). None = gate off.
DIAG = [
    dict(K=6, buf=1.00, target="vwap",   er_max=0.30, bmax=None),
    dict(K=6, buf=1.00, target="vwap",   er_max=0.20, bmax=None),
    dict(K=6, buf=1.00, target="or_opp", er_max=0.30, bmax=None),
    dict(K=6, buf=1.00, target="vwap",   er_max=None, bmax=30),
    dict(K=6, buf=1.00, target="or_opp", er_max=None, bmax=30),
    dict(K=6, buf=1.00, target="vwap",   er_max=0.30, bmax=30),
]


def sim_day(s, K, buf, target, er_max=None, bmax=None):
    """Return (date, net_pts, exit_kind) or None. Causal per module docstring."""
    h, l, c, vwap, atr = s["h"], s["l"], s["c"], s["vwap"], s["atr"]
    er = s["er"]
    orh, orl = s["or_hi"], s["or_lo"]
    if not (orh > orl):
        return None
    broke = 0; bbar = -1; ext = np.nan
    pos = 0; entry = stop = tgt = np.nan; ebar = -1
    for b in range(ORN, 78):
        # ---- position management (only on bars strictly after entry bar) ----
        if pos != 0 and b > ebar:
            if pos > 0:
                stop_hit = l[b] <= stop; tgt_hit = h[b] >= tgt
            else:
                stop_hit = h[b] >= stop; tgt_hit = l[b] <= tgt
            if stop_hit:                                   # stop first (conservative)
                g = pos * (stop - entry) - L.fric("stop"); kind = "stop"
            elif tgt_hit:
                g = pos * (tgt - entry) - L.fric("target"); kind = "target"
            elif b == 77:
                g = pos * (c[77] - entry) - L.fric("eod"); kind = "eod"
            else:
                continue
            return (s["date"], g, kind)
        if pos != 0:
            continue
        # ---- signal logic (flat) ----
        if broke == 0:
            if c[b] > orh:
                broke = 1; bbar = b; ext = h[b]
            elif c[b] < orl:
                broke = -1; bbar = b; ext = l[b]
            if broke != 0 and bmax is not None and bbar > bmax:
                return None                                # first breakout too late in day
            continue
        # first breakout happened; look for failure within K bars
        if b - bbar > K:
            return None                                    # breakout held -> no trade
        if broke == 1:
            ext = max(ext, h[b])
            if c[b] < orl:
                return None                                # traversed far side, not a re-entry
            if c[b] < orh and b < 77:                      # closed back inside -> SHORT
                if er_max is not None and er[b] > er_max:
                    return None
                e = c[b]
                t = vwap[b] if target == "vwap" else orl
                if e - t < MIN_EDGE:
                    return None
                pos = -1; entry = e; ebar = b; stop = ext + buf * atr[b]; tgt = t
        else:
            ext = min(ext, l[b])
            if c[b] > orh:
                return None
            if c[b] > orl and b < 77:                      # closed back inside -> LONG
                if er_max is not None and er[b] > er_max:
                    return None
                e = c[b]
                t = vwap[b] if target == "vwap" else orh
                if t - e < MIN_EDGE:
                    return None
                pos = 1; entry = e; ebar = b; stop = ext - buf * atr[b]; tgt = t
    return None


def run(S, K, buf, target, er_max=None, bmax=None):
    rows = []
    for s in S:
        r = sim_day(s, K, buf, target, er_max, bmax)
        if r is not None:
            rows.append(r)
    return pd.DataFrame(rows, columns=["date", "pts", "kind"])


def stats(tr):
    out = dict(net_usd=0.0, mar=0.0, trades=0, hit=0.0, maxdd_usd=0.0,
               yearly={}, top3_month_share=float("nan"), expectancy_pts=0.0,
               yrs_pos=0, n_yrs=0, max_yr_share=float("nan"))
    if len(tr) == 0:
        return out
    tr = tr.sort_values("date").reset_index(drop=True)
    usd = tr["pts"].to_numpy() * DPP
    net = float(usd.sum())
    eq = np.cumsum(usd)
    dd = float((eq - np.maximum.accumulate(eq)).min())
    dts = pd.to_datetime(tr["date"].astype(str))
    ys = pd.Series(usd).groupby(dts.dt.year.to_numpy()).sum()
    ms = pd.Series(usd).groupby(dts.dt.strftime("%Y-%m").to_numpy()).sum()
    out.update(
        net_usd=round(net, 2),
        mar=round(net / abs(dd), 3) if dd < 0 else float("inf"),
        trades=int(len(tr)),
        hit=round(float((tr["pts"] > 0).mean()), 4),
        maxdd_usd=round(dd, 2),
        yearly={str(int(k)): round(float(v), 2) for k, v in ys.items()},
        top3_month_share=round(float(ms.nlargest(3).sum() / net), 3) if net > 0 else float("nan"),
        expectancy_pts=round(float(tr["pts"].mean()), 4),
        yrs_pos=int((ys > 0).sum()), n_yrs=int(len(ys)),
        max_yr_share=round(float(ys.max() / net), 3) if net > 0 else float("nan"),
    )
    return out


def survival(st):
    ok = (st["net_usd"] > 0
          and st["mar"] >= 1.0
          and st["trades"] >= 80
          and st["n_yrs"] > 0 and st["yrs_pos"] / st["n_yrs"] >= 0.60
          and not math.isnan(st["max_yr_share"]) and st["max_yr_share"] <= 0.50)
    return ok


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--window", choices=["dev", "holdout", "all"], default="dev")
    ap.add_argument("--K", type=int, default=PRE["K"])
    ap.add_argument("--buf", type=float, default=PRE["buf"])
    ap.add_argument("--target", default=PRE["target"], choices=GRID_TGT)
    a = ap.parse_args()

    S = L.load()
    if a.window == "dev":
        S = [s for s in S if str(s["date"]) <= "2022-12-31"]
    elif a.window == "holdout":
        S = [s for s in S if str(s["date"]) >= "2023-01-01"]
    print(f"f03_orb_failure  window={a.window}  sessions={len(S)}")

    # ---- pre-registered (or CLI-overridden) config ----
    cfg = dict(K=a.K, buf=a.buf, target=a.target)
    st = stats(run(S, **cfg))
    print(f"\n== CONFIG {cfg} ==")
    print(f"net_usd={st['net_usd']:.0f}  MAR={st['mar']}  trades={st['trades']}  "
          f"hit={st['hit']:.1%}  maxDD={st['maxdd_usd']:.0f}  exp_pts={st['expectancy_pts']}")
    print(f"yearly: {st['yearly']}")
    print(f"yrs_pos={st['yrs_pos']}/{st['n_yrs']}  max_yr_share={st['max_yr_share']}  "
          f"top3_month_share={st['top3_month_share']}")
    print(f"survival_bar_pass={survival(st)}")

    out = {k: st[k] for k in ["net_usd", "mar", "trades", "hit", "maxdd_usd",
                              "yearly", "top3_month_share", "expectancy_pts"]}
    if math.isinf(out["mar"]):
        out["mar"] = None
    path = f"/Users/kaveh/mes_mim/ocean/results/f03_orb_failure_{a.window}.json"
    with open(path, "w") as f:
        json.dump(out, f, indent=1, default=str)
    print(f"wrote {path}")

    # ---- full sweep table: DEV ONLY ----
    if a.window == "dev":
        base = [dict(K=K, buf=buf, target=tgt, er_max=None, bmax=None)
                for tgt in GRID_TGT for K in GRID_K for buf in GRID_BUF]
        allc = base + DIAG
        print(f"\n== FULL SWEEP (dev only) — {len(allc)} configs "
              f"({len(base)} base grid + {len(DIAG)} rescue diagnostics) ==")
        print(f"{'K':>2} {'buf':>5} {'target':>7} {'erMax':>6} {'bMax':>5} | {'trades':>6} "
              f"{'net$':>8} {'MAR':>6} {'hit%':>5} {'maxDD$':>8} {'yrs+':>5} {'maxYr%':>6} "
              f"{'top3mo%':>7} {'exp_pts':>7}")
        for cf in allc:
            r = stats(run(S, **cf))
            mys = "  nan" if math.isnan(r["max_yr_share"]) else f"{r['max_yr_share']:.2f}"
            t3 = "  nan" if math.isnan(r["top3_month_share"]) else f"{r['top3_month_share']:.2f}"
            em = "  off" if cf["er_max"] is None else f"{cf['er_max']:.2f}"
            bm = "  off" if cf["bmax"] is None else f"{cf['bmax']:d}"
            tag = " <== PRE" if (cf["K"] == PRE["K"] and cf["buf"] == PRE["buf"]
                                 and cf["target"] == PRE["target"]
                                 and cf["er_max"] is None and cf["bmax"] is None) else ""
            print(f"{cf['K']:>2} {cf['buf']:>5.2f} {cf['target']:>7} {em:>6} {bm:>5} | "
                  f"{r['trades']:>6} {r['net_usd']:>8.0f} {r['mar']:>6.2f} {100*r['hit']:>5.1f} "
                  f"{r['maxdd_usd']:>8.0f} {r['yrs_pos']:>2}/{r['n_yrs']:<2} {mys:>6} {t3:>7} "
                  f"{r['expectancy_pts']:>7.3f}{tag}")


if __name__ == "__main__":
    main()

