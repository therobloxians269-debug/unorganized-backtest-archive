"""
The ping-pong trade, simulated exactly as specified:
  LONG  limit at the low box inner edge, stop at its outer edge, target the HIGH box inner edge
  SHORT limit at the high box inner edge, stop at its outer edge, target the LOW box inner edge
Both orders work from 09:30, both boxes static all day. Flat at 15:59.
Trend days are the loss case by construction: price leaves one box and never returns.
"""
import numpy as np, pandas as pd


def run(day, rb, spec, lo_in, lo_out, hi_in, hi_out, flat=959, both_sides=True):
    pv, tick, comm = spec['pv'], spec['tick'], spec['comm']
    out = []
    for i, (dd, row) in enumerate(day.iterrows()):
        b = rb.get(dd)
        if b is None:
            continue
        H, L, T = b['H'], b['L'], b['T']
        legs = [(+1, lo_in[i], lo_out[i], hi_in[i])]
        if both_sides:
            legs.append((-1, hi_in[i], hi_out[i], lo_in[i]))
        for s, E, S, TG in legs:
            risk = s * (E - S)
            if risk <= 0 or s * (TG - E) <= 0:
                continue
            hit = np.flatnonzero((L <= E) if s > 0 else (H >= E))
            if not len(hit):
                out.append(dict(day=dd, s=s, filled=False))
                continue
            j = hit[0]
            if (L[j] <= S) if s > 0 else (H[j] >= S):      # fill bar: stop only
                px, why = S - s * tick, 'stop'
            else:
                px = why = None
                for m in range(j + 1, len(H)):
                    if T[m] >= flat:
                        px, why = b.get('C', H)[m] if 'C' in b else (H[m] + L[m]) / 2, 'time'
                        break
                    if (L[m] <= S) if s > 0 else (H[m] >= S):
                        px, why = S - s * tick, 'stop'; break
                    if (H[m] >= TG) if s > 0 else (L[m] <= TG):
                        px, why = TG, 'target'; break
                if px is None:
                    px, why = (b.get('C', H)[-1] if 'C' in b else (H[-1] + L[-1]) / 2), 'time'
            pnl = s * (px - E) * pv - comm
            out.append(dict(day=dd, s=s, filled=True, E=E, S=S, TG=TG, risk=risk,
                            RR=s * (TG - E) / risk, why=why, pnl=pnl, R=pnl / (risk * pv)))
    return pd.DataFrame(out)


def report(r, tag, ndays):
    fl = r[r.filled]
    if not len(fl):
        print(f'  {tag:30s} NO FILLS'); return
    n, pnl, R = len(fl), fl.pnl.values, fl.R.values
    t = R.mean() / (R.std(ddof=1) / np.sqrt(n)) if n > 1 and R.std() > 0 else 0
    d3 = np.sort(pnl)[:-3].mean() if n > 3 else np.nan
    yr = fl.groupby(fl.day.dt.year).pnl.mean()
    mix = fl.why.value_counts(normalize=True)
    print(f'  {tag:30s} n={n:5d} {n/ndays:.2f}/d  WR {(pnl>0).mean()*100:4.1f}%  '
          f'medRR {np.median(fl.RR):4.2f}  avgR {R.mean():+.3f} t {t:+5.2f}  ${pnl.mean():+7.2f} '
          f'drop3 ${d3:+6.2f}  yr {(yr>0).sum()}/{len(yr)}  '
          f'[stp {mix.get("stop",0)*100:.0f} tgt {mix.get("target",0)*100:.0f} tm {mix.get("time",0)*100:.0f}]')

