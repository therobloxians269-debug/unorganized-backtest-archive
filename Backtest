"""
WALK-FORWARD on the MOMENTUM-TRIM DECISION ITSELF — the honest test of whether the x0.7 trim
(which gives Sharpe 1.90) is hindsight-fitted or causally justified.

Instead of fixing mom_scale=0.7 (a number chosen with full-sample knowledge), each week we set the
momentum weight by a CAUSAL RULE using ONLY trailing data: cap momentum's risk contribution at a
target, estimated from the trailing 52-week covariance. If the causal rule reproduces ~1.90, the trim
is a real risk-management decision, not a fit. We also print rolling 12-month Sharpe by year so the
recent decay is visible, not hidden.

    PYTHONPATH=/Users/kaveh/mim_research python3 wfa_trim.py
"""
from __future__ import annotations
import numpy as np
import pandas as pd
from tear_sheet import build_v3

_, j = build_v3()
W = j.resample("W").sum()
cols = ["C1", "C2", "M", "T"]
WARMUP = 52


def base_weights(row_active):
    # 0.35/0.25/0.15/0.25, with C2's 0.25 folding into C1 when C2 inactive (mirrors build_v3)
    c2a = row_active
    return {"C1": 0.35 + (0.0 if c2a else 0.25), "C2": 0.25 if c2a else 0.0, "M": 0.15, "T": 0.25}


def run(trim_mode, target_share=0.60):
    """trim_mode: 'none' (full M), 'fixed07' (x0.7), 'causal' (cap M risk share via trailing cov)."""
    oos = {}
    for t in range(WARMUP, len(W)):
        tr = W.iloc[t - WARMUP:t]
        c2a = (tr["C2"] != 0).sum() > 20
        bw = base_weights(c2a)
        scale = 1.0
        if trim_mode == "fixed07":
            scale = 0.7
        elif trim_mode == "causal":
            # risk share of M at base weights, from trailing cov (causal)
            wv = np.array([bw[c] for c in cols])
            cov = tr[cols].cov().values
            port_var = wv @ cov @ wv
            if port_var > 0:
                m_idx = cols.index("M")
                m_risk = (wv[m_idx] * (cov[m_idx] @ wv)) / port_var
                if m_risk > target_share:
                    # scale M weight so its (approx) risk share -> target
                    scale = max(0.2, min(1.0, np.sqrt(target_share / m_risk)))
        w = dict(bw); w["M"] = bw["M"] * scale
        oos[W.index[t]] = sum(w[c] * W[c].iloc[t] for c in cols)
    s = pd.Series(oos)
    sr = s.mean() / s.std() * np.sqrt(52)
    rho = s.autocorr(1); neff = len(s) * (1 - rho) / (1 + rho)
    dd = ((1 + s).cumprod() / (1 + s).cumprod().cummax() - 1).min()
    cagr = (1 + s).prod() ** (52 / len(s)) - 1
    return s, sr, sr * np.sqrt(max(neff, 1) / 52), cagr, dd


print("WALK-FORWARD OF THE TRIM (stitched OOS, weekly, causal where noted)")
print(f"  {'mode':14s} {'OOS Sharpe':>11} {'t(adj)':>7} {'CAGR':>7} {'maxDD':>7}")
series = {}
for mode, lbl in [("none", "no trim"), ("fixed07", "fixed x0.7"), ("causal", "causal risk-cap")]:
    s, sr, tadj, cagr, dd = run(mode)
    series[mode] = s
    print(f"  {lbl:14s} {sr:>11.2f} {tadj:>7.2f} {cagr*100:>6.1f}% {dd*100:>6.1f}%")

print("\nROLLING 12-MONTH SHARPE BY YEAR (fixed x0.7 trimmed config) — is the edge decaying?")
s = series["fixed07"]
roll = s.rolling(52).apply(lambda x: x.mean() / x.std() * np.sqrt(52) if x.std() > 0 else np.nan)
for y in range(2021, 2027):
    yr = roll[roll.index.year == y].dropna()
    if len(yr):
        print(f"  {y}: rolling-12m Sharpe  min {yr.min():5.2f} | mean {yr.mean():5.2f} | max {yr.max():5.2f}")

print("\nCALENDAR-YEAR OOS RETURNS (causal-trim path):")
sc = series["causal"]
cy = sc.groupby(sc.index.year).apply(lambda x: (1 + x).prod() - 1)
print("  " + " | ".join(f"{y}:{v*100:+.1f}%" for y, v in cy.items()))

