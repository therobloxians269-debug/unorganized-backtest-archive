"""Run Market Intraday Momentum through the gauntlet (M3 + M7).

Auto-selects data:
  * data/*ohlcv*1m*.parquet  (Databento ES.c.0 1-min, once you download it) -> real run
  * else all_trades.parquet  (the 1-month ES pilot) -> wiring check only (no power)

Builds a small config grid (predictor r1 | r1_r12 x deadband), computes per-day net
returns for each, and reports per-config stats, PBO, PSR, DSR, the IS/OOS/holdout split,
and a PASS/FAIL verdict against the pre-registered thresholds.

    PYTHONPATH=. python3 research/validate_mim.py
"""
from __future__ import annotations

import datetime as dt
import glob
from pathlib import Path

import pandas as pd

from ope.config import Config, MIMConfig
from ope.instruments import get_market
from ope.mim import run_mim
from ope.validation import gauntlet_summary, perf_stats
from ope.tick_data import load_trades, trades_to_bars

ROOT = Path(__file__).resolve().parents[1]


def load_ohlcv_bars(path: Path) -> pd.DataFrame:
    """Load a Databento ohlcv-1m parquet into right-labeled ET RTH bars."""
    df = pd.read_parquet(path)
    if "ts_event" in df.columns:
        df = df.set_index("ts_event")
    df = df.rename(columns=str.lower)
    idx = pd.DatetimeIndex(pd.to_datetime(df.index, utc=True)) + pd.Timedelta(minutes=1)
    df.index = idx.tz_convert("America/New_York")
    df = df[["open", "high", "low", "close", "volume"]].astype(float)
    df["session_date"] = [t.date() for t in df.index]
    df["in_rth"] = [dt.time(9, 30) < t.time() <= dt.time(16, 0) for t in df.index]
    return df.sort_index()


def load_bars() -> tuple[pd.DataFrame, str]:
    hits = sorted(glob.glob(str(ROOT / "data" / "*ohlcv*1m*.parquet")))
    if hits:
        return load_ohlcv_bars(Path(hits[0])), f"REAL ({Path(hits[0]).name})"
    pilot = ROOT / "all_trades.parquet"
    if pilot.exists():
        return trades_to_bars(load_trades(pilot), "1min", rth_only=True), "PILOT (1-month ES; no power)"
    raise SystemExit("no data found: download ES.c.0 ohlcv-1m or keep all_trades.parquet")


def main() -> None:
    bars, source = load_bars()
    mes = get_market("SP500").micro

    grid = {f"{p}_db{int(d)}": MIMConfig(predictor=p, deadband_bp=d, use_cost=True)
            for p in ("r1", "r1_r12") for d in (0.0, 2.0, 5.0)}
    primary = "r1_r12_db0"

    returns = {name: run_mim(bars, contract=mes, cfg=cfg)["net"] for name, cfg in grid.items()}
    n_days = len(returns[primary])
