def combine(sl, weights=None):
    fr=[]
    for k,t in sl.items():
        w=1.0 if weights is None else weights.get(k,1.0)
        x=t.copy(); x['pnl']=x.pnl*w; fr.append(x)
    return pd.concat(fr).sort_values('t').reset_index(drop=True)

def stats(t,D,pv):
    if len(t)<10: return None
    eq=t.pnl.cumsum(); dd=abs((eq-eq.cummax()).min())
    pf=t.pnl[t.pnl>0].sum()/max(1e-9,-t.pnl[t.pnl<0].sum())
    return dict(n=len(t),tpd=len(t)/D,wr=(t.pnl>0).mean()*100,dpt=t.pnl.mean(),
                pf=pf,net=t.pnl.sum(),dd=dd,dd_mic=dd/(pv/2),net_mic=t.pnl.sum()/(pv/2))

