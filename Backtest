MICRO = dict(pv=2.0, comm=1.50, slip=0.25)


def micro_dd(book, cfg_):
    """Max drawdown of the SAME trade sequence sized at 1 MICRO (pv=2, comm=$1.50)."""
    old = book.cost
    book.cost = MICRO
    try:
        t = book.trades_for_config(cfg_)
    finally:
        book.cost = old
    if t is None or len(t) == 0:
        return np.nan, np.nan, np.nan
    eq = np.cumsum(t["net"].values)
    dd = float((np.maximum.accumulate(np.concatenate([[0.0], eq])) -
                np.concatenate([[0.0], eq])).max())
    return dd, float(t["net"].mean()), float(t["r"].mean())


def marginals(d, params, minn=100):
