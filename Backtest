"""Combine our two REAL, independent, low-beta edges into one program:
  (1) multi-asset time-series TREND  (16-ETF, ope.trend)  -- net Sharpe ~0.73
  (2) cross-sectional equity MOMENTUM (S&P 500)           -- net Sharpe ~0.40 (OOS 0.86)

If their correlation is low, a risk-parity blend lifts the combined Sharpe above either
alone -- the one non-overfit way to approach the fund bar. Reports correlation, the blend's
IS/OOS Sharpe, beta/alpha vs SPY, and the gauntlet (PSR vs 1.0, DSR with honest N).

    PYTHONPATH=. python3 research/combine_edges.py
"""
from __future__ import annotations

import numpy as np
import pandas as pd

from ope.trend import ETF_BASKET, ETF_COST_BP, backtest
from ope.validation import deflated_sharpe_ratio, perf_stats, probabilistic_sharpe_ratio
from research.xs_equity import sp500_tickers, zscore

COST_BP, TGT, WIN, CAP, ANN = 3.0, 0.10, 63, 3.0, 252.0
OOS_START = "2022-01-01"


def momentum_net(yf):
    px = yf.download(sp500_tickers(), start="2010-01-01", auto_adjust=True,
                     progress=False)["Close"]
    px = px.dropna(how="all").dropna(axis=1, thresh=int(len(px) * 0.6))
    px = px[px.columns[px.iloc[-1].notna()]]
    rets = px.pct_change()
    raw = px.shift(21) / px.shift(252) - 1.0                  # 12-1 cross-sectional momentum
    w = zscore(raw).shift(1)
    w = w.sub(w.mean(axis=1), axis=0)
    w = w.div(w.abs().sum(axis=1).replace(0, np.nan), axis=0)
    g = (w * rets).sum(axis=1)
    scale = (TGT / (g.rolling(WIN).std() * np.sqrt(ANN))).shift(1).clip(0, CAP).fillna(0.0)
    w = w.mul(scale, axis=0)
    turn = w.diff().abs().sum(axis=1)
    return ((w * rets).sum(axis=1) - turn * COST_BP * 1e-4).dropna()


def line(name, r, spy):
    s, oos = perf_stats(r), perf_stats(r[r.index >= OOS_START])
    bb = pd.concat([r, spy], axis=1).dropna()
    beta = bb.cov().iloc[0, 1] / bb.iloc[:, 1].var()
    alpha = (r.mean() - beta * spy.reindex(r.index).mean()) * ANN
    psr1 = probabilistic_sharpe_ratio(r, 1.0 / np.sqrt(ANN))
    print(f"  {name:<16} Sh {s['sharpe']:.2f} (OOS {oos['sharpe']:.2f}) | ann {s['ann_return']*100:4.1f}% "
          f"DD {s['max_drawdown']*100:6.1f}% | beta {beta:+.2f} alpha {alpha*100:4.1f}% | PSR>1 {psr1*100:4.1f}%")


def main():
    import yfinance as yf
    etf = yf.download(ETF_BASKET, start="2006-01-01", auto_adjust=True, progress=False)["Close"]
    etf = etf.dropna(how="all").dropna(axis=1, thresh=int(len(etf) * 0.4))
    trend = backtest(etf, cost_bp={k: v for k, v in ETF_COST_BP.items() if k in etf.columns}).net
    mom = momentum_net(yf)
    spy = yf.download("SPY", start="2006-01-01", auto_adjust=True, progress=False)["Close"]
    spy = spy.pct_change().squeeze()

    j = pd.concat({"trend": trend, "mom": mom}, axis=1).dropna()
    corr = j["trend"].corr(j["mom"])
    # risk-parity blend: scale each to the SAME ~10% annual vol, then average (real return units)
    scaled = j * (TGT / np.sqrt(ANN)) / j.std()
    combo = (0.5 * scaled["trend"] + 0.5 * scaled["mom"])

    print(f"common period {j.index[0].date()} -> {j.index[-1].date()} ({len(j)} days)")
    print(f"correlation(trend, momentum) = {corr:+.2f}   (low => diversification works)\n")
    print("component & combined (vs SPY):")
    line("trend (ETF)", j["trend"], spy)
    line("momentum (SPX)", j["mom"], spy)
    line("COMBO 50/50 RP", combo, spy)

    srvar = max(np.var([perf_stats(j["trend"])["sharpe"], perf_stats(j["mom"])["sharpe"],
                        perf_stats(combo)["sharpe"]]) / ANN, 1e-6)
    print("\nGAUNTLET (combo):")
    print(f"  PSR vs 0: {probabilistic_sharpe_ratio(combo,0.0)*100:.1f}%  |  "
          f"PSR vs 1.0: {probabilistic_sharpe_ratio(combo,1.0/np.sqrt(ANN))*100:.1f}%")
    for N in (15, 30):
        print(f"  DSR @ N={N}: {deflated_sharpe_ratio(combo, srvar, N)*100:.1f}%")


if __name__ == "__main__":
    main()

