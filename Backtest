#!/usr/bin/env python3
"""The statistician-skeptic test the workflow never ran.
Null: random long-only exposure with the SAME hold-length distribution and SAME
number of trades as f08, placed at random entry dates in the same window, same
friction. 5000 draws. Question: is f08's timing (Donchian entry / 10d-low exit /
20d cap) better than untimed equal-exposure longs, and by how much — on
(a) net $, (b) MAR (the small-account survival metric)?"""
import sys, datetime as dt
import numpy as np
sys.path.insert(0, "/Users/kaveh/mes_mim")
import omni2_lib as L
from omni2_lib import DPP

FRIC = 0.66; N, M, K = 20, 10, 20
S = L.load()
dates = np.array([s["date"] for s in S])
o = np.array([s["o"][0] for s in S]); h = np.array([s["h"].max() for s in S])
l = np.array([s["l"].min() for s in S]); c = np.array([s["c"][-1] for s in S])
n = len(dates)

def f08_trades(i0, i1):
    """(entry_i, exit_i) pairs with entries in [i0, i1)."""
    pos = 0; entry_i = -1; out = []
    for t in range(N, n):
        exited = False
        if pos == 1:
            if c[t] < l[t-M:t].min() or (t - entry_i) >= K or t == n - 1:
                out.append((entry_i, t)); pos = 0; exited = True
        if pos == 0 and not exited and t < n - 1 and c[t] > h[t-N:t].max():
            if i0 <= t < i1: pos = 1; entry_i = t
    return out

def pnl_curve(pairs):
    day = np.zeros(n)
    for e, x in pairs:
        day[e+1:x+1] += np.diff(c[e:x+1])
        day[x] -= FRIC
    usd = day * DPP
    eq = np.cumsum(usd); dd = (eq - np.maximum.accumulate(eq)).min()
    tot = usd.sum()
    return tot, (tot/abs(dd) if dd < 0 else np.inf)

hold_start = int(np.searchsorted(dates, dt.date(2023, 1, 1)))
for (i0, i1, w) in ((N, n, "ALL 2010-2026"), (hold_start, n, "HOLDOUT 2023-2026")):
    real = f08_trades(i0, i1)
    holds = np.array([x - e for e, x in real])
    rt, rmar = pnl_curve(real)
    rng = np.random.default_rng(3)
    tots = np.empty(5000); mars = np.empty(5000)
    for i in range(5000):
        ents = np.sort(rng.integers(i0, i1 - 2, size=len(real)))
        hs = rng.permutation(holds)
        pairs = []; last_x = -1
        for e, hd in zip(ents, hs):
            e = max(e, last_x + 1)
            x = min(e + hd, n - 1)
            if e >= x: continue
            pairs.append((e, x)); last_x = x
        tots[i], mars[i] = pnl_curve(pairs)
    p_net = float((tots >= rt).mean()); p_mar = float((mars >= rmar).mean())
    print(f"{w}: f08 {len(real)} trades  net ${rt:+.0f} MAR {rmar:.2f}")
    print(f"  exposure-matched null: net p50 ${np.median(tots):+.0f} (p95 ${np.percentile(tots,95):+.0f})"
          f"  MAR p50 {np.median(mars):.2f} (p95 {np.percentile(mars,95):.2f})")
    print(f"  P(null >= f08):  net {p_net:.3f}   MAR {p_mar:.3f}\n")

