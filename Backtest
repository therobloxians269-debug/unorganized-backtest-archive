"""
Two questions:
  1. Can this harness detect an edge at all?  (power analysis + planted-edge control)
  2. Is the one live cell real, or 1-in-24 multiple-comparisons noise?
     -> proper null DISTRIBUTION from many scrambles, not a single draw.

Live cell: layers=L1L2, lookback=6, require_both=True, internal open = 09:30 (tny_alt)
"""
import numpy as np, pandas as pd
from scipy import stats
import qtlib as Q
from backtest import run, _stamp

LB, BOTH, IOPEN, LAYERS = 6, True, "tny_alt", "L1L2"

df = Q.add_true_opens(Q.load_data())


def pre_for(d):
    b15, b5 = _stamp(Q.resample(d, "15min")), _stamp(Q.resample(d, "5min"))
    p = {"b15": b15, "b5": b5}
    for s in ("short", "long"):
        p[f"s15_{s}"] = Q.ssmt(b15, lookback=LB, side=s, require_both=BOTH)
        p[f"s5_{s}"] = Q.ssmt(b5, lookback=LB, side=s, require_both=BOTH)
    return p


def trades(d):
    pre = pre_for(d)
    ps = [run(d, layers=LAYERS, side=s, internal_open=IOPEN, pre=pre)
          for s in ("short", "long")]
    ps = [p for p in ps if not p.empty]
    return pd.concat(ps, ignore_index=True) if ps else pd.DataFrame()


real = trades(df)
print(f"[real] n={len(real)}  1R gross={real['R1_gross'].mean():+.4f}  "
      f"net={real['R1_net'].mean():+.4f}")

# ---------------------------------------------------------------- 1. POWER
print("\n" + "=" * 78)
print("1. CAN THIS TEST SEE AN EDGE?  (minimum detectable effect)")
print("=" * 78)
n = len(real)
for T in (1, 2, 3):
    sd = real[f"R{T}_gross"].std(ddof=1)
    # two-sample (real vs null), 80% power, alpha=0.05 two-sided
    mde2 = (1.96 + 0.84) * sd * np.sqrt(2.0 / n)
    mde1 = (1.96 + 0.84) * sd / np.sqrt(n)          # one-sample vs zero
    print(f"  {T}R: per-trade SD={sd:.3f}  n={n}")
    print(f"       detectable vs NULL  (80% power): {mde2:+.4f} R/trade")
    print(f"       detectable vs ZERO  (80% power): {mde1:+.4f} R/trade")
print("\n  -> effects SMALLER than these are invisible to this test;")
print("     effects LARGER than these would have shown up.")

# ------------------------------------------------- 2. PLANTED-EDGE CONTROL
print("\n" + "=" * 78)
print("2. PLANTED-EDGE CONTROL — inject a known edge, see if it is recovered")
print("=" * 78)
rng = np.random.default_rng(0)
for planted in (0.05, 0.10, 0.20, 0.40):
    # add a known constant to every trade's gross R, resample with noise-free injection
    boosted = real["R1_gross"] + planted
    t, p = stats.ttest_ind(boosted, real["R1_gross"], equal_var=False)
    detected = p < 0.05
    print(f"  planted {planted:+.2f}R -> recovered {boosted.mean()-real['R1_gross'].mean():+.4f}R "
          f"  p={p:.2e}  {'DETECTED' if detected else 'MISSED'}")

# ------------------------------------------- 3. NULL DISTRIBUTION (many scrambles)
print("\n" + "=" * 78)
print("3. NULL DISTRIBUTION — 15 independent scrambles of ES/YM")
print("=" * 78)
OFFSETS = [17, 29, 37, 53, 71, 97, 113, 131, 151, 173, 197, 211, 233, 251, 271]
null_means = {1: [], 2: [], 3: []}
for off in OFFSETS:
    tn = trades(Q.scramble_references(df, offset_days=off))
    if tn.empty:
        continue
    for T in (1, 2, 3):
        null_means[T].append(tn[f"R{T}_gross"].mean())
    print(f"  offset {off:>4}: n={len(tn):>5}  1R={null_means[1][-1]:+.4f}  "
          f"2R={null_means[2][-1]:+.4f}  3R={null_means[3][-1]:+.4f}")

print("\n  --- where does REAL sit in the null distribution? ---")
for T in (1, 2, 3):
    arr = np.array(null_means[T])
    r = real[f"R{T}_gross"].mean()
    z = (r - arr.mean()) / arr.std(ddof=1) if arr.std(ddof=1) > 0 else np.nan
    pct = (arr < r).mean() * 100
    print(f"  {T}R: real={r:+.4f}  null mean={arr.mean():+.4f} sd={arr.std(ddof=1):.4f}  "
          f"z={z:+.2f}  beats {pct:.0f}% of nulls")

pd.DataFrame(null_means).to_parquet("/Users/kaveh/qt_cascade/null_dist.parquet")
real.to_parquet("/Users/kaveh/qt_cascade/live_cell_trades.parquet")

