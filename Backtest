"""Measure the REAL MES execution cost from the reconstructed L3 book -- the defensible
slippage number for the tear sheet (checklist S5: "MBO-based execution modeling is your
differentiator"). For retail sizes (1-6 contracts) on a ~50-deep touch, fills are at the
touch, so cost = half-spread (cross) + commission; market impact ~0.

Reports, over several sessions (RTH): spread distribution, touch depth, P(size fills at
touch), and round-trip cost in ticks / $ / bps for crossing vs posting.

    PYTHONPATH=. python3 research/mes_exec_cost.py
"""
from __future__ import annotations

import glob

import numpy as np
import pandas as pd

from research.l3_book_alpha import reconstruct

TICK = 0.25
POINT = 5.0                    # MES $ per index point
COMM_RT = 1.20                # MES all-in commission round-trip ($), per checklist S5
SIZES = (1, 3, 6)            # retail / Apex contract counts
N_DAYS = 4                    # sessions to average over


def main():
    files = sorted(glob.glob("data/mbo/GLBX-20260607-8MCA89KCJQ/*.mbo.dbn.zst"))[-N_DAYS:]
    rows = []
    for f in files:
        df, front, n = reconstruct(f)
        df.index = pd.to_datetime(df["ts"])
        df = df.between_time("13:30", "20:00")
        df = df[(df["ask"] > df["bid"]) & (df["bidsz"] > 0) & (df["asksz"] > 0)]
        df["date"] = df.index[0].date()
        rows.append(df)
    d = pd.concat(rows)
    mid = (d["bid"] + d["ask"]) / 2
    spr_t = (d["ask"] - d["bid"]) / TICK
    notional = POINT * mid

    print(f"sessions: {d['date'].nunique()} | snapshots: {len(d):,} | "
          f"mean mid {mid.mean():.1f} (notional ${notional.mean():,.0f}/contract)\n")
    print("SPREAD (RTH):")
    print(f"  mean {spr_t.mean():.3f} ticks | 1-tick {np.mean(spr_t<=1.0001)*100:.1f}% | "
          f"2-tick {np.mean((spr_t>1.0001)&(spr_t<=2.0001))*100:.1f}% | >2 {np.mean(spr_t>2.0001)*100:.1f}%")
    print(f"  touch depth: bid {d['bidsz'].mean():.0f} / ask {d['asksz'].mean():.0f} contracts\n")

    print("FILL-AT-TOUCH probability (both sides deep enough for size):")
    for k in SIZES:
        p = np.mean((d["bidsz"] >= k) & (d["asksz"] >= k)) * 100
        print(f"  {k} contract(s): {p:.1f}%")

    half_bps = (spr_t * TICK / 2) / mid * 1e4
    cross_rt_bps = (spr_t * TICK) / mid * 1e4
    comm_bps = COMM_RT / notional * 1e4
    print("\nROUND-TRIP COST (1-6 contracts fill at touch -> impact ~0):")
    print(f"  CROSS both sides : spread {spr_t.mean()*TICK:.3f} pt = ${spr_t.mean()*TICK*POINT:.2f} "
          f"+ comm ${COMM_RT:.2f} = ${spr_t.mean()*TICK*POINT+COMM_RT:.2f}  "
          f"= {(cross_rt_bps.mean()+comm_bps.mean()):.2f} bps")
    print(f"  POST one side    : earn ~half-spread, pay comm -> "
          f"net {(-half_bps.mean()+comm_bps.mean()):.2f} bps  (if filled; ignores adverse selection/non-fill)")
    print(f"  CROSS one / POST one : ~{(half_bps.mean()+comm_bps.mean()):.2f} bps")
    print(f"\n  components: half-spread {half_bps.mean():.3f} bps | commission {comm_bps.mean():.3f} bps")
    print(f"  -> use ~{(cross_rt_bps.mean()+comm_bps.mean()):.2f} bps round-trip for a market-order backtest;")
    print(f"     ~{(half_bps.mean()+comm_bps.mean()):.2f} bps if entries post and exits cross (realistic mix).")


if __name__ == "__main__":
    main()

