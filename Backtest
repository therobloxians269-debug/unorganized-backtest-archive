@dataclass
class EconomicEvent:
    date:        pd.Timestamp
    event_type:  EventType
    impact:      EventImpact
    time_et:     Optional[time]
    description: str = ""


class EconomicCalendar:
    """
    Manages high-impact economic events and generates per-bar blackout flags.

    Blackout logic
    ──────────────
    Timed events   → flag bars within [event − pre_min, event + post_min] UTC.
    All-day events → flag all bars on that ET calendar date.
    Only EventImpact.HIGH events produce blackout flags.
    """

    def __init__(self, pre_event_min: int = 30, post_event_min: int = 30):
        self.pre_event_min  = pre_event_min
        self.post_event_min = post_event_min
        self._events: List[EconomicEvent] = []

    def add_event(self, event: EconomicEvent) -> None:
        self._events.append(event)

    def load_from_csv(self, filepath: str) -> None:
        """
        CSV format: date (YYYY-MM-DD), event_type, impact[, time_et (HH:MM), description]
        """
        if not os.path.exists(filepath):
            logger.warning(f"Calendar CSV not found: {filepath}")
            return
        raw = pd.read_csv(filepath)
        loaded = 0
        for _, row in raw.iterrows():
            t: Optional[time] = None
            if "time_et" in raw.columns and pd.notna(row.get("time_et")):
                try:
                    t = datetime.strptime(str(row["time_et"]).strip(), "%H:%M").time()
                except ValueError:
                    pass
            try:
                self._events.append(EconomicEvent(
                    date=pd.Timestamp(row["date"]),
                    event_type=EventType(str(row["event_type"]).lower().strip()),
                    impact=EventImpact(str(row["impact"]).lower().strip()),
                    time_et=t,
                    description=str(row.get("description", "")),
                ))
                loaded += 1
            except (ValueError, KeyError) as exc:
                logger.warning(f"Skipping malformed calendar row: {exc}")
        logger.info(f"Loaded {loaded} events from {filepath}")

    def load_default_high_impact_dates(self, start: str, end: str) -> None:
        """Auto-populate OPEX and Quad-Witching dates (3rd Friday of each month)."""
        s, e = pd.Timestamp(start), pd.Timestamp(end)
        quad_months = {3, 6, 9, 12}
        count = 0
        year, mth = s.year, s.month
        while True:
            month_start = pd.Timestamp(year=year, month=mth, day=1)
            if month_start > e:
                break
            dow          = month_start.weekday()
            days_to_fri  = (4 - dow) % 7
            third_friday = month_start + pd.Timedelta(days=days_to_fri + 14)
            if s <= third_friday <= e:
                is_quad = third_friday.month in quad_months
                self._events.append(EconomicEvent(
                    date=third_friday,
                    event_type=EventType.QUAD_WITCH if is_quad else EventType.OPEX,
                    impact=EventImpact.HIGH,
                    time_et=None,
                    description="Quad Witching" if is_quad else "Monthly OPEX",
                ))
                count += 1
            mth += 1
            if mth > 12:
                mth = 1; year += 1
        logger.info(f"Auto-generated {count} OPEX/Quad-Witch dates ({start}→{end})")

    def compute_event_flags(self, df: pd.DataFrame) -> pd.DataFrame:
        """
        Returns DataFrame (same index as df) with event flag columns.
        Requires df.index to be a UTC-aware DatetimeIndex.
        """
        out = pd.DataFrame({
            "event_flag":     False,
            "event_type_str": "",
            "event_impact":   "",
        }, index=df.index)

        high = [ev for ev in self._events if ev.impact == EventImpact.HIGH]
        if not high:
            logger.warning("No HIGH-impact events in calendar.")
            return out

        for ev in high:
            if ev.time_et is not None:
                # Timed event: build UTC window around announcement
                ev_et  = datetime.combine(ev.date.date(), ev.time_et, tzinfo=_TZ_ET)
                ev_utc = ev_et.astimezone(_stdlib_tz.utc)
                t0 = pd.Timestamp(ev_utc) - pd.Timedelta(minutes=self.pre_event_min)
                t1 = pd.Timestamp(ev_utc) + pd.Timedelta(minutes=self.post_event_min)
                # Ensure tz-aware comparison
                if df.index.tzinfo is None:
                    t0 = t0.tz_localize(None)
                    t1 = t1.tz_localize(None)
                mask = (df.index >= t0) & (df.index <= t1)
            else:
                # All-day event: flag entire ET date
                ev_date_naive = ev.date.normalize().tz_localize(None)
                if df.index.tzinfo is not None:
                    et_dates = df.index.tz_convert("America/New_York").normalize().tz_localize(None)
                else:
                    et_dates = df.index.normalize()
                mask = et_dates == ev_date_naive

            out.loc[mask, "event_flag"]     = True
            out.loc[mask, "event_type_str"] = ev.event_type.value
            out.loc[mask, "event_impact"]   = ev.impact.value

        logger.info(f"Event flags: {out['event_flag'].sum():,} bars flagged")
        return out


