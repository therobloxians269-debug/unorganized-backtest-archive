"""
confidence.py — the fused SMC/ICT *confidence engine* as a tradeable signal layer.

This is the Python counterpart of ICT_SMC_Engine.pine. Instead of scoring a live
chart, it scores every raid -> MSS -> PD-array *candidate* the discretionary
playbook produces and turns the ones that clear a grade threshold into concrete
BUY / SELL setups the causal engine (engine.run_backtest) can trade.

Score is fused from six modules on the same budget as the Pine engine:

    Structure    0..20   MSS/CHoCH vs BOS, displacement at the shift, break size
    Liquidity    0..20   pool importance, sweep magnitude, reclaim, draw quality
    FVG          0..20   gap width vs ATR, freshness, presence
    Order Block  0..15   OB entry vs FVG entry, freshness
    Displacement 0..15   convex impulse-body strength (saturating)
    Context      0..10   killzone, HTF bias alignment, premium/discount + OTE
                 -----
    base         0..100
    + confluence bonus  0..15  = 15 * frac^1.5   (independent agreements amplify)
    - penalties         counter-bias, no-displacement, PD misalignment, thin RR
    => clamp 0..100 -> grade  A+ >=85, A >=75, B >=65, C >=55, D >=40, else F

Every input is causal: it reuses the same primitives, bar indices, and the exact
entry/stop/target construction as models.build_setups, so a confidence signal is
directly comparable to the flagship presets.
"""
from __future__ import annotations

import numpy as np
import pandas as pd

from . import sessions as _sessions
from .imbalance import displacement_at, order_block_before
from .premium_discount import current_range, in_ote
from .smt import smt_confirms
from .models import (
    ModelConfig, Setup, Context,
    _recent_fvg, _target_pool, _fvg_entry, _prior_profile,
)

# ---- grading -----------------------------------------------------------------
GRADE_CUTS = [(85, "A+"), (75, "A"), (65, "B"), (55, "C"), (40, "D"), (0, "F")]


def grade_of(score: float) -> str:
    for cut, g in GRADE_CUTS:
        if score >= cut:
            return g
    return "F"


def grade_to_min_score(grade: str) -> float:
    """Accept a letter ('A','b+') or a raw number ('72')."""
    g = str(grade).strip().upper()
    table = {"A+": 85, "A": 75, "B": 65, "C": 55, "D": 40, "F": 0}
    if g in table:
        return float(table[g])
    try:
        return float(g)
    except ValueError:
        return 55.0


POOL_IMP = {
    "PDH": 1.00, "PDL": 1.00, "LON_H": 0.85, "LON_L": 0.85,
    "ASIA_H": 0.80, "ASIA_L": 0.80, "EQH": 0.70, "EQL": 0.70,
}


def _c01(x: float) -> float:
    return 0.0 if x != x else max(0.0, min(1.0, x))  # x!=x catches NaN


def _smooth(x: float) -> float:
    t = _c01(x)
    return t * t * (3.0 - 2.0 * t)


def displacement_strength(df: pd.DataFrame, i: int, direction: int,
                          atr_arr: np.ndarray, lookback: int = 3) -> float:
    """0..1 multi-bar impulse strength ending at bar i (generalizes the ICT candle)."""
    o = df["open"].to_numpy(); c = df["close"].to_numpy()
    high = df["high"].to_numpy(); low = df["low"].to_numpy()
    a = atr_arr[i]
    if a != a or a <= 0:
        return 0.0
    lo = max(2, i - lookback + 1)
    best_body = 0.0
    for j in range(lo, i + 1):
        body = (c[j] - o[j]) * direction
        if body > 0:
            best_body = max(best_body, body / a)
    has_fvg = False
    for j in range(lo, i + 1):
        if direction > 0 and low[j] > high[j - 2]:
            has_fvg = True
        if direction < 0 and high[j] < low[j - 2]:
            has_fvg = True
    return _c01(0.6 * _c01(best_body / 3.0) + 0.4 * (1.0 if has_fvg else 0.0))


def score_candidate(ctx: Context, *, sweep, mss, entry: float, stop: float,
                    target: float, entry_kind: str, target_tag: str,
                    fvg, bias: int, rng, ote_ok: bool, smt_ok: bool,
                    lvn: bool) -> dict:
    """Fuse the six modules for one armed candidate. Returns score, grade, breakdown."""
    df = ctx.df
    c = df["close"].to_numpy()
    d = mss.direction
    m = mss.idx
    a = ctx.atr[m]
    a = a if (a == a and a > 0) else max(ctx.tick, 1e-9)
    risk = abs(entry - stop)
    rr = abs(target - entry) / risk if risk > 0 else 0.0

    # ---- Structure (0..20) ----
    shift_kind = 0.6 if mss.kind == "CHoCH" else 0.4          # CHoCH/MSS > continuation BOS
    disp01 = displacement_strength(df, m, d, ctx.atr)
    break_dist = _c01(abs(c[m] - mss.level) / (0.5 * a))
    leg_len = _c01(abs(mss.level - mss.opp_price) / (3.0 * a))
    fragility = 1.0 if bias == d else 0.6                     # break against HTF bias = fragile
    struct01 = _c01(0.35 * shift_kind + 0.30 * disp01 + 0.20 * break_dist + 0.15 * leg_len) * fragility
    s_struct = 20.0 * struct01

    # ---- Liquidity (0..20) ----
    pool_imp = POOL_IMP.get(sweep.ltype, 0.5)
    sweep_mag = _c01(abs(sweep.extreme - sweep.level) / (0.75 * a))
    reclaim = _c01((c[sweep.idx] - sweep.level) * d / (0.5 * a))
    real_target = target_tag != "RR"
    draw_q = 1.0 if real_target else _c01(rr / 3.0)
    liq01 = _c01(0.35 * pool_imp + 0.25 * sweep_mag + 0.20 * reclaim + 0.20 * draw_q)
    s_liq = 20.0 * liq01

    # ---- FVG (0..20) ----
    if fvg is not None:
        width_q = _c01(fvg.size / (1.2 * a))
        fresh_q = _c01(1.0 - (m - fvg.idx) / 30.0)
        fvg01 = _c01(0.45 * width_q + 0.30 * fresh_q + 0.25)   # +0.25 for existing at all
    else:
        fvg01 = 0.30                                            # OB-only entry: partial credit
    s_fvg = 20.0 * fvg01

    # ---- Order Block (0..15) ----
    if entry_kind.startswith("OB"):
        ob01 = 0.75
    elif fvg is not None:
        ob01 = 0.50                                             # FVG entry; OB likely overlaps
    else:
        ob01 = 0.30
    s_ob = 15.0 * ob01

    # ---- Displacement (0..15), convex/saturating ----
    s_disp = 15.0 * _smooth(disp01)

    # ---- Context (0..10) ----
    kz = _sessions.active_killzones(ctx.df_ny.index[m])
    kz_on = 1.0 if kz else 0.0
    bias_on = 1.0 if bias == d else (0.5 if bias == 0 else 0.0)
    pd_on = 0.0
    if rng is not None:
        frac = rng.frac(entry)
        pd_on = 1.0 if ((d > 0 and frac < 0.5) or (d < 0 and frac > 0.5)) else 0.0
    ote_on = 1.0 if ote_ok else 0.0
    ctx01 = _c01(0.4 * kz_on + 0.3 * bias_on + 0.2 * pd_on + 0.1 * ote_on)
    s_ctx = 10.0 * ctx01

    base = s_struct + s_liq + s_fvg + s_ob + s_disp + s_ctx

    # ---- Confluence bonus (independent agreements amplify, nonlinear) ----
    conf = [
        (1.5, 1.0 if bias == d else 0.0),                     # HTF bias agrees
        (1.5, disp01),                                        # displacement at shift
        (1.5, 1.0 if mss.kind == "CHoCH" else 0.0),           # true structure shift
        (1.0, 1.0 if fvg is not None else 0.0),               # PD-array present
        (1.0, 1.0 if real_target else 0.0),                   # real draw-on-liquidity
        (0.75, pd_on),                                        # discount/premium correct
        (1.0, 1.0 if smt_ok else 0.0),                        # SMT divergence
        (0.75, kz_on),                                        # killzone
    ]
    wsum = sum(w for w, _ in conf)
    frac = sum(w * v for w, v in conf) / wsum if wsum else 0.0
    bonus = 15.0 * (_c01(frac) ** 1.5)

    # ---- Penalties ----
    pen = 0.0
    if bias == -d:
        pen += 12.0                                           # counter-HTF-bias
    if disp01 < 0.30:
        pen += 8.0 * _c01((0.30 - disp01) / 0.30)             # weak displacement
    if rng is not None:
        frac = rng.frac(entry)
        if (d > 0 and frac > 0.55) or (d < 0 and frac < 0.45):
            pen += 6.0                                        # long in premium / short in discount
    if rr < 2.0:
        pen += 4.0 * _c01((2.0 - rr) / 2.0)                  # thin reward

    score = max(0.0, min(100.0, base + bonus - pen))
    return {
        "score": round(score, 1),
        "grade": grade_of(score),
        "struct": round(s_struct, 1), "liq": round(s_liq, 1), "fvg": round(s_fvg, 1),
        "ob": round(s_ob, 1), "disp": round(s_disp, 1), "ctx": round(s_ctx, 1),
        "bonus": round(bonus, 1), "pen": round(pen, 1),
    }


def build_confidence_setups(ctx: Context, cfg: ModelConfig,
                            min_score: float = 55.0) -> list[Setup]:
    """Same raid->MSS->PD-array skeleton as models.build_setups, but every armed
    candidate is graded by the fused confidence engine and only those with
    score >= min_score become BUY/SELL setups (model='confluence')."""
    df = ctx.df
    df_ny = ctx.df_ny
    n = len(df)
    events_by_idx = sorted(ctx.events, key=lambda e: e.idx)
    ev_idx = np.array([e.idx for e in events_by_idx]) if events_by_idx else np.array([], dtype=int)

    setups: list[Setup] = []
    for sw in ctx.sweeps:
        d = sw.reversal_dir
        if cfg.pool_types and sw.ltype not in cfg.pool_types:
            continue

        # 1) first same-direction MSS within the window after the raid.
        j0 = int(np.searchsorted(ev_idx, sw.idx + 1, side="left")) if len(ev_idx) else 0
        mss = None
        for k in range(j0, len(events_by_idx)):
            e = events_by_idx[k]
            if e.idx > sw.idx + cfg.mss_window:
                break
            if e.direction != d:
                continue
            if cfg.require_displacement and not displacement_at(df, e.idx, d, ctx.atr):
                continue
            mss = e
            break
        if mss is None:
            continue
        m = mss.idx

        # 2) killzone gate (if the preset restricts).
        if cfg.killzones:
            kz = _sessions.active_killzones(df_ny.index[m])
            if not any(z in cfg.killzones for z in kz):
                continue

        bias = int(ctx.bias[m])

        # 3) entry: FVG in the displacement leg, else order block.
        fvg = _recent_fvg(ctx, d, sw.idx, m)
        entry = entry_kind = None
        if fvg is not None:
            entry, entry_kind = _fvg_entry(fvg, cfg.entry_mode), f"FVG_{cfg.entry_mode}"
        elif cfg.use_order_block_fallback:
            ob = order_block_before(df, m, d, max_lookback=cfg.mss_window)
            if ob is not None:
                entry, entry_kind = (ob.top + ob.bottom) / 2.0, "OB_CE"
        if entry is None:
            continue

        # 4) stop beyond the raid extreme, entry on the right side.
        buf = cfg.stop_buffer_ticks * ctx.tick
        stop = sw.extreme - buf if d > 0 else sw.extreme + buf
        risk = abs(entry - stop)
        if risk <= 0 or (d > 0 and not stop < entry) or (d < 0 and not stop > entry):
            continue

        # 5) target = opposing draw on liquidity.
        target, tgt_tag = _target_pool(ctx, entry, d, m, risk, cfg)
        if (d > 0 and not target > entry) or (d < 0 and not target < entry):
            continue
        rr = abs(target - entry) / risk
        if rr < cfg.min_rr - 1e-9:
            continue

        # 6) confluence inputs, then the fused grade.
        rng = current_range(ctx.swings, m)
        ote_ok = in_ote(entry, rng.low, rng.high, d) if rng is not None else False
        smt_ok = smt_confirms(df, ctx.secondary, m, d) if ctx.secondary is not None else False
        vp = _prior_profile(ctx, m)
        lvn = bool(vp is not None and vp.is_lvn(entry))

        g = score_candidate(ctx, sweep=sw, mss=mss, entry=entry, stop=stop, target=target,
                            entry_kind=entry_kind, target_tag=tgt_tag, fvg=fvg, bias=bias,
                            rng=rng, ote_ok=ote_ok, smt_ok=smt_ok, lvn=lvn)
        if g["score"] < min_score:
            continue

        meta = {"pool": sw.ltype, "entry_kind": entry_kind, "target_tag": tgt_tag,
                "bias": bias, "rr": round(rr, 2), "grade": g["grade"],
                "conf_score": g["score"], "signal": "BUY" if d > 0 else "SELL",
                "m_struct": g["struct"], "m_liq": g["liq"], "m_fvg": g["fvg"],
                "m_ob": g["ob"], "m_disp": g["disp"], "m_ctx": g["ctx"],
                "bonus": g["bonus"], "pen": g["pen"]}
        setups.append(Setup(
            arm_idx=m, expiry_idx=min(n - 1, m + cfg.entry_valid_bars), direction=d,
            entry=float(entry), stop=float(stop), target=float(target),
            model="confluence", score=int(round(g["score"])), meta=meta,
        ))

    setups.sort(key=lambda s: s.arm_idx)
    return setups

