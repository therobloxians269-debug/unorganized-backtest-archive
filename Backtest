print("\n--- SWITCHING TO LIVE ENGINE (MES=F) ---")
 
ticker = 'MES=F'
starting_balance = equity_curve.iloc[-1]  # Carry forward backtest ending balance
contract_multiplier = 5.0
current_pos = 0
entry_price = 0.0
current_contracts = 0
last_keep_alive = time.time()
 
while True:
    try:
        # Keep connection alive every 10 minutes
        if time.time() - last_keep_alive > 600:
            accounts_api.list_accounts()
            last_keep_alive = time.time()
 
        # Fetch recent bars
        df = yf.download(ticker, period='15d', interval='1h', progress=False)
        if df.empty:
            print("Data feed temporarily empty. Retrying...")
            time.sleep(10)
            continue
 
        if isinstance(df.columns, pd.MultiIndex):
            df.columns = df.columns.get_level_values(0)
 
        # Indicators
        df['EMA_Trend'] = df['Close'].ewm(span=200, adjust=False).mean()
        df['VWAP'] = (
            (df['Close'] * df['Volume']).rolling(50).sum() /
            df['Volume'].rolling(50).sum()
        )
        df['Z_Score'] = (df['Close'] - df['VWAP']) / df['Close'].rolling(50).std()
 
        high_low = df['High'] - df['Low']
        high_close = np.abs(df['High'] - df['Close'].shift(1))
        low_close = np.abs(df['Low'] - df['Close'].shift(1))
        df['ATR'] = (
            pd.concat([high_low, high_close, low_close], axis=1)
            .max(axis=1)
            .rolling(14)
            .mean()
        )
 
        row = df.iloc[-1]
        cp = float(row['Close'])
        atr = float(row['ATR'])
        vwap = float(row['VWAP'])
        z_score = float(row['Z_Score'])
        ema_trend = float(row['EMA_Trend'])
 
        if any(pd.isna(v) for v in [cp, atr, vwap, z_score, ema_trend]):
            print("Warming up calculations...")
            time.sleep(10)
            continue
 
        atr_median = df['ATR'].rolling(100).median().iloc[-1]
        base_contracts = max(1, int(starting_balance // 1000))
 
        open_pnl = 0.0
 
        # EXIT LOGIC
        if current_pos != 0:
            pnl_pts = (cp - entry_price) if current_pos == 1 else (entry_price - cp)
            open_pnl = pnl_pts * contract_multiplier * current_contracts
 
            exit_condition = (
                (current_pos == 1 and cp >= vwap) or
                (current_pos == -1 and cp <= vwap) or
                (pnl_pts < -1.5 * atr)
            )
 
            if exit_condition:
                realized_pnl = open_pnl - (current_contracts * 2.80)
                starting_balance += realized_pnl
                direction = "LONG" if current_pos == 1 else "SHORT"
 
                print(f"\n❌ [{datetime.now().strftime('%H:%M:%S')}] EXIT {direction} @ {cp:.2f}")
                print(f"💰 Realized PnL: ${realized_pnl:,.2f} | Balance: ${starting_balance:,.2f}\n")
 
                log_to_file(f"EXIT_{direction}", cp, round(realized_pnl, 2), round(starting_balance, 2))
 
                current_pos = 0
                current_contracts = 0
                open_pnl = 0.0
 
        # ENTRY LOGIC
        if current_pos == 0:
            long_signal = (cp > ema_trend) and (z_score < -2.2)
            short_signal = (cp < ema_trend) and (z_score > 2.2)
 
            if long_signal:
                current_pos, entry_price, current_contracts = 1, cp, base_contracts
                print(f"\n🚀 [{datetime.now().strftime('%H:%M:%S')}] BUY @ {cp:.2f} | {base_contracts} contracts")
                log_to_file("ENTRY_LONG", cp, 0.0, round(starting_balance, 2))
 
            elif short_signal:
                current_pos, entry_price, current_contracts = -1, cp, base_contracts
                print(f"\n📉 [{datetime.now().strftime('%H:%M:%S')}] SELL @ {cp:.2f} | {base_contracts} contracts")
                log_to_file("ENTRY_SHORT", cp, 0.0, round(starting_balance, 2))
 
        # LIVE DASHBOARD
        pnl_color = "🟩" if open_pnl > 0 else ("🟥" if open_pnl < 0 else "⚪")
        print(
            f"⏱️ [{datetime.now().strftime('%H:%M:%S')}] | "
            f"Price: {cp:<8.2f} | Z: {z_score:>5.2f} | "
            f"Pos: {current_pos:>2} | Entry: {entry_price:<8.2f} | "
            f"Open PnL: {pnl_color} ${open_pnl:,.2f}"
        )
 
        time.sleep(60)
 
    except Exception as e:
        print(f"Error encountered: {e}")
        time.sleep(15)
 

