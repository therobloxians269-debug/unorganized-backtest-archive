    print(f'  {"morning statistic":28s} {"AUC":>6s}  {"MR-day mean":>12s} {"TREND-day mean":>15s}')
    for nm,col in [('Lo-MacKinlay VR(2)','vr2'),('  VR(2) z-stat (M2)','z2'),
                   ('Lo-MacKinlay VR(5)','vr5'),('  VR(5) z-stat (M2)','z5'),
                   ('Lo-MacKinlay VR(10)','vr10'),('Hurst exponent (R/S)','H'),
                   ('OU half-life','hl'),('lag-1 autocorrelation','ac1'),
                   ('Kaufman efficiency ratio','er'),('ib_de (my old proxy)','ib_de')]:
