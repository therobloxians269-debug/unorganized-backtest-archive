"""Block-to-block: enter at one rejection block, target the OPPOSING block."""
import pandas as pd, numpy as np, warnings; warnings.filterwarnings('ignore')
FLAT=1019
def trade_b2b(df, R, mode='nearest', nth=1, tgt_edge='near', buf=2.0, min_rr=0.0, max_rr=999.,
              min_conf_entry=4, min_conf_tgt=1, max_hold=390, unmitigated=True,
              pv=20., comm=4., slip=0.25, cooldown=5, displace=None, seed=0):
    o,h,l,c=df.o.values,df.h.values,df.l.values,df.c.values
    m=(df.index.hour*60+df.index.minute).values; n=len(df)
    rng=np.random.default_rng(seed); out=[]; last=-10**9
    Ri=R.i.values.astype(int); Rd=R.dir.values.astype(int)
    Rt=R.top.values; Rb=R.bot.values; Rn=R.n.values
    for x in range(len(R)):
        if Rn[x]<min_conf_entry: continue
        i=int(Ri[x]); d=int(Rd[x])
        if i<=last+cooldown or i+2>=n or (FLAT<=m[i]<1080): continue
        top,bot=Rt[x],Rb[x]
        if displace is not None:
            sh=displace*(1 if rng.random()<.5 else -1); top+=sh; bot+=sh
        ep=o[i+1]+(slip if d==1 else -slip)
        st=(bot-buf) if d==1 else (top+buf)
        if (d==1 and st>=ep) or (d==-1 and st<=ep): continue
        risk=abs(ep-st)
        if risk<1.0: continue
        # ---- the DYNAMIC target: the opposing rejection block in the profit direction
        prior = (Ri<i) & (Rd==-d) & (Rn>=min_conf_tgt)
        if unmitigated:
            pass
        cand_t=Rt[prior]; cand_b=Rb[prior]; cand_i=Ri[prior]
        if len(cand_t)==0: continue
        if d==1:   # long -> opposing (bearish) block ABOVE
            sel=cand_b>ep
            if not sel.any(): continue
            lv = np.sort(cand_b[sel] if tgt_edge=='near' else (cand_t[sel] if tgt_edge=='far' else (cand_b[sel]+cand_t[sel])/2))
            if mode=='nth':      tg = lv[min(nth-1,len(lv)-1)]
            elif mode=='nearest':tg = lv[0]
            else:                tg = lv[-1]
        else:      # short -> opposing (bullish) block BELOW
            sel=cand_t<ep
            if not sel.any(): continue
            lv = np.sort(cand_t[sel] if tgt_edge=='near' else (cand_b[sel] if tgt_edge=='far' else (cand_b[sel]+cand_t[sel])/2))[::-1]
            if mode=='nth':      tg = lv[min(nth-1,len(lv)-1)]
            elif mode=='nearest':tg = lv[0]
            else:                tg = lv[-1]
        rr=abs(tg-ep)/risk
        if rr<min_rr or rr>max_rr: continue
        e=min(i+1+max_hold,n); mm=m[i+1:e]
        fl=np.where((mm>=FLAT)&(mm<1080))[0]
        e2=i+1+int(fl[0]) if len(fl) else e
        hs=h[i+1:e2]; ls=l[i+1:e2]
        if len(hs)==0: continue
        sh_=(hs>=st) if d==-1 else (ls<=st)
        th=(ls<=tg) if d==-1 else (hs>=tg)
        si=int(sh_.argmax()) if sh_.any() else 10**9
        ti=int(th.argmax()) if th.any() else 10**9
        if si==10**9 and ti==10**9: k=e2-1; px=o[k]; w='time'
        elif si<=ti: k=i+1+si; px=st+(slip if d==-1 else -slip); w='stop'
        else: k=i+1+ti; px=tg; w='tgt'
        pts=(ep-px) if d==-1 else (px-ep)
        out.append(dict(t=df.index[i+1],d=d,n=Rn[x],rr=rr,risk=risk,
                        R=(pts*pv-comm)/(risk*pv),pnl=pts*pv-comm,why=w,bars=k-i))
        last=k
    return pd.DataFrame(out)

