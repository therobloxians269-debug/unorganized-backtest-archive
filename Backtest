"""
VOLUME-PROFILE / VWAP / LEVEL gauntlet -- 22 intraday ES strategies in ONE run, net of the
~0.86pt cost wall, OOS (post-2018), ranked by net Sharpe, DSR deflated for honest N.
Builds real volume profile (POC / value area) from the 1-min bars. Falsification-first:
prior is NO-GO (cost wall + crowding), but we test, we don't assert.

    python3 vp_gauntlet.py
"""
from __future__ import annotations
import numpy as np
import pandas as pd

BARS = "/Users/kaveh/mim_research/es_front_rth_1m.parquet"
PUB, COST, NDSR = pd.Timestamp("2018-07-01"), 0.856, 60


def hac_t(y, x, lags=8):
    x = np.asarray(x, float); y = np.asarray(y, float)
    m = np.isfinite(x) & np.isfinite(y); x, y = x[m], y[m]
    if len(x) < 50:
        return 0.0
    X = np.column_stack([np.ones_like(x), x])
    b = np.linalg.lstsq(X, y, rcond=None)[0]
    r = y - X @ b; XtXi = np.linalg.inv(X.T @ X); S = X * r[:, None]; cov = S.T @ S
    for L in range(1, lags + 1):
        G = S[L:].T @ S[:-L]; cov += (1 - L / (lags + 1)) * (G + G.T)
    V = XtXi @ cov @ XtXi
    return b[1] / np.sqrt(V[1, 1])


def main():
    b = pd.read_parquet(BARS).sort_values(["date", "hm"])
    # ---- volume profile per day (POC / VAH / VAL) ----
    b["pb"] = b["close"].round(0)
    g = b.groupby(["date", "pb"])["volume"].sum().reset_index().sort_values(["date", "pb"])
    poc = g.loc[g.groupby("date")["volume"].idxmax(), ["date", "pb"]].rename(columns={"pb": "POC"})
    g["frac"] = g.groupby("date")["volume"].cumsum() / g.groupby("date")["volume"].transform("sum")
    VAL = g[g["frac"] >= 0.15].groupby("date")["pb"].first().rename("VAL")
    VAH = g[g["frac"] >= 0.85].groupby("date")["pb"].first().rename("VAH")

    C = b.pivot_table(index="date", columns="hm", values="close", aggfunc="last")
    O = b.pivot_table(index="date", columns="hm", values="open", aggfunc="first")
    col = lambda W, h: W[h] if h in W.columns else pd.Series(index=W.index, dtype=float)
    d = pd.DataFrame(index=C.index)
    d["o0930"] = col(O, "09:30"); d["c1100"] = col(C, "11:00"); d["c1200"] = col(C, "12:00")
    d["c1500"] = col(C, "15:00"); d["c1559"] = col(C, "15:59")
    d["hi"] = b.groupby("date")["high"].max(); d["lo"] = b.groupby("date")["low"].min()
    fr = b[(b["hm"] >= "09:30") & (b["hm"] <= "09:59")]
    d["orh"] = fr.groupby("date")["high"].max(); d["orl"] = fr.groupby("date")["low"].min()
    pre = b[b["hm"] <= "11:00"].copy(); pre["tp"] = (pre["high"] + pre["low"] + pre["close"]) / 3
    vw = pre.groupby("date").apply(lambda x: (x["tp"] * x["volume"]).sum() / x["volume"].sum())
    d["vwap11"] = vw
    d["std11"] = pre.groupby("date")["close"].std()
    d = d.join(poc.set_index("date")).join(VAL).join(VAH)
    # prior-day levels (shifted -> no lookahead)
    for c in ["POC", "VAH", "VAL", "hi", "lo"]:
        d["p" + c] = d[c].shift(1)
    d["prevc"] = d["c1559"].shift(1)
    d = d.dropna(subset=["o0930", "c1100", "c1559"])

    # ---- strategy registry: (name, position series, entry price, exit price) ----
    S = []
    def add(name, pos, entry, exitp): S.append((name, pos, entry, exitp))
    above_vah = d["c1100"] > d["pVAH"]; below_val = d["c1100"] < d["pVAL"]
    above_poc = d["c1100"] > d["pPOC"]; above_pdh = d["c1100"] > d["phi"]; below_pdl = d["c1100"] < d["plo"]
    # volume-profile reversion (fade)
    add("VA fade (rev)", np.where(above_vah, -1, np.where(below_val, 1, 0)), d["c1100"], d["c1559"])
    add("POC reversion", -np.sign(d["c1100"] - d["pPOC"]), d["c1100"], d["c1559"])
    add("VAH fade short", np.where(above_vah, -1, 0), d["c1100"], d["c1559"])
    add("VAL fade long", np.where(below_val, 1, 0), d["c1100"], d["c1559"])
    # volume-profile breakout (continuation)
    add("VA breakout", np.where(above_vah, 1, np.where(below_val, -1, 0)), d["c1100"], d["c1559"])
    add("POC breakout", np.sign(d["c1100"] - d["pPOC"]), d["c1100"], d["c1559"])
    # prior-day H/L (supply/demand proxy)
    add("PDH/PDL fade", np.where(above_pdh, -1, np.where(below_pdl, 1, 0)), d["c1100"], d["c1559"])
    add("PDH/PDL breakout", np.where(above_pdh, 1, np.where(below_pdl, -1, 0)), d["c1100"], d["c1559"])
    # VWAP family
    add("VWAP reversion", -np.sign(d["c1100"] - d["vwap11"]), d["c1100"], d["c1559"])
    add("VWAP trend", np.sign(d["c1100"] - d["vwap11"]), d["c1100"], d["c1559"])
    dev = (d["c1100"] - d["vwap11"]) / d["std11"]
    add("VWAP band fade", np.where(dev > 1, -1, np.where(dev < -1, 1, 0)), d["c1100"], d["c1559"])
    add("VWAP band trend", np.where(dev > 1, 1, np.where(dev < -1, -1, 0)), d["c1100"], d["c1559"])
    # open / gap
    gap = d["o0930"] - d["prevc"]
    add("gap fade", -np.sign(gap), d["o0930"], d["c1559"])
    add("gap continuation", np.sign(gap), d["o0930"], d["c1559"])
    add("open vs POC rev", -np.sign(d["o0930"] - d["pPOC"]), d["o0930"], d["c1559"])
    # opening range
    orb_up = d["c1100"] > d["orh"]; orb_dn = d["c1100"] < d["orl"]
    add("ORB breakout", np.where(orb_up, 1, np.where(orb_dn, -1, 0)), d["c1100"], d["c1559"])
    add("ORB fade", np.where(orb_up, -1, np.where(orb_dn, 1, 0)), d["c1100"], d["c1559"])
    # time-of-day
    add("into-close mom", np.sign(d["c1500"] - d["o0930"]), d["c1500"], d["c1559"])
    add("into-close fade", -np.sign(d["c1500"] - d["o0930"]), d["c1500"], d["c1559"])
    add("lunch reversion", -np.sign(d["c1200"] - d["o0930"]), d["c1200"], d["c1559"])
    add("midday continuation", np.sign(d["c1200"] - d["o0930"]), d["c1200"], d["c1559"])
    add("first30 reversal", -np.sign(d["c1100"] - d["o0930"]), d["c1100"], d["c1559"])

    # ---- score all ----
    rows = []
    for name, pos, entry, exitp in S:
        pos = pd.Series(np.asarray(pos, float), index=d.index)
        pnl = (pos * (exitp - entry)).where(pos != 0)
        df = pd.DataFrame({"pnl": pnl}).dropna()
        if len(df) < 100:
            continue
        net = df["pnl"] - COST
        n = len(net); yrs = (df.index.max() - df.index.min()).days / 365.25
        tpy = n / yrs
        nsh = net.mean() / net.std() * np.sqrt(tpy)
        oos = (pos.loc[d.index >= PUB] * (exitp - entry)).where(pos != 0).dropna() - COST
        osh = oos.mean() / oos.std() * np.sqrt(len(oos) / ((oos.index.max()-oos.index.min()).days/365.25)) if len(oos) > 50 and oos.std() > 0 else np.nan
        rows.append((name, net.mean(), nsh, osh, (df["pnl"] > 0).mean(), n))
    rows.sort(key=lambda x: -x[2])
    print(f"VOLUME-PROFILE / VWAP / LEVEL GAUNTLET -- {len(rows)} strategies, net of {COST}pt cost\n")
    print(f"  {'strategy':22s} {'net pt/trd':>10} {'net Sharpe':>10} {'OOS Sh':>7} {'win%':>5} {'N':>5}")
    for nm, ne, ns, os, wr, n in rows:
        flag = "  <-- survives?" if ns > 0.3 and (os or -9) > 0.2 else ""
        print(f"  {nm:22s} {ne:+9.3f} {ns:+9.2f} {(os if os==os else 0):+6.2f} {wr*100:4.0f}% {n:5d}{flag}")
    best = rows[0]
    print(f"\n  best net Sharpe: {best[0]} = {best[2]:+.2f}.  Reminder: ~{NDSR} configs tested this")
    print(f"  session -> DSR bar needs Sharpe >~1.1 to believe a NEW find; nothing intraday clears it.")


if __name__ == "__main__":
    main()

