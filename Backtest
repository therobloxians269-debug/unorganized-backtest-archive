#!/usr/bin/env python3
"""
FAMILY f6: VWAP / SIGMA-BAND MEAN REVERSION on NQ / MNQ 1-min.

Stage 0  : causal session-VWAP construction + LOOKAHEAD AUDIT
Stage 1  : conditional return distribution given N-sigma stretch vs unconditional
           (the cleanest test of the family -- run BEFORE any trade logic)
Stage 2  : trade-logic sweep on IS only, robustness-selected
Stage 3  : OOS1 / OOS2 evaluation of the frozen configs
Stage 4  : random-time placebo

Usage:  python3 f6_vwap-mr.py <stage>
"""
import sys, os, itertools, json, math
import numpy as np
import pandas as pd

pd.set_option('display.width', 220)
pd.set_option('display.max_columns', 60)
pd.set_option('display.max_rows', 300)

DIR = '/Users/kaveh/qt_cascade'
CACHE = os.path.join(DIR, '.f6_cache')
os.makedirs(CACHE, exist_ok=True)

# ---------------------------------------------------------------- costs
COSTS = {
    'NQ':  dict(point_val=20.0, comm_rt=4.00, slip=0.25),
    'MNQ': dict(point_val=2.0,  comm_rt=1.50, slip=0.25),
}
# micro-equivalent for drawdown reporting (1 MNQ contract)
MICRO = dict(point_val=2.0, comm_rt=1.50, slip=0.25)

# anchors: (name, hour, minute)
ANCHORS = {'a1800': (18, 0), 'a0600': (6, 0), 'a0930': (9, 30)}


# ================================================================ loading
def load(which):
    f = {'NQ': 'nq_v6.parquet', 'MNQ': 'mnq_v6.parquet'}[which]
    df = pd.read_parquet(os.path.join(DIR, f))
    df = df.sort_index()
    return df


def anchor_group(idx, hh, mm):
    """Group id = the most recent anchor time at or before each bar.
    Purely a function of the timestamp -> cannot leak."""
    t = idx
    anchor_today = t.normalize() + pd.Timedelta(hours=hh, minutes=mm)
    # if bar is before today's anchor, it belongs to yesterday's anchor
    grp = anchor_today.where(t >= anchor_today, anchor_today - pd.Timedelta(days=1))
    return grp


def add_vwap(df, name, hh, mm):
    """Causal running VWAP + volume-weighted stdev, anchored at (hh:mm).
    Value at bar t uses bars [anchor .. t] INCLUSIVE.  Signal is taken on the
    CLOSE of bar t and the trade is entered at open of bar t+1, so inclusive
    is correct and causal."""
    g = anchor_group(df.index, hh, mm)
    tp = (df['h'] + df['l'] + df['c']) / 3.0
    v = df['v'].astype('float64')
    key = pd.Series(g, index=df.index)
    pv = tp * v
    cum_v = pv.groupby(key).cumcount() * 0  # placeholder
    cv = v.groupby(key).cumsum()
    cpv = pv.groupby(key).cumsum()
    cpv2 = (tp * tp * v).groupby(key).cumsum()
    vwap = cpv / cv
    var = cpv2 / cv - vwap ** 2
    var = var.clip(lower=0.0)
    sd = np.sqrt(var)
    n = v.groupby(key).cumcount() + 1
    df['vwap_' + name] = vwap
    df['sd_' + name] = sd
    df['nbar_' + name] = n
    df['grp_' + name] = key
    return df


def build(df):
    for name, (hh, mm) in ANCHORS.items():
        df = add_vwap(df, name, hh, mm)
    # helpers
    df['ret1'] = df['c'].diff()
    return df


# ================================================================ audit
def lookahead_audit(df, nsamples=400, seed=7):
    """Recompute vwap/sd at random timestamps using ONLY df.loc[:t] and compare
    to the vectorised column.  Any use of a future bar would show up here."""
    rng = np.random.default_rng(seed)
    out = {}
    for name, (hh, mm) in ANCHORS.items():
        idx = df.index[df['nbar_' + name] >= 5]
        pick = rng.choice(len(idx), size=min(nsamples, len(idx)), replace=False)
        maxe_v, maxe_s = 0.0, 0.0
        for i in pick:
            t = idx[i]
            sub = df.loc[:t]                      # strictly bars up to and incl. t
            gt = df['grp_' + name].loc[t]
            sub = sub[sub['grp_' + name] == gt]
            tp = (sub['h'] + sub['l'] + sub['c']) / 3.0
            v = sub['v'].astype(float)
            w = float((tp * v).sum() / v.sum())
            var = float((tp * tp * v).sum() / v.sum() - w * w)
            s = math.sqrt(max(var, 0.0))
            maxe_v = max(maxe_v, abs(w - float(df['vwap_' + name].loc[t])))
            maxe_s = max(maxe_s, abs(s - float(df['sd_' + name].loc[t])))
        out[name] = (maxe_v, maxe_s)
    return out


def audit_future_invariance(df, name, hh, mm, ncut=25, seed=11):
    """STRONGER test: truncate the dataframe at a cut point, rebuild the feature
    from scratch on the truncated frame, and confirm the values at every bar
    <= cut are IDENTICAL to the full-history build.  If any bar's feature used a
    future bar, deleting the future would change it."""
    rng = np.random.default_rng(seed)
    cuts = rng.choice(np.arange(2000, len(df) - 10), size=ncut, replace=False)
    worst = 0.0
    for ci in cuts:
        cut = df.index[ci]
        sub = df.loc[:cut, ['o', 'h', 'l', 'c', 'v']].copy()
        sub = add_vwap(sub, name, hh, mm)
        a = sub['vwap_' + name].to_numpy()
        b = df['vwap_' + name].loc[:cut].to_numpy()
        d = np.nanmax(np.abs(a - b))
        a2 = sub['sd_' + name].to_numpy()
        b2 = df['sd_' + name].loc[:cut].to_numpy()
        d2 = np.nanmax(np.abs(a2 - b2))
        worst = max(worst, d, d2)
    return worst


# ================================================================ splits
def splits(nq, mnq):
    IS = nq[(nq.index >= '2023-01-01') & (nq.index < '2025-01-01')]
    O1 = nq[nq.index >= '2025-01-01']
    O2 = mnq
    return IS, O1, O2


# ================================================================ stage 1
# time-of-day masks per anchor (a session VWAP is only meaningful inside its
# own session; the raw anchor group runs all the way to the next anchor)
def sess_mask(d, aname):
    hm = d.index.hour * 60 + d.index.minute
    if aname == 'a0930':
        return (hm >= 9 * 60 + 30) & (hm <= 16 * 60 + 59)
    if aname == 'a0600':
        return (hm >= 6 * 60) & (hm <= 16 * 60 + 59)
    # a1800: overnight leg 18:00 -> 09:29
    return (hm >= 18 * 60) | (hm <= 9 * 60 + 29)


def clustered(vals, groups):
    """POOLED mean + day-cluster-robust SE.

    !! BUG FOUND AND FIXED IN MY OWN WORK !!
    The first version of this returned the MEAN OF PER-DAY MEANS.  That is
    badly biased for this problem: the count of qualifying bars on a day is
    path-dependent.  A day where price pokes 1.5 sigma above VWAP and
    immediately falls back contributes only a handful of bars, each getting
    weight 1/n_day; a day that goes above and STAYS above contributes hundreds
    of bars, each getting tiny weight.  Equal-weighting days therefore hugely
    overweights transient excursions, which revert by construction.  On a pure
    random-walk surrogate that estimator manufactured $30-$63/micro of fake
    "mean reversion" (see stage 1b).  The pooled mean is an honest conditional
    expectation (the conditioning set is F_t-measurable, so it is exactly zero
    under a martingale); only the SE needs the day clustering."""
    s = pd.DataFrame({'v': np.asarray(vals, dtype=float),
                      'g': np.asarray(groups)}).dropna()
    if len(s) == 0:
        return np.nan, np.nan, 0, 0
    mu = s['v'].mean()                       # POOLED, unbiased
    gsum = s.groupby('g')['v'].apply(lambda x: (x - mu).sum())
    n = len(s)
    k = len(gsum)
    if k < 5:
        return mu, np.nan, n, k
    se = np.sqrt((gsum ** 2).sum()) / n      # cluster-robust SE of the mean
    return mu, (mu / se if se > 0 else np.nan), n, k


def stage1(nq, mnq):
    """DRIFT-NEUTRAL conditional mean-reversion test.

    For a stretch of magnitude z, mean reversion pays  -sign(z) * fwd_return.
    A constant drift mu contaminates the two sides in opposite directions:
        E[MR | z<0] = +mu + effect ;  E[MR | z>0] = -mu + effect
    so the AVERAGE of the two sides is drift-neutral and isolates the true
    VWAP-reversion effect.  We report that, in points and $/micro, with a
    day-cycle-clustered t-stat (overlapping windows otherwise inflate t by
    roughly sqrt(h))."""
    IS, O1, O2 = splits(nq, mnq)
    HOR = [15, 30, 60, 120, 240]
    ZB = [(1.0, 1.5), (1.5, 2.0), (2.0, 2.5), (2.5, 3.0), (3.0, 99)]
    rows = []
    for sname, d in [('IS', IS), ('OOS1', O1), ('OOS2', O2)]:
        pv = 2.0   # report per MICRO everywhere so splits are comparable
        for aname in ANCHORS:
            z = (d['c'] - d['vwap_' + aname]) / d['sd_' + aname]
            ok = (d['nbar_' + aname] >= 30) & sess_mask(d, aname)
            for h in HOR:
                fwd = d['c'].shift(-h) - d['c']
                same = d['grp_' + aname].shift(-h) == d['grp_' + aname]
                insess = pd.Series(sess_mask(d, aname), index=d.index).shift(-h).fillna(False)
                base = ok & same & insess & fwd.notna() & z.notna()
                rec = {}
                for sgn, tag in [(1, 'up'), (-1, 'dn')]:
                    for lo, hi in ZB:
                        m = base & (z * sgn >= lo) & (z * sgn < hi)
                        if m.sum() < 50:
                            rec[(tag, lo)] = (np.nan, np.nan, 0, 0)
                            continue
                        mr = (-sgn) * fwd[m]
                        rec[(tag, lo)] = clustered(mr, d['daycycle'][m])
                for lo, hi in ZB:
                    mu_up, t_up, n_up, k_up = rec[('up', lo)]
                    mu_dn, t_dn, n_dn, k_dn = rec[('dn', lo)]
                    dn_ = 0.5 * (mu_up + mu_dn)   # drift-neutral effect, points
                    rows.append(dict(split=sname, anchor=aname, h=h, z=lo,
                                     mr_up=mu_up, mr_dn=mu_dn,
                                     driftneutral_pts=dn_,
                                     dn_usd_micro=dn_ * pv,
                                     t_up=t_up, t_dn=t_dn,
                                     n_up=n_up, n_dn=n_dn,
                                     days_up=k_up, days_dn=k_dn))
    r = pd.DataFrame(rows)
    r.to_csv(os.path.join(CACHE, 'stage1_cond.csv'), index=False)
    return r


# ================================================================ stage 1b
def make_martingale_surrogate(d, seed=0):
    """Exact martingale null: same bar timestamps, same volume series, same
    per-day realised 1-min vol, but iid gaussian increments -> a true random
    walk with NO mean reversion of any kind.  Any statistic that still fires on
    this is a property of the ESTIMATOR, not of the market."""
    rng = np.random.default_rng(seed)
    out = d[['v', 'daycycle', 'atr15']].copy()
    r = d['c'].diff()
    sd_by_day = r.groupby(d['daycycle']).transform('std').fillna(r.std())
    newr = rng.standard_normal(len(d)) * sd_by_day.to_numpy()
    # restart each day-cycle at the true open so price levels stay realistic
    first = ~d['daycycle'].duplicated()
    newr[first.to_numpy()] = 0.0
    dayopen = d['o'].where(first).ffill()
    csum = pd.Series(newr, index=d.index).groupby(d['daycycle']).cumsum()
    c = dayopen + csum
    out['c'] = c
    out['o'] = c.shift(1).fillna(c)
    hl = (d['h'] - d['l']).to_numpy() / 2.0
    out['h'] = c + hl * 0.5
    out['l'] = c - hl * 0.5
    return out


def dn_effect(d, aname, h, zlo, zhi=99):
    """drift-neutral MR effect in points for one cell"""
    z = (d['c'] - d['vwap_' + aname]) / d['sd_' + aname]
    ok = (d['nbar_' + aname] >= 30) & sess_mask(d, aname)
    fwd = d['c'].shift(-h) - d['c']
    same = d['grp_' + aname].shift(-h) == d['grp_' + aname]
    insess = pd.Series(sess_mask(d, aname), index=d.index).shift(-h).fillna(False)
    base = ok & same & insess & fwd.notna() & z.notna()
    res = []
    for sgn in (1, -1):
        m = base & (z * sgn >= zlo) & (z * sgn < zhi)
        if m.sum() < 50:
            res.append(np.nan)
            continue
        mu, t, n, k = clustered((-sgn) * fwd[m], d['daycycle'][m])
        res.append(mu)
    return 0.5 * (res[0] + res[1]), res[0], res[1]


def stage1b(nq, mnq, nseed=8):
    IS, O1, O2 = splits(nq, mnq)
    cells = [('a0930', 60, 1.5), ('a0930', 120, 1.5), ('a0600', 120, 1.5),
             ('a1800', 240, 1.5), ('a0930', 30, 2.0), ('a0930', 15, 2.0)]
    print('MARTINGALE-SURROGATE CONTROL for the drift-neutral MR statistic')
    print('If the surrogate reproduces the real number, the statistic is broken.\n')
    print(f'{"cell":28s} {"REAL $/mic":>11s} {"SURROGATE mean":>15s} {"sur sd":>8s} {"sur min..max":>18s}')
    for (a, h, z) in cells:
        real, _, _ = dn_effect(IS, a, h, z)
        sur = []
        for s in range(nseed):
            sg = make_martingale_surrogate(IS, seed=s)
            sg = build(sg)
            v, _, _ = dn_effect(sg, a, h, z)
            sur.append(v)
        sur = np.array(sur, dtype=float)
        print(f'{a}/h{h}/z>{z:<14.1f} {real*2:11.2f} {np.nanmean(sur)*2:15.2f} '
              f'{np.nanstd(sur)*2:8.2f} {np.nanmin(sur)*2:8.2f}..{np.nanmax(sur)*2:7.2f}')


