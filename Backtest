import numpy as np
import pandas as pd
from dataclasses import dataclass
import matplotlib.pyplot as plt

@dataclass
class InstrumentConfig:
    symbol: str
    tick_size: float
    point_value: float
    volume_target: int

class ILSAXEngine:
    def __init__(self, config: InstrumentConfig):
        self.config = config

    def transform_ticks_to_bars(self, df_ticks: pd.DataFrame) -> pd.DataFrame:
        """Aggregates raw ticks into structural volume bars."""
        df = df_ticks.copy()
        df['bar_idx'] = (df['volume'].cumsum() // self.config.volume_target).astype(int)
        
        bars = df.groupby('bar_idx').agg({
            'timestamp': 'last',
            'price': ['first', 'max', 'min', 'last'],
            'volume': 'sum'
        })
        bars.columns = ['timestamp', 'open', 'high', 'low', 'close', 'volume']
        bars['date'] = bars['timestamp'].dt.date
        
        # Institutional Features
        bars['vwap'] = (bars['close'] * bars['volume']).groupby(bars['date']).cumsum() / \
                       bars.groupby(bars['date'])['volume'].cumsum()
        bars['vwap_std'] = bars.groupby('date')['close'].transform(lambda x: x.expanding().std())
        bars['z_score'] = (bars['close'] - bars['vwap']) / bars['vwap_std']
        bars['volatility'] = bars['close'].pct_change().rolling(20).std()
        
        return bars.dropna()

    def generate_signals(self, df_bars: pd.DataFrame, z_threshold: float = 3.25) -> pd.DataFrame:
        """Generates alpha signals based on liquidity sweeps and Z-score extremes."""
        df = df_bars.copy()
        df['session_high'] = df.groupby('date')['high'].cummax().shift(1)
        df['session_low'] = df.groupby('date')['low'].cummin().shift(1)
        
        df['signal'] = 0
        # Long: Sweep of session low + Z-score exhaustion
        long_mask = (df['low'] < df['session_low']) & (df['z_score'] < -z_threshold)
        # Short: Sweep of session high + Z-score exhaustion
