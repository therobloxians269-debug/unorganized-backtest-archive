"""Shared metrics for the Box Theory backtest."""
import numpy as np
import pandas as pd

REF_ACCT = 2000.0  # nominal micro account for DD-in-account-multiples


def daily_pnl(trades):
    if len(trades) == 0:
        return pd.Series(dtype=float)
    return trades.groupby(trades["day"])["pnl_usd"].sum()


def summarize(trades, label=""):
    n = len(trades)
    if n == 0:
        return {"label": label, "trades": 0, "net": 0.0, "avg": 0.0, "win%": 0.0,
                "PF": 0.0, "sharpe": 0.0, "maxDD": 0.0, "DD_acct": 0.0, "calmar": 0.0,
                "yrs": 0.0}
    net = trades.pnl_usd.sum()
    wins = trades.pnl_usd[trades.pnl_usd > 0].sum()
    loss = -trades.pnl_usd[trades.pnl_usd < 0].sum()
    pf = wins / loss if loss > 0 else np.inf
    d = daily_pnl(trades)
    # full calendar of trading days present
    sharpe = (d.mean() / d.std() * np.sqrt(252)) if d.std() > 0 else 0.0
    eq = trades.sort_values("last_exit_t").pnl_usd.cumsum()
    peak = eq.cummax()
    dd = (eq - peak)
    maxdd = -dd.min() if len(dd) else 0.0
    yrs = (trades.day.max() - trades.day.min()).days / 365.25
    ann = net / yrs if yrs > 0 else 0.0
    calmar = ann / maxdd if maxdd > 0 else 0.0
    return {"label": label, "trades": n, "net": round(net), "avg": round(net / n, 2),
            "win%": round((trades.pnl_usd > 0).mean() * 100, 1),
            "PF": round(pf, 3), "sharpe": round(sharpe, 2),
            "maxDD": round(maxdd), "DD_acct": round(maxdd / REF_ACCT, 2),
            "calmar": round(calmar, 2), "yrs": round(yrs, 1),
            "ann": round(ann)}


def print_row(s):
    print(f"  {s['label']:<26} n={s['trades']:>5}  net=${s['net']:>8,}  "
          f"avg=${s['avg']:>7.2f}  win={s['win%']:>4.1f}%  PF={s['PF']:>5.3f}  "
          f"Sh={s['sharpe']:>5.2f}  maxDD=${s['maxDD']:>7,}  Calmar={s['calmar']:>5.2f}")

