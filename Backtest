#!/usr/bin/env python3
"""
equity_factors.py -- data layer + shared factor/gate helpers for arranged.py.

Provides the primitives arranged.py imports (_z, _shift, _logret, _rollvol, sharpe,
calmar, apply_costs, gate_stream, build_book) plus load_universe() for a free
cross-sectional US equity panel. Gate battery mirrors the proven sleeve gate:
net Sharpe, IS/OOS t-stat, block-bootstrap CI, deflated Sharpe.
"""
from __future__ import annotations
import numpy as np, math
from scipy.stats import skew as sk, kurtosis as ku, norm, ttest_1samp
ANN = math.sqrt(252)

# ---- primitives ----
def _z(X):
    mu = np.nanmean(X, 1, keepdims=True); sd = np.nanstd(X, 1, keepdims=True); sd[sd == 0] = 1e-9
    return (X - mu) / sd

def _shift(a, k):
    out = np.full_like(a, np.nan)
    if 0 < k < a.shape[0]: out[k:] = a[:-k]
    elif k == 0: out = a.copy()
    return out

def _logret(prices):
    r = np.zeros_like(prices)
    with np.errstate(invalid="ignore", divide="ignore"):
        r[1:] = np.log(prices[1:] / prices[:-1])
    r[~np.isfinite(r)] = 0.0
    return r

def _rollvol(prices, win=63):
    r = _logret(prices); v = np.full_like(prices, np.nan)
    for t in range(win, prices.shape[0]): v[t] = np.nanstd(r[t-win:t], 0)
    return v

def sharpe(x):
    x = x[np.isfinite(x)]; return x.mean()/x.std(ddof=1)*ANN if len(x) > 1 and x.std() > 0 else 0.0

def calmar(x):
    x = x[np.isfinite(x)]; eq = np.cumsum(x); dd = (eq-np.maximum.accumulate(eq)).min()
    return (x.mean()*252)/abs(dd) if dd < 0 else float("inf")

# ---- book construction (inverse-vol weighted, vol-targeted; lagged weights, no look-ahead) ----
def build_book(prices, score, target_vol=0.10/ANN, vol_win=63):
    rets = _logret(prices); T, N = rets.shape; W = np.zeros_like(score)
    for t in range(T):
        s = score[t]
        if np.all(np.isnan(s)): continue
        s = np.where(np.isnan(s), 0.0, s); s = s - s.mean()
        iv = 1.0/(np.nanstd(rets[max(0,t-vol_win):t+1], 0) + 1e-9)
        ws = s*iv; g = np.abs(ws).sum()
        if g > 0: ws /= g
        W[t] = ws
    Wl = np.roll(W, 1, 0); Wl[0] = 0; port = np.nansum(Wl*rets, 1)
    sd = port[np.isfinite(port)].std()
    if sd > 0: port *= target_vol/sd
    return port, W

def apply_costs(prices, W, cost_bps=5.0):
    rets = _logret(prices)
    dw = np.abs(np.diff(W, axis=0, prepend=W[:1])).sum(1)
    Wl = np.roll(W, 1, 0); Wl[0] = 0; gross = np.nansum(Wl*rets, 1)
    return gross - dw*(cost_bps*1e-4), gross, float(dw.mean())

# ---- gate battery ----
def _bootstrap(port, block=20, n=1000, seed=0):
    p = port[np.isfinite(port)]; m = len(p); rng = np.random.default_rng(seed); nb = int(np.ceil(m/block)); sh = np.empty(n)
    for i in range(n):
        st = rng.integers(0, m, nb); idx = (st[:,None]+np.arange(block)[None,:]).ravel()[:m] % m; sh[i] = sharpe(p[idx])
    return float(np.percentile(sh, 5)), float(np.percentile(sh, 95))

def _dsr(port, n_trials):
    p = port[np.isfinite(port)]; sd = p.std(ddof=1); srd = p.mean()/sd if sd > 0 else 0.0
    if len(p) < 10 or n_trials < 2: return float("nan")
    emax = (1-np.euler_gamma)*norm.ppf(1-1/n_trials)+np.euler_gamma*norm.ppf(1-1/(n_trials*math.e))
    sr0 = emax/math.sqrt(len(p)); den = math.sqrt(max(1e-9, 1-float(sk(p))*srd+(float(ku(p,fisher=False))-1)/4*srd**2))
    return float(norm.cdf((srd-sr0)*math.sqrt(len(p)-1)/den))

def gate_stream(name, prices, W, split, n_trials, bar=0.7, cost_bps=5.0):
    net, gross, turn = apply_costs(prices, W, cost_bps)
    IS, OOS = net[:split], net[split:]
    ISt  = float(ttest_1samp(IS[np.isfinite(IS)], 0).statistic)  if np.isfinite(IS).sum()  > 2 else float("nan")
    OOSt = float(ttest_1samp(OOS[np.isfinite(OOS)], 0).statistic) if np.isfinite(OOS).sum() > 2 else float("nan")
    lo, hi = _bootstrap(net); d = _dsr(net, n_trials)
    e = np.cumsum(net[np.isfinite(net)]); mdd = (e-np.maximum.accumulate(e)).min()*100
    ok = (sharpe(net) >= bar and OOSt > 1.5 and lo > 0 and (np.isfinite(d) and d > 0.9))
    print(f"    {name:9} NET Sh={sharpe(net):.2f}  IS Sh={sharpe(IS):.2f}(t={ISt:.1f})  "
          f"OOS Sh={sharpe(OOS):.2f}(t={OOSt:.1f})  maxDD={mdd:.1f}%  Calmar={calmar(net):.2f}  "
          f"bootCI[{lo:.2f},{hi:.2f}]  DSR(N={n_trials})={d:.2f}  turn={turn:.3f}/d  -> {'PASS' if ok else 'FAIL'}")
    return ok, net

# ---- free universe ----
def load_universe(start="2007-01-01", min_years=8):
    """Current S&P 500 (Wikipedia) -> yfinance auto-adjusted closes -> (prices,dates,names).

    SURVIVORSHIP + LOOK-AHEAD: uses TODAY'S membership applied to all history, so the
    panel contains only firms that survived and stayed large enough to be in the index
    now. That deletes the losers/delisted and front-runs index additions -> results are
    an OPTIMISTIC CEILING, not tradable as-is. Stated, not hidden.
    """
    import pandas as pd, requests, yfinance as yf
    from io import StringIO
    url = "https://en.wikipedia.org/wiki/List_of_S%26P_500_companies"
    html = requests.get(url, headers={"User-Agent": "Mozilla/5.0"}, timeout=30).text
    syms = pd.read_html(StringIO(html))[0]["Symbol"].astype(str).tolist()
    yf_syms = [s.replace(".", "-") for s in syms]
    data = yf.download(yf_syms, start=start, auto_adjust=True, progress=False, threads=True)["Close"]
    if isinstance(data, pd.Series): data = data.to_frame()
    need = int(min_years*252*0.8)
    keep = [c for c in data.columns if data[c].dropna().shape[0] >= need]
    data = data[keep].sort_index().ffill(limit=5)
    dates = data.index.values.astype("datetime64[D]")
    prices = data.values.astype(float)
    names = list(data.columns)
    print(f"[load_universe] S&P500 current constituents (Wikipedia): {len(syms)}")
    print(f"[load_universe] downloaded & kept (>= {min_years}y history): {len(names)}  dropped: {len(syms)-len(names)}")
    print(f"[load_universe] panel T={len(dates)}  {dates[0]}..{dates[-1]}  N={len(names)}")
    print(f"[load_universe] *** SURVIVORSHIP + LOOK-AHEAD BIAS: current membership over all history "
          f"-> optimistic ceiling; only forward/paper trading is real proof ***")
    return prices, dates, names

