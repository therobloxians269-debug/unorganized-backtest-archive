"""
Trailing exits on the validated cascade entry.

The screenshots show trades held for 200+ NQ points with a trailing stop.
Every exit I tested before was a CAP (fixed R, or a fixed level). A cap cannot
produce those trades. This tests what they actually do.

Entry  = QT cascade (lb 6, both refs, 09:30 internal open), stop at the
         manipulation extreme, capped at 0.1485% of price.
Exits  = fixed R  vs  ATR trail  vs  % trail  vs  breakeven-then-trail
"""
import numpy as np, pandas as pd
import qtlib as Q
from backtest import run, _stamp

LB, BOTH, IOPEN = 6, True, "tny_alt"
CAP_PCT = 0.1485
MNQ_PT, COST_PTS = 2.0, 1.12
FLAT_MIN = 16 * 60

m1 = Q.add_true_opens(Q.load_data(verbose=False))
b15, b5 = _stamp(Q.resample(m1, "15min")), _stamp(Q.resample(m1, "5min"))
pre = {"b15": b15, "b5": b5}
for s in ("short", "long"):
    pre[f"s15_{s}"] = Q.ssmt(b15, lookback=LB, side=s, require_both=BOTH)
    pre[f"s5_{s}"] = Q.ssmt(b5, lookback=LB, side=s, require_both=BOTH)

tr = pd.concat([run(m1, layers="L1L2", side=s, internal_open=IOPEN, pre=pre)
                for s in ("short", "long")], ignore_index=True).sort_values("entry_time")
tr = tr[tr["r_pts"] <= tr["entry"] * CAP_PCT / 100].reset_index(drop=True)
yrs = (pd.to_datetime(tr["entry_time"].iloc[-1]) - pd.to_datetime(tr["entry_time"].iloc[0])).days / 365.25
print(f"[entries] n={len(tr)}  {len(tr)/yrs:.0f}/yr  median stop {tr['r_pts'].median():.1f} pts\n")

m1 = m1.copy()
m1["tmin"] = m1.index.hour * 60 + m1.index.minute
atr = (m1["nq_high"] - m1["nq_low"]).rolling(60).mean()


def walk(exit_mode, param):
    """Simulate every trade bar by bar to the actual exit."""
    out = []
    for t in tr.itertuples():
        short = t.side == "short"
        d = m1[(m1["sdate"] == t.sdate) & (m1.index >= t.entry_time) & (m1["tmin"] <= FLAT_MIN)]
        if len(d) < 3:
            continue
        hi = d["nq_high"].to_numpy()
        lo = d["nq_low"].to_numpy()
        cl = d["nq_close"].to_numpy()
        a = atr.reindex(d.index).ffill().to_numpy()
        e, r = t.entry, t.r_pts
        stop = t.stop
        best = e
        exit_px = cl[-1]
        for k in range(len(d)):
            # initial / trailing stop hit
            if (short and hi[k] >= stop) or (not short and lo[k] <= stop):
                exit_px = stop
                break
            best = min(best, lo[k]) if short else max(best, hi[k])
            gain = (e - best) if short else (best - e)
            if exit_mode == "fixedR":
                tgt = e - param * r if short else e + param * r
                if (short and lo[k] <= tgt) or (not short and hi[k] >= tgt):
                    exit_px = tgt
                    break
            elif exit_mode == "atr":
                if gain > 0:
                    ns = best + param * a[k] if short else best - param * a[k]
                    stop = min(stop, ns) if short else max(stop, ns)
            elif exit_mode == "pct":
                dist = e * param / 100
                if gain > dist:
                    ns = best + dist if short else best - dist
                    stop = min(stop, ns) if short else max(stop, ns)
            elif exit_mode == "be_atr":
                if gain >= r and stop != e:          # move to breakeven at 1R
                    stop = e
                if gain > r:
                    ns = best + param * a[k] if short else best - param * a[k]
                    stop = min(stop, ns) if short else max(stop, ns)
        pts = (e - exit_px) if short else (exit_px - e)
        out.append(dict(R=pts / r, dollars=pts * MNQ_PT - COST_PTS * MNQ_PT, side=t.side))
    return pd.DataFrame(out)


print("=" * 104)
print("EXIT COMPARISON — same entries, 1 MNQ, costs charged")
print("=" * 104)
print(f"{'exit':>26} {'n':>6} {'win%':>7} {'avgR':>8} {'bestR':>8} {'$/yr':>10} {'maxDD$':>9} {'PF':>6}")
rows = []
for mode, param, name in [
    ("fixedR", 1.0, "fixed 1R"),
    ("fixedR", 2.0, "fixed 2R"),
    ("fixedR", 3.0, "fixed 3R"),
    ("atr", 1.0, "trail 1.0 ATR"),
    ("atr", 1.5, "trail 1.5 ATR"),
    ("atr", 2.0, "trail 2.0 ATR"),
    ("atr", 3.0, "trail 3.0 ATR"),
    ("pct", 0.10, "trail 0.10% price"),
    ("pct", 0.20, "trail 0.20% price"),
    ("pct", 0.30, "trail 0.30% price"),
    ("be_atr", 1.5, "BE at 1R + 1.5 ATR"),
    ("be_atr", 2.5, "BE at 1R + 2.5 ATR"),
]:
    res = walk(mode, param)
    if len(res) < 30:
        continue
    eq = np.cumsum(res["dollars"].to_numpy())
    dd = (np.maximum.accumulate(eq) - eq).max()
    w = res.loc[res["dollars"] > 0, "dollars"].sum()
    l = -res.loc[res["dollars"] < 0, "dollars"].sum()
    pf = w / l if l > 0 else np.inf
    print(f"{name:>26} {len(res):>6} {100*(res['R']>0).mean():>7.1f} {res['R'].mean():>8.3f} "
          f"{res['R'].max():>8.1f} {eq[-1]/yrs:>10,.0f} {dd:>9,.0f} {pf:>6.2f}")
    rows.append((eq[-1] / yrs, name, res))

