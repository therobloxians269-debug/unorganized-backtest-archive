(trend-filtered long-only XS-momentum, Sharpe ~1.3). A sleeve earns a slot ONLY if:
positive Sharpe AND |corr to keeper| < ~0.4 AND the stack's Sharpe rises.
All long-only/long-flat (shorts proved ruinous). Net of 25bp. Honest: N keeps growing.

    python3 sleeve_gauntlet.py
"""
from __future__ import annotations
import numpy as np, pandas as pd, yfinance as yf
from lib_perf import perf_stats

COINS = ["BTC-USD","ETH-USD","BNB-USD","XRP-USD","ADA-USD","SOL-USD","DOGE-USD","DOT-USD",
         "AVAX-USD","LINK-USD","LTC-USD","BCH-USD","ATOM-USD","XLM-USD","ETC-USD","TRX-USD",
         "UNI-USD","FIL-USD","ALGO-USD","VET-USD","HBAR-USD","NEAR-USD","AAVE-USD","MKR-USD",
         "EOS-USD","XTZ-USD","THETA-USD","AXS-USD","SAND-USD","MANA-USD"]
ANN, COST = 365, 25.0


def sh(r):
    r = r.dropna(); return r.mean()/r.std()*np.sqrt(ANN) if len(r) > 50 and r.std() > 0 else np.nan


def main():
    px = yf.download(COINS, start="2017-01-01", auto_adjust=True, progress=False)["Close"]
    px = px.dropna(how="all").dropna(axis=1, thresh=int(len(px)*0.20))
    rets = px.pct_change()
    av = (rets.rolling(60).std()*np.sqrt(ANN)).shift(1)
    n = px.shape[1]; k = max(3, n//3)
    mkt = (1+rets.mean(axis=1)).cumprod()
    up = (mkt > mkt.rolling(100).mean()).shift(1).reindex(px.index).fillna(True)
    soft = up.replace(False, 0.3).replace(True, 1.0).astype(float)
    def norm(m): return m.div(m.abs().sum(axis=1).replace(0, np.nan), axis=0).fillna(0.0)
    def ret_of(W, weekly=True):
        W = W.shift(1)
        if weekly:
            W = W.resample("W").last().reindex(px.index, method="ffill")
        return (((W*rets).sum(axis=1) - W.diff().abs().sum(axis=1)*COST*1e-4)).dropna()

    # KEEPER
    rank90 = px.pct_change(90).shift(1).rank(axis=1, ascending=False)
    keeper = ret_of(norm((rank90 <= k).astype(float)/av).mul(soft, axis=0))

    SL = {}
    # 1 short-term REVERSAL: long worst-7d third (contrarian bounce)
    r7 = px.pct_change(7).shift(1).rank(axis=1, ascending=True)
    SL["reversal 7d (long losers)"] = ret_of(norm((r7 <= k).astype(float)/av))
    # 2 LOW-VOL: long lowest-vol third
    rv = av.rank(axis=1, ascending=True)
    SL["low-vol third"] = ret_of(norm((rv <= k).astype(float)/av))
    # 3 BTC/ETH core trend (long/flat majors only) -- different book than alt momentum
    core = px[[c for c in ("BTC-USD","ETH-USD") if c in px.columns]]
    cz = sum(core.pct_change(L)/(core.pct_change().rolling(60).std()*np.sqrt(ANN)*np.sqrt(L/ANN)) for L in (60,120,240))/3
    SL["BTC/ETH core trend"] = ret_of(norm(np.tanh(cz).clip(lower=0)), weekly=True)
    # 4 ALT-SEASON rotation: alts only when alts outperform BTC over 30d (relative momentum regime)
    alt = (1+rets.drop(columns=[c for c in ("BTC-USD",) if c in rets.columns]).mean(axis=1)).cumprod()
    btc = (1+rets["BTC-USD"]).cumprod()
    altszn = ((alt/alt.shift(30)) > (btc/btc.shift(30))).shift(1).fillna(False).astype(float)
    SL["alt-season rotation"] = ret_of(norm((rank90 <= k).astype(float)/av).mul(altszn, axis=0))
    # 5 WEEKEND effect: hold market Fri close -> Mon (a-priori documented crypto weekend drift)
    eqw = norm(pd.DataFrame(1.0, index=px.index, columns=px.columns)/av)
    wkend = pd.Series(px.index.dayofweek, index=px.index).isin([5, 6, 0]).astype(float)
    SL["weekend-only market"] = ret_of(eqw.mul(wkend, axis=0), weekly=False)
    # 6 VOL-BREAKOUT: long market only after big down-vol spike reverts (post-crash rebound)
    mvol = rets.mean(axis=1).rolling(14).std()*np.sqrt(ANN)
    calm = ((mvol < mvol.rolling(90).median()) & up).shift(1).fillna(False).astype(float)
    SL["calm-regime market"] = ret_of(eqw.mul(calm, axis=0))

    print(f"keeper Sharpe {sh(keeper):.2f}   ({px.index[0].date()}->{px.index[-1].date()}, {n} coins)\n")
