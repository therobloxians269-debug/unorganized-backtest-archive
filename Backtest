#!/usr/bin/env python3
"""OCEAN family f11_firsthour_fade — first-hour extreme revisit fade (MES 1-lot).

RULES (pre-registered config = defaults below):
  First hour = bars 0..11 (09:30-10:30). FH_lo = min(low[0:12]), FH_hi = max(high[0:12]).
  From bar 12 to bar 76, watch for the FIRST touch of each extreme (one attempt
  per side per day; the first touch consumes the opportunity whether or not we trade):
    LONG : low[b]  <= FH_lo  and context OK  -> buy  at close[b] (market)
    SHORT: high[b] >= FH_hi and context OK  -> sell at close[b] (market)
  Context filter ("session not strongly trending against the fade"):
    LONG : er[b] < ER_THR  or  close[b] > vwap[b]
    SHORT: er[b] < ER_THR  or  close[b] < vwap[b]
  Target: resting limit at vwap[b] frozen at entry (fric 'target' = 0.41 pt).
  Stop  : beyond the extreme, STOP_K * atr[b] past FH_lo/FH_hi (floor 1.0 pt),
          checked intrabar only on bars strictly AFTER the entry bar; if stop and
          target are both touched in one bar the STOP is assumed filled (conservative).
  Sanity (structural, not swept): entry must be on the live side of its stop and
          have >= 1.0 pt of room to the vwap target; no entries on bar 77.
  EOD   : flatten at bar 77 close (fric 'eod').
Causality: all signals use only completed-bar values; fills at that bar's close.
"""
import sys, os, json, argparse, datetime as dt
import numpy as np, pandas as pd
sys.path.insert(0, "/Users/kaveh/mes_mim")
import omni2_lib as L
from omni2_lib import fric, DPP

FH_N = 12          # first hour = bars 0..11
ROOM_MIN = 1.0     # structural: min points of room to target
STOP_FLOOR = 1.0   # structural: min stop distance in points
DEV_END = dt.date(2022, 12, 31)

# ---------------- PRE-REGISTERED CONFIG (defaults) ----------------
PREREG = dict(er_thr=0.35, stop_k=1.0, mode="er_or_vwap")

def sim_day(s, er_thr, stop_k, mode):
    h, l, c, vwap, atr, er = s["h"], s["l"], s["c"], s["vwap"], s["atr"], s["er"]
    fh_lo = float(l[:FH_N].min()); fh_hi = float(h[:FH_N].max())
    pos = 0; entry = stop = target = np.nan; ebar = -1
    lo_used = hi_used = False
    out = []
    for b in range(FH_N, 78):
        # ---- exits (only on bars strictly after entry bar) ----
        if pos != 0 and b > ebar:
            g = None; kind = None
            if pos > 0:
                if l[b] <= stop:      g = (stop - entry) - fric("stop");  kind = "stop"
                elif h[b] >= target:  g = (target - entry) - fric("target"); kind = "target"
                elif b == 77:         g = (c[b] - entry) - fric("eod");   kind = "eod"
            else:
                if h[b] >= stop:      g = (entry - stop) - fric("stop");  kind = "stop"
                elif l[b] <= target:  g = (entry - target) - fric("target"); kind = "target"
                elif b == 77:         g = (entry - c[b]) - fric("eod");   kind = "eod"
            if g is not None:
                out.append((s["date"], g, abs(entry - stop), kind, pos))
                pos = 0
        # ---- entries: first touch per side only, decided at bar close ----
        if b < 77:
            if not lo_used and l[b] <= fh_lo:
                lo_used = True
                ok = (er[b] < er_thr) if mode == "er_only" else \
                     (c[b] > vwap[b]) if mode == "vwap_only" else \
                     True if mode == "always" else \
                     (er[b] < er_thr or c[b] > vwap[b])
                if pos == 0 and ok:
                    sd = max(stop_k * atr[b], STOP_FLOOR)
                    stp = fh_lo - sd; tgt = vwap[b]
                    if c[b] > stp and (tgt - c[b]) >= ROOM_MIN:
                        pos = 1; entry = c[b]; stop = stp; target = tgt; ebar = b
            if not hi_used and h[b] >= fh_hi:
                hi_used = True
                ok = (er[b] < er_thr) if mode == "er_only" else \
                     (c[b] < vwap[b]) if mode == "vwap_only" else \
                     True if mode == "always" else \
                     (er[b] < er_thr or c[b] < vwap[b])
                if pos == 0 and ok:
                    sd = max(stop_k * atr[b], STOP_FLOOR)
                    stp = fh_hi + sd; tgt = vwap[b]
                    if c[b] < stp and (c[b] - tgt) >= ROOM_MIN:
                        pos = -1; entry = c[b]; stop = stp; target = tgt; ebar = b
    return out

def run(S, **kw):
    rows = [dict(date=d, net=g, risk=r, kind=k, side=p)
            for s in S for d, g, r, k, p in sim_day(s, **kw)]
    return pd.DataFrame(rows, columns=["date", "net", "risk", "kind", "side"])

def stats(tr):
    if len(tr) == 0:
        return dict(net_usd=0.0, mar=0.0, trades=0, hit=0.0, maxdd_usd=0.0,
                    yearly={}, top3_month_share=0.0, expectancy_pts=0.0,
                    yrs_pos_frac=0.0, max_yr_share=1.0)
    tr = tr.copy(); tr["dt"] = pd.to_datetime(tr["date"])
    net = tr["net"].to_numpy()
    eq = np.cumsum(net) * DPP
    dd = float((eq - np.maximum.accumulate(eq)).min())
    tot = float(net.sum() * DPP)
    mar = tot / abs(dd) if dd < 0 else float("inf")
    yearly = tr.groupby(tr["dt"].dt.year)["net"].sum() * DPP
    monthly = tr.groupby(tr["dt"].dt.to_period("M"))["net"].sum() * DPP
    top3 = float(monthly.sort_values(ascending=False).head(3).sum())
    yrs_pos = float((yearly > 0).mean())
    max_yr = float(yearly.max() / tot) if tot > 0 else 1.0
    return dict(net_usd=round(tot, 2), mar=round(mar, 3), trades=int(len(tr)),
                hit=round(float((net > 0).mean()), 4), maxdd_usd=round(dd, 2),
                yearly={str(y): round(float(v), 2) for y, v in yearly.items()},
                top3_month_share=round(top3 / tot, 4) if tot > 0 else 1.0,
                expectancy_pts=round(float(net.mean()), 4),
                yrs_pos_frac=round(yrs_pos, 3), max_yr_share=round(max_yr, 4))

def verdict(st):
    ok = (st["net_usd"] > 0 and st["mar"] >= 1.0 and st["trades"] >= 80
          and st["yrs_pos_frac"] >= 0.60 and st["max_yr_share"] <= 0.50)
    return "PASS" if ok else "FAIL"

def sweep(S):
    """Full pre-registered sweep: 3x3 grid (er_thr x stop_k) in spec mode
    'er_or_vwap', plus 3 filter-mode probes at the center cell. 12 configs."""
    ers = [0.25, 0.35, 0.45]; sks = [0.75, 1.0, 1.5]
    cfgs = [dict(er_thr=e, stop_k=k, mode="er_or_vwap") for e in ers for k in sks]
    cfgs += [dict(er_thr=0.35, stop_k=1.0, mode=m) for m in ("er_only", "vwap_only", "always")]
    # extreme-filter probes: does the loss gradient turn positive on the very
    # choppiest sessions, or just converge to zero with zero trades?
    cfgs += [dict(er_thr=0.15, stop_k=0.75, mode="er_or_vwap"),
             dict(er_thr=0.15, stop_k=1.0, mode="er_or_vwap")]
    print(f"\nSWEEP TABLE (DEV only, {len(cfgs)} configs) — survival bar: net>0, MAR>=1, "
          f"n>=80, >=60% yrs+, maxYr<=50%")
    print(f"{'#':>2} {'er_thr':>6} {'stop_k':>6} {'mode':>11} | {'n':>5} {'hit':>5} "
          f"{'net_usd':>9} {'maxDD':>9} {'MAR':>6} {'yrs+':>5} {'maxYr%':>6} {'exp_pts':>7} | verdict")
    tbl = []
    for i, kw in enumerate(cfgs):
        st = stats(run(S, **kw))
        v = verdict(st)
        tbl.append((kw, st, v))
        print(f"{i:>2} {kw['er_thr']:>6.2f} {kw['stop_k']:>6.2f} {kw['mode']:>11} | "
              f"{st['trades']:>5} {st['hit']:>5.2f} {st['net_usd']:>9.0f} {st['maxdd_usd']:>9.0f} "
              f"{st['mar']:>6.2f} {st['yrs_pos_frac']:>5.2f} {100*st['max_yr_share']:>6.1f} "
              f"{st['expectancy_pts']:>7.3f} | {v}")
    return tbl

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--window", choices=["dev", "holdout", "all"], default="dev")
    ap.add_argument("--er_thr", type=float, default=PREREG["er_thr"])
    ap.add_argument("--stop_k", type=float, default=PREREG["stop_k"])
    ap.add_argument("--mode", default=PREREG["mode"])
    a = ap.parse_args()
    S = L.load()
    if a.window == "dev":
        S = [s for s in S if s["date"] <= DEV_END]
    elif a.window == "holdout":
        S = [s for s in S if s["date"] > DEV_END]
    print(f"f11_firsthour_fade | window={a.window} | sessions={len(S)} "
          f"({S[0]['date']}..{S[-1]['date']})")
    kw = dict(er_thr=a.er_thr, stop_k=a.stop_k, mode=a.mode)
    print(f"PRE-REGISTERED CONFIG: {kw}  (structural: room>={ROOM_MIN}pt, "
          f"stop floor {STOP_FLOOR}pt, first-touch-only, one attempt/side/day)")
    st = stats(run(S, **kw))
    print("\nSTATS BLOCK")
