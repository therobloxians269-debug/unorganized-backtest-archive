"""
premium_discount.py — equilibrium and the Optimal Trade Entry (OTE).

Given a *dealing range* (the current external swing low → swing high), ICT splits
it at the 50% equilibrium: the upper half is a *premium* (a good place to sell,
a bad place to buy) and the lower half a *discount*. A disciplined discretionary
long is only taken in discount; a short only in premium.

The Optimal Trade Entry is the 62%–79% retracement of the impulse leg (the
0.705 "sweet spot" and the 0.79 deep fill), which nests inside the discount/
premium and typically overlaps the FVG/OB — this module quantifies it.
"""
from __future__ import annotations

from dataclasses import dataclass

from .structure import Swing

OTE_NEAR = 0.62
OTE_FAR = 0.79
OTE_SWEET = 0.705


@dataclass(frozen=True)
class Range:
    low: float
    high: float

    @property
    def eq(self) -> float:
        return (self.low + self.high) / 2.0

    def frac(self, price: float) -> float:
        span = self.high - self.low
        return (price - self.low) / span if span else 0.5

    def zone(self, price: float) -> str:
        f = self.frac(price)
        if f > 0.55:
            return "premium"
        if f < 0.45:
            return "discount"
        return "equilibrium"


def current_range(swings: list[Swing], upto_confirm: int) -> Range | None:
    """The dealing range from the most recent confirmed swing high & low <= bar t."""
    last_h = last_l = None
    for s in swings:
        if s.confirm_idx > upto_confirm:
            continue
        if s.kind == "H":
            last_h = s.price
        else:
            last_l = s.price
    if last_h is None or last_l is None or last_h <= last_l:
        return None
    return Range(last_l, last_h)


def ote_zone(low: float, high: float, direction: int) -> tuple[float, float]:
    """(near, far) price bounds of the 62–79% OTE retracement for a trade `direction`.

    direction +1 (long): impulse low→high, retrace down into 0.62–0.79.
    direction -1 (short): impulse high→low, retrace up into 0.62–0.79.
    """
    span = high - low
    if direction > 0:
        near = high - OTE_NEAR * span
        far = high - OTE_FAR * span
    else:
        near = low + OTE_NEAR * span
        far = low + OTE_FAR * span
    return (min(near, far), max(near, far))


def in_ote(price: float, low: float, high: float, direction: int) -> bool:
    lo, hi = ote_zone(low, high, direction)
    return lo <= price <= hi

