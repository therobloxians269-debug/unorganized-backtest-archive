def carry_sleeve(fund, pnl):
    tr = fund.rolling(30).mean().shift(1)
    raw = tr.clip(lower=0)
    w = raw.div(raw.sum(axis=1).replace(0, np.nan), axis=0).clip(upper=0.10)
    w = w.div(w.sum(axis=1).replace(0, np.nan), axis=0).fillna(0.0)
    w = w.resample("W").last().reindex(fund.index, method="ffill").fillna(0.0)
    return ((w * pnl).sum(axis=1) / CAPF - w.diff().abs().sum(axis=1) * 0.004 / CAPF
            + (CAPF - 1) / CAPF * CASH_Y).dropna()


