"""
Path-accurate simulator for the two-block trade.

  break UP (mirror for down):
    BLOCK A  = [ IB low , IB low - dA*ADR ]      the PRINTED extreme -> the STOP
    BLOCK B  = [ brk + q_a*ADR , brk + q_b*ADR ] the UNPRINTED extreme -> the TARGET
    ENTRY    = limit at  brk - f*ib_rng          the RETRACEMENT, where price trades

Conventions that the four historical bugs in this program all violated:
  · the barrier race starts the bar AFTER the entry fills (tap-bar leak)
  · on the fill bar itself only the STOP can trigger, never the target (conservative)
  · stop-first tie-break inside a bar
  · entry is a LIMIT -> no entry slippage; stop is a MARKET -> 1 tick adverse
  · costs charged on every trade, both sides
"""
import numpy as np

SPEC = {'ES':  dict(pv=5.0, tick=0.25, comm=1.50),   # traded as MES
        'NQ':  dict(pv=2.0, tick=0.25, comm=1.50),   # traded as MNQ
        'MNQ': dict(pv=2.0, tick=0.25, comm=1.50)}


def run(d, paths, spec, f=0.5, dA=0.10, tgt=None, tgt_R=None,
        entry_cut=960, flat=959, first_only=True, stop_adr=None, at_market=False):
    """tgt: array of target distance in ADR beyond the break level (Block B).
       tgt_R: alternatively a fixed R multiple. Exactly one of the two.
       stop_adr: if set, stop is this many ADR from entry instead of Block A's edge.
       at_market: enter at the break bar's close instead of working a limit."""
    pv, tick, comm = spec['pv'], spec['tick'], spec['comm']
    out = []
    tgtv = np.asarray(tgt) if tgt is not None else None

    for i, (day, row) in enumerate(d.iterrows()):
        p = paths.get(day)
        if p is None:
            continue
        s, A = row.s, row.ADR
        brk, opp, ibr = row.brk_lvl, row.opp_lvl, row.ib_rng
        E    = row.brk_c if at_market else brk - s * f * ibr
        STP  = (E - s * stop_adr * A) if stop_adr is not None else (opp - s * dA * A)
        risk = s * (E - STP)
        if risk <= 0:
            continue
        TGT = (E + s * tgt_R * risk) if tgt_R is not None else (brk + s * tgtv[i] * A)
        if s * (TGT - E) <= 0:
            continue

        H, L, T, C = p['H'], p['L'], p['T'], p['C']
        # ── working limit ──
        hit = np.flatnonzero((T < entry_cut) & ((L <= E) if s > 0 else (H >= E)))
        if not len(hit):
            out.append(dict(day=day, filled=False))
            continue
        j = hit[0]
        # fill bar: only the stop can trigger
        if (L[j] <= STP) if s > 0 else (H[j] >= STP):
            px, why = STP - s * tick, 'stop'
        else:
            px, why = None, None
            for m in range(j + 1, len(H)):
                if T[m] >= flat:
                    px, why = C[m], 'time'
                    break
                hs = (L[m] <= STP) if s > 0 else (H[m] >= STP)
                ht = (H[m] >= TGT) if s > 0 else (L[m] <= TGT)
                if hs:                                  # stop-first tie-break
                    px, why = STP - s * tick, 'stop'
                    break
                if ht:
                    px, why = TGT, 'target'
                    break
            if px is None:
                px, why = C[-1], 'time'
        pnl = s * (px - E) * pv - comm
        out.append(dict(day=day, filled=True, s=s, E=E, STP=STP, TGT=TGT,
                        risk=risk, RR=s * (TGT - E) / risk, why=why,
                        pnl=pnl, R=pnl / (risk * pv), t=T[j]))
    import pandas as pd
    return pd.DataFrame(out)


def report(r, tag, ndays):
    fl = r[r.filled] if 'filled' in r else r
    if not len(fl):
        print(f'  {tag:34s} NO FILLS'); return None
    n, pnl, R = len(fl), fl.pnl.values, fl.R.values
    wr = (pnl > 0).mean() * 100
    t = R.mean() / (R.std(ddof=1) / np.sqrt(n)) if n > 1 and R.std() > 0 else 0
    d3 = np.sort(pnl)[:-3].mean() if n > 3 else np.nan
    yr = fl.groupby(fl.day.dt.year).pnl.mean()
    print(f'  {tag:34s} n={n:5d} {n/ndays:.2f}/d  fill {len(fl)/max(len(r),1)*100:3.0f}%  '
          f'WR {wr:4.1f}%  avgR {R.mean():+.3f}  t {t:+5.2f}  ${pnl.mean():+7.2f}  '
          f'drop3 ${d3:+6.2f}  yrs {(yr>0).sum()}/{len(yr)}')
    return dict(n=n, wr=wr, avgR=R.mean(), t=t, usd=pnl.mean(), d3=d3,
                pos_yrs=(yr > 0).sum(), n_yrs=len(yr), perday=n / ndays)

