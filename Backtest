"""
E2 — Validate event-momentum on REAL ES 1m, 2010-2026 (16y), full Globex session.

Thesis (the only OOS survivor in the logs): after a scheduled 08:30 ET macro release,
a LARGE release-window move (ignition) CONTINUES over the next hours (underreaction),
and the move is big vs the MES cost floor (~0.75 pt RT) so costs aren't binding.

Deterministic 08:30 ET events (no consensus data needed — condition on the PRICE move,
which is what a chart indicator can see):
    Initial Jobless Claims — every Thursday
    Nonfarm Payrolls (NFP) — first Friday of the month
Measure: release-window move r0 over W min; aligned follow-through over H min after.
Condition on |r0| tercile (top = genuine surprises). IS(<=2019)/OOS(>=2020) split.
Honest: entry at release-window END close, exit H min later. Costs in the P&L.
"""
import pandas as pd, numpy as np

SRC = "/Users/kaveh/overnight_premium_engine/data/es_front_1m.parquet"
POINT, TICK = 5.0, 0.25
COST_RT_PTS = (1.24 / POINT) + 2 * TICK      # commission + 1 tick/side slippage, in ES points
IS_END = pd.Timestamp("2020-01-01", tz="America/New_York")

def load():
    df = pd.read_parquet(SRC)[["open", "high", "low", "close"]].copy()
    df = df[~df.index.duplicated(keep="first")].sort_index()
    return df

def event_dates(idx):
    days = pd.Series(idx.normalize().unique())
    out = []
    for d in days:
        wd = d.weekday()
        if wd == 3:   out.append((d, "Claims"))            # Thursday
        if wd == 4 and d.day <= 7: out.append((d, "NFP"))  # first Friday
    return out

def at_or_after(df, ts):
    pos = df.index.searchsorted(ts)
    return pos if pos < len(df) else None

def study(W=30, H=120, stop_pts=None):
    df = load()
    tz = df.index.tz
    rows = []
    for d, name in event_dates(df.index):
        t0 = pd.Timestamp(d.date(), tz=tz) + pd.Timedelta(hours=8, minutes=30)
        p0 = at_or_after(df, t0)
        if p0 is None: continue
        if df.index[p0] - t0 > pd.Timedelta(minutes=5): continue   # release bar must exist
        base = df.open.iloc[p0]
        pe = p0 + W
        if pe + H >= len(df): continue
        # release-window must stay same session-day (guard against gaps in data)
        if (df.index[pe] - df.index[p0]) > pd.Timedelta(minutes=W + 20): continue
        rel = df.close.iloc[pe]
        r0 = (rel / base - 1)
        if r0 == 0: continue
        sign = np.sign(r0)
        # aligned follow-through over next H min (entry at rel close, exit H later)
        exitp = df.close.iloc[pe + H]
        fwd_ret = sign * (exitp / rel - 1)          # aligned continuation, %
        fwd_pts = sign * (exitp - rel)              # aligned continuation, ES points
        net_pts = fwd_pts - COST_RT_PTS             # after MES costs, per contract
        rng_pts = base * abs(r0)                    # release move size in points (~|rel-base|)
        rows.append({"day": d, "name": name, "r0_bps": r0 * 1e4, "absr0_pts": abs(rel - base),
                     "fwd_pts": fwd_pts, "net_pts": net_pts,
                     "net_usd": net_pts * POINT})
    return pd.DataFrame(rows)

def agg(d, label):
    if len(d) == 0: return f"  {label:<34} n=0"
    net = d.net_pts.mean()
    win = (d.net_pts > 0).mean() * 100
    t = d.net_pts.mean() / d.net_pts.std() * np.sqrt(len(d)) if d.net_pts.std() > 0 else 0
    return (f"  {label:<34} n={len(d):>4}  net={net:+6.2f}pt (${net*POINT:+6.2f})  "
            f"win={win:4.1f}%  t={t:+4.2f}  totUSD=${d.net_usd.sum():+8,.0f}")

if __name__ == "__main__":
    print("="*120)
    print("EVENT-MOMENTUM STUDY — real ES 1m 2010-26.  release window W=30m, hold H=120m, condition on |r0| tercile")
    print("MES cost floor per RT ~ %.2f pts.  A row is tradeable only if net (after cost) is > 0 in BOTH IS and OOS." % COST_RT_PTS)
    print("="*120)
    for W, H in [(15, 60), (30, 120), (30, 240), (60, 120)]:
        d = study(W=W, H=H)
        thr = d.absr0_pts.quantile(2/3)
        big = d[d.absr0_pts >= thr]
        print(f"\n--- W={W}m release window, H={H}m hold ---  (big-move threshold = top tercile = {thr:.1f} pts)")
        print(agg(d, "ALL release moves"))
        print(agg(big, "BIG moves (top tercile |r0|)"))
        print(agg(big[big.day < IS_END], "  BIG · IS 2010-19"))
        print(agg(big[big.day >= IS_END], "  BIG · OOS 2020-26"))
        print(agg(big[big.name == "Claims"], "  BIG · Claims only"))
        print(agg(big[big.name == "NFP"], "  BIG · NFP only"))

