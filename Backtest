"""
Configuration & credential protection.

All secrets are read from the environment (optionally via a git-ignored `.env`) and wrapped
in `SecretStr`, which renders as `***redacted***` in any repr/log/traceback. No secret is ever
hard-coded or committed. See SECURITY.md.
"""
from __future__ import annotations

import os
from dataclasses import dataclass, field, fields
from pathlib import Path


class SecretStr:
    """A string whose value never appears in logs, reprs, or tracebacks."""

    __slots__ = ("_v",)

    def __init__(self, value: str | None):
        self._v = value or ""

    def reveal(self) -> str:
        """Explicit, auditable access — the only way to read the underlying value."""
        return self._v

    def __bool__(self) -> bool:
        return bool(self._v)

    def __repr__(self) -> str:
        return "SecretStr('***redacted***')" if self._v else "SecretStr(unset)"

    __str__ = __repr__


def _load_dotenv(path: Path) -> None:
    """Minimal .env loader (no dependency); does not overwrite existing env vars."""
    if not path.exists():
        return
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, val = line.partition("=")
        os.environ.setdefault(key.strip(), val.strip())


@dataclass(frozen=True)
class Settings:
    env: str = "paper"                       # paper | live
    base_equity: float = 10_000.0
    data_dir: Path = field(default_factory=lambda: Path("./data"))

    binance_key: SecretStr = field(default_factory=lambda: SecretStr(None))
