    "don60":    dict(use_dtrail=1, dK=60),
}

STOP_AWS = (30, 60)
STOP_MULTS = (0.75, 1.25, 2.0)
MAX_TDS = (2, 4, 99)
ENT_LO, ENT_HI = RTH_OPEN, 15 * 60 + 30      # signal bars 09:30..15:30 ET


def fam_variants():
    """(fam, key, paramtuple) with an ordered N-axis for plateau checks."""
    out = []
    for N in (15, 30, 60, 120, 180):
        out.append(("DON", f"DON{N}", dict(N=N), N))
    for N in (30, 60, 120):
        for k in (0.5, 1.0):
            out.append(("TSM", f"TSM{N}k{k}", dict(N=N, k=k, aw=60), N))
    for fast, slow in ((20, 60), (60, 120)):
        for dep in (0.10, 0.30):
            out.append(("PBK", f"PBK{fast}_{slow}d{dep}", dict(fast=fast, slow=slow,
                                                              depth=dep, aw=30), fast))
    return out


def make_sig(fam, p, F, D, gate):
    if fam == "DON":
        return sig_don(F, D, p["N"], gate)
    if fam == "TSM":
        return sig_tsm(F, D, p["N"], p["k"], p["aw"], gate)
    if fam == "PBK":
        return sig_pbk(F, D, p["fast"], p["slow"], p["depth"], p["aw"], gate)
    raise ValueError(fam)


def build_cfg(F, exit_name, stop_aw, stop_mult, max_td):
    e = dict(EXITS[exit_name])
    cfg = dict(tp_R=e.get("tp_R", 0.0), trail_mult=e.get("trail_mult", 0.0),
               be_at_R=e.get("be_at_R", 0.0), use_dtrail=e.get("use_dtrail", 0),
               time_stop=0, max_td=max_td, ent_lo=ENT_LO, ent_hi=ENT_HI,
               atr_e=F["atr30"], stop_aw=stop_aw, stop_mult=stop_mult)
    if cfg["use_dtrail"]:
        K = e["dK"]
        cfg["trail_lo_arr"] = F[f"tlo{K}"]
        cfg["trail_hi_arr"] = F[f"thi{K}"]
    return cfg


# ==================================================================== STAGE: MFE
def stage_mfe(G):
    print("\n" + "=" * 100)
    print("STAGE MFE -- are the moves caught and given back, or never caught?")
    print("=" * 100)
    for sp in ("IS", "O1", "O2"):
        D = G["D"][sp]; F = G["F"][sp]
        print(f"\n[{D['name']}]  (stop = 1.25 x ATR30, entry 09:30-15:30, flat 16:59)")
        for fam, key, p, _ in fam_variants():
            if key not in ("DON30", "DON60", "DON120", "TSM60k0.5", "PBK20_60d0.1"):
                continue
            sig = make_sig(fam, p, F, D, None)
            sp_pts = 1.25 * F["atr30"]
            # pure MFE probe: no target, no trail -> only initial stop + 16:59 flatten
            cfg = build_cfg(F, "atr3", 30, 1.25, 99)
            cfg["trail_mult"] = 0.0
            T = run_trades(D, sig, sp_pts, cfg)
            mfe_report(T, f"{key:<14s}")
        # RANDOM-ENTRY BASELINE: same bar-count, same stop, same exit logic, random dirs
        rng = np.random.default_rng(7)
        rsig = np.zeros(D["n"], np.int8)
        pick = rng.choice(D["n"], size=4000, replace=False)
        rsig[pick] = rng.choice(np.array([-1, 1], np.int8), size=4000)
        cfg = build_cfg(F, "atr3", 30, 1.25, 99); cfg["trail_mult"] = 0.0
        T = run_trades(D, rsig, 1.25 * F["atr30"], cfg)
        mfe_report(T, "RANDOM-ENTRY  ")


# ================================================================== STAGE: SWEEP
def stage_sweep(G):
    print("\n" + "=" * 100)
    print("STAGE SWEEP -- IS ONLY (NQ 2023-2024).  No OOS is touched here.")
    print("=" * 100)
    D = G["D"]["IS"]; F = G["F"]["IS"]
    half = D["df"].index < "2024-01-01"
    rows = []
    variants = fam_variants()
    total = len(variants) * len(GATE_DEFS) * len(EXITS) * len(STOP_AWS) * len(STOP_MULTS) * len(MAX_TDS)
    print(f"configs = {total}")
    done = 0
    for fam, key, p, Naxis in variants:
        for gname in GATE_DEFS:
            gate = None if gname == "none" else G["GATES"][gname]["IS"]
            sig = make_sig(fam, p, F, D, gate)
            nsig = int((sig != 0).sum())
            if nsig < 200:
                done += len(EXITS) * len(STOP_AWS) * len(STOP_MULTS) * len(MAX_TDS)
                continue
            for stop_aw in STOP_AWS:
                a = F[f"atr{stop_aw}"]
                for stop_mult in STOP_MULTS:
                    spts = stop_mult * a
                    for ename in EXITS:
                        for mtd in MAX_TDS:
                            cfg = build_cfg(F, ename, stop_aw, stop_mult, mtd)
                            T = run_trades(D, sig, spts, cfg)
                            done += 1
                            if T["n"] < 100:
                                continue
                            s = stats(T, D, key)
                            # IS half-split stability
                            ent = T["ei"]
                            h1 = half[ent]
                            r1 = T["R"][h1]; r2 = T["R"][~h1]
                            rows.append(dict(fam=fam, key=key, Naxis=Naxis, gate=gname,
                                             exit=ename, stop_aw=stop_aw,
                                             stop_mult=stop_mult, max_td=mtd,
                                             n=s["n"], tpd=s["tpd"], avgR=s["avgR"],
                                             dpt=s["dpt"], wr=s["wr"], drop3=s["drop3"],
                                             tot=s["tot"], maxdd=s["maxdd"],
                                             dd_micro=s["dd_micro"], pf=s["pf"],
                                             tR=s["tR"], medmfe=s["medmfe"],
                                             h1=float(r1.mean()) if len(r1) > 5 else np.nan,
                                             h2=float(r2.mean()) if len(r2) > 5 else np.nan))
        print(f"  {key:<16s} done {done}/{total}")
    S = pd.DataFrame(rows)
    S.to_csv(f"{OUT}/f6_IS_sweep.csv", index=False)
    print(f"\nswept {len(S)} usable configs -> {OUT}/f6_IS_sweep.csv")
    if len(S) == 0:
        return
    print("\n--- raw distribution of IS avgR (all configs) ---")
    print(S["avgR"].describe())
    print(f"frac configs with avgR>0 : {(S.avgR>0).mean():.3f}")
    print(f"frac configs with drop3>0: {(S.drop3>0).mean():.3f}")

    print("\n--- marginal means by family / gate / exit (IS avgR) ---")
    for col in ("fam", "gate", "exit", "stop_mult", "max_td", "stop_aw"):
        g = S.groupby(col).agg(n=("avgR", "size"), avgR=("avgR", "mean"),
                               pos=("avgR", lambda x: (x > 0).mean()),
                               dpt=("dpt", "mean"))
        print(f"\n[{col}]\n{g.round(4)}")

    # ---- ROBUSTNESS-FIRST selection: tiles = (fam,key-family,gate,exit,stop_aw,max_td)
    # a tile spans the N axis and the stop_mult axis -> a genuine parameter plateau.
    # HARD BAR FIRST: only cells that clear >= 1.0 trades / day-cycle are eligible.
    S["tile"] = S["fam"] + "|" + S["gate"] + "|" + S["exit"] + "|" + \
                S["stop_aw"].astype(str) + "|" + S["max_td"].astype(str)
    print(f"\ncells with tpd>=1.0 : {(S.tpd>=1.0).sum()} / {len(S)}   "
          f"(of those avgR>0: {(S[S.tpd>=1.0].avgR>0).mean():.3f}, "
          f"drop3>0: {(S[S.tpd>=1.0].drop3>0).mean():.3f})")
    S = S[S.tpd >= 1.0].copy()
    tiles = S.groupby("tile").agg(
        cells=("avgR", "size"), mean_avgR=("avgR", "mean"), min_avgR=("avgR", "min"),
        frac_pos=("avgR", lambda x: (x > 0).mean()),
        mean_drop3=("drop3", "mean"), frac_drop3_pos=("drop3", lambda x: (x > 0).mean()),
        mean_tpd=("tpd", "mean"), mean_dpt=("dpt", "mean"),
        frac_h1pos=("h1", lambda x: (x > 0).mean()), frac_h2pos=("h2", lambda x: (x > 0).mean()),
    ).reset_index()
    tiles = tiles[tiles.cells >= 6]
    tiles["score"] = tiles.frac_pos * 0.4 + tiles.frac_drop3_pos * 0.3 + \
                     tiles.frac_h1pos * 0.15 + tiles.frac_h2pos * 0.15
    tiles = tiles.sort_values(["score", "mean_avgR"], ascending=False)
    tiles.to_csv(f"{OUT}/f6_IS_tiles.csv", index=False)
    print("\n--- TOP 15 TILES by plateau robustness (IS only) ---")
    print(tiles.head(15).round(4).to_string(index=False))
    print("\n--- BOTTOM 5 TILES ---")
    print(tiles.tail(5).round(4).to_string(index=False))

    # representative config per top tile = MEDIAN cell (never the max)
    picks = []
    for _, tr in tiles.head(6).iterrows():
        sub = S[S.tile == tr.tile].sort_values("avgR")
        if len(sub) == 0:
            continue
        med = sub.iloc[len(sub) // 2]
        picks.append(med.to_dict())
    pk = pd.DataFrame(picks)
    pk.to_csv(f"{OUT}/f6_picks.csv", index=False)
    print("\n--- IS PICKS (median cell of each top tile) ---")
    if len(pk):
        print(pk[["fam", "key", "gate", "exit", "stop_aw", "stop_mult", "max_td",
                  "n", "tpd", "avgR", "dpt", "wr", "drop3", "tR", "h1", "h2",
                  "dd_micro"]].round(4).to_string(index=False))


# ================================================================== STAGE: DRIFT
def stage_drift(G):
    """THE DECISIVE COST-FREE TEST.
    If momentum is real, the forward h-minute move conditioned on a momentum state must
    have a positive mean IN THE SIGNAL'S OWN DIRECTION, gross of all costs.  No exit
    scheme can manufacture an edge that is not present here.
    Measured in ATR30 units so it is comparable across splits and price levels.
    Forward move uses c[t+h] - c[t] -> strictly future of t, which is the point; the
    CONDITIONER uses only bars <= t.
    """
    print("\n" + "=" * 100)
    print("STAGE DRIFT -- gross conditional forward drift (no costs, no exits)")
    print("=" * 100)
    for split in ("IS", "O1", "O2"):
        D = G["D"][split]; F = G["F"][split]
        c = D["c"]; n = D["n"]; a = F["atr30"]
        inwin = (D["tod"] >= ENT_LO) & (D["tod"] <= ENT_HI)
        same = np.zeros(n, bool)
        print(f"\n[{D['name']}]  forward drift in ATR30 units, signal window 09:30-15:30")
        print(f"  {'signal':<16s} {'h=15':>18s} {'h=30':>18s} {'h=60':>18s} {'h=120':>18s}")
        for fam, key, p, _ in fam_variants():
            if key not in ("DON15", "DON30", "DON60", "DON120", "DON180",
                           "TSM30k1.0", "TSM60k0.5", "TSM60k1.0", "TSM120k0.5",
                           "PBK20_60d0.1", "PBK60_120d0.1"):
                continue
            sig = make_sig(fam, p, F, D, None)
            line = f"  {key:<16s}"
            for h in (15, 30, 60, 120):
                fwd = np.full(n, np.nan)
                fwd[:n - h] = c[h:] - c[:n - h]
                # must not cross the 16:59 flatten -> require same day at t+h
                ok = np.zeros(n, bool)
                ok[:n - h] = D["day"][h:] == D["day"][:n - h]
                m = (sig != 0) & inwin & ok & np.isfinite(fwd) & np.isfinite(a) & (a > 0)
                x = (fwd[m] / a[m]) * sig[m]         # signed into the signal's direction
                if len(x) < 50:
                    line += f" {'--':>18s}"; continue
                t = x.mean() / (x.std(ddof=1) / np.sqrt(len(x)))
                line += f" {x.mean():+7.4f}(t{t:+5.1f})"
            print(line)
        # unconditional / random control
        rng = np.random.default_rng(11)
        rs = rng.choice(np.array([-1, 1]), size=n)
        line = f"  {'RANDOM-SIGN':<16s}"
        for h in (15, 30, 60, 120):
            fwd = np.full(n, np.nan); fwd[:n - h] = c[h:] - c[:n - h]
            ok = np.zeros(n, bool); ok[:n - h] = D["day"][h:] == D["day"][:n - h]
            m = inwin & ok & np.isfinite(fwd) & np.isfinite(a) & (a > 0)
            x = (fwd[m] / a[m]) * rs[m]
            t = x.mean() / (x.std(ddof=1) / np.sqrt(len(x)))
            line += f" {x.mean():+7.4f}(t{t:+5.1f})"
        print(line)
        line = f"  {'ALWAYS-LONG':<16s}"
        for h in (15, 30, 60, 120):
            fwd = np.full(n, np.nan); fwd[:n - h] = c[h:] - c[:n - h]
            ok = np.zeros(n, bool); ok[:n - h] = D["day"][h:] == D["day"][:n - h]
            m = inwin & ok & np.isfinite(fwd) & np.isfinite(a) & (a > 0)
            x = (fwd[m] / a[m])
            t = x.mean() / (x.std(ddof=1) / np.sqrt(len(x)))
            line += f" {x.mean():+7.4f}(t{t:+5.1f})"
        print(line)
        # cost floor in ATR30 units: (2*slip + comm/pv) points / ATR30
        ck = COST["MNQ" if D["pv"] <= 2 else "NQ"]
        floor_pts = 2 * ck["slip"] + ck["comm"] / ck["pv"]
        print(f"  ROUND-TRIP COST FLOOR = {floor_pts:.2f} pts = "
              f"{np.nanmedian(floor_pts / a[np.isfinite(a)]):.4f} ATR30 units")

        # ---------- BETA-STRIPPED momentum drift ----------
        # Subtract the UNCONDITIONAL in-window mean forward move before signing.  What is
        # left is pure directional-prediction skill, free of the bull-market drift that
        # a mostly-long signal set would otherwise harvest by accident.
        print("  -- beta-stripped excess drift, t clustered BY DAY-CYCLE --")
        print("     (naive t is inflated ~sqrt(h) by overlapping windows; the day-clustered")
        print("      t is the honest one: one independent observation per day-cycle)")
        print(f"  {'signal':<16s} {'longfrac':>8s} {'h=15':>18s} {'h=30':>18s} "
              f"{'h=60':>18s} {'h=120':>18s}")
        for fam, key, p, _ in fam_variants():
            if key not in ("DON30", "DON60", "DON180", "TSM60k1.0", "TSM120k0.5",
                           "PBK20_60d0.1"):
                continue
            sig = make_sig(fam, p, F, D, None)
            base = (sig != 0) & inwin
            lf = float((sig[base] > 0).mean()) if base.sum() else np.nan
            line = f"  {key:<16s} {lf:8.3f}"
            for h in (15, 30, 60, 120):
                fwd = np.full(n, np.nan); fwd[:n - h] = c[h:] - c[:n - h]
                ok = np.zeros(n, bool); ok[:n - h] = D["day"][h:] == D["day"][:n - h]
                valid = inwin & ok & np.isfinite(fwd) & np.isfinite(a) & (a > 0)
                mu = (fwd[valid] / a[valid]).mean()          # unconditional in-window drift
                m = valid & (sig != 0)
                if m.sum() < 50:
                    line += f" {'--':>18s}"; continue
                x = (fwd[m] / a[m] - mu) * sig[m]
                dmean = pd.Series(x).groupby(D["day"][m]).mean()
