"""Clean broad futures trend program on the 14-market daily universe.

Robust outright filter -> per-market continuous front-month (max-volume contract,
same-contract returns so no roll gap) -> winsorize glitch prints -> multi-timescale tanh
trend, inverse-vol, portfolio vol-targeted. Reports per-market diagnostics + full stats
(Sharpe, DD, beta to ES, PSR vs 1.0).

    PYTHONPATH=. python3 research/trend_futures.py
"""
from __future__ import annotations

import numpy as np
import pandas as pd

from ope.validation import perf_stats, probabilistic_sharpe_ratio

ROOTS = {"ES", "NQ", "CL", "NG", "GC", "SI", "HG", "ZN", "ZB", "ZF", "6E", "6J", "ZC", "ZS"}
MONTHS = set("FGHJKMNQUVXZ")
TGT, COST_BP, LOOKS, CLIP = 0.10, 1.5, (63, 126, 252), 0.20


def market_returns():
    df = pd.read_parquet("data/futures_universe_1d.parquet").reset_index()
    df["date"] = pd.to_datetime(df["ts_event"].dt.date)
    s = df["symbol"].astype(str)
    mask = (~s.str.contains(r"[-: ]", regex=True, na=False) & (s.str.len() >= 4)
            & s.str[-1].str.isdigit() & s.str[-2].isin(MONTHS) & s.str[:-2].isin(ROOTS))
    d = df[mask].copy()
    d["root"] = d["symbol"].str[:-2]
    d = d[d["volume"] > 0]
    rets = {}
    for root, g in d.groupby("root"):
        piv = g.pivot_table(index="date", columns="instrument_id", values="close")
        prev = piv.shift(1)
        front = g.loc[g.groupby("date")["volume"].idxmax()].set_index("date")
        dates = front.index
        cur = front["close"]
        pc = pd.Series([prev.at[dt, front.at[dt, "instrument_id"]]
                        if front.at[dt, "instrument_id"] in prev.columns else np.nan
                        for dt in dates], index=dates)
        r = (cur / pc - 1.0).clip(-CLIP, CLIP)         # same-contract return, winsorized
        rets[root] = r.rename(root)
    return pd.DataFrame(rets).sort_index()


def trend_net(R, cols=None):
    R = R[cols] if cols else R
    cont = (1 + R.fillna(0.0)).cumprod()
    av = (R.rolling(63).std() * np.sqrt(252)).shift(1)
    z = sum(cont.pct_change(L) / (av * np.sqrt(L / 252.0)) for L in LOOKS) / len(LOOKS)
    w = np.tanh(z).shift(1) / av
    w = w.div(w.abs().sum(axis=1).replace(0, np.nan), axis=0)
    g = (w * R).sum(axis=1)
    scale = (TGT / (g.rolling(63).std() * np.sqrt(252))).shift(1).clip(0, 3).fillna(0.0)
    w = w.mul(scale, axis=0)
    return ((w * R).sum(axis=1) - w.diff().abs().sum(axis=1) * COST_BP * 1e-4).dropna()


def main():
    R = market_returns()
    print(f"markets {list(R.columns)} | {R.index.min().date()}->{R.index.max().date()} {len(R)} days\n")
    print("per-market standalone trend Sharpe:")
    diag = {c: perf_stats(trend_net(R, [c]))["sharpe"] for c in R.columns}
    print("  " + "  ".join(f"{c}:{v:+.2f}" for c, v in sorted(diag.items(), key=lambda x: -x[1])))

    net = trend_net(R)
    s = perf_stats(net)
    es = R["ES"].reindex(net.index)
    beta = pd.concat([net, es], axis=1).dropna().cov().iloc[0, 1] / es.var()
    psr1 = probabilistic_sharpe_ratio(net, 1.0 / np.sqrt(252))
    dn = net[net < 0].std() * np.sqrt(252)
    sortino = net.mean() * 252 / dn if dn else float("nan")
    yr = net.resample("YE").apply(lambda x: (1 + x).prod() - 1)
    print(f"\n=== FULL PROGRAM ({len(R.columns)} markets) ===")
    print(f"Sharpe {s['sharpe']:.2f}  Sortino {sortino:.2f}  CAGR {s['ann_return']*100:.1f}%  "
          f"vol {s['ann_vol']*100:.1f}%  maxDD {s['max_drawdown']*100:.1f}%")
    print(f"beta_to_ES {beta:+.2f}  PSR(vs1.0) {psr1*100:.1f}%  worst yr {yr.min()*100:+.1f}%")
    print("yearly:", "  ".join(f"{t.year}:{v*100:+.0f}" for t, v in yr.items()))


if __name__ == "__main__":
    main()

