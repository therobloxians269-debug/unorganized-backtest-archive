config, mom_scale=0.7 -> Sharpe 1.90). It merges what normally lives in pm_dd_pack.py
(the build engine) + lib_perf.py (the metrics) into a single runnable script.

THE BOOK = 4 sleeves, weekly cadence, net of frictions, 2020-02 -> 2026:
    C1  Binance delta-neutral FUNDING CARRY   35%  (funding-weighted, 10% name caps)
    C2  Hyperliquid FUNDING CARRY (2023+)      25%  (backfilled into C1 weight pre-2023)
    M   long-only crypto MOMENTUM (PIT)        15% * mom_scale   (0.7 in the 1.90 config)
    T   diversified CME FUTURES TREND (14 mkts) 25%
  + 4%/yr cash yield on the carry margin buffer (CAPF leverage factor).

HONEST SCOPE NOTE (read this):
  - C1 and C2 are built end-to-end here from raw Binance/Hyperliquid klines + funding.
  - M and T enter as their FINAL daily net-return series (pit_net.parquet / trend_all.parquet).
    Their internal construction (point-in-time momentum universe; trend across 6E 6J CL NG
    GC SI HG ES NQ ZB ZF ZN ZC ZS) lives in pit_universe.py / build_futures_trend.py and is
    NOT inlined here — this file is the PORTFOLIO engine that nets them into the 1.90 book.
  - Carry Sharpes overstate true risk: the dominant risk (venue/counterparty failure) is
    absent from daily P&L. Backtested; live band ~1.3-1.6 after haircuts.

Run:  PYTHONPATH=/Users/kaveh/mim_research python3 program_v3_full.py
"""
from __future__ import annotations
import numpy as np, pandas as pd
from scipy.stats import norm, skew, kurtosis

# ---------------------------------------------------------------- config / constants
DIR   = "/Users/kaveh/mim_research"
ANN   = 365                 # crypto trades 7 days/wk -> 365 periods/yr
START = "2020-02-01"
CASH_Y = 0.04 / 365         # 4%/yr cash yield on the unused carry margin buffer
CAPF   = 1.5                # capital factor: 1.5x margin buffer on carry (de-leverages P&L)
PROD_MOM_SCALE = 0.7        # <<< the v3.2 trim that turns the 1.72 baseline into 1.90
W = dict(C1=0.35, C2=0.25, M=0.15, T=0.25)   # nominal sleeve weights (C1 absorbs C2 pre-2023)


# ================================================================ METRICS (was lib_perf)
def maxdd(r: pd.Series) -> float:
    eq = (1 + r).cumprod()
    return float((eq / eq.cummax() - 1).min())

def perf_stats(r: pd.Series, ppy: int = ANN) -> dict:
    r = r.dropna()
    if len(r) < 5 or r.std() == 0:
        return dict(cagr=0, vol=0, sharpe=0, sortino=0, calmar=0, maxdd=0)
    yrs    = len(r) / ppy
    cagr   = (1 + r).prod() ** (1 / yrs) - 1
    vol    = r.std() * np.sqrt(ppy)
    sharpe = r.mean() / r.std() * np.sqrt(ppy)
    dn     = r[r < 0].std()
    sortino = r.mean() / dn * np.sqrt(ppy) if dn > 0 else np.nan
    dd     = maxdd(r)
    calmar = cagr / abs(dd) if dd < 0 else np.nan
    return dict(cagr=cagr, vol=vol, sharpe=sharpe, sortino=sortino, calmar=calmar, maxdd=dd)

def psr(r: pd.Series, sr_star_ann: float, ppy: int = ANN) -> float:
    """Probabilistic Sharpe Ratio: P(true SR > sr_star_ann)."""
    r = r.dropna().values; n = len(r)
    if n < 10 or r.std() == 0: return np.nan
    sr = r.mean() / r.std(); sr_star = sr_star_ann / np.sqrt(ppy)
    sk = pd.Series(r).skew(); ku = pd.Series(r).kurt() + 3
    den = np.sqrt(1 - sk * sr + (ku - 1) / 4 * sr ** 2)
    return float(norm.cdf((sr - sr_star) * np.sqrt(n - 1) / den))

def per_year(r: pd.Series) -> pd.Series:
    return r.groupby(r.index.year).apply(lambda x: (1 + x).prod() - 1)


# ================================================================ SLEEVE BUILDER (was pm_dd_pack)
def carry_sleeve(fund: pd.DataFrame, pnl: pd.DataFrame, cost_scale: float = 1.0):
    """Delta-neutral funding carry. Long the highest trailing-30d POSITIVE-funding perps
       (10% name cap), weekly rebalanced, CAUSAL (.shift(1)). Returns (daily_ret, turnover).
         pnl = spot_ret - perp_ret + funding   (the realized delta-neutral carry P&L)."""
    tr  = fund.rolling(30).mean().shift(1)                 # causal 30d funding signal
    raw = tr.clip(lower=0)                                  # only long positive funding
    w   = raw.div(raw.sum(axis=1).replace(0, np.nan), axis=0).clip(upper=0.15)   # 15% cap (banked 2026-06-22: OOS-stable +~0.05 Sharpe vs 10%)
    w   = w.div(w.sum(axis=1).replace(0, np.nan), axis=0).fillna(0.0)            # renormalize
    w   = w.resample("W").last().reindex(fund.index, method="ffill").fillna(0.0) # weekly, ffwd
    turn = w.diff().abs().sum(axis=1)
    ret  = ((w * pnl).sum(axis=1) / CAPF
            - turn * 0.004 * cost_scale / CAPF             # 40bp round-trip across legs
            + (CAPF - 1) / CAPF * CASH_Y).dropna()         # cash yield on the buffer
    return ret, turn.reindex(ret.index).fillna(0.0)


def build(fund_scale: float = 1.0, cost_scale: float = 1.0, mom_scale: float = 1.0):
    """Reproduce the program. mom_scale=0.7 -> the 1.90 v3.2 config; 1.0 -> 1.72 baseline.
       Returns (port, j, comp, tC1, tC2): portfolio daily ret, per-sleeve raw, weighted comps."""
    # ---- C1: Binance funding carry ----
    k = pd.read_parquet(f"{DIR}/binance_klines.parquet");  k["date"] = k["t"].dt.normalize()
    f = pd.read_parquet(f"{DIR}/binance_funding.parquet"); f["date"] = f["t"].dt.normalize()
    bs = k[k.kind == "spot"].pivot_table(index="date", columns="sym", values="close")
    bp = k[k.kind == "perp"].pivot_table(index="date", columns="sym", values="close")
    bf = f.groupby(["date", "sym"])["fr"].sum().unstack() * fund_scale
    i  = bs.index.intersection(bp.index).intersection(bf.index)
    bs, bp, bf = bs.loc[i], bp.loc[i], bf.reindex(i)
    C1, tC1 = carry_sleeve(bf, bs.pct_change() - bp.pct_change() + bf, cost_scale)

    # ---- C2: Hyperliquid funding carry (2023+) ----
    hf = pd.read_parquet(f"{DIR}/hl_funding.parquet"); hf["date"] = hf["t"].dt.normalize()
    hfund = hf.groupby(["date", "coin"])["fr"].sum().unstack() * fund_scale
    hk = pd.read_parquet(f"{DIR}/hl_perp_1d.parquet")
    hp = hk.assign(date=hk["t"].dt.normalize()).pivot_table(index="date", columns="coin", values="close")
    bsc = bs.copy(); bsc.columns = [c.replace("USDT", "") for c in bsc.columns]
    hi  = hfund.index.intersection(hp.index).intersection(bsc.index)
    cols = [c for c in ["BTC","ETH","SOL","XRP","DOGE","ADA","AVAX","LINK","LTC","DOT"]
            if c in hfund.columns and c in hp.columns and c in bsc.columns]
    C2, tC2 = carry_sleeve(hfund.loc[hi, cols],
                           bsc.loc[hi, cols].pct_change() - hp.loc[hi, cols].pct_change()
                           + hfund.loc[hi, cols], cost_scale)

    # ---- M (PIT momentum) and T (futures trend): final net series, scaled ----
    M = pd.read_parquet(f"{DIR}/pit_net.parquet")["net"] * mom_scale
    T = pd.read_parquet(f"{DIR}/trend_all.parquet")["net"]

    # ---- net into one book (C1 absorbs C2's 25% before C2 goes live) ----
    j = pd.concat([C1.rename("C1"), C2.rename("C2"), M.rename("M"), T.rename("T")], axis=1, sort=True)
    j = j[j.index >= START]
    j[["M", "T"]] = j[["M", "T"]].fillna(0.0); j["C2"] = j["C2"].fillna(0.0)
    j = j.dropna(subset=["C1"])
    c2a = (j["C2"] != 0)
    comp = pd.DataFrame({
        "C1": (0.35 + np.where(c2a, 0, 0.25)) * j["C1"],   # 0.60 weight until C2 is live
        "C2": 0.25 * c2a * j["C2"],
        "M":  0.15 * j["M"],
        "T":  0.25 * j["T"],
    }, index=j.index)
    port = comp.sum(axis=1)
    return port, j, comp, tC1, tC2


# ================================================================ REPORT
def main():
    port, j, comp, tC1, tC2 = build(mom_scale=PROD_MOM_SCALE)     # the 1.90 config
    base, *_                = build(mom_scale=1.0)                # 1.72 baseline (for context)
    s, sb = perf_stats(port), perf_stats(base)
    eq = (1 + port).cumprod(); dd = eq / eq.cummax() - 1
    ex = port[port.index >= "2020-07-01"]; ddx = ((1 + ex).cumprod() / (1 + ex).cumprod().cummax() - 1).min()
    mo = port.resample("ME").apply(lambda x: (1 + x).prod() - 1).dropna()

    print("=" * 70)
    print(f"PROGRAM v3.2 — THE 1.90 BOOK   ({port.index[0].date()} -> {port.index[-1].date()}, "
          f"{len(port)/ANN:.1f}y, net of frictions)")
    print("=" * 70)
    print(f"  Sharpe        {s['sharpe']:.2f}   (baseline mom=1.0: {sb['sharpe']:.2f})")
    print(f"  CAGR          {s['cagr']*100:.1f}%   Vol {s['vol']*100:.1f}%")
    print(f"  Sortino       {s['sortino']:.2f}    Calmar {s['calmar']:.2f}")
    print(f"  Max drawdown  {dd.min()*100:.1f}%  (ex-COVID {ddx*100:.1f}%)")
    print(f"  PSR(>0/>1.0)  {psr(port,0)*100:.0f}% / {psr(port,1.0)*100:.0f}%")
    print(f"  Monthly skew  {skew(mo):+.2f}   exc-kurt {kurtosis(mo):+.2f}   %+months {(mo>0).mean()*100:.0f}%")
    print(f"  Total return  {((1+port).prod()-1)*100:+.0f}%")

    print("\n  SLEEVES (standalone, net) + realized risk contribution:")
    risk_c = comp.apply(lambda c: c.cov(port)) / port.var()
    ret_c  = comp.mean() / port.mean()
    print(f"  {'sleeve':6}{'Sharpe':>8}{'CAGR':>8}{'maxDD':>9}{'ret%':>7}{'risk%':>7}")
    for nm in ["C1", "C2", "M", "T"]:
        ss = perf_stats(j[nm][j[nm] != 0])
        print(f"  {nm:6}{ss['sharpe']:>8.2f}{ss['cagr']*100:>7.1f}%{ss['maxdd']*100:>8.1f}%"
              f"{ret_c[nm]*100:>6.0f}%{risk_c[nm]*100:>6.0f}%")
    print(f"  carry turnover: C1 {tC1.mean()*ANN:.1f}x/yr  C2 {tC2.mean()*ANN:.1f}x/yr")

    print("\n  CALENDAR YEARS:")
    for y, v in per_year(port).items():
        print(f"    {y}: {v*100:+.1f}%")
