#!/usr/bin/env python3
"""
scout_opportunity.py -- DAILY OPPORTUNITY BOUND on NQ.

Measurement only, no strategy. Answers: how much is actually there per day,
what a perfect-foresight trader could take, how much slack a mechanical rule has,
how many days carry a real directional leg, and whether NQ trends or mean-reverts
intraday by session (variance-ratio tests).

Splits:
  IS   = nq_v5 2023-01-01 .. 2024-12-31
  OOS1 = nq_v5 2025-01-01 ..
  OOS2 = mnq_v5 (all, 2026)

Costs (for $ figures on 1 micro):
  MNQ point_val = 2, commission $1.50 RT, slippage 0.25pt entry + 0.25pt stop exit
  -> cost floor ~= $1.50 + 0.5pt*$2 = $2.50 per round turn = 1.25 index points.
NQ points == MNQ points (same index), so all point numbers are directly comparable.

Apex constraint: flat by 16:59 ET, no overnight. Tradeable window inside a
18:00-anchored day-cycle is therefore 18:00 -> 16:59 next day (continuous, one
flatten per day). We report both that FULL-CYCLE window and RTH-only 09:30-15:59.
"""

import numpy as np
import pandas as pd
import warnings

warnings.filterwarnings("ignore")
pd.set_option("display.width", 200)

DATA = "/Users/kaveh/qt_cascade/"
MICRO_PV = 2.0            # $ per index point, 1 MNQ
COMM_RT = 1.50            # $ round turn
SLIP_PT = 0.25            # points adverse, entry and stop exit
COST_PTS = COMM_RT / MICRO_PV + 2 * SLIP_PT   # 1.25 index points per round turn
COST_USD = COST_PTS * MICRO_PV                # $2.50

SESS_NAME = {3: "Q1 Asia 18-24", 0: "Q2 London 00-06", 1: "Q3 NY-am 06-12", 2: "Q4 NY-pm 12-18"}
SESS_ORDER = [3, 0, 1, 2]


# ----------------------------------------------------------------------------- helpers
def q(x, p):
    x = np.asarray(x, dtype=float)
    x = x[np.isfinite(x)]
    return np.nan if len(x) == 0 else float(np.percentile(x, p))


def desc(x):
    x = np.asarray(x, dtype=float)
    x = x[np.isfinite(x)]
    if len(x) == 0:
        return dict(n=0)
    return dict(n=len(x), mean=float(x.mean()), p10=q(x, 10), p25=q(x, 25),
                med=q(x, 50), p75=q(x, 75), p90=q(x, 90), max=float(x.max()))


def line(lbl, d, unit=""):
    if d.get("n", 0) == 0:
        print(f"  {lbl:<34s} n=0")
        return
    print(f"  {lbl:<34s} n={d['n']:>4d}  mean={d['mean']:>9.1f}  p10={d['p10']:>8.1f}  "
          f"p25={d['p25']:>8.1f}  MED={d['med']:>8.1f}  p75={d['p75']:>8.1f}  "
          f"p90={d['p90']:>8.1f}  max={d['max']:>9.1f} {unit}")


def load():
    nq = pd.read_parquet(DATA + "nq_v5.parquet")
    mnq = pd.read_parquet(DATA + "mnq_v5.parquet")
    IS = nq[(nq.index >= "2023-01-01") & (nq.index < "2025-01-01")]
    O1 = nq[nq.index >= "2025-01-01"]
    O2 = mnq
    return {"IS": IS, "OOS1": O1, "OOS2": O2}


# ------------------------------------------------------------------ per-day extraction
def day_frames(df, window):
    """Yield (daycycle, sub-df) for the requested tradeable window.
    window='cycle' -> whole 18:00-anchored cycle, truncated at 16:59 (Apex flat).
    window='rth'   -> 09:30..15:59 only.
    """
    t = df.index
    mins = t.hour * 60 + t.minute
    if window == "cycle":
        # The 18:00-anchored cycle already runs 18:00 -> 16:59 (17:00-17:59 is the
        # CME maintenance halt, 0 bars). So the whole cycle IS the Apex-legal window:
        # one flatten at 16:59, no overnight carry across the flatten.
        keep = (mins >= 18 * 60) | (mins <= 16 * 60 + 59)
    else:
        keep = (mins >= 9 * 60 + 30) & (mins <= 15 * 60 + 59)
    sub = df[keep]
    return sub.groupby("daycycle", sort=True)


def perfect_foresight(gr, min_bars=60):
    """Best single long / best single short with perfect foresight (entry bar i,
    exit bar j>=i, intrabar extremes allowed). Returns DataFrame per day-cycle."""
    rows = []
    for dc, g in gr:
        h = g["h"].to_numpy(float)
        l = g["l"].to_numpy(float)
        c = g["c"].to_numpy(float)
        o = g["o"].to_numpy(float)
        n = len(h)
        if n < min_bars:
            continue
        runmin = np.minimum.accumulate(l)
        runmax = np.maximum.accumulate(h)
        best_long = float(np.max(h - runmin))
        best_short = float(np.max(runmax - l))
        rng = float(h.max() - l.min())
        rows.append(dict(daycycle=dc, n=n, rng=rng,
                         best_long=best_long, best_short=best_short,
                         best_one=max(best_long, best_short),
                         both=best_long + best_short,
                         open=o[0], close=c[-1], hi=h.max(), lo=l.min(),
                         px=float(np.median(c))))
    return pd.DataFrame(rows)


def rth_stats(df):
    """RTH 09:30-15:59 range + open->close signed move, per day-cycle."""
    t = df.index
    mins = t.hour * 60 + t.minute
    keep = (mins >= 9 * 60 + 30) & (mins <= 15 * 60 + 59)
    sub = df[keep]
    g = sub.groupby("daycycle", sort=True)
    out = g.agg(rth_hi=("h", "max"), rth_lo=("l", "min"),
                rth_open=("o", "first"), rth_close=("c", "last"), nb=("c", "size"))
    out["rth_rng"] = out.rth_hi - out.rth_lo
    out["rth_oc"] = out.rth_close - out.rth_open
    return out


def daily_atr(df, nlag=14):
    """ATR over day-cycle bars (TR of the cycle), lagged so it is knowable at open."""
    g = df.groupby("daycycle", sort=True).agg(hi=("h", "max"), lo=("l", "min"),
                                              cl=("c", "last"))
    pc = g.cl.shift(1)
    tr = np.maximum(g.hi - g.lo, np.maximum((g.hi - pc).abs(), (g.lo - pc).abs()))
    atr = tr.rolling(nlag, min_periods=5).mean().shift(1)
    return atr.rename("atr_d"), g.cl.rename("cl_d")


# ------------------------------------------------------------ clean-run zigzag
def zigzag_legs(h, l, P):
    """Decompose the day's path into swings that never retrace more than P points.
    A leg is therefore a CLEAN directional run: it went X points without ever
    giving back P. Adverse test is applied BEFORE the extension test inside a bar
    (same conservative convention as 'stop fills first').
    Returns (max_up_leg_pts, max_dn_leg_pts, n_legs, all_leg_magnitudes).
    """
    legs = []
    n = len(h)
    if n < 3:
        return 0.0, 0.0, 0, legs
    d = 0                      # 0 undecided, +1 up, -1 down
    hi = h[0]
    lo = l[0]
    anchor_lo = l[0]
    anchor_hi = h[0]
    up = 0.0
    dn = 0.0
    nl = 0
    for i in range(1, n):
        hh, ll = h[i], l[i]
        if d == 0:
            if hh >= lo + P:
                d = 1
                anchor_lo = lo
                hi = hh
            elif ll <= hi - P:
                d = -1
                anchor_hi = hi
                lo = ll
            else:
                hi = max(hi, hh)
                lo = min(lo, ll)
        elif d == 1:
            if ll <= hi - P:                 # reversal first (conservative)
                mag = hi - anchor_lo
                up = max(up, mag)
                legs.append(mag)
                nl += 1
                d = -1
                anchor_hi = hi
                lo = ll
            elif hh > hi:
                hi = hh
        else:
            if hh >= lo + P:
                mag = anchor_hi - lo
                dn = max(dn, mag)
                legs.append(mag)
                nl += 1
                d = 1
                anchor_lo = lo
                hi = hh
            elif ll < lo:
                lo = ll
    if d == 1:
        mag = hi - anchor_lo
        up = max(up, mag)
        legs.append(mag)
        nl += 1
    elif d == -1:
        mag = anchor_hi - lo
        dn = max(dn, mag)
        legs.append(mag)
        nl += 1
    return float(up), float(dn), nl, legs


# ------------------------------------------ perfect vs random entry, real stop
def entry_scan_day(h, l, o, c, S, RR, stride=3):
    """For every stride-th bar i: entry at o[i+1], stop S, target RR*S, time-exit at
    the last close of the window. Stop wins intrabar ties.
    Returns dict with:
      perfect-entry best MFE-before-stop (long/short), and the RANDOM-ENTRY
      distribution: hit rate at RR, avgR (gross), median MFE/S.
    """
    n = len(h)
    if n < 5:
        return None
    bl = bs = 0.0
    Rs = []
    wins = 0
    tot = 0
    opp_long = 0
    opp_short = 0
    last = c[-1]
    for i in range(0, n - 1):
        p = o[i + 1]
        fl = l[i + 1:]
        fh = h[i + 1:]
        # ---------------- LONG
        hs = np.flatnonzero(fl <= p - S)
        e = hs[0] if hs.size else fl.size          # stop bar index (exclusive)
        mfe_l = (fh[:e].max() - p) if e > 0 else 0.0
        if mfe_l > bl:
            bl = mfe_l
        # ---------------- SHORT
        hs = np.flatnonzero(fh >= p + S)
        e2 = hs[0] if hs.size else fh.size
        mfe_s = (p - fl[:e2].min()) if e2 > 0 else 0.0
        if mfe_s > bs:
            bs = mfe_s
        if mfe_l >= RR * S:
            opp_long += 1
        if mfe_s >= RR * S:
            opp_short += 1
        if i % stride:
            continue
        # random-entry accounting for both directions
        # stopped = the stop bar exists inside the window (e_ < nfwd)
        for mfe, e_, nfwd, sign in ((mfe_l, e, fl.size, +1), (mfe_s, e2, fh.size, -1)):
            tot += 1
            if mfe >= RR * S:
                Rs.append(RR)
                wins += 1
            elif e_ < nfwd:
                Rs.append(-1.0)
            else:
                Rs.append(sign * (last - p) / S)
    Rs = np.asarray(Rs, float)
    return dict(bl=bl, bs=bs, best=max(bl, bs),
                rnd_avgR=float(Rs.mean()) if Rs.size else np.nan,
                rnd_hit=wins / tot if tot else np.nan,
                n_entries=tot,
                opp_long=opp_long, opp_short=opp_short,
                opp_frac=(opp_long + opp_short) / max(2 * (n - 1), 1))


def day_scan(gr, S=30, RR=2.0, P_list=(20, 30, 50), min_bars=200, atr_map=None):
    rows = []
    for dc, g in gr:
        h = g["h"].to_numpy(float)
        l = g["l"].to_numpy(float)
        o = g["o"].to_numpy(float)
        c = g["c"].to_numpy(float)
        if len(h) < min_bars:
            continue
        r = dict(daycycle=dc, nbars=len(h))
        es = entry_scan_day(h, l, o, c, S, RR)
        if es is None:
            continue
        r.update({f"best{S}": es["best"], f"L{S}": es["bl"], f"S{S}": es["bs"],
                  f"R{S}": es["best"] / S, "rnd_avgR": es["rnd_avgR"],
                  "rnd_hit": es["rnd_hit"], "opp_frac": es["opp_frac"],
                  "opp_n": es["opp_long"] + es["opp_short"]})
        for P in P_list:
            up, dn, nl, legs = zigzag_legs(h, l, P)
            r[f"zz_up{P}"] = up
            r[f"zz_dn{P}"] = dn
            r[f"zz_max{P}"] = max(up, dn)
            r[f"zz_n{P}"] = nl
            la = np.asarray(legs, float)
            # how many CLEAN legs per day clear a given size (= how many real
            # "big trades" actually exist in the day, not how many bars look good)
            for thr in (60, 90, 100, 150, 200):
                r[f"cnt{P}_{thr}"] = int((la >= thr).sum())
            # scale-free: legs as a fraction of that day's own range
            rng_d = h.max() - l.min()
            if rng_d > 0:
                for fr in (25, 40, 60):
                    r[f"cntf{P}_{fr}"] = int((la >= fr / 100.0 * rng_d).sum())
                r[f"eff{P}"] = max(up, dn) / rng_d
        # CAUSAL scale-free variant: pullback tolerance = fraction of the PRIOR
        # 14-cycle ATR (known at the open), so no price-level or look-ahead artefact.
        if atr_map is not None:
            a = atr_map.get(dc, np.nan)
            if np.isfinite(a) and a > 0:
                rng_d = h.max() - l.min()
                for tag, fr in (("a10", 0.10), ("a20", 0.20)):
                    up, dn, nl, legs = zigzag_legs(h, l, fr * a)
                    la = np.asarray(legs, float)
                    r[f"P_{tag}"] = fr * a
                    r[f"zzmax_{tag}"] = max(up, dn)
                    r[f"eff_{tag}"] = max(up, dn) / rng_d if rng_d > 0 else np.nan
                    r[f"R_{tag}"] = max(up, dn) / (fr * a)
                    r[f"n_{tag}"] = nl
                    r[f"cnt_{tag}_3R"] = int((la >= 3 * fr * a).sum())
                    r[f"cnt_{tag}_5R"] = int((la >= 5 * fr * a).sum())
                    r[f"cnt_{tag}_40"] = int((la >= 0.40 * rng_d).sum()) if rng_d > 0 else 0
        rows.append(r)
    return pd.DataFrame(rows)


# ------------------------------------------------------------------ variance ratio
def block_returns(df, freq_min):
    """Log returns at freq_min sampled inside contiguous session blocks.
    Returns (r array, sess array, blockid array)."""
    t = df.index
    # resample close to freq within each (daycycle,sess) block
    key = df["daycycle"].astype(str) + "_" + df["sess"].astype(str)
    out_r, out_s = [], []
    for k, g in df.groupby(key, sort=False):
        if len(g) < 4 * freq_min:
            continue
        cl = g["c"].to_numpy(float)
        idx = np.arange(0, len(cl), freq_min)
        px = cl[idx]
        if len(px) < 3:
            continue
        r = np.diff(np.log(px))
        out_r.append(r)
        out_s.append(np.full(len(r), g["sess"].iloc[0]))
    if not out_r:
        return np.array([]), np.array([])
    return np.concatenate(out_r), np.concatenate(out_s)


def ac1(r):
    r = r[np.isfinite(r)]
    if len(r) < 30:
        return np.nan, np.nan, len(r)
    x = r - r.mean()
    num = np.sum(x[1:] * x[:-1])
    den = np.sum(x * x)
    rho = num / den
    se = 1.0 / np.sqrt(len(r))
    return float(rho), float(rho / se), len(r)


def variance_ratio(df, qlag, sess_filter=None):
    """Lo-MacKinlay VR(q) on 1-min log returns, computed only within contiguous
    (daycycle, sess) blocks so no overnight/session-gap returns leak in.
    Heteroskedasticity-robust z* returned."""
    d = df if sess_filter is None else df[df["sess"] == sess_filter]
    key = (d["daycycle"].astype(str) + "_" + d["sess"].astype(str)).to_numpy()
    cl = d["c"].to_numpy(float)
    r = np.diff(np.log(cl))
    same = key[1:] == key[:-1]
    r = np.where(same, r, np.nan)
    blk = key[1:]
    ok = np.isfinite(r)
    if ok.sum() < 500:
        return np.nan, np.nan, int(ok.sum())
    mu = np.nanmean(r)
    x = r - mu
    x0 = np.where(np.isfinite(x), x, 0.0)
    valid = np.isfinite(x)
    var1 = np.nansum(x * x) / (valid.sum() - 1)
    # autocorrelations, only pairs inside the same block
    vr = 1.0
    theta = 0.0
    denom = np.nansum(x * x)
    for k in range(1, qlag):
        a = x0[k:]
        b = x0[:-k]
        va = valid[k:] & valid[:-k] & (blk[k:] == blk[:-k])
        if va.sum() < 50:
            continue
        cov = np.sum((a * b)[va])
        rho = cov / denom
        w = 1.0 - k / qlag
        vr += 2 * w * rho
        # delta_k for robust variance
        num = np.sum(((a ** 2) * (b ** 2))[va])
        delta = num / (denom ** 2)
        theta += (2.0 * (qlag - k) / qlag) ** 2 * delta
    z = (vr - 1.0) / np.sqrt(theta) if theta > 0 else np.nan
    return float(vr), float(z), int(valid.sum())


