#!/usr/bin/env python3
"""
trade_logger.py — TRADE-LEVEL logger for the Co-Invest paper account.

Feed it `get_portfolio` JSON (file arg or stdin). It keeps state across runs and:
  - detects & appends every position EVENT to trade_events.csv:
        OPEN / ADD / REDUCE / CLOSE / FLIP  (with PnL at the moment it was logged)
  - rewrites open_positions.csv: every CURRENT position with how it's doing now +
        WHEN IT WAS OPENED (first time this logger saw it) and its age
  - persists positions_state.json between runs.

HONEST LIMITS (the API only returns current open positions — no fills, no open time):
  * "opened" = the first time THIS logger saw the position. Accuracy = run cadence.
    Run it often (hourly/daily) to make open-times and trade-capture meaningful;
    a weekly cadence will MISS positions opened and closed within the same week.
  * Positions that already existed on the very first run are marked BASELINE /
    opened_known=False (their true open time predates the logger — not fabricated).
  * Realized PnL on CLOSE = the LAST unrealized PnL observed before it disappeared
    (the API can't report a gone position), so it's an approximation, flagged as such.
"""
import sys, json, csv, os, datetime as dt

HERE   = os.path.dirname(os.path.abspath(__file__))
EVENTS = os.path.join(HERE, "trade_events.csv")
OPEN   = os.path.join(HERE, "open_positions.csv")
STATE  = os.path.join(HERE, "positions_state.json")

EVENT_COLS = ["event_time","event","symbol","side","size_change","size_after",
              "entryPx","markPx","unrealizedPnl","returnOnEquity","note"]
OPEN_COLS  = ["as_of","symbol","side","size","entryPx","markPx","unrealizedPnl",
              "returnOnEquity","opened_at","age_days","opened_known"]


def fnum(x, d=0.0):
    try: return float(x)
    except (TypeError, ValueError): return d


def main():
    raw = open(sys.argv[1]).read() if len(sys.argv) > 1 else sys.stdin.read()
    p = json.loads(raw)
    positions = p.get("positions", []) or []
    now = dt.datetime.now().astimezone().isoformat(timespec="seconds")

    first_run = not os.path.exists(STATE)
    state = {} if first_run else json.load(open(STATE))

    cur = {}
    for z in positions:
        sym = z.get("symbol", "")
        cur[sym] = dict(side=z.get("side",""), size=abs(fnum(z.get("size"))),
                        entryPx=fnum(z.get("entryPx")), markPx=fnum(z.get("markPx")),
                        upnl=fnum(z.get("unrealizedPnl")), roe=fnum(z.get("returnOnEquity")))

    events = []
    def ev(event, sym, c, dsz, note=""):
        events.append({"event_time":now,"event":event,"symbol":sym,"side":c["side"],
            "size_change":f"{dsz:+g}" if dsz is not None else "","size_after":f"{c['size']:g}",
            "entryPx":f"{c['entryPx']:g}","markPx":f"{c['markPx']:g}",
            "unrealizedPnl":f"{c['upnl']:+.4f}","returnOnEquity":f"{c['roe']*100:+.2f}%","note":note})

    # opens / adds / reduces / flips
    for sym, c in cur.items():
        if sym not in state:
            if first_run:
                ev("BASELINE", sym, c, None, "pre-existing; true open time predates logger")
                opened_at, known = now, False
            else:
                ev("OPEN", sym, c, c["size"], "")
                opened_at, known = now, True
            state[sym] = dict(side=c["side"], size=c["size"], entryPx=c["entryPx"],
                              opened_at=opened_at, opened_known=known,
                              last_mark=c["markPx"], last_upnl=c["upnl"], last_roe=c["roe"])
        else:
            st = state[sym]
            if c["side"] != st["side"]:                       # direction flip = close + reopen
                gone = dict(side=st["side"], size=0.0, entryPx=st["entryPx"],
                            markPx=st.get("last_mark",0.0), upnl=st.get("last_upnl",0.0), roe=st.get("last_roe",0.0))
                ev("CLOSE", sym, gone, -st["size"], "flip: closed before reversing")
                ev("OPEN", sym, c, c["size"], "flip: reopened opposite side")
                st.update(side=c["side"], size=c["size"], entryPx=c["entryPx"],
                          opened_at=now, opened_known=True)
            else:
                d = c["size"] - st["size"]
                if   d >  1e-12: ev("ADD",    sym, c, d, "scaled up")
                elif d < -1e-12: ev("REDUCE", sym, c, d, "partial close")
                st.update(size=c["size"], entryPx=c["entryPx"])
            st.update(last_mark=c["markPx"], last_upnl=c["upnl"], last_roe=c["roe"])

    # closes (in state, no longer present)
    for sym in [s for s in state if s not in cur]:
        st = state[sym]
        gone = dict(side=st["side"], size=0.0, entryPx=st["entryPx"],
                    markPx=st.get("last_mark",0.0), upnl=st.get("last_upnl",0.0), roe=st.get("last_roe",0.0))
        ev("CLOSE", sym, gone, -st["size"], "final PnL approx = last observed before close")
        del state[sym]

    # append events
    new = not os.path.exists(EVENTS)
    with open(EVENTS, "a", newline="") as f:
        w = csv.DictWriter(f, fieldnames=EVENT_COLS);
        if new: w.writeheader()
        w.writerows(events)

    # rewrite current open positions with age + opened_at
    with open(OPEN, "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=OPEN_COLS); w.writeheader()
        for sym, c in sorted(cur.items()):
            st = state[sym]; oa = st["opened_at"]
            age = (dt.datetime.fromisoformat(now) - dt.datetime.fromisoformat(oa)).total_seconds()/86400
            w.writerow({"as_of":now,"symbol":sym,"side":c["side"],"size":f"{c['size']:g}",
                "entryPx":f"{c['entryPx']:g}","markPx":f"{c['markPx']:g}",
                "unrealizedPnl":f"{c['upnl']:+.4f}","returnOnEquity":f"{c['roe']*100:+.2f}%",
                "opened_at":oa,"age_days":f"{age:.2f}","opened_known":st["opened_known"]})

    json.dump(state, open(STATE, "w"), indent=0)

    # report
    print(f"[trade_logger] {now}  ({'FIRST RUN — baseline' if first_run else 'diff vs prior run'})")
    if events:
        for e in events:
            print(f"  {e['event']:8} {e['symbol']:10} size_after {e['size_after']:>7}  "
                  f"PnL {e['unrealizedPnl']:>9} ({e['returnOnEquity']})  {e['note']}")
    else:
        print("  no position changes since last run")
    print(f"  -> {EVENTS}\n  -> {OPEN}")


if __name__ == "__main__":
    main()

