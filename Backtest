"""Self-contained US-equity (NYSE/Nasdaq) trading-day calendar.

Built on pandas' holiday machinery so the project carries no external calendar
dependency (``pandas-market-calendars`` requires Python >= 3.10 at runtime).

Scope: this returns the set of *full-closure* trading dates. A daily close->open
strategy needs only which dates trade -- intraday early-close (half-day) times are
out of scope because they do not change the daily date sequence. Returns are computed
from consecutive *observed* rows (M2), so this calendar's primary job is data-quality
gap detection, not return alignment.

Coverage: standard NYSE holidays for the modern era plus known ad-hoc closures from
2000 onward (9/11, Hurricane Sandy, national days of mourning) and Juneteenth from
its first NYSE observance in 2022.
"""
from __future__ import annotations

from datetime import date

import pandas as pd
from pandas.tseries.holiday import (
    AbstractHolidayCalendar,
    GoodFriday,
    Holiday,
    USLaborDay,
    USMartinLutherKingJr,
    USMemorialDay,
    USPresidentsDay,
    USThanksgivingDay,
    nearest_workday,
    sunday_to_monday,
)

# NYSE does NOT take the Friday before a Saturday New Year's Day, but does observe a
# Sunday New Year's on the following Monday -> ``sunday_to_monday``. All other movable
# holidays use ``nearest_workday`` (Sat->Fri, Sun->Mon), matching NYSE convention.
_JUNETEENTH_FIRST_NYSE = pd.Timestamp("2022-06-19")


class USEquityHolidayCalendar(AbstractHolidayCalendar):
    """Full-closure NYSE/Nasdaq holidays (rule-based)."""

    rules = [
        Holiday("New Year's Day", month=1, day=1, observance=sunday_to_monday),
        USMartinLutherKingJr,
        USPresidentsDay,
        GoodFriday,
        USMemorialDay,
        Holiday("Juneteenth", month=6, day=19, start_date=_JUNETEENTH_FIRST_NYSE,
                observance=nearest_workday),
        Holiday("Independence Day", month=7, day=4, observance=nearest_workday),
        USLaborDay,
        USThanksgivingDay,
        Holiday("Christmas", month=12, day=25, observance=nearest_workday),
    ]


# Unscheduled full-day closures (not derivable from rules), 2000-onward.
AD_HOC_CLOSURES = pd.to_datetime([
    "2001-09-11", "2001-09-12", "2001-09-13", "2001-09-14",  # September 11 attacks
    "2004-06-11",  # National day of mourning, Ronald Reagan
    "2007-01-02",  # National day of mourning, Gerald Ford
    "2012-10-29", "2012-10-30",  # Hurricane Sandy
    "2018-12-05",  # National day of mourning, George H. W. Bush
    "2025-01-09",  # National day of mourning, Jimmy Carter
])

_CALENDAR = USEquityHolidayCalendar()


def _ts(value: str | date | pd.Timestamp) -> pd.Timestamp:
    return pd.Timestamp(value).normalize()


def trading_days(start: str | date | pd.Timestamp,
                 end: str | date | pd.Timestamp) -> pd.DatetimeIndex:
    """Return the sorted trading days in the inclusive ``[start, end]`` range."""
    start, end = _ts(start), _ts(end)
    if start > end:
        return pd.DatetimeIndex([], name="date")
    weekdays = pd.bdate_range(start, end)  # Mon-Fri
    holidays = _CALENDAR.holidays(start, end)
    days = weekdays.difference(holidays).difference(AD_HOC_CLOSURES)
    return pd.DatetimeIndex(days, name="date")


def is_trading_day(day: str | date | pd.Timestamp) -> bool:
    """True if ``day`` is a full NYSE/Nasdaq trading day."""
    day = _ts(day)
    return len(trading_days(day, day)) == 1


def next_trading_day(day: str | date | pd.Timestamp) -> pd.Timestamp:
    """First trading day strictly after ``day``."""
    day = _ts(day)
    window = trading_days(day + pd.Timedelta(days=1), day + pd.Timedelta(days=10))
    return window[0]


def previous_trading_day(day: str | date | pd.Timestamp) -> pd.Timestamp:
    """Last trading day strictly before ``day``."""
    day = _ts(day)
    window = trading_days(day - pd.Timedelta(days=10), day - pd.Timedelta(days=1))
    return window[-1]


def validate_against_calendar(index: pd.DatetimeIndex) -> dict[str, list[pd.Timestamp]]:
    """Compare a daily price index to the expected trading calendar.

    Returns a dict with ``missing`` (expected trading days absent from the index) and
    ``unexpected`` (index dates that are not trading days). Both feed M1 data QC.
    """
    if len(index) == 0:
        return {"missing": [], "unexpected": []}
    idx = pd.DatetimeIndex(index).normalize()
    expected = trading_days(idx.min(), idx.max())
    missing = expected.difference(idx)
    unexpected = idx.difference(expected)
    return {"missing": list(missing), "unexpected": list(unexpected)}

