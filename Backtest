                col[s] = t
                break
    out = px[[col[s] for s in col]].copy()
    out.columns = list(col.keys())
    out.to_parquet(PX_CACHE)
    missing = [s for s in every if s not in col]
    print(f"mapped {len(col)}/{len(every)} symbols to Yahoo | cached -> {PX_CACHE}")
    print("UNMAPPED (no Yahoo data):", ", ".join(missing))
    return out, missing


def main():
