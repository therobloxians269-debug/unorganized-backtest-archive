    swe = [(s, e) for s, e in swe if e is not None]
    print(f"f12_exit_engine window={a.window} sessions={len(S)} entries={len(swe)}")
    print(f"FROZEN ENTRY: ORB+VWAP first breakout, ER(24)>=%.2f, stop=max(%.1fxATR,%.0fpt), 1 entry/day"
          % (ER_THR, ATR_MULT, FLOOR))

