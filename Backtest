    df = df[df["symbol"].str.match(r"^[A-Z0-9]{2}[FGHJKMNQUVXZ]\d$")].copy()
    df.index = pd.to_datetime(df.index)
    df["date"] = df.index.tz_localize(None).normalize()
    df = df[df["close"] > 0]

    # parse root / month / year-digit
    ex = df["symbol"].str.extract(PAT)
    df = df.assign(root=ex[0], mc=ex[1], yd=ex[2]).dropna(subset=["root", "mc", "yd"])
    df = df[df["root"].isin(ROOTS)]
    df["yd"] = df["yd"].astype(int)
    yr = df["date"].dt.year.values
    base = yr - 1
    df["eyear"] = base + ((df["yd"].values - base) % 10)        # resolve decade
    df["key"] = df["eyear"] * 12 + df["mc"].map(MCODE).astype(int)  # expiry sort key

    # same-contract daily return (no roll jump)
    df = df.sort_values(["root", "symbol", "date"])
    df["ret"] = df.groupby(["root", "symbol"])["close"].pct_change()

    # front = max-volume contract per (root,date)
    df = df.sort_values(["root", "date", "volume"])
    front = df.groupby(["root", "date"]).tail(1)[
        ["root", "date", "symbol", "close", "ret", "volume", "key"]
    ].rename(columns={"symbol": "fsym", "close": "fclose", "ret": "fret",
                      "volume": "fvol", "key": "fkey"})

    # next = max-volume contract with expiry strictly beyond front
    m = df.merge(front[["root", "date", "fkey"]], on=["root", "date"])
    cand = m[m["key"] > m["fkey"]]
    nxt = cand.sort_values(["root", "date", "volume"]).groupby(["root", "date"]).tail(1)[
        ["root", "date", "close", "key"]
    ].rename(columns={"close": "nclose", "key": "nkey"})

    panel = front.merge(nxt, on=["root", "date"], how="left").sort_values(["root", "date"])
    # annualized carry from the front/next term-structure slope
    mo = (panel["nkey"] - panel["fkey"]).replace(0, np.nan)
    panel["carry_ann"] = (panel["fclose"] / panel["nclose"] - 1) * (12.0 / mo)
    panel = panel.dropna(subset=["fret"])
