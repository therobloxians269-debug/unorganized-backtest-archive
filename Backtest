"""
THE COMBINED PROGRAM (one script) -- the ~1.4-Sharpe stack:
  LEG A (60% risk): crypto XS-momentum, long-only, trend-filtered (soft 0.3x in downtrend)
  LEG B (40% risk): diversified futures trend (14 mkts, 63/126/252 tanh, weekly, capped)
Combines on the union calendar (crypto earns weekends, futures weekdays), reports the full
stat sheet + per-year + frontier, then prints TODAY'S live target positions for both legs.

  PYTHONPATH=/Users/kaveh/mim_research python3 portfolio_combined.py [account_usd]

Honesty: crypto leg survivorship-inflated (current coins); futures leg needs $25k+ for
discrete contracts (else run it on Apex paper); corr measured ~+0.06.
"""
from __future__ import annotations
import sys
import numpy as np
import pandas as pd
from lib_perf import perf_stats, psr, per_year, maxdd

PANEL = "/Users/kaveh/mim_research/futures_panel.parquet"
COINS = ["BTC-USD","ETH-USD","BNB-USD","XRP-USD","ADA-USD","SOL-USD","DOGE-USD","DOT-USD",
         "AVAX-USD","LINK-USD","LTC-USD","BCH-USD","ATOM-USD","XLM-USD","ETC-USD","TRX-USD",
         "UNI-USD","FIL-USD","ALGO-USD","VET-USD","HBAR-USD","NEAR-USD","AAVE-USD","MKR-USD",
         "EOS-USD","XTZ-USD","THETA-USD","AXS-USD","SAND-USD","MANA-USD"]
W_CRYPTO, W_FUT = 0.60, 0.40            # risk weights
CRYPTO_COST_BP, FUT_COST_BP = 25.0, 3.0
ANN_C, ANN_F = 365, 252


# ---------------- LEG A: crypto keeper ----------------
def crypto_leg():
    import yfinance as yf
    px = yf.download(COINS, start="2017-01-01", auto_adjust=True, progress=False)["Close"]
    px = px.dropna(how="all").dropna(axis=1, thresh=int(len(px) * 0.20))
    rets = px.pct_change()
    av = (rets.rolling(60).std() * np.sqrt(ANN_C)).shift(1)
    k = max(3, px.shape[1] // 3)
    rank = px.pct_change(90).shift(1).rank(axis=1, ascending=False)
    w = ((rank <= k).astype(float) / av)
    w = w.div(w.abs().sum(axis=1).replace(0, np.nan), axis=0).fillna(0.0)
    mkt = (1 + rets.mean(axis=1)).cumprod()
    up = (mkt > mkt.rolling(100).mean()).shift(1).reindex(px.index).fillna(True)
    soft = up.replace(False, 0.3).replace(True, 1.0).astype(float)
    w = w.mul(soft, axis=0).shift(1).resample("W").last().reindex(px.index, method="ffill")
    net = ((w * rets).sum(axis=1) - w.diff().abs().sum(axis=1) * CRYPTO_COST_BP * 1e-4).dropna()
    # today's live weights (pre-shift target = latest signal row)
    rank_t = px.pct_change(90).rank(axis=1, ascending=False).iloc[-1]
    wt = ((rank_t <= k).astype(float) / av.iloc[-1]).fillna(0.0)
    wt = wt / wt.sum() if wt.sum() > 0 else wt
    regime = float(soft.iloc[-1])
    return net, wt[wt > 0].sort_values(ascending=False), regime


# ---------------- LEG B: futures trend ----------------
def futures_leg():
    p = pd.read_parquet(PANEL)
    F = p.pivot_table(index="date", columns="root", values="fret").sort_index()
    AV = (F.rolling(63).std() * np.sqrt(ANN_F)).shift(1)
    P = (1 + F.fillna(0)).cumprod()
    z = sum((P / P.shift(L) - 1) / (AV * np.sqrt(L / ANN_F)) for L in (63, 126, 252)) / 3
    w = (np.tanh(z) / AV)
    w = w.div(w.abs().sum(axis=1).replace(0, np.nan), axis=0).fillna(0.0).clip(-0.2, 0.2)
    w = w.shift(1).resample("W").last().reindex(F.index, method="ffill")
    sc = (0.12 / ((w * F).sum(axis=1).rolling(63).std() * np.sqrt(ANN_F))).shift(1).clip(0, 3).fillna(0.0)
    w = w.mul(sc, axis=0)
    net = ((w * F).sum(axis=1) - w.diff().abs().sum(axis=1) * FUT_COST_BP * 1e-4).dropna()
    live = w.iloc[-1]
    return net, live[live.abs() > 0.01].sort_values(key=abs, ascending=False)


def main():
    acct = float(sys.argv[1]) if len(sys.argv) > 1 else 10_000.0
    cnet, cw, regime = crypto_leg()
    fnet, fw = futures_leg()

    # union calendar: futures flat (0) on weekends
    idx = cnet.index.union(fnet.index)
    c = cnet.reindex(idx).fillna(0.0)
    f = fnet.reindex(idx).fillna(0.0)
    # unit-risk scale each leg on its own realized vol, then 60/40
    c_u = c / (cnet.std() * np.sqrt(ANN_C))
    f_u = f / (fnet.std() * np.sqrt(ANN_F))
    combo = (W_CRYPTO * c_u + W_FUT * f_u).dropna()
    combo = combo[combo.index >= "2017-06-01"]               # both legs warmed up

    j = pd.concat([cnet.rename("C"), fnet.rename("F")], axis=1).dropna()
    rho = j["C"].corr(j["F"])
    print("=" * 64)
    print("COMBINED PROGRAM  (60% crypto momentum / 40% futures trend)")
    print("=" * 64)
    sC, sF = perf_stats(cnet, ANN_C), perf_stats(fnet, ANN_F)
    print(f"  leg A crypto:  Sharpe {sC['sharpe']:.2f} | CAGR {sC['cagr']*100:.0f}% | maxDD {sC['maxdd']*100:.0f}%")
    print(f"  leg B futures: Sharpe {sF['sharpe']:.2f} | CAGR {sF['cagr']*100:.1f}% | maxDD {sF['maxdd']*100:.0f}%")
    print(f"  corr(A,B) = {rho:+.2f}\n")

    base = combo / (combo.std() * np.sqrt(ANN_C))
    print(f"  COMBINED frontier (scale to taste; account ${acct:,.0f}):")
    print(f"    {'vol':>5} {'Sharpe':>6} {'CAGR':>6} {'maxDD':>7} {'end$':>10}")
    for vt in (0.15, 0.20, 0.25, 0.30):
        r = base * vt
        s = perf_stats(r, ANN_C)
        flag = "  <- ~30% DD budget" if -0.34 < s['maxdd'] < -0.26 else ""
        print(f"    {vt*100:4.0f}% {s['sharpe']:6.2f} {s['cagr']*100:5.0f}% {s['maxdd']*100:6.0f}% "
              f"{acct*(1+r).prod():10,.0f}{flag}")
    r25 = base * 0.25
    print(f"\n  PSR(>0) {psr(r25,0,ANN_C)*100:.0f}% | PSR(>1.0) {psr(r25,1.0,ANN_C)*100:.0f}%")
    print("\n  per-year (combined @25% vol):")
    for y, v in per_year(r25).items():
        print(f"    {y}   {v*100:+6.1f}%")

    print("\n" + "=" * 64)
    print(f"TODAY'S TARGETS  (account ${acct:,.0f}; regime multiplier {regime:.1f}x)")
    print("=" * 64)
    cbudget = acct * W_CRYPTO * regime
    print(f"  LEG A crypto (${cbudget:,.0f} deployed of ${acct*W_CRYPTO:,.0f} budget; "
          f"{'DOWNTREND -> de-risked' if regime < 1 else 'UPTREND -> full'}):")
    for sym, wt in cw.items():
        print(f"    {sym:10s} {wt*100:5.1f}%   ${cbudget*wt:8,.0f}")
    print(f"\n  LEG B futures (risk budget {W_FUT:.0%}; needs ~$25k+ real or Apex paper):")
    for root, wt in fw.items():
        print(f"    {root:6s} {'LONG' if wt > 0 else 'SHORT'} {abs(wt)*100:5.1f}% of leg notional")


if __name__ == "__main__":
    main()

