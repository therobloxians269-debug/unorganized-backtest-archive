#!/usr/bin/env python3
"""Regime-routed multi-style MES indicator: TREND style on trend-regime bars,
MEAN-REVERSION/reversal style on range-regime bars. One position at a time,
<=3 trades/day. Router = causal ER(24). Fixed, defensible params (no PnL fit).
Goal: combined equity green in BOTH the pre-2020 range era and post-2020 trend era."""
import numpy as np, pandas as pd
import omni2_lib as L
from omni2_lib import ORN, FLOOR, fric

def routed(sessions, er_t=0.35, er_r=0.13, trend=True, mr="none", stop_atr=1.5, gate_trend=True):
    out = []
    for s in sessions:
        h, l, c, atr, vwap, er = s["h"], s["l"], s["c"], s["atr"], s["vwap"], s["er"]
        orh, orl = s["or_hi"], s["or_lo"]; ph, pl = s["prev_hi"], s["prev_lo"]
        pos = 0; entry = stop = tgt = np.nan; ebar = -1; risk0 = np.nan; exitm = None
        broke = 0; n = 0; style = None
        for b in range(ORN, 78):
            if pos == 0 and n < 3:
                reg = 'trend' if er[b] >= er_t else 'range' if er[b] <= er_r else 'neutral'
                side = 0; st = tg = None; xm = None; stl = None
                trend_ok = trend and (reg == 'trend' or not gate_trend)
                if trend_ok:
                    above = c[b] > vwap[b]; below = c[b] < vwap[b]
                    if broke == 0:
                        if c[b] > orh and above: side = 1; broke = 1
                        elif c[b] < orl and below: side = -1; broke = -1
                    else:
                        if broke == 1 and above and l[b] <= vwap[b]+0.5*atr[b] and c[b] > c[b-1]: side = 1
                        elif broke == -1 and below and h[b] >= vwap[b]-0.5*atr[b] and c[b] < c[b-1]: side = -1
                    if side != 0:
                        st = c[b]-side*max(stop_atr*atr[b], FLOOR); xm = 'eod'; tg = None; stl = 'trend'
                if side == 0 and reg == 'range' and mr != "none":
                    if mr in ('vwapfade', 'both'):
                        dev = c[b]-vwap[b]
                        if dev >= stop_atr*atr[b] and c[b] < c[b-1]: side = -1
                        elif dev <= -stop_atr*atr[b] and c[b] > c[b-1]: side = 1
                        if side != 0:
                            st = c[b]-side*max(stop_atr*atr[b], FLOOR); tg = vwap[b]; xm = 'target'; stl = 'mr_vwap'
                    if side == 0 and mr in ('sweep', 'both') and (ph is not None):
                        if h[b] > ph and h[b]-ph <= 0.5*atr[b] and c[b] < ph-1.0:
                            side = -1; st = h[b]; tg = vwap[b]; xm = 'target'; stl = 'mr_sweep'
                        elif l[b] < pl and pl-l[b] <= 0.5*atr[b] and c[b] > pl+1.0:
                            side = 1; st = l[b]; tg = vwap[b]; xm = 'target'; stl = 'mr_sweep'
                        if side != 0 and abs(c[b]-st) < FLOOR: st = c[b]-side*FLOOR
                if side != 0:
                    pos = side; entry = c[b]; ebar = b; risk0 = abs(entry-st); stop = st; tgt = tg; exitm = xm; style = stl; n += 1
                continue
            if pos != 0 and b > ebar:
                if (l[b] <= stop) if pos > 0 else (h[b] >= stop):
                    g = pos*(stop-entry); out.append((s["date"], g-fric("stop"), risk0, style)); pos = 0; continue
                if exitm == 'target' and ((h[b] >= tgt) if pos > 0 else (l[b] <= tgt)):
                    g = pos*(tgt-entry); out.append((s["date"], g-fric("target"), risk0, style)); pos = 0; continue
                if b == 77:
                    g = pos*(c[b]-entry); out.append((s["date"], g-fric("eod"), risk0, style)); pos = 0
    return pd.DataFrame(out, columns=["date", "net", "risk", "kind"])

def main():
    S = L.load()
    print(f"{len(S)} sessions {S[0]['date']}..{S[-1]['date']}\n")
    print("========== A. TREND style, UNGATED (all regimes) — baseline ==========")
    L.report(routed(S, trend=True, mr="none", gate_trend=False), "A trend ungated")
    print("\n========== B. TREND style, GATED to ER-trend regime only ==========")
    L.report(routed(S, trend=True, mr="none", gate_trend=True), "B trend gated")
    print("\n========== C. GATED trend + VWAP-fade on ER-range regime ==========")
    L.report(routed(S, trend=True, mr="vwapfade"), "C trend + vwapfade")
    print("\n========== D. GATED trend + SWEEP reversal on ER-range regime ==========")
    L.report(routed(S, trend=True, mr="sweep"), "D trend + sweep")
    print("\n========== E. GATED trend + BOTH range styles ==========")
    L.report(routed(S, trend=True, mr="both"), "E trend + both")
    print("\n========== per-style contribution of the best combo (E) ==========")
    e = routed(S, trend=True, mr="both"); e["yr"] = pd.to_datetime(e["date"]).dt.year
    for st in ["trend", "mr_vwap", "mr_sweep"]:
        L.report(e[e["kind"] == st], f"  {st} legs")

if __name__ == "__main__":
    main()

