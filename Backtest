"""Catch the day's clean leg. Designed from the oracle measurement, not a concept.
   Wide stop = the give-back tolerance that DEFINES a clean leg (k x daily ATR).
   Pure trail, no target. The exit rule IS the leg definition."""
import pandas as pd, numpy as np, warnings; warnings.filterwarnings('ignore')
FLAT=1019
def prep(df):
    o=df.copy(); m=(o.index.hour*60+o.index.minute).values
    o['minofday']=m; o['m18']=(m-1080+1440)%1440
    d=o.resample('1440min',origin=o.index[0].normalize()+pd.Timedelta(hours=18),
                 label='left',closed='left').agg({'h':'max','l':'min','c':'last'}).dropna()
    tr=pd.concat([d.h-d.l,(d.h-d.c.shift()).abs(),(d.l-d.c.shift()).abs()],axis=1).max(axis=1)
    o['datr']=tr.rolling(14).mean().shift(1).reindex(o.index,method='ffill')
    r=o.resample('60min',label='left',closed='left').agg({'h':'max','l':'min','c':'last'}).dropna()
    t2=pd.concat([r.h-r.l,(r.h-r.c.shift()).abs(),(r.l-r.c.shift()).abs()],axis=1).max(axis=1)
    o['atr60']=t2.rolling(14).mean().shift(1).reindex(o.index,method='ffill')
    return o

def run(b, trig='donchian', N=60, give=0.20, start=360, stop_t=1019,
        per_day=1, pv=20., comm=4., slip=0.25, min_stop_atr=0.05, displace=None, seed=0):
    """give = give-back tolerance as a fraction of DAILY atr. that is both the
       initial stop and the trail distance — identical to the clean-leg definition."""
    o,h,l,c=b.o.values,b.h.values,b.l.values,b.c.values
    m=b['minofday'].values; da=b['datr'].values; a60=b['atr60'].values
    day=b['daycycle'].values; n=len(b)
    rng=np.random.default_rng(seed)
    hi_n=pd.Series(h).rolling(N).max().shift(1).values
    lo_n=pd.Series(l).rolling(N).min().shift(1).values
    out=[]; cnt={}; i=1
    while i<n-2:
        if m[i]<start or m[i]>=stop_t or not np.isfinite(da[i]) or da[i]<=0:
            i+=1; continue
        k=day[i]
        if cnt.get(k,0)>=per_day: i+=1; continue
        d=0
        if trig=='donchian':
            if np.isfinite(hi_n[i]) and h[i]>hi_n[i]: d=1
            elif np.isfinite(lo_n[i]) and l[i]<lo_n[i]: d=-1
        elif trig=='expansion':
            if np.isfinite(a60[i]) and a60[i]>0:
                rr=(h[i]-l[i])/a60[i]
                if rr>1.0: d=1 if c[i]>o[i] else -1
        if d==0: i+=1; continue
        gp=give*da[i]
        if displace is not None: gp*= (1+displace)
        if gp<min_stop_atr*da[i]: i+=1; continue
        ep=o[i+1]+(slip if d==1 else -slip)
        st=ep-gp if d==1 else ep+gp
        risk=gp
        ext=ep; peak=0.0
        j=i+1; why='time'
        while j<n:
            if m[j]>=stop_t:
                px=o[j]+(slip if d==-1 else -slip); why='flat'; break
            hit=(l[j]<=st) if d==1 else (h[j]>=st)
            if hit:
                px=st+(slip if d==-1 else -slip); why='trail' if peak>0 else 'stop'; break
            ext=max(ext,h[j]) if d==1 else min(ext,l[j])
            peak=max(peak,((ext-ep) if d==1 else (ep-ext))/risk)
            cand=ext-gp if d==1 else ext+gp
            st=max(st,cand) if d==1 else min(st,cand)
            j+=1
        else:
            j=n-1; px=o[j]
        pts=(px-ep) if d==1 else (ep-px)
        out.append(dict(t=b.index[i+1],d=d,pts=pts,R=(pts*pv-comm)/(risk*pv),
                        pnl=pts*pv-comm,peakR=peak,why=why,risk=risk,bars=j-i))
        cnt[k]=cnt.get(k,0)+1; i=j+1
    return pd.DataFrame(out)

