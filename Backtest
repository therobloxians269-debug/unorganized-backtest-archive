    mod=(df.index.hour*60+df.index.minute).values
    idx=df.index; n=len(df); iv=idx.values
    K=blocks['known'].values; B=blocks['bot'].values; T=blocks['top'].values; D=blocks['dir'].values
    out=[]; busy=-1
    for k in range(len(blocks)):
        s=np.searchsorted(iv, K[k])
        if s>=n-2 or s<=busy: continue
        d=int(D[k]); bot,top=B[k],T[k]
        if not np.isfinite(bot) or top<=bot: continue
        # ---- confluence: block must sit near a VP / VWAP reference
        lv=[poc[s],val[s],vah[s],vw[s],vw[s]+vsd[s],vw[s]-vsd[s],vw[s]+2*vsd[s],vw[s]-2*vsd[s]]
        lv=[x for x in lv if np.isfinite(x)]
        if conf!='none':
            if not lv: continue
            near=min(abs(np.array(lv)-(bot+top)/2))
            if near>conf_tol: continue
        # ---- limit entry into the block
        ep = bot if d==-1 else top
        st = (top+buf) if d==-1 else (bot-buf)
        risk=abs(st-ep)
        if risk>max_stop or risk<min_stop: continue
        j0=None
        for q in range(s+1, min(s+1+valid_bars, n)):
            if mod[q]>=flat_min: break
            if (h[q]>=ep) if d==-1 else (l[q]<=ep): j0=q; break
        if j0 is None: continue
        # ---- target: nearest VP/VWAP level in the profit direction
        cand=[x for x in lv if (x<ep-risk*0.5 if d==-1 else x>ep+risk*0.5)]
        if not cand: continue
        tgt = max(cand) if d==-1 else min(cand)
        rr=abs(tgt-ep)/risk
        if rr<min_rr: continue
        px=None
        for j in range(j0+1, min(j0+1+max_hold, n)):
            if mod[j]>=flat_min: px=o[j]+(slip if d==-1 else -slip); why='flat'; break
            if (h[j]>=st) if d==-1 else (l[j]<=st): px=st+(slip if d==-1 else -slip); why='stop'; break
            if (l[j]<=tgt) if d==-1 else (h[j]>=tgt): px=tgt; why='tgt'; break
        if px is None:
            j=min(j0+max_hold,n-1); px=o[j]+(slip if d==-1 else -slip); why='time'
        pts=(ep-px) if d==-1 else (px-ep); net=pts*pv-comm
        out.append(dict(t=idx[j0],d=d,R=net/(risk*pv),pnl=net,risk=risk,rr=rr,why=why,bars=j-j0))
        if one_per_block: busy=j
    return pd.DataFrame(out)

