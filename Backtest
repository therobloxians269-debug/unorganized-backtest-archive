"""4H PD array -> NY session tap -> 15m rejection wick -> limit at the 50% (CE) -> 1:6.
Tested exactly as specified. Causal: the 15m candle must CLOSE before the limit is live."""
import numpy as np, pandas as pd, warnings; warnings.filterwarnings('ignore')
TICK=0.25
def rs(df, rule):
    o=df.o.resample(rule,label='left',closed='left').first()
    h=df.h.resample(rule,label='left',closed='left').max()
    l=df.l.resample(rule,label='left',closed='left').min()
    c=df.c.resample(rule,label='left',closed='left').last()
    return pd.DataFrame({'o':o,'h':h,'l':l,'c':c}).dropna()

def pd_arrays(h4, kind='rb', left=2, right=2):
    """PD arrays off 4H structure. rb = rejection block (the wick zone of a swing candle).
       ob = order block (last opposite-close candle before a displacement leg)."""
    H,L,O,C=h4.h.values,h4.l.values,h4.o.values,h4.c.values; idx=h4.index; n=len(h4)
    out=[]
    for i in range(left, n-right):
        isHi=H[i]==H[i-left:i+right+1].max(); isLo=L[i]==L[i-left:i+right+1].min()
        conf=idx[i+right]                       # level only KNOWN after right bars confirm
        if kind=='rb':
            if isHi: out.append(dict(t=conf,dir=-1,top=H[i],bot=max(O[i],C[i])))
            if isLo: out.append(dict(t=conf,dir= 1,top=min(O[i],C[i]),bot=L[i]))
        else:
            if isHi and C[i]>O[i]: out.append(dict(t=conf,dir=-1,top=H[i],bot=min(O[i],C[i])))
            if isLo and C[i]<O[i]: out.append(dict(t=conf,dir= 1,top=max(O[i],C[i]),bot=L[i]))
    d=pd.DataFrame(out)
    return d[ (d.top-d.bot).abs()>0 ] if len(d) else d

def run(df, kind='rb', rr=6.0, wickmin=0.5, ce=0.5, pv=2.0, comm=1.50,
        buf=2.0, ny=(570,960), maxwait=120, maxhold=390):
    h4=rs(df,'4h'); m15=rs(df,'15min')
    A=pd_arrays(h4,kind)
    if len(A)==0: return pd.DataFrame()
    o1,h1,l1,c1=df.o.values,df.h.values,df.l.values,df.c.values
    ts=df.index; mm=(ts.hour*60+ts.minute).values
    m15m=(m15.index.hour*60+m15.index.minute)
    used=set(); out=[]
    for _,z in A.iterrows():
        # 15m candles inside the NY session, AFTER the 4H level is confirmed
        w=m15[(m15.index>z.t)&(m15m>=ny[0])&(m15m<ny[1])]
        w=w.iloc[:maxwait] if len(w) else w
        for tt,b in w.iterrows():
            if (z.dir==1 and b.l<=z.top) or (z.dir==-1 and b.h>=z.bot):
                rng=b.h-b.l
                if rng<=0: break
                if z.dir==1:
                    wick=min(b.o,b.c)-b.l
                    if wick< wickmin*rng or b.c<=z.top: break      # must close back OUT of the level
                    ext,body=b.l,min(b.o,b.c)
                else:
                    wick=b.h-max(b.o,b.c)
                    if wick< wickmin*rng or b.c>=z.bot: break
                    ext,body=b.h,max(b.o,b.c)
                lim=ext+ce*(body-ext)                              # the 50% of the rejection block
                stp=ext-z.dir*buf
                risk=abs(lim-stp)
                if risk<TICK: break
                tgt=lim+z.dir*rr*risk
                # the limit goes live only AFTER this 15m candle closes
                st=ts.searchsorted(tt+pd.Timedelta('15min'))
                if st>=len(ts): break
                key=(z.dir,round(lim,2))
                if key in used: break
                used.add(key)
                fill=-1
                for k in range(st,min(st+maxhold,len(ts))):
                    if mm[k]>=959: break
                    if (l1[k]<=lim) if z.dir==1 else (h1[k]>=lim): fill=k; break
                if fill<0: out.append(dict(t=tt,dir=z.dir,filled=0,R=np.nan,pnl=0.0,why='nofill')); break
                R=np.nan
                for k in range(fill+1,min(fill+maxhold,len(ts))):
                    last=mm[k]>=959 or k==len(ts)-1
                    hs=(l1[k]<=stp) if z.dir==1 else (h1[k]>=stp)
                    ht=(h1[k]>=tgt) if z.dir==1 else (l1[k]<=tgt)
                    if hs: px=stp-z.dir*TICK; why='stop'
                    elif ht: px=tgt; why='tgt'
                    elif last: px=c1[k]; why='time'
                    else: continue
                    pnl=z.dir*(px-lim)*pv-comm
                    out.append(dict(t=tt,dir=z.dir,filled=1,R=pnl/(risk*pv),pnl=pnl,why=why,risk=risk))
                    break
                break
    return pd.DataFrame(out)

if __name__=='__main__':
    for f,tag in [('nq_v6.parquet','NQ 2023-25'),('mnq_v6.parquet','MNQ 2026')]:
        df=pd.read_parquet(f)
        D=pd.DatetimeIndex(df.index).normalize().nunique()
        for kind in ['rb','ob']:
            T=run(df,kind=kind)
            if len(T)==0: print(f'{tag} {kind}: none'); continue
            F=T[T.filled==1]
