#!/usr/bin/env python3
"""Dual-mode Opening-Range Breakout on real 5-min ES (front-month RTH, 2010-2026).
SELF-ADAPT: OR breakout = trend bet; if it fails (closes back into the range) ->
flip to mean-reversion back across the OR. Trend days the break runs; range days
the failed break becomes the reversion. Compared to pure-breakout, pure-fade, and
a regime-routed (OR-width) variant. Realistic Tradovate friction (limit=0 slip)."""
import math
import numpy as np, pandas as pd

COMM = 0.16; SLIP = 0.25; DPP = 5.0
ORN = 6            # opening range = first 6 five-min bars (09:30-10:00)
ATR_TRAIL = 2.0    # chandelier multiple for the trend leg
FLOOR = 5.0        # min stop distance (pts) - prevents degenerate tiny-risk trades

def load_5m():
    df = pd.read_parquet("/Users/kaveh/mim_research/es_front_rth_1m.parquet")
    df["date"] = pd.to_datetime(df["date"]).dt.date
    hm = df["hm"].str.split(":", expand=True)
    df["mos"] = (hm[0].astype(int)*60 + hm[1].astype(int)) - (9*60+30)
    df = df[(df["mos"] >= 0) & (df["mos"] < 390)].copy()
    df["b5"] = df["mos"] // 5
    g = df.groupby(["date", "b5"])
    b = pd.DataFrame({"open": g["open"].first(), "high": g["high"].max(), "low": g["low"].min(),
                      "close": g["close"].last(), "vol": g["volume"].sum()}).reset_index()
    b = b.sort_values(["date", "b5"]).reset_index(drop=True)
    pc = b["close"].shift(1)
    tr = np.maximum(b["high"]-b["low"], np.maximum((b["high"]-pc).abs(), (b["low"]-pc).abs()))
    b["atr"] = tr.ewm(alpha=1/14, adjust=False).mean()          # Wilder ATR, continuous
    sessions = []
    prev_hi = prev_lo = None
    orw_hist = []
    for d, gg in b.groupby("date", sort=True):
        gg = gg.sort_values("b5")
        if len(gg) != 78:
            if len(gg):
                prev_hi = float(gg["high"].max()); prev_lo = float(gg["low"].min())
            continue
        o = gg["open"].to_numpy(); h = gg["high"].to_numpy(); l = gg["low"].to_numpy()
        c = gg["close"].to_numpy(); v = gg["vol"].to_numpy(); atr = gg["atr"].to_numpy()
        tp = (h+l+c)/3; vwap = np.cumsum(tp*v)/np.maximum(np.cumsum(v), 1)
        orw = float(h[:ORN].max() - l[:ORN].min())
        orw_med = float(np.median(orw_hist[-20:])) if len(orw_hist) >= 20 else np.nan  # causal
        sessions.append(dict(date=d, o=o, h=h, l=l, c=c, v=v, atr=atr, vwap=vwap,
                             prev_hi=prev_hi, prev_lo=prev_lo, orw=orw, orw_med=orw_med))
        orw_hist.append(orw)
        prev_hi = float(h.max()); prev_lo = float(l.min())
    return sessions

def fric(entry_market, exit_kind):
    f = COMM
    f += SLIP if entry_market else 0.0
    f += 0.0 if exit_kind == "target" else SLIP
    return f

# ---------------- self-adapting dual-mode ----------------
def dual_selfadapt(sessions):
    out = []
    for s in sessions:
        h, l, c, atr, vwap = s["h"], s["l"], s["c"], s["atr"], s["vwap"]
        ORh = float(h[:ORN].max()); ORl = float(l[:ORN].min())
        pos = 0; entry = stop = np.nan; ebar = -1; maxfav = 0.0; reversed_ = False
        brk_ext = np.nan; risk0 = np.nan
        for b in range(ORN, 78):
            if pos == 0 and not reversed_:
                if c[b] > ORh:
                    pos = 1; entry = c[b]; stop = min(ORl, entry-FLOOR); ebar = b; maxfav = 0.0; brk_ext = h[b]; risk0 = entry-stop
                elif c[b] < ORl:
                    pos = -1; entry = c[b]; stop = max(ORh, entry+FLOOR); ebar = b; maxfav = 0.0; brk_ext = l[b]; risk0 = stop-entry
                continue
            if pos != 0 and b > ebar:
                brk_ext = max(brk_ext, h[b]) if pos > 0 else min(brk_ext, l[b])
                # (1) hard stop (opposite OR edge / trailed) intrabar
                if (l[b] <= stop) if pos > 0 else (h[b] >= stop):
                    g = pos*(stop-entry); out.append((s["date"], g, g-fric(True, "stop"), risk0, "trend_stop"))
                    pos = 0; continue
                # (2) failed break -> flip to mean-reversion (only the trend leg can flip)
                reenter = (c[b] < ORh) if pos > 0 else (c[b] > ORl)
                if reenter and not reversed_:
                    g = pos*(c[b]-entry); out.append((s["date"], g, g-fric(True, "market"), risk0, "trend_fail"))
                    rdir = -pos; rentry = c[b]
                    rstop = brk_ext + (SLIP if rdir < 0 else -SLIP)   # beyond the failed-break extreme
                    if abs(rentry-rstop) < FLOOR:
                        rstop = rentry - rdir*FLOOR
                    rrisk0 = abs(rentry-rstop)
                    rtgt = ORl if rdir < 0 else ORh                   # target far side of range
                    pos = 0; reversed_ = True
                    rex = None
                    for j in range(b+1, 78):
                        if (l[j] <= rstop) if rdir > 0 else (h[j] >= rstop):
                            gg = rdir*(rstop-rentry); rex = (gg, "stop"); break
                        if (h[j] >= rtgt) if rdir > 0 else (l[j] <= rtgt):
                            gg = rdir*(rtgt-rentry); rex = (gg, "target"); break
                        if j == 77:
                            gg = rdir*(c[j]-rentry); rex = (gg, "eod"); break
                    if rex is None:
                        gg = rdir*(c[77]-rentry); rex = (gg, "eod")
                    out.append((s["date"], rex[0], rex[0]-fric(True, rex[1]), rrisk0, "rev_"+rex[1]))
                    break
                # (3) ATR chandelier trail on the trend leg (ride the trend)
                fav = (h[b]-entry) if pos > 0 else (entry-l[b])
                maxfav = max(maxfav, fav)
                trail = (entry+maxfav) - ATR_TRAIL*atr[b] if pos > 0 else (entry-maxfav) + ATR_TRAIL*atr[b]
                stop = max(stop, trail) if pos > 0 else min(stop, trail)
                # (4) EOD
                if b == 77:
                    g = pos*(c[b]-entry); out.append((s["date"], g, g-fric(True, "eod"), risk0, "trend_eod"))
                    pos = 0
    return pd.DataFrame(out, columns=["date", "gross", "net", "risk", "kind"])

# ---------------- baselines / regime-routed ----------------
def single_mode(sessions, mode, regime=None):
    """mode: 'break' (go with) or 'fade' (fade back to VWAP). regime: None, 'wide', 'narrow'."""
    out = []
    for s in sessions:
        h, l, c, vwap, atr = s["h"], s["l"], s["c"], s["vwap"], s["atr"]
        ORh = float(h[:ORN].max()); ORl = float(l[:ORN].min())
        if regime is not None and not np.isnan(s["orw_med"]):
            wide = s["orw"] >= s["orw_med"]
            if regime == "wide" and not wide: continue
            if regime == "narrow" and wide: continue
        pos = 0; entry = stop = tgt = risk0 = np.nan; ebar = -1; done = False
        for b in range(ORN, 78):
            if pos == 0 and not done:
                brk = 1 if c[b] > ORh else -1 if c[b] < ORl else 0
                if brk != 0:
                    d = brk if mode == "break" else -brk
                    entry = c[b]; ebar = b; pos = d
                    if mode == "break":
                        stop = ORl if d > 0 else ORh; tgt = None            # ride to EOD/stop
                    else:  # fade back toward VWAP
                        stop = (h[b] if d < 0 else l[b]); tgt = vwap[b]
                    if abs(entry-stop) < FLOOR:                              # stop floor
                        stop = entry - d*FLOOR
                    risk0 = abs(entry-stop)
                continue
            if pos != 0 and b > ebar:
                if (l[b] <= stop) if pos > 0 else (h[b] >= stop):
                    g = pos*(stop-entry); out.append((s["date"], g, g-fric(True, "stop"), risk0, mode+"_stop")); pos = 0; done = True; continue
                if tgt is not None and ((h[b] >= tgt) if pos > 0 else (l[b] <= tgt)):
                    g = pos*(tgt-entry); out.append((s["date"], g, g-fric(True, "target"), risk0, mode+"_tp")); pos = 0; done = True; continue
                if b == 77:
                    g = pos*(c[b]-entry); out.append((s["date"], g, g-fric(True, "eod"), risk0, mode+"_eod")); pos = 0; done = True
    return pd.DataFrame(out, columns=["date", "gross", "net", "risk", "kind"])

def rep(tr, name):
    if len(tr) < 20:
        print(f"{name:34s} n={len(tr):4d} (too few)"); return
    tr = tr.copy(); tr["yr"] = pd.to_datetime(tr["date"]).dt.year
    tr["R"] = tr["net"]/tr["risk"].clip(lower=1e-9)
    def one(d):
        if len(d) < 5: return "—"
        net = d["net"].to_numpy(); eq = np.cumsum(net)*DPP; dd = (eq-np.maximum.accumulate(eq)).min()
        return (f"n={len(d):4d} grossR={ (d['gross']/d['risk'].clip(lower=1e-9)).mean():+.3f} "
                f"netR={d['R'].mean():+.3f} hit={(net>0).mean():.2f} ${net.sum()*DPP:>7.0f} maxDD=${dd:>7.0f}")
    print(f"{name}")
    print(f"    ALL      {one(tr)}")
    print(f"    pre-2020 {one(tr[tr.yr<2020])}")
    print(f"    2022+    {one(tr[tr.yr>=2022])}")

def main():
    S = load_5m()
    print(f"loaded {len(S)} clean 78-bar sessions {S[0]['date']}..{S[-1]['date']}. "
          f"friction: {COMM}+{SLIP}/market fill (limit target=0). OR={ORN*5}min\n")
    print("===== SELF-ADAPTING DUAL-MODE (breakout -> failed-break reversion) =====")
    d = dual_selfadapt(S)
    rep(d, "DUAL self-adapt (all legs)")
    rep(d[d["kind"].str.startswith("trend")], "  trend legs only")
    rep(d[d["kind"].str.startswith("rev")], "  reversion legs only")
    print("\n===== BASELINES =====")
    rep(single_mode(S, "break"), "pure BREAKOUT (ride EOD)")
    rep(single_mode(S, "fade"),  "pure FADE (to VWAP)")
    print("\n===== REGIME-ROUTED (OR width vs 20d median) =====")
    rep(single_mode(S, "break", regime="wide"),   "wide-OR days -> BREAKOUT")
    rep(single_mode(S, "fade",  regime="narrow"), "narrow-OR days -> FADE")

if __name__ == "__main__":
    main()

