#!/usr/bin/env python3
"""OF-1 SCREENING adapter for TradingView chart CSV exports.

SCREENING ONLY — NEVER A VERDICT. TradingView delta (requestUpAndDownVolume)
is tick-rule approximated, not CME aggressor-classified; PREREG_OF1.md bans
it for gates. Use this to eyeball whether a family is worth the Databento
spend, nothing more. No gate line is printed on purpose.

Covers the 24 bar-level cells (F1, F2, F3, F5, F8). Footprint/tape families
(F4, F6, F7) cannot be reconstructed from chart exports and are skipped.

Input: one or more 5m chart CSVs from "Export chart data..." with the
companion study OF1_EXPORT.pine on the chart (adds volume + delta columns).
Optionally one or more 1m CSVs of the same range for honest stop/target
adjudication; without them, each 5m bar's OHLC fills its five 1m slots,
which resolves same-bar stop-vs-target maximally conservatively (stop first).

  python3 tv_screen.py --csv5 mes5m_a.csv mes5m_b.csv [--csv1 mes1m_a.csv ...]
"""
import argparse
import datetime as dt
import sys
from zoneinfo import ZoneInfo

import numpy as np
import pandas as pd

import flowlab as fl

ET = ZoneInfo("America/New_York")


def _find(cols, want, avoid=()):
    for c in cols:
        lc = c.lower()
        if want in lc and not any(a in lc for a in avoid):
            return c
    return None


def read_tv(paths, need_flow):
    frames = []
    for p in paths:
        df = pd.read_csv(p)
        tc = _find(df.columns, "time")
        cols = {"open": _find(df.columns, "open"),
                "high": _find(df.columns, "high"),
                "low": _find(df.columns, "low"),
                "close": _find(df.columns, "close")}
        if need_flow:
            cols["vol"] = _find(df.columns, "vol", avoid=("delta",))
            cols["delta"] = _find(df.columns, "delta")
        missing = [k for k, v in {**cols, "time": tc}.items() if v is None]
        if missing:
            sys.exit(f"{p}: could not find column(s) {missing}. "
                     f"Have: {list(df.columns)}. Is OF1_EXPORT.pine on the "
                     f"chart (for volume/delta)?")
        if pd.api.types.is_numeric_dtype(df[tc]):
            t = pd.to_datetime(df[tc], utc=True, unit="s").dt.tz_convert(ET)
        else:
            t = (pd.to_datetime(df[tc], utc=True, format="mixed")
                 .dt.tz_convert(ET))
        out = pd.DataFrame({k: pd.to_numeric(df[v], errors="coerce")
                            for k, v in cols.items()})
        out["date"] = t.dt.date
        out["sec"] = (t.dt.hour * 3600 + t.dt.minute * 60 + t.dt.second
                      - (9 * 3600 + 30 * 60)).astype(np.int64)
        frames.append(out)
    df = pd.concat(frames, ignore_index=True)
    df = df[(df["sec"] >= 0) & (df["sec"] < fl.RTH_SECS)]
    df = df.drop_duplicates(subset=["date", "sec"]).sort_values(["date", "sec"])
    return df


def _to_grid(df, bar_sec, sess_id):
    """Map TV bars onto flowlab's fixed per-session grid with flat-fill."""
    per = fl.RTH_SECS // bar_sec
    df = df[df["date"].isin(sess_id)].copy()
    df["sess"] = df["date"].map(sess_id)
    df["b"] = (df["sec"] // bar_sec).clip(0, per - 1)
    full = []
    for s, ch in df.groupby("sess", sort=True):
        ch = ch.set_index("b").reindex(range(per))
        ch["sess"] = s
        ch["close"] = ch["close"].ffill().bfill()
        for c in ("open", "high", "low"):
            ch[c] = ch[c].fillna(ch["close"])
        for c in ("vol", "delta"):
            if c in ch.columns:
                ch[c] = ch[c].fillna(0)
        full.append(ch.reset_index().rename(columns={"index": "b"}))
    out = pd.concat(full, ignore_index=True)
    out["g"] = out["sess"] * per + out["b"]
    return out.sort_values("g").reset_index(drop=True)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--csv5", nargs="+", required=True)
    ap.add_argument("--csv1", nargs="*", default=[])
    a = ap.parse_args()

    d5 = read_tv(a.csv5, need_flow=True)
    # session hygiene mirrors run_real: full RTH coverage required
    g = d5.groupby("date")["sec"]
    per5 = fl.B5_PER_SESS
    ok = (g.size() >= int(0.9 * per5)) & (g.max() >= fl.RTH_SECS - 600)
    dates = sorted(d for d, v in ok.items() if v)
    if len(dates) < 15:
        sys.exit(f"Only {len(dates)} clean sessions in the 5m export; "
                 "need >= 15 for a meaningful screen.")
    sess_id = {d: i for i, d in enumerate(dates)}
    b5 = fl.add_features(_to_grid(d5, 300, sess_id))

    if a.csv1:
        b1 = _to_grid(read_tv(a.csv1, need_flow=False), 60, sess_id)
    else:
        print("[no 1m CSVs: adjudicating on 5m bars replicated to 1m slots "
              "-- same-bar stop-vs-target resolves stop-first]")
        rep = b5.loc[b5.index.repeat(5)].reset_index(drop=True)
        rep["b"] = rep.groupby(["sess"]).cumcount()
        b1 = rep[["sess", "b", "open", "high", "low", "close"]]
    mats = fl._b1_matrix(b1)

    cells = {}
    for N in (20, 60):
        for th in (1.5, 2.5):
            for tag, tp, mb in fl._exit_variants():
                cells[f"F1_N{N}_z{th}_{tag}"] = fl.fam_F1(b5, N, th, tp, mb)
    for th in (0.5, 1.5):
        for tag, tp, mb in fl._exit_variants():
            cells[f"F2_div{th}_{tag}"] = fl.fam_F2(b5, th, tp, mb)
    for q in (0.10, 0.20):
        for tag, tp, mb in fl._exit_variants():
            cells[f"F3_q{q}_{tag}"] = fl.fam_F3(b5, q, tp, mb)
    for th in (0.0, 1.0):
        for tag, tp, mb in fl._exit_variants():
            cells[f"F5_s{th}_{tag}"] = fl.fam_F5(b5, th, tp, mb)
    for th in (1.0, 2.0):
        for tag, tp in (("2R", 2 * fl.STOP_PTS), ("t75", None)):
            cells[f"F8_z{th}_{tag}"] = fl.fam_F8(b5, th, tp)

    sessions = list(range(len(dates)))
    tab = fl.evaluate_cells(cells, mats, sessions, n_trials=10**9,  # DSR moot
                            mcpt_perms=0, mcpt_t_gate=np.inf)       # no MCPT
    tab = tab.drop(columns=["dsr", "mcpt_p"])
    print(f"\n=== TV SCREEN — {len(dates)} sessions "
          f"{dates[0]}..{dates[-1]} — APPROXIMATED DELTA, NOT A VERDICT ===")
    print(tab.sort_values("hac_t", ascending=False).to_string(index=False))
    print("\nScreening rule of thumb: a family is Databento-worthy if its "
          "best cell shows hac_t >= 2 here. Gates run only in run_real.py.")


if __name__ == "__main__":
    main()

