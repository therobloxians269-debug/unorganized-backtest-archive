"""
THE CHROME LANGUAGE — pure candle geometry. No indicators.

WHY THIS FILE EXISTS
    Everything previously built was indicator-derived (VWAP, ADR, volume z). That is
    not price action — you cannot point at it on a chart. ICT's vocabulary works as a
    language because every primitive is a RELATIONSHIP BETWEEN BARS you identify by
    eye: a gap between two wicks, a wick beyond a prior high that closes back, a bar
    that swallows the one before it.

    Every condition below is pure geometry: bar shapes and the relationships between
    consecutive bars. Nothing here needs a single indicator to spot. ADR appears only
    for STOP SIZING, never inside a signal condition.

READ THE NAMES AS THE LANGUAGE
    Each one is a thing you can see:
      SWEEP    wick pokes beyond the prior N-bar extreme, body closes back inside
      RECLAIM  close back through a level the prior bar closed the other side of
      SWALLOW  this bar's range fully contains the prior bar's range
      COIL     this bar sits entirely inside the prior bar's range
      SHELF    two bars print near-identical extremes (a flat edge)
      VOID     a true gap: bar i-2's extreme never overlaps bar i's range
      SPRING   a down-close bar whose lower wick is most of its range
      DRIVE    body is nearly the whole range — no hesitation
      STALL    body is a sliver of the range — all wick, no progress
      LADDER   three consecutive closes in the same direction
      CHOKE    three consecutive contracting ranges
      FLARE    range expands beyond the prior N bars' largest
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')

RTH0, RTH1 = 570, 960


def bars(day, rb, tf=5):
    """Aggregate to `tf`-minute bars, keeping the 1m path index for execution."""
    out = []
    for dd, row in day.iterrows():
        b = rb.get(dd)
        if b is None:
            continue
        A = float(row.ADR)
        H1, L1, C1, O1, V1, T1 = b['H'], b['L'], b['C'], b['O'], b['V'], b['T']
        if not (A > 0) or len(C1) < 300:
            continue
        n = (len(C1) // tf) * tf
        ix = np.arange(n).reshape(-1, tf)
        df = pd.DataFrame(dict(
            day=dd, ADR=A, end=ix[:, -1], t=T1[ix[:, -1]],
            o=O1[ix[:, 0]], h=H1[ix].max(1), l=L1[ix].min(1), c=C1[ix[:, -1]],
            v=V1[ix].sum(1)))
        out.append(df)
    d = pd.concat(out, ignore_index=True)
    return d


def geometry(d):
    """
    The language. Every column is a boolean you could mark on a printed chart.
    All strictly backward-looking: bar i uses bars i, i-1, i-2, i-3 and prior extremes.
    """
    g = d.copy()
    rng = (g.h - g.l).replace(0, np.nan)
    body = (g.c - g.o)
    up = body > 0
    top = np.maximum(g.o, g.c)
    bot = np.minimum(g.o, g.c)
    uw = (g.h - top) / rng          # upper wick as a fraction of range
    lw = (bot - g.l) / rng          # lower wick
    bf = body.abs() / rng           # body fraction

    p = lambda s, k=1: s.groupby(g.day).shift(k)
    ph, pl, pc, po = p(g.h), p(g.l), p(g.c), p(g.o)
    ph2, pl2 = p(g.h, 2), p(g.l, 2)
    prng = (ph - pl)

    # running N-bar extremes, excluding the current bar
    def roll_max(s, w): return s.groupby(g.day).transform(lambda x: x.shift(1).rolling(w, min_periods=w).max())
    def roll_min(s, w): return s.groupby(g.day).transform(lambda x: x.shift(1).rolling(w, min_periods=w).min())
    h5, l5 = roll_max(g.h, 5), roll_min(g.l, 5)
    h10, l10 = roll_max(g.h, 10), roll_min(g.l, 10)

    q = {}
    # --- single-bar shape ---
    q['DRIVE_UP']   = up & (bf >= 0.70)
    q['DRIVE_DN']   = (~up) & (bf >= 0.70)
    q['STALL']      = bf <= 0.25
    q['SPRING']     = (lw >= 0.55)                       # long lower wick
    q['SHOOT']      = (uw >= 0.55)                       # long upper wick
    q['FLAT_TOP']   = uw <= 0.05                         # closed on its high
    q['FLAT_BOT']   = lw <= 0.05                         # closed on its low

    # --- two-bar relationships ---
    q['SWALLOW_UP'] = (g.h >= ph) & (g.l <= pl) & up     # outside bar, up close
    q['SWALLOW_DN'] = (g.h >= ph) & (g.l <= pl) & (~up)
    q['COIL']       = (g.h <= ph) & (g.l >= pl)          # inside bar
    q['SHELF_TOP']  = (g.h - ph).abs() <= 0.10 * prng    # matching highs
    q['SHELF_BOT']  = (g.l - pl).abs() <= 0.10 * prng
    q['THRUST_UP']  = g.c > ph                           # close beyond prior bar's high
    q['THRUST_DN']  = g.c < pl
    q['FAIL_UP']    = (g.h > ph) & (g.c < pc)            # took the high, closed weaker
    q['FAIL_DN']    = (g.l < pl) & (g.c > pc)
    q['RECLAIM_UP'] = (pc < pl.groupby(g.day).shift(0)) & (g.c > ph)   # snap back through
    q['GAP_BODY_UP'] = bot > p(top)                      # body gap up
    q['GAP_BODY_DN'] = top < p(bot)

    # --- three-bar relationships (the VOID family: a true unfilled gap) ---
    q['VOID_UP']    = g.l > ph2                          # bar i low above bar i-2 high
    q['VOID_DN']    = g.h < pl2
    q['PIVOT_HI']   = (ph > g.h) & (ph > ph2)            # prior bar is a local high
    q['PIVOT_LO']   = (pl < g.l) & (pl < pl2)

    # --- sweeps: wick beyond an N-bar extreme, body closes back inside ---
    q['SWEEP_HI5']  = (g.h > h5) & (g.c < h5)
    q['SWEEP_LO5']  = (g.l < l5) & (g.c > l5)
    q['SWEEP_HI10'] = (g.h > h10) & (g.c < h10)
    q['SWEEP_LO10'] = (g.l < l10) & (g.c > l10)
    q['BREAK_HI10'] = (g.h > h10) & (g.c > h10)          # took it AND held
    q['BREAK_LO10'] = (g.l < l10) & (g.c < l10)

    # --- sequences ---
    d_up = (g.c > p(g.c)).astype(float)
    q['LADDER_UP'] = (d_up.groupby(g.day).rolling(3, min_periods=3).sum().reset_index(level=0, drop=True) == 3)
    q['LADDER_DN'] = (d_up.groupby(g.day).rolling(3, min_periods=3).sum().reset_index(level=0, drop=True) == 0)
    r1, r2 = p(rng, 1), p(rng, 2)
    q['CHOKE']  = (rng < r1) & (r1 < r2)                 # three contracting ranges
    q['FLARE']  = rng > roll_max(rng.rename('rng'), 5)   # biggest range in 6 bars

    for k, v in q.items():
        g[k] = v.fillna(False).astype(bool)
    g['_names'] = None
    return g, list(q)


def forward(g, rb, horizons=(6, 12, 24)):
    """Forward returns from each bar's close, in ADR units, plus the path for exits."""
    out = {f'f{h}': np.full(len(g), np.nan) for h in horizons}
    out['fcl'] = np.full(len(g), np.nan)
    idx = 0
    for dd, sub in g.groupby('day', sort=False):
        b = rb.get(dd)
        if b is None:
            idx += len(sub); continue
        C1 = b['C']; A = float(sub.ADR.iloc[0])
        ends = sub.end.values.astype(int); px = sub.c.values
        for k, e in enumerate(ends):
            for h in horizons:
                kk = min(e + h * 5, len(C1) - 1)
                out[f'f{h}'][idx + k] = (float(C1[kk]) - px[k]) / A
            out['fcl'][idx + k] = (float(C1[-1]) - px[k]) / A
        idx += len(sub)
    for k, v in out.items():
        g[k] = v
    return g

