#!/usr/bin/env python3
"""
mim_validate.py — independent reference + falsification harness for the MES
Market Intraday Momentum (MIM) strategy implemented in MES_MIM.pine.

WHY THIS EXISTS
  A Pine backtest you cannot reproduce is a claim, not a result. This file
  reimplements the *exact* trade logic of MES_MIM.pine in Python so you can:
    (1) run it on YOUR Databento MES bars (1m or 30m) with YOUR splits, and
    (2) trust it, because it ships with a planted-vs-null self-test in the
        FlowLab tradition: on a tape with a genuine MIM effect it must fire
        (net>0, HAC-t>=2, MCPT small); on an identical null tape it must die.

  Synthetic results are NEVER a verdict. The verdict is what this prints on
  your real MES tape across IS / VAL / holdout, net of friction.

THE STRATEGY (Gao, Han, Li & Zhou 2018, faithful)
  r1  = P(10:00 ET) / P(prev-day 16:00 ET close) - 1     (first half-hour)
  r12 = P(15:30) / P(15:00) - 1                            (twelfth half-hour)
  At 15:30 take a position of sign(r1) [or, in 'agree' mode, only when
  sign(r1)==sign(r12)], hold to the 16:00 close. 1 MES, $5/pt.
  P&L per day (points) = dir*(P1600 - P1530) - friction_round_trip.

USAGE
  python3 mim_validate.py selftest
  python3 mim_validate.py run --data mes_30m.parquet \
        --mode first30 --friction 0.75 \
        --is 2019-05-01:2023-12-31 --val 2024-01-01:2025-06-30 \
        --holdout 2025-07-01:2026-06-30            # holdout optional; run last
  Data file: parquet/csv with columns [timestamp, open, high, low, close].
  timestamp may be epoch ns/s or ISO; tz-naive is assumed UTC.
"""
from __future__ import annotations
import argparse
import math
import sys
from zoneinfo import ZoneInfo

import numpy as np
import pandas as pd

ET = ZoneInfo("America/New_York")
POINT_VALUE = 5.0                 # MES $/pt
DEFAULT_FRICTION_PTS = 0.75       # round-trip; ~$1.24 commission + ~$2.50 (1 tick/side)


# ---------------------------------------------------------------- bar loading
def load_bars(path: str) -> pd.DataFrame:
    df = pd.read_parquet(path) if path.endswith((".parquet", ".pq")) else pd.read_csv(path)
    cols = {c.lower(): c for c in df.columns}
    def pick(*names):
        for n in names:
            if n in cols:
                return cols[n]
        sys.exit(f"data needs a {names[0]} column; have {list(df.columns)}")
    tcol = pick("timestamp", "ts", "ts_event", "time", "datetime", "date")
    ocol, ccol = pick("open", "o"), pick("close", "c")
    t = df[tcol]
    if np.issubdtype(t.dtype, np.number):
        unit = "s" if float(t.iloc[0]) < 1e12 else "ns"
        t = pd.to_datetime(t, unit=unit, utc=True)
    else:
        t = pd.to_datetime(t, utc=True, format="mixed")
    out = pd.DataFrame({"ts": t.dt.tz_convert(ET),
                        "open": pd.to_numeric(df[ocol]),
                        "close": pd.to_numeric(df[ccol])}).dropna()
    return out.sort_values("ts").reset_index(drop=True)


# ---------------------------------------------------- per-day price extraction
def _sec_of_day(ts: pd.Series) -> np.ndarray:
    return (ts.dt.hour * 3600 + ts.dt.minute * 60 + ts.dt.second).to_numpy()


def extract_daily(bars: pd.DataFrame) -> pd.DataFrame:
    """One row per RTH date with the five prices MIM needs, timeframe-agnostic.
    price_at(t) := close of the last RTH bar whose open-time is strictly < t."""
    b = bars.copy()
    b["date"] = b["ts"].dt.date
    sod = _sec_of_day(b["ts"])
    OPEN, TENAM = 9 * 3600 + 30 * 60, 10 * 3600
    T1500, T1530, T1600 = 15 * 3600, 15 * 3600 + 30 * 60, 16 * 3600
    b = b[(sod >= OPEN) & (sod < T1600 + 300)]          # RTH (+ tiny pad for 16:00 print)
    sod = _sec_of_day(b["ts"])
    b = b.assign(sod=sod)

    rows = []
    for d, g in b.groupby("date", sort=True):
        s = g["sod"].to_numpy()
        c = g["close"].to_numpy()
        if s.size < 5 or s.min() > OPEN + 1800 or s.max() < T1530:
            continue                                      # stub / early close -> skip
        def price_at(tsec):
            i = np.searchsorted(s, tsec, side="left") - 1  # last bar with open-time < tsec
            return float(c[i]) if i >= 0 else np.nan
        rows.append({"date": d,
                     "p1000": price_at(TENAM), "p1500": price_at(T1500),
                     "p1530": price_at(T1530), "p1600": price_at(T1600)})
    daily = pd.DataFrame(rows).sort_values("date").reset_index(drop=True)
    daily["prevClose"] = daily["p1600"].shift(1)
    daily["r1"] = daily["p1000"] / daily["prevClose"] - 1.0
    daily["r12"] = daily["p1530"] / daily["p1500"] - 1.0
    daily["last"] = daily["p1600"] - daily["p1530"]       # last-half-hour move in POINTS
    return daily.dropna(subset=["prevClose"]).reset_index(drop=True)


# ------------------------------------------------------------- strategy P&L
def strategy_pnl(daily: pd.DataFrame, mode: str = "first30",
                 friction: float = DEFAULT_FRICTION_PTS,
                 vol_gate: bool = False, vol_len: int = 40) -> pd.DataFrame:
    """Returns daily frame with columns dir (−1/0/+1) and pnl (points, net).
    Flat days have dir=0, pnl=0. Mirrors MES_MIM.pine exactly."""
    d = daily.copy()
    sign = lambda x: np.where(x > 0, 1, np.where(x < 0, -1, 0))
    dir_ = sign(d["r1"].to_numpy())
    if mode == "agree":
        d12 = sign(d["r12"].to_numpy())
        dir_ = np.where((dir_ != 0) & (dir_ == d12), dir_, 0)
    elif mode != "first30":
        sys.exit("mode must be 'first30' or 'agree'")
    if vol_gate:
        absr1 = d["r1"].abs().to_numpy()
        med = pd.Series(absr1).shift(1).rolling(vol_len, min_periods=vol_len).median().to_numpy()
        ok = np.isfinite(med) & (absr1 >= med)
        dir_ = np.where(ok, dir_, 0)
    d["dir"] = dir_.astype(int)
    traded = d["dir"] != 0
    d["pnl"] = np.where(traded, d["dir"] * d["last"].to_numpy() - friction, 0.0)
    return d


# ----------------------------------------------------------------- statistics
def hac_t(y: np.ndarray, lags: int = 5) -> float:
    y = np.asarray(y, float)
    n = y.size
    if n < 10 or np.allclose(y, 0):
        return 0.0
    e = y - y.mean()
    s = (e @ e) / n
    for l in range(1, min(lags, n - 1) + 1):
        s += 2 * (1 - l / (lags + 1)) * (e[l:] @ e[:-l]) / n
    se = math.sqrt(max(s, 1e-12) / n)
    return float(y.mean() / se)


def mcpt_signflip(d: pd.DataFrame, friction: float, n_perm: int = 2000,
                  seed: int = 99) -> float:
    """One-sided p: randomly flip each trade day's direction; p = P(sum >= obs)."""
    rng = np.random.default_rng(seed)
    tr = d[d["dir"] != 0]
    if len(tr) < 10:
        return float("nan")
    last = tr["last"].to_numpy()
    dirv = tr["dir"].to_numpy()
    obs = (dirv * last - friction).sum()
    ge = 0
    for _ in range(n_perm):
        flip = rng.choice([-1, 1], size=dirv.size)
        tot = (flip * dirv * last - friction).sum()
        if tot >= obs - 1e-9:
            ge += 1
    return (1 + ge) / (1 + n_perm)


def summarize(d: pd.DataFrame, label: str, friction: float,
              mcpt: bool = True) -> dict:
    trades = d[d["dir"] != 0]
    n = len(trades)
    y_all = d["pnl"].to_numpy()                     # per-day incl flat zeros
    net = float(trades["pnl"].sum())
    mean_pt = float(trades["pnl"].mean()) if n else 0.0
    gross_pt = float((trades["dir"] * trades["last"]).mean()) if n else 0.0
    hit = float((trades["pnl"] > 0).mean()) if n else 0.0
    sd = trades["pnl"].std(ddof=1) if n > 1 else np.nan
    sharpe = float(np.sqrt(252) * trades["pnl"].mean() / sd) if n > 1 and sd > 0 else 0.0
    t = hac_t(y_all)
    p = mcpt_signflip(d, friction) if (mcpt and n >= 10) else float("nan")
    n_days = len(d)
    ann = net / n_days * 252 if n_days else 0.0
    return {"label": label, "days": n_days, "trades": n, "gross_pt": gross_pt,
            "net_pt_per_trade": mean_pt, "net_pts": net, "ann_pts": ann,
            "ann_usd": ann * POINT_VALUE, "hit": hit, "sharpe": sharpe,
            "hac_t": t, "mcpt_p": p}


def print_summary(rows: list[dict]):
    df = pd.DataFrame(rows)
    show = df.copy()
    for c in ("gross_pt", "net_pt_per_trade", "net_pts", "ann_pts", "ann_usd",
              "hit", "sharpe", "hac_t"):
        show[c] = show[c].round(4)
    pd.set_option("display.width", 200)
    print(show.to_string(index=False))


# --------------------------------------------------------- synthetic self-test
def make_synthetic(n_days: int, beta_pts: float, seed: int,
                   start_price: float = 6000.0) -> pd.DataFrame:
    """1-min RTH bars, real ET timestamps. Plants a genuine MIM effect: the
    15:30->16:00 move gets a drift of sign(r1)*beta_pts. beta_pts=0 -> null."""
    rng = np.random.default_rng(seed)
    # DST-safe anchors: localize each session's 09:30 ET directly (no 24h drift).
    dates = pd.bdate_range("2022-01-03", periods=n_days)   # naive business days
    frames = []
    prev_close = start_price
    for dd in dates:
        gap = rng.normal(0, 0.0025) * prev_close           # overnight gap
        base = prev_close + gap
        steps = rng.normal(0, 0.10, 390)                   # ~0.1 pt/min vol
        price = base + np.cumsum(steps)
        p1000 = price[29]                                  # 10:00 close
        r1 = p1000 / prev_close - 1.0
        drift = np.sign(r1) * beta_pts
        ramp = np.zeros(390)
        ramp[360:390] = np.linspace(0, 1, 30) * drift      # inject into last half hour
        noise_lh = np.zeros(390)
        noise_lh[360:390] = rng.normal(0, 0.9, 30)         # last-half-hour noise
        price = price + ramp + noise_lh
        open_ = np.empty(390); open_[0] = base; open_[1:] = price[:-1]
        start = pd.Timestamp(f"{dd.date()} 09:30", tz=ET)  # correct per-day DST
        ts = pd.date_range(start, periods=390, freq="1min", tz=ET)
        frames.append(pd.DataFrame({"ts": ts, "open": open_, "close": price}))
        prev_close = price[389]
    return pd.concat(frames, ignore_index=True)


def selftest() -> int:
    fric = DEFAULT_FRICTION_PTS
    print(f"[self-test] friction = {fric} pts round-trip; 500 days each tape\n")
    rows = []
    planted = extract_daily(make_synthetic(500, beta_pts=2.0, seed=7))
    null = extract_daily(make_synthetic(500, beta_pts=0.0, seed=11))
    p_stats = summarize(strategy_pnl(planted, "first30", fric), "PLANTED first30", fric)
    n_stats = summarize(strategy_pnl(null, "first30", fric), "NULL first30", fric)
    rows += [p_stats, n_stats]
    print_summary(rows)

    # gate mirrors the real deployment gate: net>0 AND HAC-t>=2 AND MCPT<=0.05
    def passes(s):
        return (s["net_pts"] > 0) and (s["hac_t"] >= 2.0) and \
               (s["mcpt_p"] == s["mcpt_p"] and s["mcpt_p"] <= 0.05)
    p_ok = passes(p_stats)
    n_ok = passes(n_stats)
    ok = p_ok and (not n_ok)
    print(f"\nPlanted passes gate: {p_ok}  (want True)")
    print(f"Null    passes gate: {n_ok}  (want False)")
    print(f"\nSELF-TEST {'PASS' if ok else 'FAIL'}: "
          f"{'planted detected, null correctly killed' if ok else 'machinery broken'}")
    return 0 if ok else 1


# ----------------------------------------------------------------------- CLI
def _split(spec):
    a, b = spec.split(":")
    return pd.to_datetime(a).date(), pd.to_datetime(b).date()


def cmd_run(a):
    daily = extract_daily(load_bars(a.data))
    print(f"Loaded {len(daily)} clean RTH sessions "
          f"{daily['date'].min()}..{daily['date'].max()}  mode={a.mode} "
          f"vol_gate={a.vol_gate} friction={a.friction}pt\n")
    rows = []
    for name, spec in (("IS", a.is_), ("VAL", a.val), ("HOLDOUT", a.holdout)):
        if not spec:
            continue
        lo, hi = _split(spec)
        seg = daily[(daily["date"] >= lo) & (daily["date"] <= hi)]
        if seg.empty:
            print(f"[{name}] no sessions in {spec}"); continue
        d = strategy_pnl(seg, a.mode, a.friction, a.vol_gate, a.vol_len)
        rows.append(summarize(d, f"{name} {lo}..{hi}", a.friction))
    if not any((a.is_, a.val, a.holdout)):
        d = strategy_pnl(daily, a.mode, a.friction, a.vol_gate, a.vol_len)
        rows.append(summarize(d, "ALL", a.friction))
    print_summary(rows)
    print("\nDeployment gate: net_pts>0 AND hac_t>=2.0 AND mcpt_p<=0.05, on VAL, "
          "confirmed on a single-shot holdout. A backtest is a hypothesis.")


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("selftest")
    r = sub.add_parser("run")
    r.add_argument("--data", required=True)
    r.add_argument("--mode", default="first30", choices=["first30", "agree"])
    r.add_argument("--friction", type=float, default=DEFAULT_FRICTION_PTS)
    r.add_argument("--vol-gate", dest="vol_gate", action="store_true")
    r.add_argument("--vol-len", dest="vol_len", type=int, default=40)
    r.add_argument("--is", dest="is_", default=None)
    r.add_argument("--val", default=None)
    r.add_argument("--holdout", default=None)
    a = ap.parse_args()
    if a.cmd == "selftest":
        sys.exit(selftest())
    cmd_run(a)


if __name__ == "__main__":
    main()

