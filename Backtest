#!/usr/bin/env python3
"""OCEAN family f09_dow_calendar — calendar conditioning of a plain ORB base (MES 1-lot).

VERDICT: DEAD. No calendar bucket passes the survival bar, the 2010-2016 vs
2017-2022 half-split, or the +/-1-day definition-shift plateau demand.

Base engine (exact, causal):
  * OR = first 6 five-min bars (09:30-10:00): or_hi / or_lo from omni2_lib.
  * From bar 6 through bar 76, the FIRST bar whose CLOSE > or_hi -> LONG, or
    CLOSE < or_lo -> SHORT, entered at that bar's close (market, slippage in
    friction). One trade per day. No ER gate (family spec: plain base).
  * Optional stop: entry -/+ max(stop_mult*ATR(entry bar), FLOOR=5pt), house
    style (omni4_preserve.py). Checked intrabar only on bars strictly AFTER
    the entry bar. fric("stop") = 0.66 pt.
  * Otherwise ride to the 16:00 close: exit at bar-77 close, fric("eod")=0.66.
  * Sessions independent; no intraday state crosses days.

Calendar conditioning (computed from the exchange session calendar, known
ex-ante, on the FULL session list before window filtering):
  * dow        : weekday of the session (Mon..Fri)
  * mpos/mneg  : session rank from month start / month end (1-indexed)
  * gap        : calendar days since previous session (>=3 => post-weekend,
                 includes post-holiday)
Filters tested: single-DOW, month-start first-N, month-end last-N,
post-weekend. Config = (stop_mult, calendar filter). 16 configs total.

Windows: dev = dates <= 2022-12-31, holdout = 2023-01-01.., all = everything.
Defaults = PRE-REGISTERED config (best-of-family, still DEAD on dev):
  month-end last-3 sessions, stop_mult=2.0.
"""
import sys, json, argparse, math
sys.path.insert(0, "/Users/kaveh/mes_mim")
import numpy as np, pandas as pd
import omni2_lib as L
from omni2_lib import ORN, FLOOR, fric, DPP

# ---------------- PRE-REGISTERED CONFIG (defaults; family verdict = DEAD) ----------------
PRE = dict(stop=2.0, filt="mneg3")

# full sweep actually run during dev exploration (order preserved):
SWEEP = [
    # Stage A: base engine, no calendar filter (4)
    dict(stop=None, filt="all"), dict(stop=1.5, filt="all"),
    dict(stop=2.0, filt="all"),  dict(stop=2.5, filt="all"),
    # Stage B: calendar slices on stop=2.0 base (8)
    dict(stop=2.0, filt="dow0"), dict(stop=2.0, filt="dow1"),
    dict(stop=2.0, filt="dow2"), dict(stop=2.0, filt="dow3"),
    dict(stop=2.0, filt="dow4"),
    dict(stop=2.0, filt="mpos3"), dict(stop=2.0, filt="mneg3"),
    dict(stop=2.0, filt="postwknd"),
    # Stage C: month-end definition shifts + stop neighbors (4)
    dict(stop=2.0, filt="mneg2"), dict(stop=2.0, filt="mneg4"),
    dict(stop=1.5, filt="mneg3"), dict(stop=2.5, filt="mneg3"),
]

DOWNM = ["Mon", "Tue", "Wed", "Thu", "Fri"]


def build_cal(S_all):
    """Calendar features from the full session calendar (known ex-ante)."""
    by_month = {}
    for s in S_all:
        d = s["date"]
        by_month.setdefault((d.year, d.month), []).append(d)
    cal = {}
    for ym, ds in by_month.items():
        n = len(ds)
        for j, d in enumerate(ds):
            cal[d] = dict(mpos=j + 1, mneg=n - j)
    prev = None
    for s in S_all:
        d = s["date"]
        cal[d]["gap"] = (d - prev).days if prev else 99
        cal[d]["dow"] = d.weekday()
        prev = d
    return cal


def keep(date, filt, cal):
    f = cal[date]
    if filt == "all":
        return True
    if filt.startswith("dow"):
        return f["dow"] == int(filt[3])
    if filt.startswith("mpos"):
        return f["mpos"] <= int(filt[4:])
    if filt.startswith("mneg"):
        return f["mneg"] <= int(filt[4:])
    if filt == "postwknd":
        return f["gap"] >= 3
    raise ValueError(filt)


def sim_day(s, stop):
    """Plain ORB breakout, one trade/day, ride to close. Causal per docstring."""
    h, l, c, atr = s["h"], s["l"], s["c"], s["atr"]
    orh, orl = s["or_hi"], s["or_lo"]
    if not (orh > orl):
        return None
    pos = 0; entry = sl = np.nan; ebar = -1
    for b in range(ORN, 78):
        if pos != 0 and b > ebar:
            if stop is not None:
                hit = (l[b] <= sl) if pos > 0 else (h[b] >= sl)
                if hit:
                    return (s["date"], pos * (sl - entry) - fric("stop"), "stop")
            if b == 77:
                return (s["date"], pos * (c[77] - entry) - fric("eod"), "eod")
            continue
        if pos == 0 and b < 77:
            side = 1 if c[b] > orh else (-1 if c[b] < orl else 0)
            if side:
                pos = side; entry = c[b]; ebar = b
                if stop is not None:
                    sl = entry - side * max(stop * atr[b], FLOOR)
    return None


def run(S, stop, filt, cal):
    rows = []
    for s in S:
        if not keep(s["date"], filt, cal):
            continue
        r = sim_day(s, stop)
        if r is not None:
            rows.append(r)
    return pd.DataFrame(rows, columns=["date", "pts", "kind"])


def stats(tr):
    out = dict(net_usd=0.0, mar=0.0, trades=0, hit=0.0, maxdd_usd=0.0,
               yearly={}, top3_month_share=float("nan"), expectancy_pts=0.0,
               yrs_pos=0, n_yrs=0, max_yr_share=float("nan"),
               h1_usd=0.0, h2_usd=0.0)
    if len(tr) == 0:
        return out
    tr = tr.sort_values("date").reset_index(drop=True)
    usd = tr["pts"].to_numpy() * DPP
    net = float(usd.sum())
    eq = np.cumsum(usd)
    dd = float((eq - np.maximum.accumulate(eq)).min())
    dts = pd.to_datetime(tr["date"].astype(str))
    yr = dts.dt.year.to_numpy()
    ys = pd.Series(usd).groupby(yr).sum()
    ms = pd.Series(usd).groupby(dts.dt.strftime("%Y-%m").to_numpy()).sum()
    out.update(
        net_usd=round(net, 2),
        mar=round(net / abs(dd), 3) if dd < 0 else float("inf"),
        trades=int(len(tr)),
        hit=round(float((tr["pts"] > 0).mean()), 4),
        maxdd_usd=round(dd, 2),
        yearly={str(int(k)): round(float(v), 2) for k, v in ys.items()},
        top3_month_share=round(float(ms.nlargest(3).sum() / net), 3) if net > 0 else float("nan"),
        expectancy_pts=round(float(tr["pts"].mean()), 4),
        yrs_pos=int((ys > 0).sum()), n_yrs=int(len(ys)),
        max_yr_share=round(float(ys.max() / net), 3) if net > 0 else float("nan"),
        h1_usd=round(float(usd[yr <= 2016].sum()), 2),
        h2_usd=round(float(usd[yr >= 2017].sum()), 2),
    )
    return out


def survival(st):
