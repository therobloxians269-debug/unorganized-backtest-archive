                  f"MFE_R q25/50/75/90/95={q[0]:.2f}/{q[1]:.2f}/{q[2]:.2f}/{q[3]:.2f}/{q[4]:.2f} "
                  f"P(>=1R)={reach[0]:.2f} P(>=2R)={reach[1]:.2f} P(>=3R)={reach[2]:.2f} P(>=5R)={reach[3]:.2f}")
            print("     ", fmt(stats(tr, d, f"D{lb} time-exit-only")))


if __name__ == "__main__":
