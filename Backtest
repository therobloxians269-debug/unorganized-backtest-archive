def _fmt_metric(key: str, val) -> str:
    """Right-justify and format a single metric value for the report table."""
    if isinstance(val, str):
        return f"{val:>22}"
    if isinstance(val, int):
        return f"{val:>22,}"
    if isinstance(val, float):
        if "(%" in key or "%" in key:
            return f"{val:>21.4f}%"
        if "($)" in key or "$" in key:
            return f"${val:>20,.2f}"
        return f"{val:>22.4f}"
    return f"{str(val):>22}"


def print_report(
    metrics: dict,
    trades:  list[TradeRecord],
    cfg:     BacktestConfig,
) -> None:
    """
    Render the full backtest performance report to stdout.
    Includes the strategy configuration header, metrics table,
    and a tail-sample trade log.
    """
    W   = 72
    SEP = "═" * W
    DIV = "─" * W

    # ── Header ────────────────────────────────────────────────────────────────
    print(f"\n{SEP}")
    print(f"  NET-GEX GAMMA-FLIP STRATEGY  ─  BACKTEST PERFORMANCE REPORT")
    print(DIV)
    print(f"  Ticker      :  {cfg.ticker}")
    print(f"  Period      :  {cfg.start_date}  →  {cfg.end_date}")
    print(f"  Bar Interval:  {cfg.bar_interval_min}-minute intraday bars")
    print(f"  Capital     :  ${cfg.initial_capital:>12,.2f}")
    print(f"  Position    :  {cfg.contracts} contracts  ×  {cfg.shares_per_contract} shares/contract")
    print(f"  Friction    :  ${cfg.fee_per_contract:.2f}/contract/side  +  "
          f"{cfg.slippage_pct * 100:.0f}% slippage on every fill")
    print(f"  Force Close :  {cfg.force_close_time.strftime('%H:%M')} EST  "
          f"(hard stop — no overnight holds)")
    print(f"  Execution   :  Signal at bar[i] CLOSE → Fill at bar[i+1] OPEN")
    print(SEP)

    # ── Metrics table ─────────────────────────────────────────────────────────
    print(f"\n  {'METRIC':<38}  {'VALUE':>22}")
    print(f"  {'──────':<38}  {'─────':>22}")
    for key, val in metrics.items():
        print(f"  {key:<38}  {_fmt_metric(key, val)}")

    # ── Trade log (last 15 trades) ────────────────────────────────────────────
    n_show  = min(15, len(trades))
    tail    = trades[-n_show:]
    offset  = len(trades) - n_show + 1

    print(f"\n{DIV}")
    print(f"  TRADE LOG  —  last {n_show} of {len(trades)} round-trip trades")
    print(DIV)
    hdr = (
        f"  {'#':>4}  {'Dir':^5}  {'Entry Time':<21}  {'Exit Time':<21}  "
        f"{'Entry':>9}  {'Exit':>9}  {'Net P&L':>12}  Reason"
    )
    col_div = (
        f"  {'─'*4}  {'─'*5}  {'─'*21}  {'─'*21}  "
        f"{'─'*9}  {'─'*9}  {'─'*12}  {'─'*13}"
    )
    print(hdr)
    print(col_div)

    for k, t in enumerate(tail, start=offset):
        dir_lbl  = "LONG " if t.direction == 1 else "SHORT"
        sign     = "+" if t.net_pnl >= 0 else ""
        pnl_str  = f"{sign}{t.net_pnl:>10,.2f}"
        print(
            f"  {k:>4}  {dir_lbl:^5}  "
            f"{str(t.entry_time):<21}  {str(t.exit_time):<21}  "
            f"{t.entry_fill:>9.4f}  {t.exit_fill:>9.4f}  "
            f"{pnl_str:>12}  {t.exit_reason}"
        )

    print(f"\n{SEP}\n")


# ─────────────────────────────────────────────────────────────────────────────
# §9  CSV EXPORT
# ─────────────────────────────────────────────────────────────────────────────

def export_results(
    df:         pd.DataFrame,
    trades:     list[TradeRecord],
    equity_csv: str = "equity_curve.csv",
    trades_csv: str = "trade_log.csv",
) -> None:
    """
    Persist the equity curve and trade log to CSV for downstream analysis
    (Excel, R, Matplotlib, Plotly, etc.).

    Exports
    ───────
    equity_curve.csv  — bar-level OHLCV, GEX, signal, and running equity
    trade_log.csv     — one row per round-trip trade with full attribution
    """
    cols_to_export = [
        "open", "high", "low", "close", "volume",
        "net_gex", "gex_sign", "raw_signal", "equity",
    ]
    df[cols_to_export].to_csv(equity_csv)

    if trades:
        pd.DataFrame([asdict(t) for t in trades]).to_csv(trades_csv, index=False)

    print(f"  Equity curve  →  {equity_csv}  ({len(df):,} bars)")
    print(f"  Trade log     →  {trades_csv}  ({len(trades):,} trades)\n")


