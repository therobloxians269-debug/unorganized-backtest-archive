"""
RK LADDER — full nested band ladder, PER-TRADE simulation with concurrency.
Fits 12 quantile regressions (q20/40/60/80/90/95 each side) on ES 2010-2017,
never refits, then simulates every band on every day tracking CONCURRENT positions
and minute-level mark-to-market equity (what Apex's trailing threshold actually sees).
"""
import numpy as np, pandas as pd, pickle, os
from sklearn.linear_model import QuantileRegressor

SCR = '/private/tmp/claude-501/-Users-kaveh/d5ce5738-dd59-4ca2-bd9c-e9b02fe3107c/scratchpad'
QS  = [0.20,0.40,0.60,0.80,0.90,0.95]
FEATS = ['f_onlo','f_onhi','f_gap','f_pdr','f_dow']  # NOT f_onr: it is exactly f_onlo+f_onhi

def build(df, adrlen=14):
    """df: 1m bars, tz-aware ET index, cols open/high/low/close. Returns day frame + RTH bar arrays."""
    d = df.copy()
    tod = d.index.hour*60 + d.index.minute
    d['tod'] = tod
    d['rth'] = (tod>=570)&(tod<960)
    # session day = the calendar date of the RTH block
    d['day'] = d.index.normalize()
    r = d[d['rth']]
    g = r.groupby('day')
    day = pd.DataFrame({
        'o930': g['open'].first(), 'hi': g['high'].max(), 'lo': g['low'].min(),
        'cl': g['close'].last(), 'n': g.size()})
    day = day[day['n']>=300]
    day['rng'] = day['hi']-day['lo']
    # ADR(14) = mean of last 14 COMPLETED RTH ranges, today excluded
    day['ADR'] = day['rng'].shift(1).rolling(adrlen).mean()
    day['prevC'] = day['cl'].shift(1)
    day['prevRng'] = day['rng'].shift(1)
    # overnight = bars between prior RTH close and this RTH open
    ov = d[~d['rth']].copy()
    # assign each overnight bar to the NEXT rth day
    rthdays = day.index
    pos = np.searchsorted(rthdays.values, ov.index.normalize().values, side='left')
    # bars after 16:00 belong to next day's overnight; bars before 09:30 belong to same day
    same = ov['tod'] < 570
    idx = np.where(same, pos, pos+1)
    ok = idx < len(rthdays)
    ov = ov[ok]; idx = idx[ok]
    ov['tgt'] = rthdays[idx]
    og = ov.groupby('tgt')
    day['onH'] = og['high'].max(); day['onL'] = og['low'].min()
    day = day.dropna(subset=['ADR','onH','onL','prevC','prevRng'])
    day = day[day['ADR']>0]
    A = day['ADR']
    day['f_onr']  = (day['onH']-day['onL'])/A
    day['f_onlo'] = (day['o930']-day['onL'])/A
    day['f_onhi'] = (day['onH']-day['o930'])/A
    day['f_gap']  = (day['o930']-day['prevC'])/A
    day['f_pdr']  = day['prevRng']/A
    day['f_dow']  = day.index.dayofweek/4.0
    day['y_lo'] = (day['o930']-day['lo'])/A
    day['y_hi'] = (day['hi']-day['o930'])/A
    return day, r

def fit(train):
    M = {}
    X = train[FEATS].values
    for side,y in (('lo',train['y_lo'].values),('hi',train['y_hi'].values)):
        for q in QS:
            m = QuantileRegressor(quantile=q, alpha=0.0, solver='highs').fit(X,y)
            M[(side,q)] = (m.intercept_, m.coef_.copy())
    return M

def pred(M, day):
    X = day[FEATS].values
    out = {}
    for k,(b,c) in M.items():
        out[k] = np.maximum(X@c + b, 0.03)
    return out

# ─────────────────────────── the simulator ───────────────────────────
# bands: (q_entry, q_stop, size). entry = inner edge (nearer the open), stop = outer edge.
BANDS = [(0.20,0.40,1),(0.40,0.60,1),(0.60,0.80,2),(0.80,0.90,3),(0.90,0.95,3)]

def simulate(day, rth, P, bands=BANDS, pv=5.0, comm=1.50, tick=0.25,
             sides=('lo','hi'), tgt_q=0.60, sized=False, flat_min=959, tgt_frac=1.0):
    """Returns (trades DataFrame, dict day -> minute-level MTM equity path in $ (1 unit size))."""
    trades = []
    paths  = {}
    days = day.index
    di = {d:i for i,d in enumerate(days)}
    grp = {d:v for d,v in rth.groupby('day')}
    for d in days:
        if d not in grp: continue
        i = di[d]
        bars = grp[d]
        if len(bars) < 300: continue
        o = day.at[d,'o930']; A = day.at[d,'ADR']
        H = bars['high'].values; L = bars['low'].values; C = bars['close'].values
        tds = bars['tod'].values
        nb = len(bars)
        tgt_lo = o - P[('lo',tgt_q)][i]*A   # opposite block for a SHORT
        tgt_hi = o + P[('hi',tgt_q)][i]*A   # opposite block for a LONG
        # build the order book for the day
        orders = []
        for (qe,qs,sz) in bands:
            size = sz if sized else 1
            if 'lo' in sides:
                ent = o - P[('lo',qe)][i]*A
                stp = o - P[('lo',qs)][i]*A
                if stp < ent - 1e-9:
                    orders.append(dict(dir=1, ent=ent, stp=stp, tgt=ent+tgt_frac*(tgt_hi-ent), sz=size, band=(qe,qs), fill=-1))
            if 'hi' in sides:
                ent = o + P[('hi',qe)][i]*A
                stp = o + P[('hi',qs)][i]*A
                if stp > ent + 1e-9:
                    orders.append(dict(dir=-1, ent=ent, stp=stp, tgt=ent-tgt_frac*(ent-tgt_lo), sz=size, band=(qe,qs), fill=-1))
        realized = 0.0
        open_pos = []
        path = np.empty(nb, dtype=np.float64)
        for k in range(nb):
            hk, lk, ck = H[k], L[k], C[k]
            last = (k == nb-1) or (tds[k] >= flat_min)
            # 1) resolve open positions (only from the bar AFTER the fill)
            still = []
            for p in open_pos:
                if p['fill'] == k:
                    still.append(p); continue
                dr = p['dir']
                hit_stop = (lk <= p['stp']) if dr==1 else (hk >= p['stp'])
                hit_tgt  = (hk >= p['tgt']) if dr==1 else (lk <= p['tgt'])
                if hit_stop:                      # conservative: stop wins ties
                    px = p['stp'] - dr*tick       # 1 tick slippage against us
                    reason='stop'
                elif hit_tgt:
                    px = p['tgt']; reason='target'
                elif last:
                    px = ck; reason='time'
                else:
                    still.append(p); continue
                pnl = dr*(px - p['ent'])*pv*p['sz'] - comm*p['sz']
                realized += pnl
                trades.append(dict(day=d, dir=dr, band=p['band'], sz=p['sz'], ent=p['ent'],
                                   stp=p['stp'], tgt=p['tgt'], exit=px, reason=reason,
                                   k_in=p['fill'], k_out=k, pnl=pnl,
                                   R=pnl/(abs(p['ent']-p['stp'])*pv*p['sz']),
                                   prox=min(abs(p['ent']-day.at[d,'lo']),abs(p['ent']-day.at[d,'hi']))/A))
            open_pos = still
            # 2) new fills (limit orders)
            if not last:
                for od in orders:
                    if od['fill'] >= 0: continue
                    filled = (lk <= od['ent']) if od['dir']==1 else (hk >= od['ent'])
                    if filled:
                        od['fill'] = k
                        open_pos.append(dict(od))
            # 3) mark to market
            unreal = sum(p['dir']*(ck-p['ent'])*pv*p['sz'] for p in open_pos)
            path[k] = realized + unreal
        paths[d] = path
    T = pd.DataFrame(trades)
    return T, paths

