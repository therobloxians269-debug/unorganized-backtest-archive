"""
PM DUE-DILIGENCE PACK — fills the institutional metrics a PM asks for after the tear sheet.
All computed from the 2020-2026 BACKTEST per-sleeve daily series (live is ~1wk, too short).

Adds, on top of TEARSHEET.md / monte_carlo.py / walk_forward.py:
  - rolling 12m/24m Sharpe (is 1.72 stable or one-year?)
  - drawdown episodes: depth, peak->trough length, recovery time, underwater duration
  - monthly distribution: best/worst/avg/std/%pos, skew, kurtosis, VaR & CVaR (95/99)
  - return contribution & realized-risk contribution by sleeve
  - correlation stability: avg / max / crisis (COVID) pairwise
  - SENSITIVITY (real re-runs): funding -50%, costs x2/x3, momentum -30%, combined stress
  - turnover by carry sleeve (annualized one-way)
  - OOS period split: 2020-2023 vs 2024-2026

    PYTHONPATH=/Users/kaveh/mim_research python3 pm_dd_pack.py
"""
from __future__ import annotations
import numpy as np
import pandas as pd
from scipy.stats import skew, kurtosis
from lib_perf import perf_stats

DIR = "/Users/kaveh/mim_research"
ANN, START, CASH_Y, CAPF = 365, "2020-02-01", 0.04 / 365, 1.5


# ----------------------------------------------------------- parameterized rebuild
def carry_sleeve(fund, pnl, cost_scale=1.0):
    tr = fund.rolling(30).mean().shift(1)
    raw = tr.clip(lower=0)
    w = raw.div(raw.sum(axis=1).replace(0, np.nan), axis=0).clip(upper=0.15)  # 10%->15%: OOS-stable +~0.05 Sharpe (2026-06-22), prudent vs venue tail
    w = w.div(w.sum(axis=1).replace(0, np.nan), axis=0).fillna(0.0)
    w = w.resample("W").last().reindex(fund.index, method="ffill").fillna(0.0)
    turn = w.diff().abs().sum(axis=1)
    ret = ((w * pnl).sum(axis=1) / CAPF - turn * 0.004 * cost_scale / CAPF
           + (CAPF - 1) / CAPF * CASH_Y).dropna()
    return ret, turn.reindex(ret.index).fillna(0.0)


def build(fund_scale=1.0, cost_scale=1.0, mom_scale=1.0):
    k = pd.read_parquet(f"{DIR}/binance_klines.parquet"); k["date"] = k["t"].dt.normalize()
    f = pd.read_parquet(f"{DIR}/binance_funding.parquet"); f["date"] = f["t"].dt.normalize()
    bs = k[k.kind == "spot"].pivot_table(index="date", columns="sym", values="close")
    bp = k[k.kind == "perp"].pivot_table(index="date", columns="sym", values="close")
    bf = f.groupby(["date", "sym"])["fr"].sum().unstack() * fund_scale
    i = bs.index.intersection(bp.index).intersection(bf.index)
    bs, bp, bf = bs.loc[i], bp.loc[i], bf.reindex(i)
    C1, tC1 = carry_sleeve(bf, bs.pct_change() - bp.pct_change() + bf, cost_scale)
    hf = pd.read_parquet(f"{DIR}/hl_funding.parquet"); hf["date"] = hf["t"].dt.normalize()
    hfund = hf.groupby(["date", "coin"])["fr"].sum().unstack() * fund_scale
    hk = pd.read_parquet(f"{DIR}/hl_perp_1d.parquet")
    hp = hk.assign(date=hk["t"].dt.normalize()).pivot_table(index="date", columns="coin", values="close")
    bsc = bs.copy(); bsc.columns = [c.replace("USDT", "") for c in bsc.columns]
    hi = hfund.index.intersection(hp.index).intersection(bsc.index)
    cols = [c for c in ["BTC","ETH","SOL","XRP","DOGE","ADA","AVAX","LINK","LTC","DOT"]
            if c in hfund.columns and c in hp.columns and c in bsc.columns]
    C2, tC2 = carry_sleeve(hfund.loc[hi, cols],
                           bsc.loc[hi, cols].pct_change() - hp.loc[hi, cols].pct_change()
                           + hfund.loc[hi, cols], cost_scale)
    M = pd.read_parquet(f"{DIR}/pit_net.parquet")["net"] * mom_scale
    T = pd.read_parquet(f"{DIR}/trend_all.parquet")["net"]
    j = pd.concat([C1.rename("C1"), C2.rename("C2"), M.rename("M"), T.rename("T")], axis=1, sort=True)
    j = j[j.index >= START]
    j[["M", "T"]] = j[["M", "T"]].fillna(0.0); j["C2"] = j["C2"].fillna(0.0)
    j = j.dropna(subset=["C1"])
    c2a = (j["C2"] != 0)
    comp = pd.DataFrame({
        "C1": (0.35 + np.where(c2a, 0, 0.25)) * j["C1"],
        "C2": 0.25 * c2a * j["C2"],
        "M": 0.15 * j["M"],
        "T": 0.25 * j["T"],
    }, index=j.index)
    port = comp.sum(axis=1)
    return port, j, comp, tC1, tC2


# ----------------------------------------------------------- analytics helpers
def sharpe(r):
    r = r.dropna()
    return r.mean() / r.std() * np.sqrt(ANN) if r.std() > 0 else np.nan


def rolling_sharpe(port, months):
    win = int(round(months / 12 * ANN))
    rs = port.rolling(win).apply(lambda x: x.mean() / x.std() * np.sqrt(ANN) if x.std() > 0 else np.nan)
    rs = rs.dropna()
    return rs, win


def drawdown_episodes(port, top=5):
    eq = (1 + port).cumprod()
    peak, peak_d = eq.iloc[0], eq.index[0]
    in_dd, trough, trough_d, start_peak, start_peak_d = False, peak, peak_d, peak, peak_d
    eps = []
    for d, v in eq.items():
        if v >= peak:
            if in_dd:
                eps.append((start_peak_d, trough_d, d, trough / start_peak - 1))
                in_dd = False
            peak, peak_d = v, d
        else:
            if not in_dd:
                in_dd, trough, trough_d, start_peak, start_peak_d = True, v, d, peak, peak_d
            if v < trough:
                trough, trough_d = v, d
    if in_dd:
        eps.append((start_peak_d, trough_d, None, trough / start_peak - 1))
    eps.sort(key=lambda e: e[3])
    return eps[:top]


def main():
    port, j, comp, tC1, tC2 = build()
    base_sh = sharpe(port)
    yrs = len(port) / ANN
    print(f"\n{'='*78}\nPM DUE-DILIGENCE PACK — Program v3 (BACKTEST 2020-2026, {yrs:.1f}y, net of frictions)")
    print(f"baseline: Sharpe {base_sh:.2f} | CAGR {((1+port).prod()**(1/yrs)-1)*100:.1f}% "
          f"| maxDD {((1+port).cumprod()/(1+port).cumprod().cummax()-1).min()*100:.1f}%\n{'='*78}")

    # ---- 1. rolling Sharpe
    print("\n[1] ROLLING SHARPE  (is 1.72 stable, or did one year make it?)")
    for m in (12, 24):
        rs, win = rolling_sharpe(port, m)
        print(f"  {m:>2}-mo rolling Sharpe ({win}d): min {rs.min():.2f} | 25th {rs.quantile(.25):.2f} "
              f"| median {rs.median():.2f} | 75th {rs.quantile(.75):.2f} | max {rs.max():.2f} "
              f"| %>1.0 {(rs>1).mean()*100:.0f}% | %<0 {(rs<0).mean()*100:.0f}%")

    # ---- 2. drawdown episodes
    print("\n[2] DRAWDOWN EPISODES  (depth · peak->trough · recovery · underwater)")
    print(f"  {'depth':>7} {'peak':>11} {'trough':>11} {'recovered':>11} {'to-trough':>10} {'recovery':>9} {'underwater':>11}")
    for sp, tr, rc, dep in drawdown_episodes(port):
        to_tr = (tr - sp).days
        rec = (rc - tr).days if rc else None
        uw = (rc - sp).days if rc else (port.index[-1] - sp).days
        print(f"  {dep*100:>6.1f}% {sp.date()!s:>11} {tr.date()!s:>11} "
              f"{(rc.date() if rc else 'ongoing')!s:>11} {to_tr:>8}d {(str(rec)+'d' if rec is not None else 'ongoing'):>9} {uw:>9}d")

    # ---- 3. monthly distribution + tail
    m = port.resample("ME").apply(lambda x: (1 + x).prod() - 1).dropna()
    print(f"\n[3] MONTHLY RETURN DISTRIBUTION  ({len(m)} months)")
    print(f"  best {m.max()*100:+.1f}% ({m.idxmax().date()}) | worst {m.min()*100:+.1f}% ({m.idxmin().date()})")
    print(f"  avg {m.mean()*100:+.2f}% | std {m.std()*100:.2f}% | positive {(m>0).mean()*100:.0f}% "
          f"({(m>0).sum()}/{len(m)}) | negative {(m<0).mean()*100:.0f}%")
    print(f"\n[4] TAIL RISK  (monthly)")
    print(f"  skewness {skew(m):+.2f} | excess kurtosis {kurtosis(m):+.2f}")
    for p, lbl in ((5, "95%"), (1, "99%")):
        var = np.percentile(m, p); cvar = m[m <= var].mean()
        print(f"  {lbl} VaR {var*100:+.2f}%  |  {lbl} CVaR/ES {cvar*100:+.2f}%  (avg loss in worst {p}%)")

    # ---- 5. contribution to return / risk
    print("\n[5] CONTRIBUTION BY SLEEVE")
    ret_c = comp.mean() / port.mean()
    var_p = port.var()
    risk_c = comp.apply(lambda c: c.cov(port)) / var_p
    print(f"  {'sleeve':6} {'return contrib':>15} {'risk contrib':>14}")
    for s in ["C1", "C2", "M", "T"]:
        print(f"  {s:6} {ret_c[s]*100:>14.0f}% {risk_c[s]*100:>13.0f}%")

    # ---- 6. correlation stability
    print("\n[6] CORRELATION STABILITY (pairwise sleeve, daily)")
    full = j.corr()
    off = full.where(~np.eye(4, dtype=bool))
    covid = j[(j.index >= "2020-02-15") & (j.index <= "2020-05-15")].corr()
    coff = covid.where(~np.eye(4, dtype=bool))
    print(f"  full-sample: avg {off.stack().mean():.2f} | max {off.stack().max():.2f}")
    print(f"  COVID crash (Feb-May'20): avg {coff.stack().mean():.2f} | max {coff.stack().max():.2f}")

    # ---- 7. turnover (carry, annualized one-way)
    print("\n[7] TURNOVER (annualized one-way; carry sleeves only — M/T net-series, weights not cached)")
    print(f"  C1 (Binance carry): {tC1.mean()*ANN:.1f}x   C2 (HL carry): {tC2.mean()*ANN:.1f}x")

    # ---- 8. OOS period split
    print("\n[8] OUT-OF-SAMPLE PERIOD SPLIT")
    for lbl, a, b in (("2020-2023", "2020", "2023"), ("2024-2026", "2024", "2026")):
        seg = port[(port.index.year >= int(a)) & (port.index.year <= int(b))]
        s = perf_stats(seg, ANN)
        print(f"  {lbl}: Sharpe {s['sharpe']:.2f} | CAGR {s['cagr']*100:.1f}% | maxDD {s['maxdd']*100:.1f}%")

    # ---- 9. sensitivity / slippage (REAL re-runs)
    print("\n[9] SENSITIVITY & SLIPPAGE  (full re-run of the engine under stress)")
    print(f"  {'scenario':28} {'Sharpe':>7} {'CAGR':>7} {'maxDD':>7}")
    def row(lbl, **kw):
        p, *_ = build(**kw)
        s = perf_stats(p, ANN)
        print(f"  {lbl:28} {s['sharpe']:>7.2f} {s['cagr']*100:>6.1f}% {s['maxdd']*100:>6.1f}%")
    row("baseline")
    row("costs x2", cost_scale=2.0)
    row("costs x3", cost_scale=3.0)
    row("funding -50%", fund_scale=0.5)
    row("momentum -30%", mom_scale=0.7)
    row("STRESS (fund-50 cost2 mom-30)", fund_scale=0.5, cost_scale=2.0, mom_scale=0.7)
    print("\nThe headline thesis is carry. If 'funding -50%' still clears Sharpe ~1, the program is")
    print("robust to its single biggest risk. That number is the one a PM weighs most.\n")


if __name__ == "__main__":
    main()

