"""
=============================================================================
IABR Strategy  -  Module 3: Reference Level Computation
=============================================================================
Strategy    : Intraday Auction Balance Reversion (IABR)
Instruments : MES, ES, MNQ, NQ, MYM, YM
Environment : Python 3.10+  |  Google Colab compatible
Version     : 1.0
Depends on  : m1_data_session.py, m2_volatility_regime.py
=============================================================================

DESCRIPTION
-----------
Computes every institutional reference level used by the IABR signal
module (Module 5).  Four families of levels are produced:

    VWAP (expanding within RTH session)
        Session VWAP anchored to RTH open (9:30 ET), volume-weighted
        using typical price (H+L+C)/3.
        Standard deviation bands computed via volume-weighted variance.
        Z-score of current price vs VWAP is the primary signal input.

    Volume Profile (prior session, causal)
        Per-session volume distribution across price levels.
        POC, Value Area High/Low (70% of volume), HVN, LVN.
        Prior session levels are broadcast to current session bars.
        5-session composite levels use rolling mean of prior POC/VAH/VAL.

    Initial Balance (expanding then locked at bar 60)
        First 60 bars of RTH = 9:30-10:29 ET.
        IB High and Low expand during the IB period, then lock.
        IB range classified as narrow / normal / wide vs prior 60 sessions.

    Live POC (approximate, expanding within session)
        Running volume-by-price approximation using close price binning.
        Distinct from prior-session POC: reflects today's auction.

LOOKAHEAD GUARANTEES
--------------------
- VWAP at bar T uses only bars 0..T within the session.
- IB High/Low at bar T during IB period use only bars 0..T.
  After IB completes (bar 60), IB is locked from bars 0..59.
- prior_poc/vah/val/hvn/lvn: fully from the completed prior session.
- Composite levels: rolling mean with shift(1) before rolling.
- Live POC: cumulative from session open to bar T.

OUTPUT SCHEMA  (new columns appended to Module 2 output)
---------------------------------------------------------
  vwap                float64  - session VWAP
  vwap_std            float64  - volume-weighted std of deviations from VWAP
  vwap_upper_1        float64  - VWAP + 1*std
  vwap_lower_1        float64  - VWAP - 1*std
  vwap_upper_2        float64  - VWAP + 2*std
  vwap_lower_2        float64  - VWAP - 2*std
  vwap_z              float64  - (close - vwap) / vwap_std
  vwap_dist_atr       float64  - |close - vwap| / atr_20s
  ib_high             float64  - Initial Balance high (expanding then locked)
  ib_low              float64  - Initial Balance low  (expanding then locked)
  ib_range            float64  - ib_high - ib_low
  ib_complete         bool     - True from bar 60 onward
  ib_range_class      object   - "narrow" / "normal" / "wide" / "unknown"
  price_vs_ib         object   - "inside" / "above" / "below"
  ib_ext_atr          float64  - |distance beyond IB| / atr_20s
  prior_poc           float64  - prior session POC
  prior_vah           float64  - prior session Value Area High
  prior_val           float64  - prior session Value Area Low
  prior_va_width      float64  - prior_vah - prior_val
  in_prior_va         bool     - close inside [prior_val, prior_vah]
  dist_to_prior_poc   float64  - (close - prior_poc) / atr_20s  (signed)
  nearest_hvn_above   float64  - price of nearest prior-session HVN above close
  nearest_hvn_below   float64  - price of nearest prior-session HVN below close
  nearest_lvn_above   float64  - price of nearest prior-session LVN above close
  nearest_lvn_below   float64  - price of nearest prior-session LVN below close
  comp_poc_5s         float64  - composite POC: mean of prior 5 sessions
  comp_vah_5s         float64  - composite VAH: mean of prior 5 sessions
  comp_val_5s         float64  - composite VAL: mean of prior 5 sessions
  live_poc            float64  - approximate developing POC (current session)
  dist_to_live_poc    float64  - (close - live_poc) / atr_20s  (signed)
=============================================================================
"""

# ---- 0. Imports -------------------------------------------------------------
import logging
import warnings
from dataclasses import dataclass
from typing import Dict, List, Optional

import numpy as np
import pandas as pd

from m1_data_session import SessionType, validate_module1_output
from m2_volatility_regime import (
    MODULE2_OUTPUT_SCHEMA,
    RegimeLabel,
    VolatilityRegimeModule,
    validate_module2_output,
    run_module2_demo,
)

warnings.filterwarnings("ignore", category=pd.errors.PerformanceWarning)

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(name)s - %(message)s",
    datefmt="%H:%M:%S",
)
logger = logging.getLogger("IABR.M3")

__all__ = [
    "RefLevelConfig",
    "ReferenceLevelModule",
    "MODULE3_OUTPUT_SCHEMA",
    "validate_module3_output",
    "run_module3_demo",
]

# ---- Session/IB constants ---------------------------------------------------
_IB_BARS        = 60       # first 60 RTH bars = 9:30-10:29 ET
_VA_PCT         = 0.70     # 70% value area (standard)
_HVN_THRESH_PCT = 75.0     # local maxima above this profile percentile -> HVN
_LVN_THRESH_PCT = 25.0     # local minima below this profile percentile -> LVN
_MAX_NODES      = 5        # max HVN/LVN nodes stored per session


# =============================================================================
# SECTION 1 - CONFIGURATION
# =============================================================================

@dataclass
class RefLevelConfig:
    """
    Configuration for reference level computation.

    value_area_pct    Fraction of session volume defining the Value Area.
                      Industry standard is 0.70 (70%).

    ib_bars           Number of RTH bars in the Initial Balance period.
                      Default 60 = first 60 minutes (9:30-10:29 ET).

    ib_history        Sessions of IB range history used for narrow/normal/wide
                      classification.  Min 10 required for classification.

    composite_window  Sessions used for composite profile rolling mean.
    """
    value_area_pct:   float = 0.70
    ib_bars:          int   = 60
    ib_history:       int   = 60
    composite_window: int   = 5
    ib_narrow_z:      float = -0.5
    ib_wide_z:        float =  0.5


# =============================================================================
# SECTION 2 - STANDALONE VOLUME PROFILE HELPER
# =============================================================================

def _compute_session_vp(
    bars:           pd.DataFrame,
    tick_size:      float,
    value_area_pct: float = 0.70,
) -> Optional[dict]:
    """
    Compute volume profile metrics for a single RTH session.

    Algorithm
    ---------
    1.  Build price bins at tick_size intervals covering the session range.
    2.  Distribute each bar's volume uniformly across bins spanning [low, high].
        This is the standard approach for OHLCV data without tick data.
    3.  Identify POC (max-volume bin).
    4.  Expand from POC outward, adding the higher-volume side each step,
        until value_area_pct of total volume is captured.  This gives VAH/VAL.
    5.  Detect HVN (local maxima above 75th profile percentile) and
        LVN (local minima below 25th profile percentile, volume > 0).

    Parameters
    ----------
    bars           RTH bars for one session (must have high/low/volume).
    tick_size      Minimum price increment for the instrument.
    value_area_pct Fraction of volume to enclose in the value area.

    Returns
    -------
    dict with keys poc, vah, val, va_width, hvns (list), lvns (list)
    or None if the session has insufficient data.
    """
    if len(bars) < 5:
        return None

    p_min  = np.floor(bars["low"].min()  / tick_size) * tick_size
    p_max  = np.ceil( bars["high"].max() / tick_size) * tick_size
    n_bins = max(2, int(round((p_max - p_min) / tick_size)) + 1)
    bins   = p_min + np.arange(n_bins) * tick_size

    # Vectorized bin index computation
    lo_idx  = np.round((bars["low"].values  - p_min) / tick_size).astype(int).clip(0, n_bins - 1)
    hi_idx  = np.round((bars["high"].values - p_min) / tick_size).astype(int).clip(0, n_bins - 1)
    vol_arr = bars["volume"].values.astype(float)

    profile = np.zeros(n_bins)
    for i in range(len(lo_idx)):
        span = max(1, hi_idx[i] - lo_idx[i] + 1)
        profile[lo_idx[i]:hi_idx[i] + 1] += vol_arr[i] / span

    total = profile.sum()
    if total == 0.0:
        return None

    # POC
    poc_idx  = int(np.argmax(profile))
    poc      = bins[poc_idx]

    # Value Area: expand from POC until value_area_pct of volume is captured
    val_idx  = vah_idx = poc_idx
    captured = float(profile[poc_idx])
    target   = total * value_area_pct

    while captured < target:
        up   = float(profile[vah_idx + 1]) if vah_idx < n_bins - 1 else 0.0
        down = float(profile[val_idx - 1]) if val_idx > 0           else 0.0
        if up == 0.0 and down == 0.0:
            break
        if up >= down:
            vah_idx  += 1
            captured += up
        else:
            val_idx  -= 1
            captured += down

    vah = bins[vah_idx]
    val = bins[val_idx]

    # HVN / LVN detection via local extrema
    nz_mask = profile > 0.0
    hvns: List[float] = []
    lvns: List[float] = []
    if nz_mask.sum() >= 5:
        nz          = profile[nz_mask]
        hvn_thresh  = np.percentile(nz, _HVN_THRESH_PCT)
        lvn_thresh  = np.percentile(nz, _LVN_THRESH_PCT)
        for i in range(1, n_bins - 1):
            v, vl, vr = profile[i], profile[i - 1], profile[i + 1]
            if v >= hvn_thresh and v >= vl and v >= vr:
                hvns.append(float(bins[i]))
            if 0.0 < v <= lvn_thresh and v <= vl and v <= vr:
                lvns.append(float(bins[i]))

    return {
        "poc":      poc,
        "vah":      vah,
        "val":      val,
        "va_width": vah - val,
        "hvns":     sorted(hvns)[:_MAX_NODES],
        "lvns":     sorted(lvns)[:_MAX_NODES],
    }


# =============================================================================
# SECTION 3 - REFERENCE LEVEL MODULE
# =============================================================================

class ReferenceLevelModule:
    """
    Computes all reference levels required by IABR signal generation.

    process() pipeline
    ------------------
    SESSION-LEVEL (computed once per completed session)
        _compute_all_session_vps     -> VP for every session
        _compute_composite_levels    -> rolling composite POC/VAH/VAL
        _compute_ib_classification   -> narrow/normal/wide per session

    BAR-LEVEL (expanding within session or broadcast from prior session)
        _compute_vwap_and_bands      -> VWAP, bands, Z-score
        _compute_ib_bars             -> IB High/Low/range/complete/class
        _broadcast_prior_vp          -> prior POC/VAH/VAL/HVN/LVN -> bars
        _compute_nearest_nodes       -> nearest HVN/LVN above/below close
        _compute_price_location      -> distance metrics to all levels
        _compute_live_poc            -> developing POC within session
    """

    def __init__(self, config: Optional[RefLevelConfig] = None) -> None:
        self.config = config or RefLevelConfig()
        logger.info(
            f"ReferenceLevelModule ready | "
            f"va={self.config.value_area_pct:.0%} | "
            f"ib={self.config.ib_bars} bars | "
            f"composite={self.config.composite_window}s"
        )

    # ---- Main entry point ---------------------------------------------------

    def process(self, df_m2: pd.DataFrame) -> pd.DataFrame:
        """
        Annotate a Module 2 output DataFrame with all reference level columns.

        Parameters
        ----------
        df_m2 : Output of VolatilityRegimeModule.process().
                Must pass validate_module2_output().

        Returns
        -------
        pd.DataFrame with all M1+M2 columns preserved plus every
        column in MODULE3_OUTPUT_SCHEMA.
        """
        if not validate_module2_output(df_m2):
            raise ValueError("Input does not conform to Module 2 output schema.")

        df = df_m2.copy()

        # --- Session-level computations (completed sessions only) ----------
        logger.info("[M3] Computing session volume profiles ...")
        vp_sess = self._compute_all_session_vps(df)
        vp_sess = self._compute_composite_levels(vp_sess)
        vp_sess = self._compute_ib_classification(df, vp_sess)

        # --- Bar-level computations ----------------------------------------
        logger.info("[M3] Computing bar-level reference levels ...")
        df = self._compute_vwap_and_bands(df)
        df = self._compute_ib_bars(df, vp_sess)
        df = self._broadcast_prior_vp(df, vp_sess)
        df = self._compute_nearest_nodes(df)
        df = self._compute_price_location(df)
        df = self._compute_live_poc(df)

        self._log_summary(df)
        return df

    # =========================================================================
    # SESSION-LEVEL STEPS
    # =========================================================================

    def _compute_all_session_vps(self, df: pd.DataFrame) -> pd.DataFrame:
        """
        Compute volume profile metrics for every completed RTH session.

        Iterates over unique session IDs (outer loop: 252 iterations).
        Per-session VP uses vectorized numpy binning (inner: ~390 iterations).

        Returns a DataFrame indexed by rth_session_id with columns:
            poc, vah, val, va_width,
            hvn_1..hvn_5 (price of top HVNs, sorted ascending)
            lvn_1..lvn_5 (price of top LVNs, sorted ascending)
        """
        rth_mask    = df["session_type"] == SessionType.RTH.value
        rth         = df.loc[rth_mask]
        session_ids = sorted(rth["rth_session_id"].dropna().unique())

        records = []
        for sid in session_ids:
            bars      = rth.loc[rth["rth_session_id"] == sid]
            tick_size = float(bars["meta_tick_size"].iloc[0])
            vp        = _compute_session_vp(bars, tick_size, self.config.value_area_pct)

            rec = {"rth_session_id": sid}
            if vp is None:
                rec.update({
                    "poc": np.nan, "vah": np.nan, "val": np.nan, "va_width": np.nan,
                    **{f"hvn_{i+1}": np.nan for i in range(_MAX_NODES)},
                    **{f"lvn_{i+1}": np.nan for i in range(_MAX_NODES)},
                })
            else:
                hvns = vp["hvns"] + [np.nan] * _MAX_NODES  # pad to MAX_NODES
                lvns = vp["lvns"] + [np.nan] * _MAX_NODES
                rec.update({
                    "poc":      vp["poc"],
                    "vah":      vp["vah"],
                    "val":      vp["val"],
                    "va_width": vp["va_width"],
                    **{f"hvn_{i+1}": hvns[i] for i in range(_MAX_NODES)},
                    **{f"lvn_{i+1}": lvns[i] for i in range(_MAX_NODES)},
                })
            records.append(rec)

        vp_sess = (
            pd.DataFrame(records)
            .set_index("rth_session_id")
            .sort_index()
        )
        logger.debug(f"VP computed for {len(vp_sess)} sessions.")
        return vp_sess

    def _compute_composite_levels(self, vp_sess: pd.DataFrame) -> pd.DataFrame:
        """
        Rolling composite profile levels: mean of prior N sessions' POC/VAH/VAL.

        CAUSAL: shift(1) before rolling ensures session N uses only sessions
        N-window .. N-1.  min_periods=2 avoids NaN for the first few sessions.
        """
        w = self.config.composite_window
        for col, src in [("comp_poc_5s", "poc"),
                         ("comp_vah_5s", "vah"),
                         ("comp_val_5s", "val")]:
            vp_sess[col] = (
                vp_sess[src]
                .shift(1)
                .rolling(window=w, min_periods=2)
                .mean()
            )
        return vp_sess

    def _compute_ib_classification(
        self, df: pd.DataFrame, vp_sess: pd.DataFrame
    ) -> pd.DataFrame:
        """
        Classify each completed session's IB range as narrow / normal / wide
        relative to the trailing ib_history sessions.

        Method
        ------
        1.  Compute IB range (high - low of first ib_bars RTH bars) per session.
        2.  Compare to rolling mean/std of prior ib_history sessions (shift(1)
            before rolling → strictly causal).
        3.  Z-score: (ib_range - prior_mean) / prior_std.
            z < ib_narrow_z -> "narrow"
            z > ib_wide_z   -> "wide"
            else             -> "normal"

        Classification is only valid after ib_bars bars into the session.
        """
        rth_mask = df["session_type"] == SessionType.RTH.value
        rth      = df.loc[rth_mask].copy()

        # Bar position within session (0-indexed)
        bar_pos = rth.groupby("rth_session_id")["close"].cumcount()

        # IB bars: position < ib_bars
        ib_mask  = bar_pos < self.config.ib_bars
        ib_bars  = rth.loc[ib_mask]

        # Session IB High/Low
        ib_stats = ib_bars.groupby("rth_session_id").agg(
            ib_high=("high", "max"),
            ib_low=("low",  "min"),
        )
        ib_stats["ib_range"] = ib_stats["ib_high"] - ib_stats["ib_low"]

        # IB range classification using prior sessions' distribution
        hist      = self.config.ib_history
        prior_mu  = ib_stats["ib_range"].shift(1).rolling(hist, min_periods=10).mean()
        prior_sig = ib_stats["ib_range"].shift(1).rolling(hist, min_periods=10).std()
        z_score   = (ib_stats["ib_range"] - prior_mu) / prior_sig.clip(lower=1e-9)

        cfg = self.config
        ib_stats["ib_range_class"] = np.select(
            [z_score.isna(),
             z_score < cfg.ib_narrow_z,
             z_score > cfg.ib_wide_z],
            ["unknown", "narrow", "wide"],
            default="normal",
        )

        # Merge into vp_sess
        vp_sess = vp_sess.join(
            ib_stats[["ib_high", "ib_low", "ib_range", "ib_range_class"]],
            how="left",
        )
        return vp_sess

    # =========================================================================
    # BAR-LEVEL STEPS
    # =========================================================================

    def _compute_vwap_and_bands(self, df: pd.DataFrame) -> pd.DataFrame:
        """
        Compute session VWAP and volume-weighted standard deviation bands.

        Anchor : RTH open (9:30 ET).  Reset each session.  Non-RTH = NaN.

        Typical price  : (High + Low + Close) / 3
        VWAP           : cumsum(tp * volume) / cumsum(volume)
        VWAP variance  : cumsum(tp^2 * volume) / cumsum(volume)  -  VWAP^2
        VWAP std        : sqrt(variance), clipped to > 0
        Z-score         : (Close - VWAP) / VWAP_std

        All computations use only data available at bar T (expanding window).
        """
        for col in ("vwap", "vwap_std",
                    "vwap_upper_1", "vwap_lower_1",
                    "vwap_upper_2", "vwap_lower_2",
                    "vwap_z", "vwap_dist_atr"):
            df[col] = np.nan

        rth_mask = df["session_type"] == SessionType.RTH.value
        if not rth_mask.any():
            return df

        rth = df.loc[rth_mask].copy()
        tp  = (rth["high"] + rth["low"] + rth["close"]) / 3.0

        grp     = rth.groupby("rth_session_id", sort=False)
        sum_v   = grp["volume"].cumsum().clip(lower=1.0)
        sum_vp  = (tp * rth["volume"]).groupby(rth["rth_session_id"]).cumsum()
        sum_vp2 = (tp ** 2 * rth["volume"]).groupby(rth["rth_session_id"]).cumsum()

        vwap     = sum_vp / sum_v
        vwap_var = (sum_vp2 / sum_v) - vwap ** 2
        vwap_var = vwap_var.clip(lower=0.0)
        vwap_std = np.sqrt(vwap_var).clip(lower=1e-9)

        # Z-score and distance in ATR units
        vwap_z        = (rth["close"] - vwap) / vwap_std
        atr_denom     = rth["atr_20s"].fillna(rth["session_atr_live"]).clip(lower=1e-9)
        vwap_dist_atr = (rth["close"] - vwap).abs() / atr_denom

        df.loc[rth_mask, "vwap"]          = vwap.values
        df.loc[rth_mask, "vwap_std"]      = vwap_std.values
        df.loc[rth_mask, "vwap_upper_1"]  = (vwap + 1.0 * vwap_std).values
        df.loc[rth_mask, "vwap_lower_1"]  = (vwap - 1.0 * vwap_std).values
        df.loc[rth_mask, "vwap_upper_2"]  = (vwap + 2.0 * vwap_std).values
        df.loc[rth_mask, "vwap_lower_2"]  = (vwap - 2.0 * vwap_std).values
        df.loc[rth_mask, "vwap_z"]        = vwap_z.values
        df.loc[rth_mask, "vwap_dist_atr"] = vwap_dist_atr.values
        return df

    def _compute_ib_bars(
        self, df: pd.DataFrame, vp_sess: pd.DataFrame
    ) -> pd.DataFrame:
        """
        Compute per-bar Initial Balance metrics.

        During the IB period (bar 0..ib_bars-1):
            ib_high = expanding max of 'high' within session
            ib_low  = expanding min of 'low'  within session
            ib_complete = False

        After IB completes (bar >= ib_bars):
            ib_high / ib_low locked to values at bar ib_bars-1
            ib_complete = True

        ib_range_class (narrow/normal/wide) from vp_sess is broadcast to all
        bars in the session.  It is only meaningful when ib_complete=True.

        price_vs_ib  / ib_ext_atr are computed for all RTH bars.
        """
        for col in ("ib_high", "ib_low", "ib_range", "ib_complete",
                    "ib_range_class", "price_vs_ib", "ib_ext_atr"):
            df[col] = np.nan if col not in ("ib_complete",) else False

        rth_mask = df["session_type"] == SessionType.RTH.value
        if not rth_mask.any():
            return df

        rth     = df.loc[rth_mask].copy()
        grp     = rth.groupby("rth_session_id", sort=False)
        bar_pos = grp["close"].cumcount()           # 0-indexed

        # Expanding IB during period
        ib_high_exp = grp["high"].cummax()
        ib_low_exp  = grp["low"].cummin()

        # Locked IB values (from vp_sess which stores per-session ib_high/ib_low)
        ib_high_locked = rth["rth_session_id"].map(vp_sess["ib_high"])
        ib_low_locked  = rth["rth_session_id"].map(vp_sess["ib_low"])

        ib_done     = bar_pos >= self.config.ib_bars
        ib_high_bar = np.where(ib_done, ib_high_locked.values, ib_high_exp.values)
        ib_low_bar  = np.where(ib_done, ib_low_locked.values,  ib_low_exp.values)
        ib_range    = ib_high_bar - ib_low_bar

        # IB range class and price location
        ib_class    = rth["rth_session_id"].map(vp_sess.get("ib_range_class", pd.Series()))
        close       = rth["close"].values
        atr_denom   = rth["atr_20s"].fillna(rth["session_atr_live"]).clip(lower=1e-9).values

        above_ib  = close > ib_high_bar
        below_ib  = close < ib_low_bar
        price_loc = np.where(above_ib, "above",
                    np.where(below_ib, "below", "inside"))

        # IB extension in ATR units (0 if inside IB)
        ib_ext = np.where(
            above_ib, (close - ib_high_bar) / atr_denom,
            np.where(below_ib, (ib_low_bar - close) / atr_denom, 0.0)
        )

        df.loc[rth_mask, "ib_high"]       = ib_high_bar
        df.loc[rth_mask, "ib_low"]        = ib_low_bar
        df.loc[rth_mask, "ib_range"]      = ib_range
        df.loc[rth_mask, "ib_complete"]   = ib_done.values
        df.loc[rth_mask, "ib_range_class"] = ib_class.values if hasattr(ib_class, "values") else "unknown"
        df.loc[rth_mask, "price_vs_ib"]   = price_loc
        df.loc[rth_mask, "ib_ext_atr"]    = ib_ext
        return df

    def _broadcast_prior_vp(
        self, df: pd.DataFrame, vp_sess: pd.DataFrame
    ) -> pd.DataFrame:
        """
        Broadcast prior session volume profile levels to every bar.

        CAUSAL: prior_poc/vah/val/hvn/lvn for bars in session N come from
        the volume profile of session N-1 (vp_sess.shift(1)).
        Non-RTH bars receive NaN.
        """
        # Shift vp_sess by 1 to get PRIOR session values
        prior = vp_sess[
            ["poc", "vah", "val", "va_width"]
            + [f"hvn_{i+1}" for i in range(_MAX_NODES)]
            + [f"lvn_{i+1}" for i in range(_MAX_NODES)]
        ].shift(1)

        col_map = {
            "poc":      "prior_poc",
            "vah":      "prior_vah",
            "val":      "prior_val",
            "va_width": "prior_va_width",
            **{f"hvn_{i+1}": f"prior_hvn_{i+1}" for i in range(_MAX_NODES)},
            **{f"lvn_{i+1}": f"prior_lvn_{i+1}" for i in range(_MAX_NODES)},
        }
        for src_col, dst_col in col_map.items():
            df[dst_col] = df["rth_session_id"].map(prior[src_col])

        # in_prior_va: close inside [prior_val, prior_vah]
        df["in_prior_va"] = (
            (df["close"] >= df["prior_val"]) &
            (df["close"] <= df["prior_vah"])
        ).astype(bool)

        return df

    def _compute_nearest_nodes(self, df: pd.DataFrame) -> pd.DataFrame:
        """
        For each bar, find the nearest HVN and LVN above and below the close.

        Uses the prior-session HVN/LVN prices broadcast in _broadcast_prior_vp.
        Vectorized via numpy broadcasting over the 5 stored node columns.

        Output columns: nearest_hvn_above, nearest_hvn_below,
                        nearest_lvn_above, nearest_lvn_below
        """
        close = df["close"].values[:, np.newaxis]    # (n, 1)

        hvn_cols = [f"prior_hvn_{i+1}" for i in range(_MAX_NODES)]
        lvn_cols = [f"prior_lvn_{i+1}" for i in range(_MAX_NODES)]

        hvn_arr = df[hvn_cols].values   # (n, 5)
        lvn_arr = df[lvn_cols].values   # (n, 5)

        # Nearest HVN above close
        above_mask   = hvn_arr > close
        hvn_ab       = np.where(above_mask, hvn_arr, np.nan)
        df["nearest_hvn_above"] = np.nanmin(hvn_ab, axis=1)

        # Nearest HVN below close
        below_mask   = hvn_arr < close
        hvn_bl       = np.where(below_mask, hvn_arr, np.nan)
        df["nearest_hvn_below"] = np.nanmax(hvn_bl, axis=1)

        # Nearest LVN above close
        lvn_ab = np.where(lvn_arr > close, lvn_arr, np.nan)
        df["nearest_lvn_above"] = np.nanmin(lvn_ab, axis=1)

        # Nearest LVN below close
        lvn_bl = np.where(lvn_arr < close, lvn_arr, np.nan)
        df["nearest_lvn_below"] = np.nanmax(lvn_bl, axis=1)

        return df

    def _compute_price_location(self, df: pd.DataFrame) -> pd.DataFrame:
        """
        Compute signed distance metrics from current close to key reference
        levels, expressed in ATR units for instrument-agnostic comparability.

        dist_to_prior_poc = (close - prior_poc) / atr_20s
            Positive -> above POC, Negative -> below POC.
            Magnitude tells how far price has deviated from prior fair value.
        """
        atr = df["atr_20s"].fillna(df["session_atr_live"]).clip(lower=1e-9)

        df["dist_to_prior_poc"] = (
            (df["close"] - df["prior_poc"]) / atr
        )
        return df

    def _compute_live_poc(self, df: pd.DataFrame) -> pd.DataFrame:
        """
        Approximate the developing (live) POC within each RTH session.

        Method
        ------
        For each bar, assign the bar's volume to the price bin containing
        its close price (rounded to tick_size).  Maintain a cumulative
        volume-by-price dict per session.  The bin with max cumulative
        volume is the live POC estimate.

        This is a simplification of the full two-sided H-L distribution
        approach used for the prior-session profile, optimised for speed.
        It tracks where the most VOLUME has transacted (by close price),
        providing a real-time developing POC approximation.

        Non-RTH bars: NaN.
        """
        df["live_poc"]         = np.nan
        df["dist_to_live_poc"] = np.nan

        rth_mask = df["session_type"] == SessionType.RTH.value
        if not rth_mask.any():
            return df

        rth       = df.loc[rth_mask]
        tick_size = float(rth["meta_tick_size"].iloc[0])
        session_ids = sorted(rth["rth_session_id"].dropna().unique())

        live_poc_out = np.full(rth_mask.sum(), np.nan)
        idx = 0

        for sid in session_ids:
            sess = rth.loc[rth["rth_session_id"] == sid]
            closes = (sess["close"].values / tick_size).round() * tick_size
            vols   = sess["volume"].values.astype(float)
            atr_v  = sess["atr_20s"].fillna(sess["session_atr_live"]).clip(lower=1e-9).values

            vol_by_price: dict = {}
            poc_arr = np.full(len(sess), np.nan)
            current_poc = np.nan

            for i, (px, vl) in enumerate(zip(closes, vols)):
                vol_by_price[px] = vol_by_price.get(px, 0.0) + vl
                current_poc      = max(vol_by_price, key=vol_by_price.get)
                poc_arr[i]       = current_poc

            n = len(sess)
            live_poc_out[idx: idx + n] = poc_arr
            idx += n

        # Write back
        df.loc[rth_mask, "live_poc"] = live_poc_out

        atr_denom = df["atr_20s"].fillna(df["session_atr_live"]).clip(lower=1e-9)
        df["dist_to_live_poc"] = (df["close"] - df["live_poc"]) / atr_denom
        return df

    # ---- Logging ------------------------------------------------------------

    def _log_summary(self, df: pd.DataFrame) -> None:
        rth_mask = df["session_type"] == SessionType.RTH.value
        rth      = df.loc[rth_mask]
        n_sess   = rth["rth_session_id"].nunique()
        vwap_ok  = rth["vwap"].notna().sum()
        poc_ok   = rth["prior_poc"].notna().sum()
        ib_done  = rth["ib_complete"].sum()
        logger.info(
            f"[M3] sessions={n_sess} | vwap_bars={vwap_ok:,} | "
            f"poc_bars={poc_ok:,} | ib_complete_bars={ib_done:,}"
        )


