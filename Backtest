"""Trade engine for the reconstructed 'complete trade plan'.

Rules encoded from the sales page:
  entry  : on the breaker/BPR reaction bar, only if the LDC bias agrees
  stop   : 1R below/above entry
  TP1    : +1R      TP2 : +2R          ("1:2 mapped R:R")
  R      : k * ATR(14), multiplied by a session factor
           ("stop and target distances automatically tighten during Asia
             and London") -> Asia/London get a smaller R
  exit   : TP2, stop, or a time stop

Execution realism:
  * a signal on bar i is filled at the OPEN of bar i+1
  * the barrier race therefore starts on bar i+1, never on the signal bar
    (touching the level on the signal bar itself is not a fill)
  * if a bar's range spans both stop and target, the STOP is assumed first
  * one position at a time, no pyramiding
"""
import numpy as np
from numba import njit

MODE_FULL = 0   # whole position to TP2, stop at 1R
MODE_SCALE = 1  # half at TP1 then stop to breakeven, half to TP2


@njit(cache=True)
def run_trades(o, h, l, c, long_sig, short_sig, R, max_hold, mode, cost_pts,
               cooldown):
    N = len(c)
    cap = 200000
    t_entry = np.zeros(cap, np.int64)
    t_exit = np.zeros(cap, np.int64)
    t_dir = np.zeros(cap, np.int64)
    t_epx = np.zeros(cap)
    t_stop = np.zeros(cap)
    t_tp2 = np.zeros(cap)
    t_pts = np.zeros(cap)     # net points per 1 contract, cost included
    t_r = np.zeros(cap)       # net R multiple
    t_out = np.zeros(cap, np.int64)   # 2=TP2 1=TP1only 0=timeout -1=stop
    n = 0

    i = 0
    block_until = -1
    while i < N - 1:
        if i < block_until or n >= cap:
            i += 1
            continue
        d = 0
        if long_sig[i]:
            d = 1
        elif short_sig[i]:
            d = -1
        if d == 0 or R[i] <= 0 or not np.isfinite(R[i]):
            i += 1
            continue

        e = i + 1                      # fill at next bar's open
        px = o[e]
        r = R[i]
        stop = px - d * r
        tp1 = px + d * r
        tp2 = px + d * 2.0 * r

        half_done = False
        realized = 0.0                 # weighted points, gross
        cur_stop = stop
        out = 0
        j = e
        end = min(N - 1, e + max_hold)
        while j <= end:
            hi = h[j]
            lo = l[j]
            if d == 1:
                hit_stop = lo <= cur_stop
                hit_tp1 = hi >= tp1
                hit_tp2 = hi >= tp2
            else:
                hit_stop = hi >= cur_stop
                hit_tp1 = lo <= tp1
                hit_tp2 = lo <= tp2

            if mode == MODE_FULL:
                if hit_stop:
                    realized = d * (cur_stop - px)
                    out = -1
                    break
                if hit_tp2:
                    realized = 2.0 * r
                    out = 2
                    break
            else:
                if not half_done:
                    if hit_stop:
                        realized = d * (cur_stop - px)
                        out = -1
                        break
                    if hit_tp2:            # ran straight through both
                        realized = 0.5 * r + 0.5 * 2.0 * r
                        out = 2
                        break
                    if hit_tp1:
                        half_done = True
                        realized += 0.5 * r
                        cur_stop = px      # breakeven
                        out = 1
                else:
                    if hit_stop:
                        realized += 0.5 * d * (cur_stop - px)
                        out = 1
                        break
                    if hit_tp2:
                        realized += 0.5 * 2.0 * r
                        out = 2
                        break
            j += 1

        if out == 0 or (mode == MODE_SCALE and out == 1 and j > end):
            jj = min(j, N - 1)
            rem = 1.0 if not half_done else 0.5
            realized += rem * d * (c[jj] - px)
            j = jj

        net = realized - cost_pts
        t_entry[n] = e; t_exit[n] = j; t_dir[n] = d; t_epx[n] = px
        t_stop[n] = stop; t_tp2[n] = tp2
        t_pts[n] = net; t_r[n] = net / r; t_out[n] = out
        n += 1
        i = j + 1
        block_until = j + 1 + cooldown

    return (t_entry[:n], t_exit[:n], t_dir[:n], t_epx[:n], t_stop[:n],
            t_tp2[:n], t_pts[:n], t_r[:n], t_out[:n])


def stats(r, pts, dollars_per_point=2.0, label=""):
    """Summary of a trade list. `r` = net R multiples, `pts` = net points."""
    n = len(r)
    if n == 0:
        return dict(label=label, n=0, avg_r=np.nan, wr=np.nan, t=np.nan,
                    pf=np.nan, total_usd=0.0, avg_usd=np.nan)
    wins = r > 0
    gp = pts[pts > 0].sum()
    gl = -pts[pts < 0].sum()
    sd = r.std(ddof=1) if n > 1 else np.nan
    t = r.mean() / (sd / np.sqrt(n)) if n > 1 and sd > 0 else np.nan
    return dict(
        label=label, n=int(n), avg_r=float(r.mean()), wr=float(wins.mean()),
        t=float(t), pf=float(gp / gl) if gl > 0 else np.inf,
        total_usd=float(pts.sum() * dollars_per_point),
        avg_usd=float(pts.mean() * dollars_per_point),
    )


def fmt(s):
    if s["n"] == 0:
        return f"{s['label']:<34} n=0"
    return (f"{s['label']:<34} n={s['n']:>6}  avgR={s['avg_r']:+.4f}  "
            f"WR={s['wr']*100:5.1f}%  t={s['t']:+6.2f}  PF={s['pf']:.3f}  "
            f"${s['avg_usd']:+7.2f}/tr  ${s['total_usd']:+11,.0f}")

