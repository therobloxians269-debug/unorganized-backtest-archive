        print("   " + "  ".join(f"[{'PASS' if v else 'FAIL'}] {k}" for k, v in gates))
    print("\nYEAR BY YEAR")
    for Y, s in (gp - toll).groupby((gp - toll).index.year):
        print(f"  {Y}  n={len(s):>4}  net/tr={s.mean():+.3f}  tot={s.sum()*V_PT:>+8,.0f}$  "
              f"hit={100*(s>0).mean():>3.0f}%")


