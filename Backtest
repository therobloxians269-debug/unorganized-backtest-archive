    return is_, oos


def cost_variant(tr, mult):
    """Re-price commission+slippage. Base already has 1x baked; approximate
    scaling by adjusting per-leg drag. We rebuild drag = mult*base."""
    if len(tr) == 0:
        return tr
    t = tr.copy()
    # base drag per trade ~ n_legs*(commission + entry/exit slippage).
    # entry slippage 1 tick + exit slippage(stop/eod) already in prices; here we
    # add/remove commission & a slippage proxy = n_legs * (COMM + 2*tickval) * (mult-1)
    per_leg = S.COMMISSION_RT + 2 * S.TICK_VAL
    t["pnl_usd"] = t["pnl_usd"] - (mult - 1.0) * t["n_legs"] * per_leg
    return t


