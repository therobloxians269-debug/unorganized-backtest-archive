def run_mes_strategy(symbol='MES=F', initial_balance=1000.0):
    # Download Historical Data (Last 2 years, Hourly)
    df = yf.download(symbol, period='730d', interval='1h', auto_adjust=True)
    if isinstance(df.columns, pd.MultiIndex):
        df.columns = df.columns.get_level_values(0)
 
    # Indicator Calculations
    df['Log_Ret'] = np.log(df['Close'] / df['Close'].shift(1))
    tr = pd.concat([
        (df['High'] - df['Low']),
        abs(df['High'] - df['Close'].shift()),
        abs(df['Low'] - df['Close'].shift())
    ], axis=1).max(axis=1)
 
    df['ATR'] = tr.rolling(14).mean()
    df['Signal_Score'] = (
        df['Log_Ret'].rolling(20).mean() / df['Log_Ret'].rolling(20).std()
    ).shift(1)
    df['Lagged_ATR'] = df['ATR'].shift(1)
    df['Hour_UTC'] = df.index.hour
    df.dropna(inplace=True)
 
    # Strategy Parameters
    bal = initial_balance
    commission = 1.40
    slippage_pts = 0.25
    multiplier = 5.0
    signal_threshold = 0.4
    risk_per_trade = 0.015
    atr_exit_mult = 3.5
 
    history = []
    trade_log = []  # Track individual trades for PnL annotation on the plot
    pos, ent, qty = 0, 0.0, 0
    entry_idx = None
 
    # Backtest Engine
    for i in range(len(df)):
        p = df['Close'].values[i]
        s = df['Signal_Score'].values[i]
        atr = df['Lagged_ATR'].values[i]
        hour = df['Hour_UTC'].values[i]
 
        open_pnl = 0.0
        if pos != 0:
            pnl_pts = (p - ent) if pos == 1 else (ent - p)
            open_pnl = pnl_pts * multiplier * qty
 
            # Exit on signal reversal or volatility-based stop/target
            exit_triggered = (
                (pos == 1 and s < -0.1) or
                (pos == -1 and s > 0.1) or
                (abs(pnl_pts) > atr_exit_mult * atr)
            )
 
            if exit_triggered:
                realized_pnl = (pnl_pts * multiplier * qty) - (qty * commission)
                bal += realized_pnl
 
                direction = "LONG" if pos == 1 else "SHORT"
                trade_log.append({
                    'exit_time': df.index[i],
                    'exit_price': p,
                    'realized_pnl': realized_pnl,
                    'balance_after': bal,
                    'direction': direction
                })
 
                log_to_file(
                    f"EXIT_{direction}", p, round(realized_pnl, 2), round(bal, 2)
                )
 
                print(
                    f"❌ [{df.index[i].strftime('%Y-%m-%d %H:%M')}] EXIT {direction} @ {p:.2f} | "
                    f"PnL: ${realized_pnl:,.2f} | Balance: ${bal:,.2f}"
                )
 
                pos, open_pnl = 0, 0.0
 
        # Entry Logic (US Session window)
        if pos == 0 and (14 <= hour <= 20):
            if abs(s) > signal_threshold:
                qty = max(1, int((bal * risk_per_trade) / (atr * multiplier)))
                pos = 1 if s > signal_threshold else -1
                ent = p + slippage_pts if pos == 1 else p - slippage_pts
                entry_idx = i
 
                direction = "LONG" if pos == 1 else "SHORT"
                log_to_file(
                    f"ENTRY_{direction}", round(ent, 2), 0.0, round(bal, 2)
                )
 
        # Live dashboard row during backtest replay
        pnl_color = "🟩" if open_pnl > 0 else ("🟥" if open_pnl < 0 else "⚪")
        if i % 50 == 0:  # Print every 50 bars to avoid flooding the console
            print(
                f"⏱️ [{df.index[i].strftime('%Y-%m-%d %H:%M')}] | "
                f"Price: {p:<8.2f} | Signal: {s:>5.2f} | "
                f"Pos: {pos:>2} | Entry: {ent:<8.2f} | "
                f"Open PnL: {pnl_color} ${open_pnl:,.2f}"
            )
 
        history.append(bal)
 
    equity_curve = pd.Series(history, index=df.index)
    return equity_curve, pd.DataFrame(trade_log)
 
 
