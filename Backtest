"""New direction: CRYPTO time-series trend (long/flat) -- high-vol, high-return, and the one
asset class a $1,000 account can actually trade with diversification (fractional, 24/7, no
PDT, no shorting needed).

Multi-timescale (30/60/120d) vol-normalized tanh trend, LONG-ONLY (cash in downtrends),
inverse-vol sized across a basket of large coins, portfolio vol-targeted, net of cost.
Reports CAGR / vol / Sharpe / maxDD, per-year, and the gauntlet -- vs buy-and-hold BTC, so
the value of trend (avoiding the -80% bears) is visible. Honest on regime-dependence +
survivorship (uses coins that exist today).

    PYTHONPATH=. python3 research/crypto_trend.py
"""
from __future__ import annotations

import numpy as np
import pandas as pd

from ope.validation import deflated_sharpe_ratio, perf_stats, probabilistic_sharpe_ratio

COINS = ["BTC-USD", "ETH-USD", "BNB-USD", "XRP-USD", "ADA-USD", "SOL-USD", "DOGE-USD",
         "DOT-USD", "AVAX-USD", "LINK-USD", "LTC-USD", "BCH-USD", "ATOM-USD", "XLM-USD",
         "ETC-USD"]
ANN = 365.0                      # crypto trades every day
LOOKS, VOL_WIN, VOL_TGT, CAP = (30, 60, 120), 30, 0.35, 3.0
COST_BP = 25.0                   # one-way bps (retail crypto: fees + spread)
OOS = "2023-01-01"


def maxdd(r):
    eq = (1 + r).cumprod()
    return float((eq / eq.cummax() - 1).min())


def main():
    import yfinance as yf
    px = yf.download(COINS, start="2017-01-01", auto_adjust=True, progress=False)["Close"]
    px = px.dropna(how="all").dropna(axis=1, thresh=int(len(px) * 0.25))
    rets = px.pct_change()
    av = (rets.rolling(VOL_WIN).std() * np.sqrt(ANN)).shift(1)
    z = sum(px.pct_change(L) / (av * np.sqrt(L / ANN)) for L in LOOKS) / len(LOOKS)
    sig = np.tanh(z).clip(lower=0.0)                      # LONG/FLAT only
    w = (sig / av).shift(1)
    w = w.div(w.abs().sum(axis=1).replace(0, np.nan), axis=0).fillna(0.0)
    g = (w * rets).sum(axis=1)
    scale = (VOL_TGT / (g.rolling(VOL_WIN).std() * np.sqrt(ANN))).shift(1).clip(0, CAP).fillna(0.0)
    w = w.mul(scale, axis=0)
    turn = w.diff().abs().sum(axis=1)
    net = ((w * rets).sum(axis=1) - turn * COST_BP * 1e-4).dropna()
    gross = (w * rets).sum(axis=1).reindex(net.index)
    bh = rets["BTC-USD"].reindex(net.index)              # buy & hold BTC benchmark

    yrs = (net.index[-1] - net.index[0]).days / 365.25
    s = perf_stats(net, periods_per_year=int(ANN))
    print(f"CRYPTO TREND (long/flat, {px.shape[1]} coins, {net.index[0].date()} -> "
          f"{net.index[-1].date()}, {yrs:.1f}y)\n")
    print(f"  NET   CAGR {((1+net).prod()**(1/yrs)-1)*100:6.1f}% | vol {net.std()*np.sqrt(ANN)*100:4.0f}% "
          f"| Sharpe {s['sharpe']:.2f} | maxDD {maxdd(net)*100:5.1f}% | turn {turn.mean()*ANN:.0f}x")
    sg = perf_stats(gross, periods_per_year=int(ANN))
    print(f"  GROSS Sharpe {sg['sharpe']:.2f} (cost drag {((gross.mean()-net.mean())*ANN)*100:.1f}%/yr)")
    print(f"  vs BTC buy&hold: CAGR {((1+bh).prod()**(1/yrs)-1)*100:6.1f}% | "
          f"maxDD {maxdd(bh)*100:5.1f}% | Sharpe {perf_stats(bh,periods_per_year=int(ANN))['sharpe']:.2f}")
    psr1 = probabilistic_sharpe_ratio(net, 1.0 / np.sqrt(ANN))
    srvar = max(np.var([s["sharpe"], sg["sharpe"]]) / ANN, 1e-6)
    print(f"  OOS>=2023 Sharpe {perf_stats(net[net.index>=OOS],periods_per_year=int(ANN))['sharpe']:.2f} | "
          f"PSR>0 {probabilistic_sharpe_ratio(net,0)*100:.0f}% | PSR>1.0 {psr1*100:.0f}% | "
          f"DSR@N15 {deflated_sharpe_ratio(net,srvar,15)*100:.0f}%")

    print("\n  per-year (trend net / BTC buy&hold):")
    yr_n = net.groupby(net.index.year).apply(lambda x: (1 + x).prod() - 1)
    yr_b = bh.groupby(bh.index.year).apply(lambda x: (1 + x).prod() - 1)
    for y in yr_n.index:
        print(f"    {y}   trend {yr_n[y]*100:+7.1f}%   |   BTC {yr_b.get(y, float('nan'))*100:+7.1f}%")

    # vol-target frontier: dial exposure to respect a 30% DD budget (unit-vol base series)
    base = net / (net.std() * np.sqrt(ANN))
    print("\n  vol-target frontier (scale the SAME signal to hit your <=30% DD budget):")
    for vt in (0.15, 0.20, 0.25, 0.35):
        r = base * vt
        cagr = (1 + r).prod() ** (1 / yrs) - 1
        flag = "  <-- ~30% DD budget" if -0.34 < maxdd(r) < -0.26 else ""
        print(f"    vol {vt*100:2.0f}%: CAGR {cagr*100:5.1f}% | realized vol {r.std()*np.sqrt(ANN)*100:2.0f}% "
              f"| maxDD {maxdd(r)*100:5.1f}% | Sharpe {r.mean()/r.std()*np.sqrt(ANN):.2f}{flag}")


if __name__ == "__main__":
    main()

