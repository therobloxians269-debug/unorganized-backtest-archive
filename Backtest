#!/usr/bin/env python3
"""
fam_orb.py -- OPENING RANGE BREAKOUT family on NQ/MNQ, exhaustively.

Anchors : 18:00 (day-cycle open), 00:00 (London), 06:00 (NY-am QT open), 09:30 (RTH)
Windows : 5/15/30/60 min opening range
Modes   : breakout, breakout-retest, failed-breakout fade
Stops   : opposite OR side, 0.5x OR width, 1.0x OR width
Targets : 1R/1.5R/2R/3R, 1x/2x OR width, OR-width trail, time-exit only
Filters : OR width vs causal ATR, OR volume vs 20d causal mean, gap direction,
          day of week, causal NQ-vs-ES SSMT at the breakout, prior-day close position

SPLITS   IS   = nq_v5 2023-01-01 .. 2024-12-31
         OOS1 = nq_v5 2025-01-01 ..
         OOS2 = mnq_v5 (all)   -- never tuned on

COSTS    NQ : pv=20, $4.00 RT commission, 0.25pt adverse slippage on entry and on
              every MARKET exit (stop exits and time exits). Limit target fills get
              no slippage. Commission in points = 4/20 = 0.20.
         MNQ: pv=2,  $1.50 RT commission, same slippage. Commission pts = 1.50/2 = 0.75.
         NOTE: MNQ is MORE expensive in POINTS than NQ (1.25 pt vs 0.70 pt round turn).
         Because the user trades 1 micro, every result is ALSO recomputed with micro
         costs on the NQ splits ("micro-cost" columns) -- that is the honest apples-to-
         apples number.

FILLS    Entry is always the OPEN of the bar AFTER the signal bar. Never a signal-bar
         close. Stop and target inside the same 1-min bar -> STOP fills first.
         Long stop exit fills at min(stop, bar open) - slip (gap-through honoured).
         Long limit target fills at the target price exactly (no gap improvement).

APEX     Universal flatten at the 15:59 ET bar (cycle_min 1319). Well inside the
         16:59 hard flat. No overnight carry across the flatten.
"""

import numpy as np
import pandas as pd
import itertools, json, os, sys, time, warnings

warnings.filterwarnings("ignore")
pd.set_option("display.width", 250)
pd.set_option("display.max_columns", 60)

DATA = "/Users/kaveh/qt_cascade/"
OUT = "/Users/kaveh/qt_cascade/"

SLIP = 0.25                     # points, adverse, entry + market exits
NQ_PV, NQ_COMM = 20.0, 4.00     # $/pt, $ round turn
MNQ_PV, MNQ_COMM = 2.0, 1.50
NQ_COMM_PTS = NQ_COMM / NQ_PV       # 0.20 pt
MNQ_COMM_PTS = MNQ_COMM / MNQ_PV    # 0.75 pt

FLAT_CM = 1319                  # cycle-minute of the 15:59 ET bar -> forced flat
MIN_RISK_PTS = 3.0              # below this the 1.25pt cost floor dominates
MAX_RISK_PTS = 400.0

# anchor cycle-minutes
ANCH = {"1800": 0, "0000": 360, "0600": 720, "0930": 930}

RETEST_WIN = 60                 # bars allowed for the retest after a breakout
FADE_WIN = 30                   # bars allowed for the close-back-inside failure
ENTRY_WIN_DEFAULT = 360         # minutes after OR end during which entries are allowed


# ----------------------------------------------------------------------------- loading
def cycle_min(idx):
    m = idx.hour.values * 60 + idx.minute.values
    return np.where(m >= 1080, m - 1080, m + 360).astype(np.int32)


def load_split(name):
    if name == "OOS2":
        df = pd.read_parquet(DATA + "mnq_v5.parquet")
    else:
        df = pd.read_parquet(DATA + "nq_v5.parquet")
        if name == "IS":
            df = df[(df.index >= "2023-01-01") & (df.index < "2025-01-01")]
        elif name == "OOS1":
            df = df[df.index >= "2025-01-01"]
    return df


def build_days(df, name):
    """Return (days, glob) where days is a list of per-day-cycle dicts and glob holds
    contiguous arrays for the whole split (used by the random-time placebo)."""
    df = df.sort_index()
    cm = cycle_min(df.index)
    o = df["o"].values.astype(np.float64)
    h = df["h"].values.astype(np.float64)
    l = df["l"].values.astype(np.float64)
    c = df["c"].values.astype(np.float64)
    v = df["v"].values.astype(np.float64)
    esh = df["es_high"].values.astype(np.float64)
    esl = df["es_low"].values.astype(np.float64)
    dc = np.asarray(df["daycycle"].values)
    ts = df.index.values.astype("datetime64[ns]")

    # day-cycle boundaries
    change = np.empty(len(dc), dtype=bool)
    change[0] = True
    change[1:] = dc[1:] != dc[:-1]
    starts = np.flatnonzero(change)
    ends = np.append(starts[1:], len(dc))

    glob = dict(ts=ts, o=o, h=h, l=l, c=c, cm=cm, day_id=np.zeros(len(dc), np.int32))

    days = []
    for k, (s, e) in enumerate(zip(starts, ends)):
        glob["day_id"][s:e] = k
        d = dict(
            k=k, dc=dc[s], s=s, e=e, n=e - s,
            cm=cm[s:e], o=o[s:e], h=h[s:e], l=l[s:e], c=c[s:e], v=v[s:e],
            esh=esh[s:e], esl=esl[s:e], ts=ts[s:e],
        )
        # forced-flat bar index (last bar with cm <= FLAT_CM)
        ok = np.flatnonzero(d["cm"] <= FLAT_CM)
        d["flat_i"] = int(ok[-1]) if len(ok) else -1
        days.append(d)

    # ---- causal per-day features (all use PRIOR cycles only, or intra-cycle history)
    cyc_hi = np.array([d["h"].max() for d in days])
    cyc_lo = np.array([d["l"].min() for d in days])
    cyc_rng = cyc_hi - cyc_lo
    # prior-14-cycle mean range, known at the cycle open
    pr = pd.Series(cyc_rng).shift(1).rolling(14, min_periods=5).mean().values
    # prior RTH (09:30-15:59) stats
    rth_rng, rth_close, rth_pos = [], [], []
    for d in days:
        m = (d["cm"] >= 930) & (d["cm"] <= FLAT_CM)
        if m.sum() < 30:
            rth_rng.append(np.nan); rth_close.append(np.nan); rth_pos.append(np.nan)
            continue
        hh, ll = d["h"][m].max(), d["l"][m].min()
        cc = d["c"][m][-1]
        rth_rng.append(hh - ll)
        rth_close.append(cc)
        rth_pos.append((cc - ll) / (hh - ll) if hh > ll else 0.5)
    rth_rng = np.array(rth_rng); rth_close = np.array(rth_close); rth_pos = np.array(rth_pos)
    prev_rth_close = np.roll(rth_close, 1); prev_rth_close[0] = np.nan
    prev_rth_pos = np.roll(rth_pos, 1); prev_rth_pos[0] = np.nan
    prev_rth_rng20 = pd.Series(rth_rng).shift(1).rolling(20, min_periods=5).mean().values

    for k, d in enumerate(days):
        d["atr_prior"] = pr[k]
        d["prev_close"] = prev_rth_close[k]
        d["prev_pos"] = prev_rth_pos[k]
        d["rth_rng20"] = prev_rth_rng20[k]
        # RTH gap = 09:30 open - prior RTH close  (known at 09:30)
        j = np.flatnonzero(d["cm"] >= 930)
        d["gap"] = (d["o"][j[0]] - d["prev_close"]) if (len(j) and np.isfinite(d["prev_close"])) else np.nan
        # weekday of the RTH date (i.e. of the 09:30 bar); fall back to cycle date+1
        if len(j):
            d["dow"] = int(pd.Timestamp(d["ts"][j[0]]).dayofweek)
        else:
            d["dow"] = int(pd.Timestamp(d["ts"][0]).dayofweek)
    return days, glob


# ------------------------------------------------------------------- OR construction
def make_or(d, anchor_cm, W):
    """Opening range over [anchor, anchor+W) cycle-minutes. Returns dict or None."""
    m = (d["cm"] >= anchor_cm) & (d["cm"] < anchor_cm + W)
    if m.sum() < max(3, W // 3):        # need real coverage of the window
        return None
    hi = d["h"][m].max(); lo = d["l"][m].min()
    if not np.isfinite(hi) or not np.isfinite(lo) or hi <= lo:
        return None
    idx = np.flatnonzero(m)
    return dict(
        hi=hi, lo=lo, w=hi - lo, vol=d["v"][m].sum(),
        end_i=int(idx[-1]),
        es_hi=np.nanmax(d["esh"][m]), es_lo=np.nanmin(d["esl"][m]),
    )


# --------------------------------------------------------------------- entry signals
def gen_signals(d, anchor_cm, W, mode, entry_win=ENTRY_WIN_DEFAULT):
    """Return list of signal dicts. At most one per OR side.
    Each: dict(sig_i, ent_i, dirn, orh, orl, orw, ref_stop, esconf)
    ent_i is the bar whose OPEN we trade. All indices are day-local."""
    orr = make_or(d, anchor_cm, W)
    if orr is None:
        return []
    lo_i = orr["end_i"] + 1
    hi_cm = min(anchor_cm + W + entry_win, FLAT_CM - 15)
    scan = np.flatnonzero((np.arange(d["n"]) > orr["end_i"]) & (d["cm"] <= hi_cm))
    if len(scan) < 5:
        return []
    a, b = int(scan[0]), int(scan[-1])
    H = d["h"][a:b + 1]; L = d["l"][a:b + 1]; C = d["c"][a:b + 1]; O = d["o"][a:b + 1]
    ORH, ORL, ORW = orr["hi"], orr["lo"], orr["w"]

    up = H > ORH
    dn = L < ORL
    t_up = a + int(np.argmax(up)) if up.any() else None
    t_dn = a + int(np.argmax(dn)) if dn.any() else None

    # if both sides breached in the SAME bar, resolve to the level nearer that bar's open
    if t_up is not None and t_dn is not None and t_up == t_dn:
        op = d["o"][t_up]
        if abs(op - ORH) <= abs(op - ORL):
            t_dn = None
        else:
            t_up = None

    sigs = []
    for t, side in ((t_up, +1), (t_dn, -1)):
        if t is None or t >= b:
            continue
        lvl = ORH if side > 0 else ORL
        if mode == "brk":
            sig_i = t
            ent_i = t + 1
            ref = ORL if side > 0 else ORH
            dirn = side
        elif mode == "ret":
            # wait for a pull-back that touches the broken level, within RETEST_WIN bars,
            # invalidated if the OPPOSITE OR side breaks first
            j0, j1 = t + 1, min(t + RETEST_WIN, b)
            if j1 <= j0:
                continue
            seg_l = d["l"][j0:j1 + 1]; seg_h = d["h"][j0:j1 + 1]
            if side > 0:
                touch = seg_l <= ORH
                inval = seg_l < ORL
            else:
                touch = seg_h >= ORL
                inval = seg_h > ORH
            if not touch.any():
                continue
            jt = int(np.argmax(touch))
            ji = int(np.argmax(inval)) if inval.any() else 10**9
            if ji < jt:
                continue
            sig_i = j0 + jt
            ent_i = sig_i + 1
            ref = ORL if side > 0 else ORH
            dirn = side
        elif mode == "fade":
            # failed breakout: a bar CLOSES back inside the OR within FADE_WIN bars
            j0, j1 = t, min(t + FADE_WIN, b)
            if j1 <= j0:
                continue
            seg_c = d["c"][j0:j1 + 1]
            back = (seg_c < ORH) if side > 0 else (seg_c > ORL)
            if not back.any():
                continue
            jb = j0 + int(np.argmax(back))
            if jb >= b:
                continue
            sig_i = jb
            ent_i = jb + 1
            # reference stop = the extreme reached during the failed push
            if side > 0:
                ref = d["h"][t:jb + 1].max()
            else:
                ref = d["l"][t:jb + 1].min()
            dirn = -side
        else:
            raise ValueError(mode)

        if ent_i > b or ent_i >= d["n"]:
            continue
        # causal SSMT at the breakout bar: did ES confirm the NQ breakout?
        if side > 0:
            esconf = 1 if (np.isfinite(orr["es_hi"]) and d["esh"][t] > orr["es_hi"]) else 0
        else:
            esconf = 1 if (np.isfinite(orr["es_lo"]) and d["esl"][t] < orr["es_lo"]) else 0

        sigs.append(dict(sig_i=sig_i, ent_i=ent_i, dirn=dirn, orh=ORH, orl=ORL,
                         orw=ORW, orvol=orr["vol"], ref=ref, esconf=esconf,
                         brk_side=side, brk_i=t))
    sigs.sort(key=lambda s: s["ent_i"])
    return sigs


# ------------------------------------------------------------------------ simulation
def _exit_fixed(h, l, o, i0, i1, dirn, stop_px, tgt_px):
    """Return (exit_i, exit_px_raw, reason). Stop wins ties inside a bar."""
    H = h[i0:i1 + 1]; L = l[i0:i1 + 1]; O = o[i0:i1 + 1]
    if dirn > 0:
        hs = L <= stop_px
        ht = H >= tgt_px if np.isfinite(tgt_px) else np.zeros(len(H), bool)
    else:
        hs = H >= stop_px
        ht = L <= tgt_px if np.isfinite(tgt_px) else np.zeros(len(H), bool)
    is_ = int(np.argmax(hs)) if hs.any() else 10**9
    it_ = int(np.argmax(ht)) if ht.any() else 10**9
    if is_ == 10**9 and it_ == 10**9:
        return i1, None, "time"
    if is_ <= it_:
        # gap-through honoured
        px = min(stop_px, O[is_]) if dirn > 0 else max(stop_px, O[is_])
        return i0 + is_, px, "stop"
    return i0 + it_, tgt_px, "target"


def _exit_trail(h, l, o, i0, i1, dirn, stop_px, trail_d):
    """OR-width trailing stop. Level at bar i uses only bars <= i-1 (no lookahead)."""
    H = h[i0:i1 + 1]; L = l[i0:i1 + 1]; O = o[i0:i1 + 1]
    n = len(H)
    if dirn > 0:
        run = np.maximum.accumulate(H)
        prev = np.empty(n); prev[0] = O[0]; prev[1:] = run[:-1]
        lvl = np.maximum(stop_px, prev - trail_d)
        hit = L <= lvl
    else:
        run = np.minimum.accumulate(L)
        prev = np.empty(n); prev[0] = O[0]; prev[1:] = run[:-1]
        lvl = np.minimum(stop_px, prev + trail_d)
        hit = H >= lvl
    if not hit.any():
        return i1, None, "time"
    i = int(np.argmax(hit))
    px = min(lvl[i], O[i]) if dirn > 0 else max(lvl[i], O[i])
    return i0 + i, px, "stop"


def run_day(d, sigs, stop_mode, tgt_mode, max_hold, max_trades, filt=None):
    """Simulate up to max_trades sequential trades from the given signals."""
    out = []
    last_exit = -1
    for s in sigs:
        if len(out) >= max_trades:
            break
        if s["ent_i"] <= last_exit:
            continue
        ei = s["ent_i"]
        if ei >= d["n"] or d["flat_i"] < 0 or ei >= d["flat_i"]:
            continue
        dirn = s["dirn"]
        raw_entry = d["o"][ei]
        entry = raw_entry + dirn * SLIP

        # ---- stop
        if stop_mode == "opp":
            stop = s["ref"]
        elif stop_mode == "w050":
            stop = entry - dirn * 0.5 * s["orw"]
        elif stop_mode == "w100":
            stop = entry - dirn * 1.0 * s["orw"]
        else:
            raise ValueError(stop_mode)
        risk = dirn * (entry - stop)
        if not np.isfinite(risk) or risk < MIN_RISK_PTS or risk > MAX_RISK_PTS:
            continue

        # ---- optional filters (stage 2)
        if filt is not None and not filt(d, s, risk):
            continue

        # ---- target
        trail_d = None
        if tgt_mode.startswith("R"):
            tgt = entry + dirn * float(tgt_mode[1:]) * risk
        elif tgt_mode.startswith("W"):
            tgt = entry + dirn * float(tgt_mode[1:]) * s["orw"]
        elif tgt_mode.startswith("T"):
            tgt = np.nan
            trail_d = float(tgt_mode[1:]) * s["orw"]
        elif tgt_mode == "NONE":
            tgt = np.nan
        else:
            raise ValueError(tgt_mode)

        i1 = min(d["flat_i"], ei + max_hold) if max_hold is not None else d["flat_i"]
        if i1 <= ei:
            continue
        if trail_d is not None:
            xi, xpx, why = _exit_trail(d["h"], d["l"], d["o"], ei, i1, dirn, stop, trail_d)
        else:
            xi, xpx, why = _exit_fixed(d["h"], d["l"], d["o"], ei, i1, dirn, stop, tgt)
        if why == "time":
            xpx = d["c"][xi]
        # slippage on every market exit (stop + time), none on limit target
        xadj = xpx - dirn * SLIP if why in ("stop", "time") else xpx
        gpts = dirn * (xadj - entry)

        out.append(dict(
            k=d["k"], dc=d["dc"], ts=d["ts"][ei], ent_i=ei, exit_i=xi, dirn=dirn,
            entry=entry, stop=stop, risk=risk, gpts=gpts, why=why,
            hold=int(xi - ei), orw=s["orw"], esconf=s["esconf"],
            atr=d["atr_prior"], gap=d["gap"], dow=d["dow"], prev_pos=d["prev_pos"],
            orvol=s["orvol"], rth20=d["rth_rng20"],
        ))
        last_exit = xi
    return out


# ---------------------------------------------------------------------- P&L / stats
def score(trades, pv, comm_pts, ndays):
    if len(trades) == 0:
        return dict(n=0, tpd=0.0, avgR=np.nan, wr=np.nan, dpt=np.nan, tot=0.0,
                    dd_micro=np.nan, drop3=np.nan, avgR_micro=np.nan, dpt_micro=np.nan)
    g = np.array([t["gpts"] for t in trades])
    r = np.array([t["risk"] for t in trades])
    netp = g - comm_pts
    R = netp / r
    usd = netp * pv
    # micro-equivalent (what the user actually trades) regardless of split instrument
    netp_m = g - MNQ_COMM_PTS
    usd_m = netp_m * MNQ_PV
    eq = np.cumsum(usd_m)
    dd = float(np.max(np.maximum.accumulate(np.concatenate([[0.0], eq])) -
                      np.concatenate([[0.0], eq])))
    srt = np.sort(R)[::-1]
    drop3 = float(np.mean(srt[3:])) if len(srt) > 3 else np.nan
    return dict(n=len(trades), tpd=len(trades) / max(ndays, 1), avgR=float(R.mean()),
                wr=float((netp > 0).mean()), dpt=float(usd.mean()), tot=float(usd.sum()),
                dd_micro=dd, drop3=drop3,
                avgR_micro=float((netp_m / r).mean()), dpt_micro=float(usd_m.mean()),
                medrisk=float(np.median(r)), tstat=float(R.mean() / (R.std(ddof=1) / np.sqrt(len(R)))) if len(R) > 2 and R.std(ddof=1) > 0 else np.nan)


# ------------------------------------------------------------------------- the sweep
STOPS = ["opp", "w050", "w100"]
TGTS = ["R1.0", "R1.5", "R2.0", "R3.0", "W1.0", "W2.0", "T0.75", "T1.5", "NONE"]
MODES = ["brk", "ret", "fade"]
AW = [("0930", 5), ("0930", 15), ("0930", 30), ("0930", 60),
      ("0600", 15), ("0600", 30), ("0600", 60),
      ("1800", 30), ("1800", 60),
      ("0000", 30), ("0000", 60)]
HOLDS = [180, None]
MAXT = [1, 2]


def sweep(days, pv, comm_pts, tag, entry_win=ENTRY_WIN_DEFAULT, filt=None, verbose=True):
    nd = len(days)
    rows = []
    t0 = time.time()
    for (anm, W) in AW:
        acm = ANCH[anm]
        for mode in MODES:
            sig_cache = [gen_signals(d, acm, W, mode, entry_win) for d in days]
            for stop_mode in STOPS:
                for tgt_mode in TGTS:
                    for hold in HOLDS:
                        for mt in MAXT:
                            tr = []
                            for d, sg in zip(days, sig_cache):
                                if sg:
                                    tr.extend(run_day(d, sg, stop_mode, tgt_mode, hold, mt, filt))
                            s = score(tr, pv, comm_pts, nd)
                            s.update(anchor=anm, W=W, mode=mode, stop=stop_mode,
                                     tgt=tgt_mode, hold=(hold if hold else 9999), mt=mt,
                                     ew=entry_win)
                            rows.append(s)
        if verbose:
            print(f"  [{tag}] anchor {anm} W={W} done  {time.time()-t0:.0f}s  rows={len(rows)}",
                  flush=True)
    return pd.DataFrame(rows)


def run_cfg(days, cfg, pv, comm_pts, filt=None, ret_trades=False):
    acm = ANCH[cfg["anchor"]]
    hold = None if cfg["hold"] >= 9999 else int(cfg["hold"])
    tr = []
    for d in days:
        sg = gen_signals(d, acm, int(cfg["W"]), cfg["mode"], int(cfg.get("ew", ENTRY_WIN_DEFAULT)))
        if sg:
            tr.extend(run_day(d, sg, cfg["stop"], cfg["tgt"], hold, int(cfg["mt"]), filt))
    s = score(tr, pv, comm_pts, len(days))
    return (s, tr) if ret_trades else s


# ------------------------------------------------------------------ random-time placebo
def placebo(trades, glob, pv, comm_pts, ndays, seeds=8, lo=120, hi=1440):
    """Rebuild each real trade at a randomly shifted timestamp: same direction, same
    risk in points, same target/hold geometry, entering at the open of the first bar
    at/after (real entry time + U(lo,hi) minutes). Forced flat at that bar's cycle end."""
    if len(trades) == 0:
        return []
    ts, O, H, L, C, CM = glob["ts"], glob["o"], glob["h"], glob["l"], glob["c"], glob["cm"]
    dayid = glob["day_id"]
    N = len(ts)
    # per-day flat index lookup
    ndays_g = dayid[-1] + 1
    flat_of = np.full(ndays_g, -1, np.int64)
    for k in range(ndays_g):
        pass
    # vectorised: last bar with cm<=FLAT_CM per day
    ok = CM <= FLAT_CM
    idx = np.arange(N)
    tmp = np.where(ok, idx, -1)
    flat_of = pd.Series(tmp).groupby(dayid).max().values

    res = []
    for sd in range(seeds):
        rng = np.random.default_rng(1000 + sd)
        out = []
        for t in trades:
            off = int(rng.integers(lo, hi + 1))
            tgt_ts = np.datetime64(pd.Timestamp(t["ts"]) + pd.Timedelta(minutes=off))
            j = int(np.searchsorted(ts, tgt_ts, "left"))
            if j >= N - 5:
                continue
            fi = int(flat_of[dayid[j]])
            if fi <= j + 1:
                continue
            dirn = t["dirn"]
            entry = O[j] + dirn * SLIP
            risk = t["risk"]
            stop = entry - dirn * risk
            tmode = t["tgt_mode"]
            trail_d = None
            if tmode.startswith("R"):
                tg = entry + dirn * float(tmode[1:]) * risk
            elif tmode.startswith("W"):
                tg = entry + dirn * float(tmode[1:]) * t["orw"]
            elif tmode.startswith("T"):
                tg = np.nan; trail_d = float(tmode[1:]) * t["orw"]
            else:
                tg = np.nan
            i1 = min(fi, j + t["max_hold"]) if t["max_hold"] is not None else fi
            if i1 <= j:
                continue
            if trail_d is not None:
                xi, xpx, why = _exit_trail(H, L, O, j, i1, dirn, stop, trail_d)
            else:
                xi, xpx, why = _exit_fixed(H, L, O, j, i1, dirn, stop, tg)
            if why == "time":
                xpx = C[xi]
            xadj = xpx - dirn * SLIP if why in ("stop", "time") else xpx
            out.append(dict(gpts=dirn * (xadj - entry), risk=risk, dirn=dirn))
        res.append(score(out, pv, comm_pts, ndays))
    return res


def tag_trades(tr, cfg):
    hold = None if cfg["hold"] >= 9999 else int(cfg["hold"])
    for t in tr:
        t["tgt_mode"] = cfg["tgt"]
        t["max_hold"] = hold
    return tr


