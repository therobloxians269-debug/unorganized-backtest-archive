#!/usr/bin/env python3
"""SIGMABLOCK — two rejection blocks, one bullish one bearish. Python mirror of
SigmaBlock.pine.

Not a trade plan. No entry, stop, target, R:R or win rate. Two zones per session,
each bounded by an exact TOP TICK and BOTTOM TICK, scored on four legs:

  OPTIONS FLOW  real dealer gamma from gexlab. A block only scores here if the
                aggregate book is net LONG gamma and the tick sits in a positive
                gamma concentration -- there the desk buys dips and sells rallies
                to stay hedged, so its own flow leans back into the zone.
  ORDER FLOW    intrabar aggressor split from 1m bars inside each chart bar.
                Absorption (effort/result) + cumulative-delta divergence at the
                extreme + the aggressive side being trapped.
  STDEV         volume-weighted VWAP sigma envelope, session-anchored. Location
                only -- a statistical extreme of THIS session.
  GEOMETRY      the tick itself: wick dominance, local extremity, volume.

The scoring is identical to the Pine, term for term, so a block found here is the
block the chart draws.

    python3 sigmablock.py                       # latest session, live options row
    python3 sigmablock.py --bars ~/x.parquet    # any 1m OHLCV parquet/csv
    python3 sigmablock.py --tf 5 --days 5
    python3 sigmablock.py --no-options          # geometry + order flow only
"""
from __future__ import annotations

import argparse
import os
import subprocess
import sys

import numpy as np
import pandas as pd

GEXLAB = os.path.expanduser("~/gexlab")
DEF_BARS = os.path.join(GEXLAB, "data", "px", "nq_1m.parquet")
ROW_FILE = os.path.join(GEXLAB, "data", "blocks_row.txt")

SES_START, SES_END = "09:30", "16:00"
M_EXT = 1.75
EXT_LEN = 10
WICK_MIN = 0.45
VOL_MULT = 1.10
MIN_SCORE = 2.00
TICK = 0.25
CONFIRM_MIN = 60   # minutes into session before a side may read CONFIRMED (10:30 = 64.0%)
MAX_W_ATR = 0.50   # a block wider than half the 5m ATR is not a tick, it is a range

FIELDS = ["date", "spot", "netgex", "flip", "kernel", "voloi", "pin",
          "bull_lo", "bull_hi", "bull_entry", "bull_stop", "bull_target", "bull_rr",
          "bear_lo", "bear_hi", "bear_entry", "bear_stop", "bear_target", "bear_rr"]


# ── options row ────────────────────────────────────────────────────────────
def options_row(live: bool = True) -> dict | None:
    raw = None
    if live:
        try:
            r = subprocess.run([sys.executable, "blocks.py", "--pine"], cwd=GEXLAB,
                               capture_output=True, text=True, timeout=240)
            if r.returncode == 0 and r.stdout.strip():
                raw = r.stdout.strip().splitlines()[-1].strip()
        except Exception:
            raw = None
    if raw is None and os.path.exists(ROW_FILE):
        with open(ROW_FILE) as f:
            txt = [ln.strip() for ln in f if ln.strip()]
        raw = txt[-1] if txt else None
    if not raw:
        return None
    p = raw.replace(" ", "").split(",")
    if len(p) < len(FIELDS):
        return None
    d = {k: float(v) for k, v in zip(FIELDS, p[:len(FIELDS)])}
    d["date"] = int(d["date"])
    return d


# ── bars ───────────────────────────────────────────────────────────────────
def load_bars(path: str) -> pd.DataFrame:
    df = pd.read_parquet(path) if path.endswith(".parquet") else pd.read_csv(path, index_col=0, parse_dates=True)
    df.columns = [c.lower() for c in df.columns]
    ren = {"o": "open", "h": "high", "l": "low", "c": "close", "v": "volume"}
    df = df.rename(columns={k: v for k, v in ren.items() if k in df.columns})
    need = ["open", "high", "low", "close", "volume"]
    missing = [c for c in need if c not in df.columns]
    if missing:
        raise SystemExit(f"missing columns {missing} in {path}")
    if not isinstance(df.index, pd.DatetimeIndex):
        raise SystemExit("index must be a DatetimeIndex")
    if df.index.tz is None:
        df.index = df.index.tz_localize("America/New_York")
    else:
        df.index = df.index.tz_convert("America/New_York")
    return df[need].sort_index()


def to_tf(m1: pd.DataFrame, tf: int, of_mode: str = "ltf") -> pd.DataFrame:
    """Chart bars plus an aggressor split.

    ltf  intrabar polarity of the 1m bars inside each chart bar. Closest thing to
         a real aggressor split without tick data.
    clv  close-location value of the chart bar alone: ((C-L)-(H-C))/range * volume.
         No intrabar data of any kind. This is the mode to use for parity with a
         TradingView plan that does not serve seconds/tick resolution.
    """
    up = (m1["close"] > m1["open"]).astype(float)
    dn = (m1["close"] < m1["open"]).astype(float)
    fl = 1.0 - up - dn
    m1 = m1.assign(bvol=m1["volume"] * (up + fl * 0.5),
                   svol=m1["volume"] * (dn + fl * 0.5))
    g = m1.resample(f"{tf}min", label="left", closed="left")
    out = g.agg(open=("open", "first"), high=("high", "max"), low=("low", "min"),
                close=("close", "last"), volume=("volume", "sum"),
                bvol=("bvol", "sum"), svol=("svol", "sum"))
    out = out.dropna(subset=["open"])

    # ── TICK REFINEMENT ─────────────────────────────────────────────────────
    # The block is NOT the chart bar. It is the wick of the 1m bar that actually
    # printed the extreme tick — the prices that traded and were immediately
    # refused. Measured over 248 NQ sessions, median width:
    #     full 5m bar range   40.8 pts = 1.50x ATR   <- what a fat box looks like
    #     5m wick only        12.0 pts = 0.44x ATR
    #     1m bar at the tick   6.0 pts = 0.22x ATR   <- this
    body_lo = m1[["open", "close"]].min(axis=1)
    body_hi = m1[["open", "close"]].max(axis=1)

    # groupby on the floored index rather than resample: resample manufactures
    # empty bins across the overnight gap and idxmin raises on an all-NA group.
    gb = m1.groupby(m1.index.floor(f"{tf}min"))

    def far_edge(idx_of_extreme, body):
        s = pd.Series(body.reindex(idx_of_extreme.to_numpy()).to_numpy(),
                      index=idx_of_extreme.index)
        return s.reindex(out.index)

    # ATR for the width cap is computed across sessions and SHIFTED, so a huge
    # 09:30 bar cannot inflate the cap it is itself measured against.
    out["atr"] = (out["high"] - out["low"]).rolling(14, min_periods=3).mean().shift(1)
    out["atr"] = out["atr"].bfill()
    out["bull_tick"] = out["low"]
    out["bear_tick"] = out["high"]
    out["bull_far"] = far_edge(gb["low"].idxmin(), body_lo).fillna(out[["open", "close"]].min(axis=1))
    out["bear_far"] = far_edge(gb["high"].idxmax(), body_hi).fillna(out[["open", "close"]].max(axis=1))

    if of_mode == "clv":
        rng = (out["high"] - out["low"]).clip(lower=TICK)
        clv = ((out["close"] - out["low"]) - (out["high"] - out["close"])) / rng
        out["bvol"] = out["volume"] * (1.0 + clv) / 2.0
        out["svol"] = out["volume"] * (1.0 - clv) / 2.0
    return out


# ── the engine ─────────────────────────────────────────────────────────────
def session_frame(d: pd.DataFrame) -> pd.DataFrame:
    d = d.between_time(SES_START, SES_END).copy()
    if d.empty:
        return d
    v = d["volume"].clip(lower=1.0)
    tp = (d["high"] + d["low"] + d["close"]) / 3.0
    cv, cpv, cp2v = v.cumsum(), (tp * v).cumsum(), (tp * tp * v).cumsum()
    d["vwap"] = cpv / cv
    d["sd"] = np.sqrt(np.maximum(cp2v / cv - d["vwap"] ** 2, 0.0))
    d["dev"] = np.where(d["sd"] > TICK, (d["close"] - d["vwap"]) / d["sd"].replace(0, np.nan), 0.0)

    d["delta"] = d["bvol"] - d["svol"]
    d["cdelta"] = d["delta"].cumsum()
    d["davg"] = d["delta"].abs().rolling(20, min_periods=1).mean()

    d["rng"] = (d["high"] - d["low"]).clip(lower=TICK)
    d["effres"] = d["delta"].abs() / (d["rng"] / TICK)
    d["effavg"] = d["effres"].rolling(20, min_periods=1).mean()

    d["upwk"] = (d["high"] - d[["open", "close"]].max(axis=1)) / d["rng"]
    d["dnwk"] = (d[["open", "close"]].min(axis=1) - d["low"]) / d["rng"]
    d["vavg"] = d["volume"].rolling(20, min_periods=1).mean()

    d["newlo"] = d["low"] <= d["low"].rolling(EXT_LEN, min_periods=1).min()
    d["newhi"] = d["high"] >= d["high"].rolling(EXT_LEN, min_periods=1).max()
    # a bar that sets the running session extreme is always a candidate, wick or
    # not — that tick IS the session's bottom/top tick, so a side can never be
    # left with nothing to offer.
    d["seslo"] = d["low"] <= d["low"].cummin()
    d["seshi"] = d["high"] >= d["high"].cummax()
    d["cdlo"] = d["cdelta"] <= d["cdelta"].rolling(EXT_LEN, min_periods=1).min()
    d["cdhi"] = d["cdelta"] >= d["cdelta"].rolling(EXT_LEN, min_periods=1).max()
    return d


def score(r, bull: bool, opt: dict | None) -> dict:
    # OPTIONS
    s_opt = 0.0
    if opt is not None and opt["netgex"] > 0:
        lo, hi = (opt["bull_lo"], opt["bull_hi"]) if bull else (opt["bear_lo"], opt["bear_hi"])
        if r.low <= hi and r.high >= lo:
            s_opt = 2.0
        elif (r.close > opt["flip"]) if bull else (r.close < opt["flip"]):
            s_opt = 0.5
    # ORDER FLOW
    s_of = 0.0
    if r.volume > 0:
        ab = min(r.effres / r.effavg, 3.0) if r.effavg > 0 else 0.0
        s_of += ab * 0.5
        div = (r.newlo and not r.cdlo) if bull else (r.newhi and not r.cdhi)
        s_of += 1.0 if div else 0.0
        trapped = (r.delta < 0) if bull else (r.delta > 0)
        mag = min(abs(r.delta) / r.davg, 2.0) if r.davg > 0 else 0.0
        s_of += mag * 0.5 if trapped else 0.0
    # STDEV — scaled on the measured candidate distribution (923 NQ sessions,
    # 2,274 candidate ticks): median |dev| 1.22, p75 1.73, p90 2.13. Clearing the
    # envelope is worth 0 at p75, 0.5 at p90, and caps at 2.0 like the options leg.
    s_sd = min(max(abs(r.dev) - M_EXT, 0.0) / 0.40, 4.0) * 0.5
    if (r.dev >= 0) if bull else (r.dev <= 0):
        s_sd = 0.0
    # GEOMETRY
    vq = min(r.volume / r.vavg, 3.0) if r.vavg > 0 else 1.0
    s_ge = (r.dnwk if bull else r.upwk) * 1.0 + vq * 0.25
    return {"opt": s_opt, "of": s_of, "sd": s_sd, "geo": s_ge,
            "total": s_opt + s_of + s_sd + s_ge}


def bounds(r, bull: bool):
    """The block: anchored on the exact tick, extending only to the body edge of
    the 1m bar that printed it, and never wider than MAX_W_ATR x ATR. The tick
    never moves — the far edge is what gets pulled in."""
    cap = max(r.atr * MAX_W_ATR, TICK * 2)
    if bull:
        tk = r.bull_tick
        far = min(max(r.bull_far, tk + TICK), tk + cap)
        return tk, far
    tk = r.bear_tick
    far = max(min(r.bear_far, tk - TICK), tk - cap)
    return far, tk


def session_blocks(d: pd.DataFrame, opt: dict | None):
    """The two blocks, anchored on the SESSION EXTREMES — measured, not chosen.

    Why the extreme and not the best-scoring wick: over 764 NQ sessions the tick of
    a score-selected interior rejection block was the day's extreme only 9-13% of
    the time. The running session extreme was 27% (10:30) → 89% (15:55). Scoring
    was dragging the tick away from the one thing it had to be.

    Which side to trust is decided by σ-position, not by the score:
        price above VWAP → the LOW is behind price → bullish block CONFIRMED
    That rule is right 64.0% (10:30) → 90.6% (14:00), against a ceiling of 79.6% →
    98.0%. Adding the confluence score to it made it WORSE (−1.2pp at 11:00,
    −0.9pp at 13:00), so the score does not select anything here — it annotates.
    """
    if d.empty:
        return None, None
    last = d.iloc[-1]
    dev = float(last["dev"])
    # stdev picks the SIDE, time gates the CONFIRMATION. |dev| alone cannot gate:
    # at 09:35 sigma is tiny so any threshold clears instantly and accuracy is only
    # the 31-43% base rate.
    open_t = d.index[0].replace(hour=9, minute=30, second=0, microsecond=0)
    armed = (d.index[-1] - open_t).total_seconds() / 60.0 >= CONFIRM_MIN
    out = []
    for bull in (True, False):
        i = d["low"].idxmin() if bull else d["high"].idxmax()
        r = d.loc[i]
        bot, top = bounds(r, bull)
        s = score(r, bull, opt)
        confirmed = armed and ((dev > 0) if bull else (dev < 0))
        out.append({"time": i, "top": top, "bot": bot,
                    "tick": bot if bull else top,
                    "confirmed": bool(confirmed), "dev": dev, **s})
    return out[0], out[1]


def blocks_for(d: pd.DataFrame, opt: dict | None):
    found = {True: [], False: []}
    for r in d.itertuples():
        vol_ok = r.volume >= r.vavg * VOL_MULT if r.vavg > 0 else True
        cand = []
        if r.seslo or (vol_ok and r.newlo and r.dnwk >= WICK_MIN and r.close > r.low + r.rng * 0.25):
            cand.append(True)
        if r.seshi or (vol_ok and r.newhi and r.upwk >= WICK_MIN and r.close < r.high - r.rng * 0.25):
            cand.append(False)
        # One bar may serve both sides, and that is fine now: the bull block is
        # [low, body_low] and the bear block is [body_high, high] — the two wicks,
        # separated by the body, never the same box. The 116-pt opening-bar
        # collapse was only possible when both sides used the whole [high, low].
        for bull in cand:
            s = score(r, bull, opt)
            bot, top = bounds(r, bull)
            found[bull].append({"time": r.Index, "top": top, "bot": bot, **s})

    for k in found:
        found[k].sort(key=lambda x: -x["total"])
    return (found[True][0] if found[True] else None,
            found[False][0] if found[False] else None)


def show(day, bull, bear, opt, tf):
    print(f"\n  {day}   {tf}m bars   σ-position {(bull or bear or {}).get('dev', 0):+.2f}σ")
    if opt is None:
        print("  options: NO ROW — run  cd ~/gexlab && python3 blocks.py --pine")
    elif opt["netgex"] <= 0:
        print(f"  options: book SHORT gamma ({opt['netgex']:+.2f}bn) — zones withheld, fading is incoherent")
    else:
        print(f"  options: LONG gamma {opt['netgex']:+.2f}bn/1%   pin {opt['pin']:.2f}   flip {opt['flip']:.2f}   vol/OI {opt['voloi']:.2f}")
        print(f"           bull zone {opt['bull_lo']:.2f}..{opt['bull_hi']:.2f}    bear zone {opt['bear_lo']:.2f}..{opt['bear_hi']:.2f}")
    for name, b, tickname in (("BULLISH", bull, "bottom tick"), ("BEARISH", bear, "top tick")):
        if b is None:
            print(f"\n  {name} BLOCK\n    none")
            continue
        acc = {30: 52.5, 60: 64.0, 90: 72.8, 120: 75.7, 150: 79.8,
               180: 83.1, 240: 88.9, 300: 94.1, 360: 98.7}
        a = acc[max([k for k in acc if k <= CONFIRM_MIN], default=30)]
        state = f"CONFIRMED — measured {a:.1f}% on 764 NQ sessions" if b["confirmed"] else "live"
        print(f"\n  {name} BLOCK   [{state}]")
        print(f"    {tickname:<12} {b['tick']:.2f}")
        print(f"    zone         {b['bot']:.2f} .. {b['top']:.2f}   ({b['top'] - b['bot']:.2f} pts)")
        print(f"    printed      {b['time']:%H:%M}")
        print(f"    context      options {b['opt']:.2f}  orderflow {b['of']:.2f}  geometry {b['geo']:.2f}   (annotation only)")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--bars", default=DEF_BARS)
    ap.add_argument("--tf", type=int, default=5)
    ap.add_argument("--days", type=int, default=1)
    ap.add_argument("--no-options", action="store_true")
    ap.add_argument("--cached", action="store_true", help="use blocks_row.txt, do not hit CBOE")
    ap.add_argument("--of-mode", choices=["ltf", "clv"], default="clv",
                    help="clv = no intrabar data, matches a TradingView plan without seconds/tick")
    a = ap.parse_args()

    opt = None if a.no_options else options_row(live=not a.cached)
    m1 = load_bars(a.bars)
    bars = to_tf(m1, a.tf, a.of_mode)

    days = sorted(set(bars.index.date))[-a.days:]
    print(f"\nSIGMABLOCK — two rejection blocks   {os.path.basename(a.bars)}")
    print("no entry, no stop, no target, no win rate. geometry only.")
    for day in days:
        d = session_frame(bars[bars.index.date == day])
        if d.empty or len(d) < EXT_LEN:
            continue
        use = opt if (opt is not None and opt["date"] == int(day.strftime("%Y%m%d"))) else None
        if opt is not None and use is None:
            use = opt if day == days[-1] else None
        bull, bear = session_blocks(d, use)
        show(day, bull, bear, use, a.tf)
    print()


if __name__ == "__main__":
    main()

