"""
REALLOCATION STUDY — the HONEST lever: allocate by risk, not by capital.
No signal tuning, no lookback fitting, no universe cherry-picking (that would be overfitting).
Only re-weights the existing 4 sleeves and shows the real trade-offs + the carry mirage.

    PYTHONPATH=/Users/kaveh/mim_research python3 reallocation_study.py
"""
from __future__ import annotations
import numpy as np
import pandas as pd
from scipy.optimize import minimize
from pm_dd_pack import build, ANN
from lib_perf import perf_stats

port, j, comp, *_ = build()
# clean apples-to-apples: period where all four sleeves are live (C2 starts 2023)
act = j[j["C2"] != 0].copy()
cols = ["C1", "C2", "M", "T"]
R = act[cols]
cov = R.cov().values
vol = R.std().values

print(f"\nREALLOCATION STUDY — all-sleeves-active window {R.index[0].date()}..{R.index[-1].date()} "
      f"({len(R)/ANN:.1f}y)\n(no signals touched; only sleeve weights)\n")


def stats(w):
    r = R.values @ w
    s = perf_stats(pd.Series(r, index=R.index), ANN)
    pv = w @ cov @ w
    rc = (w * (cov @ w)) / pv if pv > 0 else np.zeros_like(w)   # % risk contribution
    return s, rc


def erc(cap_carry=None):
    """equal risk contribution; optional cap on summed carry (C1+C2) weight."""
    def obj(w):
        pv = w @ cov @ w
        rc = (w * (cov @ w)) / pv
        return ((rc - 1 / len(w)) ** 2).sum()
    cons = [{"type": "eq", "fun": lambda w: w.sum() - 1}]
    if cap_carry is not None:
        cons.append({"type": "ineq", "fun": lambda w: cap_carry - (w[0] + w[1])})
    res = minimize(obj, np.repeat(0.25, 4), bounds=[(0.01, 0.97)] * 4,
                   constraints=cons, method="SLSQP")
    return res.x


schemes = {
    "capital 35/25/15/25": np.array([0.35, 0.25, 0.15, 0.25]),
    "inverse-vol":         (1 / vol) / (1 / vol).sum(),
    "risk-parity (ERC)":   erc(),
    "ERC, carry<=60%":     erc(cap_carry=0.60),
}

