# ---------- SSMT state table ----------
def smt_state(df, tf, L=2, R=2, ref='either'):
    """Persistent bullish/bearish SMT state at timeframe tf, like the SSMT table rows.
       bearish active from divergence until NQ closes back above the pivot high."""
    r=rs(df,tf); h=r['h'].values; l=r['l'].values; c=r['c'].values
    eh=r['es_high'].values; el=r['es_low'].values
    yh=r['ym_high'].values; yl=r['ym_low'].values
    n=len(r); ts=r.index
    ph=np.zeros(n,bool); pl=np.zeros(n,bool)
    for i in range(L,n-R):
        if h[i]==max(h[i-L:i+R+1]) and h[i]>h[i-1] and h[i]>h[i+R]: ph[i]=True
        if l[i]==min(l[i-L:i+R+1]) and l[i]<l[i-1] and l[i]<l[i+R]: pl[i]=True
    bear=np.zeros(n,bool); bull=np.zeros(n,bool)
    last_ph=-1; last_pl=-1; bear_inval=np.nan; bull_inval=np.nan
    bs=False; bl=False
    for j in range(n):
        k=j-R
        if k>=0 and ph[k]: last_ph=k
        if k>=0 and pl[k]: last_pl=k
        if bs and c[j]>bear_inval: bs=False
        if bl and c[j]<bull_inval: bl=False
        if last_ph>=0 and j>last_ph and h[j]>h[last_ph]:
            f_es=eh[j]<=eh[last_ph]; f_ym=yh[j]<=yh[last_ph]
            ok={'either':f_es or f_ym,'es':f_es,'ym':f_ym,'both':f_es and f_ym}[ref]
            if ok: bs=True; bear_inval=h[j]
        if last_pl>=0 and j>last_pl and l[j]<l[last_pl]:
            f_es=el[j]>=el[last_pl]; f_ym=yl[j]>=yl[last_pl]
            ok={'either':f_es or f_ym,'es':f_es,'ym':f_ym,'both':f_es and f_ym}[ref]
            if ok: bl=True; bull_inval=l[j]
        bear[j]=bs; bull[j]=bl
    s=pd.DataFrame({f'bear{tf}':bear,f'bull{tf}':bull},index=ts)
    return s.reindex(df.index,method='ffill').fillna(False)

def add_bias(df, tfs=(1440,240,90)):
    for tf in tfs:
        df=df.join(smt_state(df,tf))
    return df

