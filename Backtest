nq=pd.read_parquet('nq_v3.parquet'); mnq=pd.read_parquet('mnq_v3.parquet')
def arrs3(df):
    return dict(o=df['o'].values,h=df['h'].values,l=df['l'].values,day=df['daycycle'].values,
                sess=df['sess'].values,mq=df['min_into_q90'].values,
                bs=df['bear_score'].values,us=df['bull_score'].values)
def sim(df,sig,A,minscore=0,tmso_gate=0,max_stop=15.,buf=2.,tp2_R=6.,max_hold=1440,
        max_trades_day=2,point_val=20.,comm=4.,slip_ticks=1.,tick=.25):
    o,h,l=A['o'],A['h'],A['l']; day,mq=A['day'],A['mq']; bs,us=A['bs'],A['us']
    n=len(o); slip=slip_ticks*tick; tr=[];used={};busy=-1
    I,D,Ar=sig['i'].values,sig['d'].values,sig['arm_i'].values
    for x in range(len(I)):
        i,d,a=int(I[x]),int(D[x]),int(Ar[x])
        if i<=busy or i+1>=n: continue
        if tmso_gate and mq[i]>tmso_gate: continue
        if minscore and ((bs[i] if d==-1 else us[i])<minscore): continue
        k=day[i]
        if used.get(k,0)>=max_trades_day: continue
        stop=(max(h[a:i+1].max(),h[i])+buf) if d==-1 else (min(l[a:i+1].min(),l[i])-buf)
        entry=o[i+1]+(-slip if d==-1 else slip); risk=abs(stop-entry)
        if risk>max_stop or risk<1.0: continue
        t2=entry-tp2_R*risk if d==-1 else entry+tp2_R*risk
        j,w=race(h,l,i+1,stop,t2,d,max_hold)
        if w=='tgt': r=tp2_R*risk
        elif w=='stop': r=-(risk+slip)
        else: px=o[j]; r=(entry-px if d==-1 else px-entry)-slip
        net=r*point_val-comm
        tr.append((df.index[i+1],d,risk,w,net,net/(risk*point_val)))
        used[k]=used.get(k,0)+1; busy=j
    return pd.DataFrame(tr,columns=['t','d','risk','why','pnl','R'])

