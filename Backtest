         "N": 7, "Q": 8, "U": 9, "V": 10, "X": 11, "Z": 12}
PAT = re.compile(r"^(.*?)([FGHJKMNQUVXZ])(\d)$")


def main():
    ROOTS = {"ES", "NQ", "ZN", "ZF", "ZB", "CL", "NG", "GC", "HG", "SI", "ZC", "ZS", "6E", "6J"}
    df = pd.read_parquet(SRC)
