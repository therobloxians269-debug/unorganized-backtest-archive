import pandas as pd, numpy as np, warnings; warnings.filterwarnings('ignore')
from nwog import find_nwog, inside_nwog, fvg4h

def prep(df):
    nw=find_nwog(df); df=inside_nwog(df,nw,keep=5); g=fvg4h(df)
    return df,g

def run(df,g,entry_mode='market',min_rr=0.0,limit_wait=120,buf=2.0,max_stop=80.,min_stop=3.,
        max_hold=1440,flat_min=1019,point_val=20.,comm=4.,slip_ticks=1.,tick=.25,
        one_per_gap=True,dol_mode='near'):
    o,h,l,c=df['o'].values,df['h'].values,df['l'].values,df['c'].values
    ins=df['in_nwog'].values; ce=df['nwog_ce'].values
    glo=df['nwog_lo'].values; ghi=df['nwog_hi'].values
    bm,bd=df['bear_m90'].values,df['bear_daily'].values
    um,ud=df['bull_m90'].values,df['bull_daily'].values
    mod=(df.index.hour*60+df.index.minute).values
    idx=df.index; n=len(df); slip=slip_ticks*tick
    gk=g['known'].values; gb=g['bot'].values; gt=g['top'].values
    sig_short=ins&bm&bd; sig_long=ins&um&ud
    out=[]; busy=-1; last_key=None
    for i in range(1,n-2):
        if i<=busy or mod[i]>=flat_min: continue
        s = sig_short[i] and not sig_short[i-1]
        L = sig_long[i]  and not sig_long[i-1]
        if not (s or L): continue
        d = -1 if s else 1
        key=(glo[i],ghi[i],d)
        if one_per_gap and key==last_key: continue
        # ---- entry price by mode (the variable under test)
        if entry_mode=='market':
            ep=o[i+1]+(-slip if d==-1 else slip); j0=i+1
        else:
            if entry_mode=='ce':      lim=ce[i]
            elif entry_mode=='edge':  lim=ghi[i] if d==-1 else glo[i]
            elif entry_mode=='half':  lim=(c[i]+(ghi[i] if d==-1 else glo[i]))/2
            else: raise ValueError(entry_mode)
            if np.isnan(lim): continue
            # already beyond the limit at trigger -> would fill immediately, treat as market
            if (d==-1 and c[i]>=lim) or (d==1 and c[i]<=lim):
                ep=o[i+1]+(-slip if d==-1 else slip); j0=i+1
            else:
                j0=None
                for q in range(i+1,min(i+1+limit_wait,n)):
                    if mod[q]>=flat_min: break
                    if (d==-1 and h[q]>=lim) or (d==1 and l[q]<=lim): j0=q; break
                if j0 is None:
                    out.append(dict(t=idx[i],d=d,filled=False,R=0.0,pnl=0.0,risk=np.nan,
                                    why='no_fill',bars=0)); last_key=key; continue
                ep=lim
        # ---- stop beyond the gap edge
        st = (max(ghi[i],h[i])+buf) if d==-1 else (min(glo[i],l[i])-buf)
        risk=abs(st-ep)
        if risk>max_stop or risk<min_stop:
            out.append(dict(t=idx[i],d=d,filled=False,R=0.0,pnl=0.0,risk=risk,
                            why='stop_bad',bars=0)); last_key=key; continue
        # ---- target = nearest unfilled 4h FVG (DOL)
        m=gk<=idx[i].to_datetime64()
        if d==1:
            cand=gb[m & (gb>ep)]; tgt=cand.min() if len(cand) else np.nan
        else:
            cand=gt[m & (gt<ep)]; tgt=cand.max() if len(cand) else np.nan
        if np.isnan(tgt):
            out.append(dict(t=idx[i],d=d,filled=False,R=0.0,pnl=0.0,risk=risk,
                            why='no_dol',bars=0)); last_key=key; continue
        if abs(tgt-ep)/risk < min_rr:
            out.append(dict(t=idx[i],d=d,filled=False,R=0.0,pnl=0.0,risk=risk,
                            why='rr_low',bars=0)); last_key=key; continue
        # ---- race
        why='time'; px=None
        for j in range(j0+1,min(j0+1+max_hold,n)):
            if mod[j]>=flat_min: px=o[j]+(slip if d==-1 else -slip); why='flat'; break
            if (h[j]>=st) if d==-1 else (l[j]<=st): px=st+(slip if d==-1 else -slip); why='stop'; break
            if (l[j]<=tgt) if d==-1 else (h[j]>=tgt): px=tgt; why='dol'; break
        if px is None: j=min(j0+max_hold,n-1); px=o[j]+(slip if d==-1 else -slip)
        pts=(ep-px) if d==-1 else (px-ep); net=pts*point_val-comm
        out.append(dict(t=idx[j0],d=d,filled=True,R=net/(risk*point_val),pnl=net,risk=risk,
                        why=why,bars=j-j0,rr=abs(tgt-ep)/risk))
        busy=j; last_key=key
    return pd.DataFrame(out)

def rep(t,pv=20.,lab=''):
    if len(t)==0: return f'{lab:26s} no signals'
    f=t[t.filled]
    if len(f)<3: return f'{lab:26s} sig={len(t):3d} fills={len(f)}'
    pf=f.pnl[f.pnl>0].sum()/max(1e-9,-f.pnl[f.pnl<0].sum())
    per_sig=f.pnl.sum()/len(t)
    return (f'{lab:26s} sig={len(t):3d} fill={len(f)/len(t)*100:4.0f}% WR={(f.pnl>0).mean()*100:4.1f}% '
            f'medRR={f.rr.median():4.1f} avgR={f.R.mean():+.3f} $/fill={f.pnl.mean():+7.1f} '
            f'$/signal={per_sig:+7.1f} PF={pf:4.2f} net=${f.pnl.sum():+7.0f}')

