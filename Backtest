"""Does the VECM/CARR range forecast sharpen the calibrated quantile fan?
Fan currently normalises by ADR(14). Swap in a proper conditional range forecast."""
import numpy as np, pandas as pd, pickle, warnings; warnings.filterwarnings('ignore')
from sklearn.linear_model import QuantileRegressor
SCR='/private/tmp/claude-501/-Users-kaveh/d5ce5738-dd59-4ca2-bd9c-e9b02fe3107c/scratchpad'
esday,esrth,nqday,nqrth=pickle.load(open(f'{SCR}/ladder_feats.pkl','rb'))
QS=[0.20,0.40,0.60,0.80,0.90,0.95]

def addfc(D):
    X=D.copy()
    lr=np.log(X.rng)
    # HAR-style range forecast (Corsi) on log range: daily + weekly + monthly, all lagged
    X['lr1']=lr.shift(1); X['lr5']=lr.shift(1).rolling(5).mean(); X['lr22']=lr.shift(1).rolling(22).mean()
    return X.dropna(subset=['lr1','lr5','lr22'])

for D,rth,tag,tr_end in [(esday,esrth,'ES',2017),(nqday,nqrth,'NQ',2024)]:
    X=addfc(D)
    TR=X[X.index.year<=tr_end]; TE=X[X.index.year>tr_end]
    A=TR[['lr1','lr5','lr22']].values; A=np.c_[A,np.ones(len(A))]
    b=np.linalg.lstsq(A,np.log(TR.rng.values),rcond=None)[0]
    B=np.c_[X[['lr1','lr5','lr22']].values,np.ones(len(X))]
    X['fc']=np.exp(B@b)                      # HAR conditional range forecast
    TR=X[X.index.year<=tr_end]; TE=X[X.index.year>tr_end]
    print(f'=== {tag}  train {len(TR)}  test {len(TE)} ===')
    print(f'  range forecast corr with realised:  ADR(14) {TR.ADR.corr(TR.rng):+.3f} (train) / '
          f'{TE.ADR.corr(TE.rng):+.3f} (test)   |   HAR {TE.fc.corr(TE.rng):+.3f} (test)')
    F=['f_onlo','f_onhi','f_gap','f_pdr','f_dow']
    for norm in ['ADR','fc']:
        tr=TR.copy(); te=TE.copy()
        for c in ['f_onlo','f_onhi','f_gap']:      # renormalise the features too
            tr[c]=tr[c]*tr.ADR/tr[norm]; te[c]=te[c]*te.ADR/te[norm]
        ylo_tr=(tr.o930-tr.lo)/tr[norm]; ylo_te=(te.o930-te.lo)/te[norm]
        cov=[]
        widths=[]
        for q in QS:
            mm=QuantileRegressor(quantile=q,alpha=0.0,solver='highs').fit(tr[F].values,ylo_tr.values)
            p=np.maximum(mm.predict(te[F].values),0.03)
            cov.append((ylo_te.values<p).mean())
            widths.append((p*te[norm]).mean())
        cal=np.mean(np.abs(np.array(cov)-np.array(QS)))
        # sharpness: width of the q20..q80 interval in POINTS (smaller = sharper, if calibrated)
        w=widths[3]-widths[0]
        print(f'  normalise by {norm:3s}: coverage {" ".join(f"{c:.3f}" for c in cov)}  '
              f'|cal error| {cal:.4f}   q20-q80 width {w:7.2f} pts')
    print()

