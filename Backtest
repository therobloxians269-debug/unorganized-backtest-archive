"""
volume_profile.py — POC / Value Area / HVN / LVN.

Volume Profile is the auction-theory complement to ICT's order-flow narrative.
Where ICT says "price seeks liquidity", the profile says "price seeks acceptance
(HVN) and rejects thin prices (LVN)". Paired, they sharpen edges:

  * A Point of Control (POC) or Value Area edge (VAH/VAL) that lines up with a
    prior-day high/low is a *reinforced* liquidity target.
  * An FVG that sits inside a Low Volume Node (LVN) is high quality — thin prices
    get revisited and traversed quickly, which is exactly the "efficient
    delivery" ICT expects a gap to be filled with.
  * A naked/untested POC is a magnet: a clean draw-on-liquidity objective.

Profiles here are built over an explicit set of bar positions (e.g. the prior
session) so the engine can keep them causal.
"""
from __future__ import annotations

from dataclasses import dataclass, field
import numpy as np
import pandas as pd


@dataclass
class VolumeProfile:
    prices: np.ndarray      # bin centres, ascending
    volumes: np.ndarray     # volume per bin
    poc: float
    vah: float
    val: float
    bin_size: float
    _lvn_thresh: float = field(default=0.0)

    def is_lvn(self, price: float) -> bool:
        """True if `price` sits in a thin (below-average) volume node."""
        j = int(np.clip(np.searchsorted(self.prices, price), 0, len(self.prices) - 1))
        return self.volumes[j] <= self._lvn_thresh

    def in_value(self, price: float) -> bool:
        return self.val <= price <= self.vah


def build_profile(df: pd.DataFrame, positions: np.ndarray, bin_size: float,
                  value_area_pct: float = 0.70) -> VolumeProfile | None:
    """Volume-by-price over `positions`, spreading each bar across its range."""
    if len(positions) == 0:
        return None
    high = df["high"].to_numpy()[positions]
    low = df["low"].to_numpy()[positions]
    vol = df["volume"].to_numpy()[positions]

    lo, hi = float(low.min()), float(high.max())
    if hi <= lo:
        return None
    nbins = max(1, int(np.ceil((hi - lo) / bin_size)))
    edges = lo + bin_size * np.arange(nbins + 1)
    centres = (edges[:-1] + edges[1:]) / 2.0
    acc = np.zeros(nbins)

    for h, l, v in zip(high, low, vol):
        b0 = int(np.clip((l - lo) // bin_size, 0, nbins - 1))
        b1 = int(np.clip((h - lo) // bin_size, 0, nbins - 1))
        span = b1 - b0 + 1
        acc[b0:b1 + 1] += v / span  # uniform spread across the bar's range

    poc_i = int(acc.argmax())
    poc = float(centres[poc_i])

    # Grow the value area outward from the POC to `value_area_pct` of volume.
    total = acc.sum()
    target = value_area_pct * total
    lo_i = hi_i = poc_i
    covered = acc[poc_i]
    while covered < target and (lo_i > 0 or hi_i < nbins - 1):
        down = acc[lo_i - 1] if lo_i > 0 else -1
        up = acc[hi_i + 1] if hi_i < nbins - 1 else -1
        if up >= down:
            hi_i += 1
            covered += acc[hi_i]
        else:
            lo_i -= 1
            covered += acc[lo_i]
    val = float(centres[lo_i])
    vah = float(centres[hi_i])
    lvn_thresh = float(np.mean(acc) * 0.5)

    return VolumeProfile(centres, acc, poc, vah, val, bin_size, lvn_thresh)

