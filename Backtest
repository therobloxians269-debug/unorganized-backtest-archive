"""
FUTURES GAUNTLET -- batch-test NEW multi-market daily constructions in one run, net of cost,
ranked by Calmar. Different mechanisms than already-killed MA-momentum/carry/COT/reversal:
Donchian breakout, acceleration, vol-regime-filtered trend, trend x carry agreement, plus
risk-parity (beta) and the MA-trend baseline for reference.

DSR deflated for honest cumulative N (we've explored ~35 configs this session).

    python3 futures_gauntlet.py
"""
from __future__ import annotations
import numpy as np
import pandas as pd
from lib_perf import perf_stats, deflated_sharpe, maxdd

PANEL = "/Users/kaveh/mim_research/futures_panel.parquet"
ANN, VT, COST, NTRIALS = 252, 0.12, 3.0, 35
OOS = "2018-01-01"


def main():
    p = pd.read_parquet(PANEL)
    F = p.pivot_table(index="date", columns="root", values="fret").sort_index()
    K = p.pivot_table(index="date", columns="root", values="carry_ann").reindex(F.index).ffill(limit=5)
    AV = (F.rolling(63).std() * np.sqrt(ANN)).shift(1)
    P = (1 + F.fillna(0)).cumprod()

    def fin(w):
        w = w.div(w.abs().sum(axis=1).replace(0, np.nan), axis=0).clip(-0.2, 0.2)
        w = w.resample("W").last().reindex(F.index, method="ffill")
        sc = (VT / ((w * F).sum(axis=1).rolling(63).std() * np.sqrt(ANN))).shift(1).clip(0, 3).fillna(0.0)
        w = w.mul(sc, axis=0)
        return (((w * F).sum(axis=1) - w.diff().abs().sum(axis=1) * COST * 1e-4)).dropna()

    S = {}
    # baseline MA-trend (reference)
    z = sum((P / P.shift(L) - 1) / (AV * np.sqrt(L / ANN)) for L in (63, 126, 252)) / 3
    S["MA-trend 63/126/252"] = fin((np.tanh(z) / AV).shift(1))
    # Donchian breakouts (turtle): new high/low -> hold
    for n in (20, 55, 100):
        sig = pd.DataFrame(np.where(P >= P.rolling(n).max().shift(1), 1.0,
                          np.where(P <= P.rolling(n).min().shift(1), -1.0, np.nan)),
                          index=P.index, columns=P.columns).ffill()
        S[f"Donchian {n}d breakout"] = fin((sig / AV).shift(1))
    # acceleration: is momentum itself rising?
    mom = P / P.shift(63) - 1
    accel = mom - mom.shift(21)
    S["Acceleration (d-mom)"] = fin((np.sign(accel) / AV).shift(1))
    # vol-regime-filtered trend: only trade markets currently in below-median vol
    lowvol = (AV < AV.rolling(252, min_periods=60).median())
    S["Trend x low-vol filter"] = fin(((np.tanh(z) * lowvol) / AV).shift(1))
    # trend x carry agreement: position only when trend sign == carry sign
    agree = np.sign(z) == np.sign(K)
    S["Trend x carry agree"] = fin(((np.tanh(z) * agree) / AV).shift(1))
    # dual-speed crossover (fast vs slow)
    cross = (P / P.shift(21) - 1) - (P / P.shift(126) - 1)
    S["Fast-slow crossover"] = fin((np.sign(cross) / AV).shift(1))
    # risk-parity long-only (beta benchmark)
    S["Risk-parity long (beta)"] = fin((pd.DataFrame(1.0, index=F.index, columns=F.columns) / AV).shift(1))

    rows = []
    for nm, r in S.items():
        s = perf_stats(r, ANN)
        oos = perf_stats(r[r.index >= OOS], ANN)["sharpe"]
        dsr = deflated_sharpe(r, NTRIALS, np.var([s["sharpe"]]) + 0.25, ANN)
        rows.append((nm, s["calmar"], s["sharpe"], oos, s["cagr"], s["maxdd"], dsr))
    rows.sort(key=lambda x: -x[1])
    print(f"FUTURES GAUNTLET (14 mkts daily, net, vol-tgt {VT*100:.0f}%, DSR@N={NTRIALS})\n")
    print(f"  {'strategy':24s} {'Calmar':>6} {'Sharpe':>6} {'OOS18':>6} {'CAGR':>6} {'maxDD':>7} {'DSR':>5}")
    for nm, ca, sh, oo, cg, dd, ds in rows:
        print(f"  {nm:24s} {ca:6.2f} {sh:6.2f} {oo:6.2f} {cg*100:5.1f}% {dd*100:6.0f}% {ds*100:4.0f}%")
    print(f"\n  (Calmar=CAGR/|maxDD|. Bar to beat: MA-trend baseline. GO needs OOS>0, DSR>95%, beats baseline.)")


if __name__ == "__main__":
    main()

