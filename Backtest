"""
M2+M3 — Box Theory signal engine + bar-by-bar backtest on MES economics.

Rules encoded (the.rumers / Doug):
  Box            = prior RTH session high/low (from data.py).
  Edge zones     = upper/lower 20% of the box. Middle 60% = "don't dwell" no-trade.
  Qualifier      = day's opening 5m candle range must exceed 20% of box range.
  John Wick      = rejection candle at an edge: small body, long tail into the zone,
                   close back inside. Long tail down @ bottom -> LONG.
                   Long tail up   @ top    -> SHORT.
  Entry          = next 5m bar open (no lookahead) + slippage.
  Stop           = just beyond the John Wick tail (or box edge).
  Target         = 50% midline (contract A) + opposite box edge (contract B, runner).
  Flat by 15:55  = intraday only, no overnight.

MES economics: $5/point, tick 0.25 = $1.25/tick.
Costs modeled per fill: entry +1 tick adverse, stop +1 tick adverse, market/close +1 tick,
                        limit target = exact; commission $1.24 round-turn per contract.
"""
import pandas as pd
import numpy as np

# ---- MES contract economics ----
POINT = 5.0            # $ per ES/MES point
TICK  = 0.25
TICK_VAL = POINT * TICK          # $1.25
COMMISSION_RT = 1.24             # $ per contract round-turn (retail micro)
SLIP_TICKS = 1                   # adverse ticks on entry & on market/stop exits


class Params:
    def __init__(self, **kw):
        self.zone_pct       = kw.get("zone_pct", 0.20)     # edge zone size
        self.qualify_pct    = kw.get("qualify_pct", 0.20)  # opening-candle qualifier
        self.use_qualifier  = kw.get("use_qualifier", True)
        self.wick_ratio     = kw.get("wick_ratio", 1.0)    # tail >= ratio*body
        self.wick_dom       = kw.get("wick_dom", 0.5)      # tail >= dom*range
        self.stop_mode      = kw.get("stop_mode", "wick")  # 'wick' or 'box'
        self.stop_buf_ticks = kw.get("stop_buf_ticks", 1)
        self.target_mode    = kw.get("target_mode", "mid_runner")  # 'mid_runner'|'opposite'|'r_mult'
        self.r_mult         = kw.get("r_mult", 2.0)
        self.invert         = kw.get("invert", False)      # placebo: flip signal direction
        self.optimistic     = kw.get("optimistic", False)   # tie-break: target-first (best case)
        self.max_trades_day = kw.get("max_trades_day", 3)
        self.flat_by        = kw.get("flat_by", pd.Timestamp("15:55").time())
        self.entry_time_min = kw.get("entry_time_min", pd.Timestamp("09:35").time())  # no signals before this


def _wick_signal(o, h, l, c, box, p):
    """Return +1 (long), -1 (short), or 0 for a 5m candle given the day's box row."""
    rng = h - l
    if rng <= 0:
        return 0
    body = abs(c - o)
    upper = h - max(o, c)
    lower = min(o, c) - l
    # --- bullish John Wick at the BOTTOM edge ---
    if l <= box.buy_zone:                                   # stabbed into buy zone/below
        if lower >= p.wick_ratio * max(body, TICK_VAL/POINT) and lower >= p.wick_dom * rng:
            if c > box.buy_zone and c > box.box_low:        # closed back inside/above zone
                return +1
    # --- bearish John Wick at the TOP edge ---
    if h >= box.sell_zone:
        if upper >= p.wick_ratio * max(body, TICK_VAL/POINT) and upper >= p.wick_dom * rng:
            if c < box.sell_zone and c < box.box_high:
                return -1
    return 0


def _targets(direction, entry, box, stop, p):
    """List of (price, label) contract targets. Contract A first, runner second."""
    if p.target_mode == "opposite":
        tgt = box.box_high if direction > 0 else box.box_low
        return [(tgt, "opp"), (tgt, "opp")]
    if p.target_mode == "r_mult":
        r = abs(entry - stop)
        tgt = entry + direction * p.r_mult * r
        return [(tgt, "r"), (tgt, "r")]
    # default mid_runner
    opp = box.box_high if direction > 0 else box.box_low
    return [(box.mid, "mid"), (opp, "opp")]


def backtest(bars5, boxes, p: Params):
    """Bar-by-bar sim. 2-lot per trade (contract A -> target1, B -> runner target2,
    shared stop, both flat at cutoff). Returns trades DataFrame."""
    buf = p.stop_buf_ticks * TICK
    trades = []
    # group 5m bars by day
    bars5 = bars5.sort_index()
    day_groups = bars5.groupby("day")
    box_by_day = {d: r for d, r in boxes.iterrows()}

    for day, g in day_groups:
        if day not in box_by_day:
            continue
        box = box_by_day[day]
        if not np.isfinite(box.box_range) or box.box_range <= 0:
            continue
        g = g.reset_index()  # columns: et, open, high, low, close, ...
        n = len(g)
        # qualifier: opening candle range > qualify_pct * box_range
        if p.use_qualifier:
            oc = g.iloc[0]
            if (oc.high - oc.low) <= p.qualify_pct * box.box_range:
                continue

        i = 0
        n_trades = 0
        while i < n - 1 and n_trades < p.max_trades_day:
            row = g.iloc[i]
            if row.et.time() < p.entry_time_min:
                i += 1; continue
            sig = _wick_signal(row.open, row.high, row.low, row.close, box, p)
            if sig == 0:
                i += 1; continue
            if p.invert:
                sig = -sig
            direction = sig
            # enter next bar open + slippage
            ent_bar = g.iloc[i + 1]
            fill = ent_bar.open + direction * SLIP_TICKS * TICK
            # stop
            if p.stop_mode == "box":
                stop = (box.box_low - buf) if direction > 0 else (box.box_high + buf)
            else:  # wick tail of the signal candle
                stop = (row.low - buf) if direction > 0 else (row.high + buf)
            if (direction > 0 and stop >= fill) or (direction < 0 and stop <= fill):
                i += 1; continue  # degenerate stop
            tgts = _targets(direction, fill, box, stop, p)
            # walk forward from entry bar
            legs = [{"open": True, "tgt": t[0], "lbl": t[1]} for t in tgts]
            exit_rows = []
            j = i + 1
            while j < n and any(L["open"] for L in legs):
                b = g.iloc[j]
                cutoff = b.et.time() >= p.flat_by
                for L in legs:
                    if not L["open"]:
                        continue
                    hit_stop = (b.low <= stop) if direction > 0 else (b.high >= stop)
                    hit_tgt  = (b.high >= L["tgt"]) if direction > 0 else (b.low <= L["tgt"])
                    px = None; why = None
                    if hit_stop and hit_tgt:
                        if p.optimistic:
                            px = L["tgt"]; why = L["lbl"]        # best case: target first
                        else:
                            px = stop - direction * SLIP_TICKS * TICK; why = "stop"
                    elif hit_stop:
                        px = stop - direction * SLIP_TICKS * TICK; why = "stop"
                    elif hit_tgt:
                        px = L["tgt"]; why = L["lbl"]      # limit fill, no slippage
                    elif cutoff:
                        px = b.close - direction * SLIP_TICKS * TICK; why = "eod"
                    if px is not None:
                        pnl_pts = direction * (px - fill)
                        pnl_usd = pnl_pts * POINT - COMMISSION_RT
                        exit_rows.append({"why": why, "exit": px, "pnl_pts": pnl_pts,
                                          "pnl_usd": pnl_usd, "exit_t": b.et})
                        L["open"] = False
                if cutoff:
                    # force any still-open legs flat at close
                    for L in legs:
                        if L["open"]:
                            px = b.close - direction * SLIP_TICKS * TICK
                            pnl_pts = direction * (px - fill)
                            exit_rows.append({"why": "eod", "exit": px, "pnl_pts": pnl_pts,
                                              "pnl_usd": pnl_pts * POINT - COMMISSION_RT,
                                              "exit_t": b.et})
                            L["open"] = False
                    break
                j += 1
            if exit_rows:
                tot = sum(r["pnl_usd"] for r in exit_rows)
                trades.append({
                    "day": day, "entry_t": ent_bar.et, "dir": direction, "entry": fill,
                    "stop": stop, "box_range": box.box_range,
                    "pnl_usd": tot, "n_legs": len(exit_rows),
                    "exits": ",".join(r["why"] for r in exit_rows),
                    "last_exit_t": max(r["exit_t"] for r in exit_rows),
                })
                n_trades += 1
                # advance to bar after last exit
                last_t = max(r["exit_t"] for r in exit_rows)
                nxt = g.index[g.et > last_t]
                i = int(nxt[0]) if len(nxt) else n
            else:
                i += 1
    return pd.DataFrame(trades)


