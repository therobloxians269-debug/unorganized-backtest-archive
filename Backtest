#!/usr/bin/env python3
"""
brain_factory.py — a WorldQuant BRAIN alpha search machine.

Turns alpha discovery from low-hit-rate hand-picking into a volume pipeline:
  1. discover datasets (sorted by value-score / inverse crowding) for a region+universe
  2. enumerate the MATRIX data-fields inside a chosen dataset (with crowding counts)
  3. template hundreds of candidate Fast-Expression alphas across fields x operators x lookbacks
  4. batch-simulate them against BRAIN (concurrency-limited, polled)
  5. filter survivors by Sharpe / fitness / turnover, then by self-correlation to your pool
  6. log everything to results CSV, survivors bubble to the top

Credentials (your password NEVER goes in a prompt or this file):
  Preferred: create ~/.brain_credentials  containing a JSON array:  ["you@email.com","password"]
  Or set env vars: BRAIN_EMAIL=... BRAIN_PASSWORD=...

Usage:
  python3 brain_factory.py datasets --region USA --universe TOP3000 --delay 1
  python3 brain_factory.py fields   --dataset analyst4
  python3 brain_factory.py run      --dataset analyst4 --max 60 --workers 3
  python3 brain_factory.py run      --dataset analyst4 --max 200 --min-sharpe 1.25
"""
from __future__ import annotations
import argparse, csv, itertools, json, os, random, sys, time
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path

import requests

API = "https://api.worldquantbrain.com"
HERE = Path(__file__).resolve().parent
OUT = HERE / "brain_results"
OUT.mkdir(exist_ok=True)


# ----------------------------------------------------------------------------- auth
def load_credentials():
    em, pw = os.environ.get("BRAIN_EMAIL"), os.environ.get("BRAIN_PASSWORD")
    if em and pw:
        return em, pw
    f = Path.home() / ".brain_credentials"
    if f.exists():
        data = json.loads(f.read_text())
        if isinstance(data, list) and len(data) >= 2:
            return data[0], data[1]
        if isinstance(data, dict):
            return data.get("email"), data.get("password")
    sys.exit("No credentials. Create ~/.brain_credentials = [\"email\",\"password\"] "
             "or set BRAIN_EMAIL / BRAIN_PASSWORD.")


def authenticate():
    em, pw = load_credentials()
    s = requests.Session()
    r = s.post(f"{API}/authentication", auth=(em, pw), timeout=30)
    if r.status_code == 201:
        print(f"  authenticated as {em}")
        return s
    # some accounts require a biometric/persona step; surface the link
    if r.status_code == 401:
        try:
            j = r.json()
        except Exception:
            j = {}
        loc = r.headers.get("Location") or (j.get("inquiry", {}) if isinstance(j, dict) else "")
        sys.exit(f"  auth failed (401). Response: {r.text[:200]}\n"
                 f"  If your account needs biometric verification, log in once at "
                 f"platform.worldquantbrain.com, then retry. {('persona/biometric: ' + str(loc)) if loc else ''}")
    sys.exit(f"  auth failed HTTP {r.status_code}: {r.text[:200]}")


def _get(s, url, **kw):
    for attempt in range(6):
        r = s.get(url, timeout=30, **kw)
        if r.status_code == 429:
            time.sleep(2 * (attempt + 1));  continue
        return r
    return r


# ----------------------------------------------------------------------------- discovery
def list_datasets(s, region, universe, delay, instrument="EQUITY"):
    out, offset = [], 0
    while True:
        url = (f"{API}/data-sets?instrumentType={instrument}&region={region}"
               f"&universe={universe}&delay={delay}&limit=50&offset={offset}")
        r = _get(s, url)
        if r.status_code != 200:
            print(f"  data-sets HTTP {r.status_code}: {r.text[:160]}");  break
        j = r.json()
        res = j.get("results", [])
        out.extend(res)
        if len(out) >= j.get("count", 0) or not res:
            break
        offset += 50
    return out


def list_fields(s, dataset, region, universe, delay, instrument="EQUITY", types=("MATRIX",)):
    out, offset = [], 0
    while True:
        url = (f"{API}/data-fields?instrumentType={instrument}&region={region}"
               f"&universe={universe}&delay={delay}&dataset.id={dataset}&limit=50&offset={offset}")
        r = _get(s, url)
        if r.status_code != 200:
            print(f"  data-fields HTTP {r.status_code}: {r.text[:160]}");  break
        j = r.json()
        res = j.get("results", [])
        for f in res:
            if f.get("type") in types:
                out.append(f)
        if offset + 50 >= j.get("count", 0) or not res:
            break
        offset += 50
    return out


# ----------------------------------------------------------------------------- templates
LOOKBACKS = [5, 10, 22, 66, 120]
GROUPS = ["subindustry", "industry", "sector"]

def expression_templates(field, groups_ok=True):
    """Yield robust candidate expressions for one matrix field."""
    f = field
    out = []
    out += [f"rank({f})", f"-rank({f})"]
    for d in LOOKBACKS:
        out += [
            f"ts_rank({f}, {d})",
            f"-ts_rank({f}, {d})",
            f"rank(ts_delta({f}, {d}))",
            f"-rank(ts_delta({f}, {d}))",
            f"ts_delta({f}, {d}) / (ts_std_dev({f}, {d}) + 1e-6)",
            f"-ts_delta({f}, {d}) / (ts_std_dev({f}, {d}) + 1e-6)",
            f"({f} - ts_mean({f}, {d})) / (ts_std_dev({f}, {d}) + 1e-6)",
            f"-({f} - ts_mean({f}, {d})) / (ts_std_dev({f}, {d}) + 1e-6)",
            f"rank({f} - ts_mean({f}, {d}))",
        ]
    if groups_ok:
        for g in GROUPS:
            out.append(f"group_neutralize(rank({f}), {g})")
    return out


def build_candidates(fields, max_n, seed=7):
    cands = []
    for f in fields:
        cands += expression_templates(f["id"])
    random.Random(seed).shuffle(cands)
    # de-dup, cap
    seen, uniq = set(), []
    for c in cands:
        if c not in seen:
            seen.add(c);  uniq.append(c)
    return uniq[:max_n]


# ----------------------------------------------------------------------------- simulate
def sim_settings(region, universe, delay, neutralization, decay, truncation):
    return {
        "instrumentType": "EQUITY", "region": region, "universe": universe,
        "delay": delay, "decay": decay, "neutralization": neutralization,
        "truncation": truncation, "pasteurization": "ON", "unitHandling": "VERIFY",
        "nanHandling": "ON", "language": "FASTEXPR", "visualization": False,
    }


def simulate_one(s, expr, settings, poll_max=120):
    body = {"type": "REGULAR", "settings": settings, "regular": expr}
    r = s.post(f"{API}/simulations", json=body, timeout=30)
    if r.status_code == 429:
        time.sleep(5);  r = s.post(f"{API}/simulations", json=body, timeout=30)
    if r.status_code not in (200, 201):
        return {"expr": expr, "error": f"submit {r.status_code}: {r.text[:120]}"}
    loc = r.headers.get("Location")
    if not loc:
        return {"expr": expr, "error": "no Location header"}
    sim_url = loc if loc.startswith("http") else f"{API}{loc}"
    # poll
    for _ in range(poll_max):
        pr = _get(s, sim_url)
        retry = pr.headers.get("Retry-After")
        if retry:
            time.sleep(float(retry));  continue
        j = pr.json()
        status = j.get("status")
        if status in ("COMPLETE", "WARNING") or j.get("alpha"):
            aid = j.get("alpha")
            if not aid:
                return {"expr": expr, "error": f"done but no alpha id: {str(j)[:120]}"}
            return fetch_alpha(s, aid, expr)
        if status in ("ERROR", "FAIL"):
            return {"expr": expr, "error": f"sim {status}: {str(j.get('message',''))[:120]}"}
        time.sleep(2)
    return {"expr": expr, "error": "poll timeout"}


def fetch_alpha(s, aid, expr):
    r = _get(s, f"{API}/alphas/{aid}")
    if r.status_code != 200:
        return {"expr": expr, "alpha_id": aid, "error": f"fetch {r.status_code}"}
    j = r.json()
    iss = j.get("is", {}) or {}
    checks = {c.get("name"): c.get("result") for c in iss.get("checks", [])}
    return {
        "expr": expr, "alpha_id": aid,
        "sharpe": iss.get("sharpe"), "fitness": iss.get("fitness"),
        "turnover": iss.get("turnover"), "returns": iss.get("returns"),
        "drawdown": iss.get("drawdown"), "margin": iss.get("margin"),
        "longCount": iss.get("longCount"), "shortCount": iss.get("shortCount"),
        "checks": checks, "error": None,
    }


def self_correlation(s, aid):
    """Max correlation of this alpha to your existing submitted/saved pool (lower=better)."""
    r = _get(s, f"{API}/alphas/{aid}/correlations/self")
    if r.status_code != 200:
        return None
    try:
        rows = r.json().get("records", [])
        cors = [abs(row[-1]) for row in rows if isinstance(row[-1], (int, float))]
        return max(cors) if cors else 0.0
    except Exception:
        return None


# ----------------------------------------------------------------------------- run
def cmd_run(args):
    s = authenticate()
    print(f"Enumerating fields in dataset '{args.dataset}' ...")
    fields = list_fields(s, args.dataset, args.region, args.universe, args.delay)
    if not fields:
        sys.exit("  no MATRIX fields found (check --dataset id via the `fields`/`datasets` command).")
    print(f"  {len(fields)} matrix fields")
    cands = build_candidates(fields, args.max)
    print(f"Generated {len(cands)} candidate expressions (cap {args.max}).")

    settings = sim_settings(args.region, args.universe, args.delay,
                            args.neutralization, args.decay, args.truncation)
    stamp = time.strftime("%Y%m%d_%H%M%S")
    path = OUT / f"run_{args.dataset}_{stamp}.csv"
    cols = ["sharpe", "fitness", "turnover", "returns", "drawdown", "margin",
            "max_self_corr", "expr", "alpha_id", "error"]
    rows = []

    def work(expr):
        res = simulate_one(s, expr, settings)
        if not res.get("error") and res.get("sharpe") is not None:
            if abs(res["sharpe"]) >= args.min_sharpe and (res.get("fitness") or 0) >= args.min_fitness:
                res["max_self_corr"] = self_correlation(s, res["alpha_id"])
        return res

    print(f"Simulating with {args.workers} workers (Sharpe>={args.min_sharpe}, "
          f"fitness>={args.min_fitness}) ...\n")
    done = 0
    with ThreadPoolExecutor(max_workers=args.workers) as ex:
        futs = {ex.submit(work, c): c for c in cands}
        for fut in as_completed(futs):
            r = fut.result();  rows.append(r);  done += 1
            sh = r.get("sharpe")
            tag = ""
            if sh is not None and abs(sh) >= args.min_sharpe and (r.get("fitness") or 0) >= args.min_fitness:
                mc = r.get("max_self_corr")
                tag = f"  <-- KEEP (corr={mc})" if (mc is None or mc < args.max_corr) else f"  (corr {mc} too high)"
            disp = f"sh={sh:+.2f}" if isinstance(sh, (int, float)) else f"ERR {str(r.get('error'))[:40]}"
            print(f"[{done}/{len(cands)}] {disp}  {r['expr'][:70]}{tag}")

    # write sorted
    def keyfn(r):
        sh = r.get("sharpe")
        return abs(sh) if isinstance(sh, (int, float)) else -1
    rows.sort(key=keyfn, reverse=True)
    with open(path, "w", newline="") as fh:
        w = csv.DictWriter(fh, fieldnames=cols, extrasaction="ignore")
        w.writeheader()
        for r in rows:
            w.writerow(r)

    keepers = [r for r in rows if isinstance(r.get("sharpe"), (int, float))
               and abs(r["sharpe"]) >= args.min_sharpe and (r.get("fitness") or 0) >= args.min_fitness
               and (r.get("max_self_corr") is None or r["max_self_corr"] < args.max_corr)]
    print(f"\nWrote {path}")
    print(f"SURVIVORS (Sharpe>={args.min_sharpe}, fitness>={args.min_fitness}, "
          f"self-corr<{args.max_corr}): {len(keepers)}")
    for r in keepers[:15]:
        print(f"  sh={r['sharpe']:+.2f} fit={r.get('fitness')} turn={r.get('turnover')} "
              f"corr={r.get('max_self_corr')}  {r['expr']}")


def cmd_datasets(args):
    s = authenticate()
    ds = list_datasets(s, args.region, args.universe, args.delay)
    ds.sort(key=lambda d: (d.get("valueScore") or 0), reverse=True)
    print(f"\n{len(ds)} datasets for {args.region}/{args.universe} delay{args.delay} "
          f"(sorted by value-score; high score + low alphaCount = under-mined gold):\n")
    print(f"{'id':22s}{'fields':>7s}{'alphas':>8s}{'value':>7s}  name")
    print("-" * 90)
    for d in ds:
        print(f"{str(d.get('id'))[:22]:22s}{d.get('fieldCount',0):>7d}"
              f"{d.get('alphaCount',0):>8d}{(d.get('valueScore') or 0):>7.2f}  "
              f"{str(d.get('name'))[:44]}")


def cmd_fields(args):
    s = authenticate()
    fs = list_fields(s, args.dataset, args.region, args.universe, args.delay)
    fs.sort(key=lambda f: (f.get("alphaCount") or 0))
    print(f"\n{len(fs)} MATRIX fields in '{args.dataset}' (sorted by alphaCount; "
          f"low = less mined):\n")
    print(f"{'id':52s}{'alphas':>8s}{'users':>7s}  description")
    print("-" * 100)
    for f in fs:
        print(f"{str(f.get('id'))[:52]:52s}{f.get('alphaCount',0):>8d}"
              f"{f.get('userCount',0):>7d}  {str(f.get('description'))[:36]}")


def main():
    ap = argparse.ArgumentParser()
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in ("datasets", "fields", "run"):
        p = sub.add_parser(name)
        p.add_argument("--region", default="USA")
        p.add_argument("--universe", default="TOP3000")
        p.add_argument("--delay", type=int, default=1)
        if name in ("fields", "run"):
            p.add_argument("--dataset", required=True)
        if name == "run":
            p.add_argument("--max", type=int, default=60)
            p.add_argument("--workers", type=int, default=3)
            p.add_argument("--min-sharpe", type=float, default=1.25)
            p.add_argument("--min-fitness", type=float, default=1.0)
            p.add_argument("--max-corr", type=float, default=0.70)
            p.add_argument("--neutralization", default="SUBINDUSTRY")
            p.add_argument("--decay", type=int, default=4)
            p.add_argument("--truncation", type=float, default=0.08)
    args = ap.parse_args()
    {"datasets": cmd_datasets, "fields": cmd_fields, "run": cmd_run}[args.cmd](args)


if __name__ == "__main__":
    main()

