"""
THE HUNT — a real systematic pattern search. Our alphabet, our patterns.

WHAT THIS IS
    Not one hand-crafted concept. A defined universe of simple, readable price
    conditions, every single-condition and every PAIR tested, scored the same way.
    "One pattern backed by another at the same time" is exactly a pair.

THE ONE RULE THAT MAKES SEARCHING WIDE HONEST
    If you test ~700 patterns, the best one shows |t| ~ 4 BY CHANCE. So the benchmark
    is not "did this beat zero", it is "did the best pattern beat the best pattern a
    SHUFFLED market produces". That is a max-statistic permutation test: shuffle the
    forward returns within time-of-day strata, rescan all 700 patterns, record the
    best |t|, repeat. The resulting distribution is what our winner must clear.
    With that in place we can search as wide as we like without fooling ourselves.

THE ALPHABET (all causal, all readable, computed on 5-min RTH bars)
    direction, close location in the bar, range expansion, volume, consecutive runs,
    new N-bar extremes, position vs session open / VWAP / prior day close / overnight
    range, time of day. Nothing exotic — these are the things you can see on a chart.
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')

RTH0, RTH1 = 570, 960


def bars5(day, rb):
    """All sessions -> one long 5-min frame with the causal feature alphabet."""
    out = []
    for dd, row in day.iterrows():
        b = rb.get(dd)
        if b is None:
            continue
        A = float(row.ADR)
        H1, L1, C1, O1, V1, T1 = b['H'], b['L'], b['C'], b['O'], b['V'], b['T']
        if not (A > 0) or len(C1) < 300:
            continue
        n5 = (len(C1) // 5) * 5
        ix = np.arange(n5).reshape(-1, 5)
        H, L = H1[ix].max(1), L1[ix].min(1)
        C, O = C1[ix[:, -1]], O1[ix[:, 0]]
        V, T = V1[ix].sum(1), T1[ix[:, -1]]
        end = ix[:, -1]
        m = len(C)
        if m < 20:
            continue
        rngb = np.maximum(H - L, 1e-9)
        tp = (H1 + L1 + C1) / 3.0
        vw = np.cumsum(tp * V1) / np.maximum(np.cumsum(V1), 1e-9)
        vwap = vw[end]
        o930 = float(C1[0])

        df = pd.DataFrame(dict(
            day=dd, t=T, i=np.arange(m), ADR=A, px=C, end=end,
            body=(C - O) / rngb,
            up=(C > O).astype(float),
            clo_hi=(H - C) / rngb,                 # 0 = closed on the high
            clo_lo=(C - L) / rngb,
            rng=rngb / A,
            vol=V,
        ))
        df['rng_z'] = (df.rng - df.rng.rolling(12, min_periods=6).mean().shift(1)) / \
                      (df.rng.rolling(12, min_periods=6).std().shift(1) + 1e-9)
        df['vol_z'] = (df.vol - df.vol.rolling(12, min_periods=6).mean().shift(1)) / \
                      (df.vol.rolling(12, min_periods=6).std().shift(1) + 1e-9)
        df['run'] = df.up.groupby((df.up != df.up.shift()).cumsum()).cumcount() + 1
        df['nhi20'] = (pd.Series(H).rolling(20, min_periods=5).max().shift(1) < H).astype(float)
        df['nlo20'] = (pd.Series(L).rolling(20, min_periods=5).min().shift(1) > L).astype(float)
        df['d_open'] = (C - o930) / A
        df['d_vwap'] = (C - vwap) / A
        df['d_pdc'] = (C - float(row.prevC)) / A
        df['d_onh'] = (C - float(row.onH)) / A
        df['d_onl'] = (C - float(row.onL)) / A
        df['el'] = (T - RTH0) / float(RTH1 - RTH0)
        # forward returns in ADR units
        for k in (6, 12):
            fwd = np.full(m, np.nan)
            for j in range(m):
                kk = min(end[j] + k * 5, len(C1) - 1)
                fwd[j] = (float(C1[kk]) - C[j]) / A
            df[f'f{k}'] = fwd
        out.append(df)
    return pd.concat(out, ignore_index=True).dropna(subset=['rng_z', 'vol_z', 'f6', 'f12'])


# ---- the alphabet: named boolean conditions, each with its natural opposite ----
def conditions(d):
    q = {}
    q['up_bar'] = d.up > 0.5
    q['big_body'] = d.body.abs() >= 0.6
    q['close_top'] = d.clo_hi <= 0.25
    q['close_bot'] = d.clo_lo <= 0.25
    q['range_exp'] = d.rng_z >= 1.0
    q['range_con'] = d.rng_z <= -0.5
    q['vol_hi'] = d.vol_z >= 1.0
    q['vol_lo'] = d.vol_z <= -0.5
    q['run3'] = d.run >= 3
    q['new_hi20'] = d.nhi20 > 0.5
    q['new_lo20'] = d.nlo20 > 0.5
    q['abv_open'] = d.d_open > 0
    q['abv_vwap'] = d.d_vwap > 0
    q['abv_pdc'] = d.d_pdc > 0
    q['abv_onh'] = d.d_onh > 0
    q['blw_onl'] = d.d_onl < 0
    q['stretch'] = d.d_vwap.abs() >= 0.25
    q['early'] = d.el <= 0.33
    q['late'] = d.el >= 0.67
    return {k: v.values for k, v in q.items()}


def scan(d, cond, col='f12', min_n=300, direction='both'):
    """
    Score every single condition and every PAIR. Direction is fixed by the pattern's
    own sign convention: we test BOTH long and short readings and keep the t as
    signed, so a pattern that predicts down shows a negative t. No cherry-picking of
    direction later — both are in the same multiple-testing family.
    """
    names = list(cond)
    y = d[col].values
    days = d.day.values
    # day-clustered t via day means
    dcode, duniq = pd.factorize(days)
    nd = len(duniq)

    def dayt(mask):
        n = int(mask.sum())
        if n < min_n:
            return np.nan, n
        s = np.bincount(dcode[mask], weights=y[mask], minlength=nd)
        c = np.bincount(dcode[mask], minlength=nd)
        ok = c > 0
        g = s[ok] / c[ok]
        if len(g) < 30 or g.std(ddof=1) == 0:
            return np.nan, n
        return float(g.mean() / (g.std(ddof=1) / np.sqrt(len(g)))), n

    rows = []
    for a in names:
        t, n = dayt(cond[a])
        if np.isfinite(t):
            rows.append((a, '', n, t))
    for ii, a in enumerate(names):
        for b in names[ii + 1:]:
            m = cond[a] & cond[b]
            t, n = dayt(m)
            if np.isfinite(t):
                rows.append((a, b, n, t))
    return pd.DataFrame(rows, columns=['A', 'B', 'n', 't'])


def maxstat_null(d, cond, col='f12', n_perm=150, min_n=300, seed=7):
    """
    Distribution of the BEST |t| over the whole pattern family when the forward
    returns are shuffled within time-of-day strata. This is the bar our winner
    must clear.
    """
    rng = np.random.default_rng(seed)
    names = list(cond)
    days = d.day.values
    dcode, duniq = pd.factorize(days)
    nd = len(duniq)
    tod = d.t.values
    strata = [np.flatnonzero(tod == u) for u in np.unique(tod)]
    masks = []
    for ii, a in enumerate(names):
        masks.append(cond[a])
        for b in names[ii + 1:]:
            masks.append(cond[a] & cond[b])
    masks = [m for m in masks if m.sum() >= min_n]

    best = np.empty(n_perm)
    y0 = d[col].values
    for p in range(n_perm):
        y = y0.copy()
        for s in strata:
            y[s] = rng.permutation(y[s])
        bt = 0.0
        for m in masks:
            s_ = np.bincount(dcode[m], weights=y[m], minlength=nd)
            c_ = np.bincount(dcode[m], minlength=nd)
            ok = c_ > 0
            g = s_[ok] / c_[ok]
            if len(g) < 30:
                continue
            sd = g.std(ddof=1)
            if sd == 0:
                continue
            tt = abs(g.mean() / (sd / np.sqrt(len(g))))
            if tt > bt:
                bt = tt
        best[p] = bt
    return best

