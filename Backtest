GATE_DEFS = {
    "none":  None,
    "od30":  (30, 0.50, 0.35),      # by 10:00, drive >= 0.5 ATR30 and ER >= 0.35
    "od60":  (60, 0.75, 0.40),      # by 10:30, drive >= 0.75 ATR30 and ER >= 0.40
}

EXITS = {
    "tp1":      dict(tp_R=1.0),
    "tp2":      dict(tp_R=2.0),
    "tp3":      dict(tp_R=3.0),
    "tp2be1":   dict(tp_R=2.0, be_at_R=1.0),
    "atr2":     dict(trail_mult=2.0),
    "atr3":     dict(trail_mult=3.0),
    "atr2tp4":  dict(trail_mult=2.0, tp_R=4.0),
