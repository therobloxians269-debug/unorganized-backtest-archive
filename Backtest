"""
REFINE #1 — carry-capped, CAUSAL risk-budgeted reallocation over the FULL 2020-2026 sample.

The honest improvement lever: weight sleeves by RISK, not capital, but cap carry (whose measured
vol hides its true venue tail). Weights use only TRAILING data (vol shifted 1 day, weekly rebalance)
=> no look-ahead => shippable live. Compared head-to-head with the legacy capital weights, full
sample + both OOS halves. No signal is touched; this is pure portfolio construction.

    PYTHONPATH=/Users/kaveh/mim_research python3 refine_allocation.py
"""
from __future__ import annotations
import numpy as np
import pandas as pd
from pm_dd_pack import build, ANN
from lib_perf import perf_stats

COLS = ["C1", "C2", "M", "T"]
CARRY = ["C1", "C2"]
RISKY = ["M", "T"]


def causal_riskcapped(j: pd.DataFrame, carry_cap=0.50, lookback=90) -> pd.Series:
    vol = j[COLS].rolling(lookback).std().shift(1)          # trailing vol, lagged -> causal
    iv = (1.0 / vol).where(vol > 0, 0.0).replace([np.inf, -np.inf], 0.0).fillna(0.0)
    raw = iv.div(iv.sum(axis=1).replace(0, np.nan), axis=0).fillna(0.0)  # inverse-vol base
    w = raw.copy()
    # cap combined carry weight, push the freed budget into M/T (inverse-vol within risky)
    csum = w[CARRY].sum(axis=1).replace(0, np.nan)
    scale = np.minimum(1.0, carry_cap / csum).fillna(1.0)
    w[CARRY] = w[CARRY].mul(scale, axis=0)
    remain = (1.0 - w[CARRY].sum(axis=1)).clip(lower=0.0)
    mt = raw[RISKY].div(raw[RISKY].sum(axis=1).replace(0, np.nan), axis=0).fillna(0.0)
    w[RISKY] = mt.mul(remain, axis=0)
    w = w.resample("W").last().reindex(j.index, method="ffill").fillna(0.0)  # weekly rebalance
    return (w * j[COLS]).sum(axis=1).dropna()


def vol_match(r: pd.Series, target: float) -> pd.Series:
    return r * (target / (r.std() * np.sqrt(ANN)))


def report(name, r):
    for lbl, seg in (("full ", r), ("'20-23", r[r.index.year <= 2023]), ("'24-26", r[r.index.year >= 2024])):
        s = perf_stats(seg, ANN)
        print(f"  {name:18}{lbl}  Sharpe {s['sharpe']:5.2f} | CAGR {s['cagr']*100:5.1f}% | "
              f"maxDD {s['maxdd']*100:6.1f}% | Sortino {s['sortino']:.2f}")


def main():
    _, j, comp, *_ = build()
    base = comp.sum(axis=1)                                  # legacy capital-weighted program
    realloc = causal_riskcapped(j, carry_cap=0.50)

    # match the reallocated book to the baseline's realised vol for an apples-to-apples comparison
    tgt = base.std() * np.sqrt(ANN)
    realloc_vm = vol_match(realloc, tgt)

    print(f"\nREFINE #1 — carry-capped causal reallocation vs legacy capital weights")
    print(f"(full sample {base.index[0].date()}..{base.index[-1].date()}, vol-matched to baseline {tgt*100:.1f}%)\n")
    report("baseline (capital)", base)
    print()
    report("risk-capped causal", realloc_vm)

    # sensitivity to the one knob (carry cap) — is the gain a plateau or a knife-edge?
    print("\n  carry-cap sensitivity (full-sample Sharpe, vol-matched):")
    for cap in (0.40, 0.50, 0.60, 0.70):
        r = vol_match(causal_riskcapped(j, carry_cap=cap), tgt)
        print(f"    cap {cap:.0%}: Sharpe {perf_stats(r, ANN)['sharpe']:.2f}")
    print("\n  honest read: a real lift that HOLDS out-of-sample (not just the 3.1y window) and sits on")
    print("  a cap-plateau (not a tuned point) = shippable. If OOS '24-26 doesn't beat baseline, it's noise.")


if __name__ == "__main__":
    main()

