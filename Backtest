import pandas as pd, numpy as np
from signals import collect

def simulate(df, sig, bias='none', tmso_gate=0, max_stop=60., buf=2.0,
             tp1_R=1.0, tp1_frac=0.5, be_after_tp1=True, tp2_R=3.0,
             trail_pts=0.0, max_trades_day=2, point_val=20., comm_per_unit=2.0,
             slip_ticks=1.0, tick=0.25, max_hold=None, sess_filter=None):
    o=df['o'].values;h=df['h'].values;l=df['l'].values;c=df['c'].values
    day=df['daycycle'].values; sess=df['sess'].values
    mq=df['min_into_q90'].values
    B={tf:(df[f'bear{tf}'].values,df[f'bull{tf}'].values) for tf in (1440,240,90)}
    n=len(df); slip=slip_ticks*tick
    trades=[]; used={}; busy_until=-1
    for _,s in sig.iterrows():
        i=int(s.i); d=int(s.d); a=int(s.arm_i)
        if i<=busy_until or i+1>=n: continue
        if sess_filter is not None and sess[i] not in sess_filter: continue
        if tmso_gate and mq[i]>tmso_gate: continue
        # SSMT bias table alignment
        if bias!='none':
            al=[(B[tf][0][i] if d==-1 else B[tf][1][i]) for tf in (1440,240,90)]
            ok={'d':al[0],'4h':al[1],'90':al[2],'any1':any(al),'any2':sum(al)>=2,'all3':all(al)}[bias]
            if not ok: continue
        k=day[i]
        if used.get(k,0)>=max_trades_day: continue
        stop=(max(h[a:i+1].max(),h[i])+buf) if d==-1 else (min(l[a:i+1].min(),l[i])-buf)
        entry=o[i+1]+(-slip if d==-1 else slip)
        risk=abs(stop-entry)
        if risk>max_stop or risk<4*tick: continue
        # ---- manage
        t1 = entry-tp1_R*risk if d==-1 else entry+tp1_R*risk
        t2 = entry-tp2_R*risk if d==-1 else entry+tp2_R*risk
        pos=1.0; realized=0.0; cur_stop=stop; got1=False; ext=entry
        j=i+1; why='open'
        while j<n:
            if day[j]!=k or (max_hold and (j-(i+1))>=max_hold):
                px=o[j]+(slip if d==-1 else -slip)
                realized+=pos*(entry-px if d==-1 else px-entry); why='time'; break
            hi,lo=h[j],l[j]
            hit_stop=(hi>=cur_stop) if d==-1 else (lo<=cur_stop)
            if hit_stop:
                px=cur_stop+(slip if d==-1 else -slip)
                realized+=pos*(entry-px if d==-1 else px-entry)
                why='stop' if not got1 else ('be' if abs(cur_stop-entry)<tick else 'trail'); break
            if not got1:
                hit1=(lo<=t1) if d==-1 else (hi>=t1)
                if hit1:
                    realized+=tp1_frac*(entry-t1 if d==-1 else t1-entry)
                    pos-=tp1_frac; got1=True
                    if be_after_tp1: cur_stop=entry
                    if pos<=1e-9: why='tp1'; break
            if got1:
                hit2=(lo<=t2) if d==-1 else (hi>=t2)
                if hit2:
                    realized+=pos*(entry-t2 if d==-1 else t2-entry); why='tp2'; break
                if trail_pts>0:
                    ext=min(ext,lo) if d==-1 else max(ext,hi)
                    ns=ext+trail_pts if d==-1 else ext-trail_pts
                    cur_stop=min(cur_stop,ns) if d==-1 else max(cur_stop,ns)
            j+=1
        gross=realized*point_val
        net=gross-comm_per_unit*(1+ (1 if got1 else 0))
        trades.append(dict(t=df.index[i+1],d=d,entry=entry,risk=risk,why=why,
                           pnl=net,R=net/(risk*point_val),bars=j-i))
        used[k]=used.get(k,0)+1; busy_until=j
    return pd.DataFrame(trades)

def st(tr,label=''):
    if len(tr)==0: return f'{label:52s} NO TRADES'
    w=(tr.pnl>0).mean(); pos=tr.pnl[tr.pnl>0].sum(); neg=-tr.pnl[tr.pnl<0].sum()
    pf=pos/max(1e-9,neg); eq=tr.pnl.cumsum(); dd=(eq-eq.cummax()).min()
    t=tr.pnl.mean()/tr.pnl.std()*np.sqrt(len(tr)) if tr.pnl.std()>0 else 0
    return (f'{label:52s} n={len(tr):4d} WR={w*100:5.1f}% avgR={tr.R.mean():+.3f} '
            f'$/tr={tr.pnl.mean():+7.2f} net=${tr.pnl.sum():+8.0f} PF={pf:.2f} DD=${dd:.0f} t={t:+.2f}')

