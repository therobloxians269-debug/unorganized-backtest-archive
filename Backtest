class Feat:
    """caches the expensive causal features per (K,K2/z,ema) combination"""
    def __init__(self, d):
        self.d = d
        self._er = {}
        self._ext = {}
        self._ema = {}
        self._trigA = {}
        self._trigB = {}

    def er(self, K):
        if K not in self._er:
            self._er[K] = _er_rolling(self.d["c"], K, self.d["dc"])
        return self._er[K]

    def trigA(self, K2):
        if K2 not in self._trigA:
            hi, lo = _roll_extreme(self.d["c"], K2, self.d["dc"])
            self._trigA[K2] = _triggers_extreme(self.d["c"], hi, lo, K2, self.d["dc"])
        return self._trigA[K2]

    def trigB(self, span, z):
        key = (span, z)
        if key not in self._trigB:
            if span not in self._ema:
                self._ema[span] = _ema(self.d["c"], span, self.d["dc"])
            self._trigB[key] = _triggers_stretch(self.d["c"], self._ema[span],
                                                 self.d["atr15"], z, self.d["dc"])
        return self._trigB[key]


@njit(cache=True)
def _route(st, trig, mode, cooldown, out):
    """mode 0 = reactive (state routes direction, NEUTRAL skips)
       mode 1 = always trend  (every trigger, continuation)
       mode 2 = always MR     (every trigger, fade)
       mode 3 = reactive-subset-forced-TREND (same bars reactive trades, but
                always continuation)
       mode 4 = reactive-subset-forced-MR
    cooldown: minimum bars between consecutive triggers considered."""
    n = trig.shape[0]
    last = -10 ** 9
    for t in range(n):
        tg = trig[t]
        out[t] = 0
        if tg == 0:
            continue
        if t - last < cooldown:
            continue
        s = st[t]
        v = 0
        if mode == 0:
            if s == 1:
                v = tg
            elif s == -1:
                v = -tg
        elif mode == 1:
            v = tg
        elif mode == 2:
            v = -tg
        elif mode == 3:
            if s != 0:
                v = tg
        elif mode == 4:
            if s != 0:
                v = -tg
        if v != 0:
            out[t] = v
            last = t
    return out


def make_sig(st, trig, mode, cooldown, n):
    out = np.zeros(n, np.int8)
    _route(st.astype(np.int8), trig.astype(np.int8), mode, cooldown, out)
    return out


@njit(cache=True)
def _rotate_state_within_day(st, dc, offsets):
    """circularly rotate the state series inside every day-cycle.
    Preserves: state occupancy, switch count, run-length distribution.
    Destroys: alignment with price."""
    n = st.shape[0]
    out = np.zeros(n, np.int8)
    i = 0
    k = 0
    while i < n:
        j = i
        while j + 1 < n and dc[j + 1] == dc[i]:
            j += 1
        L = j - i + 1
        off = offsets[k % offsets.shape[0]] % L
        for a in range(L):
            out[i + a] = st[i + (a + off) % L]
        k += 1
        i = j + 1
    return out


