#!/usr/bin/env python3
"""selftest.py — unit + end-to-end checks for the Judas Swing Sentinel.

Run: python3 selftest.py   (exit 0 = all green)
"""
from __future__ import annotations

import datetime as dt
from zoneinfo import ZoneInfo

import pandas as pd

from judas import Bar, Config, JudasSwingSentinel
from judas.config import InstrumentSpec
from judas.pools import BSL, SSL, PoolTracker
from judas.structure import StructureTracker

ET = ZoneInfo("America/New_York")
PASS = FAIL = 0


def check(name: str, cond: bool) -> None:
    global PASS, FAIL
    print(("  ok " if cond else "FAIL ") + name)
    PASS += cond
    FAIL += not cond


def ts(h: int, m: int, day: int = 6) -> dt.datetime:
    return dt.datetime(2024, 5, day, h, m, tzinfo=ET)


# ----------------------------------------------------------------------
def test_pool_no_lookahead() -> None:
    print("PoolTracker:")
    pt = PoolTracker(fractal_k=2)
    # hourly highs: 10, 11, 14(pivot), 12, 11 -> BSL pool at 14
    highs = [10, 11, 14, 12, 11, 10.5]
    for h_i, hi in enumerate(highs):
        for m in range(60):
            pt.on_1m_bar(ts(1 + h_i, m), hi, hi - 1.0)
        if h_i == 3:  # pivot closed + 1 neighbour: k=2 NOT yet confirmable
            check("pivot not confirmed early (no lookahead)",
                  not pt.unswept(BSL, ts(1 + h_i, 59)))
    check("BSL pool at 14 after k confirm",
          any(p.level == 14 for p in pt.unswept(BSL, ts(6, 59))))
    pt.on_1m_bar(ts(7, 0), 14.25, 13.0)   # raid
    check("sweep marked", pt.swept_between(BSL, ts(6, 0), ts(7, 0)))
    check("pool consumed", not any(p.level == 14 for p in pt.unswept(BSL, ts(7, 1))))


def test_structure_fvg() -> None:
    print("StructureTracker:")
    st = StructureTracker(swing_k=2)
    # bars: flat, then swing low at idx2 (confirmed at idx4), then bearish FVG
    tape = [(100, 100.5, 99.8, 100.2), (100.2, 100.4, 99.9, 100.1),
            (100.1, 100.3, 99.0, 99.4),   # swing low 99.0
            (99.4, 100.6, 99.3, 100.5), (100.5, 100.8, 100.2, 100.7),
            (100.7, 100.9, 100.4, 100.5),
            (100.5, 100.6, 99.9, 100.0),  # candle 1: low 99.9
            (100.0, 100.0, 99.2, 99.3),   # candle 2
            (99.3, 99.4, 98.5, 98.6)]     # candle 3: high 99.4 < 99.9 -> FVG
    for i, (o, h, l, c) in enumerate(tape):
        st.on_1m_bar(ts(9, 30 + i), o, h, l, c)
    sl = st.last_swing_low_below(100.0, ts(9, 38))
    check("swing low found + correct", sl is not None and sl.level == 99.0)
    check("swing confirm delayed by k",
          sl.confirmed_ts == ts(9, 34) and sl.ts == ts(9, 32))
    fvg = st.recent_fvg(-1, ts(9, 36))
    check("bearish FVG found", fvg is not None)
    check("FVG bounds + mid", fvg and fvg.top == 99.9 and fvg.bottom == 99.4
          and abs(fvg.mid - 99.65) < 1e-9)
    check("no bullish FVG", st.recent_fvg(+1, ts(9, 30)) is None)


# ----------------------------------------------------------------------
def scripted_day(sentinel: JudasSwingSentinel, ref_sweeps: bool):
    """Overnight builds a 1H BSL pool at 5001; 08:31 Judas raid; rejection;
    MSS through the 08:25 swing low; displacement leaves a bearish FVG."""
    S, R = "MES", "MNQ"
    intents = []

    def feed(sym, t, o, h, l, c):
        it = sentinel.on_bar(sym, Bar(t, o, h, l, c, 1))
        if it:
            intents.append(it)

    # overnight hourly highs 4998,4999,5001(pivot),4999.5,4998.5,4998 on signal
    for h_i, hi in enumerate([4998, 4999, 5001, 4999.5, 4998.5, 4998]):
        for m in range(60):
            feed(S, ts(2 + h_i, m), hi - 0.5, hi, hi - 2.0, hi - 1.0)
            # reference: its own pivot at 17600 (hour 4), flat otherwise
            rhi = 17600 if h_i == 2 else 17500
            feed(R, ts(2 + h_i, m), rhi - 5, rhi, rhi - 20, rhi - 10)

    # 08:00-08:29 drift with a swing low at 08:25 (low 4995)
    for m in range(30):
        lo = 4995.0 if m == 25 else 4996.5
        feed(S, ts(8, m), 4997.0, 4997.5, lo, 4997.25)
        feed(R, ts(8, m), 17490, 17495, 17480, 17490)

    # 08:30 approach | 08:31 raid of 5001 | 08:32 rejection close-back
    feed(S, ts(8, 30), 4997.25, 4999.75, 4997.0, 4999.5)
    feed(R, ts(8, 30), 17490, 17505, 17488, 17500)
    ref_hi = 17650 if ref_sweeps else 17550   # 17650 sweeps ref pool at 17600
    feed(R, ts(8, 31), 17500, ref_hi, 17495, 17540)
    feed(S, ts(8, 31), 4999.5, 5002.0, 4999.25, 5001.5)     # raid: high > 5001
    feed(R, ts(8, 32), 17540, 17545, 17520, 17525)
    feed(S, ts(8, 32), 5001.5, 5001.75, 5000.25, 5000.5)    # close < 5001
    # 08:33 down | 08:34 displacement -> bearish FVG + MSS (< 4995)
    feed(S, ts(8, 33), 5000.5, 5000.75, 4999.0, 4999.25)
    feed(S, ts(8, 34), 4999.25, 4999.5, 4994.0, 4994.5)
    return intents


def test_sentinel_end_to_end() -> None:
    print("JudasSwingSentinel (scripted day):")
    cfg = Config(signal=InstrumentSpec("MES", 0.25, 5.0),
                 reference=InstrumentSpec("MNQ", 0.25, 2.0))
    it = scripted_day(JudasSwingSentinel(cfg), ref_sweeps=False)
    check("one intent emitted", len(it) == 1)
    if it:
        i = it[0]
        check("short", i.side == -1)
        # FVG: candle1 low 5000.25 (08:32), candle3 high 4999.5 -> mid 4999.875
        check("limit at FVG 50% (tick-rounded)", i.limit in (4999.75, 5000.0))
        check("stop above judas high +2 ticks", i.stop == 5002.5)
        check("target = 2R", abs((i.limit - i.target) - 2 * (i.stop - i.limit)) < 1e-9)

    # SMT gate: reference sweeps its own pool too -> no divergence -> no trade
    it2 = scripted_day(JudasSwingSentinel(cfg), ref_sweeps=True)
    check("SMT divergence gate blocks confluence", len(it2) == 0)

    cfg_inv = Config(signal=InstrumentSpec("MES", 0.25, 5.0),
                     reference=InstrumentSpec("MNQ", 0.25, 2.0), smt_mode="invert")
    it3 = scripted_day(JudasSwingSentinel(cfg_inv), ref_sweeps=True)
    check("placebo (invert) fires on confluence", len(it3) == 1)

    cfg_off = Config(signal=InstrumentSpec("MES", 0.25, 5.0),
                     reference=InstrumentSpec("MNQ", 0.25, 2.0), smt_mode="off")
    it4 = scripted_day(JudasSwingSentinel(cfg_off), ref_sweeps=True)
    check("smt off ignores reference", len(it4) == 1)


# ----------------------------------------------------------------------
def test_fill_engine() -> None:
    print("backtest fill engine:")
    import backtest as bt
    from judas.sentinel import OrderIntent

    class Stub:
        """Emits one fixed short intent on the 1st signal bar."""
        def __init__(self, cfg): self.done = False
        def on_bar(self, sym, bar):
            if sym == "MES" and not self.done:
                self.done = True
                return OrderIntent(bar.ts, -1, limit=100.0, stop=102.0,
                                   target=96.0, ttl_bars=3, tag="stub")
            return None

    real = bt.JudasSwingSentinel
    bt.JudasSwingSentinel = Stub
    try:
        cfg = Config(signal=InstrumentSpec("MES", 0.25, 5.0),
                     reference=InstrumentSpec("MNQ", 0.25, 2.0))

        def mkdf(rows):
            return pd.DataFrame([dict(timestamp=ts(9, 30 + i), open=o, high=h,
                                      low=l, close=c, volume=1)
                                 for i, (o, h, l, c) in enumerate(rows)])

        ref = mkdf([(1, 1, 1, 1)] * 8)

        # touch-only never fills (high == 100.0 exactly)
        sig = mkdf([(99, 99.5, 98.5, 99), (99, 100.0, 98.5, 99)] + [(99, 99, 98, 98)] * 4)
        check("touch != fill", bt.run(cfg, sig, ref)["trades"].empty)

        # trade-through fills, then target hit (needs low < 96)
        sig = mkdf([(99, 99.5, 98.5, 99), (99, 100.5, 98.5, 99),
                    (99, 99, 95.5, 96.5)] + [(96, 96, 95, 95)] * 3)
        tr = bt.run(cfg, sig, ref)["trades"]
        check("trade-through fills at limit",
              len(tr) == 1 and tr.entry.iloc[0] == 100.0)
        check("target exit, R=+2",
              len(tr) == 1 and tr.reason.iloc[0] == "target"
              and abs(tr.R.iloc[0] - 2.0) < 1e-9)

        # ambiguous bar (stop AND target) -> stop first, with slippage
        sig = mkdf([(99, 99.5, 98.5, 99), (99, 100.5, 98.5, 99),
                    (99, 102.5, 95.0, 96)] + [(96, 96, 95, 95)] * 3)
        tr = bt.run(cfg, sig, ref)["trades"]
        check("ambiguous bar -> stop first, adverse slip",
              len(tr) == 1 and tr.reason.iloc[0] == "stop"
              and tr.exit.iloc[0] == 102.25)

        # TTL: never reaches limit -> no fill, no trade
        sig = mkdf([(99, 99.5, 98.5, 99)] + [(99, 99.5, 98.5, 99)] * 5)
        check("TTL expires unfilled", bt.run(cfg, sig, ref)["trades"].empty)
    finally:
        bt.JudasSwingSentinel = real


def main() -> None:
    for t in (test_pool_no_lookahead, test_structure_fvg,
              test_sentinel_end_to_end, test_fill_engine):
        t()
    print(f"\n{PASS} passed, {FAIL} failed")
    raise SystemExit(1 if FAIL else 0)


if __name__ == "__main__":
    main()

