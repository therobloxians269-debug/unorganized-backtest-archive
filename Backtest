overnight_premium_engine/ope/validation.py
==============================================================================
"""M7 -- the overfitting gauntlet.

Tools to decide whether a strategy's edge is real rather than mined:

    perf_stats                 annualized Sharpe, return, vol, max drawdown, win rate
    probabilistic_sharpe_ratio P(true SR > benchmark) given n, skew, kurtosis (PSR)
    deflated_sharpe_ratio      PSR vs a multiple-testing-adjusted benchmark (DSR)
    walk_forward_splits        expanding-window, embargoed train/test index folds
    pbo_cscv                   Probability of Backtest Overfitting via CSCV
    gauntlet_summary           PBO + DSR + per-config stats + PASS/FAIL verdict

References: Bailey & Lopez de Prado (2014) on PSR/DSR/PBO. PSR/DSR use the *per-period*
Sharpe (same frequency as the sample); annualization is only for reporting.
"""
from __future__ import annotations

import itertools
import math
from statistics import NormalDist

import numpy as np
import pandas as pd

_Z = NormalDist()
_GAMMA = 0.5772156649015329  # Euler-Mascheroni constant

# Pre-registered pass thresholds (set with the user before building).
PBO_MAX = 0.25
DSR_MIN = 0.95


def _per_period_sharpe(r: pd.Series) -> float:
    sd = r.std(ddof=1)
    return float(r.mean() / sd) if sd > 0 else 0.0


def perf_stats(returns, periods_per_year: int = 252) -> dict[str, float]:
    """Annualized performance summary of a per-period return series."""
    r = pd.Series(returns).dropna().astype(float)
    n = len(r)
    base = {"n": float(n), "sharpe": 0.0, "ann_return": 0.0,
            "ann_vol": 0.0, "max_drawdown": 0.0, "win_rate": float("nan")}
    if n < 2:
        return base
    sd = r.std(ddof=1)
    eq = (1.0 + r).cumprod()
    base.update(
        sharpe=_per_period_sharpe(r) * math.sqrt(periods_per_year),
        ann_return=float(r.mean() * periods_per_year),
        ann_vol=float(sd * math.sqrt(periods_per_year)),
        max_drawdown=float((eq / eq.cummax() - 1.0).min()),
        win_rate=float((r > 0).mean()),
    )
    return base


def probabilistic_sharpe_ratio(returns, benchmark_sr: float = 0.0) -> float:
    """P(true per-period SR > benchmark_sr), correcting for sample length, skew, kurtosis."""
    r = pd.Series(returns).dropna().astype(float)
    n = len(r)
    if n < 3:
        return float("nan")
    sr = _per_period_sharpe(r)
    skew = float(r.skew())
    kurt = float(r.kurt()) + 3.0  # pandas gives excess kurtosis; want the full moment
    denom = math.sqrt(max(1e-12, 1.0 - skew * sr + (kurt - 1.0) / 4.0 * sr * sr))
    return float(_Z.cdf((sr - benchmark_sr) * math.sqrt(n - 1) / denom))


def trial_sr_variance(returns_by_config: dict) -> float:
    """Variance of per-period Sharpe ratios across the configurations tried."""
    srs = [_per_period_sharpe(pd.Series(v).dropna().astype(float))
           for v in returns_by_config.values()]
    return float(np.var(srs, ddof=1)) if len(srs) > 1 else 0.0


def deflated_sharpe_ratio(returns, sr_variance: float, n_trials: int) -> float:
    """DSR: PSR against a benchmark SR inflated for the number of trials (selection bias)."""
    r = pd.Series(returns).dropna().astype(float)
    if len(r) < 3 or n_trials < 1 or sr_variance <= 0:
        return float("nan")
    if n_trials == 1:
        return probabilistic_sharpe_ratio(r, 0.0)
    z1 = _Z.inv_cdf(1.0 - 1.0 / n_trials)
    z2 = _Z.inv_cdf(1.0 - 1.0 / (n_trials * math.e))
    sr0 = math.sqrt(sr_variance) * ((1.0 - _GAMMA) * z1 + _GAMMA * z2)
    return probabilistic_sharpe_ratio(r, benchmark_sr=sr0)


def walk_forward_splits(n_obs: int, n_splits: int = 5, embargo: int = 1):
    """Yield (train_idx, test_idx) expanding-window folds with an embargo gap between them."""
    if n_splits < 1 or n_obs < (n_splits + 1) * 2:
        return
    fold = n_obs // (n_splits + 1)
    for k in range(1, n_splits + 1):
        train_end = fold * k
        test_start = train_end + embargo
        test_end = n_obs if k == n_splits else fold * (k + 1)
        if test_start < test_end:
            yield np.arange(0, train_end), np.arange(test_start, test_end)


def pbo_cscv(returns_matrix: pd.DataFrame, n_blocks: int = 10) -> float:
    """Probability of Backtest Overfitting via Combinatorially Symmetric Cross-Validation.

    ``returns_matrix`` is T observations x N configs of per-period returns. Returns the
    fraction of IS/OOS block splits where the in-sample-best config lands below the
    out-of-sample median -- low PBO = the winner tends to keep winning OOS.
    """
    m = returns_matrix.dropna(how="any")
    t_obs, n_cfg = m.shape
    if n_cfg < 2 or t_obs < n_blocks * 2 or n_blocks % 2 != 0:
        return float("nan")
    arr = m.to_numpy()
    blocks = np.array_split(np.arange(t_obs), n_blocks)

    def sharpe_cols(rows: np.ndarray) -> np.ndarray:
        sub = arr[rows]
        mu = sub.mean(axis=0)
        sd = sub.std(axis=0, ddof=1)
        with np.errstate(invalid="ignore", divide="ignore"):
            return np.where(sd > 0, mu / sd, 0.0)

    logits = []
    for is_combo in itertools.combinations(range(n_blocks), n_blocks // 2):
        is_set = set(is_combo)
        is_rows = np.concatenate([blocks[i] for i in is_combo])
        oos_rows = np.concatenate([blocks[i] for i in range(n_blocks) if i not in is_set])
        best = int(np.argmax(sharpe_cols(is_rows)))
        sr_oos = sharpe_cols(oos_rows)
        # relative rank in (0,1): fraction of configs the IS-best beats OOS
        w = float((sr_oos < sr_oos[best]).sum()) / (n_cfg - 1)
        w = min(max(w, 1e-6), 1 - 1e-6)
        logits.append(math.log(w / (1 - w)))
    return float((np.array(logits) <= 0).mean())


def gauntlet_summary(returns_by_config: dict, best_name: str,
                     *, n_blocks: int = 10, periods_per_year: int = 252) -> dict:
    """Run the full gauntlet on a grid of per-config return series and verdict the best."""
    matrix = pd.DataFrame(returns_by_config).dropna(how="any")
    best = pd.Series(returns_by_config[best_name]).dropna().astype(float)
    n_trials = len(returns_by_config)
    pbo = pbo_cscv(matrix, n_blocks=n_blocks)
    dsr = deflated_sharpe_ratio(best, trial_sr_variance(returns_by_config), n_trials)
    stats = {name: perf_stats(r, periods_per_year) for name, r in returns_by_config.items()}
    passed = (
        not math.isnan(pbo) and pbo < PBO_MAX
        and not math.isnan(dsr) and dsr > DSR_MIN
    )
    return {
        "best": best_name,
        "n_trials": n_trials,
        "pbo": pbo,
        "psr": probabilistic_sharpe_ratio(best, 0.0),
        "dsr": dsr,
        "stats": stats,
        "passed": bool(passed),
        "thresholds": {"pbo_max": PBO_MAX, "dsr_min": DSR_MIN},
    }

