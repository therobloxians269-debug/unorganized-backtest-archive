"""Canonical filesystem paths for the project.

Resolves a stable project root (the directory containing ``pyproject.toml``) and
derives cache/outputs/logs directories beneath it. Every location can be overridden
with an environment variable so runs are relocatable and reproducible on any host.
"""
from __future__ import annotations

import os
from functools import lru_cache
from pathlib import Path

_ENV_ROOT = "OPE_PROJECT_ROOT"
_ENV_DATA = "OPE_DATA_DIR"
_ENV_OUTPUTS = "OPE_OUTPUTS_DIR"
_ENV_LOGS = "OPE_LOGS_DIR"


@lru_cache(maxsize=1)
def project_root() -> Path:
    """Return the project root.

    Resolution order:
        1. ``$OPE_PROJECT_ROOT`` if set.
        2. The nearest ancestor of this file containing ``pyproject.toml``.
        3. The current working directory (last-resort fallback).
    """
    override = os.environ.get(_ENV_ROOT)
    if override:
        return Path(override).expanduser().resolve()
    here = Path(__file__).resolve()
    for parent in (here, *here.parents):
        if (parent / "pyproject.toml").is_file():
            return parent
    return Path.cwd().resolve()


def _dir_from_env(env_var: str, default: Path) -> Path:
    raw = os.environ.get(env_var)
    return Path(raw).expanduser().resolve() if raw else default


def data_dir() -> Path:
    """Directory for cached market data (parquet/csv). Created if absent."""
    path = _dir_from_env(_ENV_DATA, project_root() / "data")
    path.mkdir(parents=True, exist_ok=True)
    return path


def outputs_dir() -> Path:
    """Directory for run artifacts (manifests, metrics, plots). Created if absent."""
    path = _dir_from_env(_ENV_OUTPUTS, project_root() / "outputs")
    path.mkdir(parents=True, exist_ok=True)
    return path


def logs_dir() -> Path:
    """Directory for log files. Created if absent."""
    path = _dir_from_env(_ENV_LOGS, project_root() / "logs")
    path.mkdir(parents=True, exist_ok=True)
    return path

