#!/usr/bin/env python3
"""
onchain_stables_xs.py -- HYPOTHESIS 1b: per-chain stablecoin flows, CROSS-SECTIONAL.
(verbatim per spec; logic unchanged)
"""
from __future__ import annotations
import sys, math
import numpy as np
from scipy.stats import skew as sk, kurtosis as ku, norm, ttest_1samp, linregress, rankdata

ANN = math.sqrt(365)

# ---------- atoms ----------
def sharpe(x):
    x = x[np.isfinite(x)]
    return x.mean()/x.std(ddof=1)*ANN if len(x) > 1 and x.std() > 0 else 0.0
def calmar(x):
    x = x[np.isfinite(x)]; eq = np.cumsum(x); dd = (eq-np.maximum.accumulate(eq)).min()
    return (x.mean()*365)/abs(dd) if dd < 0 else float('inf')
def maxdd(x):
    x = x[np.isfinite(x)]; eq = np.cumsum(x); return (eq-np.maximum.accumulate(eq)).min()

# ---------- cross-sectional construction ----------
def _xs_z(M):
    mu = np.nanmean(M, axis=1, keepdims=True); sd = np.nanstd(M, axis=1, keepdims=True)
    return (M-mu)/np.where(sd > 0, sd, np.nan)

def _logret(P):
    R = np.full_like(P, np.nan); R[1:] = np.log(P[1:]/P[:-1]); return R

def _rollvol(R, w=30):
    T, N = R.shape; v = np.full_like(R, np.nan)
    for t in range(T):
        lo = max(0, t-w+1); seg = R[lo:t+1]
        with np.errstate(invalid='ignore'):
            v[t] = np.nanstd(seg, axis=0)
    return v

def xs_weights(S, P, k=14, volw=30):
    g = np.full_like(S, np.nan)
    g[k:] = np.log(S[k:]/S[:-k])
    z = _xs_z(g)
    vol = _rollvol(_logret(P), volw); vol = np.where(vol > 0, vol, np.nan)
    w = z/vol
    w = w - np.nanmean(w, axis=1, keepdims=True)                 # dollar neutral
    gross = np.nansum(np.abs(w), axis=1, keepdims=True)
    w = np.where(gross > 0, w/gross, 0.0)
    return np.nan_to_num(w, nan=0.0)

def ls_returns(W, R, cost_bps=4.0):
    Wl = np.roll(W, 1, axis=0); Wl[0] = 0.0
    turn = np.abs(np.diff(Wl, axis=0, prepend=Wl[:1])).sum(1)
    gross = np.nansum(Wl*np.nan_to_num(R), axis=1)
    net = gross - turn*(cost_bps*1e-4)
    return net, gross, turn.mean()

def fwd_ic(S, P, k=14):
    """Mean cross-sectional rank IC: signal_t vs next-day return."""
    g = np.full_like(S, np.nan); g[k:] = np.log(S[k:]/S[:-k])
    R = _logret(P); ics = []
    for t in range(len(g)-1):
        s = g[t]; r = R[t+1]; m = np.isfinite(s) & np.isfinite(r)
        if m.sum() >= 4:
            ics.append(np.corrcoef(rankdata(s[m]), rankdata(r[m]))[0, 1])
    return float(np.nanmean(ics)) if ics else 0.0

def market_alpha(ls, R):
    """Regress LS return on equal-weight basket (crypto beta). Want beta~0, alpha>0."""
    mkt = np.nanmean(R, axis=1); m = np.isfinite(ls) & np.isfinite(mkt)
    if m.sum() < 30: return 0.0, 0.0, 0.0
    lr = linregress(mkt[m], ls[m]); n = m.sum()
    resid = np.std(ls[m]-(lr.slope*mkt[m]+lr.intercept), ddof=2)
    se = resid*math.sqrt(1/n + mkt[m].mean()**2/np.sum((mkt[m]-mkt[m].mean())**2))
    return float(lr.intercept*365), float(lr.intercept/se if se > 0 else 0.0), float(lr.slope)

# ---------- gate components ----------
def direct_test(port, split):
    IS, OOS = port[:split], port[split:]
    tI = ttest_1samp(IS[np.isfinite(IS)], 0); tO = ttest_1samp(OOS[np.isfinite(OOS)], 0)
    return dict(ISs=sharpe(IS), ISt=float(tI.statistic), OOSs=sharpe(OOS), OOSt=float(tO.statistic))
def walk_forward(port, k=6, embargo=5):
    n = len(port); seg = n//k; out = []
    for i in range(k):
        a = i*seg+(embargo if i > 0 else 0); b = (i+1)*seg if i < k-1 else n
        out.append(sharpe(port[a:b]))
    return out
def block_bootstrap(port, block=20, n=1000, seed=0):
    p = port[np.isfinite(port)]; n_obs = len(p)
    if n_obs < block*2: return 0.0, 0.0
    rng = np.random.default_rng(seed); nb = int(np.ceil(n_obs/block)); sh = np.empty(n)
    for i in range(n):
        st = rng.integers(0, n_obs, nb)
        idx = (st[:, None]+np.arange(block)[None, :]).ravel()[:n_obs] % n_obs
        sh[i] = sharpe(p[idx])
    return float(np.percentile(sh, 5)), float(np.percentile(sh, 95))
def dsr(port, n_trials):
    p = port[np.isfinite(port)]; sd = p.std(ddof=1); srd = p.mean()/sd if sd > 0 else 0
    emax = (1-np.euler_gamma)*norm.ppf(1-1/n_trials)+np.euler_gamma*norm.ppf(1-1/(n_trials*math.e))
    sr0 = emax/math.sqrt(len(p))
    den = math.sqrt(max(1e-9, 1-float(sk(p))*srd+(float(ku(p, fisher=False))-1)/4*srd**2))
    return float(norm.cdf((srd-sr0)*math.sqrt(len(p)-1)/den))
def param_neighborhood(S, P, base_k=14, cost_bps=4.0):
    out = {}
    for k in sorted({max(3, int(base_k*(1+f))) for f in (-.5, -.25, 0, .5, 1.0)}):
        net, _, _ = ls_returns(xs_weights(S, P, k=k), _logret(P), cost_bps)
        out[k] = sharpe(net)
    return out
def regime_slices(port, bounds): return {k: sharpe(port[lo:hi]) for k, (lo, hi) in bounds.items()}

# ---------- the gate ----------
def gate(S, P, *, name, n_trials, split=None, bar=0.7, cost_bps=4.0, regimes=None, n_chains=None):
    R = _logret(P); W = xs_weights(S, P); net, gross, turn = ls_returns(W, R, cost_bps)
    if split is None: split = int(len(net)*0.65)
    a_ann, a_t, beta = market_alpha(net, R); ic = fwd_ic(S, P)
    bh = np.nanmean(R, axis=1)
    breadth = n_chains if n_chains else P.shape[1]
    print(f"\n===== ON-CHAIN XS GATE: {name}   (bar: net Sharpe >= {bar}) =====")
    print(f"  breadth  {breadth} chains x {np.isfinite(net).sum()} days   xs-rank-IC={ic:+.3f}  (aggregate version had breadth~1)")
    print(f"  full     gross Sh={sharpe(gross):.2f}  NET Sh={sharpe(net):.2f}  Calmar={calmar(net):.2f}  turn={turn:.3f}/d")
    print(f"  vs B&H   strat Calmar={calmar(net):.2f}  basket-B&H Calmar={calmar(bh):.2f}  strat maxDD={maxdd(net):.3f}")
    print(f"  ALPHA    market-neutral alpha={a_ann:+.3f}/yr  t={a_t:.1f}  (beta to basket={beta:+.2f})")
    dt = direct_test(net, split); print(f"  matched  IS Sh={dt['ISs']:.2f}(t={dt['ISt']:.1f})   OOS Sh={dt['OOSs']:.2f}(t={dt['OOSt']:.1f})")
    wf = walk_forward(net); print(f"  walkfwd  {[round(x,2) for x in wf]}")
    print(f"  paramN   {{{', '.join(f'{k}:{v:.2f}' for k,v in param_neighborhood(S, P, cost_bps=cost_bps).items())}}}")
    if regimes: print(f"  regimes  {{{', '.join(f'{k}:{v:.2f}' for k,v in regime_slices(net, regimes).items())}}}")
    lo, hi = block_bootstrap(net); print(f"  bootCI   90% Sharpe [{lo:.2f}, {hi:.2f}]")
    d = dsr(net, n_trials); print(f"  DSR      N={n_trials} -> {d:.2f}")
    ok = (sharpe(net) >= bar and a_t > 1.5 and lo > 0 and d > 0.9 and dt['OOSt'] > 1.5)
    print(f"  VERDICT  {'PASS - powered, real alpha' if ok else 'FAIL - does not clear the bar'}")
    return ok

# ---------- synthetic self-test ----------
def _synth_panel(mode, T=2000, N=10, rng=None):
    rng = rng or np.random.default_rng(0)
    gl = np.zeros((T, N))
    for c in range(N):
        for t in range(1, T):
            gl[t, c] = 0.96*gl[t-1, c] + rng.normal(0.0008, 0.012)
    S = 1e9*np.exp(np.cumsum(gl, axis=0))
    gk = np.full((T, N), np.nan); gk[14:] = np.log(S[14:]/S[:-14])
    gz = _xs_z(gk)
    common = rng.normal(0.0015, 0.03, T)
    idio = rng.normal(0, 0.04, (T, N))
    if mode == 'edge':
        R = 0.9*np.nan_to_num(np.roll(gz, 1, 0))*0.03 + common[:, None] + idio
    elif mode == 'noise':
        R = common[:, None] + idio
    elif mode == 'factor_trap':
        b = 0.5 + _xs_z(np.nan_to_num(np.roll(gk, 1, 0)))*0.3
        R = b*common[:, None] + idio
    else:
        raise ValueError(mode)
    P = 100*np.exp(np.cumsum(np.nan_to_num(R), axis=0))
    return S, P

if __name__ == "__main__":
    if len(sys.argv) > 1:
        import pandas as pd
        df = pd.read_parquet(sys.argv[1]).sort_values('date').reset_index(drop=True)
        chains = sorted({c[:-7] for c in df.columns if c.endswith('_stable')})
        S = np.column_stack([df[f'{c}_stable'].to_numpy(float) for c in chains])
        P = np.column_stack([df[f'{c}_px'].to_numpy(float) for c in chains])
        yrs = pd.to_datetime(df['date']).dt.year.to_numpy()
        regs = {str(y): (int(np.argmax(yrs == y)), int(len(yrs)-np.argmax(yrs[::-1] == y))) for y in sorted(set(yrs))}
        print(f"chains: {chains}")
        gate(S, P, name=f"per-chain stablecoin XS [{df.date.min()}..{df.date.max()}]",
             n_trials=12, regimes=regs, n_chains=len(chains))
        sys.exit(0)

    rng = np.random.default_rng(11)
    print("### CONTROL 1: relative inflow genuinely LEADS relative return -> PASS")
    S, P = _synth_panel('edge', rng=rng); gate(S, P, name="xs-edge", n_trials=12)
    print("\n### CONTROL 2: supply unrelated to returns -> FAIL")
    S, P = _synth_panel('noise', rng=rng); gate(S, P, name="xs-noise", n_trials=12)
    print("\n### CONTROL 3: inflow only proxies market BETA (no xs alpha) -> FAIL (LS nets factor out)")
    S, P = _synth_panel('factor_trap', rng=rng); gate(S, P, name="xs-factor-trap", n_trials=12)

