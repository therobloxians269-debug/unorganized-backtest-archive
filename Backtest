"""Hunt for sleeves that DIVERSIFY trend (low correlation + positive) to lift portfolio
Sharpe toward the fund bar (PSR>=95% vs 1.0). All on the free 16-ETF basket.

Candidates: cross-sectional momentum, short-term reversal, defensive risk-off. We report
each sleeve's Sharpe and its correlation to trend, then combine trend with the uncorrelated
positive ones and check combined Sharpe / PSR(vs 1.0) / beta.

    PYTHONPATH=. python3 research/candidate_sleeves.py
"""
from __future__ import annotations

import numpy as np
import pandas as pd

from ope.validation import perf_stats, probabilistic_sharpe_ratio

BASKET = ["SPY", "QQQ", "IWM", "EFA", "EEM", "TLT", "IEF", "LQD", "HYG", "EMB",
          "GLD", "SLV", "DBC", "USO", "VNQ", "UUP"]
TGT, COST_BP = 0.10, 1.0


def _av(rets):
    return (rets.rolling(63).std() * np.sqrt(252)).shift(1)


def trend_s(px, av):
    return np.tanh(sum(px.pct_change(L) / (av * np.sqrt(L / 252.0)) for L in (63, 126, 252)) / 3)


def xsmom_s(px, av):
    r = px.pct_change(126)
    z = r.sub(r.mean(axis=1), axis=0).div(r.std(axis=1).replace(0, np.nan), axis=0)
    return np.tanh(z)                                   # cross-sectional momentum (market-neutral)


def strev_s(px, av):
    return np.tanh(-px.pct_change(5) / (av * np.sqrt(5 / 252.0)))   # fade the 5-day move


def defensive_s(px, av):
    # risk-off: when SPY 21d vol is elevated, long bonds+gold, short equities
    spyvol = (px["SPY"].pct_change().rolling(21).std() * np.sqrt(252)).shift(1)
    hi = (spyvol > spyvol.rolling(252, min_periods=60).median()).astype(float)
    longs, shorts = ["TLT", "IEF", "GLD"], ["SPY", "QQQ", "IWM", "EEM"]
    s = pd.DataFrame(0.0, index=px.index, columns=px.columns)
    s[longs] = 1.0
    s[shorts] = -1.0
    return s.mul(hi, axis=0)


def norm_w(px, strength):
    w = strength.shift(1) / _av(px.pct_change())
    return w.div(w.abs().sum(axis=1).replace(0, np.nan), axis=0)


def net(px, w):
    rets = px.pct_change()
    g = (w * rets).sum(axis=1)
    scale = (TGT / (g.rolling(63).std() * np.sqrt(252))).shift(1).clip(0, 3).fillna(0.0)
    w = w.mul(scale, axis=0)
    return ((w * rets).sum(axis=1) - w.diff().abs().sum(axis=1) * COST_BP * 1e-4).dropna()


def line(name, n, ref=None):
    s = perf_stats(n)
    c = f" corr_trend={pd.concat([n, ref], axis=1).dropna().corr().iloc[0,1]:+.2f}" if ref is not None else ""
    print(f"{name:>10} Sh={s['sharpe']:+.2f} ann={s['ann_return']*100:4.1f}% DD={s['max_drawdown']*100:6.1f}%{c}")


def main():
    import yfinance as yf
    px = yf.download(BASKET, start="2006-01-01", auto_adjust=True, progress=False)["Close"]
    px = px.dropna(how="all").dropna(axis=1, thresh=int(len(px) * 0.4))
    av = _av(px.pct_change())

    wt = norm_w(px, trend_s(px, av))
    nt = net(px, wt)
    sleeves = {
        "xsmom": norm_w(px, xsmom_s(px, av)),
        "strev": norm_w(px, strev_s(px, av)),
        "defensive": norm_w(px, defensive_s(px, av)),
    }
    print("sleeve standalone + correlation to trend:")
    line("trend", nt)
    nets = {"trend": nt}
    for name, w in sleeves.items():
        n = net(px, w)
        nets[name] = n
        line(name, n, nt)

    # combine trend with each candidate that is positive AND low-correlation
    keep = [k for k in sleeves if perf_stats(nets[k])["sharpe"] > 0.1
            and abs(pd.concat([nets[k], nt], axis=1).dropna().corr().iloc[0, 1]) < 0.4]
    print(f"\nkeeping (positive, |corr|<0.4): {keep}")
    ws = [wt] + [sleeves[k] for k in keep]
    combo_w = sum(ws) / len(ws)
    nc = net(px, combo_w)
    s = perf_stats(nc)
    psr1 = probabilistic_sharpe_ratio(nc, 1.0 / np.sqrt(252))
    spy = px["SPY"].pct_change().reindex(nc.index)
    beta = pd.concat([nc, spy], axis=1).dropna().cov().iloc[0, 1] / spy.var()
    print(f"\nCOMBO ({['trend']+keep}):")
    print(f"  Sharpe={s['sharpe']:.2f} ann={s['ann_return']*100:.1f}% DD={s['max_drawdown']*100:.1f}% "
          f"beta={beta:+.2f} PSR(vs1.0)={psr1*100:.1f}%")


if __name__ == "__main__":
    main()

