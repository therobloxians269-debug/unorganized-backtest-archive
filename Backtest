"""
Z1/Z2 — Zone conditional-edge measurement engine.

Question the user actually asked: which chart ZONES genuinely shift the forward-return
distribution (elevated reversal / continuation), independent of any entry strategy?

Method (honest): for each candidate zone, take the FIRST bar that enters the zone
(one quasi-independent event per touch), then measure the forward return ALIGNED to the
zone's hypothesis over the next 30m/60m. Positive aligned return = "the zone works as
labelled". Report n, mean bps, t-stat, hit-rate, and IS(<=2019)/OOS(>=2020) split.
A zone is INFORMATIVE if aligned mean > 0 with |t|>=2 and same sign in both halves.

All zone definitions use only constructions Pine v6 can replicate exactly
(session VWAP, rolling stdev, ATR, session highest/lowest, time-of-day).
Cost note: MES round-turn ~0.75 pt. A zone can be INFORMATIVE (distribution shift)
without being TRADEABLE after costs — both are reported; we do not conflate them.
"""
import numpy as np, pandas as pd

BARS = pd.read_parquet("/Users/kaveh/box_theory/bars5.parquet")
BOXES = pd.read_parquet("/Users/kaveh/box_theory/boxes.parquet")
IS_END = pd.Timestamp("2020-01-01", tz="America/New_York")
POINT = 5.0

def day_frame(g):
    g = g.reset_index()
    tp = (g.high + g.low + g.close) / 3.0
    cumv = g.volume.cumsum().replace(0, np.nan)
    g["vwap"] = (tp * g.volume).cumsum() / cumv
    dev = g.close - g.vwap
    g["sig"] = dev.expanding().std().bfill()
    g["z"] = dev / g.sig.replace(0, np.nan)
    tr = (g.high - g.low)
    g["atr"] = tr.rolling(14, min_periods=3).mean().bfill()
    g["ib_hi"] = g.high.iloc[:12].max()      # first hour (12x5m) initial balance
    g["ib_lo"] = g.low.iloc[:12].min()
    g["bar"] = np.arange(len(g))
    g["tod"] = g.et.dt.strftime("%H:%M")
    return g

def collect():
    """Return dict: zone_name -> list of (day, aligned_fwd30_bps, aligned_fwd60_bps)."""
    ev = {}
    def add(name, day, base_close, fwd_series, i, direction):
        # direction: +1 if hypothesis says price goes UP next, -1 if DOWN
        for k, tag in [(6, 30), (12, 60)]:
            j = i + k
            if j >= len(fwd_series):
                r = None
            else:
                r = direction * (fwd_series[j] / base_close - 1) * 1e4  # aligned bps
            ev.setdefault(name, []).append((day, tag, r))
    for day, g0 in BARS.groupby("day"):
        if day not in BOXES.index: continue
        box = BOXES.loc[day]
        g = day_frame(g0)
        c = g.close.values
        n = len(g)
        # precompute zone membership per bar, then take first-entry events
        def first_entries(mask):
            m = mask.values if hasattr(mask, "values") else mask
            out = []
            prev = False
            for i in range(12, n-1):            # start after IB is defined
                if m[i] and not prev: out.append(i)
                prev = m[i]
            return out
        # --- VWAP sigma extension zones (reversal hypothesis) ---
        for zc, nm in [(2, "VWAP +2sig (rev)"), (3, "VWAP +3sig (rev)")]:
            for i in first_entries(g.z >= zc):
                add(nm, day, c[i], c, i, -1)     # upper extension -> expect DOWN
            for i in first_entries(g.z <= -zc):
                add(nm.replace("+", "-"), day, c[i], c, i, +1)  # lower -> expect UP
        # --- prior-day box edges (reversal hypothesis) ---
        for i in first_entries(g.high >= box.box_high):
            add("PDH touch (rev)", day, c[i], c, i, -1)
        for i in first_entries(g.low <= box.box_low):
            add("PDL touch (rev)", day, c[i], c, i, +1)
        # --- initial-balance break (continuation hypothesis) ---
        for i in first_entries((g.close > g.ib_hi) & (g.bar >= 12)):
            add("IB-high break (cont)", day, c[i], c, i, +1)
        for i in first_entries((g.close < g.ib_lo) & (g.bar >= 12)):
            add("IB-low break (cont)", day, c[i], c, i, -1)
        # --- VWAP reclaim / trend continuation (above VWAP in last 2h) ---
        for i in first_entries((g.close > g.vwap) & (g.bar >= 60)):
            add("above-VWAP late (cont)", day, c[i], c, i, +1)
        for i in first_entries((g.close < g.vwap) & (g.bar >= 60)):
            add("below-VWAP late (cont)", day, c[i], c, i, -1)
    return ev

def stats(rows, tag):
    r = np.array([x[2] for x in rows if x[1] == tag and x[2] is not None], dtype=float)
    if len(r) < 30: return None
    t = r.mean() / r.std() * np.sqrt(len(r)) if r.std() > 0 else 0
    return dict(n=len(r), bps=r.mean(), t=t, hit=(r > 0).mean()*100)

def era(rows, tag, lo, hi):
    r = np.array([x[2] for x in rows if x[1]==tag and x[2] is not None and lo<=x[0]<hi], dtype=float)
    if len(r) < 20: return None
    t = r.mean()/r.std()*np.sqrt(len(r)) if r.std()>0 else 0
    return dict(n=len(r), bps=r.mean(), t=t)

if __name__ == "__main__":
    ev = collect()
    FAR = pd.Timestamp("2099-01-01", tz="America/New_York")
    NEG = pd.Timestamp("1900-01-01", tz="America/New_York")
    print("="*120)
    print("ZONE CONDITIONAL-EDGE SIGNATURE — real ES 5m 2010-26. Aligned fwd return (bps); +=zone works as labelled.")
    print("MES cost floor ~ %.0f bps round-turn at ES~5000. INFORMATIVE = |t|>=2 & both eras same sign.  (30m horizon)" % ( (0.75/5000)*1e4 ))
    print("="*120)
    print(f"  {'ZONE':<26}{'n':>6}{'meanBPS':>9}{'t':>7}{'hit%':>7}   | {'IS bps(t)':>14} {'OOS bps(t)':>14}   verdict")
    order = ["VWAP +2sig (rev)","VWAP -2sig (rev)","VWAP +3sig (rev)","VWAP -3sig (rev)",
             "PDH touch (rev)","PDL touch (rev)","IB-high break (cont)","IB-low break (cont)",
             "above-VWAP late (cont)","below-VWAP late (cont)"]
    for nm in order:
        rows = ev.get(nm)
        if not rows:
            print(f"  {nm:<26}  (no data)"); continue
        s = stats(rows, 30)
        if s is None:
            print(f"  {nm:<26}  (n<30)"); continue
        i_ = era(rows, 30, NEG, IS_END); o_ = era(rows, 30, IS_END, FAR)
        def f(x): return f"{x['bps']:+6.1f}({x['t']:+.1f})" if x else "     n/a     "
        informative = (abs(s['t'])>=2 and i_ and o_ and (i_['bps']>0)==(o_['bps']>0) and s['bps']>0)
        v = "INFORMATIVE" if informative else ("weak+" if s['bps']>0 else "no/neg")
        print(f"  {nm:<26}{s['n']:>6}{s['bps']:>9.1f}{s['t']:>7.1f}{s['hit']:>7.1f}   | {f(i_):>14} {f(o_):>14}   {v}")

