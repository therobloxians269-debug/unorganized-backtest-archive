def daily_table(df):
    rth = df.between_time("09:30", "15:59")
    dt = rth.index.date
    g = rth.groupby(dt)
    tab = pd.DataFrame({
        "o": g["o"].first(), "h": g["h"].max(), "l": g["l"].min(),
        "c": g["c"].last(), "v": g["v"].sum(), "n": g.size(),
    })
    tab["open_ts"] = g.apply(lambda x: x.index[0])
    tab["close_ts"] = g.apply(lambda x: x.index[-1])
    tab = tab[tab["n"] >= 350]                    # drop half days / holidays
    tab["rng"] = tab["h"] - tab["l"]
    tab["er"] = (tab["c"] - tab["o"]).abs() / tab["rng"].replace(0, np.nan)
    tab["pos"] = (tab["c"] - tab["l"]) / tab["rng"].replace(0, np.nan)
    tab["open_pos"] = df.index.get_indexer(pd.DatetimeIndex(tab["open_ts"]))
    tab["close_pos"] = df.index.get_indexer(pd.DatetimeIndex(tab["close_ts"]))
    return tab.reset_index(drop=True)


def label_window(df, p_start, p_end):
    """ER label over bar positions [p_start, p_end] inclusive."""
    o = df["o"].values; h = df["h"].values; l = df["l"].values; c = df["c"].values
    hi = h[p_start:p_end + 1].max(); lo = l[p_start:p_end + 1].min()
    rng = hi - lo
    if rng <= 0: return np.nan, np.nan
    er = abs(c[p_end] - o[p_start]) / rng
    return er, rng


