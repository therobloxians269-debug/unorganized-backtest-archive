"""
THE SHARP OBJECT: not "where will the extreme be" but "is the extreme I can already
see the final one?"

At any time t the running high is a KNOWN, EXACT price. The only question is whether
price exceeds it before 16:00. That is a probability on a single tick — zero width —
and it is a far more precise statement than any block.

Fit P(running extreme survives to the close | causal state at t), per side, on ES
2010-2017. Score on unseen ES 2018-26, NQ, MNQ. Calibration is the whole test.
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')
from sklearn.linear_model import LogisticRegression

CHECK = list(range(585, 956, 5))   # every 5 min, 09:45-15:55 — the way the Pine actually runs it

FEATS = ['s_el', 's_run', 's_opp', 's_used', 's_since', 's_nnew', 's_pos', 's_vel']


def events(day, rb):
    """One row per (session, checkpoint, side)."""
    rows = []
    for dd, row in day.iterrows():
        b = rb.get(dd)
        if b is None:
            continue
        H, L, T, C = b['H'], b['L'], b['T'], b['C']
        A, o = row.ADR, row.o930
        if not (A > 0):
            continue
        dayH, dayL = H.max(), L.min()
        for t in CHECK:
            m = T <= t
            if m.sum() < 10 or (~m).sum() < 10:
                continue
            rh, rl = H[m].max(), L[m].min()
            el = (t - 570) / 390.0
            # index of the bar that made the running extreme
            ih = int(np.argmax(H[m]))
            il = int(np.argmin(L[m]))
            nH = int((H[m] >= np.maximum.accumulate(H[m]) - 1e-9).sum())
            nL = int((L[m] <= np.minimum.accumulate(L[m]) + 1e-9).sum())
            k = m.sum()
            vel = (C[m][-1] - C[m][max(0, k - 30)]) / A
            for side in ('hi', 'lo'):
                run = (rh - o) / A if side == 'hi' else (o - rl) / A
                opp = (o - rl) / A if side == 'hi' else (rh - o) / A
                since = (k - 1 - (ih if side == 'hi' else il)) / max(k, 1)
                nnew = (nH if side == 'hi' else nL) / max(k, 1)
                surv = (dayH <= rh + 1e-9) if side == 'hi' else (dayL >= rl - 1e-9)
                rows.append(dict(day=dd, t=t, side=side, surv=bool(surv),
                                 lvl=rh if side == 'hi' else rl, ADR=A,
                                 s_el=el, s_run=run, s_opp=opp,
                                 s_used=(rh - rl) / A, s_since=since,
                                 s_nnew=nnew, s_pos=(C[m][-1] - o) / A * (1 if side == 'hi' else -1),
                                 s_vel=vel * (1 if side == 'hi' else -1)))
    return pd.DataFrame(rows)


def fit(tr):
    M = {}
    for side in ('hi', 'lo'):
        g = tr[tr.side == side]
        M[side] = LogisticRegression(max_iter=2000, C=1.0).fit(g[FEATS].values, g.surv.values)
    return M


def score(M, d):
    out = np.zeros(len(d))
    for side in ('hi', 'lo'):
        m = (d.side == side).values
        if m.sum():
            out[m] = M[side].predict_proba(d[m][FEATS].values)[:, 1]
    return out


def calib(p, y, bins=(0.0, .5, .6, .7, .8, .9, .95, 1.01)):
