"""
Does 'limit at the tip of the rejection block' actually make money?

Simulates exactly what the indicator draws:
  - 00:00-05:00 NY: find the highest swing high and lowest swing low
  - the block tip = that swing's wick extreme
  - place a limit there, valid 05:00 -> 16:00
  - stop = stopPct beyond the tip, target = R multiple
  - fill only if price actually trades to the tip

Controls:
  A. block tip vs the plain overnight HIGH/LOW (is the wick structure adding anything?)
  B. block tip vs a displaced level (placebo)
"""
import numpy as np, pandas as pd
import qtlib as Q

TF = "15min"
PVL, PVR = 3, 3
WIN_START, WIN_END = 0, 5 * 60      # NY minutes: block formation window
TRADE_END = 16 * 60
