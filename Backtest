"""
RECOIL · R1 — does tau carry information?

THE CLAIM UNDER TEST
    Among raids that ARE reclaimed, the SPEED of the reclaim separates a defended
    pool (fast, violent, continues) from a genuine break that merely wobbled (slow,
    grinding, resumes). If true, forward return after the reclaim is monotone
    decreasing in tau.

THE NULLS (a result must survive all three)
  1. DISPLACED LEVEL — rerun with every pool moved 0.25/0.50 ADR off the real
     liquidity. A mechanism that lives on resting stops must weaken when the level
     no longer sits on them. If displaced scores the same, we are measuring
     mean reversion in general, not the pool.
  2. SHUFFLED TAU — permute tau across raids within the same pool. Kills the
     tau->outcome link while preserving every marginal. Must go to zero.
  3. TIME PLACEBO — raid the level at a random time instead of the true raid bar.
     Catches "any reclaim at any moment mean-reverts".

DISCOVERY IS ES-ONLY. NQ and MNQ are not touched in this file.
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')
import data as D, recoil as RC

rng = np.random.default_rng(23)
HOR = (15, 30, 60, 120)


def build(which, displace=0.0):
    d = D.load(which)
    day, r = D.sessions(d)
    rb = D.rth_bars(r)
    ra = RC.raids(day, rb, displace=displace)
    ra = RC.outcomes(ra, day, rb, horiz=HOR)
    return day, rb, ra


def daycluster_t(x, days):
    """t-stat with day-clustered SE — raids on the same session are not independent."""
    x = np.asarray(x, dtype=float)
    m = np.isfinite(x)
    x, days = x[m], np.asarray(days)[m]
    if len(x) < 10:
        return np.nan, np.nan, len(x)
    g = pd.Series(x).groupby(pd.Series(days).values).mean()
    return float(g.mean()), float(g.mean() / (g.std(ddof=1) / np.sqrt(len(g)))), len(x)


def tau_table(ra, col='r60', bins=(0, 5, 15, 30, 60, 120, 10 ** 9), label=''):
    r = ra[ra.reclaimed].copy()
    print(f'\n  {label}  (outcome = {col}, ADR units, + means the reclaim continued)')
    print(f'    {"tau (min)":<14}{"n":>7}{"mean":>9}{"t(day)":>9}{"win%":>8}{"median":>9}')
    rows = []
    for a, b in zip(bins[:-1], bins[1:]):
        m = (r.tau >= a) & (r.tau < b)
        if m.sum() < 30:
            continue
        mu, t, n = daycluster_t(r[m][col], r[m].day)
        rows.append((a, b, n, mu, t, float((r[m][col] > 0).mean()), float(r[m][col].median())))
        lab = f'{a}-{b}' if b < 10 ** 9 else f'{a}+'
        print(f'    {lab:<14}{n:>7}{mu:>+9.4f}{t:>+9.2f}{(r[m][col] > 0).mean():>8.1%}'
              f'{r[m][col].median():>+9.4f}')
    return pd.DataFrame(rows, columns=['lo', 'hi', 'n', 'mean', 't', 'winrate', 'median'])


if __name__ == '__main__':
    print('RECOIL R1 — does the speed of the reclaim carry information?')
    print('=' * 84)
    day, rb, ra = build('ES')
    ra = ra[ra.day >= '2010-01-01']
    print(f'  ES sessions {day.shape[0]:,}   raids {len(ra):,}   '
          f'reclaimed {ra.reclaimed.mean():.1%}   '
          f'raids/session {len(ra)/day.shape[0]:.2f}')
    print(f'  reclaim rate by pool:')
    for p in RC.POOLS:
        s = ra[ra.pool == p]
        if len(s):
            print(f'     {p:<5} n={len(s):>5}  reclaimed {s.reclaimed.mean():>5.1%}  '
                  f'median tau {s[s.reclaimed].tau.median():>5.0f}m  '
                  f'median penetration {s.pen.median():.3f} ADR')

    print(f'\n{"="*84}\n  MAIN — forward return after the reclaim, bucketed by tau (ES, all pools)\n{"="*84}')
    for col in ('r30', 'r60', 'r120', 'r_close'):
