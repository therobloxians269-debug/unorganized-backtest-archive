    print(f"PRE-REGISTERED: {cfg_label(PREREG)}  (friction {FRIC_RT:.2f} pt RT, roll-window days excluded)")
    print(f"net_usd={st['net_usd']:.2f}  MAR={st['mar']}  trades={st['trades']}  "
          f"hit={st['hit']:.3f}  maxDD={st['maxdd_usd']:.2f}  exp={st['expectancy_pts']:.3f} pts")
