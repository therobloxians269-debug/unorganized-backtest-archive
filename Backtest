#!/usr/bin/env python3
"""OCEAN family f01_trend_replateau.

Question: does the incumbent ORB+VWAP trend engine (omni4_preserve.sim_day)
have ANY plateau configuration when DEV = full 2010-2022, instead of the
2022+ regime it was born in?

Engine = faithful port of omni4_preserve.sim_day (entry at bar close, stop
checked intrabar only on bars strictly AFTER the entry bar, EOD exit at bar
77 close, ATR stop with 5pt house floor, ride winners to close).
Added lever: a daily-context gate = direction of the prior 20-session
close-to-close drift (drift computed ONLY from completed prior sessions;
sign of close[t-1] - close[t-21]).  Gate modes:
  er    : trade only when ER(24) >= er_thr at the signal bar (incumbent)
  drift : ER gate removed; engine only looks for signals in the drift
          direction (opposite-side breakouts are ignored entirely)
  both  : ER gate AND drift-direction restriction

Friction: omni2_lib.fric ("stop"/"eod" = 0.66pt RT, entries always market).
$5/pt (1 MES).

Windows: dev = dates <= 2022-12-31 (the only window the finder ran),
holdout = 2023-01-01.. (referee only), all = both.
"""
import sys, os, json, argparse, datetime as dt
sys.path.insert(0, "/Users/kaveh/mes_mim")
import numpy as np, pandas as pd
import omni2_lib as L
from omni2_lib import ORN, FLOOR, fric, DPP

DEV_END = dt.date(2022, 12, 31)
RESULTS_DIR = "/Users/kaveh/mes_mim/ocean/results"
DRIFT_N = 20  # prior sessions for close-to-close drift (fixed, not swept)


def load_sessions(window):
    """Load all sessions, attach causal drift direction, then filter window.
    Drift is computed on the full ordered session list BEFORE filtering so the
    holdout boundary is seamless; it only ever uses sessions strictly before t."""
    S = L.load()
    closes = [float(s["c"][-1]) for s in S]
    for i, s in enumerate(S):
        if i >= DRIFT_N + 1:
            d = closes[i - 1] - closes[i - 1 - DRIFT_N]
            s["drift"] = 1 if d > 0 else (-1 if d < 0 else 0)
        else:
            s["drift"] = 0
    if window == "dev":
        S = [s for s in S if s["date"] <= DEV_END]
    elif window == "holdout":
        S = [s for s in S if s["date"] > DEV_END]
    return S


def sim_day(s, gate, er_thr, atr_mult, max_entries):
    """Faithful port of omni4_preserve.sim_day (stop_after_loss=False,
    use_atr_stop=True) plus the optional drift-direction restriction."""
    h, l, c, atr, vwap, er = s["h"], s["l"], s["c"], s["atr"], s["vwap"], s["er"]
    orh, orl = s["or_hi"], s["or_lo"]
    use_er = gate in ("er", "both")
    use_drift = gate in ("drift", "both")
    if use_drift and s["drift"] == 0:
        return []
    ok_long = (not use_drift) or s["drift"] == 1
    ok_short = (not use_drift) or s["drift"] == -1
    pos = 0; entry = stop = np.nan; ebar = -1; risk0 = np.nan
    broke = 0; n = 0; res = []
    for b in range(ORN, 78):
        if pos == 0 and n < max_entries and b < 77 and ((not use_er) or er[b] >= er_thr):
            above = c[b] > vwap[b]; below = c[b] < vwap[b]; side = 0
            if broke == 0:
                if ok_long and c[b] > orh and above:
                    side = 1; broke = 1
                elif ok_short and c[b] < orl and below:
                    side = -1; broke = -1
            else:
                if broke == 1 and above and l[b] <= vwap[b] + 0.5*atr[b] and c[b] > c[b-1]:
                    side = 1
                elif broke == -1 and below and h[b] >= vwap[b] - 0.5*atr[b] and c[b] < c[b-1]:
                    side = -1
            if side != 0:
                pos = side; entry = c[b]; ebar = b
                sd = max(atr_mult*atr[b], FLOOR)
                stop = c[b] - side*sd; risk0 = abs(entry - stop); n += 1
            continue
        if pos != 0 and b > ebar:
            hit = (l[b] <= stop) if pos > 0 else (h[b] >= stop)
            if hit:
                g = pos*(stop - entry) - fric("stop")
            elif b == 77:
                g = pos*(c[b] - entry) - fric("eod")
            else:
                continue
            res.append((s["date"], g, risk0)); pos = 0
    return res


def run_cfg(S, gate, er_thr, atr_mult, max_entries):
    res = []
    for s in S:
        res.extend(sim_day(s, gate, er_thr, atr_mult, max_entries))
    return res


def stats(res):
    if len(res) == 0:
        return dict(net_usd=0.0, mar=0.0, trades=0, hit=0.0, maxdd_usd=0.0,
                    yearly={}, top3_month_share=float("nan"), expectancy_pts=0.0,
                    yr_pos_frac=0.0, max_yr_share=float("nan"))
    tr = pd.DataFrame(res, columns=["date", "net", "risk"])
    daily = tr.groupby("date")["net"].sum() * DPP
    idx = pd.to_datetime(pd.Series(daily.index.map(str)))
    eq = daily.cumsum().to_numpy()
    dd = float((eq - np.maximum.accumulate(eq)).min())
    net = float(daily.sum())
    mar = (net / abs(dd)) if dd < 0 else float("inf")
    dyr = pd.DataFrame({"usd": daily.to_numpy(), "yr": idx.dt.year.to_numpy(),
                        "mon": idx.dt.to_period("M").astype(str).to_numpy()})
    yearly = dyr.groupby("yr")["usd"].sum()
    monthly = dyr.groupby("mon")["usd"].sum()
    top3 = float(monthly.nlargest(3).sum() / net) if net > 0 else float("nan")
    max_yr_share = float(yearly.max() / net) if net > 0 else float("nan")
    return dict(
        net_usd=round(net, 2),
        mar=round(mar, 3) if np.isfinite(mar) else mar,
        trades=int(len(tr)),
        hit=round(float((tr["net"] > 0).mean()), 4),
        maxdd_usd=round(dd, 2),
        yearly={str(k): round(float(v), 2) for k, v in yearly.items()},
        top3_month_share=round(top3, 4) if np.isfinite(top3) else top3,
        expectancy_pts=round(float(tr["net"].mean()), 4),
        yr_pos_frac=round(float((yearly > 0).mean()), 4),
        max_yr_share=round(max_yr_share, 4) if np.isfinite(max_yr_share) else max_yr_share,
    )


def survives(st):
    """DEV survival bar (intraday holds => 80-trade minimum)."""
    if st["trades"] < 80:
        return False, "trades<80"
    if st["net_usd"] <= 0:
        return False, "net<=0"
    if not (st["mar"] >= 1.0):
        return False, "MAR<1"
    if st["yr_pos_frac"] < 0.60:
        return False, "yrs+<60%"
    if st["net_usd"] > 0 and st["max_yr_share"] > 0.50:
        return False, "1yr>50%"
    return True, "PASS"


# ---------------------------------------------------------------- sweep grid
# Budget: 30 configs total.  (gate, er_thr, atr_mult, max_entries)
SWEEP = []
# A (15): ER-only full er x stop grid at incumbent max_entries=3
for er_thr in (0.35, 0.40, 0.45, 0.50, 0.55):
    for am in (1.0, 1.5, 2.0):
        SWEEP.append(("er", er_thr, am, 3))
# B (5): ER-only max_entries=1 slice at central stop 1.5 (entries-neighbors)
for er_thr in (0.35, 0.40, 0.45, 0.50, 0.55):
    SWEEP.append(("er", er_thr, 1.5, 1))
# C (6): drift-gate-only (ER gate removed), full stop x entries grid
for am in (1.0, 1.5, 2.0):
    for me in (1, 3):
        SWEEP.append(("drift", None, am, me))
# D (4): combined ER+drift gate, central region
for er_thr in (0.40, 0.45):
    for me in (1, 3):
        SWEEP.append(("both", er_thr, 1.5, me))


def sweep_table(S):
    print("\n===== FULL SWEEP TABLE (DEV 2010-06..2022-12 only) — 30 configs =====")
    hdr = (f"{'#':>2} {'gate':5s} {'er':>5s} {'atr':>4s} {'me':>2s} "
           f"{'trades':>6s} {'net$':>8s} {'maxDD$':>8s} {'MAR':>6s} {'hit':>5s} "
           f"{'exp_pts':>7s} {'yr+%':>5s} {'maxYr%':>6s} {'verdict':s}")
    print(hdr)
    rows = []
    for i, (gate, er_thr, am, me) in enumerate(SWEEP, 1):
        st = stats(run_cfg(S, gate, er_thr, am, me))
        ok, why = survives(st)
        ers = f"{er_thr:.2f}" if er_thr is not None else "  --"
        mys = f"{100*st['max_yr_share']:>6.0f}" if np.isfinite(st["max_yr_share"]) else f"{'--':>6s}"
        print(f"{i:>2} {gate:5s} {ers:>5s} {am:>4.1f} {me:>2d} "
              f"{st['trades']:>6d} {st['net_usd']:>8.0f} {st['maxdd_usd']:>8.0f} "
              f"{st['mar']:>6.2f} {st['hit']:>5.2f} {st['expectancy_pts']:>7.3f} "
              f"{100*st['yr_pos_frac']:>5.0f} {mys} "
              + ("PASS" if ok else f"DEAD({why})"))
        rows.append((gate, er_thr, am, me, st, ok, why))
    return rows


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--window", choices=["dev", "holdout", "all"], default="dev")
    # Defaults = best-of-family cell (#15).  NOTE: family verdict is DEAD —
