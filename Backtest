"""NQ vs ES statistical arbitrage. Index futures share a common factor, so the NQ residual
from its ES-implied value is a genuinely mean-reverting series (not a chart pattern).
Everything causal: hedge ratio and z-score use only a trailing window."""
import numpy as np, pandas as pd, warnings; warnings.filterwarnings('ignore')
df=pd.read_parquet('nq_v6.parquet')
m=(df.index.hour*60+df.index.minute)
d=df[(m>=570)&(m<960)].copy(); d['tod']=m[(m>=570)&(m<960)]; d['day']=d.index.normalize()
d=d.dropna(subset=['es_close'])
print(f'rows {len(d):,}  sessions {d.day.nunique()}  corr(nq,es) 1m returns: ',end='')
rn=np.log(d.c).diff(); re_=np.log(d.es_close).diff()
print(f'{rn.corr(re_):.4f}')

# ── causal spread: rolling hedge ratio on log prices, z-score of the residual ──
for W in [60,120,240]:
    ln, le = np.log(d.c.values), np.log(d.es_close.values)
    s=pd.Series(ln); t=pd.Series(le)
    cov=s.rolling(W).cov(t); var=t.rolling(W).var()
    beta=(cov/var).shift(1)                          # known at the bar open
    resid=s-beta*t
    mu=resid.rolling(W).mean().shift(1)
    sd=resid.rolling(W).std().shift(1)
    z=((resid-mu)/sd)
    d[f'z{W}']=z.values
    d[f'b{W}']=beta.values
    # half-life of the residual (Ornstein-Uhlenbeck) as a sanity check
    r=resid.dropna().values
    dr=np.diff(r); lag=r[:-1]
    b=np.polyfit(lag-lag.mean(),dr,1)[0]
    hl=np.log(2)/(-b) if b<0 else np.nan
    print(f'  W={W:3d}  beta median {pd.Series(beta).median():.3f}  '
          f'resid sd {resid.std():.5f}  OU half-life {hl:6.1f} bars  '
          f'|z|>2 on {(z.abs()>2).mean()*100:5.2f}% of bars')

# ── does an extreme z actually revert? forward NQ return by z bucket ──
print('\n=== forward NQ return (bps) by spread z-score, W=120 — causal ===')
z=d['z120']
print(f'  {"z bucket":>12s} {"n":>7s} ' + ' '.join(f'{f"+{h}m":>8s}' for h in [5,15,30,60]))
fwd={h: (np.log(d.c.shift(-h))-np.log(d.c))*1e4 for h in [5,15,30,60]}
