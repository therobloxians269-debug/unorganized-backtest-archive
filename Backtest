"""Shared performance + gauntlet stats (self-contained, no project deps)."""
from __future__ import annotations
import numpy as np
import pandas as pd
from scipy.stats import norm

EULER = 0.5772156649015329


def maxdd(r: pd.Series) -> float:
    eq = (1 + r).cumprod()
    return float((eq / eq.cummax() - 1).min())


def perf_stats(r: pd.Series, ppy: int) -> dict:
    r = r.dropna()
    if len(r) < 5 or r.std() == 0:
        return dict(cagr=0, vol=0, sharpe=0, sortino=0, calmar=0, maxdd=0)
    yrs = len(r) / ppy
    cagr = (1 + r).prod() ** (1 / yrs) - 1
    vol = r.std() * np.sqrt(ppy)
    sharpe = r.mean() / r.std() * np.sqrt(ppy)
    downside = r[r < 0].std()
    sortino = r.mean() / downside * np.sqrt(ppy) if downside > 0 else np.nan
    dd = maxdd(r)
    calmar = cagr / abs(dd) if dd < 0 else np.nan
    return dict(cagr=cagr, vol=vol, sharpe=sharpe, sortino=sortino, calmar=calmar, maxdd=dd)


def psr(r: pd.Series, sr_star_ann: float, ppy: int) -> float:
    """Probabilistic Sharpe Ratio: P(true SR > sr_star). sr_star is ANNUALIZED."""
    r = r.dropna().values
    n = len(r)
    if n < 10 or r.std() == 0:
        return np.nan
    sr = r.mean() / r.std()                       # per-period
    sr_star = sr_star_ann / np.sqrt(ppy)          # per-period benchmark
    sk = pd.Series(r).skew()
    ku = pd.Series(r).kurt() + 3                   # pandas kurt is excess
    denom = np.sqrt(1 - sk * sr + (ku - 1) / 4 * sr ** 2)
    return float(norm.cdf((sr - sr_star) * np.sqrt(n - 1) / denom))


def deflated_sharpe(r: pd.Series, n_trials: int, sr_trial_var_ann: float, ppy: int) -> float:
    """DSR: PSR against a benchmark SR* inflated for n_trials of selection."""
    v = sr_trial_var_ann / ppy                    # per-period variance of trial SRs
    if v <= 0 or n_trials < 2:
        return psr(r, 0.0, ppy)
    e1 = norm.ppf(1 - 1.0 / n_trials)
    e2 = norm.ppf(1 - 1.0 / (n_trials * np.e))
    sr_star = np.sqrt(v) * ((1 - EULER) * e1 + EULER * e2)   # per-period
    return psr(r, sr_star * np.sqrt(ppy), ppy)


def per_year(r: pd.Series) -> pd.Series:
    return r.groupby(r.index.year).apply(lambda x: (1 + x).prod() - 1)


def line(tag: str, r: pd.Series, ppy: int):
    s = perf_stats(r, ppy)
    print(f"  {tag:14s} CAGR {s['cagr']*100:6.1f}% | vol {s['vol']*100:4.0f}% | "
          f"Sharpe {s['sharpe']:5.2f} | Sortino {s['sortino']:5.2f} | "
          f"maxDD {s['maxdd']*100:6.1f}% | Calmar {s['calmar']:4.2f}")

