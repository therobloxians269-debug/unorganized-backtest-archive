"""TREND sleeve with the CE-50% entry: a displacement breaks structure, then instead of
chasing you LIMIT at the 50% of the displacement candle. Same mechanism as the fade sleeve."""
import numpy as np, pandas as pd, warnings; warnings.filterwarnings('ignore')
TICK=0.25; FLAT=959
def run(df, swing=20, dispATR=1.0, ce=0.5, rr=3.0, buf=2.0, pv=2.0, comm=1.50,
        maxwait=45, maxhold=240, min_stop=1.5, max_stop=60., cooldown=15, rth_only=True):
    o,h,l,c=df.o.values,df.h.values,df.l.values,df.c.values
    m=(df.index.hour*60+df.index.minute).values; n=len(df)
    atr=pd.Series(h-l).rolling(60).mean().shift(1).values
    hh=pd.Series(h).rolling(swing).max().shift(1).values
    ll=pd.Series(l).rolling(swing).min().shift(1).values
    out=[]; last=-10**9
    for i in range(swing+60, n-2):
        if i<=last+cooldown: continue
        if rth_only and not (570<=m[i]<FLAT): continue
        if not np.isfinite(atr[i]) or atr[i]<=0: continue
        rng=h[i]-l[i]
        if rng < dispATR*atr[i]: continue
        up = c[i]>hh[i] and c[i]>o[i]        # displacement UP through structure
        dn = c[i]<ll[i] and c[i]<o[i]
        if not (up or dn): continue
        d = 1 if up else -1
        # CE of the displacement candle: retrace into it and buy the 50%
        lim = (h[i]-ce*rng) if d==1 else (l[i]+ce*rng)
        stp = (l[i]-buf) if d==1 else (h[i]+buf)
        if (d==1 and stp>=lim) or (d==-1 and stp<=lim): continue
        risk=abs(lim-stp)
        if risk<min_stop or risk>max_stop: continue
        fill=-1
        for k in range(i+1,min(i+1+maxwait,n)):
            if m[k]>=FLAT: break
            if (l[k]<=lim) if d==1 else (h[k]>=lim): fill=k; break
        if fill<0:
            out.append(dict(t=df.index[i],d=d,filled=0,pnl=0.0,R=np.nan,why='nofill')); continue
        tgt=lim+d*rr*risk
        for k in range(fill+1,min(fill+maxhold,n)):
            lastb=m[k]>=FLAT or k==n-1
            hs=(l[k]<=stp) if d==1 else (h[k]>=stp)
            ht=(h[k]>=tgt) if d==1 else (l[k]<=tgt)
            if hs: px=stp-d*TICK; why='stop'
            elif ht: px=tgt; why='tgt'
            elif lastb: px=c[k]; why='time'
            else: continue
            pnl=d*(px-lim)*pv-comm
            out.append(dict(t=df.index[i],d=d,filled=1,pnl=pnl,R=pnl/(risk*pv),why=why,risk=risk))
            last=k; break
    return pd.DataFrame(out)

