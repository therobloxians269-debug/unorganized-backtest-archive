"""Genuine 5-MINUTE strategies on real ES (1m -> 5m RTH bars), 2010-2026.
Everything computed on 5-min bars. Selective (<=1 trade/day) to respect MES
friction. Two structures: (A) trend breakout of prior-K 5m bars filtered by
session VWAP, ride to EOD; (B) VWAP reversion. Net at 0.50 and 0.75 pt."""
import math
import numpy as np, pandas as pd

PT_USD=5.0
def hac_t(y,lags=5):
    y=np.asarray(y,float); n=y.size
    if n<10 or np.allclose(y,0): return 0.0
    e=y-y.mean(); s=(e@e)/n
    for l in range(1,min(lags,n-1)+1): s+=2*(1-l/(lags+1))*(e[l:]@e[:-l])/n
    return float(y.mean()/math.sqrt(max(s,1e-12)/n))

def load_5m():
    df=pd.read_parquet("/Users/kaveh/mim_research/es_front_rth_1m.parquet")
    df["date"]=pd.to_datetime(df["date"]).dt.date
    hm=df["hm"].str.split(":",expand=True)
    df["mos"]=(hm[0].astype(int)*60+hm[1].astype(int))-(9*60+30)
    df=df[(df["mos"]>=0)&(df["mos"]<390)].copy()
    df["b5"]=df["mos"]//5                       # 5-min bar index 0..77
    g=df.groupby(["date","b5"])
    b=pd.DataFrame({"open":g["open"].first(),"high":g["high"].max(),"low":g["low"].min(),
                    "close":g["close"].last(),"vol":g["volume"].sum()}).reset_index()
    return b

def trend_breakout(bars, K, fric):
    """Long when a 5m bar closes above prior-K 5m-bar high AND above VWAP;
    short mirror. First signal/day only. Stop = prior-K opposite extreme. EOD exit."""
    pnl=[];yr=[]
    for dte,g in bars.groupby("date",sort=True):
        g=g.reset_index(drop=True); n=len(g)
        if n<K+5: continue
        o=g["open"].to_numpy();h=g["high"].to_numpy();l=g["low"].to_numpy();c=g["close"].to_numpy();v=g["vol"].to_numpy()
        tp=(h+l+c)/3.0; vwap=np.cumsum(tp*v)/np.maximum(np.cumsum(v),1)
        took=False
        for i in range(K, n-1):
            hh=np.max(h[i-K:i]); ll=np.min(l[i-K:i])
            longsig  = c[i]>hh and c[i]>vwap[i]
            shortsig = c[i]<ll and c[i]<vwap[i]
            if not (longsig or shortsig): continue
            d=1 if longsig else -1
            entry=c[i]; stop=ll if d>0 else hh
            if abs(entry-stop)<=0: break
            exit_px=c[n-1]
            for j in range(i+1,n):
                if (l[j]<=stop) if d>0 else (h[j]>=stop): exit_px=stop; break
            pnl.append(d*(exit_px-entry)-fric); yr.append(dte.year); took=True; break
        # if no signal, no trade
    return np.array(pnl),np.array(yr)

def vwap_reversion(bars, z, fric):
    """Fade extension: long when close < VWAP - z*intraday_sigma (and turning up),
    target VWAP, stop = 2x further. First signal/day only."""
    pnl=[];yr=[]
    for dte,g in bars.groupby("date",sort=True):
        g=g.reset_index(drop=True); n=len(g)
        if n<12: continue
        h=g["high"].to_numpy();l=g["low"].to_numpy();c=g["close"].to_numpy();v=g["vol"].to_numpy()
        tp=(h+l+c)/3.0; vwap=np.cumsum(tp*v)/np.maximum(np.cumsum(v),1)
        dev=c-vwap; sig=np.sqrt(np.cumsum(dev**2)/np.maximum(np.arange(1,n+1),1))
        for i in range(6, n-1):
            if sig[i]<=0: continue
            ext=dev[i]/sig[i]
            longsig = ext<=-z and c[i]>c[i-1]     # extended below, turning up
            shortsig= ext>= z and c[i]<c[i-1]
            if not (longsig or shortsig): continue
            d=1 if longsig else -1
            entry=c[i]; tgt=vwap[i]; stop=entry-d*abs(entry-vwap[i])
            exit_px=c[n-1]
            for j in range(i+1,n):
                if (l[j]<=stop) if d>0 else (h[j]>=stop): exit_px=stop; break
                if (h[j]>=tgt) if d>0 else (l[j]<=tgt): exit_px=tgt; break
            pnl.append(d*(exit_px-entry)-fric); yr.append(dte.year); break
    return np.array(pnl),np.array(yr)

def summ(pnl,lbl):
    n=pnl.size
    if n<10: return {"cell":lbl,"n":n}
    win=pnl[pnl>0];los=pnl[pnl<=0]
    pf=(win.sum()/abs(los.sum())) if los.size and los.sum()!=0 else float('inf')
    return {"cell":lbl,"n":n,"net_pt":round(float(pnl.mean()),3),
            "ann_usd":round(float(pnl.sum()/(n/252)*PT_USD),0),"hit":round(float((pnl>0).mean()),3),
            "pf":round(float(pf),2),"hac_t":round(hac_t(pnl),2)}

def main():
    b=load_5m()
    print(f"{b['date'].nunique()} sessions, 5-min bars {b['date'].min()}..{b['date'].max()}\n")
    rows=[]
    for fric in (0.50,0.75):
        for K in (3,6,12):
            pnl,yr=trend_breakout(b,K,fric)
            rows.append(summ(pnl,f"BRK K{K} f{fric} FULL"))
            rows.append(summ(pnl[yr>=2018],f"BRK K{K} f{fric} OOS18+"))
        for z in (1.5,2.5):
            pnl,yr=vwap_reversion(b,z,fric)
            rows.append(summ(pnl,f"REV z{z} f{fric} FULL"))
            rows.append(summ(pnl[yr>=2018],f"REV z{z} f{fric} OOS18+"))
    pd.set_option("display.width",200)
    print(pd.DataFrame(rows).to_string(index=False))

if __name__=="__main__": main()

