#!/usr/bin/env python3
"""
MES Multi-Level OFI / VPIN / Square-Root-Impact backtest engine.

Implements the 8-equation system end-to-end against Databento MES MBO data:
    (0) dollar bars                  -> make_dollar_bars
    (1)-(2) depth-normalized M-OFI   -> reconstruct_book + compute_ofi
    (3) drift  mu_k = g*Phi*exp(-l*d)-> mu = cal.g * Phi
    (4) VPIN -> gamma_k              -> compute_vpin
    (5) conditional vol sigma_k      -> compute_vol
    (6) impact-aware target q*_k     -> sizer_target
    (7) no-trade band -> q_k         -> sizer_execute
    (8) realised PnL with real fills -> backtest + fill sim

UNITS (pin these or the FOC breaks):
    mu_k, c, sigma_k  : DOLLARS per contract per bar (sigma absorbs M)
    gamma             : 1/$  (absolute risk aversion over $ PnL)
    eta               : dimensionless
    q                 : contracts

Run:
    python mes_ofi_backtest.py --smoke                      # synthetic self-test
    python mes_ofi_backtest.py --data trades.parquet --mbo mbo.parquet
"""
from __future__ import annotations
import argparse, json, math
import numpy as np
import polars as pl
from dataclasses import dataclass
from scipy.stats import norm

M_MES   = 5.0      # $ per index point
TICK    = 0.25     # index points
PRICE_SCALE = 1e-9 # databento DBN fixed-point. CSV exports may already be float -> set 1.0

# ----------------------------------------------------------------------------
# (0) DOLLAR BARS
# ----------------------------------------------------------------------------
def make_dollar_bars(trades: pl.DataFrame, dollar_thr: float, mult: float = M_MES) -> pl.DataFrame:
    """trades: columns [ts_event(int ns), price(float pts), size(int)]. Returns one row/bar."""
    notional = (trades["price"] * trades["size"] * mult)
    bar_id = (notional.cum_sum() // dollar_thr).cast(pl.Int64)
    df = trades.with_columns(bar_id=bar_id)
    bars = (df.group_by("bar_id", maintain_order=True)
              .agg(ts_open=pl.col("ts_event").first(),
                   ts_close=pl.col("ts_event").last(),
                   P=pl.col("price").last(),
                   P_open=pl.col("price").first(),
                   V=pl.col("size").sum(),
                   dP=(pl.col("price").last() - pl.col("price").first()))
              .sort("bar_id"))
    return bars

# ----------------------------------------------------------------------------
# (1)-(2) L3 BOOK RECONSTRUCTION + MULTI-LEVEL OFI
# ----------------------------------------------------------------------------
def reconstruct_book(mbo: pl.DataFrame, levels: int):
    """
    mbo: [ts_event, action(str A/C/M/R/T), side(str B/A/N), order_id(int),
          price(float pts), size(int)].
    Book driven by A/C/M/R. Returns per-event top-L snapshot arrays + ts.
    """
    bids: dict[float, int] = {}   # price -> aggregate resting size
    asks: dict[float, int] = {}
    orders: dict[int, tuple] = {} # order_id -> (side, price, size)

    n = mbo.height
    ts_arr = mbo["ts_event"].to_numpy()
    act = mbo["action"].to_list()
    sd  = mbo["side"].to_list()
    oid = mbo["order_id"].to_numpy()
    px  = mbo["price"].to_numpy()
    sz  = mbo["size"].to_numpy()

    L = levels
    out_ts = np.empty(n, dtype=np.int64)
    bpx = np.full((n, L), np.nan); bsz = np.zeros((n, L))
    apx = np.full((n, L), np.nan); asz = np.zeros((n, L))

    def book_remove(book, price, size):
        if price in book:
            book[price] -= size
            if book[price] <= 0:
                book.pop(price, None)

    def topL(book, side):
        if not book:
            return (np.full(L, np.nan), np.zeros(L))
        keys = sorted(book.keys(), reverse=(side == "B"))[:L]   # bids high->low, asks low->high
        p = np.full(L, np.nan); s = np.zeros(L)
        for i, k in enumerate(keys):
            p[i] = k; s[i] = book[k]
        return p, s

    for i in range(n):
        a = act[i]
        if a == "R":                                   # clear book
            bids.clear(); asks.clear(); orders.clear()
        elif a == "A":                                 # add resting order
            book = bids if sd[i] == "B" else asks if sd[i] == "A" else None
            if book is not None:
                book[px[i]] = book.get(px[i], 0) + int(sz[i])
                orders[int(oid[i])] = (sd[i], px[i], int(sz[i]))
        elif a == "C":                                 # cancel
            o = orders.pop(int(oid[i]), None)
            if o is not None:
                book = bids if o[0] == "B" else asks
                book_remove(book, o[1], o[2])
        elif a == "M":                                 # modify (cancel+replace)
            o = orders.pop(int(oid[i]), None)
            if o is not None:
                bk = bids if o[0] == "B" else asks
                book_remove(bk, o[1], o[2])
            book = bids if sd[i] == "B" else asks if sd[i] == "A" else None
            if book is not None:
                book[px[i]] = book.get(px[i], 0) + int(sz[i])
                orders[int(oid[i])] = (sd[i], px[i], int(sz[i]))
        elif a == "T":                                 # trade consumes resting size
            # DBN trade 'side' = aggressor side; resting removed from the OTHER book.
            if sd[i] == "B":          # aggressive buy hits the ask
                book_remove(asks, px[i], int(sz[i]))
            elif sd[i] == "A":        # aggressive sell hits the bid
                book_remove(bids, px[i], int(sz[i]))
        out_ts[i] = ts_arr[i]
        bp, bs = topL(bids, "B"); ap, as_ = topL(asks, "A")
        bpx[i] = bp; bsz[i] = bs; apx[i] = ap; asz[i] = as_

    return dict(ts=out_ts, bid_px=bpx, bid_sz=bsz, ask_px=apx, ask_sz=asz)


def compute_ofi(book, bar_close_ts: np.ndarray, levels: int, kappa: float) -> np.ndarray:
    """Cont-Kukanov-Stoikov OFI per level, depth-normalized, summed with exp weights.
       Returns Phi_k aligned to bars (len = len(bar_close_ts))."""
    L = levels
    w = np.exp(-kappa * np.arange(L)); w /= w.sum()

    bpx, bsz = book["bid_px"], book["bid_sz"]
    apx, asz = book["ask_px"], book["ask_sz"]
    ts = book["ts"]

    e = np.zeros((len(ts), L))
    for l in range(L):
        bp, bp0 = bpx[1:, l], bpx[:-1, l]
        bs, bs0 = bsz[1:, l], bsz[:-1, l]
        ap, ap0 = apx[1:, l], apx[:-1, l]
        as_, as0 = asz[1:, l], asz[:-1, l]
        bp = np.nan_to_num(bp); bp0 = np.nan_to_num(bp0)   # empty level -> price unchanged, size 0
        ap = np.nan_to_num(ap); ap0 = np.nan_to_num(ap0)
        eb = (bp >= bp0) * bs - (bp <= bp0) * bs0
        ea = (ap <= ap0) * as_ - (ap >= ap0) * as0
        e[1:, l] = eb - ea

    # mean depth per level for normalization. FLOOR at MIN_DEPTH (not epsilon):
    # a tiny epsilon would make contrib/eps EXPLODE when depth vanishes; flooring
    # keeps the normalized signal bounded when liquidity dries up.
    MIN_DEPTH = 1.0
    depth = np.maximum(0.5 * (bsz + asz), MIN_DEPTH)
    bar_of_event = np.searchsorted(bar_close_ts, ts, side="left")
    nb = len(bar_close_ts)
    Phi = np.zeros(nb)
    for l in range(L):
        normed = e[:, l] / depth[:, l]
        np.add.at(Phi, np.clip(bar_of_event, 0, nb - 1), w[l] * normed)
    return Phi

# ----------------------------------------------------------------------------
# (4) VPIN
# ----------------------------------------------------------------------------
def compute_vpin(bars: pl.DataFrame, window_n: int, sig_warmup: int = 50) -> np.ndarray:
    dP = bars["dP"].to_numpy()
    V  = bars["V"].to_numpy().astype(float)
    # CAUSAL sigma_dP: expanding std using ONLY past bars (no whole-sample leak).
    sig = np.empty(len(dP))
    for k in range(len(dP)):
        hist = dP[:k][~np.isnan(dP[:k])]
        sig[k] = np.std(hist) if len(hist) >= sig_warmup and np.std(hist) > 0 else np.nan
    fallback = np.nanstd(dP[~np.isnan(dP)][:sig_warmup]) or 1.0
    sig[np.isnan(sig)] = fallback
    sig[sig <= 0] = 1.0
    buy_frac = norm.cdf(dP / sig)
    Vbuy = V * buy_frac
    imbalance = np.abs(2 * Vbuy - V)               # |buy - sell| (direction-agnostic by design)
    Vb = np.nanmean(V) or 1.0
    vpin = np.full(len(V), np.nan)
    csum = np.cumsum(np.insert(imbalance, 0, 0.0))
    for k in range(len(V)):
        lo = max(0, k - window_n + 1)
        s = csum[k + 1] - csum[lo]
        cnt = (k - lo + 1)
        vpin[k] = s / (cnt * Vb)
    return np.clip(vpin, 0, 1)

# ----------------------------------------------------------------------------
# (5) CONDITIONAL VOL
# ----------------------------------------------------------------------------
def compute_vol(bars: pl.DataFrame, window_W: int, mult: float = M_MES) -> np.ndarray:
    """sigma_k in $/contract = mult * std(price change), causal window ending at k-1."""
    P = bars["P"].to_numpy()
    dP = np.diff(P, prepend=P[0])
    sig = np.full(len(P), np.nan)
    for k in range(len(P)):
        lo = max(0, k - window_W)
        seg = dP[lo:k]                             # strictly < k
        if len(seg) >= 2:
            sig[k] = mult * np.std(seg, ddof=1)
    first = np.nanmin(np.where(~np.isnan(sig))[0]) if np.any(~np.isnan(sig)) else 0
    sig[:first] = sig[first] if not np.isnan(sig[first]) else mult * TICK
    sig[np.isnan(sig)] = np.nanmedian(sig)
    sig[sig <= 0] = mult * TICK
    return sig

# ----------------------------------------------------------------------------
# (3) SIGNAL + CALIBRATION (TRAIN ONLY)
# ----------------------------------------------------------------------------
@dataclass
class Calib:
    g: float; g_lo: float; g_hi: float
    eta: float; lam: float; c: float

def calibrate(Phi_tr, P_tr, V_tr, sigma_tr, fee_rt: float, mult: float = M_MES) -> Calib:
    """g: slope of next-bar $ move on Phi (THE alpha, with 95% CI).
       eta: impact const from |dP|$ ~ sigma*sqrt(|dV|/V).  lam: from Phi autocorr.
       c: round-trip $ = fees + spread cross (passed in)."""
    dP_next = np.diff(P_tr) * mult                 # $ move bar k -> k+1
    x = Phi_tr[:-1]; y = dP_next
    msk = np.isfinite(x) & np.isfinite(y)
    x, y = x[msk], y[msk]
    if len(x) > 30 and np.std(x) > 0:
        b = np.polyfit(x, y, 1)[0]
        resid = y - b * x
        se = np.sqrt(np.sum(resid**2) / (len(x) - 2)) / (np.std(x) * math.sqrt(len(x)))
        g, g_lo, g_hi = b, b - 1.96 * se, b + 1.96 * se
    else:
        g = g_lo = g_hi = 0.0
    # eta: regress realized |dP|$ on sigma*sqrt(traded/Vbar) (square-root law)
    dPa = np.abs(np.diff(P_tr)) * mult
    vproxy = sigma_tr[:-1] * np.sqrt(np.maximum(V_tr[:-1], 1) / max(np.mean(V_tr), 1))
    m2 = np.isfinite(dPa) & np.isfinite(vproxy) & (vproxy > 0)
    eta = float(np.clip(np.polyfit(vproxy[m2], dPa[m2], 1)[0], 1e-4, 10)) if m2.sum() > 30 else 0.1
    # lam: autocorr half-life of Phi
    pc = Phi_tr[np.isfinite(Phi_tr)]
    if len(pc) > 10 and np.std(pc) > 0:
        ac1 = np.corrcoef(pc[:-1], pc[1:])[0, 1]
        lam = -math.log(max(abs(ac1), 1e-3)) if ac1 > 0 else 1.0
    else:
        lam = 1.0
    return Calib(g, g_lo, g_hi, eta, lam, fee_rt)

# ----------------------------------------------------------------------------
# (6)-(7) SIZER: impact-aware target + no-trade band
# ----------------------------------------------------------------------------
@dataclass
class SizerCfg:
    gamma: float; phi: float; vpin_max: float
    theta: float = 0.0          # vol-hurdle multiplier (your theta*sigma gate term)
    q_max: float = 1e9          # hard inventory cap (contracts)

def sizer_target(mu, sigma, V, vpin, cal: Calib, cfg: SizerCfg, delta=None):
    if delta is None: delta = np.zeros_like(mu)
    mu_eff = mu * np.exp(-cal.lam * delta)
    gk = cfg.gamma * (1.0 + cfg.phi * vpin)
    edge = np.abs(mu_eff) - (cal.c + cfg.theta * sigma)   # net edge over cost + vol hurdle
    a = gk * sigma**2
    b = 1.5 * cal.eta * sigma / np.sqrt(np.maximum(V, 1))
    disc = b**2 + 4 * a * np.maximum(edge, 0.0)
    u = (-b + np.sqrt(disc)) / (2 * a)
    gate = (edge > 0) & (vpin < cfg.vpin_max)
    qstar = np.where(gate, np.sign(mu_eff) * u**2, 0.0)
    qstar = np.clip(qstar, -cfg.q_max, cfg.q_max)
    return qstar, gk, mu_eff

def sizer_execute(qstar, mu_eff, sigma, gk, cal: Calib, q_max: float = 1e9):
    """(7) no-trade band: hold unless |grad| > c, else snap to qstar."""
    q = 0.0
    pos = np.empty_like(qstar)
    for k in range(len(qstar)):
        grad = mu_eff[k] - gk[k] * sigma[k]**2 * q
        if abs(grad) > cal.c:
            q = qstar[k]
        q = max(-q_max, min(q_max, q))
        pos[k] = q
    return pos

# ----------------------------------------------------------------------------
# (8) FILL SIMULATION
# ----------------------------------------------------------------------------
def taker_cost(dq, best_bid, best_bid_sz, best_ask, best_ask_sz, fee_per_side, mult=M_MES):
    """EXACT for top-of-book; walk deeper levels in the full version.
       Returns $ cost (>=0) of crossing the spread for |dq| contracts."""
    if dq == 0 or np.isnan(best_bid) or np.isnan(best_ask):
        return abs(dq) * fee_per_side
    mid = 0.5 * (best_bid + best_ask)
    slip_pts = (best_ask - mid) if dq > 0 else (mid - best_bid)
    return abs(dq) * (slip_pts * mult + fee_per_side)

def maker_markout_cost(dq, best_bid, best_ask, future_mid, fee_per_side, mult=M_MES):
    """Approximate maker fill: earn half-spread, pay adverse-selection markout.
       future_mid = mid a few events after fill. Cost can be negative (you earned
       spread net of selection). The honest number lives here -> harden this first."""
    if dq == 0 or np.isnan(best_bid) or np.isnan(best_ask):
        return abs(dq) * fee_per_side
    mid = 0.5 * (best_bid + best_ask)
    if dq > 0:                       # rest at bid
        earn_pts = (mid - best_bid)
        adverse_pts = (mid - future_mid)        # >0 if price fell after you bought
    else:                            # rest at ask
        earn_pts = (best_ask - mid)
        adverse_pts = (future_mid - mid)        # >0 if price rose after you sold
    net_pts = adverse_pts - earn_pts
    return abs(dq) * (net_pts * mult + fee_per_side)

# ----------------------------------------------------------------------------
# BACKTEST LOOP
# ----------------------------------------------------------------------------
def backtest(bars: pl.DataFrame, pos: np.ndarray, tob: dict, mode: str,
             fee_per_side: float, scale: float = 1.0, mult: float = M_MES):
    """PnL_k = pos[k-1]*(P_k-P_{k-1})*mult*scale - fill_cost(scale*dq)."""
    P = bars["P"].to_numpy()
    dP = np.diff(P, prepend=P[0])
    held = pos * scale
    dq = np.diff(held, prepend=0.0)
    gross = np.zeros(len(P)); cost = np.zeros(len(P))
    for k in range(len(P)):
        if k >= 1:
            gross[k] = held[k-1] * dP[k] * mult    # earn NEXT bar's move (no leak)
        if dq[k] != 0:
            if mode == "taker":
                cost[k] = taker_cost(dq[k], tob["bid"][k], tob["bid_sz"][k],
                                     tob["ask"][k], tob["ask_sz"][k], fee_per_side, mult)
            else:
                cost[k] = maker_markout_cost(dq[k], tob["bid"][k], tob["ask"][k],
                                             tob["fut_mid"][k], fee_per_side, mult)
    return gross - cost, gross, cost

# ----------------------------------------------------------------------------
# METRICS
# ----------------------------------------------------------------------------
def deflated_sharpe(sr, n_trials, n_obs, skew, kurt):
    """Lopez de Prado DSR. sr in per-obs units (not annualized)."""
    if n_obs < 10 or n_trials < 1:
        return float("nan")
    emax = (1 - np.euler_gamma) * norm.ppf(1 - 1.0/n_trials) + \
           np.euler_gamma * norm.ppf(1 - 1.0/(n_trials * math.e))
    sr0 = emax / math.sqrt(n_obs)
    denom = math.sqrt(max(1e-12, 1 - skew*sr + (kurt-1)/4*sr**2))
    z = (sr - sr0) * math.sqrt(n_obs - 1) / denom
    return float(norm.cdf(z))

def metrics(pnl: np.ndarray, ts_close: np.ndarray, n_trials: int = 1):
    pnl = pnl[1:]
    eq = np.cumsum(pnl)
    dd = eq - np.maximum.accumulate(eq)
    maxdd = dd.min() if len(dd) else 0.0
    if len(pnl) > 1:
        mu, sd = pnl.mean(), pnl.std(ddof=1)
    else:
        mu, sd = 0.0, 1.0
    sr_bar = mu / sd if sd > 0 else 0.0
    days = (ts_close[1:] // (86_400 * 1_000_000_000))   # daily resample for annualization
    daily = {}
    for d, p in zip(days, pnl):
        daily[d] = daily.get(d, 0.0) + p
    dvals = np.array(list(daily.values()))
    if len(dvals) > 1:
        dmu, dsd = dvals.mean(), dvals.std(ddof=1)
    else:
        dmu, dsd = (dvals.mean() if len(dvals) else 0.0), 0.0
    sharpe  = dmu/dsd*math.sqrt(252) if dsd > 0 else 0.0
    downside = dvals[dvals < 0]
    sortino = dmu/downside.std(ddof=1)*math.sqrt(252) if len(downside) > 1 and downside.std() > 0 else float("inf")
    calmar  = (dmu*252)/abs(maxdd) if maxdd < 0 else float("inf")
    from scipy.stats import skew as sk, kurtosis as ku
    dsr = deflated_sharpe(sr_bar, n_trials, len(pnl),
                          float(sk(pnl)) if len(pnl) > 2 else 0.0,
                          float(ku(pnl, fisher=False)) if len(pnl) > 2 else 3.0)
    return dict(total_pnl=float(eq[-1]) if len(eq) else 0.0, sharpe=sharpe,
                sortino=sortino, calmar=calmar, maxdd=float(maxdd),
                n_days=len(dvals), dsr=dsr, sr_per_bar=sr_bar)

def capacity_curve(bars, pos, tob, mode, fee, scales):
    rows = []
    for s in scales:
        pnl, g, c = backtest(bars, pos, tob, mode, fee, scale=s)
        m = metrics(pnl, bars["ts_close"].to_numpy())
        rows.append((s, m["sharpe"], m["total_pnl"], float(c.sum())))
    return rows

# ----------------------------------------------------------------------------
# TOP-OF-BOOK PER BAR (for fills)
# ----------------------------------------------------------------------------
def tob_per_bar(book, bar_close_ts):
    """Snapshot best bid/ask at each bar close + a forward mid for markout."""
    ts = book["ts"]
    idx = np.searchsorted(ts, bar_close_ts, side="right") - 1
    idx = np.clip(idx, 0, len(ts) - 1)
    bid = book["bid_px"][idx, 0]; bid_sz = book["bid_sz"][idx, 0]
    ask = book["ask_px"][idx, 0]; ask_sz = book["ask_sz"][idx, 0]
    mid = 0.5 * (np.nan_to_num(bid) + np.nan_to_num(ask))
    fut_idx = np.clip(idx + 20, 0, len(ts) - 1)    # ~20 events ahead for markout
    fut_mid = 0.5 * (np.nan_to_num(book["bid_px"][fut_idx, 0]) +
                     np.nan_to_num(book["ask_px"][fut_idx, 0]))
    return dict(bid=bid, bid_sz=bid_sz, ask=ask, ask_sz=ask_sz, mid=mid, fut_mid=fut_mid)

# ----------------------------------------------------------------------------
# DRIVER  (default config = Version B)
# ----------------------------------------------------------------------------
def run(trades, mbo, *, levels=5, kappa=0.5, dollar_thr=5e5, vpin_n=50, vol_W=50,
        gamma=2e-4, phi=5.0, vpin_max=0.6, theta=0.0, q_max=50.0, fee_rt=1.0,
        train_frac=0.6, n_trials=1, mode="taker",
        scale_for_capacity=(1, 2, 5, 10, 25, 50), force_g=None):
    bars = make_dollar_bars(trades, dollar_thr)
    bct = bars["ts_close"].to_numpy()
    book = reconstruct_book(mbo, levels)
    Phi   = compute_ofi(book, bct, levels, kappa)
    vpin  = compute_vpin(bars, vpin_n)
    sigma = compute_vol(bars, vol_W)
    P = bars["P"].to_numpy(); V = bars["V"].to_numpy().astype(float)

    # ---- leak guards ----
    assert len(Phi) == bars.height == len(vpin) == len(sigma), "feature/bar length mismatch"
    assert np.all(np.diff(bct) >= 0), "bars not time-sorted"

    # ---- train/test split (time-ordered) ----
    nb = bars.height; cut = int(nb * train_frac)
    cal = calibrate(Phi[:cut], P[:cut], V[:cut], sigma[:cut], fee_rt)
    print(f"[calib] g={cal.g:.4f} 95%CI=[{cal.g_lo:.4f},{cal.g_hi:.4f}]  "
          f"eta={cal.eta:.4f}  lam={cal.lam:.3f}  c=${cal.c:.2f}/ctr")
    if cal.g_lo <= 0 <= cal.g_hi:
        print("[KILL-SWITCH] g CI straddles 0 -> no next-bar OFI alpha in-sample. "
              "Strategy gates to flat. This is the correct result, not a bug.")
    if force_g is not None:
        cal.g = force_g
        print(f"[force] overriding g={force_g} to exercise sizing/fill/PnL path")

    # ---- signal + size. Train-frozen params; OOS executed STARTING FLAT ----
    mu = cal.g * Phi                                       # (3) drift = g * alpha
    cfg = SizerCfg(gamma, phi, vpin_max, theta, q_max)
    qstar, gk, mu_eff = sizer_target(mu, sigma, V, vpin, cal, cfg)

    tob = tob_per_bar(book, bct)

    # ---- OOS evaluation (test slice only, position starts at 0) ----
    pos_oos = sizer_execute(qstar[cut:nb], mu_eff[cut:nb], sigma[cut:nb],
                            gk[cut:nb], cal, q_max=q_max)
    bars_oos = bars[cut:nb]
    tob_oos = {k: v[cut:nb] for k, v in tob.items()}
    pnl, gross, cost = backtest(bars_oos, pos_oos, tob_oos, mode, fee_rt)
    m = metrics(pnl, bars_oos["ts_close"].to_numpy(), n_trials=n_trials)

    print(f"\n[OOS {mode}] bars={len(pos_oos)}  days={m['n_days']}")
    print(f"  net PnL=${m['total_pnl']:.0f}  Sharpe={m['sharpe']:.2f}  "
          f"Sortino={m['sortino']:.2f}  Calmar={m['calmar']:.2f}  maxDD=${m['maxdd']:.0f}")
    print(f"  gross=${gross.sum():.0f}  cost=${cost.sum():.0f}  "
          f"cost/gross={cost.sum()/(abs(gross.sum())+1e-9):.1%}  DSR={m['dsr']:.2f}")
    print(f"  turnover (contracts traded)={np.abs(np.diff(pos_oos, prepend=0)).sum():.0f}")

    print(f"\n[capacity {mode}] scale -> net Sharpe / net PnL / cost")
    for s, sh, tp, cst in capacity_curve(bars_oos, pos_oos, tob_oos, mode, fee_rt, scale_for_capacity):
        print(f"  x{s:>4}: Sharpe={sh:6.2f}  PnL=${tp:>10.0f}  cost=${cst:>10.0f}")
    return m

# ----------------------------------------------------------------------------
# SYNTHETIC SMOKE TEST  (test scaffolding — ignore on real data)
# ----------------------------------------------------------------------------
def synth(seed=0, n_events=60000):
    rng = np.random.default_rng(seed)
    ts = np.cumsum(rng.integers(1_000_000, 50_000_000, n_events))
    mid = 5000.0
    rows_mbo = []; rows_tr = []
    next_oid = 1
    drift = 0.0
    for i in range(n_events):
        drift = 0.95 * drift + rng.normal(0, 0.02)
        mid += drift * TICK + rng.normal(0, 0.05) * TICK
        mid = round(mid / TICK) * TICK
        bid = mid - TICK; ask = mid + TICK
        r = rng.random()
        if r < 0.45:
            side = "B" if rng.random() < 0.5 + 0.3*np.tanh(drift) else "A"
            px = bid if side == "B" else ask
            sz = int(rng.integers(1, 20))
            rows_mbo.append((ts[i], "A", side, next_oid, px, sz)); next_oid += 1
        elif r < 0.75:
            if next_oid > 2:
                oid = int(rng.integers(max(1, next_oid-200), next_oid))
                rows_mbo.append((ts[i], "C", "N", oid, 0.0, 0))
        else:
            agg = "B" if drift > 0 else "A"
            px = ask if agg == "B" else bid
            sz = int(rng.integers(1, 10))
            rows_mbo.append((ts[i], "T", agg, 0, px, sz))
            rows_tr.append((ts[i], px, sz))
    mbo = pl.DataFrame(rows_mbo, schema=["ts_event","action","side","order_id","price","size"], orient="row")
    trades = pl.DataFrame(rows_tr, schema=["ts_event","price","size"], orient="row")
    return trades, mbo

if __name__ == "__main__":
    ap = argparse.ArgumentParser()
    ap.add_argument("--smoke", action="store_true")
    ap.add_argument("--data", type=str, default=None)
    ap.add_argument("--mbo", type=str, default=None)
    ap.add_argument("--mode", type=str, default="taker", choices=["taker","maker"])
    args = ap.parse_args()

    if args.smoke:
        print("=== SYNTHETIC SMOKE TEST (no real data) ===")
        trades, mbo = synth()
        print(f"events={mbo.height}  trades={trades.height}")
        for mode in ("taker", "maker"):
            print(f"\n----- mode={mode} -----")
            run(trades, mbo, dollar_thr=2.5e5, vpin_n=30, vol_W=30,
                gamma=2e-4, phi=5.0, fee_rt=1.0, mode=mode, n_trials=20)
    else:
        trades = pl.read_parquet(args.data)   # map your columns to the canonical names first
        mbo = pl.read_parquet(args.mbo)
        run(trades, mbo, mode=args.mode)

