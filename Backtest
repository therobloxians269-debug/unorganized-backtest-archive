  CRYPTO_SLEEVE.md       auto-rendered current snapshot + per-name table

Idempotent per date: re-running the same day replaces today's rows (so the daily job
and an ad-hoc manual snapshot don't double-count). Prints a DIFF vs the previous
snapshot (opened / closed / resized) so each run shows what changed.

NOTE: this is the genuinely-executed PAPER sleeve (crypto). It is a net-position
SNAPSHOT, not a live fill feed -- a position opened and closed between snapshots shows
only as the net change. Tamper-evidence for the record comes from the git commit
timestamps and the hash-chained equity ledger (see record_daily.py / verify_chain.py).
"""
import sys, json, csv, os, datetime as dt

HERE = os.path.dirname(os.path.abspath(__file__))
PAPER = sys.argv[1] if len(sys.argv) > 1 else os.path.join(HERE, ".paper.json")
POS   = os.path.join(HERE, "crypto_positions.csv")
BAL   = os.path.join(HERE, "crypto_balance.csv")
MD    = os.path.join(HERE, "CRYPTO_SLEEVE.md")

POS_COLS = ["timestamp", "date", "symbol", "side", "size", "entryPx", "markPx",
            "unrealizedPnl", "returnOnEquity", "leverage", "leverageType",
            "marginUsed", "liquidationPx", "tp", "sl"]
BAL_COLS = ["timestamp", "date", "equity", "available_balance", "margin_used",
            "net_unrealized_pnl", "n_positions", "gross_notional"]


def fnum(x, d=0.0):
    try:
        return float(x)
    except (TypeError, ValueError):
        return d


def read_rows(path):
    return list(csv.DictReader(open(path))) if os.path.exists(path) else []


def prev_snapshot():
    """{symbol: size} from the most recent snapshot on an EARLIER date (for the diff)."""
    rows = read_rows(POS)
    dates = [r["date"] for r in rows]
    today = dt.date.today().isoformat()
    earlier = [d for d in dates if d != today]
    if not earlier:
        return None, {}
    pdate = earlier[-1]
    return pdate, {r["symbol"]: fnum(r["size"]) for r in rows if r["date"] == pdate}


def main():
    if not os.path.exists(PAPER):
        sys.exit(f"[crypto] no portfolio JSON at {PAPER} -- run the get_portfolio step first")
    p = json.load(open(PAPER))
    acct = p.get("account", {}) or {}
    positions = p.get("positions", []) or []

    ts   = dt.datetime.now().astimezone().isoformat(timespec="seconds")
    date = dt.date.today().isoformat()

    equity  = fnum(acct.get("equity") or acct.get("account_value"))
    avail   = fnum(acct.get("available_balance"))
    margin  = fnum(acct.get("margin_used"))
    net_pnl = sum(fnum(z.get("unrealizedPnl")) for z in positions)
    gross   = sum(abs(fnum(z.get("size"))) * fnum(z.get("markPx")) for z in positions)
    npos    = len(positions)

    # capture prior state BEFORE appending today's rows
    prev_date, prev = prev_snapshot()

    # ---- positions (idempotent per date) ----
    keep = [r for r in read_rows(POS) if r["date"] != date]
    with open(POS, "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=POS_COLS)
        w.writeheader(); w.writerows(keep)
        for z in positions:
            w.writerow({
                "timestamp": ts, "date": date,
                "symbol": z.get("symbol", ""), "side": z.get("side", ""),
                "size": z.get("size", ""), "entryPx": z.get("entryPx", ""),
                "markPx": z.get("markPx", ""), "unrealizedPnl": z.get("unrealizedPnl", ""),
                "returnOnEquity": z.get("returnOnEquity", ""),
                "leverage": z.get("leverage", ""), "leverageType": z.get("leverageType", ""),
                "marginUsed": z.get("marginUsed", ""), "liquidationPx": z.get("liquidationPx", ""),
                "tp": z.get("tp") or "", "sl": z.get("sl") or "",
            })

    # ---- balance (idempotent per date) ----
    keepb = [r for r in read_rows(BAL) if r["date"] != date]
    with open(BAL, "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=BAL_COLS)
        w.writeheader(); w.writerows(keepb)
        w.writerow({"timestamp": ts, "date": date, "equity": f"{equity:.2f}",
                    "available_balance": f"{avail:.2f}", "margin_used": f"{margin:.2f}",
                    "net_unrealized_pnl": f"{net_pnl:.2f}", "n_positions": npos,
                    "gross_notional": f"{gross:.2f}"})

    render(positions, equity, avail, margin, net_pnl, gross, date, ts)

    # ---- diff vs previous snapshot ----
    cur = {z.get("symbol", ""): fnum(z.get("size")) for z in positions}
    print(f"[crypto] {date}  equity=${equity:,.2f}  uPnL=${net_pnl:+,.2f}  "
          f"pos={npos}  gross=${gross:,.0f}")
    if prev_date:
        opened  = [s for s in cur if s not in prev]
        closed  = [s for s in prev if s not in cur]
        resized = [s for s in cur if s in prev and abs(cur[s] - prev[s]) > 1e-9]
        if opened or closed or resized:
            print(f"[crypto] vs {prev_date}: "
                  f"opened={opened or '-'} closed={closed or '-'} "
                  f"resized={[f'{s}:{prev[s]:g}->{cur[s]:g}' for s in resized] or '-'}")
        else:
            print(f"[crypto] vs {prev_date}: no position changes (marks only)")


def render(positions, equity, avail, margin, net_pnl, gross, date, ts):
    start = 10000.0
    ret = (equity / start - 1) * 100 if start else 0.0
    lines = [
        "# Crypto sleeve — Co-Invest paper account  *(forward record)*",
        f"*Auto-generated {date} · snapshot {ts}*", "",
        f"- **Equity:** ${equity:,.2f}  ({ret:+.2f}% vs ${start:,.0f} start)",
        f"- **Open unrealized PnL:** ${net_pnl:+,.2f}",
        f"- **Positions:** {len(positions)}  ·  gross notional ${gross:,.0f}  ·  "
        f"deployed margin ${margin:,.0f} ({(margin/equity*100) if equity else 0:.0f}%)  ·  "
        f"cash ${avail:,.0f}", "",
    ]
    if positions:
        lines += ["| Symbol | Side | Size | Entry | Mark | uPnL | ROE |",
                  "|---|---|---:|---:|---:|---:|---:|"]
        for z in sorted(positions, key=lambda x: fnum(x.get("unrealizedPnl")), reverse=True):
            lines.append(
                f"| {z.get('displayName') or z.get('symbol','')} | {z.get('side','')} | "
                f"{fnum(z.get('size')):g} | {fnum(z.get('entryPx')):g} | "
                f"{fnum(z.get('markPx')):g} | {fnum(z.get('unrealizedPnl')):+.2f} | "
                f"{fnum(z.get('returnOnEquity'))*100:+.1f}% |")
    lines += ["", "_Paper (simulated) forward record — proves no backfill, not live-audited P&L. "
              "Full history: `crypto_positions.csv` / `crypto_balance.csv`._"]
    open(MD, "w").write("\n".join(lines) + "\n")


if __name__ == "__main__":
    main()

