"""THE ROUTER — classify the day at 10:30 by opening directional efficiency, then run the
matching tactic. ONE trade per day. Trend day: limit at a pullback into the move.
Mean-reversion day: ping pong off the IB edges."""
import numpy as np, pandas as pd, warnings; warnings.filterwarnings('ignore')
TICK=0.25; FLAT=959
def run(df, thr=0.50, decide=630, pbk=0.5, trRR=2.0, mrTgt='mid', mrStop=0.5,
        pv=2.0, comm=1.50, maxwait=120):
    m=(df.index.hour*60+df.index.minute)
    r=df[(m>=570)&(m<960)].copy(); r['tod']=m[(m>=570)&(m<960)]; r['day']=r.index.normalize()
    out=[]
    for day,b in r.groupby('day'):
        if len(b)<300: continue
        o=b.o.iloc[0]
        pre=b[b.tod<=decide]
        if len(pre)<30: continue
        ibh=pre.h.max(); ibl=pre.l.min(); ib=ibh-ibl
        if ib<=0: continue
        pc=pre.c.iloc[-1]
        ib_de=abs(pc-o)/ib
        post=b[b.tod>decide]
        if len(post)<30: continue
        H=post.h.values; L=post.l.values; C=post.c.values; T=post.tod.values
        n=len(post)
        trend = ib_de>=thr
        if trend:
            d = 1 if pc>o else -1
            lim = pc - d*pbk*ib                      # pull back INTO the move
            stp = (ibl-TICK*2) if d==1 else (ibh+TICK*2)
            if (d==1 and stp>=lim) or (d==-1 and stp<=lim): continue
            risk=abs(lim-stp); tgt=lim+d*trRR*risk
        else:
            # ping pong: whichever IB edge gets touched first, fade it
            up=np.flatnonzero(H>=ibh); dn=np.flatnonzero(L<=ibl)
            iu=up[0] if len(up) else 10**9; idn=dn[0] if len(dn) else 10**9
            if min(iu,idn)==10**9: continue
            d = -1 if iu<idn else 1
            lim = ibh if d==-1 else ibl
            stp = lim + d*(-1)*mrStop*ib             # stop outside the edge
            risk=abs(lim-stp)
            tgt = (ibl+ibh)/2 if mrTgt=='mid' else (ibl if d==-1 else ibh)
            if (d==1 and tgt<=lim) or (d==-1 and tgt>=lim): continue
        fill=-1
        for k in range(n):
            if T[k]>=FLAT: break
            if (L[k]<=lim) if d==1 else (H[k]>=lim): fill=k; break
        if fill<0:
            out.append(dict(t=day,type='TREND' if trend else 'MEANREV',filled=0,pnl=0.0,R=np.nan,why='nofill')); continue
        for k in range(fill+1,n):
            last=T[k]>=FLAT or k==n-1
            hs=(L[k]<=stp) if d==1 else (H[k]>=stp)
            ht=(H[k]>=tgt) if d==1 else (L[k]<=tgt)
            if hs: px=stp-d*TICK; why='stop'
            elif ht: px=tgt; why='tgt'
            elif last: px=C[k]; why='time'
            else: continue
            pnl=d*(px-lim)*pv-comm
            out.append(dict(t=day,type='TREND' if trend else 'MEANREV',filled=1,d=d,
                            pnl=pnl,R=pnl/(risk*pv),why=why,risk=risk)); break
    return pd.DataFrame(out)

if __name__=='__main__':
    df=pd.read_parquet('nq_v6.parquet')
    sel=df[pd.DatetimeIndex(df.index).year<=2024]
    print('=== SELECT on NQ 2023-24 only ===')
    print(f'  {"thr":>5s} {"pbk":>5s} {"trRR":>5s} {"n":>4s} {"/day":>5s} {"$/tr":>7s} {"WR%":>5s} {"TREND $/tr":>11s} {"MR $/tr":>9s} {"risk$":>6s}')
