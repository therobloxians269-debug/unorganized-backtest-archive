"""
TERMINUS · causal regime recalibration.

MEASURED DEFECT: the survival base rate is not stationary. By year it runs
0.546 (ES 2020) .. 0.650 (ES 2026), and ES 2026 (0.650) and MNQ 2026 (0.651) are
identical — so it is a REGIME effect, not an instrument effect. A model with a
frozen intercept from 2010-2019 is therefore optimistic in cold years and
conservative in hot ones. On ES DEV that showed as -1.2pp (z=-2.69) and on MNQ 2026
as +4.4pp (z=+4.53).

FIX: one scalar, applied in log-odds space, estimated ONLY from sessions strictly
before the day being scored:

    offset_d = logit(mean actual survival over prior K sessions)
             - logit(mean predicted survival over prior K sessions)
    p_adj    = sigmoid(logit(p) + offset_d)

Properties that make this safe:
  · strictly causal — day d never sees itself or anything after it
  · ONE degree of freedom, so it cannot fit the cross-section, only the level
  · it is a running mean, so the Pine port is trivial
  · it is also economically meaningful: in a regime where extremes hold, hold more.
"""
import numpy as np, pandas as pd

EPS = 1e-6


def logit(p):
    p = np.clip(np.asarray(p, dtype=float), EPS, 1 - EPS)
    return np.log(p / (1 - p))


def sigmoid(x):
    return 1.0 / (1.0 + np.exp(-np.asarray(x, dtype=float)))


def rolling_offset(d, p, K=60, warm=0.0):
    """
    Per-session offset from the trailing K sessions. Returns a Series indexed by day.
    Session d uses sessions [d-K, d-1] only.
    """
    df = pd.DataFrame({'day': d.day.values, 'y': d.surv.values.astype(float),
                       'p': np.asarray(p, dtype=float)})
    g = df.groupby('day').agg(y=('y', 'mean'), p=('p', 'mean'))
    ry = g.y.shift(1).rolling(K, min_periods=max(10, K // 4)).mean()
    rp = g.p.shift(1).rolling(K, min_periods=max(10, K // 4)).mean()
    off = logit(ry.values) - logit(rp.values)
    return pd.Series(np.where(np.isfinite(off), off, warm), index=g.index)


def apply_offset(d, p, off):
    o = off.reindex(d.day.values).values
    o = np.where(np.isfinite(o), o, 0.0)
    return sigmoid(logit(p) + o)


def recalibrate(d, p, K=60):
    """Convenience: fit the causal offset on this frame and apply it."""
    return apply_offset(d, p, rolling_offset(d, p, K=K))

