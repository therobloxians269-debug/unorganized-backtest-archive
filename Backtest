#!/usr/bin/env python3
"""Opening-range breakout with a session-VWAP trend filter, on real ES 1-min
bars. VWAP is the standard institutional intraday trend reference; a breakout is
only taken when price is on the trend side of VWAP. Ride to EOD. Net of 0.75pt."""
import math
import numpy as np, pandas as pd

FRIC=0.75; PT_USD=5.0
def hac_t(y,lags=5):
    y=np.asarray(y,float); n=y.size
    if n<10 or np.allclose(y,0): return 0.0
    e=y-y.mean(); s=(e@e)/n
    for l in range(1,min(lags,n-1)+1): s+=2*(1-l/(lags+1))*(e[l:]@e[:-l])/n
    return float(y.mean()/math.sqrt(max(s,1e-12)/n))

def load():
    df=pd.read_parquet("/Users/kaveh/mim_research/es_front_rth_1m.parquet")
    df["date"]=pd.to_datetime(df["date"]).dt.date
    hm=df["hm"].str.split(":",expand=True)
    df["mos"]=(hm[0].astype(int)*60+hm[1].astype(int))-(9*60+30)
    df=df[(df["mos"]>=0)&(df["mos"]<390)]
    dc=df.sort_values(["date","mos"]).groupby("date")["close"].last().to_frame("dclose")
    dc["sma20"]=dc["dclose"].rolling(20).mean()
    dc["trend"]=np.sign(dc["dclose"].shift(1)-dc["sma20"].shift(1))
    return df, dc

def day(g,W,use_vwap,use_trend,tbias):
    o=g["open"].to_numpy();h=g["high"].to_numpy();l=g["low"].to_numpy();c=g["close"].to_numpy();v=g["volume"].to_numpy()
    m=g["mos"].to_numpy(); idx={int(x):i for i,x in enumerate(m)}
    orb=[idx[k] for k in range(W) if k in idx]
    if len(orb)<W: return None
    oh=float(np.max(h[orb])); ol=float(np.min(l[orb]))
    walk=[idx[k] for k in range(W,390) if k in idx]
    if not walk or oh<=ol: return None
    tp=(h+l+c)/3.0
    cpv=np.cumsum(tp*v); cv=np.cumsum(v)                     # running VWAP
    d=0; entry=np.nan; start=None
    for k,i in enumerate(walk):
        up=float(h[i])>=oh; dn=float(l[i])<=ol
        if up and not dn: d=1; entry=oh; start=k; break
        if dn and not up: d=-1; entry=ol; start=k; break
        if up and dn:
            d=1 if float(o[i])>=oh else -1; entry=oh if d>0 else ol; start=k; break
    if d==0: return None
    bi=walk[start]
    vwap=cpv[bi]/cv[bi] if cv[bi]>0 else np.nan
    if use_vwap and not np.isnan(vwap):
        if (d>0 and entry<vwap) or (d<0 and entry>vwap): return None   # wrong side of VWAP
    if use_trend and tbias is not None and not np.isnan(tbias) and tbias!=0 and d!=tbias:
        return None
    stop=ol if d>0 else oh; risk=abs(entry-stop)
    if risk<=0: return None
    seg=walk[start:]; exit_px=float(c[seg[-1]])
    for i in seg:
        if (float(l[i])<=stop) if d>0 else (float(h[i])>=stop): exit_px=stop; break
    return d*(exit_px-entry)-FRIC

def bt(df,dc,W,uv,ut):
    pnl=[];yr=[]
    for dte,g in df.groupby("date",sort=True):
        g=g.sort_values("mos")
        tb=dc["trend"].get(dte,np.nan) if ut else None
        r=day(g,W,uv,ut,tb)
        if r is not None: pnl.append(r); yr.append(dte.year)
    return np.array(pnl),np.array(yr)

def summ(pnl,lbl):
    n=pnl.size
    if n<10: return {"cell":lbl,"n":n}
    win=pnl[pnl>0];los=pnl[pnl<=0]
    pf=(win.sum()/abs(los.sum())) if los.size and los.sum()!=0 else float('inf')
    return {"cell":lbl,"n":n,"net_pt":round(float(pnl.mean()),4),
            "ann_usd":round(float(pnl.sum()/(n/252)*PT_USD),0),"hit":round(float((pnl>0).mean()),3),
            "pf":round(float(pf),2),"hac_t":round(hac_t(pnl),2)}

def main():
    df,dc=load()
    print(f"{df['date'].nunique()} sessions {min(df['date'])}..{max(df['date'])} fric={FRIC}\n")
