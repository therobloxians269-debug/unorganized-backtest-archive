"""Persistent attempts at the day's leg.
   Small stop, re-enter on every fresh trigger, trail wide once in profit,
   daily loss cap. Optimise the DAILY win rate, not the per-trade one."""
import pandas as pd, numpy as np, warnings; warnings.filterwarnings('ignore')
FLAT=1019
def prep(df):
    o=df.copy(); m=(o.index.hour*60+o.index.minute).values
    o['minofday']=m
    d=o.resample('1440min',origin=o.index[0].normalize()+pd.Timedelta(hours=18),
                 label='left',closed='left').agg({'h':'max','l':'min','c':'last'}).dropna()
    tr=pd.concat([d.h-d.l,(d.h-d.c.shift()).abs(),(d.l-d.c.shift()).abs()],axis=1).max(axis=1)
    o['datr']=tr.rolling(14).mean().shift(1).reindex(o.index,method='ffill')
    return o

def run(b, N=60, stop_f=0.05, trail_f=0.20, arm_R=1.0, max_att=8, day_cap=4.0,
        start=360, stop_t=FLAT, pv=20., comm=4., slip=0.25, displace=None, seed=0):
    """stop_f / trail_f are fractions of DAILY atr. arm_R = R gained before the
       wide trail replaces the tight stop. day_cap = stop trying after -N R on the day."""
    o,h,l = b.o.values, b.h.values, b.l.values
    m=b['minofday'].values; da=b['datr'].values; day=b['daycycle'].values; n=len(b)
    hi_n=pd.Series(h).rolling(N).max().shift(1).values
    lo_n=pd.Series(l).rolling(N).min().shift(1).values
    rng=np.random.default_rng(seed)
    trades=[]; i=1
    att={}; lost={}
    while i<n-2:
        if m[i]<start or m[i]>=stop_t or not np.isfinite(da[i]) or da[i]<=0:
            i+=1; continue
        k=day[i]
        if att.get(k,0)>=max_att or lost.get(k,0.0)<=-day_cap: i+=1; continue
        d=0
        if np.isfinite(hi_n[i]) and h[i]>hi_n[i]: d=1
        elif np.isfinite(lo_n[i]) and l[i]<lo_n[i]: d=-1
        if d==0: i+=1; continue
        sp=stop_f*da[i]; tp=trail_f*da[i]
        if displace is not None: sp*= (1+displace)
        ep=o[i+1]+(slip if d==1 else -slip)
        st=ep-sp if d==1 else ep+sp
        risk=sp; ext=ep; peak=0.0; armed=False
        j=i+1; why='time'
        while j<n:
            if m[j]>=stop_t:
                px=o[j]+(slip if d==-1 else -slip); why='flat'; break
            if (l[j]<=st) if d==1 else (h[j]>=st):
                px=st+(slip if d==-1 else -slip); why='trail' if armed else 'stop'; break
            ext=max(ext,h[j]) if d==1 else min(ext,l[j])
            peak=max(peak,((ext-ep) if d==1 else (ep-ext))/risk)
            if peak>=arm_R:
                armed=True
                cand=ext-tp if d==1 else ext+tp
                st=max(st,cand) if d==1 else min(st,cand)
            j+=1
        else:
            j=n-1; px=o[j]
        pts=(px-ep) if d==1 else (ep-px)
        R=(pts*pv-comm)/(risk*pv)
        trades.append(dict(t=b.index[i+1],day=k,d=d,pts=pts,R=R,pnl=pts*pv-comm,
                           peakR=peak,why=why,risk=risk))
        att[k]=att.get(k,0)+1; lost[k]=lost.get(k,0.0)+R
        i=j+1
    return pd.DataFrame(trades)

def daily(t):
    g=t.groupby('day').agg(pnl=('pnl','sum'),n=('pnl','size'),bestR=('R','max'))
    return g

