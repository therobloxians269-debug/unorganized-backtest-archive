                elif c[b] < orl and below: side = -1; broke = -1
            elif reentry:                                     # VWAP-pullback re-entry
                if broke == 1 and above and l[b] <= vwap[b] + 0.5*atr[b] and c[b] > c[b-1]: side = 1
                elif broke == -1 and below and h[b] >= vwap[b] - 0.5*atr[b] and c[b] < c[b-1]: side = -1
