"""Compression -> expansion. One strategy.
   Rank every bar by how tight the last N bars are vs recent history.
   Trade the break of the tightest ranges. Stop = the compression range itself,
   so RR is high by construction. Measure SPEED as well as size."""
import pandas as pd, numpy as np, warnings; warnings.filterwarnings('ignore')
FLAT=1019
def prep(df):
    o=df.copy(); m=(o.index.hour*60+o.index.minute).values
    o['minofday']=m
    r=o.resample('60min',label='left',closed='left').agg({'h':'max','l':'min','c':'last'}).dropna()
    tr=pd.concat([r.h-r.l,(r.h-r.c.shift()).abs(),(r.l-r.c.shift()).abs()],axis=1).max(axis=1)
    o['atr60']=tr.rolling(14).mean().shift(1).reindex(o.index,method='ffill')
    return o

def run(b, N=30, pct=0.15, look=390, rr=4.0, buf=1.0, max_hold=180,
        start=360, stop_t=FLAT, per_day=99, pv=20., comm=4., slip=0.25,
        trail_atr=0.0, displace=None, seed=0, max_risk_atr=1.0):
    o,h,l = b.o.values, b.h.values, b.l.values
    m=b['minofday'].values; a=b['atr60'].values; day=b['daycycle'].values; n=len(b)
    rng=np.random.default_rng(seed)
    hh=pd.Series(h).rolling(N).max()
    ll=pd.Series(l).rolling(N).min()
    rngN=(hh-ll)
    # compression = this N-bar range is in the tightest `pct` of the last `look` bars
    thr=rngN.rolling(look).quantile(pct)
    hh=hh.shift(1).values; ll=ll.shift(1).values
    rngS=rngN.shift(1).values; thrS=thr.shift(1).values
    out=[]; cnt={}; i=1
    while i<n-2:
        if m[i]<start or m[i]>=stop_t or not np.isfinite(a[i]) or a[i]<=0:
            i+=1; continue
        k=day[i]
        if cnt.get(k,0)>=per_day: i+=1; continue
        if not (np.isfinite(rngS[i]) and np.isfinite(thrS[i]) and rngS[i]<=thrS[i]):
            i+=1; continue
        d=0
        if h[i]>hh[i]: d=1
        elif l[i]<ll[i]: d=-1
        if d==0: i+=1; continue
        box=rngS[i]
        if displace is not None: box*=(1+displace)
        ep=o[i+1]+(slip if d==1 else -slip)
        st=(ll[i]-buf) if d==1 else (hh[i]+buf)
        if (d==1 and st>=ep) or (d==-1 and st<=ep): i+=1; continue
        risk=abs(ep-st)
        if risk<1.0 or risk>max_risk_atr*a[i]: i+=1; continue
        tg=ep+rr*risk if d==1 else ep-rr*risk
        cs=st; ext=ep; peak=0.0
        j=i+1; why='time'; px=None
        while j<min(i+1+max_hold,n):
            if m[j]>=stop_t:
                px=o[j]+(slip if d==-1 else -slip); why='flat'; break
            if (l[j]<=cs) if d==1 else (h[j]>=cs):
                px=cs+(slip if d==-1 else -slip); why='trail' if peak>=1 else 'stop'; break
            if (h[j]>=tg) if d==1 else (l[j]<=tg):
                px=tg; why='tgt'; break
            ext=max(ext,h[j]) if d==1 else min(ext,l[j])
            peak=max(peak,((ext-ep) if d==1 else (ep-ext))/risk)
            if trail_atr>0 and peak>=1.0:
                cand=ext-trail_atr*a[j] if d==1 else ext+trail_atr*a[j]
                cs=max(cs,cand) if d==1 else min(cs,cand)
            j+=1
        if px is None:
            j=min(i+max_hold,n-1); px=o[j]
        pts=(px-ep) if d==1 else (ep-px)
        out.append(dict(t=b.index[i+1],d=d,pts=pts,R=(pts*pv-comm)/(risk*pv),
                        pnl=pts*pv-comm,why=why,risk=risk,mins=j-i,peakR=peak,
                        boxR=box/a[i]))
        cnt[k]=cnt.get(k,0)+1; i=j+1
    return pd.DataFrame(out)

