"""Sweep 1: the product as advertised, across its 6 timeframes and both
label conventions, on NQ.  Splits reported separately; 2026 is untouched."""
import numpy as np, pandas as pd, time
import data, engine, run

df = data.load_nq_main()
SPL = data.SPLITS
COST = data.cost_points("MNQ")
print(f"NQ 1m bars={len(df)}  {df.index.min()} .. {df.index.max()}")
print(f"MNQ round-turn cost = {COST:.3f} NQ points  (${COST*2:.2f}/contract)\n")

rows = []
for tf in run.TFS:
    for lm in ["forward", "published"]:
        t0 = time.time()
        st = run.build(df, tf, lm, key="nq")
        for gate in ["breaker", "bpr", "either", "none", "struct_only"]:
            for mname, mode in [("1:2 full", engine.MODE_FULL), ("scale", engine.MODE_SCALE)]:
                r = run.backtest(st, gate=gate, k=1.0, mode=mode, tf=tf)
                for s in run.report(st, r, f"{tf}m {lm[:4]} {gate:<11} {mname}", splits=SPL):
                    s["tf"] = tf; s["label"] = s["label"]; s["lm"] = lm
                    s["gate"] = gate; s["mode"] = mname
                    rows.append(s)
        print(f"-- tf={tf} label={lm} built+swept in {time.time()-t0:.1f}s")

R = pd.DataFrame(rows)
R.to_csv("sweep1.csv", index=False)

pd.set_option("display.width", 250)
for gate in ["breaker", "bpr", "either", "none", "struct_only"]:
    print(f"\n{'='*118}\nGATE = {gate}\n{'='*118}")
    for _, x in R[(R.gate == gate)].iterrows():
        print(engine.fmt(x.to_dict()))

