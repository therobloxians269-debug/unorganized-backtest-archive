"""
E2b — LAST honest swing: post-release RANGE BREAKOUT on event days (positive skew).

Thesis: a naive breakout is a -0.10R loser on all days (proven). But on a SCHEDULED
CATALYST day, a breakout of the post-release consolidation range has a fundamental
reason to follow through. Event = regime filter, not the entry itself.

Setup (event days = Thu Claims + 1st-Fri NFP):
  release range = high/low of 5m bars in [08:30, 09:00) ET (30 min post-release).
  trigger       = first 5m bar after 09:00 to break the range (close beyond it).
  entry         = NEXT bar open +/- 1 tick (no lookahead).
  stop          = opposite side of the release range (defined risk).
  manage        = leg A -> +1R; leg B -> chandelier trail (positive skew). Flat 15:55.
Report: netR/contract, win%, SKEW (must be >=0 for the mandate), IS/OOS.
Control: SAME setup on non-event weekdays (should be worse if the catalyst matters).
"""
import pandas as pd, numpy as np
from scipy import stats as sps

SRC = "/Users/kaveh/overnight_premium_engine/data/es_front_1m.parquet"
POINT, TICK, SLIP = 5.0, 0.25, 0.25
COMM_PTS = 1.24 / POINT
IS_END = pd.Timestamp("2020-01-01", tz="America/New_York")
ET_START = pd.Timestamp("08:30").time(); RANGE_END = pd.Timestamp("09:00").time()
FLAT = pd.Timestamp("15:55").time()

def load5():
    df = pd.read_parquet(SRC)[["open","high","low","close","volume"]].copy()
    df = df[~df.index.duplicated(keep="first")].sort_index()
    # keep 08:00-16:00 ET, resample per day to 5m
    df = df[(df.index.time >= pd.Timestamp("08:00").time()) & (df.index.time < pd.Timestamp("16:00").time())]
    df["day"] = df.index.normalize()
    agg = {"open":"first","high":"max","low":"min","close":"last","volume":"sum"}
    out=[]
    for day,g in df.groupby("day"):
        b=g.resample("5min",closed="left",label="left").agg(agg).dropna(subset=["open"])
        b["day"]=day; out.append(b)
    return pd.concat(out).sort_index()

def label(day):
    wd=day.weekday()
    if wd==3: return "Claims"
    if wd==4 and day.day<=7: return "NFP"
    return None

def trade_day(g, trail_mult=1.0, max_risk=None):
    g=g.reset_index(); n=len(g)
    rr=g[(g.et.dt.time>=ET_START)&(g.et.dt.time<RANGE_END)]
    if len(rr)<3: return []
    rh,rl=rr.high.max(),rr.low.min()
    atr=(g.high-g.low).expanding().mean()
    start=g.index[g.et.dt.time>=RANGE_END]
    if len(start)==0: return []
    s0=int(start[0])
    sig=None
    for i in range(s0,n-1):
        b=g.iloc[i]
        if b.close>rh: sig=(i,+1,rl); break
        if b.close<rl: sig=(i,-1,rh); break
    if sig is None: return []
    i,dirn,stop0=sig
    entry=g.iloc[i+1].open+dirn*SLIP
    risk=abs(entry-stop0)
    if risk<=TICK: return []
    if max_risk and risk>max_risk: return []
    stop=entry-dirn*risk; t1=entry+dirn*risk
    legA=legB=None; ext=entry
    for j in range(i+1,n):
        b=g.iloc[j]; cutoff=b.et.time()>=FLAT
        hs=(b.low<=stop) if dirn>0 else (b.high>=stop)
        if legA is None:
            ht=(b.high>=t1) if dirn>0 else (b.low<=t1)
            if hs and not ht: legA=dirn*(stop-entry)-SLIP
            elif ht: legA=dirn*(t1-entry)
            elif cutoff: legA=dirn*(b.close-entry)-SLIP
        ext=max(ext,b.close) if dirn>0 else min(ext,b.close)
        trail=ext-dirn*trail_mult*atr.iloc[j]
        if legB is None:
            htr=(b.close<=trail) if dirn>0 else (b.close>=trail)
            if hs: legB=dirn*(stop-entry)-SLIP
            elif htr: legB=dirn*(b.close-entry)-SLIP
            elif cutoff: legB=dirn*(b.close-entry)-SLIP
        if legA is not None and legB is not None: break
    return [((p-COMM_PTS)/risk) for p in (legA,legB) if p is not None]

def run(bars, which):
    rows=[]
    for day,g in bars.groupby("day"):
        lab=label(day)
        take = (lab is not None) if which=="event" else (lab is None and day.weekday()<5)
        if not take: continue
        for R in trade_day(g):
            rows.append({"day":day,"R":R,"lab":lab or "none"})
    return pd.DataFrame(rows)

def rep(d,name):
    if len(d)==0: print(f"  {name:<30} n=0"); return
    R=d.R; t=R.mean()/R.std()*np.sqrt(len(R)) if R.std()>0 else 0
    sk=sps.skew(R)
    print(f"  {name:<30} legs={len(R):>4}  netR={R.mean():+.3f}  win={ (R>0).mean()*100:4.1f}%  "
          f"t={t:+4.2f}  skew={sk:+4.2f}  totR={R.sum():+6.1f}")

if __name__=="__main__":
    print("Loading 5m event-window bars (2010-26)...")
    bars=load5()
    ev=run(bars,"event"); ctl=run(bars,"control")
    print("="*104)
    print("POST-RELEASE RANGE BREAKOUT — event days vs control. Mandate needs netR>+0.20 AND skew>=0.")
    print("="*104)
    rep(ev,"EVENT days (Claims+NFP)")
    rep(ev[ev.day<IS_END],"  EVENT IS 2010-19")
    rep(ev[ev.day>=IS_END],"  EVENT OOS 2020-26")
    rep(ev[ev.lab=="Claims"],"  EVENT Claims only")
    rep(ev[ev.lab=="NFP"],"  EVENT NFP only")
    rep(ctl,"CONTROL non-event weekdays")

