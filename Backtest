def sim_flat(df,sig,A,minscore=0,max_stop=25.,buf=2.,trail_atr=3.0,trail_after_R=1.0,
             flat_min=None,max_hold=4320,max_concurrent=3,point_val=20.,comm=4.,
             slip_ticks=1.,tick=.25):
    """flat_min: minute-of-day (ET) by which position must be closed (Apex = 16:59 -> 1019)."""
    o,h,l=A['o'],A['h'],A['l']; day=A['day']; bs,us=A['bs'],A['us']; atr=A['atr']
    mod=A['mod']; n=len(o); slip=slip_ticks*tick; out=[]; open_until=[]
    I,D,Ar=sig['i'].values,sig['d'].values,sig['arm_i'].values
    for x in range(len(I)):
        i,d,a=int(I[x]),int(D[x]),int(Ar[x])
        if i+2>=n: continue
        open_until=[e for e in open_until if e>i]
        if len(open_until)>=max_concurrent: continue
        if minscore and ((bs[i] if d==-1 else us[i])<minscore): continue
        if flat_min is not None and mod[i]>=flat_min: continue      # no new trades after cutoff
        stop=(max(h[a:i+1].max(),h[i])+buf) if d==-1 else (min(l[a:i+1].min(),l[i])-buf)
        entry=o[i+1]+(-slip if d==-1 else slip); risk=abs(stop-entry)
        if risk>max_stop or risk<1.0: continue
        cs=stop; ext=entry; peakR=0.; why='time'
        end=min(i+1+max_hold,n)
        for j in range(i+1,end):
            if flat_min is not None and mod[j]>=flat_min:
                px=o[j]+(slip if d==-1 else -slip); why='flat'; break
            hi,lo=h[j],l[j]
            if (hi>=cs) if d==-1 else (lo<=cs):
                px=cs+(slip if d==-1 else -slip); why='trail' if peakR>0 else 'stop'; break
            ext=min(ext,lo) if d==-1 else max(ext,hi)
            peakR=max(peakR,((entry-ext) if d==-1 else (ext-entry))/risk)
            if peakR>=trail_after_R and not np.isnan(atr[j]):
                ns=ext+trail_atr*atr[j] if d==-1 else ext-trail_atr*atr[j]
                cs=min(cs,ns) if d==-1 else max(cs,ns)
        else:
            j=end-1; px=o[j]+(slip if d==-1 else -slip)
        pts=(entry-px) if d==-1 else (px-entry); net=pts*point_val-comm
        out.append((df.index[i+1],d,risk,why,net,net/(risk*point_val),peakR,j-i))
        open_until.append(j)
    return pd.DataFrame(out,columns=['t','d','risk','why','pnl','R','peakR','bars'])

