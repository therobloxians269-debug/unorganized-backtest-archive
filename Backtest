    print(f"\n== CONFIG {cfg} ==")
    print(f"net_usd={st['net_usd']:.0f}  MAR={st['mar']}  trades={st['trades']}  "
          f"hit={st['hit']:.1%}  maxDD={st['maxdd_usd']:.0f}  exp_pts={st['expectancy_pts']}")
    print(f"yearly: {st['yearly']}")
