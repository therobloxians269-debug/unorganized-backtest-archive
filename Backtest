#!/usr/bin/env python3
"""
overnight_killswitch.py -- the GATE. Overnight (ETH gap) vs intraday (RTH) premium on
16y ES, net of cost, across CHRONOLOGICAL folds, with neg/pos controls + deflation.

Falsification-first: this is the cheapest test that can kill the slow-signal thread.
Data: es_daily_bars.parquet (RTH daily O=09:30, C=15:59, prevC; roll-flagged; validated).
  overnight (ETH) = O_t/prevC_t - 1   (close->open gap; the overnight premium)
  intraday  (RTH) = C_t/O_t   - 1
  buy&hold        = C_t/prevC_t - 1    (beta benchmark)
Roll days excluded (calendar-spread gap would be a fake overnight return).
"""
import numpy as np, polars as pl
from scipy.stats import norm

ANN = 252
ES_RT_BPS  = 0.6     # ES round-trip cost (user-supplied)
MES_RT_BPS = 0.9     # MES round-trip (thinner book / fixed-commission drag)
N_TRIALS   = 10      # configs screened on the overnight idea (for deflation)
rng = np.random.default_rng(7)

b = pl.read_parquet("/Users/kaveh/es_daily_bars.parquet")
O, C, pc = (b[c].to_numpy().astype(float) for c in ("O","C","prevC"))
roll = b["roll"].to_numpy().astype(bool)
yr = (b["date"].to_numpy().astype("datetime64[Y]").astype(int) + 1970)

ok = np.isfinite(pc) & ~roll                  # drop roll-day overnight gaps
r_on = (O/pc - 1.0)
r_id = (C/O  - 1.0)
r_cc = (C/pc - 1.0)

def stats(r, cost_bps=0.0, ann=ANN):
    r = r[np.isfinite(r)]
    if len(r) < 5: return None
    rn = r - cost_bps*1e-4
    mu, sd = rn.mean(), rn.std(ddof=1)
    sh = mu/sd*np.sqrt(ann) if sd>0 else 0.0
    dn = rn[rn<0].std(ddof=1) if (rn<0).sum()>1 else np.nan
    sortino = mu/dn*np.sqrt(ann) if dn and dn>0 else float('nan')
    eq = np.cumprod(1+rn); dd = (eq/np.maximum.accumulate(eq)-1).min()
    ann_ret = (1+rn).prod()**(ann/len(rn))-1
    calmar = ann_ret/abs(dd) if dd<0 else float('nan')
    t = mu/(sd/np.sqrt(len(rn))) if sd>0 else 0.0
    return dict(n=len(rn), ann=ann_ret, vol=sd*np.sqrt(ann), sharpe=sh, sortino=sortino,
                calmar=calmar, t=t, mu_bps=mu*1e4, maxdd=dd)

def dsr(sharpe_ann, n_obs, n_trials, r, ann=ANN):
    sr = sharpe_ann/np.sqrt(ann)                # per-period
    from scipy.stats import skew, kurtosis
    rr = r[np.isfinite(r)]; sk=float(skew(rr)); ku=float(kurtosis(rr,fisher=False))
    emax=(1-np.euler_gamma)*norm.ppf(1-1/n_trials)+np.euler_gamma*norm.ppf(1-1/(n_trials*np.e))
    sr0=emax/np.sqrt(n_obs)
    den=np.sqrt(max(1e-12,1-sk*sr+(ku-1)/4*sr**2))
    return float(norm.cdf((sr-sr0)*np.sqrt(n_obs-1)/den))

print("="*86)
print("KILL-SWITCH: OVERNIGHT (ETH) PREMIUM — ES 16y, NET OF COST, CHRONOLOGICAL FOLDS")
print("="*86)
m_on = stats(r_on[ok], ES_RT_BPS); m_id = stats(r_id[ok], ES_RT_BPS); m_bh = stats(r_cc[ok], 0.0)
print(f"sessions used: {m_on['n']} (roll days excluded)   cost: ES {ES_RT_BPS}bps RT/day\n")
print(f"{'leg':<22}{'annRet':>8}{'vol':>7}{'Sharpe':>8}{'Sortino':>8}{'Calmar':>8}{'t-stat':>8}{'mean(bps/d)':>12}")
for nm,m in (("OVERNIGHT net (ETH)",m_on),("intraday net (RTH)",m_id),("buy&hold gross",m_bh)):
    print(f"{nm:<22}{m['ann']*100:>7.1f}%{m['vol']*100:>6.1f}%{m['sharpe']:>8.2f}{m['sortino']:>8.2f}"
          f"{m['calmar']:>8.2f}{m['t']:>8.2f}{m['mu_bps']:>12.2f}")
m_on_mes = stats(r_on[ok], MES_RT_BPS)
print(f"\n  (same overnight leg at MES {MES_RT_BPS}bps cost: Sharpe {m_on_mes['sharpe']:.2f}, "
      f"annRet {m_on_mes['ann']*100:.1f}%, t {m_on_mes['t']:.2f})")

print("\n--- CHRONOLOGICAL FOLDS (overnight net of ES cost; is the t-stat STABLE?) ---")
years = np.array([2010,2014,2018,2022,2026])
print(f"{'fold':<14}{'Sharpe':>8}{'Sortino':>9}{'Calmar':>8}{'t-stat':>8}{'annRet':>9}{'N':>7}")
fold_ts=[]
for a,bnd in zip(years[:-1],years[1:]):
    sel = ok & (yr>=a) & (yr<bnd)
    m = stats(r_on[sel], ES_RT_BPS)
    if m: fold_ts.append(m['t']); print(f"{a}-{bnd-1:<9}{m['sharpe']:>8.2f}{m['sortino']:>9.2f}"
          f"{m['calmar']:>8.2f}{m['t']:>8.2f}{m['ann']*100:>8.1f}%{m['n']:>7}")

print("\n--- CONTROLS ---")
neg=[]
for s in range(20):
    g=np.random.default_rng(s); rr=r_on[ok]*g.choice([-1,1],ok.sum())  # sign-shuffle -> kills drift
    neg.append(stats(rr,ES_RT_BPS)['sharpe'])
print(f"NEGATIVE control (sign-shuffled overnight, net): mean Sharpe {np.mean(neg):+.2f} "
      f"(must be <=0 -> integrity {'PASS' if np.mean(neg)<=0.05 else 'FAIL'})")
pos = stats(r_on[ok]+0.0005, ES_RT_BPS)          # inject +5bps/day drift
print(f"POSITIVE control (+5bps/day injected): Sharpe {pos['sharpe']:.2f}, t {pos['t']:.1f} "
      f"(must detect strongly -> {'PASS' if pos['t']>5 else 'FAIL'})")

d = dsr(m_on['sharpe'], m_on['n'], N_TRIALS, r_on[ok]-ES_RT_BPS*1e-4)
print(f"\nDeflated Sharpe (n_trials={N_TRIALS}): {d*100:.1f}%   PSR(>0): {dsr(m_on['sharpe'],m_on['n'],1,r_on[ok]-ES_RT_BPS*1e-4)*100:.1f}%")

print("\n" + "="*86)
stable = (min(fold_ts) > 1.5)
beats_bh = m_on['sharpe'] > m_bh['sharpe']
fundable = (m_on['sharpe']>=0.7 and stable and m_on['t']>3)
print("VERDICT:")
print(f"  full-sample net: Sharpe {m_on['sharpe']:.2f}, t {m_on['t']:.2f} -> survives cost line: {'YES' if m_on['t']>2 else 'NO'}")
print(f"  fold t-stats {[round(x,1) for x in fold_ts]} -> STABLE(all>1.5): {stable}")
print(f"  net Sharpe vs buy&hold {m_on['sharpe']:.2f} vs {m_bh['sharpe']:.2f} -> adds over beta: {beats_bh}")
print(f"  FUNDABLE standalone (Sharpe>=0.7 & stable & t>3): {fundable}")

