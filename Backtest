"""Trend + Carry on the real 14-market futures universe (daily, all expiries).

Per market: continuous front-month (max-volume contract, same-contract returns -> no roll
gap) for the TREND signal, and front-vs-next term structure for the CARRY signal
(backwardation = positive carry = long). Two positive, uncorrelated premia -> combine and
gauntlet, targeting higher Sharpe / lower drawdown than trend alone.

    PYTHONPATH=. python3 research/trend_carry.py
"""
from __future__ import annotations

import numpy as np
import pandas as pd

from ope.validation import gauntlet_summary, perf_stats

ROOTS = {"ES", "NQ", "CL", "NG", "GC", "SI", "HG", "ZN", "ZB", "ZF", "6E", "6J", "ZC", "ZS"}
MONTHS = set("FGHJKMNQUVXZ")
TGT, COST_BP, LOOKS = 0.10, 1.5, (63, 126, 252)
PATH = "data/futures_universe_1d.parquet"


def load_outrights():
    df = pd.read_parquet(PATH).reset_index()
    df["date"] = pd.to_datetime(df["ts_event"].dt.date)
    s = df["symbol"].astype(str)
    mask = (~s.str.contains(r"[-: ]", regex=True, na=False) & (s.str.len() >= 4)
            & s.str[-1].str.isdigit() & s.str[-2].isin(MONTHS) & s.str[:-2].isin(ROOTS))
    d = df[mask].copy()
    d["root"] = d["symbol"].str[:-2]
    return d[["date", "root", "instrument_id", "close", "volume"]]


def build_signals(d):
    d["expiry"] = d["instrument_id"].map(d.groupby("instrument_id")["date"].max())
    rets, carry = {}, {}
    for root, g in d.groupby("root"):
        piv = g.pivot_table(index="date", columns="instrument_id", values="close")
        prev = piv.shift(1)
        front = g.loc[g.groupby("date")["volume"].idxmax()].set_index("date")
        dates = front.index
        pc = pd.Series([prev.at[dt, front.at[dt, "instrument_id"]]
                        if front.at[dt, "instrument_id"] in prev.columns else np.nan
                        for dt in dates], index=dates)
        rets[root] = (front["close"] / pc - 1.0).rename(root)
        carr = {}
        for dt, gg in g.groupby("date"):
            fe, fcl = front.at[dt, "expiry"], front.at[dt, "close"]
            cand = gg[gg["expiry"] > fe]
            if cand.empty:
                continue
            nxt = cand.loc[cand["expiry"].idxmin()]
            yrs = (nxt["expiry"] - fe).days / 365.25
            if yrs > 0 and nxt["close"] > 0 and fcl > 0:
                carr[dt] = np.log(fcl / nxt["close"]) / yrs
        carry[root] = pd.Series(carr).rename(root)

    R = pd.DataFrame(rets).sort_index()
    cont = (1 + R.fillna(0.0)).cumprod()   # avoid NaN-poisoning for late-starting markets
    av = (R.rolling(63).std() * np.sqrt(252)).shift(1)
    tz = sum(cont.pct_change(L) / (av * np.sqrt(L / 252.0)) for L in LOOKS) / len(LOOKS)
    C = pd.DataFrame(carry).reindex(R.index).reindex(columns=R.columns)
    # cross-sectional carry factor: long backwardated markets, short contangoed (level, not momentum)
    cz = C.sub(C.mean(axis=1), axis=0).div(C.std(axis=1).replace(0, np.nan), axis=0)
    return R, np.tanh(tz), np.tanh(cz)


def norm_w(R, sig):
    av = (R.rolling(63).std() * np.sqrt(252)).shift(1)
    w = sig.shift(1) / av
    return w.div(w.abs().sum(axis=1).replace(0, np.nan), axis=0)


def net(R, w):
    g = (w * R).sum(axis=1)
    scale = (TGT / (g.rolling(63).std() * np.sqrt(252))).shift(1).clip(0, 3).fillna(0.0)
    w = w.mul(scale, axis=0)
    return ((w * R).sum(axis=1) - w.diff().abs().sum(axis=1) * COST_BP * 1e-4).dropna()


def show(name, n):
    s = perf_stats(n)
    e = [perf_stats(n[m])["sharpe"] for m in
         (n.index.year <= 2014, (n.index.year >= 2015) & (n.index.year <= 2021), n.index.year >= 2022)]
    cal = s["ann_return"] / abs(s["max_drawdown"]) if s["max_drawdown"] else 0
    print(f"{name:>8} Sh={s['sharpe']:.2f} ann={s['ann_return']*100:4.1f}% DD={s['max_drawdown']*100:6.1f}% "
          f"Cal={cal:4.2f} | eras {e[0]:+.2f}/{e[1]:+.2f}/{e[2]:+.2f}")
    return n


def main():
    R, trend_sig, carry_sig = build_signals(load_outrights())
    print(f"markets: {list(R.columns)}\n{R.index.min().date()}->{R.index.max().date()}, {len(R)} days\n")
    wt, wv = norm_w(R, trend_sig), norm_w(R, carry_sig)
    nt, nv = net(R, wt), net(R, wv)
    nc = net(R, 0.5 * wt + 0.5 * wv)
    cor = pd.concat({"t": nt, "c": nv}, axis=1).dropna().corr().iloc[0, 1]
    print(f"correlation(trend, carry) = {cor:+.2f}\n")
    show("trend", nt)
    show("carry", nv)
    show("combo", nc)
    g = gauntlet_summary({"trend": nt, "carry": nv, "combo": nc}, "combo", n_blocks=10)
    print(f"\ngauntlet (combo): PBO={g['pbo']:.3f} PSR={g['psr']:.3f} DSR={g['dsr']:.3f} "
          f"-> {'PASS' if g['passed'] else 'FAIL'}")


if __name__ == "__main__":
    main()

