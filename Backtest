"""
FORCED FLOW — the readable version. Named states you can see on a chart.

THE READ (this is the whole model, in plain English):

    CONTEXT   "we're leaning"      — price has spent most of the session BELOW
                                     session VWAP. Every execution algo benchmarked
                                     to VWAP is behind on a buy order and must keep
                                     participating. A real, non-discretionary bid.

    TRIGGER   "absorption"         — a 5-min bar prints HEAVY volume but REFUSES to
                                     travel. Effort without result. Someone large is
                                     eating everything the other side throws at them.
                                     Below VWAP that someone is a forced buyer.

    CONFIRM   "the low is in"      — the TERMINUS estimator says the running low is
                                     probably the day's final low (validated:
                                     strat-AUC 0.859 NQ / 0.888 MNQ, never trained).

    Mirror all three for shorts.

EVERY STEP MUST EARN ITS PLACE. For each layer we require:
  · lift over the base rate, day-clustered
  · it must BEAT ITS OWN INVERSE — if flipping the condition scores the same, the
    condition is measuring nothing (this is what collapsed the ICT confluence stack)
  · a time-matched placebo: random bars drawn from the same time-of-day distribution,
    because time of day alone drives a lot of forward variance
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')

RTH0, RTH1 = 570, 960


def five_min(b):
    """Aggregate a session's 1m arrays into 5m bars, keeping the 1m path for exits."""
    H, L, C, O, T, V = b['H'], b['L'], b['C'], b['O'], b['T'], b['V']
    n = (len(C) // 5) * 5
    idx = np.arange(n).reshape(-1, 5)
    return dict(
        O=O[idx[:, 0]], C=C[idx[:, -1]],
        H=H[idx].max(1), L=L[idx].min(1),
        V=V[idx].sum(1), T=T[idx[:, -1]],
        end=idx[:, -1],                     # 1m index of each 5m bar's last minute
    )


def states(day, rb, vol_z=1.5, rng_mult=0.6, lean_thr=0.65, win=12):
    """
    One row per completed 5-min RTH bar, with every named state flagged.

    vol_z     how heavy volume must be, in trailing-window z units
    rng_mult  how compressed the range must be, vs the trailing median range
    lean_thr  fraction of session minutes below VWAP to call it a LEAN
    win       trailing window (in 5m bars) for the volume/range norms
    """
    rows = []
    for dd, row in day.iterrows():
        b = rb.get(dd)
        if b is None:
            continue
        A = float(row.ADR)
        if not (A > 0) or len(b['C']) < 200:
            continue
        f = five_min(b)
        O, C, H, L, V, T, end = f['O'], f['C'], f['H'], f['L'], f['V'], f['T'], f['end']
        m = len(C)
        if m < win + 6:
            continue

        # session VWAP on the 1m path, sampled at each 5m close (causal)
        H1, L1, C1, V1 = b['H'], b['L'], b['C'], b['V']
        tp = (H1 + L1 + C1) / 3.0
        vw = np.cumsum(tp * V1) / np.maximum(np.cumsum(V1), 1e-9)
        vwap5 = vw[end]
        below1 = (C1 < vw).astype(float)
        lean5 = np.cumsum(below1)[end] / (end + 1.0)

        rng = H - L
        # trailing norms, SHIFTED — a bar is never judged against itself
        vmu = pd.Series(V).rolling(win, min_periods=6).mean().shift(1).values
        vsd = pd.Series(V).rolling(win, min_periods=6).std().shift(1).values
        rmd = pd.Series(rng).rolling(win, min_periods=6).median().shift(1).values

        rmu = pd.Series(rng).rolling(win, min_periods=6).mean().shift(1).values
        rsd = pd.Series(rng).rolling(win, min_periods=6).std().shift(1).values

        vz = (V - vmu) / np.where(vsd > 0, vsd, np.nan)
        rz = (rng - rmu) / np.where(rsd > 0, rsd, np.nan)
        rr = rng / np.where(rmd > 0, rmd, np.nan)

        # EFFORT MINUS RESULT. Volume and range are strongly co-moving, so thresholding
        # them independently ("heavy AND tight") is a near-empty set — measured, it fired
        # on 0.02% of bars. The residual is the honest object: how much MORE volume than
        # this bar's travel deserved. High az = the market ate size and refused to move.
        az = vz - rz

        heavy = vz >= vol_z
        tight = rr <= rng_mult
        wide = rr >= (1.0 / max(rng_mult, 1e-6))
        light = vz <= -0.5

        absorb = az >= vol_z                      # effort without result
        anti = az <= -vol_z                       # the INVERSE: result without effort

        dev = (C - vwap5) / A
        lean_lo = lean5 >= lean_thr               # mostly below VWAP -> forced buyers
        lean_hi = lean5 <= (1.0 - lean_thr)

        cl = float(C1[-1])
        for i in range(win, m - 3):
            if T[i] < RTH0 + 30 or T[i] > 930:
                continue
            if not np.isfinite(az[i]) or not np.isfinite(rr[i]):
                continue
            j = int(end[i])
            rows.append(dict(
                day=dd, t=int(T[i]), i5=i, j1=j, ADR=A, px=float(C[i]),
                vz=float(vz[i]), rz=float(rz[i]), az=float(az[i]),
                rr=float(rr[i]), dev=float(dev[i]),
                lean=float(lean5[i]),
                absorb=bool(absorb[i]), anti=bool(anti[i]),
                heavy=bool(heavy[i]), tight=bool(tight[i]),
                lean_lo=bool(lean_lo[i]), lean_hi=bool(lean_hi[i]),
                below=bool(C[i] < vwap5[i]),
                # forward return to the close, in ADR units, from this 5m close
                y=(cl - float(C[i])) / A,
                # forward over the next 30 / 60 minutes
                y30=(float(C1[min(j + 30, len(C1) - 1)]) - float(C[i])) / A,
                y60=(float(C1[min(j + 60, len(C1) - 1)]) - float(C[i])) / A,
            ))
    return pd.DataFrame(rows)


def daycluster(x, days):
    x = np.asarray(x, dtype=float)
    m = np.isfinite(x)
    if m.sum() < 20:
        return np.nan, np.nan, int(m.sum())
    g = pd.Series(x[m]).groupby(np.asarray(days)[m]).mean()
    if len(g) < 8 or g.std(ddof=1) == 0:
        return float(g.mean()), np.nan, int(m.sum())
    return float(g.mean()), float(g.mean() / (g.std(ddof=1) / np.sqrt(len(g)))), int(m.sum())


def time_matched_placebo(s, mask, col='y', n_draw=200, seed=5, cond=None):
    """
    Draw random bars with the SAME time-of-day distribution as the fired signal.

    `cond` restricts the DRAW POOL to the same conditioning subset (e.g. only
    below-VWAP bars). Without it the placebo mixes below- and above-VWAP bars, whose
    forward returns have opposite expected signs, so the trigger gets credit for the
    context. Measured: that unfair version reported z=+27.6 for a signal that had not
    been shown to add anything at all.
    """
    rng = np.random.default_rng(seed)
    fired = s[mask]
    if len(fired) < 30:
        return np.nan, np.nan
    base = s if cond is None else s[cond]
    counts = fired.groupby('t').size()
    pool = {t: g.index.values for t, g in base.groupby('t')}
    out = []
    for _ in range(n_draw):
        pick = []
        for t, c in counts.items():
            p = pool.get(t)
            if p is None or len(p) == 0:
                continue
            pick.append(rng.choice(p, size=min(c, len(p)), replace=False))
        if not pick:
            continue
        ii = np.concatenate(pick)
        g = s.loc[ii]
        mu, _, _ = daycluster(g[col], g.day)
        out.append(mu)
    out = np.array([o for o in out if np.isfinite(o)])
    return (float(out.mean()), float(out.std())) if len(out) else (np.nan, np.nan)


def report(s, mask, label, col='y', sign=+1, placebo=True, cond=None):
    g = s[mask]
    mu, t, n = daycluster(sign * g[col], g.day)
    line = f'  {label:<34} n={n:>6}  mean {mu:>+8.4f}  t {t:>+6.2f}'
    if placebo and n >= 30:
        pm, ps = time_matched_placebo(s, mask, col=col, cond=cond)
        if np.isfinite(pm):
            z = (mu - sign * pm) / ps if ps > 0 else np.nan
            line += f'   placebo {sign*pm:+.4f}+-{ps:.4f}  z {z:+.2f}'
    print(line)
    return mu, t, n

