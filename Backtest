        on_lo = min(prev_close, px) - abs(rng.normal(0, 5))
        spent_hi = on_hi >= prev_hi
        spent_lo = on_lo <= prev_lo
        o = np.zeros(BARS); h = np.zeros(BARS); l = np.zeros(BARS); c = np.zeros(BARS); v = np.zeros(BARS)
        tdir = rng.choice([-1, 1])
        anchor = px
        plant_left = 0; plant_dir = 0
        ema = 0.0; vnum = 0.0; vden = 0.0; devs = []
        fh_hi, fh_lo = -1e9, 1e9
