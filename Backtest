"""Does ORB work on ES when ES is 'in play'? (tests the stocks-in-play idea, free, on ES)

Per session: opening gap |open/prev_close-1| and opening-range relative volume (vs
trailing-20 median) proxy 'in play'. We bucket the 5-min ORB R-multiple by those, full
16yr, to see if ORB turns profitable on high-gap / high-RVOL days.

    PYTHONPATH=. python3 research/orb_inplay.py
"""
from __future__ import annotations

import datetime as dt
from pathlib import Path

import numpy as np
import pandas as pd

from ope.instruments import get_market
from ope.validation import perf_stats

CACHE = Path(__file__).resolve().parents[1] / "data" / "es_outright_1m.parquet"


def front_bars() -> pd.DataFrame:
    df = pd.read_parquet(CACHE)
    et = (pd.DatetimeIndex(pd.to_datetime(df["ts_event"], utc=True))
          + pd.Timedelta(minutes=1)).tz_convert("America/New_York")
    df = df.assign(_t=et, session_date=et.date, _time=et.time)
    rth = df[(df["_time"] > dt.time(9, 30)) & (df["_time"] <= dt.time(16, 0))]
    vol = rth.groupby(["instrument_id", "session_date"], as_index=False)["volume"].sum()
    front = vol.loc[vol.groupby("session_date")["volume"].idxmax(), ["session_date", "instrument_id"]]
    fb = rth.merge(front.rename(columns={"instrument_id": "fiid"}), on="session_date")
    return fb[fb["instrument_id"] == fb["fiid"]].sort_values("_t")


def orb_R(o, h, low, c, cost_pts, or_min=5):
    orh, orl = h[:or_min].max(), low[:or_min].min()
    risk = orh - orl
    if risk <= 0 or len(o) <= or_min:
        return 0.0
    direction = 1 if c[or_min - 1] > o[0] else -1
    H, L, C = h[or_min:], low[or_min:], c[or_min:]
    entry = side = None
    j = 0
    for i in range(len(H)):
        if direction > 0 and H[i] >= orh:
            entry, stop, side, j = orh, orl, 1, i; break
        if direction < 0 and L[i] <= orl:
            entry, stop, side, j = orl, orh, -1, i; break
    if entry is None:
        return 0.0
    exitp = C[-1]
    for k in range(j, len(H)):
        if (side > 0 and L[k] <= stop) or (side < 0 and H[k] >= stop):
            exitp = stop; break
    return side * (exitp - entry) / risk - cost_pts / risk


def main():
    bars = front_bars()
    cost_pts = get_market("SP500").micro.round_turn_cost() / get_market("SP500").micro.point_multiplier
    recs = {}
    for sd, b in bars.groupby("session_date", sort=True):
        o = b["open"].to_numpy(); h = b["high"].to_numpy()
        low = b["low"].to_numpy(); c = b["close"].to_numpy(); v = b["volume"].to_numpy()
        recs[sd] = (o[0], c[-1], min(5, len(v)) and v[:5].sum(),
                    orb_R(o, h, low, c, cost_pts))
    t = pd.DataFrame.from_dict(recs, orient="index", columns=["open", "close", "orvol", "R"])
    t["gap"] = (t["open"] / t["close"].shift(1) - 1.0).abs()
    t["rvol"] = t["orvol"] / t["orvol"].rolling(20, min_periods=10).median()
    t = t.dropna(subset=["gap", "rvol"])
    yrs = (pd.to_datetime(str(t.index.max())) - pd.to_datetime(str(t.index.min()))).days / 365.25
    print(f"sessions={len(t)} over {yrs:.1f}y [{t.index.min()} -> {t.index.max()}]; cost {cost_pts:.3f}pts\n")

    def line(name, sub):
        tr = sub["R"][sub["R"] != 0]
        if len(tr) < 5:
            print(f"  {name:>16}: n<5"); return
        tpy = len(tr) / yrs
        sh = tr.mean() / tr.std() * np.sqrt(tpy) if tr.std() > 0 else 0.0
        print(f"  {name:>16}: n={len(tr):>4} meanR={tr.mean():+.3f} win={(tr>0).mean()*100:>4.0f}% annSh={sh:+.2f}")

    print("ORB(5) by opening-gap quartile (in-play proxy), full sample:")
    for q, lab in zip(pd.qcut(t["gap"], 4, labels=False), ["Q1-low", "Q2", "Q3", "Q4-high"]):
        pass
    t["gapq"] = pd.qcut(t["gap"], 4, labels=["Q1low", "Q2", "Q3", "Q4high"])
    t["rvq"] = pd.qcut(t["rvol"], 4, labels=["Q1low", "Q2", "Q3", "Q4high"])
    for lab in ["Q1low", "Q2", "Q3", "Q4high"]:
        line(f"gap {lab}", t[t["gapq"] == lab])
    print("ORB(5) by opening-range RVOL quartile:")
    for lab in ["Q1low", "Q2", "Q3", "Q4high"]:
        line(f"rvol {lab}", t[t["rvq"] == lab])

    inplay = t[(t["gapq"] == "Q4high") | (t["rvq"] == "Q4high")]
    ip = inplay["R"][inplay["R"] != 0].copy()
    ip.index = pd.to_datetime([str(d) for d in inplay.index[inplay["R"] != 0]])
    print(f"\nIN-PLAY (top-quartile gap OR rvol): n={len(ip)} meanR={ip.mean():+.3f} win={(ip>0).mean()*100:.0f}%")
    ho = ip[ip.index >= pd.Timestamp("2022-01-01")]
    print(f"  2022+ holdout: n={len(ho)} meanR={ho.mean():+.3f} win={(ho>0).mean()*100:.0f}%")


if __name__ == "__main__":
    main()

