#!/usr/bin/env python3
"""Exact-replica backtest of MNQ_VBO.pine (session-VWAP breakout) on real ES 1m.

Data: ~/quant_lab/cache/es_ym_1m.parquet (real, 2019-05..2026-06, 24h w/ session labels).
Logic mirror of the Pine indicator:
  - 5m ETH bars, session-anchored VWAP, ATR(14) = RMA of TR on the 5m series
  - entry on 5m close crossing VWAP +/- buf*ATR with VWAP slope agreement,
    window 09:35-15:00 ET, max N trades/day, daily loss cut in gross R
  - bracket: stop = stopMult*ATR, target = tgtMult*ATR, stop wins intrabar ties
  - force flat at the 15:50 bar close (or session end if early close)
Costs: $2.50 round trip (commission+fees+slippage) on micro; dollarized at $5/pt (MES).
MNQ equivalence: same % move economics, risk-$ band nearly identical.
"""
import numpy as np, pandas as pd, itertools, sys, json

DATA = "/Users/kaveh/quant_lab/cache/es_ym_1m.parquet"
PT_VAL = 5.0          # $/pt micro (MES); MNQ = $2/pt at ~2.5-3.7x the points -> same $ band
COST_RT = 2.50        # $ round trip: commission+exchange+~1-2 ticks slippage

def load_5m():
    df = pd.read_parquet(DATA)
    df = df[["es_open","es_high","es_low","es_close","es_volume","min_of_day","session"]].copy()
    df.columns = ["o","h","l","c","v","mod","sess"]
    df["hlc3v"] = (df.h + df.l + df.c) / 3.0 * df.v
    # 5m buckets (clock-aligned, fine across midnight)
    b = df.groupby([df["sess"], df.index.floor("5min")]).agg(
        o=("o","first"), h=("h","max"), l=("l","min"), c=("c","last"),
        v=("v","sum"), hlc3v=("hlc3v","sum"), mod=("mod","first"))
    b.index.names = ["sess","ts"]
    b = b.reset_index().sort_values("ts").reset_index(drop=True)
    # session-anchored VWAP
    g = b.groupby("sess", sort=False)
    b["vwap"] = g["hlc3v"].cumsum() / g["v"].cumsum().replace(0, np.nan)
    b["vwap"] = b["vwap"].ffill()
    # ATR(14) RMA on the 5m ETH series (matches Pine on an ETH chart)
    pc = b.c.shift(1)
    tr = np.maximum(b.h - b.l, np.maximum((b.h - pc).abs(), (b.l - pc).abs()))
    b["atr"] = tr.ewm(alpha=1/14, adjust=False, min_periods=14).mean()
    # daily regime: session-close > 200d SMA
    dc = b.groupby("sess")["c"].last()
    ma = dc.rolling(200, min_periods=60).mean()
    reg = (dc > ma).astype(int) * 2 - 1  # +1 bull, -1 bear
    b["regime"] = b["sess"].map(reg).fillna(0).astype(int)
    return b

def run(b, buf=0.25, stop=1.0, tgt=2.0, max_trades=2, max_loss_r=2.0,
        win_end=900, longs=True, shorts=True, regime_filter=False):
    c, h, l, vw, atr = (b[k].to_numpy() for k in ["c","h","l","vwap","atr"])
    mod = b["mod"].to_numpy(); sess = b["sess"].to_numpy(); rgm = b["regime"].to_numpy()
    n = len(b)
    up, dn = vw + buf*atr, vw - buf*atr
    c1 = np.roll(c,1); up1 = np.roll(up,1); dn1 = np.roll(dn,1); vw1 = np.roll(vw,1)
    x_up = (c1 <= up1) & (c > up) & (vw > vw1)
    x_dn = (c1 >= dn1) & (c < dn) & (vw < vw1)
    x_up[0] = x_dn[0] = False
    in_win = (mod >= 575) & (mod < win_end)
    valid = ~np.isnan(atr) & ~np.isnan(vw) & in_win
    sig = np.where(valid & ((x_up & longs) | (x_dn & shorts)))[0]

    # per-session: last tradable bar index (first bar with mod>=950, else last bar of session)
    sess_change = np.r_[True, sess[1:] != sess[:-1]]
    sess_start = np.where(sess_change)[0]
    sess_end = np.r_[sess_start[1:] - 1, n - 1]
    flat_idx = {}
    for s0, s1 in zip(sess_start, sess_end):
        m = np.where((mod[s0:s1+1] >= 950) & (mod[s0:s1+1] < 960))[0]
        if len(m):
            flat_idx[sess[s0]] = s0 + m[0]
        else:  # early close: last bar with mod < 960 in RTH morning range
            m2 = np.where((mod[s0:s1+1] >= 570) & (mod[s0:s1+1] < 960))[0]
            flat_idx[sess[s0]] = s0 + m2[-1] if len(m2) else s1

    trades = []
    cur_sess, day_n, day_r, busy_until = None, 0, 0.0, -1
    for i in sig:
        if i <= busy_until:  # still in a position
            continue
        s = sess[i]
        if s != cur_sess:
            cur_sess, day_n, day_r = s, 0, 0.0
        if day_n >= max_trades or day_r <= -max_loss_r:
            continue
        side = 1 if x_up[i] else -1
        if regime_filter and side != rgm[i]:
            continue
        e = c[i]; rk = stop*atr[i]
        sp = e - side*rk; tp = e + side*tgt*atr[i]
        fi = flat_idx[s]
        j, gross = None, None
        for k in range(i+1, fi):
            hit_s = l[k] <= sp if side==1 else h[k] >= sp
            hit_t = h[k] >= tp if side==1 else l[k] <= tp
            if hit_s: j, gross = k, -1.0; break          # stop wins ties
            if hit_t: j, gross = k, tgt/stop; break
        if j is None:
            j = fi; gross = side*(c[fi]-e)/rk            # force flat
        risk_d = rk*PT_VAL
        trades.append((b.at[i,"ts"], s, side, rk, gross, gross - COST_RT/risk_d, risk_d))
        day_n += 1; day_r += gross; busy_until = j
    t = pd.DataFrame(trades, columns=["ts","sess","side","risk_pts","gross_r","net_r","risk_d"])
    return t

def stats(t, label=""):
    if len(t)==0: return {"label":label,"n":0}
    eq = t.net_r.cumsum(); dd = (eq - eq.cummax()).min()
    risk = t.risk_d.mean()
    yrs = (t.ts.iloc[-1]-t.ts.iloc[0]).days/365.25
    w = t.net_r > 0
    pf = t.net_r[t.net_r>0].sum() / max(1e-9, -t.net_r[t.net_r<=0].sum())
    return {"label":label, "n":len(t), "wr":100*w.mean(), "avg_r":t.net_r.mean(),
            "pf":pf, "tot_r":t.net_r.sum(), "r_yr":t.net_r.sum()/max(yrs,1e-9),
            "dd_r":dd, "risk$":risk, "dd$":dd*risk, "pnl$_yr":t.net_r.sum()/max(yrs,1e-9)*risk}

def fmt(s):
    if s.get("n",0)==0: return f"{s.get('label','')}: no trades"
    return (f"{s['label']:<26} n={s['n']:<5} WR={s['wr']:5.1f}%  avgR={s['avg_r']:+.3f}  PF={s['pf']:.2f}  "
            f"R/yr={s['r_yr']:+6.1f}  maxDD={s['dd_r']:6.1f}R (${s['dd$']:,.0f})  "
            f"avg risk=${s['risk$']:.0f}  P&L/yr=${s['pnl$_yr']:,.0f}")

def ruin(t, start=1000., floor=400., n_paths=5000, n_per_yr=None, seed=7):
    if len(t)<50: return float("nan")
    rng = np.random.default_rng(seed)
    yrs = (t.ts.iloc[-1]-t.ts.iloc[0]).days/365.25
    n_per_yr = n_per_yr or int(len(t)/yrs)
    pnl = (t.net_r * t.risk_d).to_numpy()
    ruined = 0
    for _ in range(n_paths):
        eqv = start + np.cumsum(rng.choice(pnl, n_per_yr))
        if eqv.min() < floor: ruined += 1
    return 100*ruined/n_paths

if __name__ == "__main__":
    b = load_5m()
    split = "2023-01-01"
    print(f"bars(5m)={len(b)}  {b.ts.iloc[0]} .. {b.ts.iloc[-1]}")

    base = dict(buf=0.25, stop=1.0, tgt=2.0, max_trades=2, max_loss_r=2.0,
                win_end=900, longs=True, shorts=True, regime_filter=False)
    t = run(b, **base)
    print("\n=== BASELINE (shipped defaults) ===")
    print(fmt(stats(t, "full 2019-2026")))
    print(fmt(stats(t[t.ts <  split], "IS  2019-2022")))
    print(fmt(stats(t[t.ts >= split], "OOS 2023-2026")))
    for y, g in t.groupby(t.ts.dt.year):
        print(f"  {y}: n={len(g):4d}  totR={g.net_r.sum():+7.1f}  WR={100*(g.net_r>0).mean():.0f}%")
    print(f"1yr ruin prob @$1k (floor $400): {ruin(t):.1f}%")

    if "--sweep" in sys.argv:
        print("\n=== SWEEP (rank on IS, judge on OOS) ===")
        grid = list(itertools.product(
            [0.15,0.25,0.40],      # buf
            [0.75,1.0,1.5],        # stop
            [1.5,2.0,3.0],         # tgt
            [1,2],                 # max_trades
            [900,690],             # win_end: 15:00 or 11:30 (morning only)
            [(True,True),(True,False)],  # both / long-only
            [False,True],          # regime filter
        ))
        rows = []
        for buf,sp,tg,mt,we,(lo,sh),rf in grid:
            tt = run(b, buf=buf, stop=sp, tgt=tg, max_trades=mt, win_end=we,
                     longs=lo, shorts=sh, regime_filter=rf)
            si = stats(tt[tt.ts < split]); so = stats(tt[tt.ts >= split])
            if si.get("n",0) < 150: continue
            rows.append(dict(buf=buf,stop=sp,tgt=tg,mt=mt,we=we,lo=lo,sh=sh,rf=rf,
                             is_n=si["n"], is_avg=si["avg_r"], is_ryr=si["r_yr"], is_dd=si["dd_r"],
                             oos_n=so.get("n",0), oos_avg=so.get("avg_r",np.nan),
                             oos_ryr=so.get("r_yr",np.nan), oos_dd=so.get("dd_r",np.nan)))
        r = pd.DataFrame(rows).sort_values("is_avg", ascending=False)
        pd.set_option("display.width", 250)
        print(f"configs tested: {len(r)}")
        print("\nTOP 10 by IS avg net R  ->  their OOS truth:")
        print(r.head(10).to_string(index=False, float_format=lambda x: f"{x:+.3f}" if abs(x)<20 else f"{x:.0f}"))
        print("\nTOP 10 by OOS avg net R (for reference / overfit check):")
        print(r.sort_values("oos_avg", ascending=False).head(10).to_string(index=False, float_format=lambda x: f"{x:+.3f}" if abs(x)<20 else f"{x:.0f}"))
        pos = r[(r.is_avg>0) & (r.oos_avg>0)]
        print(f"\nconfigs positive in BOTH IS and OOS: {len(pos)}/{len(r)}")

