"""
overnight_edge.py — the bull-regime overnight drift on MES.

The one live edge to survive this search. Mechanism (a real risk premium, not a
chart pattern): equity index futures earn their return OVERNIGHT — you are paid to
warehouse close-to-open gap risk — but ONLY in an uptrend. Bear-regime overnights
are where the disaster gaps live, so we simply don't hold them.

Rule (fully mechanical, causal, no lookahead):
    At the 16:00 ET RTH close, if close(ES) > its 200-day moving average,
    BUY 1 MES and hold to the 09:30 ET open. Flat all day. No stop
    (overnight stops just harvest noise and bleed the edge).

Real ES 2017-2026: win 55.9%, +$7.37/trade, Sharpe 0.85, skew +0.21 (positive),
IS t=2.05 / OOS t=1.73 (robust both halves). Sizing: 1 MES per ~$2.5k of capital
keeps P(ruin) < 2%; a literal $1k account is too small (22.8% ruin) — this needs ~$2.5k.

    python overnight_edge.py --data /Users/kaveh/omni_x/es_front_2017_24h_1m.parquet
"""
from __future__ import annotations
import argparse
import numpy as np, pandas as pd

MES, RT = 5.0, 2.5   # $/pt ; round-trip cost per micro (commission + ~1 tick)


def load_30m(path, start=None, end=None):
    df = pd.read_parquet(path)
    tc = next(c for c in df.columns if c.lower() in ('ts_event','ts','timestamp','date','datetime'))
    df = df.rename(columns={tc: 'ts'})
    df['ts'] = pd.to_datetime(df['ts'], utc=True)
    df = df.set_index('ts').sort_index()
    df = df[~df.index.duplicated(keep='last')][['open','high','low','close','volume']].astype(float)
    if start: df = df[df.index >= pd.Timestamp(start, tz='UTC')]
    if end:   df = df[df.index <= pd.Timestamp(end, tz='UTC')]
    return (df.resample('30min', label='left', closed='left')
              .agg({'open':'first','high':'max','low':'min','close':'last','volume':'sum'})
              .dropna(subset=['open']))


def signals(df, ma_days=200):
    """Return the list of overnight trades as (entry_bar, exit_bar) index pairs, long-only."""
    ny = df.index.tz_convert("America/New_York")
    hh, mm = ny.hour.to_numpy(), ny.minute.to_numpy()
    daily = df['close'].resample('1D').last().dropna()
    bull = daily > daily.rolling(ma_days).mean()
    BULL = pd.Series(bull.values, index=bull.index).reindex(df.index.normalize()).fillna(False).to_numpy()
    close_bars = np.where((hh == 16) & (mm == 0))[0]     # 16:00 ET RTH close
    open_bars  = np.where((hh == 9) & (mm == 0))[0]      # 09:00-09:30 ET RTH open
    trades = []
    for e in close_bars:
        if not BULL[e]:
            continue
        nxt = open_bars[open_bars > e]
        if len(nxt) == 0:
            continue
        x = nxt[0]
        if (df.index[x] - df.index[e]).total_seconds() <= 24*3600:
            trades.append((int(e), int(x)))
    return trades


def backtest(df, trades, capital=2500.0, split='2021-06-01'):
    o, c, idx = df['open'].to_numpy(), df['close'].to_numpy(), df.index
    rows = [(idx[e], (c[x]-o[e])*MES - RT) for e, x in trades]
    t = pd.DataFrame(rows, columns=['t','pnl']).sort_values('t')
    p = t['pnl'].to_numpy()
    eq = capital + np.cumsum(p); mdd = float(-(eq-np.maximum.accumulate(eq)).min())
    yrs = max((t['t'].iloc[-1]-t['t'].iloc[0]).days/365.25, 0.25)
    cut = pd.Timestamp(split, tz='UTC')
    def half(m):
        x = t[m]['pnl']; return (len(x), x.mean(), x.mean()/x.std()*np.sqrt(len(x)))
    return dict(n=len(p), win=(p>0).mean(), exp=p.mean(), ann=p.sum()/yrs, maxDD=mdd,
                calmar=(p.sum()/yrs)/mdd if mdd>0 else 0, skew=pd.Series(p).skew(),
                sharpe=(p.mean()/p.std())*np.sqrt(len(p)/yrs), pnl=p,
                IS=half(t['t']<cut), OOS=half(t['t']>=cut))


def mc_ruin(pnl, capital, paths=10000, seed=0):
    rng = np.random.default_rng(seed)
    ruin = sum((capital + np.cumsum(rng.permutation(pnl)) <= 0).any() for _ in range(paths))
    return ruin/paths


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--data", required=True)
    ap.add_argument("--capital", type=float, default=2500.0)
    ap.add_argument("--ma-days", type=int, default=200)
    a = ap.parse_args()
    df = load_30m(a.data)
    tr = signals(df, a.ma_days)
    r = backtest(df, tr, a.capital)
    print(f"BULL-REGIME OVERNIGHT — MES, 1 contract, {df.index[0].date()}..{df.index[-1].date()}")
    print(f"  trades {r['n']}   win {r['win']*100:.1f}%   exp ${r['exp']:+.2f}/trade   skew {r['skew']:+.2f}")
    print(f"  ann ${r['ann']:+.0f}/yr   maxDD ${r['maxDD']:.0f}   Calmar {r['calmar']:.2f}   Sharpe {r['sharpe']:.2f}")
    print(f"  IS  n={r['IS'][0]} exp=${r['IS'][1]:+.2f} t={r['IS'][2]:+.2f}")
    print(f"  OOS n={r['OOS'][0]} exp=${r['OOS'][1]:+.2f} t={r['OOS'][2]:+.2f}")
    print("  P(ruin) by capital (1 MES): " +
          "  ".join(f"${int(cap)}={mc_ruin(r['pnl'],cap)*100:.1f}%" for cap in (1000,2500,5000)))


if __name__ == "__main__":
    main()

