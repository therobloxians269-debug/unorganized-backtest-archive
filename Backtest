#!/usr/bin/env python3
"""GEXLAB M1 — dealer gamma engine.

Turns a recorded chain snapshot into a small set of candidate price levels.

WHY THIS IS NOT ANOTHER PRICE-DERIVED LEVEL
-------------------------------------------
Every level family measured so far in this program (PDH/PDL, quarter H/L, 15m /
1H / 4H pivots, FVGs, order/rejection blocks) rejects at 48.5-48.7% against a
50.4% displaced-level placebo. Those are all endogenous: derived from past
price, common knowledge, with nobody's capital committed to defending them.

A large-gamma strike is different in kind. If dealers are net long gamma at K,
their delta hedge is mechanically mean-reverting near K: sell into rallies, buy
into dips, sized by the gamma. That is a forced flow backed by real inventory,
not a drawing. It is the one reason to expect a level to behave differently
from a coin flip. Whether it actually does is an empirical question this module
does not answer -- it only produces the candidates for M3 to test.

THE SIGN CONVENTION IS AN ASSUMPTION, NOT DATA
----------------------------------------------
Open interest is unsigned. Nothing in this feed says who is long. The standard
convention (SqueezeMetrics) assumes dealers are LONG call OI and SHORT put OI.
That is a guess about customer behaviour, and every public GEX chart inherits
it. It is falsifiable for free, and M2 does exactly that: if the convention is
right, high net-GEX sessions must realise LOWER intraday vol than low net-GEX
sessions. If realised vol comes out flat, the levels are decoration. If it
comes out inverted, the sign is backwards. Run that control before trusting a
single level from this file.

    python3 gex.py                    # newest QQQ snapshot -> levels
    python3 gex.py --validate         # check my BS gamma against CBOE's greeks
    python3 gex.py --profile          # print the strike-by-strike GEX ladder
    python3 gex.py --pine             # emit the paste string for the indicator
"""
from __future__ import annotations

import re
import sys
import datetime as dt
from dataclasses import dataclass, field
from pathlib import Path

import numpy as np
import pandas as pd

ROOT = Path(__file__).resolve().parent
DATA = ROOT / "data" / "chains"

R_FREE = 0.043      # short-rate; gamma is nearly insensitive to it at these tenors
Q_DIV = 0.005       # QQQ distribution yield
CONTRACT = 100      # shares per contract
MIN_T = 1.0 / (365.25 * 24 * 6)   # 10 minutes, floors the 0DTE gamma blowup

# Dealer sign per side under the standard convention. ASSUMPTION -- see docstring.
DEALER_SIGN = {"C": +1.0, "P": -1.0}

N_LEVELS = 5      # strongest gamma strikes taken EACH side; merged and
                  # re-ranked by |gamma| into GEX 1..2*N_LEVELS


# ───────────────────────────── Black-Scholes ─────────────────────────────
def norm_pdf(x: np.ndarray) -> np.ndarray:
    return np.exp(-0.5 * x * x) / np.sqrt(2.0 * np.pi)


def norm_cdf(x: np.ndarray) -> np.ndarray:
    from scipy.special import ndtr
    return ndtr(np.asarray(x, float))


def _d1d2(S, K, T, sigma, r=None, q=None):
    # Read the module constants at CALL time, not definition time. Binding them as
    # default arguments (r=R_FREE) freezes them at import, so `gex.R_FREE = 0.05`
    # becomes a silent no-op -- the config appears to change and nothing does.
    r = R_FREE if r is None else r
    q = Q_DIV if q is None else q
    S = np.asarray(S, float); K = np.asarray(K, float)
    T = np.maximum(np.asarray(T, float), MIN_T)
    sigma = np.maximum(np.asarray(sigma, float), 1e-4)
    vt = sigma * np.sqrt(T)
    d1 = (np.log(S / K) + (r - q + 0.5 * sigma * sigma) * T) / vt
    return d1, d1 - vt, T, sigma, vt


def bs_gamma(S: np.ndarray, K: np.ndarray, T: np.ndarray, sigma: np.ndarray,
             r=None, q=None) -> np.ndarray:
    """Per-share gamma. Identical for calls and puts (put-call parity)."""
    r = R_FREE if r is None else r
    q = Q_DIV if q is None else q
    d1, _, T, sigma, vt = _d1d2(S, K, T, sigma, r, q)
    return np.exp(-q * T) * norm_pdf(d1) / (np.asarray(S, float) * vt)


def bs_vanna(S, K, T, sigma, r=None, q=None) -> np.ndarray:
    """dDelta/dVol. Per 1.00 of vol (i.e. 100 vol points); scale by 0.01 for one.

    Vanna is why a vol crush mechanically forces dealers to buy: their delta
    changes with NO move in spot at all. Same for calls and puts.
    """
    r = R_FREE if r is None else r
    q = Q_DIV if q is None else q
    d1, d2, T, sigma, _ = _d1d2(S, K, T, sigma, r, q)
    return -np.exp(-q * T) * norm_pdf(d1) * d2 / sigma


def bs_charm(S, K, T, sigma, right: np.ndarray, r=None, q=None) -> np.ndarray:
    """dDelta/dt per CALENDAR DAY of time passing.

    The purest "forced hedge" of the three: charm moves dealer delta even when
    spot and vol are both perfectly still, purely because the clock ran. It is
    what drives the late-day drift on expiry and 0DTE-heavy sessions.
    """
    r = R_FREE if r is None else r
    q = Q_DIV if q is None else q
    d1, d2, T, sigma, vt = _d1d2(S, K, T, sigma, r, q)
    common = -np.exp(-q * T) * norm_pdf(d1) * (2 * (r - q) * T - d2 * vt) / (2 * T * vt)
    is_call = np.asarray(right) == "C"
    carry = np.where(is_call,
                      q * np.exp(-q * T) * norm_cdf(d1),
                     -q * np.exp(-q * T) * norm_cdf(-d1))
    # NB: this closed form is already d(delta)/dt with t = calendar time passing
    # (i.e. it equals -d(delta)/dT). Negating it again inverts every charm call,
    # which is what the finite-difference test in selftest.py exists to catch.
    return (common + carry) / 365.25


# ───────────────────────────── snapshot loading ─────────────────────────────
def quality(path: Path) -> tuple[bool, str]:
    """Is this snapshot usable? Returns (ok, reason).

    OBSERVED 2026-08-10, and the reason this function exists: CBOE served the
    _NDX chain with EVERY implied vol set to 0.0000 from ~09:34 ET onward. The
    file looked healthy by every cheap check -- 17,020 rows, 6,505 of them with
    real open interest, correct spot, correct expiries -- but IV is the one input
    Black-Scholes gamma cannot be computed without, so the entire chain silently
    evaporated at the loader's filter and `--update` died on an empty frame.

    A crash is the good outcome here. The bad outcome is a partial zeroing that
    leaves just enough rows to produce a plausible-looking but wrong map, so this
    checks the SHARE of usable contracts rather than merely "not zero".
    """
    try:
        df = pd.read_parquet(path)
    except Exception as e:  # noqa: BLE001
        return False, f"unreadable ({type(e).__name__})"
    if df.empty:
        return False, "file has no rows"
    for c in ("iv", "open_interest", "spot", "strike", "expiry"):
        if c not in df.columns:
            return False, f"missing column '{c}'"
    oi = df["open_interest"] > 0
    if not oi.any():
        return False, "no contracts carry open interest"
    iv_ok = (df["iv"] > 1e-3) & oi
    share = iv_ok.sum() / max(oi.sum(), 1)
    if share < 0.50:
        return False, (f"IV column is degenerate — only {iv_ok.sum():,} of "
                       f"{int(oi.sum()):,} contracts with OI have a usable IV "
                       f"({share:.1%}); CBOE serves all-zero IV intermittently")
    if not np.isfinite(float(df["spot"].iloc[0])) or float(df["spot"].iloc[0]) <= 0:
        return False, "spot is missing or non-positive"
    return True, f"{iv_ok.sum():,} usable contracts ({share:.0%} of OI rows)"


def latest_snapshot(root: str = "QQQ", verbose: bool = True) -> Path:
    """Newest USABLE snapshot, not merely the newest file.

    Walks backwards past unusable files and says so out loud. Falling back to an
    older snapshot is a real cost -- the open interest is staler -- so it is never
    done silently; the caller prints the as-of time and the age is visible.
    """
    d = DATA / root
    fs = sorted(d.glob("*.parquet")) if d.exists() else []
    if not fs:
        raise SystemExit(f"no snapshots for {root}. Run:  python3 snap.py {root}")
    skipped = []
    for p in reversed(fs):
        ok, why = quality(p)
        if ok:
            if skipped and verbose:
                print(f"  ! skipped {len(skipped)} unusable snapshot(s), newest first:")
                for q, w in skipped[:3]:
                    print(f"      {q.name}: {w}")
                print(f"    -> using {p.name} instead (OLDER data; check the as-of below)\n")
            return p
        skipped.append((p, why))
    lines = "\n".join(f"    {q.name}: {w}" for q, w in skipped[:5])
    raise SystemExit(f"every {root} snapshot on disk is unusable:\n{lines}\n"
                     f"  Re-pull with:  python3 snap.py {root}")


def load(path: Path) -> pd.DataFrame:
    df = pd.read_parquet(path)
    ts = pd.Timestamp(df["snap_ts"].iloc[0])
    exp = pd.to_datetime(df["expiry"])
    root = str(df["underlying"].iloc[0]) if "underlying" in df.columns else "QQQ"

    # Settlement time is not cosmetic: it sets T, and gamma blows up as T->0, so
    # getting it wrong misprices exactly the near-expiry strikes that matter most.
    #   QQQ (ETF)          : PM-settled, 16:00 ET.
    #   NDX 3rd Friday     : AM-settled -- it settles on the OPENING prints, so
    #                        the contract is dead at 09:30, not 16:00.
    #   NDX weeklies / EOM : PM-settled.
    third_fri = (exp.dt.weekday == 4) & exp.dt.day.between(15, 21)
    am_settled = third_fri if root.upper().lstrip("_") == "NDX" else pd.Series(False, index=exp.index)
    settle = pd.Timedelta(hours=16) - am_settled * pd.Timedelta(hours=6, minutes=30)
    secs = (exp + settle - ts).dt.total_seconds()
    df["T"] = secs / (365.25 * 24 * 3600)
    df["dte"] = (exp.dt.date - ts.date()).map(lambda x: x.days)
    df = df[(df["open_interest"] > 0) & (df["iv"] > 1e-3) & (df["T"] > 0)].copy()
    return df


# ───────────────────────────── the GEX profile ─────────────────────────────
def gex_at(df: pd.DataFrame, spot: float) -> np.ndarray:
    """Dealer $-gamma per contract row, in $ per 1% move, at a hypothetical spot.

    Per-strike IV is held fixed as spot moves (sticky-strike). That is the
    standard assumption and it is wrong in the tails; it matters little for the
    near-spot region where the flip and the walls live.
    """
    g = bs_gamma(spot, df["strike"].to_numpy(), df["T"].to_numpy(), df["iv"].to_numpy())
    sign = df["right"].map(DEALER_SIGN).to_numpy()
    return sign * g * df["open_interest"].to_numpy() * CONTRACT * spot * spot * 0.01


def profile(df: pd.DataFrame, spot: float) -> pd.DataFrame:
    d = df.copy()
    d["gex"] = gex_at(d, spot)
    p = (d.groupby("strike")
           .apply(lambda x: pd.Series({
               "gex": x["gex"].sum(),
               "call_gex": x.loc[x["right"] == "C", "gex"].sum(),
               "put_gex": x.loc[x["right"] == "P", "gex"].sum(),
               "call_oi": x.loc[x["right"] == "C", "open_interest"].sum(),
               "put_oi": x.loc[x["right"] == "P", "open_interest"].sum(),
           }), include_groups=False)
           .reset_index())
    return p.sort_values("strike").reset_index(drop=True)


def gamma_flip(df: pd.DataFrame, spot: float, lo: float = 0.90, hi: float = 1.10,
               n: int = 401) -> float | None:
    """Spot at which total dealer gamma crosses zero.

    Above it dealers are long gamma and hedging damps moves; below it they are
    short and hedging amplifies. Found by rebuilding the whole book at each
    hypothetical spot -- not by interpolating the static profile, which is the
    usual error.
    """
    grid = np.linspace(spot * lo, spot * hi, n)
    tot = np.array([gex_at(df, s).sum() for s in grid])
    sgn = np.sign(tot)
    idx = np.where(np.diff(sgn) != 0)[0]
    if len(idx) == 0:
        return None
    # the crossing nearest spot is the one that governs today
    j = idx[np.argmin(np.abs(grid[idx] - spot))]
    x0, x1, y0, y1 = grid[j], grid[j + 1], tot[j], tot[j + 1]
    return float(x0 - y0 * (x1 - x0) / (y1 - y0)) if y1 != y0 else float(x0)


def flows(df: pd.DataFrame, spot: float) -> tuple[float, float]:
    """Aggregate dealer charm and vanna exposure, in $ of delta.

    These are what gamma alone cannot give you: a DIRECTION and a CLOCK.
      charm -> $ delta the desk must trade per day purely from time passing,
               with spot and vol both frozen. Drives late-day drift.
      vanna -> $ delta per 1 vol point. Positive means a vol crush forces
               buying, which is the mechanical core of a "vanna rally".
    """
    sign = df["right"].map(DEALER_SIGN).to_numpy()
    oi = df["open_interest"].to_numpy() * CONTRACT
    K, T, iv = df["strike"].to_numpy(), df["T"].to_numpy(), df["iv"].to_numpy()
    ch = bs_charm(spot, K, T, iv, df["right"].to_numpy())
    vn = bs_vanna(spot, K, T, iv)
    return float((sign * ch * oi * spot).sum()), float((sign * vn * oi * spot * 0.01).sum())


@dataclass
class Levels:
    asof: str
    underlying: str
    spot: float
    bucket: str
    n_contracts: int
    net_gex_bn: float           # $bn per 1% move
    flip: float | None
    call_wall: float | None     # largest positive dealer gamma above spot
    put_wall: float | None      # most negative dealer gamma below spot
    pin: float | None           # largest |gamma| strike, either side
    regime: str
    charm_bn: float = 0.0       # $bn of delta forced per day by the clock alone
    vanna_bn: float = 0.0       # $bn of delta forced per 1 vol point
    # the N biggest gamma concentrations each side of spot, as (strike, gex_bn).
    # SIGNED: a strike can carry negative dealer gamma, where hedging accelerates
    # rather than pins. Calling everything above spot a "call wall" hides that.
    top_above: list = field(default_factory=list)
    top_below: list = field(default_factory=list)

    def pretty(self) -> str:
        f = lambda v: "  n/a  " if v is None else f"{v:8.2f}"
        return (f"{self.bucket:>6s}  n={self.n_contracts:5d}  "
                f"netGEX {self.net_gex_bn:+7.2f}bn/1%  flip {f(self.flip)}  "
                f"putwall {f(self.put_wall)}  callwall {f(self.call_wall)}  "
                f"pin {f(self.pin)}\n{'':>8s}charm {self.charm_bn:+6.2f}bn/day  "
                f"vanna {self.vanna_bn:+6.2f}bn/volpt  [{self.regime}]")


def levels(df: pd.DataFrame, spot: float, bucket: str, asof: str,
           underlying: str) -> Levels:
    p = profile(df, spot)
    above, below = p[p["strike"] > spot], p[p["strike"] < spot]
    # CALL WALL / PUT WALL use call gamma and put gamma SEPARATELY, which is the
    # conventional definition and a different strike from the net-gamma extreme:
    # a strike can hold huge call gamma and still net out flat once its puts are
    # subtracted. Netting first hides exactly the wall you were looking for.
    cw = float(above.loc[above["call_gex"].idxmax(), "strike"]) if len(above) and above["call_gex"].max() > 0 else None
    pw = float(below.loc[below["put_gex"].idxmin(), "strike"]) if len(below) and below["put_gex"].min() < 0 else None
    pin = float(p.loc[p["gex"].abs().idxmax(), "strike"]) if len(p) else None
    net = float(p["gex"].sum())
    ch, vn = flows(df, spot)
    # every meaningful concentration, not just the single biggest each side.
    # Ranked by |gamma| so a strike that ACCELERATES (negative dealer gamma) is
    # not silently dropped just because it is not a "wall".
    # N_LEVELS strongest each side so both sides are always represented, then the
    # two sets are merged and re-ranked by |gamma| downstream to become GEX 1..N.
    pa = p.assign(mag=p["gex"].abs())
    above = pa[pa["strike"] > spot].nlargest(N_LEVELS, "mag").sort_values("mag", ascending=False)
    below = pa[pa["strike"] < spot].nlargest(N_LEVELS, "mag").sort_values("mag", ascending=False)
    return Levels(
        asof=asof, underlying=underlying, spot=spot, bucket=bucket,
        n_contracts=int(len(df)), net_gex_bn=net / 1e9,
        flip=gamma_flip(df, spot), call_wall=cw, put_wall=pw, pin=pin,
        regime="long-gamma (damped)" if net > 0 else "short-gamma (amplified)",
        charm_bn=ch / 1e9, vanna_bn=vn / 1e9,
        top_above=[(float(r.strike), float(r.gex) / 1e9) for r in above.itertuples()],
        top_below=[(float(r.strike), float(r.gex) / 1e9) for r in below.itertuples()],
    )


BUCKETS = {"0DTE": (0, 0), "7D": (0, 7), "30D": (0, 30), "ALL": (0, 10_000)}


def all_buckets(df: pd.DataFrame, spot: float, asof: str, underlying: str) -> list[Levels]:
    out = []
    for name, (a, b) in BUCKETS.items():
        sub = df[(df["dte"] >= a) & (df["dte"] <= b)]
        if len(sub) < 20:
            continue
        out.append(levels(sub, spot, name, asof, underlying))
    return out


# ───────────────────────────── ETF strike -> futures price ─────────────────────────────
def to_futures(level: float, etf_spot: float, fut_spot: float) -> float:
    """Map by RELATIVE distance, never by a fixed multiplier.

    NQ/QQQ drifts with dividends, financing and the expense ratio, so a constant
    ratio silently biases every level. Proportional distance from spot is
    invariant to all of that.
    """
    return fut_spot * (level / etf_spot)


def futures_spot(sym: str = "NQ=F") -> float | None:
    try:
        import yfinance as yf
        v = yf.Ticker(sym).fast_info.get("lastPrice")
        return float(v) if v else None
    except Exception:  # noqa: BLE001
        return None


def index_ticker(root: str) -> str:
    return "^NDX" if root.upper().lstrip("_") == "NDX" else root.upper().lstrip("_")


def carry_ratio(fut: str = "NQ=F", root: str = "_NDX"):
    """Futures/cash ratio taken at the last SYNCHRONOUS close.

    F = S * exp((r-q)T), so the RATIO is the stable quantity and the point
    difference is not -- which is why levels map proportionally.

    The trap is using a LIVE future against a STALE index. NDX stops printing at
    16:00 while NQ trades all night, so live_NQ / friday_NDX is not the carry
    basis: it is the carry basis plus the entire overnight move, and it drags
    every level with it. Measured on this snapshot the two ratios differ by
    0.119%, which is ~35 NQ points -- 3.5x the strike spacing. Both legs must be
    read at the same instant.
    """
    import yfinance as yf
    f = yf.Ticker(fut).history(period="1mo", interval="1d")
    s = yf.Ticker(index_ticker(root)).history(period="1mo", interval="1d")
    if f.empty or s.empty:
        return None
    f.index = pd.to_datetime(f.index).tz_localize(None).normalize()
    s.index = pd.to_datetime(s.index).tz_localize(None).normalize()
    common = f.index.intersection(s.index)
    if len(common) == 0:
        return None
    d = common[-1]
    fc, sc = float(f.loc[d, "Close"]), float(s.loc[d, "Close"])
    return fc / sc, d, fc, sc


def strike_step(df: pd.DataFrame, spot: float) -> float:
    """Modal gap between adjacent listed strikes near the money.

    This is the block's width, and it is a real quantity rather than invented
    padding: gamma sits on a discrete strike, so the strike interval is the
    natural width of that strike's zone once mapped into futures points.
    """
    ks = np.sort(df.loc[(df["strike"] / spot).between(0.97, 1.03), "strike"].unique())
    if len(ks) < 3:
        return 1.0
    d = np.diff(ks)
    d = d[d > 0]
    return float(pd.Series(d).mode().iloc[0]) if len(d) else 1.0


def _nyse_holidays(a: pd.Timestamp, b: pd.Timestamp):
    from pandas.tseries.holiday import (AbstractHolidayCalendar, Holiday, GoodFriday,
                                        USMartinLutherKingJr, USPresidentsDay,
                                        USMemorialDay, USLaborDay, USThanksgivingDay,
                                        nearest_workday)

    class NYSE(AbstractHolidayCalendar):
        # NYSE is NOT the federal calendar: it closes Good Friday, and it stays
        # OPEN on Columbus Day and Veterans Day.
        rules = [
            Holiday("NewYears", month=1, day=1, observance=nearest_workday),
            USMartinLutherKingJr, USPresidentsDay, GoodFriday, USMemorialDay,
            Holiday("Juneteenth", month=6, day=19, start_date="2021-06-18",
                    observance=nearest_workday),
            Holiday("July4", month=7, day=4, observance=nearest_workday),
            USLaborDay, USThanksgivingDay,
            Holiday("Christmas", month=12, day=25, observance=nearest_workday),
        ]

    return set(NYSE().holidays(a, b).normalize())


def applies_to(asof: str) -> str:
    """Which SESSION these levels govern.

    Two traps, both silent:
      1. A chain pulled after the close describes the NEXT session. Stamping it
         with its own date would make any backtest look a day clairvoyant.
      2. The stamp must land on a real trading day. CBOE stamps its weekend file
         with a Saturday date; a Saturday key matches no session, so the
         indicator finds nothing and draws an empty chart with no error.
    """
    ts = pd.Timestamp(asof)
    target = ts.normalize() + (pd.Timedelta(days=1) if ts.hour >= 16 else pd.Timedelta(0))
    hol = _nyse_holidays(target - pd.Timedelta(days=5), target + pd.Timedelta(days=30))
    for _ in range(30):
        if target.weekday() < 5 and target not in hol:
            return target.strftime("%Y%m%d")
        target += pd.Timedelta(days=1)
    return target.strftime("%Y%m%d")


ROWS_FILE = ROOT / "data" / "pine_rows.txt"
PINE_FILE = ROOT / "GEX_Map.pine"
KEEP_ROWS = 60


def update_pine(row: str, keep: int = KEEP_ROWS) -> str:
    """Append today's row to the rolling history and re-bake it into the indicator.

    Pine cannot fetch anything. TradingView has no options feed, so there is no
    version of this that live-updates itself: the numbers are computed here and
    carried across by hand. This makes that carry one copy-paste instead of
    editing a string by eye.
    """
    date = row.split(",", 1)[0]
    ROWS_FILE.parent.mkdir(parents=True, exist_ok=True)
    old = ROWS_FILE.read_text().split() if ROWS_FILE.exists() else []
    kept = [r for r in old if r and not r.startswith(date)]   # today replaces today
    kept.append(row)
    kept = sorted(set(kept))[-keep:]
    ROWS_FILE.write_text("\n".join(kept) + "\n")

    block = ";".join(kept)
    src = PINE_FILE.read_text()
    m = re.search(r'(input\.text_area\(\s*\n?\s*")([^"]*)(")', src)
    if not m:
        return "\n!! could not find the text_area default in GEX_Map.pine"
    PINE_FILE.write_text(src[:m.start(2)] + block + src[m.end(2):])

    return (f"\n{len(kept)} session(s) now in {ROWS_FILE.name}; "
            f"GEX_Map.pine default rebaked.\n"
            f"Paste this into the indicator's 'GEX rows' box "
            f"(no need to re-paste the script):\n\n{block}\n")


def now_view(sym: str = "NQ=F") -> str:
    """Where price sits against the levels right now, with the RR geometry.

    Reads the same rows the indicator is using, so this and the chart can never
    disagree. The RR column is the only filter in this whole program that has
    survived everything: a setup with under ~2R of room to its target loses money
    even at a high hit rate, and RR is known BEFORE entry, so it costs nothing.
    """
    if not ROWS_FILE.exists():
        return "no rows yet — run:  python3 gex.py _NDX --update"
    row = ROWS_FILE.read_text().split()[-1].split(",")
    px = futures_spot(sym)
    if px is None:
        return f"could not quote {sym}"

    flip = float(row[1])
    netgex, charm = float(row[2]), float(row[4])

    # ROW LAYOUT — the single definition, and it must match GEX_Map.pine, which
    # parses the same string with `ik = 8 + 2 * j`.
    #   [0..7]  date, flip, netGEX, width, charm, vanna, callWall, putWall
    #   [8..]   ten (strike, gamma) pairs
    # This read from index 6 instead of 8: it consumed callWall/putWall as a
    # phantom (strike, gamma) pair -- printing a putWall of 29195.84 as a "gamma"
    # of +29195.840 next to every other level's 0.2-0.6 -- and, reading ten pairs
    # from two fields early, silently dropped the LAST real level off the map.
    # The Pine was right the whole time, so the chart and the terminal were
    # describing different sets of levels.
    HDR, N_PAIRS = 8, 10
    lv = []
    for j in range(N_PAIRS):
        ik = HDR + 2 * j
        if ik + 1 >= len(row):
            break
        k, g = row[ik], row[ik + 1]
        if k != "na" and g != "na":
            lv.append((float(k), float(g)))
    lv.sort(key=lambda x: -x[0])

    out = [f"\nsession {row[0]}   {sym.replace('=F','')} now {px:.2f}",
           f"regime: {'LONG gamma — hedging DAMPS' if netgex > 0 else 'SHORT gamma — hedging AMPLIFIES'}"
           f"   ({netgex:+.2f}bn/1%)",
           f"flip {flip:.2f} — price is {abs(px - flip):.0f} pts "
           f"{'ABOVE' if px > flip else 'BELOW'} it",
           f"charm {charm:+.2f}bn/day — desk must {'BUY' if charm > 0 else 'SELL'} into the clock",
           "", f"  {'level':>10} {'gamma':>9} {'kind':>12} {'dist':>8}"]
    for i, (k, g) in enumerate(lv):
        out.append(f"  {k:>10.2f} {g:>+9.3f} {'PINS' if g > 0 else 'ACCELERATES':>12} "
                   f"{k - px:>+8.0f}")
        nxt = lv[i + 1][0] if i + 1 < len(lv) else float("-inf")
        if k > px >= nxt:
            out.append(f"{'':>41}——— price {px:.2f} ———")

    above = sorted([k for k, _ in lv if k > px])
    below = sorted([k for k, _ in lv if k < px], reverse=True)
    out += ["", "  RR geometry from here (target = next level, stop = level behind):"]
    if above and below:
        rr_l = (above[0] - px) / max(px - below[0], 1e-9)
        rr_s = (px - below[0]) / max(above[0] - px, 1e-9)
        out.append(f"    LONG  -> {above[0]:.2f}  stop {below[0]:.2f}   "
                   f"RR {rr_l:>6.3f}  {'PASSES >=2R' if rr_l >= 2 else 'FAILS the 2R gate'}")
        out.append(f"    SHORT -> {below[0]:.2f}  stop {above[0]:.2f}   "
                   f"RR {rr_s:>6.3f}  {'PASSES >=2R' if rr_s >= 2 else 'FAILS the 2R gate'}")
    if len(above) >= 2 and below:
        rr = (above[0] - below[0]) / max(above[1] - above[0], 1e-9)
        out.append(f"    SHORT from {above[0]:.2f} -> {below[0]:.2f}  stop {above[1]:.2f}   "
                   f"RR {rr:>6.3f}  {'PASSES' if rr >= 2 else 'fails'}   (wait for the tag)")
    out.append("\n  Levels are a STOP/TARGET map. Nothing here is a measured entry.")
    return "\n".join(out)


def pine_row(df: pd.DataFrame, spot: float, asof: str, ls: list[Levels]) -> str:
    """One CSV row for the GEX_Map indicator, mapped into the target's price."""
    sym = "NQ=F"
    if "--sym" in sys.argv:
        sym = sys.argv[sys.argv.index("--sym") + 1]
    # MEASURED, not preferred: sign.py --oi-decay shows traded volume / standing OI
    # runs 1.71 at 2-7 DTE but only 0.14 at 8-30 DTE. Near-dated positions are
    # opened AND closed inside the session, so overnight OI cannot see them -- a
    # 0DTE "wall" from OI describes yesterday's leftovers. Worse, intraday 0DTE
    # volume concentrates at different strikes than standing OI (round numbers,
    # chasing spot), so it is the LEVEL that is wrong, not merely the scale.
    # 30D is the default because it is the widest bucket whose OI is trustworthy.
    order = ["30D", "7D", "ALL", "0DTE"]
    if "--bucket" in sys.argv:
        order = [sys.argv[sys.argv.index("--bucket") + 1]] + order
    L = next((x for b in order for x in ls if x.bucket == b), ls[-1])
    root = str(df["underlying"].iloc[0])
    if sym.upper() in ("QQQ", "NONE"):
        ratio, label, refline = 1.0, root, "raw strikes, no mapping"
    else:
        cr = carry_ratio(sym, root)
        if cr is None:
            return f"\ncould not build a synchronous {sym}/{root} ratio"
        ratio, d, fc, sc = cr
        label = sym.replace("=F", "")
        refline = (f"carry ratio {ratio:.6f} from the last synchronous close "
                   f"{d:%Y-%m-%d}: {label} {fc:.2f} / {root} {sc:.2f}")

    conv = lambda v: v * ratio if v else float("nan")
    step = strike_step(df, spot) * ratio
    day = applies_to(asof)

    # merge both sides and re-rank by |gamma| so index j becomes "GEX j+1",
    # the ranking convention every commercial gamma chart uses
    merged = sorted(L.top_above + L.top_below, key=lambda x: -abs(x[1]))
    n_slots = N_LEVELS * 2

    cells = [day, f"{conv(L.flip):.2f}", f"{L.net_gex_bn:.2f}", f"{step:.2f}",
             f"{L.charm_bn:.2f}", f"{L.vanna_bn:.2f}",
             f"{conv(L.call_wall):.2f}" if L.call_wall else "na",
             f"{conv(L.put_wall):.2f}" if L.put_wall else "na"]
    for i in range(n_slots):
        if i < len(merged):
            k, g = merged[i]
            cells += [f"{conv(k):.2f}", f"{g:.3f}"]
        else:
            cells += ["na", "na"]
    row = ",".join(cells)

    lines = [f"\n{label} levels   bucket {L.bucket}   block width {step:.1f} pts"
             f"   governs session {day}",
             f"  {refline}",
             f"  charm {L.charm_bn:+.2f}bn/day  -> desk must "
             f"{'BUY' if L.charm_bn > 0 else 'SELL'} delta as the clock runs",
             f"  vanna {L.vanna_bn:+.2f}bn/volpt -> a vol crush forces "
             f"{'BUYING' if L.vanna_bn > 0 else 'SELLING'}",
             "",
             f"  {'HVL / flip':<12} {conv(L.flip):>10.2f}   regime boundary",
             f"  {'CALL WALL':<12} {conv(L.call_wall):>10.2f}   largest CALL gamma above spot"
             if L.call_wall else f"  {'CALL WALL':<12} {'n/a':>10}",
             f"  {'PUT WALL':<12} {conv(L.put_wall):>10.2f}   largest PUT gamma below spot"
             if L.put_wall else f"  {'PUT WALL':<12} {'n/a':>10}",
             ""]
    for i, (k, g) in enumerate(merged):
        lines.append(f"  {'GEX ' + str(i + 1):<12} {conv(k):>10.2f}   {g:+.3f} bn/1%   "
                     f"{'PINS' if g > 0 else 'ACCELERATES'}")
    lines += ["\nPaste into GEX_Map.pine (one row per session, newline separated):",
              f"  {row}"]
    return "\n".join(lines)


# ───────────────────────────── CLI ─────────────────────────────
def validate(df: pd.DataFrame, spot: float) -> None:
    """Positive control: my BS gamma vs CBOE's own greeks on the same rows.

    If these disagree the pricer is wrong and every level downstream is noise.
    """
    d = df[(df["gamma"] > 0) & (df["dte"] >= 1)].copy()
    d["mine"] = bs_gamma(spot, d["strike"].to_numpy(), d["T"].to_numpy(), d["iv"].to_numpy())
    d["relerr"] = (d["mine"] - d["gamma"]).abs() / d["gamma"]
    corr = d["mine"].corr(d["gamma"])
    print(f"pricer check vs CBOE greeks   n={len(d):,}")
    print(f"  corr            {corr:.6f}")
    print(f"  median rel err  {d['relerr'].median():.4%}")
    print(f"  p90 rel err     {d['relerr'].quantile(0.90):.4%}")
    near = d[(d["strike"] / spot).between(0.95, 1.05)]
    print(f"  near-the-money (0.95-1.05 S)  n={len(near):,}  "
          f"median rel err {near['relerr'].median():.4%}")
    ok = corr > 0.99 and near["relerr"].median() < 0.05
    print(f"  VERDICT: {'PASS' if ok else 'FAIL — do not trust downstream levels'}")


def main() -> None:
    root = next((a.upper() for a in sys.argv[1:] if not a.startswith("-")), "QQQ")
    if "--now" in sys.argv:
        print(now_view())
        return
    path = latest_snapshot(root)
    df = load(path)
    spot = float(df["spot"].iloc[0])
    asof = str(pd.Timestamp(df["snap_ts"].iloc[0]))

    print(f"snapshot  {path.name}")
    print(f"as-of     {asof} ET     {root} spot {spot:.2f}     "
          f"{len(df):,} live contracts\n")

    if "--validate" in sys.argv:
        validate(df, spot)
        return

    ls = all_buckets(df, spot, asof, root)
    for L in ls:
        print(L.pretty())

    if "--profile" in sys.argv:
        sub = df[df["dte"] <= 7]
        p = profile(sub, spot)
        p = p[(p["strike"] / spot).between(0.96, 1.04)]
        print("\n  strike      netGEX($m/1%)   callOI    putOI")
        for _, r in p.iterrows():
            bar = "█" * min(40, int(abs(r["gex"]) / 2e7))
            print(f"  {r['strike']:8.1f}  {r['gex']/1e6:+12.1f}  "
                  f"{r['call_oi']:8.0f} {r['put_oi']:8.0f}  {bar}")

    if "--pine" in sys.argv or "--update" in sys.argv:
        out = pine_row(df, spot, asof, ls)
        print(out)
        if "--update" in sys.argv:
            row = out.strip().splitlines()[-1].strip()
            print(update_pine(row))


