import pandas as pd, numpy as np
from engine import *

def collect(df, ext_tf=15, int_tf=5, L=1, R=1, ref='either',
            ext_window=240, int_window=120, require_sweep=True):
    ext_ev=smt_events(rs(df,ext_tf),L,R,ref); int_ev=smt_events(rs(df,int_tf),L,R,ref)
    ext_time={}; int_time={}
    for t,d in ext_ev: ext_time.setdefault(t+pd.Timedelta(minutes=ext_tf),[]).append(d)
    for t,d in int_ev: int_time.setdefault(t+pd.Timedelta(minutes=int_tf),[]).append(d)
    idx=df.index; c=df['c'].values; TDO=df['TDO'].values
    dh=df['dhigh'].values; dl=df['dlow'].values
    cb=df['cisd_bear'].values; cl_=df['cisd_bull'].values
    sess=df['sess'].values; day=df['daycycle'].values
    n=len(df); armed_ext={-1:None,1:None}; armed_int={-1:None,1:None}
    sig=[]; ne=ni=0
    for i in range(n):
        t=idx[i]
        if t in ext_time:
            for d in ext_time[t]: armed_ext[d]=i; ne+=1
        if t in int_time:
            for d in int_time[t]:
                e=armed_ext[d]
                if e is not None and 0<=(i-e)<=ext_window: armed_int[d]=i; ni+=1
        for d in (-1,1):
            a=armed_int[d]
            if a is None: continue
            if (i-a)>int_window: armed_int[d]=None; continue
            if require_sweep:
                if d==-1 and not (dh[i]>TDO[i]): continue
                if d== 1 and not (dl[i]<TDO[i]): continue
            lvl = cb[i] if d==-1 else cl_[i]
            if np.isnan(lvl): continue
            fired=(c[i]<lvl) if d==-1 else (c[i]>lvl)
            prev_ok=(c[i-1]>=lvl) if d==-1 else (c[i-1]<=lvl)
            if fired and prev_ok and i+1<n:
                sig.append((i,idx[i+1],d,sess[i],day[i],a))
                armed_int[d]=None; armed_ext[d]=None
    return pd.DataFrame(sig,columns=['i','t','d','sess','day','arm_i']), ne, ni

def fwd_stats(df,sig,horizons=(5,15,30,60,120,240)):
    o=df['o'].values; h=df['h'].values; l=df['l'].values; n=len(df)
    rows=[]
    for _,s in sig.iterrows():
        i=int(s.i)+1
        if i>=n: continue
        e=o[i]; r={'d':s.d,'t':s.t,'sess':s.sess}
        for H in horizons:
            j=min(i+H,n-1)
            r[f'f{H}']=(o[j]-e)*s.d
            r[f'mfe{H}']=(h[i:j+1].max()-e)*s.d if s.d==1 else (e-l[i:j+1].min())
            r[f'mae{H}']=(e-l[i:j+1].min()) if s.d==1 else (h[i:j+1].max()-e)
        rows.append(r)
    return pd.DataFrame(rows)

