"""
Oil (MCL) trend-following test on 16y real CL daily (Databento GLBX).

Why oil: crude is the best trend-following asset in futures (fat tails, persistent
directional moves) — the natural home of POSITIVE skew, which is the user's mandate.
Equity indices (all we tested tonight) are the WORST place for this; oil is the best.

Two classic positive-skew trend systems, honestly costed for MCL ($100/$1 move, $1/tick):
  1) Donchian breakout (Turtle): long on N-day high break, flat/short on N-day low break,
     ride the trend. Cuts losers, lets winners run -> right-skewed.
  2) Time-series momentum: position = sign(trailing L-day return).
IS/OOS split, Sharpe, t-stat, and SKEW (must be > 0 for the mandate).
"""
import databento as db
import pandas as pd, numpy as np
from scipy import stats as sps

PATH = "/Users/kaveh/cl_data/GLBX-20260623-D5LY89873W/glbx-mdp3-20100606-20260622.ohlcv-1d.dbn.zst"
MCL_PT = 100.0        # $ per $1.00 move (100 barrels)
TICK = 0.01
COST_RT = 2.5         # $ per MCL round-turn (comm ~1.5 + ~1 tick slip)
IS_END = pd.Timestamp("2019-01-01")

def load_front():
    """Build a continuous FRONT-month crude daily series (volume-based front) and
    within-contract returns (no roll-gap contamination)."""
    store = db.DBNStore.from_file(PATH)
    df = store.to_df()
    df = df.reset_index()
    # normalize columns
    tcol = "ts_event" if "ts_event" in df.columns else df.columns[0]
    df["day"] = pd.to_datetime(df[tcol]).dt.tz_localize(None).dt.normalize()
    idcol = "instrument_id" if "instrument_id" in df.columns else "symbol"
    df = df[["day", idcol, "open", "high", "low", "close", "volume"]].dropna()
    # front = max-volume contract each day
    idx = df.groupby("day")["volume"].idxmax()
    front = df.loc[idx].set_index("day").sort_index()
    # within-contract daily returns: only keep return when same contract as prior day
    front["ret"] = np.nan
    prev_id = front[idcol].shift(1); prev_close = front["close"].shift(1)
    same = front[idcol] == prev_id
    front.loc[same, "ret"] = np.log(front["close"] / prev_close)[same]
    return front

def donchian(front, N=20, exitN=10):
    """Long/short Donchian breakout on the front close, per-trade P&L in $ (1 MCL)."""
    c = front["close"]; h = front["high"]; l = front["low"]
    upper = h.rolling(N).max().shift(1); lower = l.rolling(N).min().shift(1)
    xlow = l.rolling(exitN).min().shift(1); xhigh = h.rolling(exitN).max().shift(1)
    pos = 0; entry = 0.0; trades = []
    idx = front.index
    for i in range(N + 1, len(front)):
        px = c.iloc[i]
        if pos == 0:
            if px > upper.iloc[i]: pos = 1; entry = px; ed = idx[i]
            elif px < lower.iloc[i]: pos = -1; entry = px; ed = idx[i]
        elif pos == 1:
            if px < xlow.iloc[i]:
                trades.append({"in": ed, "out": idx[i], "dir": 1, "pnl": (px-entry)*MCL_PT - COST_RT})
                pos = 0
                if px < lower.iloc[i]: pos = -1; entry = px; ed = idx[i]
        elif pos == -1:
            if px > xhigh.iloc[i]:
                trades.append({"in": ed, "out": idx[i], "dir": -1, "pnl": (entry-px)*MCL_PT - COST_RT})
                pos = 0
                if px > upper.iloc[i]: pos = 1; entry = px; ed = idx[i]
    return pd.DataFrame(trades)

def tsmom(front, L=60):
    r = front["ret"].fillna(0)
    sig = np.sign(r.rolling(L).sum())
    strat = sig.shift(1) * r
    flips = (sig.shift(1) != sig.shift(2)).astype(float)
    # cost per flip in return units (~2 ticks / price)
    strat = strat - flips * (COST_RT / (front["close"] * MCL_PT))
    return strat.dropna()

def rep_trades(tr, label):
    if len(tr) == 0: print(f"  {label:<28} no trades"); return
    p = tr["pnl"]; wr = (p>0).mean()*100
    t = p.mean()/p.std()*np.sqrt(len(p)) if p.std()>0 else 0
    sk = sps.skew(p)
    print(f"  {label:<28} n={len(p):>4}  net=${p.sum():+8,.0f}  avg=${p.mean():+6.1f}  win={wr:4.1f}%  "
          f"t={t:+4.2f}  skew={sk:+4.2f}")

def rep_daily(s, label):
    if len(s) < 50: print(f"  {label:<28} n<50"); return
    sh = s.mean()/s.std()*np.sqrt(252); t = s.mean()/s.std()*np.sqrt(len(s))
    print(f"  {label:<28} Sharpe={sh:+.2f}  t={t:+.2f}  (n={len(s)})")

if __name__ == "__main__":
    front = load_front()
    print(f"CL front series: {front.index.min().date()} -> {front.index.max().date()}, {len(front)} days, "
          f"price {front.close.iloc[-1]:.1f}")
    print("="*100)
    print("DONCHIAN BREAKOUT (Turtle) on MCL — positive-skew trend. cost $2.5 RT/contract")
    print("="*100)
    for N,x in [(20,10),(40,20),(55,20)]:
        tr = donchian(front, N, x)
        rep_trades(tr, f"Donchian {N}/{x} ALL")
        rep_trades(tr[tr["in"]<IS_END], f"  {N}/{x} IS 2010-18")
        rep_trades(tr[tr["in"]>=IS_END], f"  {N}/{x} OOS 2019-26")
    print("\n" + "="*100)
    print("TIME-SERIES MOMENTUM on crude (daily) — Sharpe after costs")
    print("="*100)
    for L in [20,60,120,250]:
        s = tsmom(front, L); mid=len(s)//2
        rep_daily(s, f"TSMOM L={L} full");
    print("  --- best L IS/OOS ---")
    s = tsmom(front, 120); mid=len(s)//2
    rep_daily(s.iloc[:mid], "TSMOM L=120 IS"); rep_daily(s.iloc[mid:], "TSMOM L=120 OOS")

