"""PO3 / AMD-X on the DAY candle (not the 90m quarter — that one already died).
   Accumulation = first N hours of the 18:00 day cycle.
   Manipulation = sweep of that range.
   Distribution = the leg the other way. Enter on the reclaim."""
import pandas as pd, numpy as np, warnings; warnings.filterwarnings('ignore')
FLAT=1019
def build(df):
    o=df.copy(); m=(o.index.hour*60+o.index.minute).values
    o['minofday']=m; o['m18']=(m-1080+1440)%1440
    r=o.resample('60min',label='left',closed='left').agg({'h':'max','l':'min','c':'last'}).dropna()
    tr=pd.concat([r.h-r.l,(r.h-r.c.shift()).abs(),(r.l-r.c.shift()).abs()],axis=1).max(axis=1)
    o['atr60']=tr.rolling(14).mean().shift(1).reindex(o.index,method='ffill')
    return o

def po3_setups(b, acc_hours=6, reclaim_bars=30, min_sweep_atr=0.10):
    """one setup per day: sweep of the accumulation range, then reclaim back inside."""
    out=[]
    for day,g in b.groupby('daycycle',sort=True):
        acc=g[g.m18<acc_hours*60]
        if len(acc)<acc_hours*30: continue
        aH,aL=acc.h.max(),acc.l.min()
        post=g[(g.m18>=acc_hours*60)]
        post=post[~((post.minofday>=FLAT)&(post.minofday<1080))]
        if len(post)<60: continue
        hh=post.h.values; ll=post.l.values; cc=post.c.values; idx=post.index
        a=post.atr60.values
        swept=None
        for k in range(len(post)):
            if not np.isfinite(a[k]) or a[k]<=0: continue
            if hh[k]>aH+min_sweep_atr*a[k]: swept=('up',k,hh[k]); break
            if ll[k]<aL-min_sweep_atr*a[k]: swept=('dn',k,ll[k]); break
        if swept is None: continue
        side,k0,ext=swept
        # reclaim: close back inside the accumulation range within N bars
        rc=None
        for k in range(k0+1,min(k0+1+reclaim_bars,len(post))):
            if side=='up' and cc[k]<aH: rc=k; break
            if side=='dn' and cc[k]>aL: rc=k; break
        if rc is None: continue
        out.append(dict(day=day,t=idx[rc],dir=-1 if side=='up' else 1,
                        accH=aH,accL=aL,ext=ext,atr=a[rc],
                        i=b.index.get_loc(idx[rc])))
    return pd.DataFrame(out)

def trade(b,P,rr=4.0,stop_mode='ext',buf=2.0,max_hold=780,pv=20.,comm=4.,slip=0.25,
          tgt_mode='R',displace=None,seed=0,min_rr=0.0):
    o,h,l=b.o.values,b.h.values,b.l.values; m=b['minofday'].values; n=len(b)
    rng=np.random.default_rng(seed); out=[]
    for _,p in P.iterrows():
        i=int(p.i); d=int(p.dir)
        if i+2>=n: continue
        aH,aL,ext=p.accH,p.accL,p.ext
        if displace is not None:
            sh=displace*(1 if rng.random()<.5 else -1); aH+=sh; aL+=sh; ext+=sh
        ep=o[i+1]+(slip if d==1 else -slip)
        st=(ext-buf) if d==1 else (ext+buf)
        if (d==1 and st>=ep) or (d==-1 and st<=ep): continue
        risk=abs(ep-st)
        if risk<1.0 or risk>4*p.atr: continue
        tg = (ep+rr*risk if d==1 else ep-rr*risk) if tgt_mode=='R' else (aH if d==1 else aL)
        if abs(tg-ep)/risk<min_rr: continue
        e=min(i+1+max_hold,n); mm=m[i+1:e]
        fl=np.where((mm>=FLAT)&(mm<1080))[0]
        e2=i+1+int(fl[0]) if len(fl) else e
        hs=h[i+1:e2]; ls=l[i+1:e2]
        if len(hs)==0: continue
        sh_=(hs>=st) if d==-1 else (ls<=st)
        th=(ls<=tg) if d==-1 else (hs>=tg)
        si=int(sh_.argmax()) if sh_.any() else 10**9
        ti=int(th.argmax()) if th.any() else 10**9
        if si==10**9 and ti==10**9: k=e2-1; px=o[k]; w='time'
        elif si<=ti: k=i+1+si; px=st+(slip if d==-1 else -slip); w='stop'
        else: k=i+1+ti; px=tg; w='tgt'
        pts=(ep-px) if d==-1 else (px-ep)
        out.append(dict(t=b.index[i+1],d=d,R=(pts*pv-comm)/(risk*pv),pnl=pts*pv-comm,
                        rr=abs(tg-ep)/risk,why=w,risk=risk))
    return pd.DataFrame(out)

