#!/usr/bin/env python3
"""GEXLAB — machinery selftest. Planted vs null.

Fourteen days of API pulling is a bad time to discover the gate cannot detect
anything. This plants a known effect and confirms the gate finds it, then feeds
it pure noise and confirms the gate stays quiet. Same discipline as
flowlab/run_validation.py.

    python3 selftest.py
"""
from __future__ import annotations

import sys

import numpy as np
import pandas as pd
from scipy import stats

import gex as G
import gate as GA

PASS, FAIL = "PASS", "FAIL"
results: list[tuple[str, str, str]] = []


def check(name: str, ok: bool, detail: str = "") -> None:
    results.append((name, PASS if ok else FAIL, detail))
    print(f"  [{PASS if ok else FAIL}] {name}" + (f"  — {detail}" if detail else ""))


# ───────────────────────── layer A: the pricer ─────────────────────────
def test_pricer() -> None:
    print("\nLAYER A — Black-Scholes gamma")

    # Closed form: S=K=100, sig=0.2, T=1, r=q=0 -> d1=0.1, gamma=phi(0.1)/(S*sig*sqrt(T))
    g = G.bs_gamma(100.0, 100.0, 1.0, 0.2, r=0.0, q=0.0)
    want = stats.norm.pdf(0.1) / (100 * 0.2)
    check("ATM gamma matches closed form", abs(float(g) - want) < 1e-12,
          f"{float(g):.9f} vs {want:.9f}")

    # Gamma peaks near the money and decays into both wings.
    ks = np.array([70.0, 90.0, 100.0, 110.0, 130.0])
    gs = G.bs_gamma(100.0, ks, 0.25, 0.2)
    check("gamma peaks near the money", int(np.argmax(gs)) == 2, f"argmax={int(np.argmax(gs))}")

    # Shorter tenor -> taller, narrower ATM gamma.
    near = float(G.bs_gamma(100.0, 100.0, 1 / 52, 0.2))
    far = float(G.bs_gamma(100.0, 100.0, 1.0, 0.2))
    check("short tenor concentrates gamma", near > far, f"{near:.5f} > {far:.5f}")

    # The 0DTE floor must stop the singularity.
    tiny = float(G.bs_gamma(100.0, 100.0, 0.0, 0.2))
    check("T floor prevents 0DTE blowup", np.isfinite(tiny), f"gamma(T=0)={tiny:.4f}")

    # ── charm and vanna against numerical derivatives of delta ──
    # If these are wrong the "forced flow" direction is wrong, which is worse
    # than having no number at all.
    def delta(S, K, T, sig, right, r=G.R_FREE, q=G.Q_DIV):
        d1, _, T, _, _ = G._d1d2(S, K, T, sig, r, q)
        return np.where(np.asarray(right) == "C",
                        np.exp(-q * T) * G.norm_cdf(d1),
                        np.exp(-q * T) * (G.norm_cdf(d1) - 1))

    dt = 1.0 / 365.25
    sc = lambda x: float(np.ravel(np.asarray(x))[0])
    for K, tag in ((110.0, "OTM call"), (90.0, "ITM call")):
        T0, sig = 0.25, 0.20
        fd = sc(delta(100.0, K, T0 - dt, sig, "C") - delta(100.0, K, T0, sig, "C"))
        an = sc(G.bs_charm(100.0, K, T0, sig, np.array(["C"])))
        check(f"charm matches d(delta)/dday — {tag}", abs(an - fd) < 0.02 * max(abs(fd), 1e-4),
              f"analytic {an:+.6f} vs finite-diff {fd:+.6f}")

    # sign intuition: an OTM call's delta decays toward 0, an ITM call's toward 1
    c_otm = sc(G.bs_charm(100.0, 110.0, 0.25, 0.2, np.array(["C"])))
    c_itm = sc(G.bs_charm(100.0, 90.0, 0.25, 0.2, np.array(["C"])))
    check("charm sign: OTM call decays, ITM call builds", c_otm < 0 < c_itm,
          f"OTM {c_otm:+.5f}  ITM {c_itm:+.5f}")

    dv = 1e-4
    fd_v = sc(delta(100.0, 110.0, 0.25, 0.2 + dv, "C") - delta(100.0, 110.0, 0.25, 0.2, "C")) / dv
    an_v = sc(G.bs_vanna(100.0, 110.0, 0.25, 0.2))
    check("vanna matches d(delta)/dvol", abs(an_v - fd_v) < 0.01 * abs(fd_v),
          f"analytic {an_v:+.5f} vs finite-diff {fd_v:+.5f}")

    # vanna is a pure second cross-derivative: identical for calls and puts
    vp = sc(G.bs_vanna(100.0, 110.0, 0.25, 0.2))
    check("vanna is right-agnostic", abs(vp - an_v) < 1e-12)


# ───────────────────────── layer B: profile and flip ─────────────────────────
def synth_chain(spot: float, call_oi: dict, put_oi: dict, dte: int = 30,
                iv: float = 0.20) -> pd.DataFrame:
    rows = []
    for right, book in (("C", call_oi), ("P", put_oi)):
        for k, oi in book.items():
            rows.append({"strike": float(k), "right": right, "open_interest": float(oi),
                         "iv": iv, "T": dte / 365.25, "dte": dte, "spot": spot,
                         "snap_ts": pd.Timestamp("2026-01-05 16:00")})
    return pd.DataFrame(rows)


def test_profile() -> None:
    print("\nLAYER B — GEX profile and the gamma flip")

    # All calls, no puts -> dealers long gamma everywhere, no zero crossing.
    allcall = synth_chain(100.0, {95: 5000, 100: 9000, 105: 5000}, {})
    tot = G.gex_at(allcall, 100.0).sum()
    check("pure call book is net long gamma", tot > 0, f"netGEX={tot/1e6:+.1f}m")
    check("pure call book has no flip", G.gamma_flip(allcall, 100.0) is None)

    # Put OI at 2x the call OI on mirror strikes -> net gamma at spot is NEGATIVE,
    # so spot must RISE to neutralise it and the flip sits ABOVE spot.
    mixed = synth_chain(100.0, {105: 20000, 110: 20000}, {90: 40000, 95: 40000})
    flip = G.gamma_flip(mixed, 100.0)
    check("mixed book produces a flip", flip is not None, f"flip={flip}")
    if flip:
        # the defining invariant: the flip is an actual zero of the profile
        at_spot = abs(G.gex_at(mixed, 100.0).sum())
        at_flip = abs(G.gex_at(mixed, flip).sum())
        check("flip is a true zero of the profile", at_flip < 0.01 * at_spot,
              f"|net(flip)|={at_flip/1e6:.3f}m vs |net(spot)|={at_spot/1e6:.1f}m")
        check("put-heavy book flips ABOVE spot", flip > 100.0, f"{flip:.2f}")
        above = G.gex_at(mixed, flip + 1.5).sum()
        below = G.gex_at(mixed, flip - 1.5).sum()
        check("sign inverts across the flip", above > 0 > below,
              f"above={above/1e6:+.1f}m below={below/1e6:+.1f}m")

    # Swapping the OI between calls and puts NEGATES the profile exactly
    # (+Gc*OIc - Gp*OIp -> its own negative), so the flip must stay put while the
    # sign orientation reverses. Anything else means the solver is not finding a
    # real root.
    negated = synth_chain(100.0, {90: 40000, 95: 40000}, {105: 20000, 110: 20000})
    flip2 = G.gamma_flip(negated, 100.0)
    check("negated book keeps the same flip", flip2 is not None and abs(flip2 - flip) < 1e-6,
          f"{flip2:.4f} vs {flip:.4f}")
    check("negated book reverses sign orientation",
          G.gex_at(negated, flip2 + 1.5).sum() < 0 < G.gex_at(negated, flip2 - 1.5).sum())

    # A book that really does flip below spot: fat ATM calls holding gamma up
    # here, deep puts that only take over once spot falls into them.
    below = synth_chain(100.0, {100: 40000}, {85: 60000})
    flip3 = G.gamma_flip(below, 100.0)
    check("ATM-call / deep-put book flips BELOW spot",
          flip3 is not None and 85.0 < flip3 < 100.0, f"{flip3:.2f}" if flip3 else "none")

    # Put wall / call wall land on the right side of spot.
    L = G.levels(mixed, 100.0, "30D", "test", "SYN")
    check("call wall above spot", L.call_wall is not None and L.call_wall > 100.0, f"{L.call_wall}")
    check("put wall below spot", L.put_wall is not None and L.put_wall < 100.0, f"{L.put_wall}")

    # ETF -> futures mapping is proportional, not additive.
    m = G.to_futures(730.0, 723.23, 29834.75)
    check("ETF->futures preserves relative distance",
          abs((m / 29834.75) - (730.0 / 723.23)) < 1e-12, f"{m:.2f}")


# ───────────────────────── layer C: the gate ─────────────────────────
def synth_gate_frame(n: int, effect: float, seed: int) -> pd.DataFrame:
    """effect < 0 plants the hypothesised relationship: high gamma rank -> low vol."""
    rng = np.random.default_rng(seed)
    rank = rng.uniform(0, 1, n)
    noise = rng.normal(0, 1.0, n)
    fwd = 1.0 + effect * (rank - 0.5) + 0.35 * noise
    return pd.DataFrame({"gex_rank": rank, "fwd_park": np.maximum(fwd, 0.05)})


def test_gate() -> None:
    print("\nLAYER C — the falsification gate")

    planted = synth_gate_frame(220, effect=-0.60, seed=11)
    obs, pv = GA.placebo(planted, "gex_rank", "fwd_park", n=1000)
    check("gate DETECTS a planted negative effect", obs < 0 and pv < 0.01,
          f"rho={obs:+.3f} p={pv:.4f}")

    null = synth_gate_frame(220, effect=0.0, seed=12)
    obs0, pv0 = GA.placebo(null, "gex_rank", "fwd_park", n=1000)
    check("gate stays QUIET on pure noise", pv0 > 0.05, f"rho={obs0:+.3f} p={pv0:.4f}")

    inverted = synth_gate_frame(220, effect=+0.60, seed=13)
    obsi, pvi = GA.placebo(inverted, "gex_rank", "fwd_park", n=1000)
    check("gate flags an INVERTED sign", obsi > 0 and pvi < 0.01,
          f"rho={obsi:+.3f} p={pvi:.4f}")

    # False-positive rate on repeated nulls must sit near the nominal 5%.
    hits = 0
    for s in range(60):
        f = synth_gate_frame(220, 0.0, seed=100 + s)
        _, p = GA.placebo(f, "gex_rank", "fwd_park", n=400)
        hits += p < 0.05
    check("null false-positive rate near nominal", hits <= 8, f"{hits}/60 fired at p<0.05")


# ───────────────────── layer D: the Python <-> Pine contract ─────────────────────
def pine_parse(text: str) -> list[list[str]]:
    """Byte-for-byte mirror of the parser inside GEX_Map.pine.

    The generator and the indicator are two programs in two languages that agree
    only by convention. This re-implements the Pine side exactly, so a field
    added on one side and not the other fails here instead of silently drawing
    a wall at the wrong price.
    """
    clean = text.replace(" ", "").replace("\n", ";")
    out = []
    for rw in clean.split(";"):
        if len(rw) >= 8:
            f = rw.split(",")
            if len(f) >= 7:
                out.append(f)
    return out


def test_pine_contract() -> None:
    from pathlib import Path
    import re
    print("\nLAYER D — Python <-> Pine contract")

    pine = Path(__file__).resolve().parent / "GEX_Map.pine"
    src = pine.read_text()
    check("GEX_Map.pine exists", pine.exists())

    m = re.search(r'input\.text_area\(\s*\n?\s*"([^"]+)"', src)
    check("default row found in the indicator", m is not None)
    if not m:
        return
    rows = pine_parse(m.group(1))
    # One row per session, and the default accumulates as sessions go by -- this
    # asserted len == 1 and started failing the moment a second day existed. What
    # actually matters is that EVERY row parses and that they are distinct
    # sessions, so a stale duplicate cannot shadow today's levels.
    check("default row(s) survive the Pine parser", len(rows) >= 1, f"{len(rows)} row(s)")
    dates = [r[0] for r in rows]
    check("every default row is a distinct session", len(set(dates)) == len(dates),
          f"{len(dates)} rows, {len(set(dates))} unique")
    f = rows[0]

    # The Pine reads 6 scalars then STRIDE (strike,gex) pairs. That arithmetic must
    # agree with N_LEVELS on the Python side, or the outermost levels are silently
    # dropped or read as garbage.
    stride = int(re.search(r'^STRIDE\s*=\s*(\d+)', src, re.M).group(1))
    check("Pine STRIDE equals 2x N_LEVELS in gex.py", stride == 2 * G.N_LEVELS,
          f"STRIDE={stride}, N_LEVELS={G.N_LEVELS}")
    # 6 scalars + callWall + putWall, then STRIDE (strike,gex) pairs
    want = 8 + 2 * stride
    check(f"default row carries all {want} fields", len(f) == want, f"{len(f)} fields")

    lvl_start = int(re.search(r'ik = (\d+) \+ 2 \* j', src).group(1))
    check("Pine reads levels from the index the generator writes them to",
          lvl_start == 8, f"pine starts at {lvl_start}, generator writes from 8")

    try:
        d = int(f[0])
        nums = [float(x) for x in f[1:] if x != "na"]
        ok = 20000101 <= d <= 21001231 and all(np.isfinite(nums))
    except Exception:  # noqa: BLE001
        ok = False
    check("date parses as YYYYMMDD, rest as floats or 'na'", ok, f"date={f[0]}")

    # A Saturday key matches no session, so the indicator draws nothing and reports
    # no error. This is the check for the bug that produced exactly that.
    wd = pd.Timestamp(f[0]).weekday()
    check("stamped session is a weekday", wd < 5, f"{f[0]} weekday={wd}")

    # levels are emitted rank-ordered, so |gamma| must be non-increasing: index j is
    # GEX j+1 on the chart, and a break here means the labels name the wrong strikes
    gs = [abs(float(f[9 + 2 * j])) for j in range(stride) if f[9 + 2 * j] != "na"]
    mono = all(gs[i] >= gs[i + 1] - 1e-9 for i in range(len(gs) - 1))
    check("levels are ranked by |gamma| descending (GEX 1 is the largest)", mono,
          f"GEX1 {gs[0]:.3f} .. GEX{len(gs)} {gs[-1]:.3f}" if gs else "none")

    # both sides of spot must be represented, or the map is one-sided
    ks = [float(f[8 + 2 * j]) for j in range(stride) if f[8 + 2 * j] != "na"]
    cw, pw = f[6], f[7]
    if cw != "na" and pw != "na":
        check("call wall sits above the put wall", float(cw) > float(pw), f"{cw} vs {pw}")
    check("levels straddle spot (both sides present)",
          len(ks) > 2 and max(ks) > float(cw or 0) - 1e9, f"{len(ks)} levels")

    check("header documents the field order",
          "date,flip,netGEX,width,charm,vanna,callWall,putWall" in src)


# ───────────────── layer E: the trade geometry the indicator computes ─────────────────
def best_setup(levels: dict, price: float, netgex: float, block_w: float, atr: float,
               stop_blocks: float = 1.0, stop_atr: float = 1.0, min_rr: float = 2.0,
               adr: float | None = None, entry_reach: float = 0.5,
               target_reach: float = 0.75):
    """Byte-for-byte mirror of the candidate scan inside GEX_Map.pine.

    The Pine cannot be unit tested, so the logic is restated here and the planted
    cases below pin down every branch. If the two ever drift, these tests are what
    notices.
    """
    stop = max(block_w * stop_blocks, atr * stop_atr)
    ks = sorted(levels)
    out = {"long": None, "short": None, "stop_dist": stop}
    for k in ks:
        g = levels[k]
        if g <= 0:                                   # gate: entry must be PINS
            continue
        if adr is not None and abs(k - price) > adr * entry_reach:   # entry reachable
            continue
        up = min([x for x in ks if x > k], default=None)
        dn = max([x for x in ks if x < k], default=None)
        if k < price and up is not None:
            if adr is None or up - k <= adr * target_reach:
                rr = (up - k) / stop
                if out["long"] is None or rr > out["long"]["rr"]:
                    out["long"] = {"entry": k, "target": up, "stop": k - stop, "rr": rr, "g": g}
        if k > price and dn is not None:
            if adr is None or k - dn <= adr * target_reach:
                rr = (k - dn) / stop
                if out["short"] is None or rr > out["short"]["rr"]:
                    out["short"] = {"entry": k, "target": dn, "stop": k + stop, "rr": rr, "g": g}
    out["ok_long"] = out["long"] is not None and out["long"]["rr"] >= min_rr and netgex > 0
    out["ok_short"] = out["short"] is not None and out["short"]["rr"] >= min_rr and netgex > 0
    return out


def test_trade_logic() -> None:
    print("\nLAYER E — trade geometry (stops, targets, gates)")
    L = {29000.0: 0.30, 29200.0: 0.20, 29500.0: 0.40, 29800.0: 0.25, 30000.0: 0.35}
    px, adr, W, atr = 29350.0, 600.0, 10.0, 20.0

    r = best_setup(L, px, +3.0, W, atr, adr=adr)
    check("stop is the ATR floor when it exceeds the block", abs(r["stop_dist"] - 20.0) < 1e-9,
          f"{r['stop_dist']}")
    check("LONG stop sits BELOW the entry (invalidation, not the next level)",
          r["long"]["stop"] < r["long"]["entry"] and
          abs(r["long"]["entry"] - r["long"]["stop"] - 20.0) < 1e-9,
          f"entry {r['long']['entry']} stop {r['long']['stop']}")
    check("SHORT stop sits ABOVE the entry",
          r["short"]["stop"] > r["short"]["entry"] and
          abs(r["short"]["stop"] - r["short"]["entry"] - 20.0) < 1e-9,
          f"entry {r['short']['entry']} stop {r['short']['stop']}")
    check("LONG entry is below price, target above entry",
          r["long"]["entry"] < px < 1e18 and r["long"]["target"] > r["long"]["entry"])
    check("SHORT entry is above price, target below entry",
          r["short"]["entry"] > px and r["short"]["target"] < r["short"]["entry"])

    # a negative-gamma level must never be chosen, no matter how good its geometry
    L2 = dict(L); L2[29340.0] = -0.90
    r2 = best_setup(L2, px, +3.0, W, atr, adr=adr)
    check("ACCELERATES level is never selected", r2["long"]["entry"] != 29340.0,
          f"picked {r2['long']['entry']}")

    # short-gamma book disqualifies fading entirely
    r3 = best_setup(L, px, -3.0, W, atr, adr=adr)
    check("short-gamma book blocks both sides", not r3["ok_long"] and not r3["ok_short"])

    # unreachable entry must be dropped, or R:R ranking degenerates to "furthest level"
    L4 = dict(L); L4[20000.0] = 9.99
    r4 = best_setup(L4, px, +3.0, W, atr, adr=adr)
    check("unreachable entry excluded despite huge gamma", r4["long"]["entry"] != 20000.0,
          f"picked {r4['long']['entry']}")
    r4b = best_setup(L4, px, +3.0, W, atr, adr=None)
    check("without the reach gate that same level WINS (proves the gate matters)",
          r4b["long"]["entry"] == 20000.0, f"picked {r4b['long']['entry']}")

    # R:R must fall as the stop widens -- the sign of a real geometry, not a knob
    rr_tight = best_setup(L, px, +3.0, W, 5.0, adr=adr)["long"]["rr"]
    rr_wide = best_setup(L, px, +3.0, W, 80.0, adr=adr)["long"]["rr"]
    check("R:R is monotonically decreasing in stop distance", rr_tight > rr_wide,
          f"{rr_tight:.2f} (5pt atr) vs {rr_wide:.2f} (80pt atr)")

    # the winner must actually be the best-R:R qualifying candidate
    cands = [(k, (min([x for x in sorted(L) if x > k], default=1e18) - k) / 20.0)
             for k in sorted(L) if k < px and L[k] > 0]
    cands = [c for c in cands if c[1] < 1e17]
    check("selected LONG is the highest-R:R candidate",
          abs(r["long"]["rr"] - max(c[1] for c in cands)) < 1e-9,
          f"picked rr {r['long']['rr']:.2f}, best available {max(c[1] for c in cands):.2f}")

    # one-sided book must not fabricate the missing side
    r5 = best_setup({29000.0: 0.3, 29100.0: 0.2}, px, +3.0, W, atr, adr=adr)
    check("no short invented when every level is below price", r5["short"] is None)

    # minRR is a real gate
    r6 = best_setup(L, px, +3.0, W, atr, min_rr=99.0, adr=adr)
    check("minRR gate blocks an otherwise valid setup", not r6["ok_long"])


if __name__ == "__main__":
    print("GEXLAB SELFTEST")
    test_pricer()
    test_profile()
    test_gate()
    test_pine_contract()
    test_trade_logic()
    n_fail = sum(1 for _, s, _ in results if s == FAIL)
    print(f"\n{len(results) - n_fail}/{len(results)} passed")
    if n_fail:
        print("MACHINERY IS NOT SOUND — do not spend API budget until this is green.")
    sys.exit(1 if n_fail else 0)

