"""M2' -- intraday microstructure features for the liquidity-reversion core.

Consumes causal bars from ``ope.tick_data.trades_to_bars`` and produces, per RTH
session and strictly point-in-time, the anchors and order-flow state the reversion
signal (M3') will threshold:

    session_vwap   anchored (session-open) volume-weighted average price
    vwap_sigma     volume-weighted dispersion of price about session_vwap
    stretch        (close - session_vwap) / vwap_sigma  -- the 'how far' trigger
    cvd_session    cumulative volume delta within the session (signed flow)
    ofi            rolling order-flow imbalance in [-1, 1]
    buy_ratio      rolling aggressive-buy share in [0, 1]
    absorption_z   rolling z-score of volume-per-unit-range (high = absorption)
    divergence     price position minus CVD position over a window (exhaustion)
    rv             rolling intraday realized vol of bar log-returns (state)

Every cumulative resets at each session start and every rolling window is computed
*within* a session, so nothing leaks across the overnight gap. All features at bar t
use only bars <= t.
"""
from __future__ import annotations

from typing import TYPE_CHECKING

import numpy as np
import pandas as pd

from ope.config import FeatureConfig
from ope.logging_utils import get_logger

if TYPE_CHECKING:
    from ope.config import Config

_LOG = get_logger("features")

FEATURE_COLUMNS = (
    "session_vwap", "vwap_sigma", "stretch", "cvd_session",
    "ofi", "buy_ratio", "absorption_z", "divergence", "rv",
)
_EPS = 1e-12


def _minmax_pos(x: pd.Series, window: int) -> pd.Series:
    """Position of ``x`` within its trailing [min, max] window, in [0, 1] (0.5 if flat)."""
    lo = x.rolling(window, min_periods=1).min()
    hi = x.rolling(window, min_periods=1).max()
    rng = hi - lo
    return ((x - lo) / rng.where(rng > 0)).fillna(0.5)


def _session_features(b: pd.DataFrame, fcfg: FeatureConfig) -> pd.DataFrame:
    """Compute all features for one session's contiguous, time-sorted bars."""
    close = b["close"].astype(float)
    vol = b["volume"].astype(float)

    # Anchored, volume-weighted mean & dispersion (running, causal).
    cum_v = vol.cumsum()
    safe_v = cum_v.where(cum_v > 0)
    wmean = (vol * close).cumsum() / safe_v
    wvar = (vol * close**2).cumsum() / safe_v - wmean**2
    sigma = np.sqrt(wvar.clip(lower=0))
    stretch = (close - wmean) / sigma.where(sigma > 0)
    if fcfg.vwap_band_min_bars > 0:
        stretch.iloc[: fcfg.vwap_band_min_bars] = np.nan

    cvd_session = b["cvd_delta"].astype(float).cumsum()

    roll_cvd = b["cvd_delta"].rolling(fcfg.ofi_window, min_periods=1).sum()
    roll_vol = vol.rolling(fcfg.ofi_window, min_periods=1).sum()
    ofi = roll_cvd / roll_vol.where(roll_vol > 0)

    buy = b["buy_vol"].rolling(fcfg.flow_window, min_periods=1).sum()
    sell = b["sell_vol"].rolling(fcfg.flow_window, min_periods=1).sum()
    denom = buy + sell
    buy_ratio = buy / denom.where(denom > 0)

    rng = (b["high"] - b["low"]).abs().astype(float)
    absorption = vol / (rng + _EPS)
    a_mean = absorption.rolling(fcfg.absorption_window, min_periods=2).mean()
    a_std = absorption.rolling(fcfg.absorption_window, min_periods=2).std(ddof=0)
    absorption_z = (absorption - a_mean) / a_std.where(a_std > 0)

    divergence = (
        _minmax_pos(close, fcfg.divergence_window)
        - _minmax_pos(cvd_session, fcfg.divergence_window)
    )

    logret = np.log(close).diff()
    rv = logret.rolling(fcfg.realized_vol_window, min_periods=2).std(ddof=0)

    return pd.DataFrame(
        {
            "session_vwap": wmean,
            "vwap_sigma": sigma,
            "stretch": stretch,
            "cvd_session": cvd_session,
            "ofi": ofi,
            "buy_ratio": buy_ratio,
            "absorption_z": absorption_z,
            "divergence": divergence,
            "rv": rv,
        },
        index=b.index,
    )


def build_features(bars: pd.DataFrame, config: "Config | None" = None) -> pd.DataFrame:
    """Build the causal microstructure feature panel from M1+ bars.

    ``bars`` is the output of ``tick_data.trades_to_bars`` (needs ``close``, ``high``,
    ``low``, ``volume``, ``buy_vol``, ``sell_vol``, ``cvd_delta``, ``session_date``,
    ``in_rth``). Features are computed per session and concatenated in time order.
    """
    fcfg = config.features if config is not None else FeatureConfig()
    empty = pd.DataFrame(columns=list(FEATURE_COLUMNS))
    if bars.empty:
        return empty
    work = bars[bars["in_rth"]] if fcfg.rth_only else bars
    if work.empty:
        return empty

    parts = [_session_features(b, fcfg) for _, b in work.groupby("session_date", sort=False)]
    feats = pd.concat(parts)
    feats.index.name = bars.index.name
    _LOG.info("built %d feature rows across %d sessions",
              len(feats), work["session_date"].nunique())
    return feats[list(FEATURE_COLUMNS)]

