def trade(TE_side, side, rth, day, topq=0.05, rr=3.0, buf=2.0, pv=5.0, comm=1.50, flat=959):
    E=TE_side.copy(); E['rk']=E.p.rank(pct=True)
    E=E[E.rk>=1-topq]
    dr = -1 if side=='hi' else 1
    out=[]
    grp={d:v for d,v in rth.groupby('day')}
    for d,g in E.groupby('day'):
        if d not in grp: continue
        b=grp[d]; H=b['high'].values; L=b['low'].values; C=b['close'].values; T=b['tod'].values; n=len(b)
        A=day.at[d,'ADR']
        taken=False
        for _,e in g.sort_values('k').iterrows():
            if taken: break
            k=int(e.k)
            if k+2>=n or T[k]>=flat: continue
            ent=C[k]
            runext = H[:k+1].max() if side=='hi' else L[:k+1].min()
            stp = runext + (buf if side=='hi' else -buf)
            risk=abs(ent-stp)
            if risk<TICK: continue
            tgt=ent+dr*rr*risk
            for j in range(k+1,n):
                last=T[j]>=flat or j==n-1
                hs=(H[j]>=stp) if side=='hi' else (L[j]<=stp)
                ht=(L[j]<=tgt) if side=='hi' else (H[j]>=tgt)
                if hs: px=stp+dr*(-TICK); why='stop'
                elif ht: px=tgt; why='tgt'
                elif last: px=C[j]; why='time'
                else: continue
                pnl=dr*(px-ent)*pv-comm
                out.append(dict(day=d,side=side,pnl=pnl,R=pnl/(risk*pv),why=why,risk=risk,
                                is_ext=int(e.is_ext))); taken=True; break
    return pd.DataFrame(out)

