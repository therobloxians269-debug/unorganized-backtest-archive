`program-tearsheet` grades a sleeve-returns panel (parquet at $DATA_DIR/sleeve_returns.parquet,
columns = sleeve names, index = dates) through the full analytics battery. The panel itself is
proprietary and not distributed; evaluators point DATA_DIR at their own copy, or run the test
suite which exercises the battery on a synthetic fixture.
"""
from __future__ import annotations

import sys
from pathlib import Path

import pandas as pd

from . import analytics as A
from .config import Settings
from .portfolio import CAPITAL_WEIGHTS, combine


def render_tearsheet(argv: list[str] | None = None) -> int:
    cfg = Settings.load()
    panel = cfg.data_dir / "sleeve_returns.parquet"
    if not panel.exists():
        print(f"No sleeve-returns panel at {panel}. This redacted copy ships without proprietary "
              f"data; set DATA_DIR or run `pytest` to exercise the analytics on the fixture.",
              file=sys.stderr)
        return 2

    R = pd.read_parquet(panel)
