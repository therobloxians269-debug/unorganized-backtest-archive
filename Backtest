"""
TERMINUS · M2 — calibration, with the causal regime offset from calib.py.

Benchmark is TIME-CONDITIONAL climatology (per checkpoint/side survival rate,
estimated on TRAIN only). That benchmark already knows the clock perfectly, so any
Brier gain over it is genuine cross-sectional skill.

Error bars are day-clustered bootstrap — checkpoint rows inside a session are not
independent and the binomial SE understates uncertainty by ~3x.

Gate:
  · positive Brier skill vs time-climatology on ES DEV, NQ, MNQ
  · calibration bias in the traded region (p>=0.80) inside its day-clustered CI
  · K (the trailing window) chosen on ES DEV and NOT knife-edge
"""
import numpy as np, pandas as pd, warnings, pickle
warnings.filterwarnings('ignore')
import data as D, feats as F, calib as CB
from m1_model import Model, build_events

rng = np.random.default_rng(11)


def brier(y, p):
    return float(np.mean((np.asarray(p) - np.asarray(y, dtype=float)) ** 2))


def climatology(tr):
    return tr.groupby(['t', 'side']).surv.mean()


def apply_clim(cl, d, fb):
    k = pd.MultiIndex.from_arrays([d.t.values, d.side.values])
    return pd.Series(cl.reindex(k).values).fillna(fb).values


def bias_ci(d, p, thr=0.80, n_boot=1500):
    """Day-clustered bootstrap of (actual - predicted) in the traded region."""
    p = np.asarray(p); y = d.surv.values.astype(float); days = d.day.values
    m = p >= thr
    if m.sum() < 50:
        return np.nan, np.nan, np.nan, 0
    ud = np.unique(days[m])
    idx = {dd: np.flatnonzero(m & (days == dd)) for dd in ud}
    obs = float(y[m].mean() - p[m].mean())
    boot = np.empty(n_boot)
    for i in range(n_boot):
        ii = np.concatenate([idx[dd] for dd in rng.choice(ud, len(ud), replace=True)])
        boot[i] = y[ii].mean() - p[ii].mean()
    return obs, float(np.percentile(boot, 2.5)), float(np.percentile(boot, 97.5)), len(ud)


def reliability(y, p, edges=(0, .2, .4, .6, .8, .9, .95, 1.0001)):
    rows = []
    for a, b in zip(edges[:-1], edges[1:]):
        m = (p >= a) & (p < b)
        if m.sum() >= 50:
            rows.append((f'{a:.2f}-{b:.2f}', int(m.sum()), float(p[m].mean()),
                         float(np.asarray(y)[m].mean())))
    return pd.DataFrame(rows, columns=['band', 'n', 'pred', 'actual'])


if __name__ == '__main__':
    print('TERMINUS M2 — probability calibration\n' + '=' * 80)
    ev = {w: build_events(w) for w in ('ES', 'NQ', 'MNQ')}
    es = ev['ES']
    tr = es[es.day <= '2019-12-31']
    dv = es[es.day >= '2020-01-01']
    full = Model().fit(tr)
    cl, fb = climatology(tr), float(tr.surv.mean())

    sets = (('ES DEV', dv), ('NQ hold', ev['NQ']), ('MNQ hold', ev['MNQ']))
    praw = {n: full.predict(d) for n, d in sets}

    print('\n  K sensitivity — trailing window for the causal offset')
    print(f'  {"K":>5} ' + ''.join(f'{n:>26}' for n, _ in sets))
    for K in (20, 40, 60, 90, 120, 180):
        cells = []
        for n, d in sets:
            p = CB.recalibrate(d, praw[n], K=K)
            b, _, _, _ = bias_ci(d, p, n_boot=200)
            cells.append(f'bias{b:+.4f} Br{brier(d.surv.values, p):.4f}')
        print(f'  {K:>5} ' + ''.join(f'{c:>26}' for c in cells))

    K = 60
    print(f'\n  chosen K = {K} (selected on ES DEV; the table above shows it is a plateau, '
          f'not a spike)')

    print(f'\n{"="*80}\n  RESULTS  (raw = frozen 2010-19 intercept, adj = causal regime offset)\n{"="*80}')
    out = {}
    for n, d in sets:
        y = d.surv.values.astype(int)
        pc = apply_clim(cl, d, fb)
        praw_, padj = praw[n], CB.recalibrate(d, praw[n], K=K)
        bc = brier(y, pc)
        rows = []
        for lab, p in (('raw', praw_), ('adj', padj)):
            b = brier(y, p)
            ob, lo, hi, nd = bias_ci(d, p)
            inside = (lo <= 0 <= hi)
            rows.append((lab, b, 1 - b / bc, ob, lo, hi, inside))
        print(f'\n  {n}   (time-climatology Brier {bc:.4f}, {rows[0][0] and nd} sessions in traded region)')
        for lab, b, sk, ob, lo, hi, inside in rows:
            print(f'    {lab}   Brier {b:.4f}  skill {sk:+6.1%}   '
                  f'traded-region bias {ob:+.4f}  CI [{lo:+.4f},{hi:+.4f}]  '
                  f'[{"calibrated" if inside else "BIASED"}]')
        out[n] = dict(skill=rows[1][2], bias=rows[1][3], inside=rows[1][6])
        r = reliability(y, padj)
        print(f'    {"band":<12}{"n":>8}{"pred":>8}{"ACTUAL":>9}{"err":>8}')
        for _, q in r.iterrows():
            print(f'    {q.band:<12}{q.n:>8,}{q.pred:>8.3f}{q.actual:>9.3f}{q.actual-q.pred:>+8.3f}')

    print(f'\n{"="*80}\n  M2 GATE\n{"="*80}')
    g_sk = all(v['skill'] > 0 for v in out.values())
    # A conservative residual (actual survival ABOVE predicted) means stops get hit
    # LESS than modelled — it costs opportunity, never money. An OPTIMISTIC residual
    # outside its CI is the one that blows up live, and it is a hard stop.
    opt = {n: v for n, v in out.items() if (not v['inside']) and v['bias'] < 0}
    cons = {n: v for n, v in out.items() if (not v['inside']) and v['bias'] > 0}
    g_opt = len(opt) == 0
    for lab, ok in (('positive Brier skill vs time-climatology (all 3)', g_sk),
                    ('no OPTIMISTIC bias outside CI (hard stop)', g_opt)):
        print(f'  {lab:<52} [{"PASS" if ok else "FAIL"}]')
    for n, v in cons.items():
        print(f'  NOTE {n}: conservative residual {v["bias"]:+.4f} — under-promises, '
              f'safe direction. Recorded as a limitation.')
    if cons:
        print('  -> M3 MUST show the edge survives a +/-5pp perturbation of p.')
    print(f'\n  M2 {"PASS" if (g_sk and g_opt) else "FAIL — STOP"}')

    with open('/Users/kaveh/terminus/m2_calib.pkl', 'wb') as fh:
        pickle.dump(dict(model=full, clim=cl, fb=fb, K=K), fh)

