#!/usr/bin/env python3
"""Adapter: pull daily OHLCV from yfinance into the harness price contract.

Emits one TICKER.csv per name with columns: date,open,high,low,close,adj_close
(RAW OHLC + adj_close so the split/ex-div guard can fire), plus SPY.csv as the
market proxy. Logs success/failure per ticker for the survivorship report.
"""
import sys, time, warnings, json
import pandas as pd, numpy as np
import yfinance as yf
warnings.filterwarnings("ignore")

OUT = "prices_dir"
import os; os.makedirs(OUT, exist_ok=True)

ev = pd.read_csv("events_sp500.csv")
tickers = sorted(ev["ticker"].str.upper().unique().tolist())
need = tickers + ["SPY"]
print(f"Need {len(need)} symbols ({len(tickers)} event tickers + SPY)", flush=True)

START, END = "2014-09-01", "2026-06-23"

def write_one(sym, df):
    """df: single-ticker frame with columns Open/High/Low/Close/Adj Close."""
    if df is None or len(df) == 0:
        return 0
    df = df.dropna(how="all")
    cols = {c.lower(): c for c in df.columns}
    # handle both 'Adj Close' and 'adj close'
    def col(name):
        for c in df.columns:
            if str(c).lower().replace(" ", "") == name:
                return c
        return None
    o, h, l, c, ac = (col("open"), col("high"), col("low"),
                      col("close"), col("adjclose"))
    if o is None or c is None:
        return 0
    out = pd.DataFrame({
        "date": pd.to_datetime(df.index).normalize(),
        "open": df[o].to_numpy().ravel(),
        "high": (df[h] if h else df[o]).to_numpy().ravel(),
        "low":  (df[l] if l else df[o]).to_numpy().ravel(),
        "close": df[c].to_numpy().ravel(),
    })
    if ac is not None:
        out["adj_close"] = df[ac].to_numpy().ravel()
    out = out.dropna(subset=["open", "close"])
    out = out[(out["open"] > 0) & (out["close"] > 0)]
    if len(out) == 0:
        return 0
    out.to_csv(f"{OUT}/{sym}.csv", index=False)
    return len(out)

ok, empty, err = [], [], {}
# market first
try:
    spy = yf.download("SPY", start=START, end=END, auto_adjust=False,
                      progress=False, threads=False)
    n = write_one("SPY", spy)
    # also place a top-level SPY.csv for --market
    if os.path.exists(f"{OUT}/SPY.csv"):
        import shutil; shutil.copy(f"{OUT}/SPY.csv", "SPY.csv")
    print(f"SPY rows={n}", flush=True)
except Exception as e:
    print("SPY ERR", e, flush=True)

# batch the rest
BATCH = 40
for i in range(0, len(tickers), BATCH):
    chunk = tickers[i:i+BATCH]
    try:
        raw = yf.download(chunk, start=START, end=END, auto_adjust=False,
                          progress=False, threads=True, group_by="ticker")
    except Exception as e:
        for s in chunk: err[s] = str(e)[:60]
        print(f"batch {i//BATCH} ERR {str(e)[:60]}", flush=True)
        continue
    for s in chunk:
        try:
            if isinstance(raw.columns, pd.MultiIndex):
                if s not in raw.columns.get_level_values(0):
                    empty.append(s); continue
                sub = raw[s]
            else:
                sub = raw  # single returned
            n = write_one(s, sub)
            if n > 0: ok.append((s, n))
            else: empty.append(s)
        except Exception as e:
            err[s] = str(e)[:60]; empty.append(s)
    print(f"...progress {min(i+BATCH,len(tickers))}/{len(tickers)}  ok={len(ok)} empty={len(empty)} err={len(err)}", flush=True)
    time.sleep(1.0)

# write a manifest for the survivorship report
manifest = {"ok": ok, "empty": empty, "err": err}
with open("pull_manifest.json", "w") as f:
    json.dump(manifest, f)
print(f"\nDONE: ok={len(ok)}  empty/missing={len(empty)}  err={len(err)}", flush=True)
print("missing sample:", empty[:30], flush=True)

