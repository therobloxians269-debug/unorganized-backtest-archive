SPLIT = '2022-06-01'          # IS < 2022-06 <= OOS  (split by session date)
RTH_LO, RTH_HI = 570, 960     # 09:30 .. 16:00 ET (min_of_day); RTH rows are 570..959

raw = pd.read_parquet(PARQ)   # tz-aware ET DatetimeIndex + min_of_day/rth/session cols

# ----------------------------------------------------------------------------------
def market_frames(prefix, bin_size):
    """Return (df5, va_by_session, prior) for a market ('es' or 'ym').
       df5      : 5-min RTH OHLCV, tz ET index (fed to M.evaluate).
       va_by_session[date] = dict(POC,VAH,VAL,H) built from that session's 1m RTH.
       prior[date] = immediately preceding VA-available session date (causal ref)."""
    cols = {f'{prefix}_open':'open', f'{prefix}_high':'high', f'{prefix}_low':'low',
            f'{prefix}_close':'close', f'{prefix}_volume':'volume'}
    one = raw.rename(columns=cols)[['open','high','low','close','volume','rth','session']].copy()
    one = one[one['volume'] > 0]                      # drop dead minutes
    r1 = one[one['rth']]                              # 1m RTH only

    # ---- prior-session value area from 1m RTH (hlc3 x volume, standard 70% VA algo) ----
    def value_area(g):
        tp  = (g['high'] + g['low'] + g['close']) / 3.0
        b   = np.round(tp / bin_size) * bin_size
        vol = g['volume'].groupby(b).sum().sort_index()
        prices = vol.index.to_numpy(); v = vol.to_numpy(); total = v.sum()
        if total <= 0 or len(v) < 3: return None
        poc = int(np.argmax(v)); lo = hi = poc; acc = v[poc]; tgt = 0.70 * total
        while acc < tgt and (lo > 0 or hi < len(v) - 1):        # two-bin expansion
            up = v[hi+1] if hi < len(v)-1 else -1.0
            dn = v[lo-1] if lo > 0 else -1.0
            if up >= dn: hi += 1; acc += v[hi]
            else:        lo -= 1; acc += v[lo]
        VAH, VAL, POC = float(prices[hi]), float(prices[lo]), float(prices[poc])
        if VAH <= VAL: return None
        return dict(POC=POC, VAH=VAH, VAL=VAL, H=VAH - VAL)

    va = {}
    for day, g in r1.groupby('session'):
        res = value_area(g)
        if res: va[day] = res
    days  = sorted(va.keys())
    prior = {days[i]: days[i-1] for i in range(1, len(days))}

    # ---- 5-min RTH execution frame (label-left buckets: 09:30..15:55) ----
    df5 = (r1[['open','high','low','close','volume']]
           .resample('5min', label='left', closed='left')
           .agg({'open':'first','high':'max','low':'min','close':'last','volume':'sum'})
           .dropna(subset=['open']))
    return df5, va, prior

# ----------------------------------------------------------------------------------
def build_trades(df5, va, prior, use_A, use_B, params):
    """Walk each RTH session bar-by-bar, single-position book, return M.evaluate trades."""
    o = df5['open'].to_numpy(); h = df5['high'].to_numpy()
    l = df5['low'].to_numpy();  c = df5['close'].to_numpy()
    sess_date = pd.Series(df5.index.normalize().date, index=df5.index)
    stopbuf = params['stopbuf']          # price buffer beyond extreme (points)
    brk_frac = params['brk_frac']        # decisive-breakout buffer as frac of VA height

    sess = {}
    for gi, d in enumerate(sess_date.values):
        sess.setdefault(d, []).append(gi)

    trades = []
    for day, idxs in sess.items():
        pday = prior.get(day)
        if pday is None: continue
        v = va[pday]; VAH, VAL, POC, VH = v['VAH'], v['VAL'], v['POC'], v['H']
        if VH <= 0: continue
        bbuf = brk_frac * VH
        n = len(idxs)
        up_brk = dn_brk = False; brk_p = -1
        fvg_up = fvg_dn = None          # (top, bottom, form_p)
        flat_until = 0                  # local pos from which a new signal may be taken

        for p in range(n):
            g = idxs[p]
            # ---- maintain breakout / FVG state (causal, uses bars <= p) ----
            if use_B:
                if not up_brk and not dn_brk:
                    if   c[g] > VAH + bbuf: up_brk = True; brk_p = p
                    elif c[g] < VAL - bbuf: dn_brk = True; brk_p = p
                if up_brk and fvg_up is None and p >= 2 and p >= brk_p:
                    g2 = idxs[p-2]
                    if l[g] > h[g2]:                       # bullish FVG: low[p] > high[p-2]
                        fvg_up = (l[g], h[g2], p)          # (top, bottom, form_p)
                if dn_brk and fvg_dn is None and p >= 2 and p >= brk_p:
                    g2 = idxs[p-2]
                    if h[g] < l[g2]:                       # bearish FVG: high[p] < low[p-2]
                        fvg_dn = (l[g2], h[g], p)          # (top, bottom, form_p)

            if p < flat_until:
                continue

            sig = None                                     # (dir, stop, tgt, kind)
            # ---- Setup A: rejection reversal back into value ----
            if use_A:
                if h[g] > VAH and c[g] <= VAH:             # poked above, closed back in
                    stop = h[g] + stopbuf
                    if stop > POC: sig = (-1, stop, POC, 'A')
                elif l[g] < VAL and c[g] >= VAL:           # poked below, closed back in
                    stop = l[g] - stopbuf
                    if stop < POC: sig = (+1, stop, POC, 'A')
            # ---- Setup B: FVG retest continuation (only if A didn't fire this bar) ----
            if sig is None and use_B:
                if fvg_up is not None and p > fvg_up[2] and l[g] <= fvg_up[0]:
                    top, bot, _ = fvg_up
                    sig = (+1, bot - stopbuf, VAH + VH, 'B'); fvg_up = None
                elif fvg_dn is not None and p > fvg_dn[2] and h[g] >= fvg_dn[1]:
                    top, bot, _ = fvg_dn
                    sig = (-1, top + stopbuf, VAL - VH, 'B'); fvg_dn = None

            if sig is None:
                continue
            d, stop, tgt, kind = sig
            ep = p + 1                                      # enter NEXT bar open
            if ep >= n: continue
            entry = idxs[ep]
            exit_p = n - 1                                  # default: force exit 16:00
            for q in range(ep, n):
                gg = idxs[q]
                if d == +1:
                    if l[gg] <= stop or h[gg] >= tgt: exit_p = q; break   # stop-first if both
                else:
                    if h[gg] >= stop or l[gg] <= tgt: exit_p = q; break
            trades.append((entry, idxs[exit_p], d))
            flat_until = exit_p + 1
    return trades

# ----------------------------------------------------------------------------------
def report(df5, trades, name):
    r = M.evaluate(df5, trades, split=SPLIT, name=name)
    if r.get('trades', 0) == 0:
        print(f"{name:22} NO TRADES"); return None
    yrs = max((df5.index[-1] - df5.index[0]).days / 365.25, 0.25)
    tpy = r['trades'] / yrs
    IS, OOS = r.get('IS'), r.get('OOS')
    is_t  = IS['t']  if IS  else float('nan')
    oos_t = OOS['t'] if OOS else float('nan')
    oos_n = OOS['n'] if OOS else 0
    clears = (tpy >= 80) and (r['exp'] > 0) and (OOS is not None and oos_t >= 1.5)
    verdict = ('ALIVE' if clears else
               'MARGINAL' if (r['exp'] > 0 and (OOS and oos_t >= 1.0)) else 'DEAD')
    print(f"{name:22} N={r['trades']:<5} tpy={tpy:5.1f} win={r['win']*100:4.1f}% "
          f"exp=${r['exp']:+6.2f} OOSt={oos_t:+5.2f}(n={oos_n}) ISt={is_t:+5.2f} "
          f"DD=${r['maxDD']:6.0f} skew={r['skew']:+5.2f} ann=${r['ann']:+6.0f}"
          f"({r['ann_pct']:+5.1f}%/$1k)  -> {verdict}")
    r['_tpy'] = round(tpy, 1); r['_verdict'] = verdict; r['_clears'] = clears
    r['_oos_t'] = oos_t; r['_is_t'] = is_t
    return r

# ----------------------------------------------------------------------------------
if __name__ == '__main__':
    PAR = dict(es=dict(bin=1.0, stopbuf=0.5, brk_frac=0.10),
               ym=dict(bin=5.0, stopbuf=4.0, brk_frac=0.10))
    out = {}
    for mkt in ('es', 'ym'):
        p = PAR[mkt]
        df5, va, prior = market_frames(mkt, p['bin'])
        pr = dict(stopbuf=p['stopbuf'], brk_frac=p['brk_frac'])
        span = f"{df5.index[0].date()}..{df5.index[-1].date()}  bars={len(df5)}"
        print(f"\n===== {mkt.upper()}  ({span})  VA-sessions={len(va)}  bin={p['bin']} =====")
        tA  = build_trades(df5, va, prior, True,  False, pr)
        tB  = build_trades(df5, va, prior, False, True,  pr)
        tAB = build_trades(df5, va, prior, True,  True,  pr)
        rA  = report(df5, tA,  f'{mkt} A-reject')
        rB  = report(df5, tB,  f'{mkt} B-fvg')
        rAB = report(df5, tAB, f'{mkt} A+B combo')
        out[mkt] = dict(A=rA, B=rB, AB=rAB)

    print("\n----- CLEAR TEST (tpy>=80 AND exp>0 AND OOS t>=1.5) -----")
    any_clear = False
    for mkt in ('es', 'ym'):
        for k, lab in (('A', f'{mkt} A'), ('B', f'{mkt} B'), ('AB', f'{mkt} A+B')):
            r = out[mkt][k]
            if r and r.get('_clears'):
                any_clear = True
                print(f"  CLEARS: {lab}")
    print("  none cleared." if not any_clear else "")
    # machine-readable dump for the write-up
    dump = {}
    for mkt in ('es', 'ym'):
        for k in ('A', 'B', 'AB'):
            r = out[mkt][k]
            if not r: continue
            dump[f'{mkt}_{k}'] = {kk: r.get(kk) for kk in
                ('trades','_tpy','win','exp','_oos_t','_is_t','maxDD','skew',
                 'ann','ann_pct','_verdict','_clears')}
    print("JSON:" + json.dumps(dump))

