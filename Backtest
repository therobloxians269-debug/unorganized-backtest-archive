#!/usr/bin/env python3
"""verify_chain.py -- recompute the SHA-256 hash chain and prove the ledger wasn't tampered.
Hand this (and its output) to a DDQ. Exit 0 = intact, 1 = tampered."""
import csv, os, hashlib, sys

HERE = os.path.dirname(os.path.abspath(__file__))
LEDGER = os.path.join(HERE, "ledger.csv")
PAYLOAD_KEYS = ["date","paper_equity","shadow_prog_equity","shadow_prog_ret","C1","C2","M","T"]

def main():
    if not os.path.exists(LEDGER):
        print("no ledger yet"); return 0
    rows = list(csv.DictReader(open(LEDGER)))
    prev = "GENESIS"
    for i, r in enumerate(rows):
        payload = "|".join(str(r.get(k, "")) for k in PAYLOAD_KEYS) + "|" + prev
        h = hashlib.sha256(payload.encode()).hexdigest()
        if h != r["row_hash"]:
            print(f"TAMPERED at row {i} ({r['date']}): recomputed {h[:16]} != stored {r['row_hash'][:16]}")
            return 1
        if r["prev_hash"] != prev:
            print(f"BROKEN LINK at row {i} ({r['date']}): prev_hash mismatch")
            return 1
        prev = r["row_hash"]
    print(f"CHAIN INTACT — {len(rows)} marks, {rows[0]['date']}..{rows[-1]['date']}, head {prev[:16]}")
    return 0

if __name__ == "__main__":
    sys.exit(main())

