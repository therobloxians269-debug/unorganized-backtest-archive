#!/usr/bin/env python3
"""OCEAN family f04_gap_engine — overnight gap dynamics on ES RTH 5-min (1 MES, $5/pt).

PRE-REGISTERED CONFIG (defaults below): gap-AND-GO continuation, LARGE gaps.
  gap g = today's 09:30 open - yesterday's RTH close; gn = |g| / (prev_hi - prev_lo).
  Trade only if 0.60 <= gn (large bucket, open-ended). Watch first 6 five-min bars
  (09:30-10:00). Stand aside if the gap already filled (price touched prev_close in
  bars 0..5). At the 10:00 bar close (bar 5), if close is beyond the 09:30 open in
  the gap direction, enter 1 MES WITH the gap at that close (market fill).
  Stop = entry -/+ max(1.5 * ATR14_5m[entry bar], 2.0 pts), checked intrabar only on
  bars strictly after the entry bar. No target; exit at 16:00 close if stop not hit.
  Friction: stop/eod 0.66 pt RT, target 0.41 (unused here). One trade max per day.

Gap-FILL fade branch (limit target at prev_close) was tested in the same sweep and is
DEAD on DEV (11/12 cells net-negative). Sweep table (DEV only) printed below so the
referee sees every config tried: 24 grid cells + 2 probes = 26 configs total.
"""
import sys, json, argparse, datetime, os
sys.path.insert(0, "/Users/kaveh/mes_mim")
import numpy as np, pandas as pd
import omni2_lib as L
from omni2_lib import fric, DPP

DEV_END = datetime.date(2022, 12, 31)
BUCKETS = {"S": (0.15, 0.30), "M": (0.30, 0.60), "L": (0.60, 99.0)}
STOP_FLOOR = 2.0
# ---- pre-registered defaults ----
REG = dict(branch="go", bucket="L", w=6, k=1.5)

def is_roll_week(d):
    """quarterly front-month roll splice lands mid Mar/Jun/Sep/Dec"""
    return d.month in (3, 6, 9, 12) and 8 <= d.day <= 15

def sim_day(s, branch, blo, bhi, w, k):
    """One session. Entry at bar close, stop intrabar on bars strictly after entry,
    EOD at bar-77 close. Conservative: stop counted first if stop+target share a bar."""
    pc, ph, pl = s["prev_close"], s["prev_hi"], s["prev_lo"]
    if pc is None:
        return None
    r = ph - pl
    if r <= 0:
        return None
    o0 = s["o"][0]
    g = o0 - pc
    if g == 0:
        return None
    gn = abs(g) / r
    if not (blo <= gn < bhi):
        return None
    sgn = 1 if g > 0 else -1
    h, l, c, atr = s["h"], s["l"], s["c"], s["atr"]
    e = w - 1
    filled_early = (l[:w].min() <= pc) if sgn > 0 else (h[:w].max() >= pc)
    if filled_early:
        return None
    if branch == "fade":
        side = -sgn
        if sgn > 0 and not (c[e] < o0 and c[e] > pc):
            return None
        if sgn < 0 and not (c[e] > o0 and c[e] < pc):
            return None
        if abs(c[e] - pc) < 1.0:      # remaining gap must be worth the friction
            return None
        tgt = pc                       # resting limit at prev_close
    else:                              # "go" continuation
        side = sgn
        if sgn > 0 and not (c[e] > o0):
            return None
        if sgn < 0 and not (c[e] < o0):
            return None
        tgt = None
    entry = c[e]
    sd = max(k * atr[e], STOP_FLOOR)
    stop = entry - side * sd
    for b in range(e + 1, 78):
        stop_hit = (l[b] <= stop) if side > 0 else (h[b] >= stop)
        tgt_hit = tgt is not None and ((h[b] >= tgt) if side > 0 else (l[b] <= tgt))
        if stop_hit:
            return (s["date"], side * (stop - entry) - fric("stop"), sd, "stop")
        if tgt_hit:
            return (s["date"], side * (tgt - entry) - fric("target"), sd, "target")
        if b == 77:
            return (s["date"], side * (c[77] - entry) - fric("eod"), sd, "eod")
    return None

def run(S, branch, bucket, w, k, excl_roll=False):
    blo, bhi = BUCKETS[bucket]
    rows = [t for s in S if not (excl_roll and is_roll_week(s["date"]))
            for t in [sim_day(s, branch, blo, bhi, w, k)] if t]
    return pd.DataFrame(rows, columns=["date", "net", "risk", "kind"])

def stats(tr):
    if len(tr) == 0:
        return dict(n=0, net=0.0, mar=0.0, hit=0.0, dd=0.0, ypos=0.0, mys=float("nan"),
                    exp=0.0, yearly={}, top3m=float("nan"))
    usd = tr["net"].to_numpy() * DPP
    eq = np.cumsum(usd)
    dd = float((eq - np.maximum.accumulate(eq)).min())
    net = float(usd.sum())
    mar = net / abs(dd) if dd < 0 else 9999.0
    dts = pd.to_datetime(tr["date"].astype(str))
    yearly = tr.assign(u=usd).groupby(dts.dt.year)["u"].sum()
    mon = tr.assign(u=usd).groupby(dts.dt.to_period("M"))["u"].sum()
    top3m = float(mon.sort_values(ascending=False).head(3).sum() / net) if net > 0 else float("nan")
    mys = float(yearly.max() / net) if net > 0 else float("nan")
    return dict(n=len(tr), net=net, mar=float(mar), hit=float((usd > 0).mean()), dd=dd,
                ypos=float((yearly > 0).mean()), mys=mys, exp=float(tr["net"].mean()),
                yearly={int(a): round(float(b), 2) for a, b in yearly.items()}, top3m=top3m)

def sweep(S):
    print("\nDEV SWEEP — every config tried (24 grid cells + 2 probes = 26)")
    print(f"{'#':>2} {'branch':6} {'bkt':3} {'w':>2} {'k':>4} | {'n':>4} {'net$':>8} {'MAR':>6} "
