"""Decisive realism stress: entry-cancel LATENCY. In the zero-latency backtest we cancel a
resting entry the instant the signal weakens, dodging adverse fills no real trader could
dodge. Here a triggered cancel only lands `cancel_latency_ns` later, and the order stays
fillable in between -- so we eat the adverse fills that arrive during the reaction window.

For each latency we run the full month and report: trades, total net at the default cost,
and the ROUND-TRIP commission break-even (= average per-trade gross-after-taker-slip, the
commission at which net crosses zero). Retail internet round-trip to CME is ~5-50 ms;
colocated is <1 ms.

    PYTHONPATH=. python3 -m research.ofmm.latency
"""
from __future__ import annotations

import numpy as np

from research.ofmm.tape import load_day, day_files, TICK, POINT
from research.ofmm.backtest import Params, run_day

DOLLAR_TICK = TICK * POINT
ANN = 252
MS = 1_000_000


def run_all(cancel_latency_ns):
    p = Params(comm_side=0.0, taker_slip_ticks=0.0, cancel_latency_ns=cancel_latency_ns)
    day_net, all_tr = [], []
    for f in day_files():
        trades, _, _, _ = run_day(load_day(f), p)
        all_tr.extend(trades)
        day_net.append(sum(t["gross_ticks"] * DOLLAR_TICK for t in trades))  # gross, no cost
    return all_tr, np.array(day_net)


def evaluate(trades, comm_side, slip):
    g = np.array([t["gross_ticks"] - (slip if t["taker"] else 0.0) for t in trades])
    return g * DOLLAR_TICK - 2.0 * comm_side          # per-trade net $


def main():
    CS, SL = 0.35, 0.5
    print(f"{'latency':>9} {'trades':>7} {'net@$0.70RT':>12} {'RT break-even':>14} "
          f"{'net@$1.24RT':>12} {'dailySharpe':>12}")
    for L_ms in (0, 1, 5, 10, 20, 50):
        trades, _ = run_all(L_ms * MS)
        n = len(trades)
        per = evaluate(trades, CS, SL)                # net per trade at default cost
        # per-day nets at default cost for Sharpe
        # (recompute grouping by day via ts date is overkill; use gross-after-slip/day proxy)
        net_def = per.sum()
        gross_after_slip = np.array([t["gross_ticks"] - (SL if t["taker"] else 0.0)
                                     for t in trades]) * DOLLAR_TICK
        be_rt = gross_after_slip.mean() if n else float("nan")     # RT commission break-even
        net_124 = (gross_after_slip - 1.24).sum()
        # daily Sharpe at default cost
        import collections
        byday = collections.defaultdict(float)
        for t, pn in zip(trades, per):
            byday[t["ts_in"] // (86_400 * 1_000_000_000)] += pn
        dn = np.array(list(byday.values()))
        shp = dn.mean() / dn.std(ddof=1) * np.sqrt(ANN) if len(dn) > 1 and dn.std() > 0 else float("nan")
        print(f"{L_ms:>6}ms {n:>7} {net_def:>12.0f} {be_rt:>13.3f}$ {net_124:>12.0f} {shp:>12.2f}")


if __name__ == "__main__":
    main()

