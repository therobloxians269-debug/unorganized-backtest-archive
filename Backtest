    show(r, f"k={k} real")

    # placebo 1: displaced breaker zones (same count/width/timing, fake price)
    for sh in [30.0, 60.0]:
        rp = run.backtest(st, gate="breaker", k=k, mode=engine.MODE_FULL, tf=5,
                          shift=sh)
        s = engine.stats(rp[7], rp[6], 2.0, f"k={k} DISPLACED {sh:.0f}pt")
        print(engine.fmt(s))

    # placebo 2: random entries matched on count and session
    L, S = run.signals(st, "breaker")
    nsig = int(L.sum() + S.sum())
    sess = st["sess"]
    pool = np.where(st["m"]["filt"])[0]
