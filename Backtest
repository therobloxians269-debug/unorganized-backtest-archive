        if isinstance(df.columns, pd.MultiIndex):
            df.columns = df.columns.get_level_values(0)
 
        # ==========================================
        # 5. ALPHA VARIANT INDICATOR SUITE
        # ==========================================
        df['EMA_200'] = df['Close'].ewm(span=200, adjust=False).mean()
        df['VWAP']    = (df['Close'] * df['Volume']).rolling(50).sum() \
                        / df['Volume'].rolling(50).sum()
        df['STD']     = df['Close'].rolling(50).std()
 
        # ATR
        tr = pd.concat([
            (df['High'] - df['Low']),
            abs(df['High'] - df['Close'].shift()),
            abs(df['Low']  - df['Close'].shift())
        ], axis=1).max(axis=1)
        df['ATR'] = tr.rolling(14).mean()
 
        # ADX (directional strength filter)
        plus_dm  = df['High'].diff().clip(lower=0)
        minus_dm = df['Low'].diff().clip(upper=0).abs()
        df['ADX'] = (
            100
            * (abs(plus_dm.rolling(14).mean() - minus_dm.rolling(14).mean())
               / df['ATR'].replace(0, 1e-9))
        ).rolling(14).mean()
 
        # Snapshot latest bar
        row      = df.iloc[-1]
        cp       = float(row['Close'])
        atr      = float(row['ATR'])
        vwap     = float(row['VWAP'])
        std      = float(row['STD'])
        ema_200  = float(row['EMA_200'])
        adx      = float(row['ADX'])
 
        if any(pd.isna(v) for v in [cp, atr, vwap, std, ema_200, adx]):
            print("Indicators warming up...")
            time.sleep(10)
            continue
 
        z_score = (cp - vwap) / std
 
        # Dynamic z-score threshold based on market regime
        z_target  = 2.2 if adx < 15 else 2.8
 
        # Dynamic contract sizing  (double up on extreme z-score)
        base_qty  = int(starting_balance // 1000) + 1
        alpha_qty = base_qty * 2 if abs(z_score) > 3.0 else base_qty
 
        open_pnl = 0.0
 
        # ==========================================
        # 6. EXIT LOGIC (Trailing Stop + Mean Reversion + Hold Limit)
        # ==========================================
        if current_pos != 0:
            hold_time += 1
            pnl_pts = (cp - entry_price) if current_pos == 1 else (entry_price - cp)
            open_pnl = pnl_pts * contract_multiplier * current_contracts
 
            exit_sig = False
 
            if current_pos == 1:
                highest_seen = max(highest_seen, cp)
                # Trail: price fell 3×ATR from swing high, OR mean fully recovered
                exit_sig = (cp < (highest_seen - (3.0 * atr))) or (z_score > 0.5)
            else:
                lowest_seen = min(lowest_seen, cp)
                # Trail: price rose 3×ATR from swing low, OR mean fully recovered
                exit_sig = (cp > (lowest_seen + (3.0 * atr))) or (z_score < -0.5)
 
            # Max hold-time guard: 48 hourly bars (~2 trading days)
            if exit_sig or hold_time > 48:
                realized_pnl = open_pnl - (current_contracts * COMMISSION_PER_LOT)
                starting_balance += realized_pnl
 
                print(f"\n❌ [{datetime.now().strftime('%H:%M:%S')}] EXIT @ {cp:.2f}")
                print(f"   Hold bars : {hold_time}")
                print(f"   Realized  : ${realized_pnl:,.2f}  |  Balance: ${starting_balance:,.2f}\n")
 
                log_to_file("EXIT", cp, realized_pnl, starting_balance)
 
                current_pos = 0
                current_contracts = 0
                hold_time = 0
                open_pnl  = 0.0
 
        # ==========================================
        # 7. ENTRY LOGIC (ADX mean-reversion filter)
        # ==========================================
        if current_pos == 0 and adx < 25:          # only trade choppy/ranging markets
            long_signal  = (cp > ema_200) and (z_score < -z_target)
            short_signal = (cp < ema_200) and (z_score >  z_target)
 
            if long_signal:
                # Slight upward slippage on entry
                entry_price       = cp * 1.0001
                current_pos       = 1
                current_contracts = alpha_qty
                highest_seen      = cp
                hold_time         = 0
 
                print(f"\n🚀 [{datetime.now().strftime('%H:%M:%S')}] BUY  @ {entry_price:.2f} | Qty: {alpha_qty} | Z: {z_score:.2f} | ADX: {adx:.1f}")
                log_to_file("BUY_ENTRY", entry_price, 0.00, starting_balance)
 
            elif short_signal:
                # Slight downward slippage on entry
                entry_price       = cp * 0.9999
                current_pos       = -1
                current_contracts = alpha_qty
                lowest_seen       = cp
                hold_time         = 0
 
                print(f"\n📉 [{datetime.now().strftime('%H:%M:%S')}] SELL @ {entry_price:.2f} | Qty: {alpha_qty} | Z: {z_score:.2f} | ADX: {adx:.1f}")
                log_to_file("SELL_ENTRY", entry_price, 0.00, starting_balance)
 
        # ==========================================
        # 8. LIVE DASHBOARD
        # ==========================================
        pnl_icon = "🟩" if open_pnl > 0 else "🟥" if open_pnl < 0 else "⚪"
        regime   = "RANGE" if adx < 25 else "TREND"
 
        print(
            f"⏱️  [{datetime.now().strftime('%H:%M:%S')}] "
            f"| Price: {cp:<9.2f}"
            f"| Z: {z_score:>+6.2f}"
            f"| ADX: {adx:>5.1f} ({regime})"
            f"| Pos: {current_pos:>2}"
            f"| Bars: {hold_time:>3}"
            f"| Entry: {entry_price:<9.2f}"
            f"| Open PnL: {pnl_icon} ${open_pnl:,.2f}"
        )
 
        time.sleep(60)
 
    except Exception as e:
        print(f"[ERROR] {datetime.now().strftime('%H:%M:%S')} → {e}")
        time.sleep(15)
 

