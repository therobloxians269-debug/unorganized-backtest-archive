from __future__ import annotations
import numpy as np
import pandas as pd
import yfinance as yf
from lib_perf import perf_stats, psr, deflated_sharpe, per_year, maxdd, line

COINS = ["BTC-USD","ETH-USD","BNB-USD","XRP-USD","ADA-USD","SOL-USD","DOGE-USD","DOT-USD",
         "AVAX-USD","LINK-USD","LTC-USD","BCH-USD","ATOM-USD","XLM-USD","ETC-USD","TRX-USD",
         "UNI-USD","FIL-USD","ALGO-USD","VET-USD","HBAR-USD","NEAR-USD","AAVE-USD","MKR-USD",
         "EOS-USD","XTZ-USD","THETA-USD","AXS-USD","SAND-USD","MANA-USD"]
ANN = 365
COST_BP = 25.0
OOS = "2023-01-01"


def vol_target(w, rets, win, tgt, cap=3.0):
    g = (w * rets).sum(axis=1)
    scale = (tgt / (g.rolling(win).std() * np.sqrt(ANN))).shift(1).clip(0, cap).fillna(0.0)
    return w.mul(scale, axis=0)


def weekly(w):
    """Hold weights constant within ISO week -> ~5x fewer rebalances."""
    return w.resample("W").last().reindex(w.index, method="ffill")


def net_of(w, rets, cost_bp=COST_BP):
    turn = w.diff().abs().sum(axis=1)
    net = ((w * rets).sum(axis=1) - turn * cost_bp * 1e-4).dropna()
    return net, turn.mean() * ANN


def summarize(name, net, turn):
    s = perf_stats(net, ANN)
    oos = perf_stats(net[net.index >= OOS], ANN)["sharpe"]
    print(f"  {name:22s} Sh {s['sharpe']:4.2f} | CAGR {s['cagr']*100:5.1f}% | vol {s['vol']*100:3.0f}% "
          f"| maxDD {s['maxdd']*100:5.1f}% | turn {turn:4.0f}x | OOS23 Sh {oos:4.2f}")
    return net


def main():
    px = yf.download(COINS, start="2017-01-01", auto_adjust=True, progress=False)["Close"]
    px = px.dropna(how="all").dropna(axis=1, thresh=int(len(px) * 0.20))
    rets = px.pct_change()
    print(f"universe: {px.shape[1]} coins, {px.index[0].date()} -> {px.index[-1].date()}\n")

    # ---- v1 baseline (fast daily TS) ----
    av30 = (rets.rolling(30).std() * np.sqrt(ANN)).shift(1)
    z1 = sum(px.pct_change(L) / (av30 * np.sqrt(L / ANN)) for L in (30, 60, 120)) / 3
    w1 = np.tanh(z1).clip(lower=0.0).div(av30)
    w1 = w1.div(w1.abs().sum(axis=1).replace(0, np.nan), axis=0).shift(1).fillna(0.0)
    w1 = vol_target(w1, rets, 30, 0.35)
    n1, t1 = net_of(w1, rets)

    # ---- Fix 1: SLOW TS + WEEKLY ----
    av60 = (rets.rolling(60).std() * np.sqrt(ANN)).shift(1)
    z2 = sum(px.pct_change(L) / (av60 * np.sqrt(L / ANN)) for L in (60, 120, 240)) / 3
    w2 = np.tanh(z2).clip(lower=0.0).div(av60)
    w2 = w2.div(w2.abs().sum(axis=1).replace(0, np.nan), axis=0).shift(1).fillna(0.0)
    w2 = weekly(w2)
    w2 = vol_target(w2, rets, 60, 0.35)
    n2, t2 = net_of(w2, rets)

    # ---- Fix 2: XS momentum sleeve (long top-third by 90d, weekly) ----
    mom = px.pct_change(90).shift(1)
    rank = mom.rank(axis=1, ascending=False)
    k = max(3, px.shape[1] // 3)
    wx = (rank <= k).astype(float).div(av60)                 # inverse-vol within winners
    wx = wx.div(wx.abs().sum(axis=1).replace(0, np.nan), axis=0).shift(1).fillna(0.0)
    wx = weekly(wx)
    wx = vol_target(wx, rets, 60, 0.35)
    nx, tx = net_of(wx, rets)

    print("SLEEVES (long/flat, vol-targeted 35%):")
    summarize("v1 fast-daily TS", n1, t1)
    summarize("slow-weekly TS", n2, t2)
    summarize("XS-momentum", nx, tx)

    # correlation of sleeve returns (the diversification test)
    j = pd.concat([n2.rename("TS"), nx.rename("XS")], axis=1).dropna()
    rho = j["TS"].corr(j["XS"])
    print(f"\n  corr(slow-TS, XS) = {rho:+.2f}  (lower = more diversification benefit)")

    # ---- Combine: risk-parity 50/50 of unit-vol sleeves ----
    u_ts = n2 / (n2.std() * np.sqrt(ANN))
    u_xs = nx / (nx.std() * np.sqrt(ANN))
    combo = ((u_ts + u_xs) / 2).dropna()
    print("\nCOMBINED (50/50 risk-parity, unit-vol base):")
    summarize("TS+XS combo", combo, (t2 + tx) / 2)

    # ---- Walk-forward by year (combo) ----
    print("\n  per-year NET (slow-TS / XS / combo):")
    py = pd.concat([per_year(n2), per_year(nx), per_year(combo)], axis=1,
                   keys=["TS", "XS", "combo"])
    for y, row in py.iterrows():
        print(f"    {y}   TS {row['TS']*100:+7.1f}%  XS {row['XS']*100:+7.1f}%  combo {row['combo']*100:+7.1f}%")

    # ---- decay verdict: rolling 1y Sharpe ----
