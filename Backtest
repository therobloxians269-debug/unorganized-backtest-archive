#!/usr/bin/env python3
"""
rebalance_extended.py
================================================================================
Stage-2 harness for the 60/40 rebalancing front-run, built on top of the
falsification gate in rebalance_pretest.py.

The primary spec ALREADY FAILED the gate (Sharpe -0.45, disguised beta). Per the
pre-registered rule we do NOT re-tune the primary to pass. This module instead:

  1. CLOSES A GATE HOLE: the original hard-fail only checked beta to EQUITIES.
     The strategy carries a large, unchecked LONG-DURATION (rate) bet
     (beta to ZN = +0.39). We add a bond-beta hard-fail.

  2. Tests two PRE-SPECIFIED mechanism-faithful sharpenings as secondary
     hypotheses (NOT post-hoc knobs):
        - flow-magnitude weighting  : size in proportion to |drift| (bigger
          overweight => bigger mandated rebalance flow => bigger trade).
        - quarter-end amplification : restrict to quarter-end months, where
          rebalancing flows concentrate (more funds rebalance quarterly).

  3. Runs the DECISIVE test: a trailing BETA-STRIPPED overlay. If the P&L is
     just compensation for net market/duration exposure, neutralizing beta
     causally should collapse it. If something survives, there may be a real
     (small) flow alpha. This separates "edge" from "disguised beta".

  4. Runs an expanding-window WALK-FORWARD OOS battery and honestly inflates the
     Deflated-Sharpe trial count to reflect every expression tried here.

Everything is reported verbatim, including (especially) failures. Extensions are
EXPLORATORY: a survivor here is a LEAD requiring its own locked OOS confirmation,
not a green light.

Usage:
    python rebalance_extended.py --es-file ES.csv --bond-file ZN.csv
================================================================================
"""
import argparse
import numpy as np
import pandas as pd
from scipy import stats

import rebalance_pretest as R   # reuse loaders, panel, metrics

# Total honest expression count across BOTH scripts (gate primary+2 secondary,
# plus the 5 extensions below) -> conservative DSR haircut.
HONEST_TRIALS = 10
BETA_LOOKBACK = 504            # ~2y trailing window for the causal beta hedge
GATE_BETA_ES = 0.15
GATE_BETA_ZN = 0.20            # rate-exposure tolerance (bond leg is vol-scaled, so looser)


# ----------------------------------------------------------------------------
# Extended strategy builder
# ----------------------------------------------------------------------------
def strategy_ext(df, cost_ticks, variant, weighting="sign", qend_only=False,
                 mag_clip=3.0):
    """Generalizes R.strategy_returns.
      weighting : 'sign'  -> equity leg in {-1,0,+1}
                  'mag'   -> equity leg = -sign(drift)*min(|z(drift)|, mag_clip)
                             (z = drift standardized by its own trailing 252d sd)
      qend_only : trade only in months that END a calendar quarter (Mar/Jun/Sep/Dec)
    """
    s = R.risk_scale(df).fillna(0.0)
    w_es = pd.Series(0.0, index=df.index)
    w_zn = pd.Series(0.0, index=df.index)

    drift_l = df["drift"].shift(1)
    sgn = np.sign(drift_l).fillna(0.0)

    if weighting == "mag":
        sd = drift_l.rolling(252).std()
        z = (drift_l / sd).clip(-mag_clip, mag_clip).fillna(0.0)
        size = -z                      # short when overweight, scaled by magnitude
    else:
        size = -sgn

    qmask = np.ones(len(df), dtype=bool)
    if qend_only:
        qmask = df.index.month.isin([3, 6, 9, 12])

    if variant in ("frontrun", "combined"):
        mask = df["in_frontrun"].values & qmask
        w_es = w_es.where(~mask, size)
        w_zn = w_zn.where(~mask, -size * s)   # long bond when short equity
    if variant in ("reversal", "combined"):
        sgn_rev = np.sign(df["prev_month_drift"]).fillna(0.0)
        mask_r = df["in_reversal"].values & qmask
        w_es = w_es.where(~mask_r, sgn_rev)
        w_zn = w_zn.where(~mask_r, -sgn_rev * s)

    gross = w_es.shift(1) * df["r_es"] + w_zn.shift(1) * df["r_zn"]
    c_es = cost_ticks * R.ES_TICK_PTS / df["es"]
    c_zn = cost_ticks * R.ZN_TICK_PTS / df["zn"]
    cost = (w_es - w_es.shift(1)).abs() * c_es + (w_zn - w_zn.shift(1)).abs() * c_zn
    net = (gross - cost).fillna(0.0)
    active = (w_es != 0) | (w_zn != 0)
    return net, gross.fillna(0.0), active


def beta_strip(net, mkt, bond, lookback=BETA_LOOKBACK):
    """Causal (trailing) double beta-neutralization: remove the component of the
    strategy explained by trailing ES AND ZN exposure. Hedge ratios estimated on
    [t-lookback, t-1] only -> no look-ahead. Returns the residual ('alpha') series.
    """
    X = pd.DataFrame({"es": mkt, "zn": bond}).fillna(0.0)
    y = net.fillna(0.0)
    resid = pd.Series(np.nan, index=net.index)
    xv = X.values
    yv = y.values
    for i in range(lookback, len(net)):
        Xp = xv[i - lookback:i]
        yp = yv[i - lookback:i]
        A = np.column_stack([np.ones(lookback), Xp])
        b, *_ = np.linalg.lstsq(A, yp, rcond=None)   # [alpha, b_es, b_zn]
        resid.iloc[i] = yv[i] - (b[1] * xv[i, 0] + b[2] * xv[i, 1])
    return resid


def gate_ext(net, active, mkt, bond, label):
    """Gate with BOTH equity- and bond-beta hard-fails."""
    b_es, t_es = R.market_beta(net, mkt)
    b_zn, t_zn = R.market_beta(net, bond)
    act = net[active].dropna()
    sk = stats.skew(act) if len(act) > 2 else np.nan
    sr = R.ann_sharpe(net)
    fails = []
    if not np.isnan(b_es) and abs(b_es) >= GATE_BETA_ES:
        fails.append(f"|beta_ES|={abs(b_es):.3f}>={GATE_BETA_ES}")
    if not np.isnan(b_zn) and abs(b_zn) >= GATE_BETA_ZN:
        fails.append(f"|beta_ZN|={abs(b_zn):.3f}>={GATE_BETA_ZN} (disguised rate bet)")
    if not np.isnan(sk) and sk < 0:
        fails.append(f"skew={sk:.2f}<0")
    status = "FAIL" if fails else ("GREEN" if sr >= 1.0 else "MARGINAL" if sr >= 0.5 else "KILL")
    return {"label": label, "sharpe": sr, "beta_es": b_es, "beta_zn": b_zn,
            "skew": sk, "status": status, "fails": ";".join(fails) if fails else "-"}


def walkforward(df, builder_kwargs, n_folds=5, cost=1.0):
    """Expanding-window OOS. The base expression fits no parameters (vol-scale is
    already causal), so this is a temporal-stability check: train window is only
    used to confirm the rule, OOS Sharpe is reported per fold."""
    idx = df.index
    bounds = np.linspace(int(len(idx) * 0.4), len(idx), n_folds + 1).astype(int)
    out = []
    for k in range(n_folds):
        lo, hi = bounds[k], bounds[k + 1]
        sl = df.iloc[:hi]
        net, _, _ = strategy_ext(sl, cost, "frontrun", **builder_kwargs)
        oos = net.iloc[lo:hi]
        out.append((f"{idx[lo].date()}..{idx[hi-1].date()}", R.ann_sharpe(oos), len(oos)))
    return out


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--es-file", required=True)
    ap.add_argument("--bond-file", required=True)
    ap.add_argument("--window", type=int, default=5)
    ap.add_argument("--reversal", type=int, default=3)
    ap.add_argument("--cost-ticks", type=float, default=1.0)
    args = ap.parse_args()

    es = R.load_file(args.es_file)
    zn = R.load_file(args.bond_file)
    df = R.build_panel(es, zn)
    df = R.add_drift_and_windows(df, args.window, args.reversal)
    mkt, bond = df["r_es"], df["r_zn"]
    c = args.cost_ticks

    print("=" * 84)
    print("STAGE-2 EXTENDED HARNESS  (gate already FAILED the primary; this is diagnostic)")
    print(f"  data: {len(df)} days {df.index.min().date()}..{df.index.max().date()}  "
          f"cost={c} tick/leg  honest_trials={HONEST_TRIALS}")
    print("=" * 84)

    # ---- 1. Variant battery through the ENHANCED (two-beta) gate ----
    specs = [
        ("base sign frontrun",        dict(weighting="sign", qend_only=False)),
        ("flow-magnitude frontrun",   dict(weighting="mag",  qend_only=False)),
        ("quarter-end sign frontrun", dict(weighting="sign", qend_only=True)),
        ("quarter-end + magnitude",   dict(weighting="mag",  qend_only=True)),
    ]
    print("\n1) VARIANT BATTERY (enhanced gate: ES-beta AND ZN-beta hard-fails)")
    hdr = f"{'spec':28s} {'Sharpe':>7} {'beta_ES':>8} {'beta_ZN':>8} {'skew':>6}  {'status':>8}  fails"
    print(hdr); print("-" * len(hdr))
    rows = []
    for name, kw in specs:
        net, _, act = strategy_ext(df, c, "frontrun", **kw)
        g = gate_ext(net, act, mkt, bond, name)
        rows.append(g)
        print(f"{name:28s} {g['sharpe']:>7.2f} {g['beta_es']:>8.3f} {g['beta_zn']:>8.3f} "
              f"{g['skew']:>6.2f}  {g['status']:>8}  {g['fails']}")
    # reversal too
    netr, _, actr = strategy_ext(df, c, "reversal", weighting="sign")
    gr = gate_ext(netr, actr, mkt, bond, "reversal (sign)")
    print(f"{'reversal (sign)':28s} {gr['sharpe']:>7.2f} {gr['beta_es']:>8.3f} {gr['beta_zn']:>8.3f} "
          f"{gr['skew']:>6.2f}  {gr['status']:>8}  {gr['fails']}")

    # ---- 2. DECISIVE: strip beta causally, is anything left? ----
    print("\n2) BETA-STRIPPED ALPHA (causal trailing ES+ZN hedge, 504d) — the decisive test")
    print(f"   {'spec':28s} {'rawSharpe':>10} {'alphaSharpe':>12} {'alpha bps/yr':>13}")
    print("   " + "-" * 66)
    for name, kw in specs:
        net, _, act = strategy_ext(df, c, "frontrun", **kw)
        resid = beta_strip(net, mkt, bond)
        rs = R.ann_sharpe(resid)
        ann = resid.dropna().mean() * R.TRADING_DAYS * 1e4
        print(f"   {name:28s} {R.ann_sharpe(net):>10.2f} {rs:>12.2f} {ann:>13.0f}")

    # ---- 3. Walk-forward OOS for the two leading expressions ----
    print("\n3) WALK-FORWARD OOS (expanding window, 5 folds)")
    for name, kw in [("base sign", dict(weighting="sign", qend_only=False)),
                     ("flow-magnitude", dict(weighting="mag", qend_only=False))]:
        wf = walkforward(df, kw, n_folds=5, cost=c)
        srs = [s for _, s, _ in wf]
        print(f"   {name:16s}: " + "  ".join(f"{R.fmt(s,2)}" for s in srs)
              + f"   (mean OOS Sharpe {np.nanmean(srs):+.2f})")

    # ---- 4. DSR with honest inflated trial count, applied to best raw variant ----
    best = max(rows + [gr], key=lambda r: (np.nan_to_num(r["sharpe"], nan=-9)))
    net_b, _, act_b = strategy_ext(df, c, "frontrun",
                                   **dict(weighting="mag" if "magnitude" in best["label"] else "sign",
                                          qend_only="quarter" in best["label"]))
    dsr, sr0 = R.deflated_sharpe(net_b, HONEST_TRIALS)
    print(f"\n4) DEFLATED SHARPE on best raw variant ('{best['label']}', Sharpe {best['sharpe']:.2f})")
    print(f"   trials={HONEST_TRIALS}  DSR={R.fmt(dsr,3)}  SR0_ann={R.fmt(sr0,2)}")

    # ---- verdict ----
    print("\n" + "=" * 84)
    print("EXTENDED VERDICT")
    print("=" * 84)
    anylive = any(r["status"] in ("GREEN", "MARGINAL") for r in rows + [gr])
    print(f"Any variant clearing the enhanced gate (>=MARGINAL, beta-clean): "
          f"{'YES' if anylive else 'NO'}")
    print("Beta-stripped alpha is the arbiter: if neutralizing ES+ZN beta leaves")
    print("Sharpe <= 0, the daily-horizon expression of this mechanism is dead and")
    print("the raw P&L was disguised market/duration exposure. A positive, stable")
    print("beta-stripped Sharpe that ALSO survives walk-forward would be a LEAD")
    print("(needs its own locked OOS), not a pass.")


if __name__ == "__main__":
    main()

