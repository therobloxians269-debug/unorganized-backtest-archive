"""
CRYPTO SHORT-HORIZON REVERSAL SLEEVE — candidate NEW uncorrelated return stream (lever: breadth of BETS).

The book is maxed on tuning (vol-target hurts, realloc/breadth/ensemble marginal). The only real
headroom is a new sleeve that is BOTH good standalone AND uncorrelated. Short-horizon (1-5d) reversal
in crypto is a well-documented liquidity-provision effect and should be ~uncorrelated (even negatively
correlated) to the 90d cross-sectional momentum sleeve — the rare case where adding it can lift a book
that's already at Sharpe 1.72.

Construction (mirrors the momentum sleeve's discipline):
  - SAME point-in-time top-30 eligibility (no survivorship leak)
  - signal = -(past Nd return): biggest recent LOSER = strongest buy
  - dollar-neutral cross-sectional: long top-quintile losers, short top-quintile winners, inv-vol per leg
  - gross exposure normalized to 1.0

Honesty guards (reversal lives or dies on COST):
  - sweep lookback (1/2/3/5d), rebalance freq (daily/2d/3d), cost (0/10/25 bps one-way)
  - report TURNOVER — if it only works at 0 cost, it's a paper edge, killed
  - OOS split 2018-2022 vs 2023-2026
  - correlation to the deployed momentum sleeve
  - net effect when added to the full program at a modest risk weight

    PYTHONPATH=/Users/kaveh/mim_research python3 reversal_sleeve.py
"""
from __future__ import annotations
import numpy as np
import pandas as pd
from lib_perf import perf_stats
from pit_backtest import PX, ANN
from momentum_ensemble import build_elig

START = pd.Timestamp("2018-01-01")


def reversal(px, elig, lookback=2, rebal=None, cost_bps=10.0, quint=5):
    rets = px.pct_change()
    av = (rets.rolling(30).std() * np.sqrt(ANN)).shift(1)
    score = (-px.pct_change(lookback)).shift(1).where(elig)        # high = recent loser = buy
    n_t = score.notna().sum(axis=1)
    k_t = np.maximum(2, (n_t // quint)).astype(float)
    rk_hi = score.rank(axis=1, ascending=False)                   # 1 = biggest loser
    rk_lo = score.rank(axis=1, ascending=True)                    # 1 = biggest winner
    longs = rk_hi.le(k_t, axis=0).astype(float)
    shorts = rk_lo.le(k_t, axis=0).astype(float)
    wl = (longs / av).replace([np.inf, -np.inf], np.nan).fillna(0.0)
    ws = (shorts / av).replace([np.inf, -np.inf], np.nan).fillna(0.0)
    wl = wl.div(wl.abs().sum(axis=1).replace(0, np.nan), axis=0).fillna(0.0)
    ws = ws.div(ws.abs().sum(axis=1).replace(0, np.nan), axis=0).fillna(0.0)
    w = 0.5 * wl - 0.5 * ws                                        # dollar-neutral, gross 1.0
    w = w.shift(1)
    if rebal:
        w = w.resample(rebal).last().reindex(px.index, method="ffill")
    w = w.fillna(0.0)
    turn = w.diff().abs().sum(axis=1)
    net = ((w * rets.fillna(0.0)).sum(axis=1) - turn * cost_bps * 1e-4).dropna()
    net = net[net.index >= START]
    return net, turn[turn.index >= START]


def stat(r):
    return perf_stats(r, ANN)


def show(tag, r, turn=None):
    s = stat(r)
    t = f" | turn {turn.mean()*ANN:5.0f}x" if turn is not None else ""
    print(f"  {tag:30} Sharpe {s['sharpe']:5.2f} | CAGR {s['cagr']*100:6.1f}% | "
          f"vol {s['vol']*100:4.0f}% | maxDD {s['maxdd']*100:6.1f}%{t}")


def main():
    px = pd.read_parquet(PX); px.index = pd.to_datetime(px.index).tz_localize(None)
    elig = build_elig(px)

    print("=" * 104)
    print("CRYPTO SHORT-HORIZON REVERSAL SLEEVE — does it survive realistic cost? (point-in-time, dollar-neutral)")
    print("=" * 104)

    print("\n[1] LOOKBACK x REBALANCE  (cost 10 bps one-way)")
    best = None
    for lb in (1, 2, 3, 5):
        for rb in (None, "2D", "3D"):
            r, t = reversal(px, elig, lookback=lb, rebal=rb, cost_bps=10.0)
            tag = f"lb {lb}d / rebal {rb or 'daily':>5}"
            show(tag, r, t)
            if best is None or stat(r)['sharpe'] > stat(best[0])['sharpe']:
                best = (r, lb, rb)
        print()
    _, blb, brb = best
    print(f"  best config @10bps: lb {blb}d / rebal {brb or 'daily'}")

    print("\n[2] COST SENSITIVITY on best config  (the kill test — reversal dies on cost)")
    for c in (0.0, 5.0, 10.0, 25.0):
        r, t = reversal(px, elig, lookback=blb, rebal=brb, cost_bps=c)
