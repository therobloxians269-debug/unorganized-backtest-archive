"""Daye's literal model:  Q1 accumulate · Q2 manipulate (Judas) · Q3 distribute.
   Enter Q3 against the Q2 sweep. Filter with 'buy below True Open, sell above'.
   True Open of the session = the Q2 open (19:30 / 01:30 / 07:30 / 13:30)."""
import pandas as pd, numpy as np, warnings; warnings.filterwarnings('ignore')
FLAT=1019
def prep(df):
    o=df.copy(); m=(o.index.hour*60+o.index.minute).values
    o['minofday']=m; m18=(m-1080+1440)%1440
    o['m18']=m18; o['sess']=m18//360; o['qs']=(m18//90)%4
    o['skey']=o['daycycle'].astype(str)+'_'+o['sess'].astype(str)
    r=o.resample('60min',label='left',closed='left').agg({'h':'max','l':'min','c':'last'}).dropna()
    tr=pd.concat([r.h-r.l,(r.h-r.c.shift()).abs(),(r.l-r.c.shift()).abs()],axis=1).max(axis=1)
    o['atr60']=tr.rolling(14).mean().shift(1).reindex(o.index,method='ffill')
    return o

def setups(b, min_sweep=0.05, need_reclaim=True):
    out=[]
    for sk,g in b.groupby('skey',sort=True):
        q={i:v for i,v in g.groupby('qs')}
        if 0 not in q or 1 not in q or 2 not in q: continue
        if len(q[0])<45 or len(q[1])<45 or len(q[2])<30: continue
        a=g.atr60.iloc[0]
        if not np.isfinite(a) or a<=0: continue
        q1h,q1l=q[0].h.max(),q[0].l.min()
        TSO=q[1].o.iloc[0]                      # True Session Open = the Q2 open
        swU=q[1].h.max()>q1h+min_sweep*a
        swD=q[1].l.min()<q1l-min_sweep*a
        if swU==swD: continue                   # exactly one side
        if need_reclaim:                        # Judas: must close back inside Q1
            if swU and q[1].c.iloc[-1]>q1h: continue
            if swD and q[1].c.iloc[-1]<q1l: continue
        d=-1 if swU else 1
        ent=q[2].index[0]
        px=q[2].o.iloc[0]
        out.append(dict(skey=sk,t=ent,i=b.index.get_loc(ent),dir=d,
                        ext=q[1].h.max() if swU else q[1].l.min(),
                        TSO=TSO,px=px,atr=a,sess=int(g.sess.iloc[0]),
                        q1h=q1h,q1l=q1l,
                        q1r=(q1h-q1l)/a,
                        q2r=(q[1].h.max()-q[1].l.min())/a))
    return pd.DataFrame(out)

def trade(b,P,rr=6.0,buf=2.0,max_hold=270,pv=20.,comm=4.,slip=0.25,
          tso_filter=0,sessions=(0,1,2,3),displace=None,seed=0,max_stop_atr=2.5,
          min_q2r=0.0,min_rr=0.0,pd_filter=0):
    o,h,l=b.o.values,b.h.values,b.l.values; m=b['minofday'].values; n=len(b)
    rng=np.random.default_rng(seed); out=[]
    for _,p in P.iterrows():
        if p.sess not in sessions: continue
        if p.q2r < min_q2r: continue
        i=int(p.i); d=int(p.dir)
        if i+2>=n or (FLAT<=m[i]<1080): continue
        ext=p.ext; tso=p.TSO
        if displace is not None:
            sh=displace*(1 if rng.random()<.5 else -1); ext+=sh; tso+=sh
        ep=o[i+1]+(slip if d==1 else -slip)
        # PD array: equilibrium of the Q1 accumulation range
        if pd_filter!=0:
            eq=(p.q1h+p.q1l)/2.0
            if pd_filter==1:      # orthodox: buy in DISCOUNT, sell in PREMIUM
                if d==1 and ep>=eq: continue
                if d==-1 and ep<=eq: continue
            elif pd_filter==-1:   # inverted
                if d==1 and ep<=eq: continue
                if d==-1 and ep>=eq: continue
        # Daye: buy BELOW the true open, sell ABOVE it
        if tso_filter==1:      # Daye: buy BELOW the true open, sell ABOVE
            if d==1 and ep>=tso: continue
            if d==-1 and ep<=tso: continue
        elif tso_filter==-1:   # inverted: buy ABOVE, sell BELOW
            if d==1 and ep<=tso: continue
            if d==-1 and ep>=tso: continue
        st=(ext-buf) if d==1 else (ext+buf)
        if (d==1 and st>=ep) or (d==-1 and st<=ep): continue
        risk=abs(ep-st)
        if risk<1.0 or risk>max_stop_atr*p.atr: continue
        tg=ep+rr*risk if d==1 else ep-rr*risk
        e=min(i+1+max_hold,n); mm=m[i+1:e]
        fl=np.where((mm>=FLAT)&(mm<1080))[0]
        e2=i+1+int(fl[0]) if len(fl) else e
        hs=h[i+1:e2]; ls=l[i+1:e2]
        if len(hs)==0: continue
        sh_=(hs>=st) if d==-1 else (ls<=st)
        th=(ls<=tg) if d==-1 else (hs>=tg)
        si=int(sh_.argmax()) if sh_.any() else 10**9
        ti=int(th.argmax()) if th.any() else 10**9
        if si==10**9 and ti==10**9: k=e2-1; px=o[k]; w='time'
        elif si<=ti: k=i+1+si; px=st+(slip if d==-1 else -slip); w='stop'
        else: k=i+1+ti; px=tg; w='tgt'
        pts=(ep-px) if d==-1 else (px-ep)
        out.append(dict(t=b.index[i+1],d=d,sess=p.sess,R=(pts*pv-comm)/(risk*pv),
                        pnl=pts*pv-comm,why=w,risk=risk))
    return pd.DataFrame(out)

