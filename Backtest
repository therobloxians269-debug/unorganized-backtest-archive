"""Stack uncorrelated sleeves to cut drawdown and lift Sharpe (the path to both Apex and
institutional). Trend (multi-timescale momentum) + Value (long-horizon reversal) on a
broadened free ETF basket; measure correlation and whether the combo beats each sleeve.

    PYTHONPATH=. python3 research/sleeves.py
"""
from __future__ import annotations

import numpy as np
import pandas as pd

from ope.validation import gauntlet_summary, perf_stats

BASKET = ["SPY", "QQQ", "IWM", "EFA", "EEM", "TLT", "IEF", "LQD", "HYG", "EMB",
          "GLD", "SLV", "DBC", "USO", "VNQ", "UUP"]
TGT, COST_BP = 0.10, 1.0
LOOKS = (63, 126, 252)        # trend timescales
VALUE_LOOK = 756              # ~3y reversal (cheap = fell over 3y -> long)


def _annvol(rets):
    return (rets.rolling(63).std() * np.sqrt(252)).shift(1)


def trend_strength(px, av):
    z = sum(px.pct_change(L) / (av * np.sqrt(L / 252.0)) for L in LOOKS) / len(LOOKS)
    return np.tanh(z)


def value_strength(px, av):
    z = px.pct_change(VALUE_LOOK) / (av * np.sqrt(VALUE_LOOK / 252.0))
    return np.tanh(-z)                       # long long-term losers


def norm_w(px, strength):
    av = _annvol(px.pct_change())
    w = strength.shift(1) / av
    return w.div(w.abs().sum(axis=1).replace(0, np.nan), axis=0)


def net_from_w(px, w, port_vt=True):
    rets = px.pct_change()
    if port_vt:
        g = (w * rets).sum(axis=1)
        scale = (TGT / (g.rolling(63).std() * np.sqrt(252))).shift(1).clip(0, 3).fillna(0.0)
        w = w.mul(scale, axis=0)
    return ((w * rets).sum(axis=1) - w.diff().abs().sum(axis=1) * COST_BP * 1e-4).dropna()


def show(name, net):
    s = perf_stats(net)
    eras = [perf_stats(net[m])["sharpe"] for m in
            (net.index.year <= 2014, (net.index.year >= 2015) & (net.index.year <= 2021), net.index.year >= 2022)]
    print(f"{name:>10} Sh={s['sharpe']:.2f} ann={s['ann_return']*100:4.1f}% "
          f"DD={s['max_drawdown']*100:6.1f}% Cal={s['ann_return']/abs(s['max_drawdown']):4.2f} "
          f"| eras {eras[0]:+.2f}/{eras[1]:+.2f}/{eras[2]:+.2f}")
    return net


def main():
    import yfinance as yf
    px = yf.download(BASKET, start="2006-01-01", auto_adjust=True, progress=False)["Close"]
    px = px.dropna(how="all").dropna(axis=1, thresh=int(len(px) * 0.4))
    print(f"basket ({len(px.columns)}): {list(px.columns)}\n{px.index[0].date()}->{px.index[-1].date()}\n")

    wt = norm_w(px, trend_strength(px, _annvol(px.pct_change())))
    wv = norm_w(px, value_strength(px, _annvol(px.pct_change())))
    nt = net_from_w(px, wt)
    nv = net_from_w(px, wv)
    ncombo = net_from_w(px, 0.5 * wt.add(0.0) + 0.5 * wv)        # 50/50 risk blend

    common = pd.concat({"trend": nt, "value": nv}, axis=1).dropna()
    corr = common["trend"].corr(common["value"])
    print(f"correlation(trend, value) = {corr:+.2f}  (low/negative = good diversifier)\n")

    show("trend", nt)
    show("value", nv)
    show("combo5050", ncombo)

    g = gauntlet_summary({"trend": nt, "value": nv, "combo": ncombo}, "combo", n_blocks=10)
    print(f"\ngauntlet (combo): PBO={g['pbo']:.3f} PSR={g['psr']:.3f} DSR={g['dsr']:.3f} "
          f"-> {'PASS' if g['passed'] else 'FAIL'}")


if __name__ == "__main__":
    main()

