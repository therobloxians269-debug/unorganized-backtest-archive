"""THE OPENING DRIVE. The extreme prints in the first minutes on a volume climax (10x
concentration, measured). So: let the opening range print it, trade away from it, stop behind it.
Entry on the retracement (the 50% mechanism). One trade a day. Params picked on ES 2010-2017."""
import numpy as np, pandas as pd, pickle, warnings; warnings.filterwarnings('ignore')
TICK=0.25
def load():
    es=pd.read_parquet('/Users/kaveh/overnight_premium_engine/data/es_front_1m.parquet')
    es=es.rename(columns=str.lower)[['open','high','low','close','volume']]
    t=es.index.hour*60+es.index.minute
    es=es[(t>=570)&(t<960)].copy(); es['tod']=t[(t>=570)&(t<960)]; es['day']=es.index.normalize()
    nq=pd.read_parquet('nq_v6.parquet').rename(columns={'o':'open','h':'high','l':'low','c':'close','v':'volume'})
    t2=nq.index.hour*60+nq.index.minute
    nq=nq[(t2>=570)&(t2<960)][['open','high','low','close','volume']].copy()
    nq['tod']=t2[(t2>=570)&(t2<960)]; nq['day']=nq.index.normalize()
    return es,nq

def run(df, ORM=15, pbk=0.5, rr=3.0, pv=5.0, comm=1.50, maxwait=90, flat=959, stopbuf=0.10):
    out=[]
    for d,b in df.groupby('day'):
        if len(b)<300: continue
        H=b['high'].values; L=b['low'].values; C=b['close'].values; T=b['tod'].values; n=len(b)
        orm=T<570+ORM
        if orm.sum()<ORM*0.8: continue
        orh=H[orm].max(); orl=L[orm].min(); orr=orh-orl
        if orr<=0: continue
        post=np.flatnonzero(~orm)
        up=[k for k in post if H[k]>=orh]; dn=[k for k in post if L[k]<=orl]
        iu=up[0] if up else 10**9; idn=dn[0] if dn else 10**9
        if min(iu,idn)==10**9 or T[min(iu,idn)]>=flat: continue
        d_=1 if iu<idn else -1                       # trade AWAY from the printed extreme
        k0=min(iu,idn)
        lim = (orh - pbk*orr) if d_==1 else (orl + pbk*orr)   # retrace into the OR
        stp = (orl - stopbuf*orr) if d_==1 else (orh + stopbuf*orr)
        risk=abs(lim-stp)
        if risk<TICK: continue
        tgt=lim+d_*rr*risk
        fill=-1
        for k in range(k0,min(k0+maxwait,n)):
            if T[k]>=flat: break
            if (L[k]<=lim) if d_==1 else (H[k]>=lim): fill=k; break
        if fill<0:
            out.append(dict(day=d,filled=0,pnl=0.0,R=np.nan,why='nofill')); continue
        for k in range(fill+1,n):
            last=T[k]>=flat or k==n-1
            hs=(L[k]<=stp) if d_==1 else (H[k]>=stp)
            ht=(H[k]>=tgt) if d_==1 else (L[k]<=tgt)
            if hs: px=stp-d_*TICK; why='stop'
            elif ht: px=tgt; why='tgt'
            elif last: px=C[k]; why='time'
            else: continue
            out.append(dict(day=d,filled=1,d=d_,pnl=d_*(px-lim)*pv-comm,
                            R=(d_*(px-lim)*pv-comm)/(risk*pv),why=why,risk=risk)); break
    return pd.DataFrame(out)

