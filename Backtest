                      f"m_stop={PREREG['m_stop']} tstop={PREREG['tstop']} both-sides", st)
    if len(tr):
        kc = tr["kind"].value_counts()
        print("exit mix: " + "  ".join(f"{k}:{v}" for k, v in kc.items()))
        for lbl, sub in (("long", tr[tr["side"] > 0]), ("short", tr[tr["side"] < 0])):
            print(f"  {lbl:5s} n={len(sub)} net=${sub['net'].sum()*DPP:,.0f} "
                  f"hit={(sub['net'] > 0).mean():.3f}")

    os.makedirs(RESULTS_DIR, exist_ok=True)
    out = os.path.join(RESULTS_DIR, f"f02_vwap_reversion_{args.window}.json")
    with open(out, "w") as f:
        json.dump(st, f, indent=2)
    print(f"\nwrote {out}")

    if args.window == "dev":
        n_years = len({str(s["date"])[:4] for s in S})
        alive, why = survival(st, n_years)
        print(f"DEV SURVIVAL BAR: {'PASS' if alive else 'FAIL (' + why + ')'}")
        sweep(S)


if __name__ == "__main__":
    main()

