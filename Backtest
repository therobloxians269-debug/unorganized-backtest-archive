"""
Can the block be made NARROWER at the same containment? The only honest lever is
better information. Build an expanded pre-open feature set and measure, OOS, the
half-width h needed to contain the extreme 27% of the time. Lower h = better.

Everything here is still known at 09:30:00. Nothing from today's RTH.
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')
RTH0, RTH1 = 570, 960


def build(d, adrlen=14):
    tod = d.index.hour * 60 + d.index.minute
    d = d.assign(tod=tod, rth=(tod >= RTH0) & (tod < RTH1), day=d.index.normalize())
    r = d[d.rth]
    g = r.groupby('day')
    day = pd.DataFrame({'o930': g['open'].first(), 'hi': g['high'].max(),
                        'lo': g['low'].min(), 'cl': g['close'].last(),
                        'n': g.size(), 'rvol': g['volume'].sum()})
    day = day[day.n >= 300]
    day['rng'] = day.hi - day.lo
    day['ADR'] = day.rng.shift(1).rolling(adrlen).mean()
    day['ADR5'] = day.rng.shift(1).rolling(5).mean()
    day['ADR40'] = day.rng.shift(1).rolling(40).mean()
    day['prevC'] = day.cl.shift(1)
    day['prevRng'] = day.rng.shift(1)
    day['prevRng2'] = day.rng.shift(2)
    day['prevHi'] = day.hi.shift(1)
    day['prevLo'] = day.lo.shift(1)
    day['prevVol'] = day.rvol.shift(1)
    day['volMA'] = day.rvol.shift(1).rolling(20).mean()
    day['c5'] = day.cl.shift(1) - day.cl.shift(6)          # 5-day trend
    day['rngStd'] = day.rng.shift(1).rolling(20).std()     # vol-of-vol

    ov = d[~d.rth].copy()
    rd = day.index
    pos = np.searchsorted(rd.values, ov.index.normalize().values, side='left')
    idx = np.where(ov.tod.values < RTH0, pos, pos + 1)
    ok = idx < len(rd)
    ov, idx = ov[ok], idx[ok]
    ov['tgt'] = rd[idx]
    og = ov.groupby('tgt')
    day['onH'] = og['high'].max()
    day['onL'] = og['low'].min()
    day['onV'] = og['volume'].sum()
    day['onVMA'] = day.onV.shift(1).rolling(20).mean()
    # overnight realised vol from 1m closes
    lr = np.log(ov.close).diff()
    day['onRV'] = lr.groupby(ov.tgt).std() * np.sqrt(lr.groupby(ov.tgt).size())
    # session sub-ranges: Asia 18:00-03:00, London 03:00-09:30
    asia = ov[(ov.tod >= 1080) | (ov.tod < 180)]
    lond = ov[(ov.tod >= 180) & (ov.tod < RTH0)]
    ag, lg = asia.groupby('tgt'), lond.groupby('tgt')
    day['asR'] = ag['high'].max() - ag['low'].min()
    day['loR'] = lg['high'].max() - lg['low'].min()
    day['loC'] = lg['close'].last()

    day = day.dropna(subset=['ADR', 'ADR5', 'ADR40', 'onH', 'prevC', 'prevRng',
                             'prevRng2', 'volMA', 'onVMA', 'onRV', 'asR', 'loR',
                             'c5', 'rngStd', 'prevHi'])
    day = day[day.ADR > 0]
    A = day.ADR
    # ── BASE: the six features currently shipped ──
    day['f_onr']  = (day.onH - day.onL) / A
    day['f_onlo'] = (day.o930 - day.onL) / A
    day['f_onhi'] = (day.onH - day.o930) / A
    day['f_gap']  = (day.o930 - day.prevC) / A
    day['f_pdr']  = day.prevRng / A
    day['f_dow']  = day.index.dayofweek / 4.0
    # ── EXTRA ──
    day['f_vts']   = day.ADR5 / day.ADR40                       # vol term structure
    day['f_vov']   = day.rngStd / A                             # vol of vol
    day['f_agap']  = (day.o930 - day.prevC).abs() / A           # gap magnitude
    day['f_pdr2']  = day.prevRng2 / A
    day['f_pcloc'] = (day.prevC - day.prevLo) / (day.prevHi - day.prevLo).replace(0, np.nan)
    day['f_onv']   = day.onV / day.onVMA
    day['f_rvol']  = day.prevVol / day.volMA
    day['f_onrv']  = day.onRV * day.o930 / A                    # ON realised vol in ADR units
    day['f_asr']   = day.asR / A
    day['f_lor']   = day.loR / A
    day['f_lodrv'] = (day.o930 - day.loC) / A                   # drive off the London close
    day['f_c5']    = day.c5 / A
    day['f_dom']   = day.index.day / 31.0

    day['y_lo'] = (day.o930 - day.lo) / A
    day['y_hi'] = (day.hi - day.o930) / A
    return day.replace([np.inf, -np.inf], np.nan).dropna(
        subset=[c for c in day.columns if c.startswith('f_')] + ['y_lo', 'y_hi'])


BASE  = ['f_onr', 'f_onlo', 'f_onhi', 'f_gap', 'f_pdr', 'f_dow']
EXTRA = ['f_vts', 'f_vov', 'f_agap', 'f_pdr2', 'f_pcloc', 'f_onv', 'f_rvol',
         'f_onrv', 'f_asr', 'f_lor', 'f_lodrv', 'f_c5', 'f_dom']


def hneed(y, c, target=0.27, lo=0.005, hi=1.0):
    """half-width needed to contain the extreme `target` of the time"""
    for _ in range(60):
        m = (lo + hi) / 2
        if ((y >= c - m) & (y <= c + m)).mean() < target:
            lo = m
        else:
            hi = m
    return (lo + hi) / 2

