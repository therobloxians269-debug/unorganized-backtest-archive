#!/usr/bin/env python3
"""
Founder Accumulation ETF Strategy — Backtest
==============================================
Buy founder-led stocks when momentum is negative (founders accumulate in weakness).
Monthly rebalance: 3rd Friday. Equal-weight top 6 by momentum inversion score.
"""

import pandas as pd
import numpy as np
import yfinance as yf
from datetime import timedelta
import warnings
warnings.filterwarnings('ignore')

FOUNDERS = ['NVDA', 'TSLA', 'META', 'AMZN', 'GOOG', 'MSFT', 'AAPL', 'NFLX', 'CRM', 'PANW']
HOLDINGS = 6
START_DATE = '2015-01-01'
END_DATE = '2026-08-11'

print("\n" + "="*80)
print(" FOUNDER ACCUMULATION ETF STRATEGY — BACKTEST")
print("="*80)

# Fetch prices
print("\n[*] Fetching historical prices for", len(FOUNDERS), "founder stocks...")
price_dfs = []
for ticker in FOUNDERS:
    try:
        df = yf.download(ticker, start=START_DATE, end=END_DATE, progress=False)
        if len(df) > 0 and 'Close' in df.columns:
            close_series = df['Close'].copy()
            close_series.name = ticker
            price_dfs.append(close_series)
    except:
        pass

print(f"[+] Loaded {len(price_dfs)} tickers\n")

if len(price_dfs) < 4:
    print("[-] Not enough data. Exiting.\n")
    exit(1)

# Merge into single DataFrame
prices = pd.concat(price_dfs, axis=1).dropna(how='all')
print(f"[+] Trading dates: {len(prices)}\n")

# Get rebalance dates (3rd Friday of each month)
def get_thirds(start_str, end_str):
    dates = []
    cur = pd.Timestamp(start_str).replace(day=1)
    end = pd.Timestamp(end_str)

    while cur <= end:
        # Find all Fridays in this month
        month_end = (cur + pd.DateOffset(months=1)).replace(day=1) - timedelta(days=1)
        fridays = pd.date_range(start=cur, end=month_end, freq='W-FRI')

        if len(fridays) >= 3:
            third = fridays[2]
            if third <= end:
                dates.append(third)

        cur = (cur + pd.DateOffset(months=1)).replace(day=1)

    return sorted(dates)

rebalance_dates = get_thirds(START_DATE, END_DATE)
# Snap to actual trading dates
rebalance_dates = [prices.index[prices.index >= d][0] for d in rebalance_dates if len(prices.index[prices.index >= d]) > 0]
rebalance_dates = sorted(set(rebalance_dates))

print(f"[+] Rebalance dates: {len(rebalance_dates)}\n")
print(f"[*] Running backtest...")

# Backtest loop
# cash and positions are the ONLY state. Portfolio value = cash + mark-to-market
# positions. The previous version re-seeded `cash = portfolio` (a constant $1,000)
# at every one of the 139 rebalances, injecting $138k of phantom capital.
cash = 1000.0
positions = {t: 0.0 for t in prices.columns}
daily_pv = []

for i, date in enumerate(prices.index):
    # Rebalance?
    if date in rebalance_dates:
        # Compute momentum scores (90d returns)
        scores = {}
        for ticker in prices.columns:
            if ticker not in prices.columns:
                continue

            hist = prices[ticker][:date]
            if len(hist) >= 90:
                # 90-day momentum
                momentum = float((hist.iloc[-1] / hist.iloc[-90]) - 1.0)
                # Volatility of 90-day returns
                vol = float(hist.pct_change().std())

                # ACCUMULATION SCORE: negative momentum (weakness) + low vol = high score
                # Proxy for founder behavior: buy in weakness, high conviction (low vol)
                score = -momentum / max(vol, 0.001)
                scores[ticker] = score

        if scores:
            # Rank top 6
            ranked = sorted(scores.items(), key=lambda x: x[1], reverse=True)[:HOLDINGS]
            new_positions = {t: 0.0 for t in prices.columns}

            # Liquidate everything to cash
            for ticker in positions:
                if positions[ticker] > 0:
                    try:
                        price = float(prices[ticker].loc[:date].iloc[-1])
                        cash += positions[ticker] * price
                    except:
                        pass

            # Deploy all cash equally across the top HOLDINGS
            cash_per = cash / HOLDINGS
            deployed = 0.0
            for ticker, score in ranked:
                try:
                    price = float(prices[ticker].loc[:date].iloc[-1])
                    if price > 0:
                        shares = cash_per / price
                        new_positions[ticker] = shares
                        deployed += shares * price
                except:
                    pass

            positions = new_positions
            cash -= deployed

    # Daily mark-to-market: cash + positions
    pv = cash
    for ticker in positions:
        if positions[ticker] > 0:
            try:
                price = float(prices[ticker].loc[:date].iloc[-1])
                pv += positions[ticker] * price
            except:
                pass

    daily_pv.append({'date': date, 'value': pv})

# Compute stats
pv_df = pd.DataFrame(daily_pv).set_index('date')
pv_array = pv_df['value'].values

returns = np.diff(pv_array) / (pv_array[:-1] + 1e-9)

annual_return = (pv_array[-1] / pv_array[0]) ** (252 / len(returns)) - 1 if len(returns) > 0 else 0
annual_vol = np.std(returns) * np.sqrt(252) if len(returns) > 0 else 0
sharpe = annual_return / (annual_vol + 1e-9)

# Max DD
cummax = np.maximum.accumulate(pv_array)
