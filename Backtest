"""EXACTLY 1.00 trades/day. Rank every candidate in the session by a candle-level score and take
the single best. No threshold -> no frequency loss. Score components are all known pre-entry."""
import numpy as np, pandas as pd, warnings; warnings.filterwarnings('ignore')
from crs import build_levels, rejections
TICK=0.25; FLAT=959
def candidates(f, pv=2.0, comm=1.50, ce=0.5, buf=2.0, maxwait=60, maxhold=240):
    df=pd.read_parquet(f); LV=build_levels(df); R=rejections(df,LV,minConf=1)
    o,h,l,c,v=df.o.values,df.h.values,df.l.values,df.c.values,df.v.values.astype(float)
    tod=(df.index.hour*60+df.index.minute).values; n=len(df)
    idx=np.arange(n)//5
    H5=pd.Series(h).groupby(idx).max().values; L5=pd.Series(l).groupby(idx).min().values
    ph=np.full(len(H5),np.nan); pl=np.full(len(H5),np.nan)
    for i in range(2,len(H5)-2):
        if H5[i]==H5[i-2:i+3].max(): ph[i+2]=H5[i]
        if L5[i]==L5[i-2:i+3].min(): pl[i+2]=L5[i]
    ph=pd.Series(ph).ffill().values; pl=pd.Series(pl).ffill().values
    vma=pd.Series(v).rolling(60,min_periods=10).mean().shift(1).values
    out=[]
    for _,b in R.iterrows():
        i=int(b.i); d=int(b.dir)
        if i+2>=n or not (570<=tod[i]<FLAT): continue
        rng=h[i]-l[i]
        if rng<=0: continue
        ext=l[i] if d==1 else h[i]; body=min(o[i],c[i]) if d==1 else max(o[i],c[i])
        lim=ext+ce*(body-ext); stp=(b.bot-buf) if d==1 else (b.top+buf)
        if (d==1 and stp>=lim) or (d==-1 and stp<=lim): continue
        risk=abs(lim-stp)
        if risk<1.5 or risk>60: continue
        gi=i//5; sw=ph[gi] if d==1 else pl[gi]
        if not np.isfinite(sw): continue
        if (d==1 and sw<=lim) or (d==-1 and sw>=lim): continue
        rr=abs(sw-lim)/risk
        # ---- candle-level score, all pre-entry ----
        wick=((min(o[i],c[i])-l[i]) if d==1 else (h[i]-max(o[i],c[i])))/rng
        close_pos=(c[i]-l[i])/rng; close_pos=close_pos if d==1 else 1-close_pos
        volx=v[i]/vma[i] if np.isfinite(vma[i]) and vma[i]>0 else 1.0
        body_frac=abs(c[i]-o[i])/rng
        out.append(dict(t=df.index[i],i=i,d=d,lim=lim,stp=stp,sw=sw,risk=risk,rr=rr,
                        conf=b.n,wick=wick,close_pos=close_pos,volx=volx,body=body_frac,
                        day=pd.Timestamp(df.index[i]).normalize()))
    C=pd.DataFrame(out)
    # ---- resolve every candidate causally ----
    res=[]
    for _,r in C.iterrows():
        i=int(r.i); d=int(r.d); lim=r.lim; stp=r.stp; sw=r.sw
        fill=-1
        for k in range(i+1,min(i+1+maxwait,n)):
            if tod[k]>=FLAT: break
            if (l[k]<=lim) if d==1 else (h[k]>=lim): fill=k; break
        if fill<0: res.append(np.nan); continue
        pnl=np.nan
        for k in range(fill+1,min(fill+maxhold,n)):
            last=tod[k]>=FLAT or k==n-1
            hs=(l[k]<=stp) if d==1 else (h[k]>=stp)
            ht=(h[k]>=sw) if d==1 else (l[k]<=sw)
            if hs: px=stp-d*TICK
            elif ht: px=sw
            elif last: px=c[k]
            else: continue
            pnl=d*(px-lim)*pv-comm; break
        res.append(pnl)
    C['pnl']=res
    return C.dropna(subset=['pnl'])

SP=[('NQ 2023-24 SELECT','nq_v6.parquet',(2023,2024)),('NQ 2025 CONFIRM','nq_v6.parquet',(2025,2025)),
