        mf, tf, nf = daycluster_t(f_.r60, f_.day)
        ms, ts, ns = daycluster_t(sl.r60, sl.day)
        print(f'    {p:<7}{nf:>8}{mf:>+10.4f}{tf:>+8.2f}   {ns:>8}{ms:>+10.4f}{ts:>+8.2f}')

