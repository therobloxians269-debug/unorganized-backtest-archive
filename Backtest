#!/usr/bin/env python3
"""GEXLAB M1b CONTROL — can Method A recover a dealer sign we planted ourselves?

The measurement on real data says nothing until this passes. If the instrument
cannot read an answer we wrote into the chain by hand, then whatever it prints on
Monday's open interest is not a measurement, it is a number.

Each case builds a synthetic pair of settlements from a REAL chain -- real
strikes, real quotes, real spreads -- and overwrites only the two things Method A
consumes: the open-interest change, and where each print landed in the spread.
The truth is therefore known exactly, and the test is whether measure_doi()
returns it.

    python3 signtest.py           # the full suite
    python3 signtest.py -v        # show every case's numbers
"""
from __future__ import annotations

import sys

import numpy as np
import pandas as pd

import gex as G
import sign as S

VERBOSE = "-v" in sys.argv
RNG = np.random.default_rng(11)

# planted share must come back at least this strong, and a null must stay under
STRONG, NULL_MAX = 0.90, 0.25


# ─────────────────────────────── fixtures ───────────────────────────────
def base_chain(per_side: int = 300) -> pd.DataFrame:
    """A real chain, trimmed to contracts whose quotes Method A will accept.

    trade_location() drops anything without a two-sided quote or with a spread
    wider than 50% of mid, so the fixture has to clear that bar or the test would
    be measuring the filter instead of the classifier.
    """
    # Must go through the quality gate, not just take the newest file: CBOE
    # serves all-zero IV intermittently, and load() then correctly returns an
    # empty frame, which reads here as "fixture too thin" rather than as the
    # feed defect it actually is.
    d = G.load(G.latest_snapshot("QQQ", verbose=False))
    d = d[(d["bid"] > 0) & (d["ask"] > d["bid"])].copy()
    d["_mid"] = (d["bid"] + d["ask"]) / 2.0
    d = d[(d["ask"] - d["bid"]) / d["_mid"].clip(lower=0.01) < 0.40]
    parts = [d[d["right"] == r].head(per_side) for r in ("C", "P")]
    out = pd.concat(parts).reset_index(drop=True)
    if len(out) < 2 * per_side * 0.5:
        raise SystemExit(f"fixture too thin: {len(out)} contracts")
    return out


def _loc_to_price(df: pd.DataFrame, loc: np.ndarray) -> np.ndarray:
    """loc 0 = print at the bid (customer sold), 1 = at the ask (bought)."""
    return df["bid"].to_numpy() + loc * (df["ask"] - df["bid"]).to_numpy()


def make_pair(base: pd.DataFrame, call_side: float, put_side: float,
              doi_calls: float = 100.0, doi_puts: float = 100.0,
              b_side: float | None = None, random_loc: bool = False):
    """Build (a, b): two settlements with a known answer planted in `a`.

    call_side / put_side: +1 customers bought to open, -1 customers sold to open.
    b_side: if set, `b` gets prints planted the OPPOSITE way. Method A must
            ignore them -- market data is supposed to come from `a` alone.
    """
    a, b = base.copy(), base.copy()
    a["open_interest"] = 1000.0
    a["volume"] = 500.0

    doi = np.where(a["right"].to_numpy() == "C", doi_calls, doi_puts)
    b["open_interest"] = 1000.0 + doi

    if random_loc:
        loc = RNG.uniform(0.0, 1.0, len(a))
    else:
        side = np.where(a["right"].to_numpy() == "C", call_side, put_side)
        loc = (side + 1.0) / 2.0        # +1 -> 1.0 (ask), -1 -> 0.0 (bid)
    a["last_trade_price"] = _loc_to_price(a, loc)

    b["volume"] = 500.0
    b_loc = np.full(len(b), 0.5) if b_side is None else np.full(len(b), (b_side + 1.0) / 2.0)
    b["last_trade_price"] = _loc_to_price(b, b_loc)
    return a, b


# ─────────────────────────────── harness ───────────────────────────────
FAILS: list[str] = []


def check(name: str, cond: bool, detail: str = "") -> None:
    tag = "ok  " if cond else "FAIL"
    if not cond:
        FAILS.append(name)
    if VERBOSE or not cond:
        print(f"  [{tag}] {name}   {detail}")
    else:
        print(f"  [{tag}] {name}")


def near(x, target, tol) -> bool:
    return x is not None and abs(x - target) <= tol


# ─────────────────────────────── the cases ───────────────────────────────
def main() -> None:
    base = base_chain()
    nC = int((base["right"] == "C").sum())
    nP = int((base["right"] == "P").sum())
    print(f"fixture: {len(base)} real contracts ({nC} calls, {nP} puts)\n")

    print("A. can it recover a planted sign at all?")
    a, b = make_pair(base, call_side=+1, put_side=+1)
    r = S.measure_doi(a, b)
    check("customers BOUGHT both -> dealers SHORT both",
          r["status"] == "ok" and r["calls"] > STRONG and r["puts"] > STRONG,
          f"calls {r['calls']:+.3f}  puts {r['puts']:+.3f}")

    a, b = make_pair(base, call_side=-1, put_side=-1)
    r = S.measure_doi(a, b)
    check("customers SOLD both -> dealers LONG both",
          r["calls"] < -STRONG and r["puts"] < -STRONG,
          f"calls {r['calls']:+.3f}  puts {r['puts']:+.3f}")

    print("\nB. can it recover the STANDARD convention specifically?")
    # convention = dealers long calls, short puts = customers sold calls, bought puts
    a, b = make_pair(base, call_side=-1, put_side=+1)
    r = S.measure_doi(a, b)
    check("dealers LONG calls / SHORT puts recovered",
          r["calls"] < -STRONG and r["puts"] > STRONG,
          f"calls {r['calls']:+.3f}  puts {r['puts']:+.3f}")

    a, b = make_pair(base, call_side=+1, put_side=-1)
    r = S.measure_doi(a, b)
    check("the INVERTED convention is also recovered (not hard-coded)",
          r["calls"] > STRONG and r["puts"] < -STRONG,
          f"calls {r['calls']:+.3f}  puts {r['puts']:+.3f}")

    print("\nC. the null — random prints must produce no sign")
    shares = []
    for _ in range(12):
        a, b = make_pair(base, 0, 0, random_loc=True)
        r = S.measure_doi(a, b)
        shares += [r["calls"], r["puts"]]
    worst = max(abs(s) for s in shares)
    check("random trade location -> |share| stays near zero",
          worst < NULL_MAX, f"worst |share| over 24 draws {worst:.3f}")

    print("\nD. the directional-pairing regression test")
    # `a` says bought, `b` says sold. Open interest published in `b` is the
    # SETTLED result of the session that traded in `a`, so reading location off
    # `b` explains yesterday's OI with today's first few minutes of prints.
    a, b = make_pair(base, call_side=+1, put_side=+1, b_side=-1)
    r = S.measure_doi(a, b)
    check("prints are taken from A, never from B",
          r["calls"] > STRONG and r["puts"] > STRONG,
          f"calls {r['calls']:+.3f}  puts {r['puts']:+.3f} (B planted the opposite)")

    print("\nE. contracts that CLOSED must not vote")
    # OI down = contracts closed, which says nothing about new dealer inventory.
    # Plant closers at the ask and openers at the bid: only the openers may count.
    a, b = make_pair(base, call_side=-1, put_side=-1)
    is_call = a["right"].to_numpy() == "C"
    b.loc[is_call, "open_interest"] = 1000.0 - 300.0      # calls CLOSED
    a.loc[is_call, "last_trade_price"] = _loc_to_price(a[is_call], np.ones(is_call.sum()))
    r = S.measure_doi(a, b)
    check("OI decreases are excluded from the vote",
          r["calls"] is None and r["puts"] < -STRONG,
          f"calls {r['calls']}  puts {r['puts']:+.3f}")

    print("\nF. is it weighted by SIZE of the opening, not contract count?")
    # one huge buy against many small sells must come out net BOUGHT
    a, b = make_pair(base, call_side=-1, put_side=-1)
    ci = np.flatnonzero(a["right"].to_numpy() == "C")
    big = ci[0]
    b.iloc[big, b.columns.get_loc("open_interest")] = 1000.0 + 100.0 * len(ci) * 3
    a.iloc[big, a.columns.get_loc("last_trade_price")] = float(a["ask"].iloc[big])
    r = S.measure_doi(a, b)
    check("one large opening outweighs many small ones",
          r["calls"] > 0.4, f"calls {r['calls']:+.3f} (unweighted would be ~-1)")

    print("\nG. the same-settlement guard")
    a, b = make_pair(base, +1, +1)
    b["open_interest"] = a["open_interest"]
    r = S.measure_doi(a, b)
    check("identical OI is reported as missing data, not as a null result",
          r["status"] == "same_settlement" and r["changed"] == 0,
          f"status={r['status']}")

    print("\nH. does the classifier invent a mirror image?")
    # The live reading came back near-symmetric (-20.8% calls / +19.7% puts).
    # That is either real customer behaviour or an artifact of calls and puts
    # sitting on opposite sides of spot. Plant the SAME side on both: a mirroring
    # artifact would still split them, a clean classifier will not.
    a, b = make_pair(base, call_side=+1, put_side=+1)
    r = S.measure_doi(a, b)
    check("same side planted on both -> both report the same sign",
          r["calls"] > STRONG and r["puts"] > STRONG and
          abs(r["calls"] - r["puts"]) < 0.15,
          f"calls {r['calls']:+.3f}  puts {r['puts']:+.3f}  gap {abs(r['calls']-r['puts']):.3f}")

    n_run = 10
    print(f"\n{'-' * 62}")
    if FAILS:
        print(f"{len(FAILS)} FAILED: {', '.join(FAILS)}")
        print("Method A cannot be trusted on real data until these pass.")
        sys.exit(1)
    print(f"ALL {n_run} CONTROLS PASS — Method A recovers a planted sign, stays")
    print("silent on noise, ignores closers, weights by size, and reads its")
    print("prints from the correct settlement. The instrument works.")


if __name__ == "__main__":
    main()

