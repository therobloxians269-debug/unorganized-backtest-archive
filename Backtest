"""
UNFINISHED BUSINESS — test the MECHANISM against ground truth first, candles second.

The methodological fix for everything built today: all seven prior concepts ASSERTED a
mechanism and then tested a candle proxy for it. That is circular. Here the order is
reversed:

  STEP 1  does the real, print-level event behave the way auction theory claims?
          (23-28 sessions of true aggressor data — small, but it is GROUND TRUTH)
  STEP 2  does the readable candle pattern identify that event?     [done: 1.56-1.78x lift]
  STEP 3  only if 1 and 2 both hold, test the candle signature over 16 years.

THE CLAIM (auction theory, not a retail pattern)
    A high made where the auction never completed — trading on BOTH sides of the
    extreme, no clean single-print rejection — leaves business undone. The market
    returns to finish it, so that high gets EXCEEDED later.
    A high made on a clean rejection is finished business, and it HOLDS.

This is directly falsifiable and it has a natural control group (finished auctions at
the same kind of location). It also connects to the one validated object we have: if
true, "unfinished" is a real feature for the extreme-survival estimator.
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')

OF = '/Users/kaveh/Downloads/mesx/orderflow/bars_5min.parquet'


def load_truth():
    d = pd.read_parquet(OF)
    d = d[d.rth].copy()
    d['nowick_hi'] = (d.high - np.maximum(d.open, d.close)) <= 1e-9
    d['nowick_lo'] = (np.minimum(d.open, d.close) - d.low) <= 1e-9
    return d


def running_extreme_events(d, hi_flag='unfin_high', lo_flag='unfin_low'):
    """
    One row per bar that sets a NEW RUNNING SESSION EXTREME. That is the only fair
    comparison set: it holds location constant so 'unfinished' is the only thing that
    varies. For each, ask whether the extreme was later EXCEEDED in the same session.
    """
    rows = []
    for dt, g in d.groupby('date_et'):
        g = g.sort_values('tod_min')
        H, L = g.high.values, g.low.values
        uh, ul = g[hi_flag].values, g[lo_flag].values
        nh, nl = g.nowick_hi.values, g.nowick_lo.values
        T = g.tod_min.values
        n = len(g)
        if n < 40:
            continue
        cmaxH = np.maximum.accumulate(H)
        cminL = np.minimum.accumulate(L)
        for i in range(3, n - 6):
            # new running high?
            if H[i] >= cmaxH[i - 1] - 1e-9:
                later = H[i + 1:]
                rows.append(dict(date=dt, tod=T[i], side='hi', i=i,
                                 unfin=bool(uh[i]), nowick=bool(nh[i]),
                                 exceeded=bool((later > H[i] + 1e-9).any()),
                                 bars_left=n - i - 1))
            if L[i] <= cminL[i - 1] + 1e-9:
                later = L[i + 1:]
                rows.append(dict(date=dt, tod=T[i], side='lo', i=i,
                                 unfin=bool(ul[i]), nowick=bool(nl[i]),
                                 exceeded=bool((later < L[i] - 1e-9).any()),
                                 bars_left=n - i - 1))
    return pd.DataFrame(rows)


def compare(ev, flag, label):
    """Exceeded-rate for flagged vs unflagged, controlling for bars remaining."""
    print(f'\n  {label}')
    print(f'    {"group":<22}{"n":>7}{"exceeded":>11}{"med bars left":>15}')
    for side in ('hi', 'lo', 'both'):
        s = ev if side == 'both' else ev[ev.side == side]
        a = s[s[flag]]; b = s[~s[flag]]
        if len(a) < 20 or len(b) < 20:
            continue
        print(f'    {side} {flag}=1{"":<10}{len(a):>7}{a.exceeded.mean():>11.3f}'
              f'{a.bars_left.median():>15.0f}')
        print(f'    {side} {flag}=0{"":<10}{len(b):>7}{b.exceeded.mean():>11.3f}'
              f'{b.bars_left.median():>15.0f}')
        # bars-left-matched comparison: the only real confound is time remaining
        q = pd.qcut(s.bars_left, 4, labels=False, duplicates='drop')
        diffs, ns = [], []
        for k in sorted(pd.Series(q).dropna().unique()):
            m = (q == k)
            aa, bb = s[m & s[flag]], s[m & ~s[flag]]
            if len(aa) >= 10 and len(bb) >= 10:
                diffs.append(aa.exceeded.mean() - bb.exceeded.mean())
                ns.append(len(aa) + len(bb))
        if diffs:
            w = np.array(ns, dtype=float)
            print(f'    -> bars-left-matched lift: {np.average(diffs, weights=w):+.3f}'
                  f'  (strata: {", ".join(f"{x:+.3f}" for x in diffs)})')
        print()

