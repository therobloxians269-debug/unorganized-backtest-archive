"""
Portfolio construction — combines sleeve return streams by RISK budget.

This layer is methodology, not Core IP, so it is shown in full. It takes a DataFrame of sleeve
returns and produces the combined program return under a chosen allocation scheme. The default,
shippable scheme is `risk_capped` — equal-risk-contribution with a hard cap on the carry budget,
because measured carry vol understates true carry risk (see DISCLOSURES.md). Naive inverse-vol /
ERC is provided only to demonstrate, and explicitly warn against, the carry mirage.
"""
from __future__ import annotations

import numpy as np
import pandas as pd
from scipy.optimize import minimize

# Disclosed default capital weights (the legacy/headline scheme).
CAPITAL_WEIGHTS = {"carry_binance": 0.35, "carry_hyperliquid": 0.25, "momentum": 0.15, "trend": 0.25}


def _erc_weights(cov: np.ndarray, carry_cap: float | None, carry_idx: list[int]) -> np.ndarray:
    n = cov.shape[0]

    def obj(w):
        pv = w @ cov @ w
        rc = (w * (cov @ w)) / pv
        return float(((rc - 1 / n) ** 2).sum())

    cons = [{"type": "eq", "fun": lambda w: w.sum() - 1}]
    if carry_cap is not None and carry_idx:
        cons.append({"type": "ineq", "fun": lambda w: carry_cap - w[carry_idx].sum()})
    res = minimize(obj, np.repeat(1 / n, n), bounds=[(0.01, 0.97)] * n,
                   constraints=cons, method="SLSQP")
    return res.x


def combine(sleeve_returns: pd.DataFrame, scheme: str = "risk_capped",
            carry_cap: float = 0.60) -> pd.Series:
    """
    scheme:
      "capital"     -> disclosed legacy weights (headline 1.72 Sharpe number)
      "inverse_vol" -> MIRAGE: over-levers carry; do not ship (kept for transparency)
      "erc"         -> equal risk contribution (also over-weights carry)
      "risk_capped" -> ERC with carry budget capped (the honest, shippable improvement)
    """
    R = sleeve_returns.dropna(how="all").fillna(0.0)
    cols = list(R.columns)
    carry_idx = [i for i, c in enumerate(cols) if c.startswith("carry")]

    if scheme == "capital":
        w = np.array([CAPITAL_WEIGHTS.get(c, 0.0) for c in cols])
        w = w / w.sum()
    elif scheme == "inverse_vol":
        iv = 1.0 / R.std().replace(0, np.nan)
        w = (iv / iv.sum()).fillna(0.0).values
    elif scheme in ("erc", "risk_capped"):
        cov = R.cov().values
        w = _erc_weights(cov, carry_cap if scheme == "risk_capped" else None, carry_idx)
    else:
        raise ValueError(f"unknown scheme: {scheme}")

    return pd.Series(R.values @ w, index=R.index, name=f"program_{scheme}")


def risk_contribution(sleeve_returns: pd.DataFrame, weights: dict[str, float]) -> pd.Series:
    """Realised % risk contribution per sleeve under a given weighting."""
    R = sleeve_returns.fillna(0.0)
    w = np.array([weights.get(c, 0.0) for c in R.columns])
    cov = R.cov().values
    pv = w @ cov @ w
    rc = (w * (cov @ w)) / pv if pv > 0 else np.zeros_like(w)
    return pd.Series(rc, index=R.columns, name="risk_contribution")

