==============================================================================
"""M1 (intraday extension) -- tick/trade loading and causal time-bar aggregation.

The daily OHLCV layer (``ope.data``) feeds the trend/volatility overlay; this module
turns CME Globex MDP3 *trades* (Databento) into causal intraday bars plus order-flow
series for the microstructure core. We research on the E-mini ES (deep, liquid tick
data) and deploy on the Micro E-mini (MES).

Aggressor convention -- verified empirically against the data (May-Jun 2026 ES) with
the tick rule: 97.6% of upticks carry side 'B' and 97.6% of downticks carry side 'A'.
So::

    side 'B' = buy aggressor  (+1)
    side 'A' = sell aggressor (-1)
    side 'N' = unknown        ( 0)

and ``signed_size = +size`` for buys, ``-size`` for sells. Cumulative volume delta
(CVD) is ``signed_size.cumsum()`` (reset per session by the feature layer, M2').

Causality: bars are right-labeled and right-closed -- a bar stamped ``t`` covers the
half-open interval ``(t - freq, t]`` and is fully known at ``t``. No look-ahead.
"""
from __future__ import annotations

from pathlib import Path

import numpy as np
import pandas as pd

from ope.instruments import US_EQUITY_RTH, SessionSpec
from ope.logging_utils import get_logger

_LOG = get_logger("tick_data")

# Raw Databento trades columns we consume (others in the file are ignored).
RAW_TRADE_COLUMNS = ("ts_event", "instrument_id", "symbol", "price", "size", "side", "sequence")
# Canonical per-bar columns produced by ``trades_to_bars`` (before session tags).
BAR_COLUMNS = (
    "open", "high", "low", "close", "vwap", "volume",
    "buy_vol", "sell_vol", "cvd_delta", "dollar_vol", "n_trades",
)
DEFAULT_TZ = "America/New_York"
_AGGRESSOR = {"B": 1, "A": -1, "N": 0}


def aggressor_sign(side: pd.Series) -> pd.Series:
    """Map Databento trade ``side`` to signed aggressor direction (+1 buy / -1 sell / 0).

    Convention verified empirically (tick rule): 'B' = buy aggressor, 'A' = sell
    aggressor. Unknown/other codes map to 0 so they neither add to nor subtract from
    order flow.
    """
    return side.map(_AGGRESSOR).fillna(0).astype("int64")


def normalize_trades(raw: pd.DataFrame, *, tz: str = DEFAULT_TZ) -> pd.DataFrame:
    """Coerce a raw Databento trades frame into a canonical, sorted, causal form.

    - ``ts_event`` is made tz-aware (UTC if naive) and converted to ``tz`` (default ET),
      then rows are sorted by (ts_event, sequence) so same-nanosecond trades retain
      matching-engine order.
    - rows with non-positive or missing price/size are dropped.
    - adds ``signed_size`` (+size buy / -size sell / 0 unknown) for order-flow sums.

    Returns a frame indexed by ``ts_event`` with the available canonical columns.
    """
    keep_order = ("instrument_id", "symbol", "price", "size", "side", "sequence", "signed_size")
    if raw is None or len(raw) == 0:
        idx = pd.DatetimeIndex([], name="ts_event", tz=tz)
        return pd.DataFrame({c: [] for c in keep_order}, index=idx)

    df = raw.copy()
    ts = pd.to_datetime(df["ts_event"])
    ts = ts.dt.tz_localize("UTC") if ts.dt.tz is None else ts
    df["ts_event"] = ts.dt.tz_convert(tz)

    sort_keys = ["ts_event"] + (["sequence"] if "sequence" in df.columns else [])
    df = df.sort_values(sort_keys, kind="stable")

    df["price"] = pd.to_numeric(df["price"], errors="coerce")
    df["size"] = pd.to_numeric(df["size"], errors="coerce")
    df = df.dropna(subset=["price", "size"])
    df = df[(df["price"] > 0) & (df["size"] > 0)]

    df["signed_size"] = df["size"].astype("int64") * aggressor_sign(df["side"])

    df = df.set_index("ts_event")
    return df[[c for c in keep_order if c in df.columns]]


def select_front_month(trades: pd.DataFrame) -> pd.DataFrame:
    """Keep only the most-active contract (max total traded size).

    Over a short window one expiry dominates volume (the lead month), so total size is
    a robust, causal proxy for 'front month' without needing the instrument-definition
    feed. (For the May-Jun 2026 ES pilot the lead month is >99% of all trades.)
    """
    if "instrument_id" not in trades.columns or trades.empty:
        return trades
    front = trades.groupby("instrument_id")["size"].sum().idxmax()
    out = trades[trades["instrument_id"] == front]
    _LOG.info("front-month instrument_id=%s (%d of %d trades)", front, len(out), len(trades))
    return out


def load_trades(path: str | Path, *, tz: str = DEFAULT_TZ,
                front_month_only: bool = True) -> pd.DataFrame:
    """Load a Databento trades parquet into canonical form (see ``normalize_trades``)."""
    import pyarrow.parquet as pq

    p = Path(path)
    names = set(pq.ParquetFile(str(p)).schema.names)
    cols = [c for c in RAW_TRADE_COLUMNS if c in names]
    trades = normalize_trades(pd.read_parquet(p, columns=cols), tz=tz)
    return select_front_month(trades) if front_month_only else trades


def _tag_session(index: pd.DatetimeIndex, session: SessionSpec) -> tuple[pd.Series, pd.Series]:
    """Return (session_date, in_rth) for a tz-aware bar index, in the session's tz."""
    local = index.tz_convert(session.tz)
    in_rth = pd.Series(
        [session.rth_open <= t < session.rth_close for t in local.time],
        index=index, name="in_rth",
    )
    session_date = pd.Series(local.date, index=index, name="session_date")
    return session_date, in_rth


def trades_to_bars(
    trades: pd.DataFrame,
    freq: str = "1min",
    *,
    session: SessionSpec = US_EQUITY_RTH,
    rth_only: bool = False,
    drop_empty: bool = True,
) -> pd.DataFrame:
    """Aggregate canonical trades into causal time bars with order-flow columns.

    Bars are right-labeled and right-closed: a bar stamped ``t`` covers ``(t-freq, t]``
    and is fully known at ``t``. Each bar carries OHLC, ``vwap``, total/buy/sell volume,
    ``cvd_delta`` (= buy_vol - sell_vol), ``dollar_vol``, ``n_trades``, plus
    ``session_date`` and ``in_rth`` tags. With ``rth_only=True`` only regular-hours bars
    are returned. Empty intervals are dropped unless ``drop_empty=False``.
    """
    if trades.empty:
        return pd.DataFrame(columns=[*BAR_COLUMNS, "session_date", "in_rth"])

    t = trades.copy()
    t["buy_size"] = np.where(t["signed_size"] > 0, t["size"], 0.0)
    t["sell_size"] = np.where(t["signed_size"] < 0, t["size"], 0.0)
    t["pv"] = t["price"] * t["size"]

    r = t.resample(freq, label="right", closed="right")
    bars = pd.DataFrame(
        {
            "open": r["price"].first(),
            "high": r["price"].max(),
            "low": r["price"].min(),
            "close": r["price"].last(),
            "volume": r["size"].sum(),
            "buy_vol": r["buy_size"].sum(),
            "sell_vol": r["sell_size"].sum(),
            "dollar_vol": r["pv"].sum(),
            "n_trades": r["price"].count(),
        }
    )
    if drop_empty:
        bars = bars[bars["n_trades"] > 0]

    bars["vwap"] = bars["dollar_vol"] / bars["volume"].where(bars["volume"] > 0)
    bars["cvd_delta"] = bars["buy_vol"] - bars["sell_vol"]
    bars = bars[list(BAR_COLUMNS)]

    session_date, in_rth = _tag_session(bars.index, session)
    bars["session_date"] = session_date
    bars["in_rth"] = in_rth
    return bars[bars["in_rth"]] if rth_only else bars

