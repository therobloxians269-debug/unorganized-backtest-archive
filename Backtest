def sim(stop_frac, tgt_frac):
    """stop/target as fractions of the previous cycle range, measured from the level."""
    out = []
    for k in range(1, len(cycles)):
        pc, cc = cycles[k - 1], cycles[k]
        H, L = HI.loc[pc], LO.loc[pc]
        if not (np.isfinite(H) and np.isfinite(L)) or H <= L:
            continue
        rg = H - L
        d = m1[m1["cyc"] == cc]
        if len(d) < 200:
            continue
        ch, cl, cc_ = d["nq_high"].to_numpy(), d["nq_low"].to_numpy(), d["nq_close"].to_numpy()
        for side in ("short", "long"):
            lvl = H if side == "short" else L
            r = rg * stop_frac
            stop = lvl + r if side == "short" else lvl - r
            tgt = lvl - rg * tgt_frac if side == "short" else lvl + rg * tgt_frac
            fills = np.flatnonzero(ch >= lvl) if side == "short" else np.flatnonzero(cl <= lvl)
            if not len(fills):
                continue
            f = fills[0]
            fh, fl = ch[f:], cl[f:]
            si = np.flatnonzero(fh >= stop) if side == "short" else np.flatnonzero(fl <= stop)
            ti = np.flatnonzero(fl <= tgt) if side == "short" else np.flatnonzero(fh >= tgt)
            s0 = si[0] if len(si) else 10**9
            t0 = ti[0] if len(ti) else 10**9
            rr = tgt_frac / stop_frac
            if s0 <= t0:
                gross = -1.0
            elif t0 < s0:
                gross = rr
            else:
                last = cc_[-1]
                gross = (lvl - last) / r if side == "short" else (last - lvl) / r
            out.append(gross * r * MNQ_PT - COST_PTS * MNQ_PT)
    return np.array(out)


