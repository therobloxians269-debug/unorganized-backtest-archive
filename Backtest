"""
REJECTION BLOCKS on MNQ/NQ — which ones reject hardest?

A rejection block is the WICK zone of a swing candle:
  bearish RB = [max(open,close) .. high]  at a swing high   (upper wick)
  bullish RB = [low .. min(open,close)]   at a swing low    (lower wick)

Goal: rank blocks so we can draw the single best bullish and single best
bearish one each day. Everything is confirmed with `right` bars of lag so
there is no lookahead.
"""
import numpy as np, pandas as pd
import qtlib as Q

TF = "15min"
LEFT, RIGHT = 3, 3          # pivot confirmation
MAX_AGE_BARS = 96           # a block stays live ~1 day of 15m bars
BARRIER_PCT = 0.06          # symmetric barrier, % of price (~17 pts at 28.4k)

df = Q.load_data(verbose=False)
b = Q.resample(df, TF)
b = b.rename(columns={c: c.replace("nq_", "") for c in b.columns if c.startswith("nq_")})
b = b[["open", "high", "low", "close"]].copy()
b["sdate"] = (b.index + pd.Timedelta(hours=6)).date
print(f"[data] {len(b):,} {TF} bars, {b['sdate'].nunique()} days, "
      f"{b.index.min().date()} -> {b.index.max().date()}")

o, h, l, c = (b[x].to_numpy() for x in ("open", "high", "low", "close"))
n = len(b)
rng = np.maximum(h - l, 1e-9)
body_hi = np.maximum(o, c)
body_lo = np.minimum(o, c)
up_wick = h - body_hi
dn_wick = body_lo - l
atr = pd.Series(np.maximum.reduce([h - l, np.abs(h - np.roll(c, 1)),
                                   np.abs(l - np.roll(c, 1))])).rolling(14).mean().to_numpy()

# ---- pivots (confirmed RIGHT bars later, no lookahead) -------------------
is_ph = np.zeros(n, bool)
is_pl = np.zeros(n, bool)
for i in range(LEFT, n - RIGHT):
    w = slice(i - LEFT, i + RIGHT + 1)
    if h[i] == h[w].max() and (h[w] == h[i]).sum() == 1:
        is_ph[i] = True
    if l[i] == l[w].min() and (l[w] == l[i]).sum() == 1:
        is_pl[i] = True

print(f"[pivots] {is_ph.sum():,} swing highs, {is_pl.sum():,} swing lows")


def build(side):
    """Collect candidate blocks with their features."""
    rows = []
    piv = is_ph if side == "bear" else is_pl
    for i in np.flatnonzero(piv):
        conf = i + RIGHT                      # bar at which the block becomes known
        if conf >= n - 2 or not np.isfinite(atr[i]) or atr[i] <= 0:
            continue
        if side == "bear":
            z_lo, z_hi = body_hi[i], h[i]     # zone we expect to reject FROM
            wick = up_wick[i]
        else:
            z_lo, z_hi = l[i], body_lo[i]
            wick = dn_wick[i]
        if wick <= 0:
            continue
        rows.append(dict(i=i, conf=conf, side=side, z_lo=z_lo, z_hi=z_hi,
                         wick=wick, wick_frac=wick / rng[i], wick_atr=wick / atr[i],
                         px=c[i], sdate=b["sdate"].iloc[i],
                         hour=b.index[i].hour, atr=atr[i]))
    return pd.DataFrame(rows)


def test(blocks, displace=0.0):
    """First re-touch after confirmation, then a symmetric barrier race.

    displace shifts the zone by a % of price -> placebo control.
    """
    out = []
    for r in blocks.itertuples():
        shift = displace / 100.0 * r.px
        zl, zh = r.z_lo + shift, r.z_hi + shift
        lo_i, hi_i = r.conf + 1, min(r.conf + 1 + MAX_AGE_BARS, n)
        if lo_i >= hi_i:
            continue
        # first bar that trades into the zone
        if r.side == "bear":
            hit = np.flatnonzero(h[lo_i:hi_i] >= zl)
        else:
            hit = np.flatnonzero(l[lo_i:hi_i] <= zh)
        if not len(hit):
            continue
        t = lo_i + hit[0]
        entry = zl if r.side == "bear" else zh
        k = BARRIER_PCT / 100.0 * entry
        fwd = slice(t, min(t + MAX_AGE_BARS, n))
        fh, fl = h[fwd], l[fwd]
        if r.side == "bear":                  # reject = price falls away
            good = np.flatnonzero(fl <= entry - k)
            bad = np.flatnonzero(fh >= entry + k)
        else:
            good = np.flatnonzero(fh >= entry + k)
            bad = np.flatnonzero(fl <= entry - k)
        gi = good[0] if len(good) else 10**9
        bi = bad[0] if len(bad) else 10**9
        if gi == bi == 10**9:
            continue
        out.append(dict(side=r.side, rejected=gi < bi, wick=r.wick,
                        wick_frac=r.wick_frac, wick_atr=r.wick_atr,
                        hour=r.hour, sdate=r.sdate, age=t - r.conf))
    return pd.DataFrame(out)


bear, bull = build("bear"), build("bull")
print(f"[blocks] {len(bear):,} bearish, {len(bull):,} bullish candidates\n")

allb = pd.concat([bear, bull], ignore_index=True)
res = test(allb)
pl = pd.concat([test(allb, displace=+0.25), test(allb, displace=-0.25)], ignore_index=True)

print("=" * 74)
print("BASELINE — does a rejection block reject more than a displaced one?")
print("=" * 74)
print(f"  real blocks     : {res['rejected'].mean():.4f}   (n={len(res):,})")
print(f"  displaced (0.25%): {pl['rejected'].mean():.4f}   (n={len(pl):,})  <- placebo")
print(f"  edge over placebo: {res['rejected'].mean() - pl['rejected'].mean():+.4f}")

print("\n" + "=" * 74)
print("WHICH BLOCKS REJECT HARDEST — rejection rate by feature quintile")
print("=" * 74)
for feat in ("wick_atr", "wick_frac"):
    print(f"\n  by {feat}:")
    q = pd.qcut(res[feat], 5, labels=["Q1 smallest", "Q2", "Q3", "Q4", "Q5 largest"])
    t = res.groupby(q, observed=True).agg(n=("rejected", "size"), rate=("rejected", "mean"))
    print(t.to_string(float_format=lambda v: f"{v:8.4f}"))

print("\n  by side:")
print(res.groupby("side").agg(n=("rejected", "size"),
                              rate=("rejected", "mean")).to_string(float_format=lambda v: f"{v:8.4f}"))

print("\n  by formation hour (NY), top 8 by rate, min 200 obs:")
hr = res.groupby("hour").agg(n=("rejected", "size"), rate=("rejected", "mean"))
print(hr[hr["n"] >= 200].sort_values("rate", ascending=False).head(8)
      .to_string(float_format=lambda v: f"{v:8.4f}"))

