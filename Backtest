#!/usr/bin/env python3
"""OF-1 real-data runner: Databento GLBX.MDP3 trades -> FlowLab verdicts.

Runs on YOUR machine (needs DATABENTO_API_KEY in env). The container that
built this harness cannot reach Databento; nothing here was fit to real data.

Subcommands
  cost          Estimate USD cost of missing months. No purchase.
  download      Pull missing months to ./data/*.parquet. Needs --confirm-purchase.
                Holdout months additionally need --unlock-holdout.
  run-val       Evaluate all 34 preregistered cells on VAL (2024-01..2025-06).
                Writes candidates.json with cells passing ALL gates.
                Optional --with-is prints the IS table (context only, not a gate).
  run-holdout   SINGLE-SHOT. Evaluates ONLY candidates.json cells on the
                untouched holdout (2025-07..2026-06). Needs --unlock-holdout.

Gates (frozen in PREREG_OF1.md): HAC-t >= 3.0, DSR >= 0.95 at
--cumulative-trials, MCPT p <= 0.05, net > 0 after friction.

Typical sequence:
  export DATABENTO_API_KEY=db-xxxx
  python3 run_real.py cost
  python3 run_real.py download --confirm-purchase
  python3 run_real.py run-val --cumulative-trials <LEDGER+34>
  # ... if candidates.json is non-empty, ONE holdout shot, ever:
  python3 run_real.py download --confirm-purchase --unlock-holdout
  python3 run_real.py run-holdout --cumulative-trials <LEDGER+34> --unlock-holdout
"""
import argparse, datetime as dt, json, os, sys
from pathlib import Path
from zoneinfo import ZoneInfo

import numpy as np
import pandas as pd

import flowlab as fl

DATA = Path(__file__).parent / "data"
ET = ZoneInfo("America/New_York")
DATASET, SCHEMA, SYMBOL, STYPE = "GLBX.MDP3", "trades", "MES.v.0", "continuous"

# Frozen splits (PREREG_OF1.md). Holdout is untouched until run-holdout.
IS_START, IS_END = "2019-05-01", "2023-12-31"
VAL_START, VAL_END = "2024-01-01", "2025-06-30"
HO_START, HO_END = "2025-07-01", "2026-06-30"
CONTEXT_DAYS = 7          # lookback prefix so rolling-200 features are warm
MIN_TRADES_SESS = 10_000  # drop stub sessions (bad days / thin holidays)
EARLY_CLOSE_CUT = "15:55" # drop early-close sessions (declared filter)

GATE_T, GATE_DSR, GATE_P = 3.0, 0.95, 0.05


def _months(a, b):
    d = dt.date.fromisoformat(a).replace(day=1)
    end = dt.date.fromisoformat(b)
    while d <= end:
        nxt = (d.replace(day=28) + dt.timedelta(days=4)).replace(day=1)
        yield d.isoformat(), min(nxt - dt.timedelta(days=1), end).isoformat(), \
            f"{d:%Y-%m}"
        d = nxt


def _client():
    try:
        import databento as db
    except ImportError:
        sys.exit("pip install databento  (then set DATABENTO_API_KEY)")
    key = os.environ.get("DATABENTO_API_KEY")
    if not key:
        sys.exit("Set DATABENTO_API_KEY in your environment.")
    return db.Historical(key)


def _month_path(tag):
    return DATA / f"GLBX-MES-trades-{tag}.parquet"


def _rth_windows(a, b):
    """UTC [start,end) request windows covering 09:30-16:00 ET for each
    business day in [a, b]. DST-correct via zoneinfo."""
    d = dt.date.fromisoformat(a)
    end = dt.date.fromisoformat(b)
    while d <= end:
        if d.weekday() < 5:
            o = dt.datetime.combine(d, dt.time(9, 30), tzinfo=ET)
            c = dt.datetime.combine(d, dt.time(16, 0), tzinfo=ET)
            yield (o.astimezone(dt.UTC).isoformat(),
                   c.astimezone(dt.UTC).isoformat())
        d += dt.timedelta(days=1)


def _request_windows(a, b, full_day):
    if full_day:
        return [(a, b)]
    return list(_rth_windows(a, b))


def _wanted_months(unlock_holdout):
    m = list(_months(IS_START, VAL_END))
    if unlock_holdout:
        m += list(_months(HO_START, HO_END))
    return m


def cmd_cost(args):
    c = _client()
    total = 0.0
    mode = "FULL-DAY (ETH+RTH)" if args.full_day else "RTH-only windows"
    print(f"Estimating in {mode} mode ...")
    for a, b, tag in _wanted_months(args.unlock_holdout):
        if _month_path(tag).exists():
            continue
        usd = sum(c.metadata.get_cost(dataset=DATASET, symbols=[SYMBOL],
                                      stype_in=STYPE, schema=SCHEMA,
                                      start=w0, end=w1)
                  for w0, w1 in _request_windows(a, b, args.full_day))
        total += usd
        print(f"  {tag}: ${usd:,.2f}")
    print(f"\nTOTAL for missing months: ${total:,.2f}  [{mode}]"
          f"  (holdout {'INCLUDED' if args.unlock_holdout else 'excluded'})")
    print("Nothing purchased. Re-run as `download --confirm-purchase` to buy.")


def cmd_download(args):
    if not args.confirm_purchase:
        sys.exit("Refusing to purchase without --confirm-purchase. "
                 "Run `cost` first.")
    c = _client()
    DATA.mkdir(exist_ok=True)
    for a, b, tag in _wanted_months(args.unlock_holdout):
        p = _month_path(tag)
        if p.exists():
            print(f"  {tag}: cached")
            continue
        print(f"  {tag}: downloading "
              f"({'full-day' if args.full_day else 'RTH windows'}) ...",
              flush=True)
        chunks, skipped = [], []
        for w0, w1 in _request_windows(a, b, args.full_day):
            try:
                store = c.timeseries.get_range(
                    dataset=DATASET, symbols=[SYMBOL], stype_in=STYPE,
                    schema=SCHEMA, start=w0, end=w1)
                df = store.to_df()
            except Exception as e:            # holiday/empty window etc.
                skipped.append((w0[:10], str(e)[:60]))
                continue
            if df is None or len(df) == 0:
                continue
            chunks.append(_convert_trades(df))
        if not chunks:
            sys.exit(f"  {tag}: nothing returned; aborting so the gap is "
                     f"not silently cached. Skipped: {skipped[:3]}")
        out = pd.concat(chunks, ignore_index=True)
        out.to_parquet(p, index=False)
        note = f", {len(skipped)} empty/holiday windows" if skipped else ""
        print(f"  {tag}: {len(out):,} aggressor-classified trades{note} "
              f"-> {p.name}")


def _convert_trades(df):
    """Databento trades to_df frame -> lean parquet columns."""
    if "ts_event" in df.columns:
        ts = pd.DatetimeIndex(df["ts_event"])
    else:
        ts = df.index                      # to_df() default index
    px = df["price"].to_numpy()
    if np.issubdtype(px.dtype, np.integer):
        px = px * 1e-9                     # fixed-precision int -> float
    side = df["side"].astype(str).to_numpy()
    sd = np.where(side == "B", 1, np.where(side == "A", -1, 0)).astype(np.int8)
    keep = sd != 0                         # drop 'N' (no aggressor)
    ts_utc = (ts if ts.tz is not None else ts.tz_localize("UTC"))
    ts_utc = ts_utc.tz_convert("UTC").as_unit("ns")
    return pd.DataFrame({
        "ts": ts_utc[keep],
        "px": px[keep].astype(np.float32),
        "sz": df["size"].to_numpy()[keep].astype(np.int32),
        "sd": sd[keep],
    })


def load_tape(start, end):
    """Assemble a FlowLab tape dict from cached parquets over [start, end]."""
    frames = []
    for a, b, tag in _months(start, end):
        p = _month_path(tag)
        if not p.exists():
            sys.exit(f"Missing {p.name}; run `download` for this range first.")
        frames.append(pd.read_parquet(p))
    df = pd.concat(frames, ignore_index=True)
    t = pd.DatetimeIndex(df["ts"])
    if t.tz is None:
        t = t.tz_localize("UTC")
    t = t.tz_convert(ET)
    df["date"] = t.date
    df["sec"] = (t.hour * 3600 + t.minute * 60 + t.second
                 + t.microsecond / 1e6
                 - (9 * 3600 + 30 * 60)).astype(np.float32)
    df = df[(df["sec"] >= 0) & (df["sec"] < fl.RTH_SECS)
            & (df["date"] >= dt.date.fromisoformat(start))
            & (df["date"] <= dt.date.fromisoformat(end))]
    # session hygiene: drop stubs and declared early closes
    g = df.groupby("date")["sec"]
    ok = (g.size() >= MIN_TRADES_SESS) & \
         (g.max() >= _hhmm_to_sec(EARLY_CLOSE_CUT))
    dates = sorted(d for d, v in ok.items() if v)
    df = df[df["date"].isin(set(dates))].sort_values(["date", "sec"], kind="stable")
    sess_id = {d: i for i, d in enumerate(dates)}
    tape = {
        "sess": df["date"].map(sess_id).to_numpy(np.int16),
        "sec": df["sec"].to_numpy(np.float32),
        "price": df["px"].to_numpy(np.float32),
        "side": df["sd"].to_numpy(np.int8),
        "size": df["sz"].to_numpy(np.int32),
    }
    return tape, dates


def _hhmm_to_sec(hhmm):
    h, m = map(int, hhmm.split(":"))
    return (h * 3600 + m * 60) - (9 * 3600 + 30 * 60)


def _passers(tab):
    m = (tab["hac_t"] >= GATE_T) & (tab["dsr"] >= GATE_DSR) \
        & (tab["mcpt_p"] <= GATE_P) & (tab["net_pts"] > 0)
    return tab[m.fillna(False)]


def _print_tab(tab, title):
    print(f"\n=== {title} ===")
    print(tab.sort_values("hac_t", ascending=False).to_string(index=False))


def cmd_run_val(args):
    ctx = (dt.date.fromisoformat(VAL_START)
           - dt.timedelta(days=CONTEXT_DAYS)).isoformat()
    tape, dates = load_tape(ctx if not args.with_is else IS_START, VAL_END)
    cells, mats, _ = fl.build_all_cells(tape)
    d0, d1 = dt.date.fromisoformat(VAL_START), dt.date.fromisoformat(VAL_END)
    val_ids = [i for i, d in enumerate(dates) if d0 <= d <= d1]
    if args.with_is:
        i1 = dt.date.fromisoformat(IS_END)
        is_ids = [i for i, d in enumerate(dates) if d <= i1]
        _print_tab(fl.evaluate_cells(cells, mats, is_ids, args.cumulative_trials),
                   f"IS {IS_START}..{IS_END}  ({len(is_ids)} sessions) "
                   "[context only, NOT a gate]")
    tab = fl.evaluate_cells(cells, mats, val_ids, args.cumulative_trials)
    _print_tab(tab, f"VAL {VAL_START}..{VAL_END}  ({len(val_ids)} sessions)"
                    f"  N_trials={args.cumulative_trials}")
    good = _passers(tab)
    out = {"created": dt.datetime.now(dt.UTC).isoformat(),
           "cumulative_trials": args.cumulative_trials,
           "gates": {"t": GATE_T, "dsr": GATE_DSR, "mcpt_p": GATE_P},
           "val_passers": good.to_dict("records")}
    Path("candidates.json").write_text(json.dumps(out, indent=2, default=str))
    _ledger(f"OF-1 VAL run @N={args.cumulative_trials}: "
            f"{len(good)}/34 cells pass -> {sorted(good['cell'])}")
    print(f"\nVAL passers: {len(good)}/34 -> {sorted(good['cell'].tolist())}")
    print("Wrote candidates.json"
          + ("" if len(good) else "  (empty: class result so far = kill)"))


def cmd_run_holdout(args):
    if not args.unlock_holdout:
        sys.exit("Holdout is single-shot. Pass --unlock-holdout only when "
                 "you are ready to spend it.")
    cand = json.loads(Path("candidates.json").read_text())["val_passers"]
    if not cand:
        sys.exit("candidates.json is empty; nothing earned a holdout shot.")
    names = {c["cell"] for c in cand}
    ctx = (dt.date.fromisoformat(HO_START)
           - dt.timedelta(days=CONTEXT_DAYS)).isoformat()
    tape, dates = load_tape(ctx, HO_END)
    cells, mats, _ = fl.build_all_cells(tape)
    cells = {k: v for k, v in cells.items() if k in names}
    d0 = dt.date.fromisoformat(HO_START)
    ho_ids = [i for i, d in enumerate(dates) if d >= d0]
    tab = fl.evaluate_cells(cells, mats, ho_ids, args.cumulative_trials)
    _print_tab(tab, f"HOLDOUT {HO_START}..{HO_END}  ({len(ho_ids)} sessions)"
                    f"  N_trials={args.cumulative_trials}  [SINGLE SHOT]")
    good = _passers(tab)
    verdict = (f"OF-1 HOLDOUT @N={args.cumulative_trials}: "
               f"{len(good)}/{len(cells)} candidates confirm -> "
               f"{sorted(good['cell'].tolist())}")
    _ledger(verdict)
    print("\n" + verdict)
    print("Confirmed cells are shippable; everything else in OF-1 is a kill."
          if len(good) else
          "OF-1 class verdict: KILL. Log it and move to the next data class.")


def _ledger(line):
    with open("LEDGER.txt", "a") as f:
        f.write(f"{dt.date.today().isoformat()}  {line}\n")


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in ("cost", "download", "run-val", "run-holdout"):
        s = sub.add_parser(name)
        s.add_argument("--unlock-holdout", action="store_true")
        if name in ("cost", "download"):
            s.add_argument("--full-day", action="store_true",
                           help="ETH+RTH instead of RTH windows "
                                "(2-3x cost; harness only uses RTH)")
        if name == "download":
            s.add_argument("--confirm-purchase", action="store_true")
        if name.startswith("run"):
            s.add_argument("--cumulative-trials", type=int, required=True,
                           help="Ledger integer INCLUDING these 34 cells")
        if name == "run-val":
            s.add_argument("--with-is", action="store_true",
                           help="Also print IS table (context, heavy RAM)")
    a = ap.parse_args()
    {"cost": cmd_cost, "download": cmd_download,
     "run-val": cmd_run_val, "run-holdout": cmd_run_holdout}[a.cmd](a)


if __name__ == "__main__":
    main()

