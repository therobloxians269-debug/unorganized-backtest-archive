#!/usr/bin/env python3
"""GEXLAB M1b — MEASURE the dealer sign instead of assuming it.

Every public gamma chart assumes dealers are long call OI and short put OI. That
convention comes from an era when the dominant customer flows were covered-call
selling and protective put buying. If today's dominant flow is retail BUYING
0DTE calls and puts, the dealer is SHORT both, and the sign is backwards at
exactly the strikes that matter most.

Nobody publishes dealer inventory. But it is partially recoverable, two ways:

METHOD A — open-interest change (the real one)
  OI is the count of contracts outstanding. Compare two consecutive settlements:
      dOI > 0  contracts were OPENED at that strike
      dOI < 0  contracts were CLOSED
  Pair that with where the day's trades printed relative to the quote:
      opened + printing at the ASK -> customers bought to open -> dealer SHORT
      opened + printing at the BID -> customers sold to open   -> dealer LONG
  Needs two snapshots. Exact, and it is what M2 should eventually consume.

METHOD B — trade location only (works on one snapshot, and is WEAK)
  Uses each contract's last print versus its own bid/ask midpoint, volume
  weighted. One print is a poor summary of a whole day of flow, so treat this as
  a smoke signal, not a measurement. It is reported with its own disagreement
  rate so the noise is visible rather than hidden.

    python3 sign.py              # what can be measured from what is on disk
    python3 sign.py --oi-decay   # how much 0DTE gamma is knowable from OI at all
"""
from __future__ import annotations

import sys
from pathlib import Path

import numpy as np
import pandas as pd

import gex as G

ROOT = Path(__file__).resolve().parent


def snapshots(root: str = "QQQ", usable_only: bool = True) -> list[Path]:
    """Every snapshot on disk, oldest first.

    `usable_only` drops files that fail `gex.quality` -- CBOE serves all-zero IV
    intermittently (see reference notes), and such a file carries perfectly good
    OPEN INTEREST while being useless for pricing. That distinction matters here:
    Method A only needs OI and prints, so a zeroed-IV file is not worthless to
    this module. It is excluded anyway, because a chain we cannot price is a
    chain we cannot cross-check, and a silent half-usable input is how the
    stale-spot and charm-sign bugs both got in.
    """
    d = ROOT / "data" / "chains" / root
    live = sorted(d.glob("*.parquet")) if d.exists() else []
    h = ROOT / "data" / "hist" / root
    hist = sorted(h.glob("*.parquet")) if h.exists() else []
    fs = hist + live
    if not usable_only:
        return fs
    return [p for p in fs if G.quality(p)[0]]


# ───────────────────── which files are the same settlement ─────────────────────
# snap.py runs 4x/day but the OCC publishes open interest ONCE, overnight. So on
# a normal day three of the four files carry byte-identical OI, and "the last two
# files" is almost never "the last two settlements". Measured on the two weekend
# QQQ pulls: 9,253 contracts matched, sum|dOI| = 0.
#
# Identity is the OI vector itself, not the filename or the CBOE date stamp --
# the stamp lied about a Saturday once already, and a stale-but-restamped file
# would pass a date check while carrying the previous settlement.
CACHE = ROOT / "data" / ".settlement_cache.json"


def _cache_load() -> dict:
    try:
        import json
        return json.loads(CACHE.read_text())
    except Exception:  # noqa: BLE001 -- a missing or corrupt cache must never be fatal
        return {}


def _cache_save(c: dict) -> None:
    try:
        import json
        CACHE.parent.mkdir(parents=True, exist_ok=True)
        CACHE.write_text(json.dumps(c))
    except Exception:  # noqa: BLE001
        pass


def _oi_series(p: Path) -> pd.Series:
    d = G.load(p)
    return d.set_index(["expiry", "right", "strike"])["open_interest"]


def same_settlement(a: Path, b: Path) -> bool:
    """Do these two files carry the SAME published open interest?

    Compared only on contracts present in BOTH, which is the entire point.
    A hash of the file content does NOT work, and the failure is not academic:
    CBOE PRUNES THE CHAIN INTRADAY. Measured 2026-08-10 across one session,
    QQQ went 9,627 -> 9,187 -> 8,851 contracts while the open interest of every
    surviving contract stayed byte-identical (changed 0, sum|dOI| 0 on 9,149 and
    8,839 matched pairs). A content hash therefore reported three DIFFERENT
    settlements in a single day, which would have made Method A pair two
    intraday files and report "same settlement" tomorrow -- a false negative
    exactly when the first real measurement arrived.
    """
    try:
        sa, sb = _oi_series(a), _oi_series(b)
    except Exception:  # noqa: BLE001
        return False
    common = sa.index.intersection(sb.index)
    if len(common) < 50:
        return False
    return bool((sa.loc[common] - sb.loc[common]).abs().sum() == 0)


def settlement_runs(root: str = "QQQ") -> list[dict]:
    """Group snapshots into consecutive runs that share one settlement.

    Returns one dict per settlement, oldest first:
        files  every file carrying it, in pull order
        first  earliest file -- the freshest view of the NEW open interest, and
               the fullest contract roster before the intraday pruning starts
        last   latest file   -- carries that session's accumulated VOLUME, which
               is what the trade-location classifier needs
    """
    runs: list[dict] = []
    for p in snapshots(root):
        if runs and same_settlement(runs[-1]["files"][-1], p):
            runs[-1]["files"].append(p)
        else:
            runs.append({"files": [p]})
    for i, r in enumerate(runs):
        r["first"], r["last"] = r["files"][0], r["files"][-1]
        r["sid"] = f"S{i+1}"
    return runs


# ───────────────────────── method B: trade location ─────────────────────────
def trade_location(df: pd.DataFrame) -> pd.DataFrame:
    """Classify each contract's last print as buyer- or seller-initiated.

    Only contracts that actually traded, with a two-sided quote and a spread
    tight enough for the midpoint to mean anything.
    """
    d = df[(df["volume"] > 0) & (df["bid"] > 0) & (df["ask"] > df["bid"])].copy()
    d["mid"] = (d["bid"] + d["ask"]) / 2.0
    d["spread"] = d["ask"] - d["bid"]
    d["rel_spread"] = d["spread"] / d["mid"].clip(lower=0.01)
    d = d[d["rel_spread"] < 0.50]
    # where in the spread did the print land: 0 = at bid, 1 = at ask
    d["loc"] = ((d["last_trade_price"] - d["bid"]) / d["spread"]).clip(0, 1)
    d = d[d["loc"].notna()]
    d["initiated"] = np.where(d["loc"] > 0.6, 1.0,          # customer bought
                       np.where(d["loc"] < 0.4, -1.0, 0.0))  # customer sold / unclear
    return d


def report_location(df: pd.DataFrame) -> None:
    d = trade_location(df)
    if d.empty:
        print("no classifiable prints in this snapshot")
        return
    print(f"METHOD B — trade location (WEAK: one print per contract)")
    print(f"  classifiable contracts: {len(d):,}   "
          f"unclear (mid-market): {(d['initiated'] == 0).mean():.1%}")
    for right, name in (("C", "calls"), ("P", "puts")):
        s = d[d["right"] == right]
        if s.empty:
            continue
        vol = s["volume"].to_numpy()
        net = float((s["initiated"].to_numpy() * vol).sum())
        tot = float(vol.sum())
        share = net / tot if tot else 0.0
        verdict = "BOUGHT" if share > 0.05 else ("SOLD" if share < -0.05 else "mixed")
        print(f"  {name:>6s}: customers net {verdict:>6s}  "
              f"({share:+.1%} of {tot:,.0f} contracts of volume)")
        print(f"          -> implies dealers are "
              f"{'SHORT' if share > 0.05 else ('LONG' if share < -0.05 else 'unclear on')} {name}")
    print(f"\n  standard convention says: dealers LONG calls, SHORT puts")


# ───────────────────────── method A: open interest change ─────────────────────────
def _as_df(x) -> pd.DataFrame:
    return x if isinstance(x, pd.DataFrame) else G.load(x)


def measure_doi(a, b) -> dict:
    """Which side opened the new contracts. Accepts Paths or DataFrames.

    a  the LAST snapshot of the old settlement. Carries OI_prev, and -- the part
       that matters -- that session's accumulated volume and prints.
    b  the FIRST snapshot of the new settlement. Carries OI_new.

    THE PAIRING IS DIRECTIONAL AND EASY TO GET BACKWARDS. Open interest published
    Tuesday morning is the settled result of MONDAY's trading. The prints that
    created it are in Monday's files, not Tuesday's -- a Tuesday 09:45 snapshot
    has barely any volume yet. Reading trade location off `b` therefore explains
    Monday's OI change with Tuesday's first fifteen minutes, which is not a weak
    measurement but a meaningless one. Market data is taken from `a` throughout;
    only open interest is taken from `b`.
    """
    da, db = _as_df(a), _as_df(b)
    key = ["expiry", "right", "strike"]
    cols = key + ["volume", "bid", "ask", "last_trade_price", "open_interest"]
    m = da[cols].merge(db[key + ["open_interest"]], on=key, how="inner",
                       suffixes=("", "_new"))
    m["doi"] = m["open_interest_new"] - m["open_interest"]

    # Two FILES is not two SETTLEMENTS. Without this guard the method silently
    # reports "0 contracts" and looks like a null result instead of missing data.
    out = {"matched": len(m), "changed": int((m["doi"] != 0).sum()),
           "calls": None, "puts": None, "n_calls": 0, "n_puts": 0, "n_opened": 0}
    if out["changed"] == 0:
        out["status"] = "same_settlement"
        return out
    out["status"] = "ok"

    loc = trade_location(m)
    opened = loc[loc["doi"] > 0]
    out["n_opened"] = len(opened)
    for right, name in (("C", "calls"), ("P", "puts")):
        s = opened[opened["right"] == right]
        out[f"n_{name}"] = len(s)
        if s.empty:
            continue
        w = s["doi"].to_numpy(dtype=float)
        if w.sum() <= 0:
            continue
        out[name] = float((s["initiated"].to_numpy() * w).sum() / w.sum())
    return out


def report_doi(a: Path, b: Path) -> None:
    print(f"METHOD A — open-interest change")
    print(f"  prints/volume from : {a.name}")
    print(f"  new open interest  : {b.name}")
    r = measure_doi(a, b)
    if r["status"] == "same_settlement":
        print(f"  both files carry the SAME settlement — open interest is identical")
        print(f"  ({r['matched']:,} contracts matched, 0 changed). Not a null result: the")
        print(f"  OCC has not published a new settlement between these two snapshots.")
        print(f"  Method A needs snapshots from two different SESSIONS.")
        return
    print(f"  {r['changed']:,} of {r['matched']:,} matched contracts changed open interest")
    print(f"  contracts with OI increase and a classifiable print: {r['n_opened']:,}")
    for name in ("calls", "puts"):
        share = r[name]
        if share is None:
            print(f"  {name:>6s}: no classifiable opened contracts")
            continue
        print(f"  {name:>6s}: newly opened OI was {share:+.1%} customer-BOUGHT "
              f"-> dealers net {'SHORT' if share > 0 else 'LONG'} {name}"
              f"  (n={r['n_' + name]:,})")


# ───────────────────── how much 0DTE gamma is knowable at all ─────────────────────
def oi_decay(df: pd.DataFrame) -> None:
    """OI is settled OVERNIGHT. 0DTE positions are opened and closed inside the
    session, so a 0DTE 'gamma wall' built from OI describes yesterday's leftovers,
    not the book that is actually being hedged today. This measures how bad that
    is by comparing traded volume to standing OI by tenor."""
    print("Is 0DTE gamma knowable from open interest?")
    print(f"  {'DTE':>5} {'contracts':>10} {'volume':>12} {'OI':>12} {'vol/OI':>8}")
    for lo, hi, tag in ((0, 0, "0"), (1, 1, "1"), (2, 7, "2-7"),
                        (8, 30, "8-30"), (31, 9999, "31+")):
        s = df[(df["dte"] >= lo) & (df["dte"] <= hi)]
        if s.empty:
            continue
        v, o = s["volume"].sum(), s["open_interest"].sum()
        print(f"  {tag:>5} {len(s):>10,} {v:>12,.0f} {o:>12,.0f} {v/max(o,1):>8.2f}")
    print("\n  vol/OI far above 1 means the position is created and destroyed intraday,")
    print("  so standing OI cannot describe it. Below ~1 means OI is a fair picture.")


def placebo_doi(a, b, n: int = 500) -> None:
    """Re-price every print to a RANDOM point inside its own real spread.

    signtest.py proves the classifier is clean on synthetic quotes. This asks the
    harder question on real ones: do the actual spread widths, price levels and
    moneyness of a live chain manufacture a sign on their own? Everything is held
    fixed -- same contracts, same dOI weights, same spreads -- and only the
    location of each print inside its spread is randomised. A real flow signal
    must sit outside what this produces.
    """
    da, db = _as_df(a), _as_df(b)
    obs = measure_doi(da, db)
    if obs["status"] != "ok":
        print("placebo needs two distinct settlements")
        return
    rng = np.random.default_rng(3)
    keep = {}
    for name in ("calls", "puts"):
        keep[name] = []
    sp = (da["ask"] - da["bid"]).to_numpy()
    lo = da["bid"].to_numpy()
    for _ in range(n):
        d = da.copy()
        d["last_trade_price"] = lo + rng.uniform(0.0, 1.0, len(d)) * sp
        r = measure_doi(d, db)
        for name in ("calls", "puts"):
            if r[name] is not None:
                keep[name].append(r[name])
    print(f"PLACEBO — prints randomised inside their own spreads, {n} draws")
    for name in ("calls", "puts"):
        arr = np.array(keep[name])
        o = obs[name]
        if o is None or arr.size == 0:
            continue
        pv = float((np.abs(arr) >= abs(o)).mean())
        print(f"  {name:>6s}: observed {o:+.3f}   placebo mean {arr.mean():+.3f} "
              f"sd {arr.std():.3f}   p {pv:.3f}  "
              f"{'SEPARATES' if pv < 0.05 else 'does NOT separate'}")


def main() -> None:
    snaps = snapshots()
    if not snaps:
        raise SystemExit("no snapshots. Run:  python3 snap.py QQQ")
    df = G.load(snaps[-1])
    spot = float(df["spot"].iloc[0])
    print(f"snapshot  {snaps[-1].name}   spot {spot:.2f}   {len(df):,} live contracts\n")

    if "--oi-decay" in sys.argv:
        oi_decay(df)
        return

    if "--placebo" in sys.argv:
        runs = settlement_runs()
        if len(runs) < 2:
            raise SystemExit("placebo needs two distinct settlements")
        placebo_doi(runs[-2]["last"], runs[-1]["first"])
        return

    runs = settlement_runs()
    print(f"{len(snaps)} file(s) on disk  ->  {len(runs)} distinct settlement(s)")
    for r in runs:
        span = r["first"].name if len(r["files"]) == 1 else \
               f"{r['first'].name} .. {r['last'].name}"
        print(f"    {r['sid']}  {len(r['files'])} file(s)  {span}")
    print()

    if len(runs) >= 2:
        # last file of the old settlement (has the session's prints) paired with
        # the first file of the new one (has the freshly published OI)
        report_doi(runs[-2]["last"], runs[-1]["first"])
        print()
    else:
        print("METHOD A unavailable: only ONE settlement on disk.")
        print("  Alpha Vantage HISTORICAL_OPTIONS is a PAID endpoint (verified"
              " 2026-08-09),")
        print("  and no free source of historical per-strike OI exists. The only"
              " route is")
        print("  forward accumulation: snap.py already runs 4x/day. Open interest"
              " settles")
        print("  overnight, so the next distinct settlement appears in the FIRST"
              " pull of")
        print("  the next trading day.\n")
    report_location(df)


if __name__ == "__main__":
    main()

