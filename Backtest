"""
THE RECOIL — our own primitive.

MECHANISM (real liquidity, stated plainly):
    Price raids a pool of resting stops. Two things can be true:
      · the pool was DEFENDED — someone was sitting there and is now actively
        covering, so price is thrown back through the level almost immediately
      · the break was GENUINE — the pool simply fed the move, and price grinds
        away and never comes back
    Same level. Same direction. Opposite meaning. The only thing that separates
    them is TIME.

    tau = minutes from the raid until price trades back through the level.

WHY THIS IS NOT ANOTHER DEAD LEVEL IDEA:
    The whole kill log is LOCATION concepts, and the fill paradox kills every one
    of them as an entry (a level is the extreme BECAUSE price never returned, so
    the accuracy lives entirely in the unfillable subset). The recoil is not a
    location, it is a RESPONSE TIME. It is only defined on raids that price DID
    come back through — i.e. exactly the fillable subset. It inverts the paradox
    instead of fighting it.

    It also fixes the geometry that killed the retracement build: a fast recoil
    means the sweep extreme is only minutes away, so the stop is tight and R:R is
    large — for free, and known before entry.

CAUSALITY:
    Every pool level is fixed before the session (PDH/PDL, ONH/ONL) or at 10:30
    (IB edges). The raid is timestamped. tau is measured forward from the raid but
    is fully observed BEFORE the entry it licenses — the entry IS the reclaim.
    No feature here uses a bar later than the bar it is attached to.
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')

RTH0, RTH1 = 570, 960
IBLEN = 60

# the pools, all known causally. 'ib' becomes live only after 10:30.
POOLS = ('pdh', 'pdl', 'onh', 'onl', 'ibh', 'ibl')
UP_POOLS = ('pdh', 'onh', 'ibh')      # raided by trading ABOVE
DN_POOLS = ('pdl', 'onl', 'ibl')


def pool_levels(day, rb, dd, displace=0.0):
    """
    Level for each pool on session dd. `displace` shifts every level by that
    fraction of ADR — the displaced-level placebo. A real mechanism must die when
    the level is moved off the actual liquidity.
    """
    row = day.loc[dd]
    A = float(row.ADR)
    off = displace * A
    b = rb[dd]
    T = b['T']
    mib = T < RTH0 + IBLEN
    if mib.sum() < IBLEN * 0.8:
        return None
    ibh = float(b['H'][mib].max()); ibl = float(b['L'][mib].min())
    return {
        'pdh': float(row.prevHi) + off, 'pdl': float(row.prevLo) - off,
        'onh': float(row.onH) + off,    'onl': float(row.onL) - off,
        'ibh': ibh + off,               'ibl': ibl - off,
    }


def raids(day, rb, displace=0.0, max_tau=120, min_tau=1):
    """
    One row per (session, pool) for the FIRST raid of that pool in the session.

    Columns:
      raid_i   bar index of the raid (first bar trading beyond the level)
      ext      the extreme price reached between the raid and the reclaim
      tau      minutes from raid to reclaim; NaN if never reclaimed by the close
      reclaim_i bar index of the reclaim (the entry bar), NaN if none
    """
    rows = []
    for dd in day.index:
        b = rb.get(dd)
        if b is None:
            continue
        H, L, C, T = b['H'], b['L'], b['C'], b['T']
        A = float(day.at[dd, 'ADR'])
        lv = pool_levels(day, rb, dd, displace)
        if lv is None or not (A > 0):
            continue

        for pool in POOLS:
            lvl = lv[pool]
            up = pool in UP_POOLS
            # IB pools cannot be raided until the IB is complete
            start = int(np.searchsorted(T, RTH0 + IBLEN, side='left')) if pool.startswith('ib') else 0
            if start >= len(H) - 10:
                continue
            hit = np.flatnonzero(H[start:] > lvl) if up else np.flatnonzero(L[start:] < lvl)
            if not len(hit):
                continue
            ri = start + int(hit[0])
            if ri >= len(H) - 5:
                continue

            # reclaim: price trades back THROUGH the level, searched from ri+1
            fwd = np.flatnonzero(C[ri + 1:] < lvl) if up else np.flatnonzero(C[ri + 1:] > lvl)
            if len(fwd):
                ci = ri + 1 + int(fwd[0])
                tau = float(T[ci] - T[ri])
                ext = float(H[ri:ci + 1].max()) if up else float(L[ri:ci + 1].min())
            else:
                ci, tau = np.nan, np.nan
                ext = float(H[ri:].max()) if up else float(L[ri:].min())

            rows.append(dict(
                day=dd, pool=pool, up=up, lvl=lvl, ADR=A,
                raid_i=ri, raid_tod=int(T[ri]),
                reclaim_i=ci, reclaim_tod=(int(T[int(ci)]) if ci == ci else np.nan),
                tau=tau, ext=ext,
                pen=(ext - lvl) / A if up else (lvl - ext) / A,   # penetration depth
                reclaim_px=(float(C[int(ci)]) if ci == ci else np.nan),
                n_bars=len(H),
            ))
    r = pd.DataFrame(rows)
    if len(r):
        r['reclaimed'] = r.tau.notna()
        r['fast'] = r.reclaimed & (r.tau <= max_tau) & (r.tau >= min_tau)
    return r


def outcomes(r, day, rb, horiz=(15, 30, 60, 120), to_close=True):
    """
    Forward outcome from the RECLAIM bar (entry), in ADR units, signed so that
    positive = the reclaim continued (i.e. the raid was a trap).

    A raid above a level that is reclaimed implies a SHORT; a raid below implies
    a LONG. Measurement starts at reclaim_i+1 — never the reclaim bar itself.
    """
    out = {f'r{h}': [] for h in horiz}
    out['r_close'] = []
    out['mfe'] = []; out['mae'] = []
    for _, q in r.iterrows():
        if not q.reclaimed:
            for h in horiz:
                out[f'r{h}'].append(np.nan)
            out['r_close'].append(np.nan); out['mfe'].append(np.nan); out['mae'].append(np.nan)
            continue
        b = rb[q.day]
        H, L, C = b['H'], b['L'], b['C']
        j = int(q.reclaim_i)
        sgn = -1.0 if q.up else 1.0          # raid up -> reclaim is a short
        px = float(C[j]); A = float(q.ADR)
        for h in horiz:
            k = min(j + h, len(C) - 1)
            out[f'r{h}'].append(sgn * (float(C[k]) - px) / A)
        out['r_close'].append(sgn * (float(C[-1]) - px) / A)
        fh, fl = H[j + 1:], L[j + 1:]
        if len(fh) == 0:
            out['mfe'].append(np.nan); out['mae'].append(np.nan)
        elif q.up:
            out['mfe'].append((px - float(fl.min())) / A)
            out['mae'].append((float(fh.max()) - px) / A)
        else:
            out['mfe'].append((float(fh.max()) - px) / A)
            out['mae'].append((px - float(fl.min())) / A)
    for k, v in out.items():
        r[k] = v
    return r

