        bar   = "x" * int(cnt / n_sess * 30)
        delta = cnt - pre_vc.get(regime, 0)
        dstr  = f"  [{delta:+d} vs pre]" if delta != 0 else ""
        print(f"    {str(regime):>11}  {cnt:>4} / {n_sess}  {bar}{dstr}")

    trend_pre   = pre_vc.get(RegimeLabel.TRENDING.value, 0)
    trend_intra = intr_vc.get(RegimeLabel.TRENDING.value, 0)
    overrides   = max(trend_intra - trend_pre, 0)
    print(f"\n  Intraday TRENDING overrides: {overrides} sessions "
          f"({overrides / n_sess * 100:.1f}%)")

    # 5. Gate stats + lookahead check
    print(f"\n[5/5]  Gate Statistics & Lookahead Verification")
    print("-" * 50)

    gate_bars = df_m2["regime_gate"].sum()
    sig_bars  = df_m2["signal_eligible"].sum()
    combined  = (df_m2["signal_eligible"] & df_m2["regime_gate"]).sum()
    rth_total = rth_mask.sum()

    print(f"  RTH bars total               : {rth_total:>8,}")
    print(f"  signal_eligible (M1)         : {sig_bars:>8,}  "
          f"({sig_bars / rth_total * 100:.1f}% of RTH)")
    print(f"  regime_gate (M2)             : {gate_bars:>8,}  "
          f"({gate_bars / rth_total * 100:.1f}% of RTH)")
    print(f"  signal_eligible & regime_gate: {combined:>8,}  "
          f"({combined / rth_total * 100:.1f}% of RTH)")
    print(f"  Combined gate / session (avg): {combined / n_sess:>8.0f} bars")

    # Lookahead: atr_20s at session 20 = mean of sessions 0-19 ranges
    if n_sess >= 25:
        s20_atr = df_m2.loc[df_m2["rth_session_id"] == 20.0, "atr_20s"].iloc[0]
        manual  = np.mean([
            df_m2.loc[df_m2["rth_session_id"] == float(i), "high"].max()
            - df_m2.loc[df_m2["rth_session_id"] == float(i), "low"].min()
            for i in range(20)
        ])
        la_ok = np.isclose(s20_atr, manual, rtol=1e-5)
        print(f"\n  Lookahead verification (atr_20s @ session 20):")
        print(f"    Module 2 value   : {s20_atr:.4f}")
        print(f"    Manual mean[0-19]: {manual:.4f}")
        print(f"    Test {'PASSED' if la_ok else 'FAILED'}")

    # Schema
    print(f"\n  Output schema:")
    all_ok = True
    for col, dtype in MODULE2_OUTPUT_SCHEMA.items():
        present = col in df_m2.columns
        if not present: all_ok = False
        print(f"    {'ok' if present else 'MISSING'}  {col:<25} {dtype}")

    print(f"\n  Schema: {'ALL PRESENT' if all_ok else 'INCOMPLETE'}")
    print(f"\n{SEP}")
    print(f"  Module 2 complete.  Ready for Module 3.")
    print(f"{SEP}\n")
    return df_m2


