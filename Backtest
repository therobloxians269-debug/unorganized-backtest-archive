    maxshare = (max(yrs) / st["net_usd"]) if st["net_usd"] > 0 and yrs else float("nan")
    ok = (st["net_usd"] > 0 and st["mar"] >= 1.0 and st["trades"] >= 80
          and ny > 0 and ypos / ny >= 0.60
          and (st["net_usd"] > 0 and maxshare <= 0.50))
    return ok, ypos, ny, maxshare

def sweep(S):
