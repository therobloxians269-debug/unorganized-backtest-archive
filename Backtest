"""Growth-of-$1,000 simulation of the combined program over the most recent 2 years.

Combo = 50/50 risk-parity of (multi-asset TS trend, 16 ETFs) + (cross-sectional equity
MOMENTUM, S&P 500), each vol-targeted to ~10% annual, net of cost. Compounds $1,000 over
the trailing ~504 trading days and reports dollars, drawdown, and a monthly equity path,
with SPY buy-and-hold for reference.

    PYTHONPATH=. python3 research/sim_1k.py
"""
from __future__ import annotations

import numpy as np
import pandas as pd

from ope.trend import ETF_BASKET, ETF_COST_BP, backtest
from research.combine_edges import momentum_net

TGT, ANN, START = 0.10, 252.0, 1000.0
YEARS = 2


def main():
    import yfinance as yf
    etf = yf.download(ETF_BASKET, start="2006-01-01", auto_adjust=True, progress=False)["Close"]
    etf = etf.dropna(how="all").dropna(axis=1, thresh=int(len(etf) * 0.4))
    trend = backtest(etf, cost_bp={k: v for k, v in ETF_COST_BP.items() if k in etf.columns}).net
    mom = momentum_net(yf)

    j = pd.concat({"trend": trend, "mom": mom}, axis=1).dropna()
    scaled = j * (TGT / np.sqrt(ANN)) / j.std()
    combo = (0.5 * scaled["trend"] + 0.5 * scaled["mom"])
    combo = combo.iloc[-int(YEARS * 252):]                      # last 2 years

    eq = START * (1 + combo).cumprod()
    dd = eq / eq.cummax() - 1
    spy = yf.download("SPY", start="2006-01-01", auto_adjust=True, progress=False)["Close"].squeeze()
    spy = spy.pct_change().reindex(combo.index).fillna(0.0)
    spy_eq = START * (1 + spy).cumprod()

    yrs = (combo.index[-1] - combo.index[0]).days / 365.25
    cagr = (eq.iloc[-1] / START) ** (1 / yrs) - 1
    sharpe = combo.mean() / combo.std() * np.sqrt(ANN)
    print(f"=== GROWTH OF $1,000  ({combo.index[0].date()} -> {combo.index[-1].date()}, "
          f"{yrs:.2f}y, {len(combo)} days) ===\n")
    print(f"  ending equity      ${eq.iloc[-1]:,.2f}")
    print(f"  total return       {(eq.iloc[-1]/START-1)*100:+.1f}%   (${eq.iloc[-1]-START:+,.2f})")
    print(f"  CAGR               {cagr*100:+.1f}%/yr")
    print(f"  annualized vol     {combo.std()*np.sqrt(ANN)*100:.1f}%")
    print(f"  Sharpe (2y)        {sharpe:.2f}")
    print(f"  max drawdown       {dd.min()*100:.1f}%  (worst dip to ${eq[dd.idxmin()]:,.0f})")
    print(f"  best / worst day   ${(eq.diff().max()):+,.2f} / ${(eq.diff().min()):+,.2f}")
    print(f"  positive days      {(combo>0).mean()*100:.0f}%")
    print(f"\n  reference: $1,000 in SPY buy&hold -> ${spy_eq.iloc[-1]:,.2f} "
          f"({(spy_eq.iloc[-1]/START-1)*100:+.1f}%)")

    print("\n  month-end equity:")
    me = eq.resample("ME").last()
    mret = ((1 + combo).resample("ME").prod() - 1) * 100
    for d, v in me.items():
        print(f"    {d.strftime('%Y-%m')}   ${v:8,.2f}   ({mret.get(d, float('nan')):+5.1f}%)")


if __name__ == "__main__":
    main()

