"""Main backtest driver."""
import numpy as np
import pandas as pd
import data, ldc, structure, engine

TFS = [1, 5, 15, 60]
_cache = {}


def prep(df, tf):
    b = data.resample(df, tf)
    h = np.ascontiguousarray(b["high"].to_numpy(dtype=float))
    l = np.ascontiguousarray(b["low"].to_numpy(dtype=float))
    c = np.ascontiguousarray(b["close"].to_numpy(dtype=float))
    o = np.ascontiguousarray(b["open"].to_numpy(dtype=float))
    return b, o, h, l, c


def build(df, tf, label_mode="forward", key=""):
    ck = (key, tf, label_mode)
    if ck in _cache:
        return _cache[ck]
    b, o, h, l, c = prep(df, tf)
    m = ldc.classify(h, l, c, label_mode=label_mode)
    a = ldc.atr(h, l, c, 14)
    piv = 5
    bk = structure.breaker_signals(o, h, l, c, piv, 20, 500)
    bp = structure.bpr_signals(h, l, c, 500)
    sess = data.session_of(b.index)
    out = dict(bars=b, o=o, h=h, l=l, c=c, m=m, atr=a, bk=bk, bp=bp, sess=sess,
               piv=piv)
    _cache[ck] = out
    return out


def make_R(st, k=1.0, sess_mult=(0.75, 0.75, 1.0)):
    mult = np.array(sess_mult)[st["sess"]]
    return k * st["atr"] * mult


def signals(st, gate="breaker", shift=0.0):
    m = st["m"]
    bias_long = m["signal"] == 1
    bias_short = m["signal"] == -1
    if gate == "none":                      # LDC's own entry trigger, no structure
        return m["new_long"].copy(), m["new_short"].copy()
    if gate == "breaker":
        s = st["bk"] if shift == 0 else structure.breaker_signals(
            st["o"], st["h"], st["l"], st["c"], st["piv"], 20, 500, shift)
        bl, bs = s[0], s[1]
    elif gate == "bpr":
        bl, bs = st["bp"][0], st["bp"][1]
    elif gate == "either":
        bl = st["bk"][0] | st["bp"][0]
        bs = st["bk"][1] | st["bp"][1]
    elif gate == "struct_only":
        return st["bk"][0].copy(), st["bk"][1].copy()
    else:
        raise ValueError(gate)
    return (bl & bias_long & m["kern_bull"] & m["filt"],
            bs & bias_short & (~m["kern_bull"]) & m["filt"])


def backtest(st, gate="breaker", k=1.0, mode=engine.MODE_FULL, max_hold=None,
             cost=None, cooldown=0, shift=0.0, sym="MNQ", tf=1,
             invert=False, mask=None):
    L, S = signals(st, gate, shift)
    if invert:
        L, S = S.copy(), L.copy()
    if mask is not None:
        L = L & mask
        S = S & mask
    R = make_R(st, k)
    if max_hold is None:
        max_hold = max(30, int(240 / tf))
    if cost is None:
        cost = data.cost_points(sym)
    r = engine.run_trades(st["o"], st["h"], st["l"], st["c"], L, S, R,
                          max_hold, mode, cost, cooldown)
    return r


def split_mask(index, lo, hi):
    ts = index.tz_localize(None) if index.tz is not None else index
    return (ts >= pd.Timestamp(lo)) & (ts <= pd.Timestamp(hi))


def report(st, r, name, sym="MNQ", splits=None):
    idx = st["bars"].index
    ent = r[0]
    rr, pts = r[7], r[6]
    dpp = data.SPECS[sym]["dollars_per_point"]
    rows = [engine.stats(rr, pts, dpp, f"{name} ALL")]
    if splits:
        for sname, (lo, hi) in splits.items():
            mk = split_mask(idx, lo, hi)[ent] if len(ent) else np.zeros(0, bool)
            rows.append(engine.stats(rr[mk], pts[mk], dpp, f"{name} {sname}"))
    return rows

