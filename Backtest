import numpy as np, pandas as pd, microbt as M

df = M.load('/Users/kaveh/omni_x/es_front_2017_24h_1m.parquet', tf='5min')
ny = df.index.tz_convert('America/New_York')
mins = ny.hour*60 + ny.minute
rth = (mins >= 570) & (mins < 960)   # 09:30 .. 15:55 inclusive (last bar 15:55-16:00)
day = pd.Series(ny.date, index=df.index)

sub = df[rth].copy()
sub_day = day[rth]
posn = {t: i for i, t in enumerate(df.index)}  # timestamp -> global bar idx

# per RTH day: first bar (09:30) and last bar (15:55)
firsts, lasts = [], []
for d, grp in sub.groupby(sub_day.values):
    firsts.append((d, grp.index[0]))
    lasts.append((d, grp.index[-1]))
first_map = dict(firsts); last_map = dict(lasts)
days = sorted(first_map.keys())

o = df['open'].to_numpy(); c = df['close'].to_numpy()

def build(fade):
    trades = []
    for k in range(1, len(days)):
        d = days[k]; pd_ = days[k-1]
        ent_ts = first_map[d]; ext_ts = last_map[d]
        prior_close_ts = last_map[pd_]
        e = posn[ent_ts]; x = posn[ext_ts]
        prior_close = c[posn[prior_close_ts]]
        gap = o[e] - prior_close   # known at 09:30 open, causal
        if gap == 0: continue
        dirn = int(np.sign(gap))
        if fade: dirn = -dirn
        trades.append((e, x, dirn))
    return trades

cont = build(False); fade = build(True)
rc = M.evaluate(df, cont, name='gap-cont')
rf = M.evaluate(df, fade, name='gap-fade')
M.show(rc); M.show(rf)

# pick best IS exp
def is_exp(r): return r['IS']['exp'] if r.get('IS') else -999
best = rc if is_exp(rc) >= is_exp(rf) else rf
print('\nBEST(by IS exp):', best['name'])
yrs = (df.index[-1]-df.index[0]).days/365.25
import json
print(json.dumps({k:best[k] for k in ['name','trades','win','exp','ann','ann_pct','maxDD','calmar','skew','ann_sharpe','IS','OOS']}, default=str))
print('trades_per_yr', round(best['trades']/yrs,1))

