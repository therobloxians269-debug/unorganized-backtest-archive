    ├─ _get_zero_dte_expiry()   →  earliest expiry from options tuple
    ├─ _fetch_options_chain()   →  raw calls + puts concatenated
    ├─ _filter_strikes()        →  ±2% ATM window, auto-expands to ±5%
    ├─ _clean_and_cast()        →  dropna, type enforcement, zero-IV purge
    └─ run()                    →  orchestrator → PipelineResult

Public factory
--------------
  build_spy_0dte_snapshot() → PipelineResult
      .df_underlying          pd.DataFrame  (5-min OHLCV bars)
      .df_options_filtered    pd.DataFrame  (cleaned, typed, ATM-filtered)
      .spot_price             float
      .expiry_date            str
      .strike_window_used     float

Dependencies
------------
  pip install yfinance pandas
===============================================================================
"""

from __future__ import annotations

import logging
import sys
from dataclasses import dataclass, field
from datetime import datetime
from typing import Tuple

import pandas as pd
import yfinance as yf

# ──────────────────────────────────────────────────────────────────────────────
# Logging — structured, production-grade format
# ──────────────────────────────────────────────────────────────────────────────
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s | %(levelname)-8s | %(name)s | %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S",
    handlers=[logging.StreamHandler(sys.stdout)],
)
logger = logging.getLogger("SPY0DTEPipeline")


# ──────────────────────────────────────────────────────────────────────────────
# Configuration Constants
# ──────────────────────────────────────────────────────────────────────────────
TICKER: str             = "SPY"
INTRADAY_PERIOD: str    = "1d"        # yfinance period token for same-day bars
INTRADAY_INTERVAL: str  = "5m"        # 5-minute bar granularity
PRIMARY_WINDOW: float   = 0.02        # ±2%  ATM filter (primary)
FALLBACK_WINDOW: float  = 0.05        # ±5%  ATM filter (auto-fallback)

# Columns surfaced by yfinance option_chain(); used for display & validation
_CHAIN_DISPLAY_COLS: list[str] = [
    "option_type",
    "contractSymbol",
    "strike",
    "lastPrice",
    "bid",
    "ask",
    "volume",
    "openInterest",
    "impliedVolatility",
    "inTheMoney",
]


# ──────────────────────────────────────────────────────────────────────────────
# Return-Type Dataclass
# ──────────────────────────────────────────────────────────────────────────────
@dataclass
class PipelineResult:
    """
    Structured, immutable-ish container for a single pipeline snapshot.

    Fields
    ------
    df_underlying       : 5-minute SPY OHLCV bars for the current session.
    df_options_filtered : ATM-filtered, cleaned, typed 0DTE options chain.
    spot_price          : Most recent Close used as the live spot reference.
    expiry_date         : Earliest (0DTE) expiration date string from yfinance.
    strike_window_used  : Actual window applied after primary/fallback logic.
    timestamp           : UTC wall-clock time of pipeline execution.
    """
    df_underlying:       pd.DataFrame
    df_options_filtered: pd.DataFrame
    spot_price:          float
    expiry_date:         str
    strike_window_used:  float
    timestamp:           datetime = field(default_factory=datetime.utcnow)

    # ------------------------------------------------------------------ repr
    def __repr__(self) -> str:                              # pragma: no cover
        return (
            f"PipelineResult("
            f"spot={self.spot_price:.2f}, "
            f"expiry='{self.expiry_date}', "
            f"window=±{self.strike_window_used*100:.0f}%, "
            f"options_rows={len(self.df_options_filtered)}, "
            f"ts='{self.timestamp.strftime('%Y-%m-%d %H:%M:%S UTC')}')"
        )

    def summary(self) -> str:                               # pragma: no cover
        """Human-readable console summary block."""
        n_calls = len(self.df_options_filtered[
            self.df_options_filtered["option_type"] == "call"
        ])
        n_puts  = len(self.df_options_filtered[
            self.df_options_filtered["option_type"] == "put"
        ])
        sep = "─" * 62
        return (
            f"\n{sep}\n"
            f"  Pipeline Snapshot   {self.timestamp.strftime('%Y-%m-%d %H:%M:%S UTC')}\n"
            f"{sep}\n"
            f"  Ticker            : {TICKER}\n"
            f"  Spot Price        : ${self.spot_price:.2f}\n"
            f"  0DTE Expiry       : {self.expiry_date}\n"
            f"  Strike Window     : ±{self.strike_window_used*100:.0f}%\n"
            f"  Underlying Bars   : {len(self.df_underlying)}\n"
            f"  Options Contracts : {len(self.df_options_filtered)}"
            f"  (calls={n_calls}, puts={n_puts})\n"
            f"{sep}"
        )


# ──────────────────────────────────────────────────────────────────────────────
# Core Pipeline Class
# ──────────────────────────────────────────────────────────────────────────────
class SPY0DTEPipeline:
    """
    Production-grade intraday data ingestion pipeline for SPY 0DTE options.

    Instantiate once per session (or per scheduled tick) and call .run() to
    receive a fully validated PipelineResult.  Each internal method is
    independently unit-testable and raises descriptive RuntimeErrors on
    unrecoverable failures so upstream orchestrators can catch and alert.

    Parameters
    ----------
    ticker            : Underlying symbol (default 'SPY').
    intraday_period   : yfinance period string for history() (default '1d').
    intraday_interval : yfinance interval string for history() (default '5m').
    primary_window    : Fractional ATM strike window, first-pass (default 0.02).
    fallback_window   : Fractional ATM strike window, fallback (default 0.05).
    """

    def __init__(
        self,
        ticker: str            = TICKER,
        intraday_period: str   = INTRADAY_PERIOD,
        intraday_interval: str = INTRADAY_INTERVAL,
        primary_window: float  = PRIMARY_WINDOW,
        fallback_window: float = FALLBACK_WINDOW,
    ) -> None:
        if primary_window >= fallback_window:
            raise ValueError(
                f"primary_window ({primary_window}) must be strictly less than "
                f"fallback_window ({fallback_window})."
            )
        self.ticker_symbol     = ticker
        self.intraday_period   = intraday_period
        self.intraday_interval = intraday_interval
        self.primary_window    = primary_window
        self.fallback_window   = fallback_window
        # One yf.Ticker object reused across pipeline steps (avoids redundant init)
        self._ticker: yf.Ticker = yf.Ticker(ticker)

    # ──────────────────────────────────────────────────────────────────────────
    # Step 1 — Underlying Intraday Data
    # ──────────────────────────────────────────────────────────────────────────
    def _fetch_underlying(self) -> Tuple[pd.DataFrame, float]:
        """
        Pull live 5-minute OHLCV bars for the current session.

        Returns
        -------
        df    : Timezone-normalised (UTC) DataFrame with float64 OHLC and int64 Volume.
        spot  : Most recent Close price cast to Python float.

        Raises
        ------
        RuntimeError  if the API returns an empty frame (closed market / network fault).
        """
        logger.info(
            "Fetching underlying | ticker=%s | period=%s | interval=%s",
            self.ticker_symbol, self.intraday_period, self.intraday_interval,
        )

        df: pd.DataFrame = self._ticker.history(
            period=self.intraday_period,
            interval=self.intraday_interval,
            auto_adjust=True,
            prepost=False,      # Regular-session bars only
            repair=True,        # Auto-repair split/corporate-action artefacts
        )

        if df.empty:
            raise RuntimeError(
                f"[Step 1] Underlying history() returned empty for '{self.ticker_symbol}'. "
                "Possible causes: market closed, network unreachable, or yfinance outage."
            )

        # ── Timezone normalisation ─────────────────────────────────────────
        if df.index.tzinfo is None:
            df.index = df.index.tz_localize("UTC")
        else:
            df.index = df.index.tz_convert("UTC")
        df.index.name = "datetime_utc"

        # ── Column selection & rename to lowercase ─────────────────────────
        required_underlying = ["Open", "High", "Low", "Close", "Volume"]
        missing = [c for c in required_underlying if c not in df.columns]
        if missing:
            raise RuntimeError(
                f"[Step 1] Underlying DataFrame missing expected columns: {missing}. "
                f"Got: {list(df.columns)}"
            )
        df = df[required_underlying].rename(columns=str.lower).copy()

        # ── Enforce strict dtypes ──────────────────────────────────────────
        df = df.astype({
            "open"  : "float64",
            "high"  : "float64",
            "low"   : "float64",
            "close" : "float64",
            "volume": "int64",
        })
        df.dropna(subset=["close"], inplace=True)

        if df.empty:
            raise RuntimeError(
                "[Step 1] All rows dropped after NaN purge on 'close'. "
                "Data is unusable — aborting pipeline."
            )

        spot_price: float = float(df["close"].iloc[-1])
        logger.info(
            "Spot extracted: $%.4f | bars loaded: %d | last bar: %s",
            spot_price, len(df), df.index[-1],
        )
        return df, spot_price

    # ──────────────────────────────────────────────────────────────────────────
    # Step 2 — 0DTE Expiry Extraction
    # ──────────────────────────────────────────────────────────────────────────
    def _get_zero_dte_expiry(self) -> str:
        """
        Retrieve the SPY options expiration tuple and return the earliest date.

        Handles the edge case where `.options` returns an empty tuple
        (market holiday, pre-market API state, transient 429/503 responses).

        Returns
        -------
        expiry : str  e.g. '2025-06-20'

        Raises
        ------
        ValueError   if the options tuple is empty.
        RuntimeError if the yfinance call itself errors out.
        """
        logger.info("Querying options expirations for '%s'...", self.ticker_symbol)
        try:
            expirations: tuple[str, ...] = self._ticker.options  # type: ignore[assignment]
        except Exception as exc:
            raise RuntimeError(
                f"[Step 2] yfinance .options attribute raised an exception for "
                f"'{self.ticker_symbol}': {exc}"
            ) from exc

        # ── Guard: empty tuple ─────────────────────────────────────────────
        if not expirations:
            raise ValueError(
                f"[Step 2] options tuple for '{self.ticker_symbol}' is empty. "
                "This typically occurs on non-trading days, during pre-market before "
                "the chain is published, or during a yfinance API outage. "
                "Retry during regular trading hours (09:30–16:00 ET)."
            )

        earliest: str = expirations[0]
        logger.info(
            "0DTE expiry selected: '%s' | total expirations available: %d",
            earliest, len(expirations),
        )
        return earliest

    # ──────────────────────────────────────────────────────────────────────────
    # Step 3 — Raw Options Chain Download
    # ──────────────────────────────────────────────────────────────────────────
    def _fetch_options_chain(self, expiry: str) -> pd.DataFrame:
        """
        Download the full call + put surface for *expiry*, tag each leg
        with an `option_type` column ('call' / 'put'), and return a
        single concatenated DataFrame.

        Raises
        ------
        RuntimeError  if the API call fails or both legs are empty.
        """
        logger.info("Downloading option chain | expiry=%s", expiry)
        try:
            chain = self._ticker.option_chain(expiry)
        except Exception as exc:
            raise RuntimeError(
                f"[Step 3] option_chain() failed for expiry '{expiry}': {exc}"
            ) from exc

        calls: pd.DataFrame = chain.calls.copy()
        puts:  pd.DataFrame = chain.puts.copy()

        if calls.empty and puts.empty:
            raise RuntimeError(
                f"[Step 3] Both calls and puts are empty for expiry '{expiry}'. "
                "Chain may not yet be published or liquidity is zero."
            )

        calls["option_type"] = "call"
        puts["option_type"]  = "put"

        df_chain: pd.DataFrame = pd.concat(
            [calls, puts], axis=0, ignore_index=True
        )
        logger.info(
            "Raw chain loaded: %d rows (calls=%d, puts=%d)",
            len(df_chain), len(calls), len(puts),
        )
        return df_chain

    # ──────────────────────────────────────────────────────────────────────────
    # Step 4 — Adaptive ATM Strike Filter
    # ──────────────────────────────────────────────────────────────────────────
    def _filter_strikes(
        self,
        df_chain: pd.DataFrame,
        spot:     float,
    ) -> Tuple[pd.DataFrame, float]:
        """
        Retain only contracts whose strike falls within ±primary_window of spot.
        If that slice is empty, automatically expand to ±fallback_window.

        Parameters
        ----------
        df_chain : Full unfiltered options chain (calls + puts).
        spot     : Live underlying price used as the ATM anchor.

        Returns
        -------
        filtered      : Subset DataFrame of near-the-money contracts.
        window_used   : The fractional window that was actually applied.

        Raises
        ------
        RuntimeError  if even the fallback window yields zero contracts.
        """
        def _window_slice(df: pd.DataFrame, pct: float) -> pd.DataFrame:
            lo = spot * (1.0 - pct)
            hi = spot * (1.0 + pct)
            mask = (df["strike"] >= lo) & (df["strike"] <= hi)
            logger.debug(
                "Strike window ±%.0f%%: lo=%.2f hi=%.2f → %d rows",
                pct * 100, lo, hi, mask.sum(),
            )
            return df.loc[mask].copy()

        # ── Primary attempt ────────────────────────────────────────────────
        logger.info(
            "Applying primary strike filter: spot=$%.4f ±%.0f%%",
            spot, self.primary_window * 100,
        )
        filtered: pd.DataFrame = _window_slice(df_chain, self.primary_window)

        if not filtered.empty:
            logger.info(
                "Primary filter succeeded: %d contracts retained",
                len(filtered),
            )
            return filtered, self.primary_window

        # ── Fallback ───────────────────────────────────────────────────────
        logger.warning(
            "[Step 4] Primary ±%.0f%% filter returned 0 contracts. "
            "Auto-expanding to fallback ±%.0f%%.",
            self.primary_window * 100,
            self.fallback_window * 100,
        )
        filtered = _window_slice(df_chain, self.fallback_window)

        if filtered.empty:
            raise RuntimeError(
                f"[Step 4] Fallback ±{self.fallback_window*100:.0f}% strike filter "
                "also returned 0 contracts. The options chain is severely illiquid "
                "or the strike axis does not bracket the current spot price. "
                "Investigate the raw chain before retrying."
            )

        logger.info(
            "Fallback filter succeeded: %d contracts retained (±%.0f%%)",
            len(filtered), self.fallback_window * 100,
        )
        return filtered, self.fallback_window

    # ──────────────────────────────────────────────────────────────────────────
    # Step 5 — Type Casting & Data Cleaning
    # ──────────────────────────────────────────────────────────────────────────
    @staticmethod
    def _clean_and_cast(df: pd.DataFrame) -> pd.DataFrame:
        """
        Enforce a strict, analysis-ready schema on the filtered options chain.

        Operations (in order)
        ─────────────────────
        1. Drop rows where 'volume' or 'impliedVolatility' is NaN.
        2. Cast 'strike'            → float64
           Cast 'impliedVolatility' → float64
           Cast 'volume'            → int64
        3. Coerce auxiliary numerics (lastPrice, bid, ask, openInterest) → float64.
        4. Purge contracts with impliedVolatility == 0.0 (stale / untradeable).
        5. Sort by option_type ascending, then strike ascending.
        6. Reset index for clean downstream indexing.

        Returns
        -------
        Cleaned, typed DataFrame ready for strategy consumption.

        Raises
        ------
        RuntimeError if the frame is fully empty after cleaning.
        """
        n_raw: int = len(df)
        logger.info("Cleaning options DataFrame | rows pre-clean: %d", n_raw)

        # ── 1. Drop rows missing critical fields ───────────────────────────
        df = df.dropna(subset=["volume", "impliedVolatility"]).copy()
        n_after_dropna: int = len(df)
        if n_raw > n_after_dropna:
            logger.info(
                "Dropped %d rows with NaN volume or impliedVolatility",
                n_raw - n_after_dropna,
            )

        # ── 2. Strict type casting — mandatory fields ──────────────────────
        df["strike"]            = df["strike"].astype("float64")
        df["impliedVolatility"] = df["impliedVolatility"].astype("float64")
        # volume arrives as float64 from yfinance (may have been .0 decimals).
        # Safe to cast to int64 after NaN removal.
        df["volume"]            = df["volume"].astype("float64").astype("int64")

        # ── 3. Coerce auxiliary numerics defensively ───────────────────────
        _aux_cols: list[str] = ["lastPrice", "bid", "ask", "openInterest"]
        for col in _aux_cols:
            if col in df.columns:
                df[col] = pd.to_numeric(df[col], errors="coerce").astype("float64")

        # ── 4. Purge zero-IV contracts (never tradeable at market) ─────────
        n_before_iv: int = len(df)
        df = df[df["impliedVolatility"] > 0.0].copy()
        n_purged: int = n_before_iv - len(df)
        if n_purged:
            logger.info("Purged %d zero-IV (stale/untradeable) contracts", n_purged)

        if df.empty:
            raise RuntimeError(
                "[Step 5] DataFrame is completely empty after cleaning. "
                "No tradeable contracts remain in the ATM window."
            )

        # ── 5–6. Sort and reindex ──────────────────────────────────────────
        df = (
            df
            .sort_values(["option_type", "strike"], ascending=[True, True])
            .reset_index(drop=True)
        )

        logger.info(
            "Clean DataFrame ready | rows: %d | dtypes: strike=%s, iv=%s, vol=%s",
            len(df),
            df["strike"].dtype,
            df["impliedVolatility"].dtype,
            df["volume"].dtype,
        )
        return df

    # ──────────────────────────────────────────────────────────────────────────
    # Orchestrator
    # ──────────────────────────────────────────────────────────────────────────
    def run(self) -> PipelineResult:
        """
        Execute all five pipeline stages in sequence and return a PipelineResult.

        Fail-fast on any unrecoverable stage; each exception carries a
        '[Step N]' prefix for easy triage in log aggregators.

        Returns
        -------
        PipelineResult
            .df_underlying        — 5-min SPY OHLCV (UTC-indexed)
            .df_options_filtered  — ATM-filtered, typed 0DTE options chain
            .spot_price           — float, used as ATM anchor
            .expiry_date          — str, earliest expiry ('YYYY-MM-DD')
            .strike_window_used   — float, fractional window that was applied
        """
        divider = "─" * 62
        logger.info(divider)
        logger.info(
            "SPY 0DTE Pipeline | run started: %s UTC",
            datetime.utcnow().strftime("%Y-%m-%d %H:%M:%S"),
        )
        logger.info(divider)

        # Step 1 — Underlying
        df_underlying, spot_price = self._fetch_underlying()

        # Step 2 — 0DTE expiry
        expiry_date: str = self._get_zero_dte_expiry()

        # Step 3 — Raw options chain
        df_chain: pd.DataFrame = self._fetch_options_chain(expiry_date)

        # Step 4 — ATM strike filter (primary → fallback)
        df_filtered, window_used = self._filter_strikes(df_chain, spot_price)

        # Step 5 — Clean & cast
        df_options_filtered: pd.DataFrame = self._clean_and_cast(df_filtered)

        result = PipelineResult(
            df_underlying=df_underlying,
            df_options_filtered=df_options_filtered,
            spot_price=spot_price,
            expiry_date=expiry_date,
            strike_window_used=window_used,
        )
        logger.info(result.summary())
        return result


# ──────────────────────────────────────────────────────────────────────────────
# Public Factory Function
# ──────────────────────────────────────────────────────────────────────────────
def build_spy_0dte_snapshot(
    ticker: str            = TICKER,
    primary_window: float  = PRIMARY_WINDOW,
    fallback_window: float = FALLBACK_WINDOW,
) -> PipelineResult:
    """
    Convenience factory — instantiates SPY0DTEPipeline and executes run().

    Example
    -------
    >>> result = build_spy_0dte_snapshot()
    >>> df_underlying       = result.df_underlying
    >>> df_options_filtered = result.df_options_filtered
    """
    pipeline = SPY0DTEPipeline(
        ticker=ticker,
        primary_window=primary_window,
        fallback_window=fallback_window,
    )
    return pipeline.run()


# ──────────────────────────────────────────────────────────────────────────────
# CLI Entry Point
# ──────────────────────────────────────────────────────────────────────────────
if __name__ == "__main__":
    try:
        result = build_spy_0dte_snapshot()

        # ── Underlying preview ─────────────────────────────────────────────
        print("\n╔══════════════════════════════════════════╗")
        print("║   df_underlying  —  last 5 bars          ║")
        print("╚══════════════════════════════════════════╝")
        print(result.df_underlying.tail().to_string())

        # ── Options preview ────────────────────────────────────────────────
        print("\n╔══════════════════════════════════════════╗")
        print("║   df_options_filtered  —  all contracts  ║")
        print("╚══════════════════════════════════════════╝")
        display_cols = [c for c in _CHAIN_DISPLAY_COLS if c in result.df_options_filtered.columns]
        print(result.df_options_filtered[display_cols].to_string(index=False))

        # ── Schema validation ──────────────────────────────────────────────
        print("\n╔══════════════════════════════════════════╗")
        print("║   df_options_filtered  —  dtypes          ║")
        print("╚══════════════════════════════════════════╝")
        print(result.df_options_filtered.dtypes.to_string())

    except Exception as fatal:
        logger.critical(
            "Pipeline terminated with unrecoverable error: %s",
            fatal,
            exc_info=True,
        )
        sys.exit(1)

