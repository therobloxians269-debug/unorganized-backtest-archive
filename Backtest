#!/usr/bin/env python3
"""
github_devhealth.py — friction-adjusted backtest of a "developer-health" signal on L1 tokens.

Hypothesis (Option A): a blockchain's open-source developer health leads its token's
forward return. When a project's issue resolution decays (backlog grows, fixes get
slower, fewer issues closed), the token underperforms; when dev-health improves, it
outperforms. We test it cross-sectionally, dollar-neutral, net of trading friction.

Data (all free, works locally):
  - dev-health : GitHub REST issues API (one paginated sweep per repo -> opened/closed/
                 latency/backlog monthly series). Cached to disk. Set GITHUB_TOKEN for
                 5000 req/hr (unauthenticated = 60/hr, only enough for a small proof run).
  - prices     : Yahoo Finance via yfinance ("<SYM>-USD" daily -> monthly returns).

Honesty rails baked in:
  - net-of-cost is the headline (turnover-based friction at 0/10/25/50 bps one-way)
  - IC reported with Newey-West (HAC) t-stat on the monthly IC series
  - in-sample / out-of-sample split (first half / second half)
  - deflated-Sharpe haircut for the number of signal variants tried
  - dollar-neutral long/short so common crypto beta is removed

Usage:
  python3 github_devhealth.py --proof                 # ~5 repos, no token needed
  GITHUB_TOKEN=ghp_xxx python3 github_devhealth.py    # full universe
"""
from __future__ import annotations
import argparse, json, os, sys, time, math
from datetime import datetime, timezone, timedelta
from pathlib import Path

import numpy as np
import pandas as pd
import requests

CACHE = Path(__file__).resolve().parent / "cache"
CACHE.mkdir(exist_ok=True)

# sym -> (github repo "owner/name", yahoo ticker). One flagship repo per chain.
UNIVERSE = {
    "ETH":  ("ethereum/go-ethereum",          "ETH-USD"),
    "SOL":  ("solana-labs/solana",            "SOL-USD"),
    "AVAX": ("ava-labs/avalanchego",          "AVAX-USD"),
    "ADA":  ("IntersectMBO/cardano-node",     "ADA-USD"),
    "DOT":  ("paritytech/polkadot-sdk",       "DOT-USD"),
    "ATOM": ("cosmos/cosmos-sdk",             "ATOM-USD"),
    "NEAR": ("near/nearcore",                 "NEAR-USD"),
    "ALGO": ("algorand/go-algorand",          "ALGO-USD"),
    "FTM":  ("Fantom-foundation/go-opera",    "FTM-USD"),
    "TRX":  ("tronprotocol/java-tron",        "TRX-USD"),
    "XTZ":  ("tezos/tezos",                   "XTZ-USD"),
    "EGLD": ("multiversx/mx-chain-go",        "EGLD-USD"),
    "ONE":  ("harmony-one/harmony",           "ONE-USD"),
    "CELO": ("celo-org/celo-monorepo",        "CELO-USD"),
    "FIL":  ("filecoin-project/lotus",        "FIL-USD"),
    "INJ":  ("InjectiveLabs/injective",       "INJ-USD"),
    "SEI":  ("sei-protocol/sei-chain",        "SEI-USD"),
    "SUI":  ("MystenLabs/sui",                "SUI-USD"),
    "APT":  ("aptos-labs/aptos-core",         "APT-USD"),
    "TIA":  ("celestiaorg/celestia-node",     "TIA-USD"),
    "KAVA": ("Kava-Labs/kava",                "KAVA-USD"),
    "OSMO": ("osmosis-labs/osmosis",          "OSMO-USD"),
    "KSM":  ("paritytech/substrate",          "KSM-USD"),
    "ROSE": ("oasisprotocol/oasis-core",      "ROSE-USD"),
}

PROOF_SYMS = ["ATOM", "NEAR", "KAVA", "INJ", "OSMO"]  # small-enough repos for a 60-call budget

BUG_LABELS = {"bug", "type:bug", "kind/bug", "c-bug", "t-bug", "security",
              "type:security", "vulnerability", "critical", "p0", "priority:critical"}


# ----------------------------------------------------------------------------- GitHub
def gh_headers():
    h = {"Accept": "application/vnd.github+json", "User-Agent": "alpha-lab-devhealth"}
    tok = os.environ.get("GITHUB_TOKEN")
    if tok:
        h["Authorization"] = f"Bearer {tok}"
    return h


def fetch_issues(repo: str, since: datetime, max_pages: int = 60):
    """All issues (not PRs) created on/after `since`. Cached per repo+since to disk."""
    key = CACHE / f"gh_{repo.replace('/', '_')}_{since.date()}.json"
    if key.exists():
        return json.loads(key.read_text())

    out, page = [], 1
    sess = requests.Session()
    while page <= max_pages:
        url = (f"https://api.github.com/repos/{repo}/issues"
               f"?state=all&sort=created&direction=desc&per_page=100&page={page}")
        r = sess.get(url, headers=gh_headers(), timeout=30)
        if r.status_code == 403 and "rate limit" in r.text.lower():
            reset = int(r.headers.get("X-RateLimit-Reset", time.time() + 3600))
            wait = max(0, reset - int(time.time())) + 2
            print(f"  ! rate-limited on {repo}; reset in {wait}s "
                  f"({wait//60}m). Stopping pull (need GITHUB_TOKEN to go further).")
            break
        if r.status_code != 200:
            print(f"  ! {repo} HTTP {r.status_code}: {r.text[:120]}")
            break
        batch = r.json()
        if not batch:
            break
        stop = False
        for it in batch:
            if "pull_request" in it:          # GitHub returns PRs in /issues; drop them
                continue
            created = it["created_at"]
            created_dt = datetime.fromisoformat(created.replace("Z", "+00:00")).replace(tzinfo=None)
            if created_dt < since:
                stop = True
                break
            out.append({
                "created_at": created,
                "closed_at": it.get("closed_at"),
                "labels": [l["name"].lower() for l in it.get("labels", [])],
            })
        rem = r.headers.get("X-RateLimit-Remaining")
        if stop:
            break
        page += 1
        if rem is not None and int(rem) <= 1:
            print(f"  ! {repo}: 1 GitHub request left; stopping (set GITHUB_TOKEN to finish).")
            break
        time.sleep(0.4)

    key.write_text(json.dumps(out))
    print(f"  {repo:38s} {len(out):6d} issues  (pages={page})")
    return out


def devhealth_panels(syms, since: datetime, max_pages: int):
    """Return dict of monthly metric DataFrames (index=month-end, cols=sym)."""
    res_ratio, latency, backlog_chg, bug_share = {}, {}, {}, {}
    for s in syms:
        repo = UNIVERSE[s][0]
        issues = fetch_issues(repo, since, max_pages)
        if not issues:
            continue
        df = pd.DataFrame(issues)
        df["created"] = pd.to_datetime(df["created_at"]).dt.tz_localize(None)
        df["closed"] = pd.to_datetime(df["closed_at"]).dt.tz_localize(None)
        df["is_bug"] = df["labels"].apply(lambda L: any(b in BUG_LABELS for b in L))
        df["ttc_days"] = (df["closed"] - df["created"]).dt.total_seconds() / 86400.0

        opened = df.set_index("created").resample("ME").size()
        closed = df.dropna(subset=["closed"]).set_index("closed").resample("ME").size()
        opened, closed = opened.align(closed, fill_value=0)
        rr = closed / (opened + 1.0)                       # resolution ratio (>1 healthy)
        bl = (opened - closed).cumsum()                    # open-issue backlog proxy
        # median time-to-close for issues *closed* that month
        med_ttc = (df.dropna(subset=["closed"]).set_index("closed")["ttc_days"]
                     .resample("ME").median())
        bug = df.set_index("created")["is_bug"].resample("ME").mean()

        res_ratio[s] = rr
        latency[s] = med_ttc
        backlog_chg[s] = bl
        bug_share[s] = bug

    def frame(d):
        return pd.DataFrame(d).sort_index()

    return {
        "resolution_ratio": frame(res_ratio),
        "fix_latency_days": frame(latency),
        "backlog_level": frame(backlog_chg),
        "bug_share": frame(bug_share),
    }


# ----------------------------------------------------------------------------- prices
def monthly_returns(syms, start: datetime):
    import yfinance as yf
    tickers = [UNIVERSE[s][1] for s in syms]
    px = yf.download(tickers, start=start.strftime("%Y-%m-%d"),
                     interval="1d", progress=False, auto_adjust=True)["Close"]
    if isinstance(px, pd.Series):
        px = px.to_frame()
    inv = {UNIVERSE[s][1]: s for s in syms}
    px = px.rename(columns=inv)
    m = px.resample("ME").last()
    return m.pct_change()


# ----------------------------------------------------------------------------- stats
def newey_west_tstat(x: pd.Series, lags: int = 3):
    x = x.dropna().values
    n = len(x)
    if n < 8:
        return np.nan
    mu = x.mean()
    e = x - mu
    g0 = (e @ e) / n
    var = g0
    for k in range(1, lags + 1):
        w = 1 - k / (lags + 1)
        gk = (e[k:] @ e[:-k]) / n
        var += 2 * w * gk
    se = math.sqrt(var / n)
    return mu / se if se > 0 else np.nan


def spearman_ic(sig: pd.Series, ret: pd.Series):
    d = pd.concat([sig, ret], axis=1).dropna()
    if len(d) < 4:
        return np.nan
    return d.iloc[:, 0].rank().corr(d.iloc[:, 1].rank())


def deflate_sharpe(sr: float, n_obs: int, n_trials: int):
    """Approx deflated Sharpe: prob the true SR>0 after trying n_trials variants."""
    if not np.isfinite(sr) or n_obs < 8:
        return np.nan
    # expected max of n_trials standard-normal Sharpes (per-period), scaled back
    from scipy.stats import norm
    emax = (1 - np.euler_gamma) * norm.ppf(1 - 1.0 / n_trials) + \
           np.euler_gamma * norm.ppf(1 - 1.0 / (n_trials * math.e))
    sr_p = sr / math.sqrt(12)                      # de-annualize (monthly)
    se = math.sqrt((1 + 0.5 * sr_p ** 2) / (n_obs - 1))
    z = (sr_p - emax * se) / se
    return float(norm.cdf(z))


# ----------------------------------------------------------------------------- backtest
def evaluate(signal: pd.DataFrame, fwd: pd.DataFrame, name: str,
             higher_is_bullish: bool, n_trials: int, costs=(0, 10, 25, 50)):
    """Cross-sectional dollar-neutral long/short. signal_t -> fwd return_{t}."""
    sig = signal.copy()
    if not higher_is_bullish:
        sig = -sig
    idx = sig.index.intersection(fwd.index)
    sig, fwd = sig.loc[idx], fwd.loc[idx]

    # cross-sectional IC each month
    ics = pd.Series({t: spearman_ic(sig.loc[t], fwd.loc[t]) for t in idx}).dropna()

    # dollar-neutral weights: demeaned cross-sectional rank, scaled to gross leverage 1
    w = sig.rank(axis=1) - sig.rank(axis=1).mean(axis=1).values.reshape(-1, 1)
    w = w.div(w.abs().sum(axis=1), axis=0).fillna(0.0)
    gross = (w * fwd).sum(axis=1)                      # this-month pnl from last weights? align below
    # weights formed at t from signal_t predict return over the SAME labeled fwd row,
    # where fwd is already the forward (next-period) return, so no extra shift needed.
    turnover = w.diff().abs().sum(axis=1).fillna(w.abs().sum(axis=1))

    rows = []
    for c in costs:
        net = gross - turnover * (c / 10000.0)
        net = net.dropna()
        if len(net) < 8:
            sr = np.nan
        else:
            sr = net.mean() / net.std() * math.sqrt(12) if net.std() > 0 else np.nan
        rows.append((c, sr, net))

    # IS / OOS split on the net@25bps series
    net_by_cost = {c: net for c, sr, net in rows}
    base = net_by_cost.get(25, pd.Series(dtype=float)).dropna()
    half = len(base) // 2
    is_sr = base.iloc[:half].mean() / base.iloc[:half].std() * math.sqrt(12) if half >= 8 and base.iloc[:half].std() > 0 else np.nan
    oos_sr = base.iloc[half:].mean() / base.iloc[half:].std() * math.sqrt(12) if (len(base) - half) >= 8 and base.iloc[half:].std() > 0 else np.nan

    gross_sr = gross.dropna().mean() / gross.dropna().std() * math.sqrt(12) if gross.dropna().std() > 0 else np.nan
    dsr = deflate_sharpe(dict([(c, s) for c, s, _ in rows]).get(25, np.nan), len(base), n_trials)

    return {
        "name": name, "n_months": len(idx), "mean_ic": ics.mean(),
        "ic_t": newey_west_tstat(ics), "ic_hitrate": (ics > 0).mean(),
        "turnover": turnover.mean(),
        "sr_by_cost": {c: s for c, s, _ in rows},
        "gross_sr": gross_sr, "is_sr": is_sr, "oos_sr": oos_sr, "dsr_25": dsr,
    }


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--proof", action="store_true", help="small repo subset, no token needed")
    ap.add_argument("--months", type=int, default=42)
    ap.add_argument("--max-pages", type=int, default=60)
    ap.add_argument("--repos", type=str, default="")
    args = ap.parse_args()

    syms = (args.repos.split(",") if args.repos
            else PROOF_SYMS if args.proof else list(UNIVERSE))
    if args.proof and args.max_pages == 60:
        args.max_pages = 10  # keep proof under the 60-call unauth budget

    since = datetime.now(timezone.utc).replace(tzinfo=None) - timedelta(days=30 * args.months)
    print(f"\nUniverse ({len(syms)}): {', '.join(syms)}")
    print(f"History since {since.date()}   token={'yes' if os.environ.get('GITHUB_TOKEN') else 'NO (rate-limited)'}\n")

    print("Pulling GitHub issues ...")
    panels = devhealth_panels(syms, since, args.max_pages)

    print("\nPulling prices (yfinance) ...")
    have = [s for s in syms if any(s in p.columns for p in panels.values())]
    rets = monthly_returns(have, since)
    fwd = rets.shift(-1)                                  # forward 1-month return (label aligned to t)

    # signal variants: (panel, transform, higher_is_bullish)
    variants = []
    rr = panels["resolution_ratio"]
    variants.append(("resolution_ratio_level", rr, True))
    variants.append(("resolution_ratio_chg3", rr - rr.rolling(3).mean(), True))
    lat = panels["fix_latency_days"]
    variants.append(("fix_latency_level", lat, False))       # slower fixes = bearish
    variants.append(("fix_latency_chg3", lat - lat.rolling(3).mean(), False))
    bl = panels["backlog_level"]
    variants.append(("backlog_growth3", bl.diff(3), False))  # growing backlog = bearish
    n_trials = len(variants)

    results = []
    for nm, sigdf, bull in variants:
        sigdf = sigdf.reindex(columns=fwd.columns)
        results.append(evaluate(sigdf, fwd, nm, bull, n_trials))

    # ---- report
    print("\n" + "=" * 92)
    print("DEVELOPER-HEALTH SIGNAL — friction-adjusted cross-sectional long/short")
    print("=" * 92)
    hdr = f"{'signal':24s}{'mo':>4s}{'IC':>7s}{'IC_t':>6s}{'hit':>6s}{'turn':>6s}" \
          f"{'SR_0':>7s}{'SR_25':>7s}{'SR_50':>7s}{'OOS25':>7s}{'DSR':>6s}"
    print(hdr); print("-" * len(hdr))
    for r in results:
        sc = r["sr_by_cost"]
        print(f"{r['name']:24s}{r['n_months']:>4d}{r['mean_ic']:>7.3f}{r['ic_t']:>6.2f}"
              f"{r['ic_hitrate']:>6.0%}{r['turnover']:>6.2f}"
              f"{sc.get(0, float('nan')):>7.2f}{sc.get(25, float('nan')):>7.2f}"
              f"{sc.get(50, float('nan')):>7.2f}{r['oos_sr']:>7.2f}{r['dsr_25']:>6.2f}")
    print("-" * len(hdr))
    print("IC=mean monthly rank-corr  IC_t=Newey-West t  hit=% months IC>0  turn=avg turnover")
    print("SR_x=annualized net Sharpe at x bps one-way  OOS25=out-of-sample SR@25bps  DSR=deflated-Sharpe p(SR>0)")
    print("\nBar to take seriously: IC_t>2, OOS25 clearly>0, DSR>0.90. Otherwise it's noise.\n")


if __name__ == "__main__":
    main()

