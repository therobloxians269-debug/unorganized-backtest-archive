#!/usr/bin/env python3
"""
composite.py -- Multi-Premium Regime Allocator backtest, anti-overfit workflow.

CRITICAL ORDER (do NOT skip):
  1. Test each INGREDIENT's edge alone (OOS IC). Keep only survivors.
  2. Fuse survivors -> mu_t. Size with vol-target + sqrt-impact + no-trade band.
  3. Score with DEFLATED Sharpe, penalizing the trial/parameter count.

Ingredients (each a real source; fusion is the new part):
  overnight  : close->open premium            (testable TODAY on ES 1-min)
  vrp        : variance risk premium budget   (needs VIX/RV)
  gex        : dealer-gamma regime switch     (needs options OI)
  xasset     : cross-asset risk-on gate       (needs VIX term struct + bond fut)
"""
from __future__ import annotations
import numpy as np, polars as pl, math
from scipy.stats import norm, spearmanr

# ---------------------------------------------------------------------------
# SESSION (daily) BARS from intraday ES 1-min  -> O/H/L/C per session
# ---------------------------------------------------------------------------
def session_bars(intraday: pl.DataFrame) -> pl.DataFrame:
    """intraday cols: [ts_event(ns), price]. Returns daily O,H,L,C, prev_C."""
    day = (intraday["ts_event"] // (86_400 * 1_000_000_000)).alias("day")
    df = intraday.with_columns(day)
    bars = (df.group_by("day", maintain_order=True)
              .agg(O=pl.col("price").first(), H=pl.col("price").max(),
                   L=pl.col("price").min(), C=pl.col("price").last())
              .sort("day"))
    return bars.with_columns(prevC=pl.col("C").shift(1))

# ---------------------------------------------------------------------------
# INGREDIENTS  (each returns a standardized signal aligned to bars)
# ---------------------------------------------------------------------------
def _z(x, w=60):
    x = np.asarray(x, float); out = np.full_like(x, np.nan)
    for k in range(len(x)):
        h = x[max(0,k-w):k]
        if len(h) >= 10 and np.nanstd(h) > 0:
            out[k] = (x[k] - np.nanmean(h)) / np.nanstd(h)
    return np.nan_to_num(out)

def ing_overnight(bars: pl.DataFrame) -> np.ndarray:
    """Overnight premium predictor. r_on = ln(O_t/C_{t-1}); condition the long-into-close
       view on prior INTRADAY weakness (overreaction reverses overnight) + vol regime."""
    O, C, pc = bars["O"].to_numpy(), bars["C"].to_numpy(), bars["prevC"].to_numpy()
    r_id = np.log(C / O)                     # intraday return, day t
    r_id_prev = np.roll(r_id, 1); r_id_prev[0] = 0
    # signal available at close of t, predicting r_on of t+1: lean long after weak intraday
    sig = -_z(r_id_prev)                     # weak prior intraday -> stronger overnight
    return sig

def ing_vrp(bars, vix=None, rv=None):
    """Variance risk premium budget. Pi = (IV - RV_forecast). INTERFACE: pass VIX & RV."""
    if vix is None: return None
    Pi = np.asarray(vix, float) - np.asarray(rv, float)
    return _z(Pi)

def ing_gex(bars, net_gex=None):
    """Dealer-gamma regime. >0 long-gamma (revert), <0 short-gamma (trend). INTERFACE."""
    if net_gex is None: return None
    return np.sign(np.asarray(net_gex, float))

def ing_xasset(bars, vix_slope=None, bond_sig=None):
    """Cross-asset risk-on gate in [0,1]. INTERFACE: VIX term slope + bond move."""
    if vix_slope is None: return None
    z = np.asarray(vix_slope, float) + (np.asarray(bond_sig, float) if bond_sig is not None else 0)
    return 1.0 / (1.0 + np.exp(-_z(z)))      # logistic gate

# ---------------------------------------------------------------------------
# STEP 1: per-ingredient IC gate  (keep only survivors)
# ---------------------------------------------------------------------------
def ic_gate(signal, bars, horizon=1, train_frac=0.6, name=""):
    """OOS Spearman IC of signal vs forward overnight+next return. Survivor if
       p_test<0.05, sign-stable train->test, |IC|>0.01."""
    C, O = bars["C"].to_numpy(), bars["O"].to_numpy()
    fwd = np.full(len(C), np.nan)
    fwd[:-horizon] = np.log(C[horizon:] / C[:-horizon])   # forward h-session return
    s, y = np.asarray(signal,float), fwd
    m = np.isfinite(s) & np.isfinite(y); cut = int(len(C)*train_frac)
    tr = m.copy(); tr[cut:] = False; te = m.copy(); te[:cut] = False
    if tr.sum()<30 or te.sum()<30: return False, np.nan, np.nan
    ic_tr = spearmanr(s[tr], y[tr]).correlation
    r = spearmanr(s[te], y[te]); ic_te, p = r.correlation, r.pvalue
    survive = (p<0.05) and (np.sign(ic_te)==np.sign(ic_tr)) and abs(ic_te)>0.01
    print(f"  [{name:<9}] IC_train={ic_tr:+.4f}  IC_test={ic_te:+.4f}  p={p:.4f}  "
          f"N={te.sum()}  {'KEEP' if survive else 'cut'}")
    return survive, ic_te, ic_tr

# ---------------------------------------------------------------------------
# STEP 2: fuse survivors -> mu_t, then size (vol-target + sqrt-impact + band)
# ---------------------------------------------------------------------------
def fuse_and_size(bars, ings: dict, *, gamma=2e-4, eta=0.1, c=2.6, vol_W=20,
                  lam_lo=0.5, lam_hi=2.0, phi=0.5, mult=5.0, q_max=50.0):
    """ings: {'overnight':sig, 'gex':regime, 'vrp':z, 'xasset':gate}. Missing -> neutral.
       Frictionless MV target, sqrt-impact shrink, no-trade band on the $ cost hurdle.
       NOTE: mu here is a z-score; we scale it to a $ edge via sigma. On real data this
       scaling is the calibrated g from the harness, not a proxy."""
    C = bars["C"].to_numpy(); n = len(C)
    r = np.log(C / np.roll(C, 1)); r[0] = 0.0
    sigma = np.array([mult*np.std(np.diff(C[max(0,k-vol_W):k])) if k > 2 else np.nan for k in range(n)])
    med = np.nanmedian(sigma[np.isfinite(sigma)]) if np.any(np.isfinite(sigma)) else mult*0.25
    sigma = np.nan_to_num(sigma, nan=med); sigma[sigma <= 0] = mult*0.25

    on  = ings.get('overnight', np.zeros(n)).astype(float)
    gex = ings.get('gex'); vrp = ings.get('vrp'); xg = ings.get('xasset')

    mu = on.copy()
    if gex is not None:                          # regime tilt only if GEX survived
        mom, rev = _z(r), -_z(r)
        mu = on + np.where(gex < 0, 0.5*mom, 0.0) + np.where(gex > 0, 0.5*rev, 0.0)
    lam = np.clip(1 + phi*(vrp if vrp is not None else 0.0), lam_lo, lam_hi)
    lam = np.full(n, float(lam)) if np.ndim(lam) == 0 else lam
    gate = xg if xg is not None else np.ones(n)

    omega_star  = gate * lam * mu / (gamma * sigma**2)   # gated, budget-scaled MV target
    edge_dollar = np.abs(mu) * sigma                     # rough $ edge/contract (calib g on real data)

    pos = np.zeros(n); q = 0.0
    for k in range(n):
        if edge_dollar[k] > c:                            # no-trade band: clear round-trip cost
            a, b = gamma*sigma[k]**2, 1.5*eta*sigma[k]    # sqrt-impact shrink toward target
            u = (-b + math.sqrt(b*b + 4*a*max(edge_dollar[k]-c, 0.0)))/(2*a) if a > 0 else 0.0
            q = float(np.clip(np.sign(omega_star[k]) * min(abs(omega_star[k]), u*u), -q_max, q_max))
        pos[k] = q
    return pos, sigma, mu


# ---------------------------------------------------------------------------
# STEP 3: PnL (one session round-trip) + metrics + DEFLATED Sharpe
# ---------------------------------------------------------------------------
def deflated_sharpe(sr, n_trials, n_obs, skew, kurt):
    if n_obs<10 or n_trials<1: return float('nan')
    emax=(1-np.euler_gamma)*norm.ppf(1-1/n_trials)+np.euler_gamma*norm.ppf(1-1/(n_trials*math.e))
    sr0=emax/math.sqrt(n_obs); den=math.sqrt(max(1e-12,1-skew*sr+(kurt-1)/4*sr**2))
    return float(norm.cdf((sr-sr0)*math.sqrt(n_obs-1)/den))

def backtest_composite(bars, pos, sigma, *, c=2.6, mult=5.0, n_trials=10, train_frac=0.6):
    C=bars["C"].to_numpy(); r=np.diff(C, prepend=C[0])
    cut=int(len(C)*train_frac)
    held=pos; dq=np.diff(held, prepend=0.0)
    gross=np.zeros(len(C)); cost=np.abs(dq)*c            # round-trip cost per contract
    for k in range(1,len(C)): gross[k]=held[k-1]*r[k]*mult
    pnl=(gross-cost)[cut:]                                # OOS only
    from scipy.stats import skew as sk, kurtosis as ku
    eq=np.cumsum(pnl); dd=(eq-np.maximum.accumulate(eq)).min() if len(eq) else 0
    mu_,sd_=(pnl.mean(),pnl.std(ddof=1)) if len(pnl)>1 else (0,1)
    sharpe=mu_/sd_*math.sqrt(252) if sd_>0 else 0
    dsr=deflated_sharpe(mu_/sd_ if sd_>0 else 0, n_trials, len(pnl),
                        float(sk(pnl)) if len(pnl)>2 else 0, float(ku(pnl,fisher=False)) if len(pnl)>2 else 3)
    print(f"\n[OOS] sessions={len(pnl)}  netPnL=${eq[-1] if len(eq) else 0:.0f}  "
          f"Sharpe={sharpe:.2f}  maxDD=${dd:.0f}  DSR={dsr:.2f}  "
          f"turnover={np.abs(np.diff(pos,prepend=0)).sum():.0f}")
    return dict(sharpe=sharpe, dsr=dsr, pnl=eq[-1] if len(eq) else 0)

# ---------------------------------------------------------------------------
# SMOKE: synthetic daily data with a planted overnight effect
# ---------------------------------------------------------------------------
def synth_daily(seed=0, n=1500):
    rng=np.random.default_rng(seed); rows=[]; C=5000.0; day0=20000
    prev_id=0.0
    for d in range(n):
        on = 0.0007 - 0.4*prev_id + rng.normal(0,0.004)   # overnight: drift, reverses prior intraday
        O = C*math.exp(on)
        idr = rng.normal(0,0.008); Cn=O*math.exp(idr)
        H=max(O,Cn)*1.002; L=min(O,Cn)*0.998
        # store as intraday-ish: emit open and close ticks for the day
        ts_o=(day0+d)*86_400*1_000_000_000
        rows.append((ts_o,O)); rows.append((ts_o+3600*1_000_000_000,Cn))
        prev_id=idr; C=Cn
    return pl.DataFrame(rows, schema=["ts_event","price"], orient="row")

if __name__=="__main__":
    print("=== COMPOSITE SMOKE: ingredient-first workflow (synthetic) ===")
    intraday=synth_daily()
    bars=session_bars(intraday)
    print(f"sessions={bars.height}")
    print("\nSTEP 1 - test each ingredient ALONE (keep survivors):")
    on=ing_overnight(bars)
    keep_on,_,_=ic_gate(on, bars, name="overnight")
    # vrp/gex/xasset would be tested here once you supply their data
    ings={}
    if keep_on: ings['overnight']=on
    print("\nSTEP 2+3 - fuse survivors, size, score:")
    if ings:
        pos,sigma,mu=fuse_and_size(bars, ings)
        backtest_composite(bars, pos, sigma, n_trials=4)
    else:
        print("  no ingredient survived -> nothing to fuse. Correct behavior.")

