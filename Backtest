#!/usr/bin/env python3
"""GEXLAB M4 — TWO rejection blocks. One bullish, one bearish. That is all.

The ten-level map is a picture of the book. This is a trade plan: one zone where
a long limit rests, one where a short limit rests, each with entry, stop, target
and R:R, or an explicit "no trade today".

WHAT IS COMBINED, AND WHY EACH PART IS THERE
--------------------------------------------
OPTIONS FLOW decides WHERE and WHETHER:
  · the block is anchored on a POSITIVE dealer-gamma concentration -- that is the
    fade mechanism itself. At a long-gamma strike the desk must buy dips and sell
    rallies to stay hedged, so its own flow pushes price back into the zone.
  · negative-gamma strikes are excluded outright. Hedging there runs WITH the
    move and takes the limit out. Same location, opposite trade.
  · the whole book must be net long gamma or neither block is offered: fading is
    incoherent when the aggregate desk is amplifying.

TWO TENORS, DELIBERATELY, because they fail in opposite directions:
  · REGIME comes from the 8-30D bucket, where vol/OI ~ 0.08 so open interest
    genuinely describes the book -- but the gamma kernel there is +-1900 NQ pts,
    far too broad to locate anything.
  · LOCATION comes from the 0-1D bucket, where the kernel is +-100-350 pts and a
    zone is physically meaningful -- but vol/OI ~ 7.75, so standing OI is the
    least reliable it ever gets.
  Neither tenor can do both jobs. Using each for the thing it is good at is the
  only honest way to combine them, and the residual risk is stated on the chart
  rather than hidden.

OUR OWN CONCEPTS decide the GEOMETRY:
  · WIDTH is measured as the full-width-half-maximum of the actual gamma peak,
    not the strike interval. The listing grid is 10 pts; the mechanism is
    hundreds. Drawing 10 is inventing ~190x the resolution the data carries.
  · ENTRY is the CE-50% of the block, not its edge. Third independent
    confirmation in this program that the midpoint beats the extreme.
  · STOP sits beyond the FAR edge: a fade is dead once price is through the zone.
  · R:R >= 2 gate. The only filter that has survived every test here, and it is
    known before entry so it costs nothing.

    python3 blocks.py            # today's two blocks
    python3 blocks.py --pine     # the one-line row for GEX_Blocks.pine
"""
from __future__ import annotations

import sys

import numpy as np
import pandas as pd

import gex as G

SHARP = (0, 1)        # locating bucket: kernel is tight enough to mean something
REGIME = (8, 30)      # regime bucket: OI is actually descriptive here
MIN_RR = 2.0
STOP_BUF = 0.25       # extra stop beyond the far edge, in block half-widths
MIN_SHARE = 0.15      # a block must carry >=15% of the book's largest peak
MAX_REACH = 0.60      # target must sit within 0.60 x ADR of entry, or it is fiction
STOP_ATR = 1.0        # stop floor in 5m ATR(14) of NQ


def nq_atr(tf: str = "5min", n: int = 14) -> float:
    """MEDIAN ATR(14) on NQ 5m from the bars touch.py already stores.

    Without a floor the R:R is fiction. The zone-derived stop came out 14.4 NQ
    points on the first build while the 5m ATR was ~42: a stop four times inside
    the noise, producing 3.48R that price would take out on an ordinary wiggle.
    R:R can be set to any value by tightening the stop, so the stop must be the
    LARGER of the structural distance and a volatility floor -- the same rule the
    ten-level map already enforces.

    The MEDIAN, not the last reading, and that matters more than it looks. The
    last value swings with WHEN the script happens to run: 42.3 during the 10:19
    selloff, 18.7 fifteen minutes after the close the same day. These levels
    govern the NEXT session, so the floor must describe typical conditions rather
    than whichever minute the cron fired. A stop that changes because the job ran
    at 16:10 instead of 10:19 is the same class of bug as the chart-timeframe ATR
    that once made one setup score 19.92R on 1m and 1.94R on 1h.
    """
    try:
        px = pd.read_parquet(G.ROOT / "data" / "px" / "nq_1m.parquet")
    except Exception:  # noqa: BLE001
        return float("nan")
    b = px.resample(tf).agg(high=("high", "max"), low=("low", "min"),
                            close=("close", "last")).dropna()
    if len(b) < n + 1:
        return float("nan")
    tr = pd.concat([b.high - b.low, (b.high - b.close.shift()).abs(),
                    (b.low - b.close.shift()).abs()], axis=1).max(axis=1)
    return float(tr.rolling(n).mean().median())


def daily_atr(n: int = 14) -> float:
    """ADR(14) on NQ daily bars, for the reachability gate."""
    try:
        px = pd.read_parquet(G.ROOT / "data" / "px" / "nq_1m.parquet")
    except Exception:  # noqa: BLE001
        return float("nan")
    b = px.resample("1D").agg(high=("high", "max"), low=("low", "min"),
                              close=("close", "last")).dropna()
    if len(b) < 3:
        return 663.0                     # documented NQ ADR fallback; too few days stored
    tr = pd.concat([b.high - b.low, (b.high - b.close.shift()).abs(),
                    (b.low - b.close.shift()).abs()], axis=1).max(axis=1)
    v = tr.rolling(min(n, len(tr))).mean().iloc[-1]
    return float(v) if np.isfinite(v) else 663.0


def peaks(prof: pd.DataFrame) -> list[dict]:
    """Every distinct positive-gamma concentration, with its measured FWHM.

    Peaks must be found ONCE and shared, because the target is "the next
    concentration", not "the next strike". Scanning strike-by-strike returns a
    point on the SAME peak -- the first build did exactly that and produced a
    bull target of 29712 sitting inside its own 29682-29717 block, an 0.8-1.4R
    setup that was really a zero-width trade against itself.

    A peak must also clear its own neighbourhood by a real margin (PROM), or
    every ripple on the smoothed profile registers as separate structure.
    """
    PROM = 0.20                       # must exceed neighbours by 20% to be its own peak
    ks = prof.sort_values("strike").reset_index(drop=True)
    g = ks.gex.to_numpy()
    k = ks.strike.to_numpy()
    out = []
    for i in range(1, len(g) - 1):
        if g[i] <= 0 or not (g[i] >= g[i - 1] and g[i] >= g[i + 1]):
            continue
        lo_j = hi_j = i
        while lo_j > 0 and g[lo_j - 1] < g[lo_j]:
            lo_j -= 1
        while hi_j < len(g) - 1 and g[hi_j + 1] < g[hi_j]:
            hi_j += 1
        base = max(g[lo_j], g[hi_j], 0.0)
        if g[i] <= base * (1.0 + PROM):
            continue
        half = g[i] / 2.0
        lo_e = hi_e = k[i]
        for q in range(i, -1, -1):
            if g[q] < half:
                lo_e = k[q]; break
        for q in range(i, len(g)):
            if g[q] < half:
                hi_e = k[q]; break
        out.append({"strike": float(k[i]), "gex": float(g[i]),
                    "lo": float(lo_e), "hi": float(hi_e)})
    return sorted(out, key=lambda x: x["strike"])


def build(root: str = "_NDX"):
    path = G.latest_snapshot(root, verbose=False)
    df = G.load(path)
    spot = float(df["spot"].iloc[0])
    asof = str(pd.Timestamp(df["snap_ts"].iloc[0]))
    ratio = G.carry_ratio("NQ=F", root)
    if isinstance(ratio, tuple):
        ratio = ratio[0]

    reg = df[(df.dte >= REGIME[0]) & (df.dte <= REGIME[1])]
    shp = df[(df.dte >= SHARP[0]) & (df.dte <= SHARP[1])]
    if len(reg) < 50 or len(shp) < 30:
        raise SystemExit(f"thin chain: regime {len(reg)}, sharp {len(shp)}")

    net_reg = float(G.profile(reg, spot)["gex"].sum()) / 1e9
    flip = G.gamma_flip(reg, spot)
    prof = G.profile(shp, spot)
    prof["gex"] = prof["gex"] / 1e9

    # how reliable is the locating bucket today -- reported, never hidden
    vol_oi = float(shp.volume.sum()) / max(float(shp.open_interest.sum()), 1)
    iv = float(shp.iv.median())
    dte = float(max(shp.dte.min(), 0.5))
    kernel = spot * iv * np.sqrt(dte / 365.25)

    out = {"asof": asof, "spot": spot, "ratio": ratio, "net_reg": net_reg,
           "flip": flip, "vol_oi": vol_oi, "kernel": kernel, "long_gamma": net_reg > 0}

    pks = peaks(prof)
    out["n_peaks"] = len(pks)
    if not pks:
        out["bull"] = out["bear"] = out["pin"] = None
        return out
    atr_nq = nq_atr()
    atr_idx = atr_nq / ratio if np.isfinite(atr_nq) and ratio else float("nan")
    adr_idx = (daily_atr() / ratio) if ratio else float("nan")
    out["atr_nq"], out["adr_nq"] = atr_nq, daily_atr()

    # THE PIN IS THE TARGET, NOT A BLOCK -- this is the correction that matters.
    # In a LONG-gamma book the largest concentration is an ATTRACTOR: the desk
    # sells rallies and buys dips into it, so price is drawn TOWARD it. Anchoring
    # a fade ON it is backwards, and the first build did exactly that -- it put
    # the bearish block on the strongest peak, which WAS the pin, giving a target
    # distance of literally zero. The trade the mechanism actually implies is:
    # enter where hedging supports you, away from the pin, and let the hedging
    # drag price back to the pin.
    pin = max(pks, key=lambda x: x["gex"])
    out["pin"] = pin["strike"]
    biggest = pin["gex"]

    for side in ("bull", "bear"):
        # the block must sit on the correct side of BOTH price and the pin: below
        # both for a long, above both for a short. A "bullish" block above the pin
        # would be betting price walks away from the magnet.
        cand = [p for p in pks
                if (p["strike"] < min(spot, pin["strike"]) if side == "bull"
                    else p["strike"] > max(spot, pin["strike"]))]
        if not cand:
            out[side] = None
            continue
        pk = max(cand, key=lambda x: x["gex"])
        share = pk["gex"] / biggest if biggest > 0 else 0.0
        half = max((pk["hi"] - pk["lo"]) / 2.0, G.strike_step(df, spot))
        entry = (pk["lo"] + pk["hi"]) / 2.0               # CE-50% of the zone
        target = pin["strike"]
        if side == "bull":
            struct = pk["lo"] - STOP_BUF * half
            stop = min(struct, entry - atr_idx) if np.isfinite(atr_idx) else struct
        else:
            struct = pk["hi"] + STOP_BUF * half
            stop = max(struct, entry + atr_idx) if np.isfinite(atr_idx) else struct
        risk = abs(entry - stop)
        rr = abs(target - entry) / risk if risk > 0 else np.nan
        # REACHABILITY, and it is not optional. A target far enough away inflates
        # R:R without adding expectancy: the ICT stack tested this morning drew to
        # a structural HTF level a median 22.8R away and won 0.0% of 118 trades,
        # stopped out first EVERY time at every horizon out to 15 days.
        reach = abs(target - entry) / adr_idx if np.isfinite(adr_idx) else np.nan
        out[side] = {"lo": pk["lo"], "hi": pk["hi"], "entry": entry, "stop": stop,
                     "target": target, "rr": rr, "gex": pk["gex"], "half": half,
                     "share": share, "thin": share < MIN_SHARE,
                     "reach": reach, "far": np.isfinite(reach) and reach > MAX_REACH}
    return out


def to_nq(x, r):
    return x * r if x is not None and np.isfinite(x) else np.nan


def show(b) -> None:
    r = b["ratio"]
    px = G.futures_spot("NQ=F")
    print(f"\nas-of {b['asof']}   _NDX {b['spot']:.2f}   NQ {px if px else float('nan'):.2f}")
    print(f"PIN (draw): {to_nq(b['pin'], r):.1f}   — long gamma pulls price TOWARD this, "
          f"so it is the TARGET, never a block")
    print(f"regime (8-30D, reliable OI): net {b['net_reg']:+.2f}bn/1%  "
          f"{'LONG gamma — fades are coherent' if b['long_gamma'] else 'SHORT gamma — NO BLOCKS OFFERED'}")
    print(f"locating bucket (0-1D): kernel +/-{to_nq(b['kernel'], r):.0f} NQ pts   "
          f"vol/OI {b['vol_oi']:.2f} "
          f"({'OI is stale vs today’s flow — treat as provisional' if b['vol_oi'] > 3 else 'OI is reasonably descriptive'})")
    print()
    for side, name in (("bull", "BULLISH BLOCK  (long limit)"),
                       ("bear", "BEARISH BLOCK  (short limit)")):
        d = b[side]
        print(f"  {name}")
        if d is None:
            print("    no positive-gamma concentration on this side\n"); continue
        ok = (b["long_gamma"] and np.isfinite(d["rr"]) and d["rr"] >= MIN_RR
              and not d["thin"] and not d["far"])
        risk = abs(to_nq(d["entry"], r) - to_nq(d["stop"], r))
        print(f"    zone    {to_nq(d['lo'], r):>9.1f} .. {to_nq(d['hi'], r):<9.1f}"
              f"  ({to_nq(d['hi'] - d['lo'], r):.0f} NQ pts wide, measured FWHM)")
        print(f"    entry   {to_nq(d['entry'], r):>9.1f}   (CE-50%)")
        print(f"    stop    {to_nq(d['stop'], r):>9.1f}   ({risk:.0f} pts risk"
              f"{', ATR-floored' if risk > 1.01 * abs(to_nq(d['entry'], r) - to_nq(d['lo'] - STOP_BUF * d['half'] if side == 'bull' else d['hi'] + STOP_BUF * d['half'], r)) else ''})")
        print(f"    target  {to_nq(d['target'], r):>9.1f}")
        why = ("PASSES" if ok else
               ("FAILS — target is " + format(d['reach'], '.2f') + "x ADR away; R:R is inflated, not real" if d['far'] else
                ("FAILS — peak is only " + format(d['share'], '.0%') + " of the book, not a concentration" if d['thin'] else
                 "FAILS the 2R gate — no trade")))
        print(f"    R:R     {d['rr']:>9.2f}   {why}")
        print(f"    reach   {d['reach']:>9.2f} x ADR to target")
        print(f"    gamma   {d['gex']:>9.3f} bn  ({d['share']:.0%} of the largest peak)\n")
    print("  Geometry only. No win rate has been measured for any of this.")


def pine_row(b) -> str:
    """date,spot,netgex,flip,kernel,volOI, then bull(lo,hi,entry,stop,target,rr),
    then bear(...). Everything already converted to NQ."""
    r = b["ratio"]
    f = [G.applies_to(b["asof"]), f"{to_nq(b['spot'], r):.2f}", f"{b['net_reg']:.2f}",
         f"{to_nq(b['flip'], r):.2f}" if b["flip"] else "na",
         f"{to_nq(b['kernel'], r):.1f}", f"{b['vol_oi']:.2f}",
         f"{to_nq(b['pin'], r):.2f}" if b.get("pin") else "na"]
    for side in ("bull", "bear"):
        d = b[side]
        if d is None:
            f += ["na"] * 6
        else:
            f += [f"{to_nq(d['lo'], r):.2f}", f"{to_nq(d['hi'], r):.2f}",
                  f"{to_nq(d['entry'], r):.2f}", f"{to_nq(d['stop'], r):.2f}",
                  f"{to_nq(d['target'], r):.2f}",
                  f"{d['rr']:.2f}" if np.isfinite(d["rr"]) else "na"]
    return ",".join(f)


if __name__ == "__main__":
    b = build("_NDX")
    if "--pine" in sys.argv:
        print(pine_row(b))
    else:
        show(b)
        print(f"  pine row:\n  {pine_row(b)}")

