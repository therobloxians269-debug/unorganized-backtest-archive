        # ---- opening range block (knowable at anchor + or_min)
        if with_or:
            e = p + or_min          # OR block reads bars [p, e) only -- never bar e
            if e > len(c): rows.append(None); continue
            if (idx[e - 1] - ts).total_seconds() > (or_min + 5) * 60: rows.append(None); continue
            orh = h[p:e].max(); orl = l[p:e].min(); orr = orh - orl
            f["or_rng"] = orr / atr_d
            f["or_er"] = abs(c[e - 1] - o[p]) / orr if orr > 0 else np.nan
            f["or_pos"] = (c[e - 1] - orl) / orr if orr > 0 else np.nan
            orv = v[p:e].sum()
            povs = []
            for j in range(1, 11):
                kk = k - j + 1
                if kk < 1 or kk >= len(tab): break
                pp = int(tab["open_pos"].values[kk])
                povs.append(v[pp:pp + or_min].sum())
            f["or_vol"] = orv / np.mean(povs) if povs else np.nan
            f["or_vs_on"] = orr / onr if onr > 0 else np.nan
            f["or_vs_pd"] = orr / drng[k] if drng[k] > 0 else np.nan
        rows.append(f)
    cols = FEAT_CORE + (FEAT_OR if with_or else [])
    out = pd.DataFrame([r if r is not None else {c_: np.nan for c_ in cols} for r in rows],
                       columns=cols)
    out["valid"] = [r is not None for r in rows]
    return out


# ----------------------------------------------------------------------------
# session set assembly
# ----------------------------------------------------------------------------
def build_dataset(df, P, tab, or_min=30, contaminated=False):
    """One row per RTH session. Two label windows, two anchors."""
    n = len(df)
    op = tab["open_pos"].values; cp = tab["close_pos"].values
    ts_open = pd.DatetimeIndex(tab["open_ts"])
    # anchor A = 09:30 ; anchor B = 09:30 + or_min
    posA = op.astype(int)
    posB = posA + or_min
    ok = posB < n
    fa = build_features(df, P, tab, posA, ts_open, with_or=False, contaminated=contaminated)
    fb = build_features(df, P, tab, posA, ts_open, with_or=True, or_min=or_min,
                        contaminated=contaminated)
    lab_full = []; lab_post = []; rng_full = []
    for i in range(len(tab)):
        e = int(cp[i])
        erA, rgA = label_window(df, int(posA[i]), e)
        lab_full.append(erA); rng_full.append(rgA)
        if ok[i] and posB[i] < e:
            erB, _ = label_window(df, int(posB[i]), e)
        else:
            erB = np.nan
        lab_post.append(erB)
    ds = pd.DataFrame({
        "date": tab["open_ts"].dt.date.values,
        "open_ts": ts_open, "posA": posA, "posB": posB, "close_pos": cp,
        "er_full": lab_full, "er_post": lab_post, "rng_full": rng_full,
    })
    for c_ in FEAT_CORE: ds["A_" + c_] = fa[c_].values
    ds["A_valid"] = fa["valid"].values
    for c_ in FEAT_CORE + FEAT_OR: ds["B_" + c_] = fb[c_].values
    ds["B_valid"] = fb["valid"].values
    ds["ts"] = pd.DatetimeIndex(ds["open_ts"])
    return ds


def regime(er, hi=0.6, lo=0.3):
    r = pd.Series(np.where(er > hi, "TREND", np.where(er < lo, "RANGE", "MIXED")),
                  index=er.index)
    return r.mask(er.isna())


# ----------------------------------------------------------------------------
# model evaluation
# ----------------------------------------------------------------------------
def fit_eval(Xis, yis, sets, seed=0, label=""):
    med = Xis.median()
    def prep(X): return X.fillna(med).replace([np.inf, -np.inf], np.nan).fillna(med).values
    mu = Xis.fillna(med).mean().values; sd = Xis.fillna(med).std().replace(0, 1).values
    Zis = (prep(Xis) - mu) / sd
    lr = LogisticRegression(C=0.3, max_iter=2000)
    lr.fit(Zis, yis)
    gb = HistGradientBoostingClassifier(max_depth=3, max_iter=150, learning_rate=0.05,
                                        min_samples_leaf=25, l2_regularization=1.0,
                                        random_state=seed)
    gb.fit(prep(Xis), yis)
    out = {}
    for name, (X, y) in sets.items():
        if len(y) < 30 or y.nunique() < 2:
            out[name] = dict(n=len(y), auc_lr=np.nan, auc_gb=np.nan)
            continue
        Z = (prep(X) - mu) / sd
        p_lr = lr.predict_proba(Z)[:, 1]
        p_gb = gb.predict_proba(prep(X))[:, 1]
        out[name] = dict(n=int(len(y)), base=float(y.mean()),
                         auc_lr=float(roc_auc_score(y, p_lr)),
                         auc_gb=float(roc_auc_score(y, p_gb)),
                         br_lr=float(brier_score_loss(y, p_lr)),
                         br_gb=float(brier_score_loss(y, p_gb)),
                         p_lr=p_lr, p_gb=p_gb, y=y.values)
    # IS cross-validated AUC (honest in-sample estimate)
    tss = TimeSeriesSplit(n_splits=5)
    cv_lr = []; cv_gb = []
    Xv = prep(Xis)
    for tr, te in tss.split(Xv):
        if yis.iloc[tr].nunique() < 2 or yis.iloc[te].nunique() < 2: continue
        m1 = LogisticRegression(C=0.3, max_iter=2000).fit((Xv[tr] - mu) / sd, yis.iloc[tr])
        cv_lr.append(roc_auc_score(yis.iloc[te], m1.predict_proba((Xv[te] - mu) / sd)[:, 1]))
        m2 = HistGradientBoostingClassifier(max_depth=3, max_iter=150, learning_rate=0.05,
                                            min_samples_leaf=25, l2_regularization=1.0,
                                            random_state=seed).fit(Xv[tr], yis.iloc[tr])
        cv_gb.append(roc_auc_score(yis.iloc[te], m2.predict_proba(Xv[te])[:, 1]))
    out["_cv"] = dict(auc_lr=float(np.mean(cv_lr)) if cv_lr else np.nan,
                      auc_gb=float(np.mean(cv_gb)) if cv_gb else np.nan)
    out["_models"] = (lr, gb, mu, sd, med, prep)
    return out


def calib_table(p, y, nb=5):
    q = pd.qcut(pd.Series(p), nb, labels=False, duplicates="drop")
    d = pd.DataFrame({"p": p, "y": y, "q": q}).groupby("q").agg(
        n=("y", "size"), pred=("p", "mean"), act=("y", "mean"))
    return d


# ----------------------------------------------------------------------------
# trade simulator (for the economic routing test)
# ----------------------------------------------------------------------------
def sim_trade(df, entry_pos, direction, R0, last_pos, pv, comm, slip=0.25):
    """Enter at open of entry_pos. Stop R0 against, target 1.5*R0.
       Stop assumed filled first if both touched in a bar. Time exit at last_pos."""
    o = df["o"].values; h = df["h"].values; l = df["l"].values; c = df["c"].values
    if entry_pos > last_pos or entry_pos >= len(o): return None
    e = o[entry_pos] + direction * slip                      # adverse entry slip
    stop = e - direction * R0
    targ = e + direction * 1.5 * R0
    exit_px = None; hit = "time"
    for j in range(entry_pos, last_pos + 1):
        if direction == 1:
            if l[j] <= stop: exit_px = stop - slip; hit = "stop"; break
            if h[j] >= targ: exit_px = targ; hit = "targ"; break
        else:
            if h[j] >= stop: exit_px = stop + slip; hit = "stop"; break
            if l[j] <= targ: exit_px = targ; hit = "targ"; break
    if exit_px is None: exit_px = c[last_pos]
    pts = direction * (exit_px - e)
    usd = pts * pv - comm
    return dict(R=usd / (R0 * pv), usd=usd, pts=pts, hit=hit, entry_pos=entry_pos)


def playbooks(df, ds, tab, pv, comm, or_min=30, k_risk=0.25, ext_mult=1.5):
    """TREND = first break of the 09:30-10:00 opening range.
       MR    = first 1.5*R0 extension from the 09:30 open, faded."""
    o = df["o"].values; h = df["h"].values; l = df["l"].values; c = df["c"].values
    idx = df.index
    drng = tab["rng"].values; dclose = tab["close_pos"].values
    rows = []
    for i, r in ds.iterrows():
        pA = int(r.posA); pB = int(r.posB); cp = int(r.close_pos)
        k = int(np.searchsorted(dclose, pA - 1, side="right")) - 1
        if k < 21: continue
        atr_d = np.nanmean(drng[k - 19:k + 1])
        if not np.isfinite(atr_d) or atr_d <= 0: continue
        R0 = float(np.clip(k_risk * atr_d, 10.0, 150.0))
        # flat by 16:59 -> last usable bar
        day_end = min(cp, len(c) - 2)
        orh = h[pA:pB].max(); orl = l[pA:pB].min()
        # ---- TREND: first OR break after 10:00
        tr = None
        for j in range(pB, day_end):
            if h[j] > orh: tr = sim_trade(df, j + 1, 1, R0, day_end, pv, comm); break
            if l[j] < orl: tr = sim_trade(df, j + 1, -1, R0, day_end, pv, comm); break
        # ---- MR: first ext_mult*R0 extension from session open, faded
        so = o[pA]; mr = None
        for j in range(pB, day_end):
            if c[j] - so >= ext_mult * R0:
                mr = sim_trade(df, j + 1, -1, R0, day_end, pv, comm); break
            if so - c[j] >= ext_mult * R0:
                mr = sim_trade(df, j + 1, 1, R0, day_end, pv, comm); break
        rows.append(dict(i=i, date=r.date, R0=R0,
                         trend_R=tr["R"] if tr else np.nan,
                         trend_usd=tr["usd"] if tr else np.nan,
                         trend_pos=tr["entry_pos"] if tr else np.nan,
                         trend_dir=np.sign(tr["pts"]) * 0 + (1 if tr and tr["pts"] >= 0 else 0) if tr else np.nan,
                         mr_R=mr["R"] if mr else np.nan,
                         mr_usd=mr["usd"] if mr else np.nan,
                         mr_pos=mr["entry_pos"] if mr else np.nan,
                         day_end=day_end))
    return pd.DataFrame(rows).set_index("i")


def maxdd(series):
    eq = np.cumsum(series)
    return float(np.max(np.maximum.accumulate(np.concatenate([[0.0], eq])) -
                        np.concatenate([[0.0], eq])))


