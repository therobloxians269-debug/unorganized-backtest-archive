"""
FAMILY: qt-open-drift
Quarterly-Theory true-open DRIFT / FADE / AMD-cascade on NQ (IS 2023-24, OOS1 2025) and MNQ (OOS2 2026).

Sub-families tested:
  (A) DRIFT   : direction of the first N minutes after a true open (TDO/TSO/TMSO) -> continuation or fade
  (B) FADE    : price extends X*ATR from the true open -> fade back toward the true open
  (C) AMD     : manipulation leg of quarter k predicts the distribution leg of quarter k+1
  (D) RAID    : quarter k+1 sweeps quarter k's extreme -> reverse

Rules honoured:
  * entry ALWAYS at next-bar open after the signal bar closes
  * 0.25pt adverse slippage on entry and on stop exits; commission per spec
  * stop filled first if stop & target both touched in one 1-min bar
  * flat by 16:59 ET (last bar of the 18:00-anchored day cycle), no new entries after that
  * tuning ONLY on IS; OOS1 / OOS2 read once at the end
  * every survivor is checked against a random-time placebo (offset U(120,1440) min, 8 seeds)

Usage: python3 fam_qt-open-drift.py [explore|sweep|final|all]
"""
import sys, os, json, math, itertools, warnings
import numpy as np
import pandas as pd
from numba import njit

warnings.filterwarnings("ignore")
DIR = "/Users/kaveh/qt_cascade"
SLIP = 0.25

# per-spec costs
COST = {
    "NQ":  dict(pv=20.0, comm=4.00),
    "MNQ": dict(pv=2.0,  comm=1.50),
}
# what the user actually trades: 1 micro. Used as the conservative cross-check on NQ data.
MICRO = dict(pv=2.0, comm=1.50)


# ----------------------------------------------------------------------------- data
def load(path):
    df = pd.read_parquet(path)
    df = df.sort_index()
    return df


def prep(df):
    """Build causal fields. Deliberately does NOT use the parquet's atr15/30/60 or
    bear_score/bull_score: those are forward-filled from the LEFT label of a resampled
    bar and therefore peek inside the current bar."""
    d = {}
    d["o"] = df["o"].to_numpy(np.float64)
    d["h"] = df["h"].to_numpy(np.float64)
    d["l"] = df["l"].to_numpy(np.float64)
    d["c"] = df["c"].to_numpy(np.float64)
    n = len(df)

    # integer ids
    cyc = pd.factorize(df["daycycle"].astype(str))[0].astype(np.int64)
    q90 = df["q90"].to_numpy(np.int64)          # 0..15 within the day cycle
    mq = df["min_into_q90"].to_numpy(np.int64)
    d["cyc"] = cyc
    d["q90"] = q90
    d["mq"] = mq
    d["qid"] = cyc * 16 + q90                    # global 90-min quarter id
    d["sord"] = q90 // 4                         # session ORDER inside the cycle (0..3)
    d["sid"] = cyc * 4 + d["sord"]               # global session id
    d["TDO"] = df["TDO"].to_numpy(np.float64)
    d["TSO"] = df["TSO"].to_numpy(np.float64)
    d["TMSO"] = df["TMSO"].to_numpy(np.float64)
    idx = df.index
    d["hhmm"] = (idx.hour * 60 + idx.minute).to_numpy(np.int64)
    d["dates"] = idx
    d["n"] = n

    # causal true range / ATR on 1-min bars, shifted so bar t only knows t-1 back
    pc = np.roll(d["c"], 1); pc[0] = d["c"][0]
    tr = np.maximum(d["h"] - d["l"], np.maximum(np.abs(d["h"] - pc), np.abs(d["l"] - pc)))
    s = pd.Series(tr)
    for k in (30, 90, 390):
        d[f"atr{k}"] = s.rolling(k, min_periods=k // 2).mean().shift(1).to_numpy(np.float64)

    # prior-14-cycle mean range: known at the cycle open, fully causal, vol-scaled
    g = pd.DataFrame({"cyc": cyc, "h": d["h"], "l": d["l"]}).groupby("cyc")
    rng = (g["h"].max() - g["l"].min())
    ref_by_cyc = rng.rolling(14, min_periods=5).mean().shift(1)
    d["ref"] = ref_by_cyc.reindex(cyc).to_numpy(np.float64)   # per-bar, constant within a cycle

    # forced-flat bar for each cycle = last bar at/ before 16:59 ET in that cycle
    ok = (d["hhmm"] <= 16 * 60 + 59) | (d["hhmm"] >= 18 * 60)   # everything in cycle qualifies
    flat = np.zeros(n, np.int64)
    last_idx = pd.Series(np.arange(n)).groupby(cyc).max()
    d["flat"] = last_idx.reindex(cyc).to_numpy(np.int64)

    # period boundaries
    d["qstart"] = _grp_first(d["qid"], n)
    d["qend"] = _grp_last(d["qid"], n)
    d["sstart"] = _grp_first(d["sid"], n)
    d["send"] = _grp_last(d["sid"], n)
    d["cstart"] = _grp_first(cyc, n)
    d["cend"] = _grp_last(cyc, n)
    return d


def _grp_first(key, n):
    s = pd.Series(np.arange(n))
    return s.groupby(key).transform("min").to_numpy(np.int64)


def _grp_last(key, n):
    s = pd.Series(np.arange(n))
    return s.groupby(key).transform("max").to_numpy(np.int64)


# ----------------------------------------------------------------------------- engine
@njit(cache=True)
def _sim(o, h, l, c, ent, dirn, stop_pts, targ_pts, maxexit, slip, pv, comm):
    m = ent.shape[0]
    pnl = np.empty(m, np.float64)
    rr = np.empty(m, np.float64)
    exi = np.empty(m, np.int64)
    kind = np.empty(m, np.int64)   # 1 target, -1 stop, 0 time
    for t in range(m):
        i = ent[t]
        dd = dirn[t]
        e = o[i] + dd * slip
        sp = stop_pts[t]
        tp = targ_pts[t]
        stop = e - dd * sp
        targ = e + dd * tp
        j = maxexit[t]
        if j < i:
            j = i
        ex = c[j]
        ky = 0
        ke = j
        for k in range(i, j + 1):
            if dd == 1:
                if l[k] <= stop:
                    ex = stop - slip
                    ky = -1
                    ke = k
                    break
                if h[k] >= targ:
                    ex = targ
                    ky = 1
                    ke = k
                    break
            else:
                if h[k] >= stop:
                    ex = stop + slip
                    ky = -1
                    ke = k
                    break
                if l[k] <= targ:
                    ex = targ
                    ky = 1
                    ke = k
                    break
        g = dd * (ex - e) * pv
        pnl[t] = g - comm
        rr[t] = pnl[t] / (sp * pv)
        exi[t] = ke
        kind[t] = ky
    return pnl, rr, exi, kind


def simulate(D, ent, dirn, stop_pts, targ_pts, maxexit, pv, comm):
    ent = np.asarray(ent, np.int64)
    dirn = np.asarray(dirn, np.int64)
    stop_pts = np.asarray(stop_pts, np.float64)
    targ_pts = np.asarray(targ_pts, np.float64)
    maxexit = np.asarray(maxexit, np.int64)
    return _sim(D["o"], D["h"], D["l"], D["c"], ent, dirn, stop_pts, targ_pts, maxexit,
                SLIP, pv, comm)


def stats(D, ent, pnl, rr, label="", ndays=None):
    m = len(rr)
    if m == 0:
        return dict(n=0, avgR=0.0, dpt=0.0, wr=0.0, tpd=0.0, maxdd=0.0, drop3=0.0, tstat=0.0, total=0.0)
    if ndays is None:
        ndays = len(np.unique(D["cyc"]))
    order = np.argsort(ent)
    eq = np.cumsum(pnl[order])
    dd = float(np.max(np.maximum.accumulate(np.concatenate([[0.0], eq])) - np.concatenate([[0.0], eq])))
    srt = np.sort(rr)
    drop3 = float(srt[:-3].mean()) if m > 3 else float("nan")
    sd = rr.std(ddof=1) if m > 1 else 0.0
    t = float(rr.mean() / (sd / math.sqrt(m))) if sd > 0 else 0.0
    return dict(n=int(m), avgR=float(rr.mean()), dpt=float(pnl.mean()), wr=float((pnl > 0).mean()),
                tpd=float(m / ndays), maxdd=dd, drop3=drop3, tstat=t, total=float(pnl.sum()))


def fmt(s):
    return (f"n={s['n']:5d} tpd={s['tpd']:4.2f} avgR={s['avgR']:+.4f} $/tr={s['dpt']:+7.2f} "
            f"wr={s['wr']:.3f} t={s['tstat']:+5.2f} drop3={s['drop3']:+.4f} DD=${s['maxdd']:,.0f}")


# ----------------------------------------------------------------------------- signal builders
def _period(D, which):
    if which == "q":
        return D["qid"], D["qstart"], D["qend"]
    if which == "s":
        return D["sid"], D["sstart"], D["send"]
    return D["cyc"], D["cstart"], D["cend"]


def sig_drift(D, which="q", N=15, thr=0.0, mode="cont", stopmode="atr", s_mult=0.10,
              rr=2.0, hold=0, sess_filter=None, hhmm_min=None, hhmm_max=None):
    """(A) DRIFT: measure the move over the first N minutes of each true-open period.
    mode 'cont' trades in the direction of that move, 'fade' against it."""
    pid, pst, pen = _period(D, which)
    n = D["n"]
    starts = np.unique(pst)
    starts = starts[(starts + N) < n]
    # only periods that actually contain N+1 bars of the same period
    sig_i = starts + N - 1               # last bar of the observation window
    ent_i = starts + N                   # entry bar (next open)
    good = (pid[sig_i] == pid[starts]) & (pid[ent_i] == pid[starts])
    starts, sig_i, ent_i = starts[good], sig_i[good], ent_i[good]

    P0 = D["o"][starts]
    move = D["c"][sig_i] - P0
    ref = D["ref"][ent_i]
    span = D["h"][starts] * 0  # placeholder
    # observation-window range (used by 'range' stop mode)
    hi = np.array([D["h"][a:b + 1].max() for a, b in zip(starts, sig_i)])
    lo = np.array([D["l"][a:b + 1].min() for a, b in zip(starts, sig_i)])

    keep = np.isfinite(ref) & (np.abs(move) >= thr * ref) & (np.abs(move) > 0)
    if sess_filter is not None:
        keep &= np.isin(D["sord"][starts], sess_filter)
    if hhmm_min is not None:
        keep &= (D["hhmm"][starts] >= hhmm_min) & (D["hhmm"][starts] <= hhmm_max)
    # apex: no entries after 16:59 -> entry bar must be <= flat bar
    keep &= ent_i <= D["flat"][ent_i]

    starts, sig_i, ent_i = starts[keep], sig_i[keep], ent_i[keep]
    move, ref, hi, lo = move[keep], ref[keep], hi[keep], lo[keep]

    sgn = np.sign(move).astype(np.int64)
    dirn = sgn if mode == "cont" else -sgn

    if stopmode == "atr":
        stop = s_mult * ref
    elif stopmode == "range":
        stop = np.maximum(hi - lo, 1e-9) * s_mult
    else:  # 'open' = stop the other side of the true open
        P0k = D["o"][starts]
        e = D["o"][ent_i]
        stop = np.maximum(np.abs(e - P0k), 0.25) * s_mult
    stop = np.maximum(stop, 2.0)   # never a sub-2pt stop (unrealistic on NQ)
    targ = stop * rr

    if hold and hold > 0:
        mx = np.minimum(ent_i + hold, pen[ent_i])
    else:
        mx = pen[ent_i]
    mx = np.minimum(mx, D["flat"][ent_i])
    mx = np.minimum(mx, D["n"] - 1)
    return dict(ent=ent_i, dirn=dirn, stop=stop, targ=targ, mx=mx, start=starts)


def sig_fade(D, which="q", X=1.0, mode="fade", s_mult=0.5, tmode="open", rr=1.0,
             skip=1, sess_filter=None, hold=0, ref_of="cycle"):
    """(B) FADE / BREAK of the true open: first bar where price is X*ref away from the
    period's true open. mode 'fade' trades back toward the open, 'cont' trades away."""
    pid, pst, pen = _period(D, which)
    n = D["n"]
    # vector scan: for each bar, distance from the period open
    P0 = D["o"][pst]
    ref = D["ref"]
    dist_up = D["h"] - P0
    dist_dn = P0 - D["l"]
    thr = X * ref
    trig_up = dist_up >= thr
    trig_dn = dist_dn >= thr
    pos = np.arange(n) - pst
    valid = (pos >= skip) & np.isfinite(thr)
    fire = (trig_up | trig_dn) & valid
    idx = np.where(fire)[0]
    if len(idx) == 0:
        return None
    # keep only the FIRST firing bar in each period
    keyp = pid[idx]
    first = np.ones(len(idx), bool)
    first[1:] = keyp[1:] != keyp[:-1]
    idx = idx[first]
    up = trig_up[idx] & ~trig_dn[idx]
    dn = trig_dn[idx] & ~trig_up[idx]
    both = trig_up[idx] & trig_dn[idx]
    sgn = np.where(up, 1, np.where(dn, -1, 0)).astype(np.int64)
    # if a single bar tags both sides, skip it (ambiguous)
    keep = sgn != 0
    idx, sgn = idx[keep], sgn[keep]
    ent_i = idx + 1
    keep = (ent_i < n) & (pid[ent_i] == pid[idx])
    idx, sgn, ent_i = idx[keep], sgn[keep], ent_i[keep]
    if sess_filter is not None:
        k = np.isin(D["sord"][ent_i], sess_filter)
        idx, sgn, ent_i = idx[k], sgn[k], ent_i[k]
    k = ent_i <= D["flat"][ent_i]
    idx, sgn, ent_i = idx[k], sgn[k], ent_i[k]
    if len(ent_i) == 0:
        return None

    dirn = (-sgn) if mode == "fade" else sgn
    refe = D["ref"][ent_i]
    stop = np.maximum(s_mult * refe, 2.0)
    P0e = D["o"][pst[ent_i]]
    e = D["o"][ent_i]
    if tmode == "open":                      # target = the true open itself
        targ = np.maximum(np.abs(e - P0e), 1.0)
    elif tmode == "half":
        targ = np.maximum(np.abs(e - P0e) * 0.5, 1.0)
    else:                                    # fixed R multiple
        targ = stop * rr
    if hold and hold > 0:
        mx = np.minimum(ent_i + hold, pen[ent_i])
    else:
        mx = pen[ent_i]
    mx = np.minimum(np.minimum(mx, D["flat"][ent_i]), n - 1)
    return dict(ent=ent_i, dirn=dirn.astype(np.int64), stop=stop, targ=targ, mx=mx, start=pst[ent_i])


def sig_amd(D, which="q", manip="ext", mode="rev", s_mult=0.10, rr=2.0, qsel=None,
            sess_filter=None, hold=0, lag=1, delay=0):
    """(C) AMD cascade: read the leg of period k, act at the open of period k+lag.
    manip 'ext'  = which extreme is further from the period open
           'body' = sign of close-open
           'exto' = extreme relative to the PARENT period open (session/cycle open)
    mode 'rev' = trade opposite the manipulation leg, 'cont' = with it."""
    pid, pst, pen = _period(D, which)
    n = D["n"]
    starts = np.unique(pst)
    # per-period aggregates
    dfp = pd.DataFrame({"p": pid, "h": D["h"], "l": D["l"], "c": D["c"], "o": D["o"]})
    g = dfp.groupby("p")
    ph = g["h"].max().to_numpy()
    pl = g["l"].min().to_numpy()
    pc = g["c"].last().to_numpy()
    po = g["o"].first().to_numpy()
    pids = g["h"].max().index.to_numpy()
    pos_of = {p: i for i, p in enumerate(pids)}
    st_of = pd.Series(pst).groupby(pid).first().to_numpy()
    en_of = pd.Series(pen).groupby(pid).first().to_numpy()

    if manip == "ext":
        mdir = np.where((ph - po) >= (po - pl), 1, -1)
    elif manip == "body":
        mdir = np.where(pc >= po, 1, -1)
    else:  # 'exto' -> relative to parent open (session open for quarters)
        par = pd.Series(D["TSO"] if which == "q" else D["TDO"]).groupby(pid).first().to_numpy()
        mdir = np.where((ph - par) >= (par - pl), 1, -1)

    # act at the start of period k+lag  (contiguity: same session for quarters)
    k = np.arange(len(pids) - lag)
    nxt = k + lag
    same = np.ones(len(k), bool)
    if which == "q":
        # only cascade within the same 6h session unless qsel says otherwise
        sord_k = D["sord"][st_of[k]]
        sord_n = D["sord"][st_of[nxt]]
        cyc_k = D["cyc"][st_of[k]]
        cyc_n = D["cyc"][st_of[nxt]]
        same = (pids[nxt] - pids[k] == lag)
    else:
        same = (pids[nxt] - pids[k] == lag)

    kk = k[same]
    nn = nxt[same]
    ent_i = st_of[nn] + delay
    ok = ent_i <= en_of[nn]
    kk, nn, ent_i = kk[ok], nn[ok], ent_i[ok]
    if qsel is not None:
        qi = D["q90"][st_of[nn]] % 4
        m = np.isin(qi, qsel)
        kk, nn, ent_i = kk[m], nn[m], ent_i[m]
    if sess_filter is not None:
        m = np.isin(D["sord"][st_of[nn]], sess_filter)
        kk, nn, ent_i = kk[m], nn[m], ent_i[m]
    m = (ent_i <= D["flat"][ent_i]) & np.isfinite(D["ref"][ent_i])
    kk, nn, ent_i = kk[m], nn[m], ent_i[m]
    if len(ent_i) == 0:
        return None
    md = mdir[kk]
    dirn = (-md if mode == "rev" else md).astype(np.int64)
    refe = D["ref"][ent_i]
    stop = np.maximum(s_mult * refe, 2.0)
    targ = stop * rr
    if hold and hold > 0:
        mx = np.minimum(ent_i + hold, en_of[nn])
    else:
        mx = en_of[nn]
    mx = np.minimum(np.minimum(mx, D["flat"][ent_i]), n - 1)
    return dict(ent=ent_i, dirn=dirn, stop=stop, targ=targ, mx=mx, start=st_of[nn])


def sig_raid(D, which="q", mode="rev", s_mult=0.10, rr=2.0, hold=0, sess_filter=None,
             qsel=None, minpen=0.0):
    """(D) RAID: inside period k+1, price sweeps period k's high or low -> reverse (or go with)."""
    pid, pst, pen = _period(D, which)
    n = D["n"]
    dfp = pd.DataFrame({"p": pid, "h": D["h"], "l": D["l"]})
    g = dfp.groupby("p")
    ph = g["h"].max()
    pl = g["l"].min()
    pids = ph.index.to_numpy()
    prev_h = ph.shift(1).to_numpy()
    prev_l = pl.shift(1).to_numpy()
    contig = np.concatenate([[False], np.diff(pids) == 1])
    map_h = pd.Series(prev_h, index=pids).reindex(pid).to_numpy()
    map_l = pd.Series(prev_l, index=pids).reindex(pid).to_numpy()
    map_ok = pd.Series(contig, index=pids).reindex(pid).to_numpy()
    ref = D["ref"]
    pen_pts = minpen * ref
    up = (D["h"] >= map_h + pen_pts) & map_ok & np.isfinite(map_h)
    dn = (D["l"] <= map_l - pen_pts) & map_ok & np.isfinite(map_l)
    fire = up | dn
    idx = np.where(fire)[0]
    if len(idx) == 0:
        return None
    keyp = pid[idx]
    first = np.ones(len(idx), bool)
    first[1:] = keyp[1:] != keyp[:-1]
    idx = idx[first]
    sgn = np.where(up[idx] & ~dn[idx], 1, np.where(dn[idx] & ~up[idx], -1, 0)).astype(np.int64)
    keep = sgn != 0
    idx, sgn = idx[keep], sgn[keep]
    ent_i = idx + 1
    keep = (ent_i < n) & (pid[ent_i] == pid[idx]) & (ent_i <= D["flat"][ent_i]) & np.isfinite(D["ref"][ent_i])
    idx, sgn, ent_i = idx[keep], sgn[keep], ent_i[keep]
    if sess_filter is not None:
        m = np.isin(D["sord"][ent_i], sess_filter)
        idx, sgn, ent_i = idx[m], sgn[m], ent_i[m]
    if qsel is not None:
        m = np.isin(D["q90"][ent_i] % 4, qsel)
        idx, sgn, ent_i = idx[m], sgn[m], ent_i[m]
    if len(ent_i) == 0:
        return None
    dirn = (-sgn if mode == "rev" else sgn).astype(np.int64)
    refe = D["ref"][ent_i]
    stop = np.maximum(s_mult * refe, 2.0)
    targ = stop * rr
    if hold and hold > 0:
        mx = np.minimum(ent_i + hold, pen[ent_i])
    else:
        mx = pen[ent_i]
    mx = np.minimum(np.minimum(mx, D["flat"][ent_i]), n - 1)
    return dict(ent=ent_i, dirn=dirn, stop=stop, targ=targ, mx=mx, start=pst[ent_i])


BUILDERS = dict(drift=sig_drift, fade=sig_fade, amd=sig_amd, raid=sig_raid)


def run_cfg(D, cfg, pv, comm):
    b = BUILDERS[cfg["fam"]]
    kw = {k: v for k, v in cfg.items() if k != "fam"}
    s = b(D, **kw)
    if s is None or len(s["ent"]) == 0:
        return None, None
    pnl, rr, exi, kind = simulate(D, s["ent"], s["dirn"], s["stop"], s["targ"], s["mx"], pv, comm)
    return s, dict(pnl=pnl, rr=rr, exi=exi, kind=kind)


# ----------------------------------------------------------------------------- placebo
def placebo(D, cfg, pv, comm, seeds=8, lo=120, hi=1440):
    """Same directions / stops / targets / hold lengths, entry timestamps shifted by a
    random offset U(120,1440) minutes."""
    s, r = run_cfg(D, cfg, pv, comm)
    if s is None:
        return None
    ent = s["ent"]
    hold = s["mx"] - ent
    out = []
    n = D["n"]
    for sd in range(seeds):
        rng = np.random.default_rng(1000 + sd)
        off = rng.integers(lo, hi + 1, size=len(ent))
        e2 = ent + off
        ok = e2 < n - 5
        e2 = e2[ok]
        d2 = s["dirn"][ok]
        st2 = s["stop"][ok]
        tg2 = s["targ"][ok]
        mx2 = np.minimum(np.minimum(e2 + hold[ok], D["flat"][e2]), n - 1)
        bad = mx2 < e2
        mx2[bad] = e2[bad]
        p2, r2, _, _ = simulate(D, e2, d2, st2, tg2, mx2, pv, comm)
        out.append(r2.mean())
    return float(np.mean(out)), float(np.std(out)), out


# ----------------------------------------------------------------------------- splits
def splits():
    nq = load(f"{DIR}/nq_v5.parquet")
