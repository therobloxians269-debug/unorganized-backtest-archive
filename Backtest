        ct = int(round(risk_usd / (r * MNQ_PT)))
        ct = max(1, min(max_ct, ct))
        fired += 1
        best, exit_px, j = e, None, i + 1
        while j < n and sdate[j] == sdate[i] and tmin[j] <= FLAT_MIN:
            if (side == "short" and nq_h[j] >= stop) or (side == "long" and nq_l[j] <= stop):
