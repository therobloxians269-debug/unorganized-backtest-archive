"""Price (and optionally download) the data to validate Market Intraday Momentum.

MIM needs 30-min granularity over many years. Databento has no native 30-min OHLCV, so
we buy the cheapest fitting schema -- ohlcv-1m -- and resample to 30-min (1-min also
serves later ATR-stop / execution work). We ALWAYS price via get_cost before spending.

Usage:
    export DATABENTO_API_KEY=db-...           # your key
    python research/price_mim_data.py          # price only (no spend)
    python research/price_mim_data.py --download   # fetch into data/ (guarded <$20)
    python research/price_mim_data.py --symbols ES.c.0 NQ.c.0 YM.c.0   # multi-market

This downloads OHLCV bars only (cheapest schema); it never buys trades/mbp/mbo.
"""
from __future__ import annotations

import argparse
import os
import sys

DATASET = "GLBX.MDP3"
START = "2010-06-06"   # GLBX.MDP3 history start
END = "2026-06-06"
STYPE = "continuous"   # ES.c.0 = continuous front month
DEFAULT_SYMBOLS = ["ES.c.0"]
DEFAULT_SCHEMA = "ohlcv-1m"
COST_GUARD = 40.0      # refuse to auto-download above this (override with --max-cost)


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--download", action="store_true", help="actually fetch (spends credit)")
    ap.add_argument("--symbols", nargs="+", default=DEFAULT_SYMBOLS)
    ap.add_argument("--schema", default=DEFAULT_SCHEMA)
    ap.add_argument("--start", default=START)
    ap.add_argument("--end", default=END)
    ap.add_argument("--max-cost", type=float, default=COST_GUARD,
                    help="abort download above this USD cost")
    args = ap.parse_args()

    key = os.environ.get("DATABENTO_API_KEY")
    if not key:
        sys.exit("set your key first:  export DATABENTO_API_KEY=db-...")

    import databento as db

    client = db.Historical(key)
    q = dict(dataset=DATASET, symbols=args.symbols, schema=args.schema,
             start=args.start, end=args.end, stype_in=STYPE)

    cost = client.metadata.get_cost(**q)
    try:
        size_mb = client.metadata.get_billable_size(**q) / 1e6
    except Exception:
        size_mb = float("nan")
    print(f"query : {DATASET} {args.schema} {args.symbols} {args.start}->{args.end} ({STYPE})")
    print(f"COST  : ${cost:.2f}    billable size: {size_mb:.1f} MB")

    if not args.download:
        print("\n(price only) -- re-run with --download to fetch. Nothing was charged.")
        return
    if cost > args.max_cost:
        sys.exit(f"cost ${cost:.2f} exceeds ${args.max_cost:.0f} guard; "
                 f"re-run with --max-cost to override")

    print("downloading ...")
    data = client.timeseries.get_range(**q)
    os.makedirs("data", exist_ok=True)
    tag = "-".join(s.replace(".", "") for s in args.symbols)
    path = f"data/{tag}_{args.schema.replace('-', '')}_{args.start[:4]}_{args.end[:4]}.parquet"
    data.to_df().to_parquet(path)
    print(f"saved -> {path}  (cost ${cost:.2f})")


if __name__ == "__main__":
    main()

