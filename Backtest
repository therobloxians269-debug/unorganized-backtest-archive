#!/usr/bin/env python3
"""OCEAN family f10_bigbar_ignition — single big-bar momentum ignition (MES 1-lot).

Hypothesis: one 5m bar with range >= k*ATR and top-quintile session volume marks
either momentum ignition (follow it to EOD) or climactic exhaustion (fade it
back to VWAP). Both branches tested on the grid; the stronger plateau branch is
pre-registered.

Signal (exact, causal — evaluated only on completed bars):
  * Entry window: bars 6..71 only (skip first 30 min 09:30-10:00 and last
    30 min 15:30-16:00). Position management continues through bar 77.
  * Ignition bar b: (h[b]-l[b]) >= k * ATR(b-1)  [prevailing ATR *before* the
    bar, so the big bar cannot inflate its own threshold] AND
    v[b] >= 80th percentile of v[0..b] (session volume so far, causal at close)
    AND c[b] != o[b] (bar has a direction). First qualifying bar of the day
    only; one trade per day.
  * dir = +1 if c[b] > o[b] else -1.

Branch A "follow": enter dir at c[b] (market, slippage in friction).
  Stop = entry - dir * max(m*ATR(b), FLOOR=5pt)   [ATR at entry bar, i.e.
  updated WITH the ignition bar's TR — house floor per omni4_preserve].
  No target; ride to EOD (bar-77 close, fric("eod")=0.66pt).

Branch B "fade": enter -dir at c[b]. Target = session VWAP at bar b, resting
  limit (fric("target")=0.41pt); requires VWAP >= 0.25pt on the profitable
  side, else no trade. Stop = ignition-bar extreme +/- sb*ATR(b) (sb="none"
  => no stop, EOD exit). Stop checked intrabar only on bars strictly after
  the entry bar; stop takes precedence over target in the same bar
  (conservative). EOD exit at bar-77 close if neither hit.

Windows: dev = dates <= 2022-12-31, holdout = 2023-01-01.., all = everything.
Sweep table (dev only) prints every config tested.

VERDICT: DEAD. All 25 dev configs (18 base grid + 7 rescue diagnostics) are
net-negative after friction; zero net-positive cells exist, so no plateau and
nothing to pre-register. Defaults below are the least-bad mid-grid cell
(follow k=2.5 m=1.5, dev net -$1369) kept ONLY as a reference config; it fails
the survival bar and must not be traded. Decomposition: follow branch is
mildly gross-positive (~+0.34 pt/trade before friction at k=2.5) — big bars do
continue — but the edge is ~half the 0.66 pt market-order friction; fade
branch is gross-NEGATIVE (fading ignition bars loses even before costs).
"""
import sys, json, argparse, math
sys.path.insert(0, "/Users/kaveh/mes_mim")
import numpy as np, pandas as pd
import omni2_lib as L

DPP = L.DPP
FLOOR = L.FLOOR          # 5.0 pt minimum stop distance (house convention)
VOL_PCT = 80             # fixed by family spec, not a tuned parameter
MIN_EDGE = 0.25          # fade target must sit >= 1 tick on the profitable side
B_FIRST, B_LAST = 6, 71  # entry window (exclude first/last 30 min)

# ------------- DEFAULT CONFIG (reference only — family is DEAD) -------------
# Least-bad mid-grid cell; FAILS the survival bar. Nothing is pre-registered.
PRE = dict(branch="follow", k=2.5, m=1.5, sb=1.0)

GRID_K  = [2.0, 2.5, 3.0]
GRID_M  = [1.0, 1.5, 2.0]          # branch A stop multiple (x ATR, floored 5pt)
GRID_SB = [0.5, 1.0, "none"]       # branch B stop buffer beyond bar extreme

# rescue/robustness diagnostics (each counts against the ~30 budget):
DIAG = [
    dict(branch="fade", k=2.5, m=1.5, sb=1.0, bmax=41),      # fade, morning only (<13:00)
    dict(branch="fade", k=2.5, m=1.5, sb=1.0, dir_only=-1),  # fade up-bars only (short)
    dict(branch="fade", k=2.5, m=1.5, sb=1.0, dir_only=1),   # fade down-bars only (long)
    dict(branch="follow", k=2.5, m=1.5, sb=1.0, er_min=0.35),  # follow only in trend regime
    dict(branch="follow", k=2.5, m=1.5, sb=1.0, bmax=41),      # follow, morning only
    dict(branch="follow", k=2.5, m=1.5, sb=1.0, dir_only=-1),  # follow down-bars only
    dict(branch="follow", k=2.5, m=1.5, sb=1.0, dir_only=1),   # follow up-bars only
]


def sim_day(s, branch, k, m=1.5, sb=1.0, bmax=None, dir_only=None, er_min=None):
    """Return (date, net_pts, exit_kind) or None. Causal per module docstring."""
    o, h, l, c, v, vwap, atr = s["o"], s["h"], s["l"], s["c"], s["v"], s["vwap"], s["atr"]
    er = s["er"]
    pos = 0; entry = stop = tgt = np.nan; ebar = -1
    for b in range(B_FIRST, 78):
        # ---- position management (only on bars strictly after entry bar) ----
        if pos != 0 and b > ebar:
            if pos > 0:
                stop_hit = (not np.isnan(stop)) and l[b] <= stop
                tgt_hit = (not np.isnan(tgt)) and h[b] >= tgt
            else:
                stop_hit = (not np.isnan(stop)) and h[b] >= stop
                tgt_hit = (not np.isnan(tgt)) and l[b] <= tgt
            if stop_hit:                                    # stop first (conservative)
                g = pos * (stop - entry) - L.fric("stop"); kind = "stop"
            elif tgt_hit:
                g = pos * (tgt - entry) - L.fric("target"); kind = "target"
            elif b == 77:
                g = pos * (c[77] - entry) - L.fric("eod"); kind = "eod"
            else:
                continue
            return (s["date"], g, kind)
        if pos != 0:
            continue
        # ---- signal logic (flat, entries only in window) ----
        if b > B_LAST:
            continue
        if bmax is not None and b > bmax:
            continue
        ap = atr[b - 1]                                     # prevailing ATR before the bar
        if ap <= 0 or (h[b] - l[b]) < k * ap:
            continue
        if v[b] < np.percentile(v[:b + 1], VOL_PCT):
            continue
        d = 1 if c[b] > o[b] else (-1 if c[b] < o[b] else 0)
        if d == 0:
            continue
        if dir_only is not None and d != dir_only:
            continue
        if er_min is not None and er[b] < er_min:
            continue
        if branch == "follow":
            pos = d; entry = c[b]; ebar = b
            stop = entry - d * max(m * atr[b], FLOOR)
            tgt = np.nan
        else:                                               # fade toward VWAP
            e = c[b]; t = vwap[b]
            if d * (e - t) < MIN_EDGE:                      # VWAP must be on profit side
                continue
            pos = -d; entry = e; ebar = b; tgt = t
            if sb == "none":
                stop = np.nan
            else:
                stop = (h[b] + sb * atr[b]) if pos < 0 else (l[b] - sb * atr[b])
    return None


def run(S, **cfg):
    rows = []
    for s in S:
        r = sim_day(s, **cfg)
        if r is not None:
            rows.append(r)
    return pd.DataFrame(rows, columns=["date", "pts", "kind"])


def stats(tr):
    out = dict(net_usd=0.0, mar=0.0, trades=0, hit=0.0, maxdd_usd=0.0,
               yearly={}, top3_month_share=float("nan"), expectancy_pts=0.0,
               yrs_pos=0, n_yrs=0, max_yr_share=float("nan"))
    if len(tr) == 0:
        return out
    tr = tr.sort_values("date").reset_index(drop=True)
    usd = tr["pts"].to_numpy() * DPP
    net = float(usd.sum())
    eq = np.cumsum(usd)
    dd = float((eq - np.maximum.accumulate(eq)).min())
    dts = pd.to_datetime(tr["date"].astype(str))
    ys = pd.Series(usd).groupby(dts.dt.year.to_numpy()).sum()
    ms = pd.Series(usd).groupby(dts.dt.strftime("%Y-%m").to_numpy()).sum()
    out.update(
        net_usd=round(net, 2),
        mar=round(net / abs(dd), 3) if dd < 0 else float("inf"),
        trades=int(len(tr)),
        hit=round(float((tr["pts"] > 0).mean()), 4),
        maxdd_usd=round(dd, 2),
        yearly={str(int(kk)): round(float(vv), 2) for kk, vv in ys.items()},
        top3_month_share=round(float(ms.nlargest(3).sum() / net), 3) if net > 0 else float("nan"),
        expectancy_pts=round(float(tr["pts"].mean()), 4),
        yrs_pos=int((ys > 0).sum()), n_yrs=int(len(ys)),
        max_yr_share=round(float(ys.max() / net), 3) if net > 0 else float("nan"),
    )
    return out


def survival(st):
    return (st["net_usd"] > 0
            and st["mar"] >= 1.0
            and st["trades"] >= 80
            and st["n_yrs"] > 0 and st["yrs_pos"] / st["n_yrs"] >= 0.60
            and not math.isnan(st["max_yr_share"]) and st["max_yr_share"] <= 0.50)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--window", choices=["dev", "holdout", "all"], default="dev")
    ap.add_argument("--branch", default=PRE["branch"], choices=["follow", "fade"])
    ap.add_argument("--k", type=float, default=PRE["k"])
    ap.add_argument("--m", type=float, default=PRE["m"])
    ap.add_argument("--sb", default=PRE["sb"])
    a = ap.parse_args()
    sb = a.sb if a.sb == "none" else float(a.sb)

    S = L.load()
    if a.window == "dev":
        S = [s for s in S if str(s["date"]) <= "2022-12-31"]
    elif a.window == "holdout":
        S = [s for s in S if str(s["date"]) >= "2023-01-01"]
    print(f"f10_bigbar_ignition  window={a.window}  sessions={len(S)}")

    # ---- pre-registered (or CLI-overridden) config ----
    cfg = dict(branch=a.branch, k=a.k, m=a.m, sb=sb)
