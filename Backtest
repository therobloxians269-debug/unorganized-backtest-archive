"""
Second attempt, motivated by M4's own insight:
The Apex trailing threshold punishes GIVE-BACK, so the winning shape is
high-win-rate / low-give-back, not a 2R trend system.

Test a plain VWAP mean-reversion fade on real ES RTH 1-min:
  - session VWAP; band = k * rolling std of (close - vwap)
  - when price extends >= band ABOVE vwap -> short toward vwap (symmetric long)
  - target = partial move back (small), stop = wider (-> high WR, negative skew)
  - allow up to N trades/day (MR gives multiple shots)
Same conservative Monte-Carlo of the Apex 50K path as sim.py.

Fixed params, not optimized. Point is to see if the geometry insight survives
real costs, or if the corpus verdict (micro-intraday is dead net-of-cost) holds.
"""
import numpy as np
import pandas as pd
from sim import (load_es, monte_carlo, PT_VALUE, COST_PER_MES_RT,
                 RISK_SWEEP, PROFIT_TARGET, ACCOUNT_DD, MAX_DAYS)

# --- MR signal params (FIXED) ---
BAND_K      = 1.8      # entry when |close-vwap| >= BAND_K * std
STD_WIN     = 30       # bars for the std of (close - vwap)
TARGET_FRAC = 0.60     # take profit at 60% of the way back to vwap
STOP_MULT   = 1.20     # stop = entry +/- STOP_MULT * band (continuation)
MAX_TR_DAY  = 3        # up to 3 fades/day
COOLDOWN    = 10       # bars between entries
EXIT_CUT    = 15 * 60 + 55


def backtest_mr(df):
    trades = []
    for day, g in df.groupby(df["dt"].dt.date):
        g = g.sort_values("dt").reset_index(drop=True)
        mins = g["dt"].dt.hour * 60 + g["dt"].dt.minute
        tp = (g["high"] + g["low"] + g["close"]) / 3.0
        cumv = g["volume"].cumsum().replace(0, np.nan)
        vwap = (tp * g["volume"]).cumsum() / cumv
        dev = g["close"] - vwap
        std = dev.rolling(STD_WIN, min_periods=STD_WIN).std()

        c = g["close"].values; h = g["high"].values; l = g["low"].values
        vw = vwap.values; bd = (BAND_K * std).values
        n = len(g)
        last_entry = -10**9
        taken = 0
        i = STD_WIN
        while i < n - 1 and taken < MAX_TR_DAY:
            if mins.iloc[i] > EXIT_CUT:
                break
            if i - last_entry < COOLDOWN or not np.isfinite(bd[i]) or bd[i] <= 0:
                i += 1; continue
            dv = c[i] - vw[i]
            side = 0
            if dv >= bd[i]:
                side = -1               # extended above -> fade short
            elif dv <= -bd[i]:
                side = 1                # extended below -> fade long
            if side == 0:
                i += 1; continue

            entry = c[i]
            move_back = abs(dv)                      # distance to vwap
            target = entry + side * TARGET_FRAC * move_back
            stop   = entry - side * STOP_MULT * bd[i]
            risk_pts = abs(entry - stop)
            if risk_pts < 2.0:
                i += 1; continue

            mfe = mae = 0.0
            outcome = None
            j = i + 1
            while j < n and mins.iloc[j] <= EXIT_CUT + 5:
                up = (h[j] - entry) * side
                dn = (l[j] - entry) * side
                mfe = max(mfe, up); mae = min(mae, dn)
                if dn <= -risk_pts:
                    outcome = -risk_pts; break
                if up >= abs(target - entry):
                    outcome = abs(target - entry) * 1.0; break
                j += 1
            if outcome is None:
                outcome = (c[min(j, n-1)] - entry) * side
            trades.append(dict(
                date=str(day), stop_pts=risk_pts,
                R=outcome / risk_pts, mfe_R=mfe / risk_pts, mae_R=mae / risk_pts,
            ))
            taken += 1
            last_entry = j if outcome is not None else i
            i = max(i + 1, last_entry)
    return pd.DataFrame(trades)


def main():
    df = load_es()
    tr = backtest_mr(df)
    n = len(tr)
    wr = (tr["R"] > 0).mean()
    exp_R = tr["R"].mean()
    avg_stop_d = tr["stop_pts"].mean() * PT_VALUE
    cost_R = COST_PER_MES_RT / avg_stop_d
    net_R = exp_R - cost_R
    tr["yr"] = tr["date"].str[:4]
    yr = tr.groupby("yr")["R"].mean()

    print("=" * 68)
    print("SIGNAL: VWAP mean-reversion fade (high-WR / low-giveback), ES RTH")
    print("=" * 68)
    print(f"  trades            : {n:,}  (~{n/ df['dt'].dt.date.nunique():.1f}/day)")
    print(f"  win rate          : {wr:6.1%}")
    print(f"  gross expectancy  : {exp_R:+.4f} R/trade")
    print(f"  ~cost             : {cost_R:.4f} R/trade  (avg stop ${avg_stop_d:.0f})")
    print(f"  NET expectancy    : {net_R:+.4f} R/trade")
    print(f"  year stability    : {(yr>0).sum()}/{len(yr)} years net-positive gross R")
    print()
    print("=" * 68)
    print("MONTE CARLO — Apex 50K eval  (same conservative trailing model)")
    print("=" * 68)
    print(f"  {'risk/trade':>10} {'P(pass)':>9} {'P(bust)':>9} "
          f"{'P(timeout)':>11} {'med days':>9}")
    print("  " + "-" * 52)
    best = None
    for r in RISK_SWEEP:
        res = monte_carlo(tr, r)
        if best is None or res["p_pass"] > best["p_pass"]:
            best = res
        md = res["med_days"] if res["med_days"] else "-"
        print(f"  {'$'+str(r):>10} {res['p_pass']:>8.1%} {res['p_bust']:>8.1%} "
              f"{res['p_timeout']:>10.1%} {str(md):>9}")
    p = best["p_pass"]
    print(f"\n  GATE (P(pass) >= 60%): best = {p:.1%} -> "
          f"{'PASSES' if p >= 0.60 else 'FAILS'}")


if __name__ == "__main__":
    main()

