"""quant_lab harness — fast, overfit-resistant signal screening on ES/YM 1m.

Discipline baked in:
  * TRAIN (<=2022) selects the parameter; TEST (>=2023) is reported untouched.
  * PnL is causal: position at bar t (from info <= t) earns ES return t->t+1.
  * Costs charged on every position change (slippage + commission, in points).
  * PLACEBO: the same rule with its signal circularly shifted by random lags;
    a real signal must beat the 95th percentile of placebo test-Sharpes.
A signal only "survives" if: test Sharpe > 0.5, same sign as train, and it
clears the placebo 95th percentile. Everything else is a kill (logged, not
surfaced).
"""
from __future__ import annotations

import numpy as np
import pandas as pd

MULT_MES = 5.0
TICK = 0.25
COST_PTS_PER_SIDE = 0.25 + 0.62 / MULT_MES   # 1 tick slip + MES commission ≈ 0.374 pt
TRAIN_END = pd.Timestamp("2023-01-01", tz="America/New_York")

_CACHE = None


def load() -> pd.DataFrame:
    global _CACHE
    if _CACHE is None:
        _CACHE = pd.read_parquet("cache/es_ym_1m.parquet")
    return _CACHE


def _sharpe_daily(pnl_pts: pd.Series, index: pd.DatetimeIndex) -> float:
    s = pd.Series(pnl_pts.values, index=index)
    daily = s.groupby(s.index.normalize()).sum()
    if daily.std() == 0 or len(daily) < 20:
        return 0.0
    return daily.mean() / daily.std() * np.sqrt(252)


def evaluate(df: pd.DataFrame, pos: pd.Series, cost_mult: float = 1.0
             ) -> dict:
    """pos: causal position in {-1,0,+1} (or continuous), aligned to df.index.
    Returns pnl series (points) and Sharpe over the given df window."""
    es = df["es_close"]
    fwd = es.shift(-1) - es                      # next-bar ES point change
    pos = pos.fillna(0.0).clip(-1, 1)
    turn = pos.diff().abs().fillna(pos.abs())
    pnl = pos * fwd - turn * COST_PTS_PER_SIDE * cost_mult
    pnl = pnl.iloc[:-1]                           # last bar has no fwd
    return {"pnl": pnl, "sharpe": _sharpe_daily(pnl, pnl.index),
            "trades": int(turn.sum()), "net_pts": float(pnl.sum())}


def _placebo_sharpes(df: pd.DataFrame, raw_signal: pd.Series, thr: float,
                     n: int = 40) -> np.ndarray:
    """Circular-shift the signal by pseudo-random lags (deterministic set) and
    re-evaluate; distribution of test-Sharpes under no genuine timing."""
    out = []
    L = len(raw_signal)
    lags = [(i * 97 + 13) % L for i in range(1, n + 1)]  # deterministic, spread
    for lag in lags:
        shifted = pd.Series(np.roll(raw_signal.values, lag), index=raw_signal.index)
        pos = _threshold_pos(shifted, thr)
        out.append(evaluate(df, pos)["sharpe"])
    return np.array(out)


def _threshold_pos(sig: pd.Series, thr: float) -> pd.Series:
    pos = pd.Series(0.0, index=sig.index)
    pos[sig > thr] = 1.0
    pos[sig < -thr] = -1.0
    return pos


def screen(name: str, sig_fn, param_grid: list, rth_only: bool = True,
           thr_grid=(0.0,)) -> dict:
    """sig_fn(df, **params) -> causal raw signal (higher = more long ES).
    Grid-search (param, thr) on TRAIN by Sharpe; report that pick on TEST +
    placebo. Returns a result dict; caller decides survive/kill."""
    df = load()
    if rth_only:
        df = df[df["rth"]].copy()
    train = df[df.index < TRAIN_END]
    test = df[df.index >= TRAIN_END]

    best = None
    for params in param_grid:
        sig_tr = sig_fn(train, **params)
        for thr in thr_grid:
            pos = _threshold_pos(sig_tr, thr)
            r = evaluate(train, pos)
            if r["trades"] < 200:               # need activity to trust it
                continue
            if best is None or r["sharpe"] > best["tr_sharpe"]:
                best = {"params": params, "thr": thr, "tr_sharpe": r["sharpe"]}
    if best is None:
        return {"name": name, "status": "no-activity", "tr_sharpe": 0.0,
                "te_sharpe": 0.0}

    sig_te = sig_fn(test, **best["params"])
    pos_te = _threshold_pos(sig_te, best["thr"])
    rte = evaluate(test, pos_te)
    plc = _placebo_sharpes(test, sig_te, best["thr"])
    p95 = float(np.percentile(plc, 95))

    survive = (rte["sharpe"] > 0.5 and np.sign(rte["sharpe"]) == np.sign(best["tr_sharpe"])
               and rte["sharpe"] > p95)
    return {"name": name, "params": best["params"], "thr": best["thr"],
            "tr_sharpe": round(best["tr_sharpe"], 2),
            "te_sharpe": round(rte["sharpe"], 2),
            "placebo_p95": round(p95, 2), "te_trades": rte["trades"],
            "te_net_pts": round(rte["net_pts"], 1),
            "status": "SURVIVE" if survive else "kill"}


def leaderboard(results: list[dict]) -> str:
    rows = sorted(results, key=lambda r: r.get("te_sharpe", -9), reverse=True)
    lines = [f"{'signal':28s} {'trainSR':>7s} {'testSR':>6s} {'plc95':>6s} "
             f"{'trades':>6s} {'status':>8s}"]
    for r in rows:
        lines.append(f"{r['name']:28s} {r.get('tr_sharpe',0):7.2f} "
                     f"{r.get('te_sharpe',0):6.2f} {r.get('placebo_p95',0):6.2f} "
                     f"{r.get('te_trades',0):6d} {r.get('status','?'):>8s}")
    return "\n".join(lines)

