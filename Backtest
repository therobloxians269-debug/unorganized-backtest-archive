"""
Sanity control: prove the go/no-go gate is NOT a no-machine.
Inject a SYNTHETIC trade distribution with a genuine, realistic positive edge
and run it through the exact same conservative Apex Monte-Carlo.

If a real +edge clears the 60% gate, the tool discriminates edge from no-edge,
and the 'don't buy' verdict on the real signals is trustworthy -- they simply
lack the edge, not the tool rigged against them.
"""
import numpy as np
import pandas as pd
from sim import monte_carlo, RISK_SWEEP

RNG = np.random.default_rng(7)

def make_edge(n=4000, wr=0.52, win_R=1.5, loss_R=-1.0, stop_pts=8.0):
    """A believable edge: 52% WR at 1.5R win / 1.0R loss -> ~+0.30R gross."""
    wins = RNG.random(n) < wr
    R = np.where(wins, win_R, loss_R).astype(float)
    R += RNG.normal(0, 0.12, n)                       # noise
    # excursions: winners run favorable, losers dig adverse
    mfe = np.where(wins, R + RNG.uniform(0.1, 0.5, n),
                        RNG.uniform(0.2, 0.6, n))
    mae = np.where(wins, -RNG.uniform(0.1, 0.5, n),
                        R - RNG.uniform(0.0, 0.3, n))
    return pd.DataFrame(dict(stop_pts=stop_pts, R=R,
                            mfe_R=mfe, mae_R=np.minimum(mae, 0)))

def main():
    tr = make_edge()
    print("CONTROL: synthetic signal with a genuine edge")
    print(f"  win rate        : {(tr['R']>0).mean():.1%}")
    print(f"  gross expectancy: {tr['R'].mean():+.3f} R/trade")
    print(f"  (this is the ~edge a mechanical micro system almost never has)\n")
    print(f"  {'risk/trade':>10} {'P(pass)':>9} {'P(bust)':>9} {'med days':>9}")
    print("  " + "-" * 42)
    best = 0
    for r in RISK_SWEEP:
        res = monte_carlo(tr, r)
        best = max(best, res["p_pass"])
        md = res["med_days"] if res["med_days"] else "-"
        print(f"  {'$'+str(r):>10} {res['p_pass']:>8.1%} {res['p_bust']:>8.1%} {str(md):>9}")
    print(f"\n  best P(pass) = {best:.1%} -> gate {'PASSES' if best>=0.60 else 'still fails'}")
    print("  => the gate CAN say yes. It says no to ORB/MR because they have no edge.")

if __name__ == "__main__":
    main()

