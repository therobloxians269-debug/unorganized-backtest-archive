"""QT locates the rejection block (the Q2 manipulation extreme).
   CISD and/or PSP time the entry inside Q3.  Target 6R."""
import pandas as pd, numpy as np, warnings; warnings.filterwarnings('ignore')
FLAT=1019
def prep(df):
    o=df.copy(); m=(o.index.hour*60+o.index.minute).values
    o['minofday']=m; m18=(m-1080+1440)%1440
    o['m18']=m18; o['sess']=m18//360; o['qs']=(m18//90)%4
    o['skey']=o['daycycle'].astype(str)+'_'+o['sess'].astype(str)
    r=o.resample('60min',label='left',closed='left').agg({'h':'max','l':'min','c':'last'}).dropna()
    tr=pd.concat([r.h-r.l,(r.h-r.c.shift()).abs(),(r.l-r.c.shift()).abs()],axis=1).max(axis=1)
    o['atr60']=tr.rolling(14).mean().shift(1).reindex(o.index,method='ffill')
    # CISD levels on the chart timeframe
    op=o.o.values; cl=o.c.values; n=len(o)
    cb=np.full(n,np.nan); cs=np.full(n,np.nan)
    up=np.nan; dn=np.nan; fu=np.nan; fd=np.nan
    for i in range(n):
        if cl[i]>op[i]:
            up=op[i] if np.isnan(up) else up
            if not np.isnan(dn): fd=dn; dn=np.nan
        elif cl[i]<op[i]:
            dn=op[i] if np.isnan(dn) else dn
            if not np.isnan(up): fu=up; up=np.nan
        cb[i]=up if not np.isnan(up) else fu     # bearish CISD level
        cs[i]=dn if not np.isnan(dn) else fd     # bullish CISD level
    o['cisd_bear']=cb; o['cisd_bull']=cs
    # PSP: new 3-bar extreme that ES or YM does NOT confirm
    h=o.h.values; l=o.l.values
    eh=o.es_high.values; el=o.es_low.values; yh=o.ym_high.values; yl=o.ym_low.values
    pb=np.zeros(n,bool); ps=np.zeros(n,bool)
    for i in range(2,n):
        if h[i]>max(h[i-1],h[i-2]) and (eh[i]<=max(eh[i-1],eh[i-2]) or yh[i]<=max(yh[i-1],yh[i-2])): pb[i]=True
        if l[i]<min(l[i-1],l[i-2]) and (el[i]>=min(el[i-1],el[i-2]) or yl[i]>=min(yl[i-1],yl[i-2])): ps[i]=True
    o['psp_bear']=pb; o['psp_bull']=ps
    return o

def blocks_from_qt(b, min_sweep=0.05, need_reclaim=True):
    """the rejection block IS the Q2 manipulation extreme."""
    out=[]
    for sk,g in b.groupby('skey',sort=True):
        q={i:v for i,v in g.groupby('qs')}
        if 0 not in q or 1 not in q or 2 not in q: continue
        if len(q[0])<45 or len(q[1])<45 or len(q[2])<30: continue
        a=g.atr60.iloc[0]
        if not np.isfinite(a) or a<=0: continue
        q1h,q1l=q[0].h.max(),q[0].l.min()
        swU=q[1].h.max()>q1h+min_sweep*a
        swD=q[1].l.min()<q1l-min_sweep*a
        if swU==swD: continue
        if need_reclaim:
            if swU and q[1].c.iloc[-1]>q1h: continue
            if swD and q[1].c.iloc[-1]<q1l: continue
        d=-1 if swU else 1
        # block = body-to-wick of the extreme Q2 bar
        seg=q[1]
        j=seg.h.idxmax() if swU else seg.l.idxmin()
        row=seg.loc[j]
        top=row.h if swU else min(row.o,row.c)
        bot=max(row.o,row.c) if swU else row.l
        out.append(dict(skey=sk,dir=d,top=top,bot=bot,ext=row.h if swU else row.l,
                        TSO=q[1].o.iloc[0],atr=a,sess=int(g.sess.iloc[0]),
                        i0=b.index.get_loc(q[2].index[0]),
                        i1=b.index.get_loc(q[2].index[-1])))
    return pd.DataFrame(out)

def trade(b,B,trigger='cisd',rr=6.0,buf=2.0,max_hold=270,pv=20.,comm=4.,slip=0.25,
          tso_filter=0,extend_q=1,displace=None,seed=0,max_stop_atr=2.5):
    o,h,l,c=b.o.values,b.h.values,b.l.values,b.c.values
    m=b['minofday'].values; n=len(b)
    cb=b.cisd_bear.values; cs=b.cisd_bull.values
    pb=b.psp_bear.values; pp=b.psp_bull.values
    rng=np.random.default_rng(seed); out=[]
    for _,z in B.iterrows():
        d=int(z.dir); ext=z.ext; tso=z.TSO
        if displace is not None:
            sh=displace*(1 if rng.random()<.5 else -1); ext+=sh; tso+=sh
        i0=int(z.i0); i1=min(int(z.i1)+int(extend_q*90),n-3)
        j=None
        for k in range(i0,i1):
            if FLAT<=m[k]<1080: break
            ok=False
            if trigger in ('cisd','either','both'):
                lv=cb[k] if d==-1 else cs[k]
                fired=(not np.isnan(lv)) and ((c[k]<lv) if d==-1 else (c[k]>lv)) and \
                      ((c[k-1]>=lv) if d==-1 else (c[k-1]<=lv))
                ok=fired
            if trigger=='psp': ok=(pb[k] if d==-1 else pp[k])
            elif trigger=='either': ok=ok or (pb[k] if d==-1 else pp[k])
            elif trigger=='both': ok=ok and (pb[k] if d==-1 else pp[k])
            if ok: j=k; break
        if j is None or j+2>=n: continue
        ep=o[j+1]+(slip if d==1 else -slip)
        if tso_filter==1:
            if (d==1 and ep>=tso) or (d==-1 and ep<=tso): continue
        elif tso_filter==-1:
            if (d==1 and ep<=tso) or (d==-1 and ep>=tso): continue
        st=(ext-buf) if d==1 else (ext+buf)
        if (d==1 and st>=ep) or (d==-1 and st<=ep): continue
        risk=abs(ep-st)
        if risk<1.0 or risk>max_stop_atr*z.atr: continue
        tg=ep+rr*risk if d==1 else ep-rr*risk
        e=min(j+1+max_hold,n); mm=m[j+1:e]
        fl=np.where((mm>=FLAT)&(mm<1080))[0]
        e2=j+1+int(fl[0]) if len(fl) else e
        hs=h[j+1:e2]; ls=l[j+1:e2]
        if len(hs)==0: continue
        sh_=(hs>=st) if d==-1 else (ls<=st)
        th=(ls<=tg) if d==-1 else (hs>=tg)
        si=int(sh_.argmax()) if sh_.any() else 10**9
        ti=int(th.argmax()) if th.any() else 10**9
        if si==10**9 and ti==10**9: k2=e2-1; px=o[k2]; w='time'
        elif si<=ti: k2=j+1+si; px=st+(slip if d==-1 else -slip); w='stop'
        else: k2=j+1+ti; px=tg; w='tgt'
        pts=(ep-px) if d==-1 else (px-ep)
        out.append(dict(t=b.index[j+1],d=d,R=(pts*pv-comm)/(risk*pv),
                        pnl=pts*pv-comm,why=w,risk=risk))
    return pd.DataFrame(out)

