"""Factory substrate: continuous FRONT-MONTH ES 1-minute series, full 24h session,
2010-2026, from the cached outrights parquet (built once by validate_mim_real).

Conventions (match validate_mim_real.py, verified there):
  * bars are right-labeled: ts_event + 1min = bar close time; converted to ET.
  * CME session: 18:00 ET -> 17:00 ET next day; session_date = calendar date of the
    17:00 close, computed as (et + 6h).date().
  * front month per session = outright contract with max session volume (no spreads).
  * NO roll back-adjustment: strategies here are strictly intraday (enter+exit within
    one session), and cross-session features (gap, prev close) must be computed against
    the SAME contract's previous-session close - provided here as per-session metadata.

Output: data/es_front_1m.parquet with columns
  et (index, tz America/New_York), session_date, symbol, open, high, low, close, volume,
plus per-session table data/es_front_sessions.parquet with
  session_date, symbol, prev_close_same (prev-session close of the SAME contract),
  session_open, session_close, rth_open (first bar close after 09:30), n_bars.

    PYTHONPATH=. python3 -m research.factory.data1m
"""
from __future__ import annotations

from pathlib import Path

import numpy as np
import pandas as pd

ROOT = Path(__file__).resolve().parents[2]
OUTRIGHTS = ROOT / "data" / "es_outright_1m.parquet"
OUT_BARS = ROOT / "data" / "es_front_1m.parquet"
OUT_SESS = ROOT / "data" / "es_front_sessions.parquet"


def main() -> None:
    df = pd.read_parquet(OUTRIGHTS)
    et = (pd.DatetimeIndex(pd.to_datetime(df["ts_event"], utc=True))
          + pd.Timedelta(minutes=1)).tz_convert("America/New_York")
    df = df.assign(et=et)
    df["session_date"] = (df["et"] + pd.Timedelta(hours=6)).dt.date
    print(f"outright rows {len(df):,} | sessions {df['session_date'].nunique():,}")

    # front month per session = max-volume outright that session
    vol = df.groupby(["session_date", "instrument_id"])["volume"].sum()
    front_iid = vol.groupby(level=0).idxmax().map(lambda t: t[1])  # session -> iid
    front_map = front_iid.to_dict()
    keep = df["instrument_id"].values == df["session_date"].map(front_map).values
    fr = df.loc[keep].sort_values("et").set_index("et")
    fr = fr[["session_date", "symbol", "instrument_id", "open", "high", "low", "close", "volume"]]
    print(f"front-month rows {len(fr):,}")

    # per-session metadata incl. SAME-contract previous-session close
    g = fr.groupby("session_date", sort=True)
    sess = pd.DataFrame({
        "symbol": g["symbol"].first(),
        "iid": g["instrument_id"].first(),
        "session_open": g["open"].first(),
        "session_close": g["close"].last(),
        "n_bars": g.size(),
    })
    # same-contract prev close: last close of THIS contract in the PREVIOUS session
    last_close = df.groupby(["instrument_id", "session_date"])["close"].last()
    sessions = list(sess.index)
    prev_close = []
    for i, sd in enumerate(sessions):
        if i == 0:
            prev_close.append(np.nan); continue
        prev_close.append(last_close.get((sess["iid"].iloc[i], sessions[i - 1]), np.nan))
    sess["prev_close_same"] = prev_close

    # RTH open = first bar close strictly after 09:30 ET
    tod = fr.index.time
    import datetime as dt
    rth = fr[(tod > dt.time(9, 30)) & (tod <= dt.time(16, 0))]
    sess["rth_open"] = rth.groupby("session_date")["open"].first()

    fr.drop(columns=["instrument_id"]).to_parquet(OUT_BARS)
    sess.drop(columns=["iid"]).to_parquet(OUT_SESS)
    print(f"wrote {OUT_BARS.name} ({len(fr):,} rows), {OUT_SESS.name} ({len(sess):,} sessions)")
    print(f"span {sessions[0]} -> {sessions[-1]}")
    print("prev_close_same coverage:", f"{sess['prev_close_same'].notna().mean()*100:.1f}%")


if __name__ == "__main__":
    main()

