"""
Founder Accumulation ETF Backtest (Simplified)
==============================================
Founder-led S&P 500 strategy with synthetic accumulation signal.

Usage:
    python3 backtest_simple.py
"""

import pandas as pd
import numpy as np
import yfinance as yf
from datetime import datetime, timedelta
import warnings
warnings.filterwarnings('ignore')

FOUNDER_STOCKS = [
    'NVDA', 'TSLA', 'META', 'AMZN', 'GOOG', 'MSFT', 'AAPL', 'BRK-B',
    'NFLX', 'UBER', 'ANET', 'COIN', 'SPOT', 'SNOW', 'CRWD', 'CRM',
    'PYPL', 'ADSK', 'ROKU', 'ZM', 'PANW', 'MKTX', 'FTNT'
]

HOLDINGS = 6
CAPITAL = 1000.0
START_DATE = '2010-01-01'
IS_END_DATE = '2022-12-31'
OOS_START = '2023-01-01'
OOS_END = '2026-08-10'

def fetch_prices(tickers, start, end):
    """Fetch prices for all tickers."""
    print(f"[*] Fetching prices for {len(tickers)} stocks...")
    data = {}
    for ticker in tickers:
        try:
            df = yf.download(ticker, start=start, end=end, progress=False)
            if len(df) > 0:
                data[ticker] = df['Close'].astype(float)
        except:
            pass
    print(f"[+] Loaded {len(data)} tickers\n")
    return data

def get_rebalance_dates(start, end):
    """Get 3rd Friday of each month."""
    dates = []
    current = pd.Timestamp(start).replace(day=1)
    end = pd.Timestamp(end)

    while current <= end:
        # Find fridays in this month
        fridays = []
        d = current
        while d.month == current.month:
            if d.weekday() == 4:  # Friday
                fridays.append(d)
            d += timedelta(days=1)

        if len(fridays) >= 3:
            third_friday = fridays[2]
            if current <= third_friday <= end:
                dates.append(third_friday)

        # Next month
        if current.month == 12:
            current = current.replace(year=current.year + 1, month=1)
        else:
            current = current.replace(month=current.month + 1)

    return sorted(set(dates))

def compute_accum_score(prices_dict, date):
    """
    Compute accumulation score based on price momentum and volatility.
    Surrogate for insider accumulation: high score when stock weak + low vol.
    Pattern: founders accumulate in weakness.
    """
    scores = {}

    for ticker in prices_dict:
        prices = prices_dict[ticker]
        prices_to_date = prices[prices.index <= date]

        if len(prices_to_date) < 120:
            continue

        # Lookback: 90 days
        recent_prices = prices_to_date.iloc[-90:]

        # Momentum: 90-day return (negative is good for accumulation signal)
        momentum = float((recent_prices.iloc[-1] / recent_prices.iloc[0]) - 1.0)

        # Volatility (lower = more selective accumulation)
        volatility = float(recent_prices.pct_change().std())

        # Accumulation score: negative momentum + low vol = high score
        # Score is (how much down) * (how stable)
        accum_score = -momentum / max(volatility, 0.01)  # Inverted momentum

        scores[ticker] = accum_score

    return scores

def backtest_period(prices_dict, start_date, end_date, period_name):
    """Run backtest for a period."""
    print(f"\n[PHASE] {period_name.upper()}")
    print("=" * 60)

    rebalance_dates = [d for d in get_rebalance_dates(start_date, end_date)
                       if pd.Timestamp(start_date) <= d <= pd.Timestamp(end_date)]

    print(f"Rebalance dates: {len(rebalance_dates)}")

    # Get all trading dates
    first_ticker = list(prices_dict.keys())[0]
    all_dates = prices_dict[first_ticker][
        (prices_dict[first_ticker].index >= pd.Timestamp(start_date)) &
        (prices_dict[first_ticker].index <= pd.Timestamp(end_date))
    ].index

    portfolio_value = [CAPITAL]
    dates_out = [all_dates[0]]
    positions = {}
    trades = []

    for date in all_dates:
        # Rebalance?
        if date in rebalance_dates:
            # Compute scores
            scores = compute_accum_score(prices_dict, date)
            ranked = sorted(scores.items(), key=lambda x: x[1], reverse=True)[:HOLDINGS]
            new_positions = {t: 0 for t, _ in ranked}

            # Liquidate old positions, get cash
            cash = portfolio_value[-1]
            for ticker in positions:
                if ticker not in new_positions and ticker in prices_dict:
                    try:
                        price = float(prices_dict[ticker][prices_dict[ticker].index <= date].iloc[-1])
                        shares = positions[ticker]
                        cash += shares * price
                    except:
                        pass

            # Rebalance
            for ticker, score in ranked:
                if ticker in prices_dict:
                    try:
                        price = float(prices_dict[ticker][prices_dict[ticker].index <= date].iloc[-1])
                        shares = (cash / HOLDINGS) / price if price > 0 else 0
                        new_positions[ticker] = shares
                        trades.append({'date': date, 'ticker': ticker, 'action': 'buy', 'price': price, 'score': score})
                    except:
                        pass

            positions = new_positions

        # Daily P&L
        pv = 0
        for ticker in positions:
            if ticker in prices_dict:
                try:
                    price = float(prices_dict[ticker][prices_dict[ticker].index <= date].iloc[-1])
                    pv += positions[ticker] * price
                except:
                    pass

        portfolio_value.append(pv)
        dates_out.append(date)

    # Compute stats
    pv_array = np.array(portfolio_value)
    returns = np.diff(pv_array) / pv_array[:-1]

    if len(returns) > 0:
        annual_return = (pv_array[-1] / pv_array[0]) ** (252 / len(returns)) - 1 if pv_array[0] > 0 else 0
        annual_vol = np.std(returns) * np.sqrt(252)
        sharpe = annual_return / annual_vol if annual_vol > 0 else 0

        # Max DD
        cummax = np.maximum.accumulate(pv_array)
        dd = (pv_array - cummax) / cummax
        max_dd = np.min(dd)

        calmar = annual_return / abs(max_dd) if max_dd < 0 else 0
        skew = pd.Series(returns).skew()
        total_return = (pv_array[-1] / pv_array[0]) - 1 if pv_array[0] > 0 else 0
    else:
        annual_return = annual_vol = sharpe = calmar = max_dd = skew = total_return = 0

    print(f"\nResults for {period_name}:")
    print(f"  Total Return:   {total_return:>8.2%}")
    print(f"  Annual Return:  {annual_return:>8.2%}")
    print(f"  Annual Vol:     {annual_vol:>8.2%}")
    print(f"  Sharpe Ratio:   {sharpe:>8.2f}")
    print(f"  Max Drawdown:   {max_dd:>8.2%}")
    print(f"  Calmar Ratio:   {calmar:>8.2f}")
    print(f"  Skew:           {skew:>8.2f}")
    print(f"  Trades:         {len(trades)}")

    return {
        'annual_return': annual_return,
        'annual_vol': annual_vol,
        'sharpe': sharpe,
        'calmar': calmar,
        'max_dd': max_dd,
        'skew': skew,
        'total_return': total_return
    }

def main():
    print("\n" + "=" * 60)
    print("FOUNDER ACCUMULATION ETF BACKTEST")
    print("=" * 60)

    # Fetch prices
    all_prices = fetch_prices(FOUNDER_STOCKS, START_DATE, OOS_END)

    # In-sample
    is_stats = backtest_period(all_prices, START_DATE, IS_END_DATE, 'IN-SAMPLE (2010-2022)')

    # Out-of-sample
