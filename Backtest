def make_sessions(df, feat, or_min, k_risk):
    """(start_pos, day_end_pos, R0, session_id) with R0 causal at the open."""
    out = []
    keep = []
    for i, r in feat.iterrows():
        if not r["valid"]: continue
        atr_d = r["atr_d"]
        if not np.isfinite(atr_d) or atr_d <= 0: continue
        R0 = float(np.clip(k_risk * atr_d, 10.0, 150.0))
        s = int(r["posA"]); de = int(r["close_pos"])
        if de - s < or_min + 30: continue
        out.append((s, de, R0, i))
        keep.append(i)
    return out, keep


def load(path):
    df = pd.read_parquet(path)
    df = df.sort_index()
    return df


