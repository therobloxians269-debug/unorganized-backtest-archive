          f"{'Width':>7}  {'InVA%':>6}  {'Comp5':>8}")
    print("  " + "-" * 58)
    for idx, row in sess_sample.iterrows():
        poc  = f"{row.prior_poc:.2f}"  if pd.notna(row.prior_poc) else "  n/a"
        vah  = f"{row.prior_vah:.2f}"  if pd.notna(row.prior_vah) else "  n/a"
        val  = f"{row.prior_val:.2f}"  if pd.notna(row.prior_val) else "  n/a"
        wid  = f"{row.va_width:.2f}"   if pd.notna(row.va_width)  else "  n/a"
        comp = f"{row.comp_poc:.2f}"   if pd.notna(row.comp_poc)  else "  n/a"
        print(
            f"  {int(idx):>5}  {poc:>9}  {vah:>8}  {val:>8}  "
            f"{wid:>7}  {row.in_va_pct*100:>5.1f}%  {comp:>8}"
        )

    # 5. IB classification
    print(f"\n[5/6]  Initial Balance Classification")
    print("-" * 50)

    ib_dist = (
        rth[rth["ib_complete"]]
        .groupby("rth_session_id")["ib_range_class"]
        .first()
        .value_counts()
    )
    n_sess = rth["rth_session_id"].nunique()
    for cls, cnt in ib_dist.items():
        bar = "x" * int(cnt / n_sess * 30)
        print(f"  {str(cls):>8}  {cnt:>4} / {n_sess}  {bar}")

    mean_ib = rth[rth["ib_complete"]].groupby("rth_session_id")["ib_range"].first().mean()
    print(f"\n  Mean IB range (all sessions): {mean_ib:.2f} pts")

    # 6. Schema + lookahead verification
    print(f"\n[6/6]  Schema Validation & Lookahead Tests")
    print("-" * 50)

    # Schema
    all_ok = True
    for col in MODULE3_OUTPUT_SCHEMA:
        present = col in df_m3.columns
        if not present: all_ok = False
        print(f"  {'ok' if present else 'MISSING'}  {col}")

    # Lookahead test 1: VWAP at bar T uses only bars 0..T
    print(f"\n  Lookahead test 1 - VWAP causality:")
    s25 = rth.loc[rth["rth_session_id"] == 25.0]
    if len(s25) >= 60:
        vwap_at_60  = s25.iloc[59]["vwap"]
        tp          = (s25["high"] + s25["low"] + s25["close"]) / 3.0
        manual_vwap = (
            (tp.iloc[:60] * s25["volume"].iloc[:60]).sum()
            / s25["volume"].iloc[:60].sum()
        )
        la1_ok = np.isclose(vwap_at_60, manual_vwap, rtol=1e-5)
        print(f"    VWAP at bar 59 of sess 25  : {vwap_at_60:.4f}")
        print(f"    Manual VWAP (bars 0-59)    : {manual_vwap:.4f}")
        print(f"    Test {'PASSED' if la1_ok else 'FAILED'}")

    # Lookahead test 2: prior_poc for session N = poc of session N-1
    print(f"\n  Lookahead test 2 - Prior POC causality:")
    if rth["rth_session_id"].max() >= 5:
        for test_sess in [2, 3, 4, 5]:
            s_curr  = rth.loc[rth["rth_session_id"] == float(test_sess)]
            s_prev  = rth.loc[rth["rth_session_id"] == float(test_sess - 1)]
            if len(s_curr) == 0 or len(s_prev) == 0:
                continue
            curr_prior_poc = s_curr.iloc[0]["prior_poc"]
            # Recompute prior session POC manually
            tick = float(s_prev["meta_tick_size"].iloc[0])
            vp   = _compute_session_vp(s_prev, tick)
            manual_poc = vp["poc"] if vp else np.nan
            ok = (pd.isna(curr_prior_poc) and pd.isna(manual_poc)) or \
                 np.isclose(curr_prior_poc, manual_poc, rtol=1e-4)
            print(f"    Sess {test_sess}: prior_poc={curr_prior_poc:.2f}  "
                  f"manual={manual_poc:.2f}  {'ok' if ok else 'FAIL'}")

    print(f"\n  Schema: {'ALL PRESENT' if all_ok else 'INCOMPLETE'}")

    # Final gate summary
    combined = (df_m3["signal_eligible"] & df_m3["regime_gate"]).sum()
    print(f"\n  M1+M2+M3 combined gate: {combined:,} bars "
          f"({combined/rth_mask.sum()*100:.1f}% of RTH)")

    print(f"\n{SEP}")
    print(f"  Module 3 complete.  Ready for Module 4.")
    print(f"{SEP}\n")

    return df_m3


