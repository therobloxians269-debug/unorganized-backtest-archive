"""Caporin/Ranaldo/Santucci de Magistris (2013) & Cheung (2009):
log(H) and log(L) are COINTEGRATED with vector (1,-1), so the error-correction term IS the
range. Fit a VECM in (logH, logL) and forecast tomorrow's HIGH and LOW as levels.
Train ES 2010-2017, test 2018-2026 never refitted."""
import numpy as np, pandas as pd, warnings; warnings.filterwarnings('ignore')
SCR='/private/tmp/claude-501/-Users-kaveh/d5ce5738-dd59-4ca2-bd9c-e9b02fe3107c/scratchpad'
import pickle
esday,esrth,nqday,nqrth=pickle.load(open(f'{SCR}/ladder_feats.pkl','rb'))

def prep(D):
    X=pd.DataFrame(index=D.index)
    X['lh']=np.log(D.hi); X['ll']=np.log(D.lo); X['lc']=np.log(D.cl); X['lo_']=np.log(D.o930)
    X['rng']=X.lh-X.ll                      # the cointegrating residual
    return X.dropna()

def fit_vecm(X, p=2):
    """DlogH_t = c + a*(rng_{t-1}-mu) + sum_i (b_i*DlogH_{t-i} + g_i*DlogL_{t-i}); same for L."""
    dh=X.lh.diff(); dl=X.ll.diff(); ec=X.rng.shift(1)
    cols={'ec':ec}
    for i in range(1,p+1):
        cols[f'dh{i}']=dh.shift(i); cols[f'dl{i}']=dl.shift(i)
    R=pd.DataFrame(cols); R['1']=1.0
    Z=pd.concat([R,dh.rename('yh'),dl.rename('yl')],axis=1).dropna()
    A=Z[list(R.columns)].values
    bh=np.linalg.lstsq(A,Z.yh.values,rcond=None)[0]
    bl=np.linalg.lstsq(A,Z.yl.values,rcond=None)[0]
    return list(R.columns), bh, bl, p

def predict(X, cols, bh, bl, p):
    dh=X.lh.diff(); dl=X.ll.diff(); ec=X.rng.shift(1)
    c={'ec':ec}
    for i in range(1,p+1):
        c[f'dh{i}']=dh.shift(i); c[f'dl{i}']=dl.shift(i)
    R=pd.DataFrame(c); R['1']=1.0
    A=R[cols]
    ph=X.lh.shift(1)+A.values@bh
    pl=X.ll.shift(1)+A.values@bl
    return pd.DataFrame({'ph':np.exp(ph),'pl':np.exp(pl)},index=X.index)

for D,tag,tr_end in [(esday,'ES',2017),(nqday,'NQ',None)]:
    X=prep(D)
    if tr_end:
        TR=X[X.index.year<=tr_end]; TE=X[X.index.year>tr_end]
    else:
        TR=X[X.index.year<=2024]; TE=X[X.index.year>2024]
    cols,bh,bl,p=fit_vecm(TR)
    P=predict(X,cols,bh,bl,p).reindex(TE.index)
    act_h=np.exp(TE.lh); act_l=np.exp(TE.ll)
    # benchmarks: yesterday's H/L, and open +- ADR/2
    nv_h=np.exp(TE.lh.shift(1)); nv_l=np.exp(TE.ll.shift(1))
    ok=P.ph.notna()&nv_h.notna()
    mae_m=( (P.ph-act_h).abs()+(P.pl-act_l).abs() )[ok].mean()/2
    mae_n=( (nv_h-act_h).abs()+(nv_l-act_l).abs() )[ok].mean()/2
    rr=(P.ph-P.pl)[ok]; ra=(act_h-act_l)[ok]
    print(f'=== {tag}  train n={len(TR)}  test n={ok.sum()} ({TE.index[0].date()}..{TE.index[-1].date()}) ===')
    print(f'  EC coefficient on the range:  dH {bh[cols.index("ec")]:+.4f}   dL {bl[cols.index("ec")]:+.4f}')
    print(f'  MAE of the H/L level forecast : model {mae_m:8.2f} pts   naive(prev H/L) {mae_n:8.2f} pts   '
          f'improvement {100*(1-mae_m/mae_n):+5.1f}%')
    print(f'  forecast range vs realised    : corr {rr.corr(ra):+.3f}   mean fc {rr.mean():7.2f}  actual {ra.mean():7.2f}')
    print(f'  P(actual HIGH  <= forecast H) : {(act_h[ok]<=P.ph[ok]).mean()*100:5.1f}%')
    print(f'  P(actual LOW   >= forecast L) : {(act_l[ok]>=P.pl[ok]).mean()*100:5.1f}%')
    print(f'  P(price touches forecast H)   : {(act_h[ok]>=P.ph[ok]).mean()*100:5.1f}%')
    print(f'  P(price touches forecast L)   : {(act_l[ok]<=P.pl[ok]).mean()*100:5.1f}%')
    print()

