            i += 1
            continue
        fired_today += 1
        best = e
        exit_px = None
        j = i + 1
        while j < n and sdate[j] == sdate[i] and tmin[j] <= FLAT_MIN:
            if (side == "short" and nq_h[j] >= stop) or (side == "long" and nq_l[j] <= stop):
                exit_px = stop
                break
            best = min(best, nq_l[j]) if side == "short" else max(best, nq_h[j])
            gain = (e - best) if side == "short" else (best - e)
            if gain > 0:
                ns = best + trail_atr * atr[j] if side == "short" else best - trail_atr * atr[j]
                stop = min(stop, ns) if side == "short" else max(stop, ns)
