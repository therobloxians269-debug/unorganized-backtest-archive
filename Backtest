#!/usr/bin/env python3
"""
mnq_adaptive.py — adaptive trend/mean-reversion switcher for MNQ (user thesis:
"catch trends AND mean reversions"). Regime = Kaufman Efficiency Ratio (ER):
high ER = trending -> trade continuation of the net move, hold to session close;
low ER = choppy -> fade z-score stretch back to the rolling mean.
Everything causal: signal at bar close, enter next bar open, flat by close.

Data: NQ=F hourly (Yahoo, ~2.4y) at MNQ economics ($2/pt, $2.2 RT).
Cross-check: identical logic on 9y of real ES 1m (15m bars) at MES economics —
if the construction is real it should survive there too (or at least not be
strongly negative), and per the thesis it should be BETTER on NQ.
"""
import ssl, certifi, urllib.request, json
import numpy as np, pandas as pd

def yahoo(sym, interval='1h', rng='730d'):
    ctx = ssl.create_default_context(cafile=certifi.where())
    url = f"https://query1.finance.yahoo.com/v8/finance/chart/{sym}?range={rng}&interval={interval}"
    req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
    d = json.load(urllib.request.urlopen(req, timeout=60, context=ctx))
    r = d['chart']['result'][0]; q = r['indicators']['quote'][0]
    df = pd.DataFrame({'o': q['open'], 'h': q['high'], 'l': q['low'], 'c': q['close'], 'v': q['volume']},
                      index=pd.to_datetime(r['timestamp'], unit='s', utc=True)).dropna()
    df.index = df.index.tz_convert('America/New_York')
    return df

def us_bars(df, h0=9, h1=15):
    return df[(df.index.hour >= h0) & (df.index.hour <= h1)].copy()

def run(df, pv, rt, K, er_hi, er_lo, z_in, label, split_frac=0.6):
    df = df.copy()
    c = df['c'].to_numpy(); o = df['o'].to_numpy(); n = len(df)
    day = df.index.normalize()
    dc = np.abs(np.diff(c, prepend=c[0]))
    net = np.abs(c - np.roll(c, K)); net[:K] = np.nan
    den = pd.Series(dc).rolling(K).sum().to_numpy()
    er = net / np.where(den > 1e-9, den, np.nan)
    sma = pd.Series(c).rolling(K).mean().to_numpy()
    sd = pd.Series(c).rolling(K).std().to_numpy()
    z = (c - sma) / np.where(sd > 1e-9, sd, np.nan)
    last_of = {}
    for i in range(n): last_of[day[i]] = i
    trades = []   # (ts, leg, pnl)
    i = K
    while i < n - 1:
        e = i + 1
        if day[e] != day[i]: i += 1; continue
        eod = last_of[day[i]]
        leg = None; dirn = 0; x = eod
        if np.isfinite(er[i]) and er[i] >= er_hi:
            dirn = 1 if c[i] > c[i - K] else -1
            leg = 'trend'; x = eod                        # ride to close
        elif np.isfinite(er[i]) and er[i] <= er_lo and np.isfinite(z[i]) and abs(z[i]) >= z_in:
            dirn = -1 if z[i] > 0 else 1
            leg = 'mr'
            x = eod
            for k in range(e, eod + 1):                   # exit when z crosses 0
                if np.isfinite(z[k]) and z[k] * z[i] <= 0:
                    x = k; break
        if leg is None or x <= e - 1: i += 1; continue
        pnl = dirn * (c[x] - o[e]) * pv - rt
        trades.append((df.index[i], leg, pnl))
        i = x + 1
    if not trades:
        print(f"{label}: no trades"); return
    t = pd.DataFrame(trades, columns=['ts', 'leg', 'pnl'])
    cut = t['ts'].iloc[int(len(t) * split_frac)]
    days_n = t['ts'].dt.normalize().nunique()
    def seg(x, tag):
        p = x['pnl'].to_numpy()
        if len(p) < 10: return f"{tag}: n<10"
        return (f"{tag} N={len(p)} exp=${p.mean():+.2f} t={p.mean()/p.std()*np.sqrt(len(p)):+.2f} "
                f"win={100*(p>0).mean():.0f}%")
    p = t['pnl'].to_numpy()
    print(f"{label:34} N={len(p):4d} ({len(p)/days_n:.1f}/day) exp=${p.mean():+6.2f} "
          f"t={p.mean()/p.std()*np.sqrt(len(p)):+5.2f} skew={pd.Series(p).skew():+5.2f}")
    print(f"   {seg(t[t['ts'] <= cut], 'IS ')} | {seg(t[t['ts'] > cut], 'OOS')}")
    for lg, gg in t.groupby('leg'):
        print(f"   {seg(gg, 'leg:' + lg)}")

print("======== NQ=F hourly (2.4y) @ MNQ economics ========")
nq = us_bars(yahoo('NQ=F'))
for K, hi, lo, zi in [(10, 0.35, 0.20, 1.5), (7, 0.40, 0.20, 1.5), (14, 0.30, 0.15, 2.0)]:
    run(nq, 2.0, 2.2, K, hi, lo, zi, f"NQ K={K} er>{hi}/<{lo} z{zi}")

print("\n======== control: ES 15m, 9y real data @ MES economics ========")
es = pd.read_parquet("/Users/kaveh/omni_x/es_front_2017_24h_1m.parquet")
es = es.rename(columns={'ts_event': 'ts'}).set_index('ts').sort_index()
es = es[~es.index.duplicated()][['open', 'high', 'low', 'close', 'volume']].astype(float)
es = (es.resample('15min', label='left', closed='left')
        .agg({'open': 'first', 'high': 'max', 'low': 'min', 'close': 'last', 'volume': 'sum'})
        .dropna(subset=['open']))
es.index = es.index.tz_convert('America/New_York')
es = es.rename(columns={'open': 'o', 'high': 'h', 'low': 'l', 'close': 'c', 'volume': 'v'})
esr = es[(es.index.hour * 60 + es.index.minute >= 570) & (es.index.hour * 60 + es.index.minute <= 945)]
for K, hi, lo, zi in [(13, 0.35, 0.20, 1.5), (26, 0.30, 0.15, 2.0)]:
    run(esr, 5.0, 2.5, K, hi, lo, zi, f"ES K={K} er>{hi}/<{lo} z{zi}")

