"""
FAMILY: sweep-reversal  (liquidity sweep + reclaim, NO SMT machinery)
=====================================================================
Entry after price sweeps a reference extreme and reverses back inside.

References tested:
  0 PD    prior day-CYCLE (18:00->16:59) high/low
  1 rPD   prior RTH (09:30-15:59) high/low
  2 ON    overnight (18:00 -> 09:29, Asia+London) high/low   [valid from 09:30]
  3 PS    prior 6h session high/low
  4 IB    initial balance 09:30-10:00 high/low               [valid from 10:00]
  5 PW    prior week high/low

Mechanics (upper side / SHORT; mirrored for lower/LONG):
  arm      : last close was <= L
  sweep    : bar high > L + pen           (pen = pen_frac * dayvol)
  reclaim  : a bar closes back < L within N bars of the sweep bar
  entry    : NEXT bar open after the reclaim bar
  stop     : max high reached during the sweep + stopbuf (stopbuf_frac * dayvol)
  target   : entry -/+ rr * risk
  exit     : stop / target / maxhold bars / forced flat at day-cycle end (16:59)
  ties     : if stop and target both touched inside one bar -> STOP fills first

Costs (mandatory):
  NQ  pv=20 comm $4.00 RT slip 0.25pt adverse on entry and on stop/time exits
  MNQ pv=2  comm $1.50 RT same slippage in points
  Target exits fill at the limit (no slippage). Time exits ARE charged slippage
  (market order) - stricter than the spec minimum.

Splits: IS = NQ 2023-01-01..2024-12-31 | OOS1 = NQ 2025 | OOS2 = MNQ 2026
Tuning happens on IS ONLY.
"""
import sys, json, math, datetime
import numpy as np
import pandas as pd
from numba import njit

pd.set_option('display.width', 220)
pd.set_option('display.max_columns', 60)
pd.set_option('display.max_rows', 200)

NREF = 6
REFNAMES = ['PD', 'rPD', 'ON', 'PS', 'IB', 'PW']

# ------------------------------------------------------------------ prep

def prep(path, is_mnq):
    df = pd.read_parquet(path)
    df = df.sort_index()
    df['dc'] = pd.to_datetime(pd.Series(df['daycycle'].values, index=df.index).astype(str))
    dcodes, duniq = pd.factorize(df['dc'], sort=True)
    df['day_id'] = dcodes
    ts = df.index
    df['tmin'] = ts.hour * 60 + ts.minute          # minute of calendar day (ET)
    df['cal'] = ts.tz_localize(None).normalize()   # calendar day for RTH grouping (naive)

    n = len(df)
    o = df['o'].to_numpy(np.float64); h = df['h'].to_numpy(np.float64)
    l = df['l'].to_numpy(np.float64); c = df['c'].to_numpy(np.float64)
    day_id = df['day_id'].to_numpy(np.int64)
    tmin = df['tmin'].to_numpy(np.int64)
    sess = df['sess'].to_numpy(np.int64)

    # ---- per-day-cycle aggregates
    g = df.groupby('day_id')
    cyc_hi = g['h'].max(); cyc_lo = g['l'].min()
    ndays = len(cyc_hi)
    cyc_range = (cyc_hi - cyc_lo).to_numpy(np.float64)

    # dayvol = mean of the PRIOR 14 cycle ranges (strictly causal, known at 18:00)
    s = pd.Series(cyc_range)
    dv_day = s.shift(1).rolling(14, min_periods=3).mean()
    dv_day = dv_day.bfill().to_numpy(np.float64)   # bfill only touches the first <=3 cycles of the file
    dayvol = dv_day[day_id]

    # ---- ref 0: prior day-cycle high/low
    pdh = np.full(ndays, np.nan); pdl = np.full(ndays, np.nan)
    pdh[1:] = cyc_hi.to_numpy()[:-1]; pdl[1:] = cyc_lo.to_numpy()[:-1]

    # ---- ref 1: prior RTH (09:30-15:59 of previous calendar trading day)
    rth_mask = (tmin >= 570) & (tmin < 960)
    rdf = df[rth_mask]
    rhi = rdf.groupby('cal')['h'].max(); rlo = rdf.groupby('cal')['l'].min()
    rhi_prev = rhi.shift(1); rlo_prev = rlo.shift(1)
    # each day_id's RTH sits on the calendar day AFTER the 18:00 anchor.
    dc_cal = df.groupby('day_id')['cal'].max()      # last calendar day inside the cycle == the RTH day
    rpdh = rhi_prev.reindex(dc_cal.values).to_numpy(np.float64)
    rpdl = rlo_prev.reindex(dc_cal.values).to_numpy(np.float64)

    # ---- ref 2: overnight high/low (18:00 -> 09:29 inside the cycle)
    on_mask = ~rth_mask & ~((tmin >= 960) & (tmin < 1020))   # exclude 16:00-16:59 too
    on_mask = (tmin >= 1080) | (tmin < 570)                  # 18:00-23:59 or 00:00-09:29
    odf = df[on_mask]
    onh = odf.groupby('day_id')['h'].max().reindex(range(ndays)).to_numpy(np.float64)
    onl = odf.groupby('day_id')['l'].min().reindex(range(ndays)).to_numpy(np.float64)

    # ---- ref 5: prior week high/low  (ISO week of the cycle's RTH calendar day)
    wk = pd.Series(pd.to_datetime(dc_cal.values)).dt.to_period('W')
    wdf = pd.DataFrame({'wk': wk.values, 'hi': cyc_hi.to_numpy(), 'lo': cyc_lo.to_numpy()})
    whi = wdf.groupby('wk')['hi'].max(); wlo = wdf.groupby('wk')['lo'].min()
    whi_prev = whi.shift(1); wlo_prev = wlo.shift(1)
    pwh = whi_prev.reindex(wdf['wk'].values).to_numpy(np.float64)
    pwl = wlo_prev.reindex(wdf['wk'].values).to_numpy(np.float64)

    # ---- ref 3: prior 6h session high/low (previous sesskey in time order)
    skey = df['sesskey'].to_numpy()
    schg = np.empty(n, np.bool_); schg[0] = True
    schg[1:] = skey[1:] != skey[:-1]
    sidx = np.cumsum(schg) - 1
    sdf = pd.DataFrame({'si': sidx, 'h': h, 'l': l})
    shi = sdf.groupby('si')['h'].max().to_numpy(); slo = sdf.groupby('si')['l'].min().to_numpy()
    pshi = np.full(len(shi), np.nan); pslo = np.full(len(slo), np.nan)
    pshi[1:] = shi[:-1]; pslo[1:] = slo[:-1]

    # ---- ref 4: initial balance 09:30-10:00 (built causally, valid from 10:00)
    ib_mask = (tmin >= 570) & (tmin < 600)
    idf = df[ib_mask]
    ibh = idf.groupby('day_id')['h'].max().reindex(range(ndays)).to_numpy(np.float64)
    ibl = idf.groupby('day_id')['l'].min().reindex(range(ndays)).to_numpy(np.float64)

    # ---- assemble per-bar level matrices
    levU = np.full((n, NREF), np.nan); levL = np.full((n, NREF), np.nan)
    levU[:, 0] = pdh[day_id];  levL[:, 0] = pdl[day_id]
    levU[:, 1] = rpdh[day_id]; levL[:, 1] = rpdl[day_id]
    on_valid = (tmin >= 570) & (tmin < 1020)                  # only usable 09:30-16:59, after ON closes
    levU[on_valid, 2] = onh[day_id][on_valid]; levL[on_valid, 2] = onl[day_id][on_valid]
    levU[:, 3] = pshi[sidx];   levL[:, 3] = pslo[sidx]
    ib_valid = (tmin >= 600) & (tmin < 1020)
    levU[ib_valid, 4] = ibh[day_id][ib_valid]; levL[ib_valid, 4] = ibl[day_id][ib_valid]
    levU[:, 5] = pwh[day_id];  levL[:, 5] = pwl[day_id]

    # ---- day-cycle end index (last bar of the cycle == forced flat, <=16:59)
    last_idx = np.zeros(ndays, np.int64)
    pos = np.arange(n)
    np.maximum.at(last_idx, day_id, pos)
    day_end = last_idx[day_id]

    pack = dict(o=o, h=h, l=l, c=c, day_id=day_id, tmin=tmin, sess=sess,
                levU=levU, levL=levL, dayvol=dayvol, day_end=day_end,
                index=df.index, ndays=ndays, n=n,
                pv=2.0 if is_mnq else 20.0, comm=1.50 if is_mnq else 4.00)
    return pack


# ------------------------------------------------------------------ signal generation

@njit(cache=True)
def gen_signals(o, h, l, c, levU, levL, day_id, dayvol, day_end,
                pen_frac, N, stopbuf_frac, cooldown, maxsig):
    n = o.shape[0]; nref = levU.shape[1]
    s_bar = np.empty(maxsig, np.int64)      # ENTRY bar
    s_dir = np.empty(maxsig, np.int64)
    s_stop = np.empty(maxsig, np.float64)
    s_ref = np.empty(maxsig, np.int64)
    s_depth = np.empty(maxsig, np.float64)  # penetration beyond level / dayvol
    s_nrb = np.empty(maxsig, np.int64)      # bars taken to reclaim
    s_nsw = np.empty(maxsig, np.int64)      # prior sweeps of this level THIS cycle (0 = virgin)
    s_sig = np.empty(maxsig, np.int64)      # signal (reclaim) bar
    k = 0

    pend_u = np.zeros(nref, np.int64); pend_d = np.zeros(nref, np.int64)
    above_u = np.ones(nref, np.int64); below_d = np.ones(nref, np.int64)
    pst_u = np.zeros(nref, np.int64); pst_d = np.zeros(nref, np.int64)
    ext_u = np.zeros(nref, np.float64); ext_d = np.zeros(nref, np.float64)
    nsw_u = np.zeros(nref, np.int64); nsw_d = np.zeros(nref, np.int64)
    last_u = np.full(nref, -10 ** 8, np.int64); last_d = np.full(nref, -10 ** 8, np.int64)
    prevU = np.full(nref, np.nan); prevD = np.full(nref, np.nan)

    for i in range(1, n):
        if day_id[i] != day_id[i - 1]:
            for r in range(nref):
                nsw_u[r] = 0; nsw_d[r] = 0
        dv = dayvol[i]
        pen = pen_frac * dv
        sbuf = stopbuf_frac * dv
        for r in range(nref):
            # ================= UPPER (short) =================
            Lv = levU[i, r]
            if not np.isnan(Lv):
                if np.isnan(prevU[r]) or Lv != prevU[r]:
                    pend_u[r] = 0
                    above_u[r] = 1 if c[i - 1] > Lv else 0
                    last_u[r] = -10 ** 8
                    prevU[r] = Lv
                if pend_u[r] == 1:
                    if h[i] > ext_u[r]:
                        ext_u[r] = h[i]
                    if c[i] < Lv:
                        if k < maxsig and i + 1 <= day_end[i] and i + 1 < n:
                            s_bar[k] = i + 1; s_dir[k] = -1
                            s_stop[k] = ext_u[r] + sbuf; s_ref[k] = r
                            s_depth[k] = (ext_u[r] - Lv) / dv
                            s_nrb[k] = i - pst_u[r]; s_nsw[k] = nsw_u[r]; s_sig[k] = i
                            k += 1
                        pend_u[r] = 0; nsw_u[r] += 1; above_u[r] = 0; last_u[r] = i
                    elif (i - pst_u[r]) >= N:
                        pend_u[r] = 0; nsw_u[r] += 1; last_u[r] = i
                        above_u[r] = 1 if c[i] > Lv else 0
                else:
                    if above_u[r] == 0 and h[i] > Lv + pen and (i - last_u[r]) >= cooldown:
                        pend_u[r] = 1; pst_u[r] = i; ext_u[r] = h[i]
                        if c[i] < Lv:      # same-bar sweep + reclaim (wick rejection)
                            if k < maxsig and i + 1 <= day_end[i] and i + 1 < n:
                                s_bar[k] = i + 1; s_dir[k] = -1
                                s_stop[k] = ext_u[r] + sbuf; s_ref[k] = r
                                s_depth[k] = (ext_u[r] - Lv) / dv
                                s_nrb[k] = 0; s_nsw[k] = nsw_u[r]; s_sig[k] = i
                                k += 1
                            pend_u[r] = 0; nsw_u[r] += 1; above_u[r] = 0; last_u[r] = i
                    else:
                        above_u[r] = 1 if c[i] > Lv else 0
            else:
                pend_u[r] = 0; above_u[r] = 1; prevU[r] = np.nan

            # ================= LOWER (long) =================
            Dv = levL[i, r]
            if not np.isnan(Dv):
                if np.isnan(prevD[r]) or Dv != prevD[r]:
                    pend_d[r] = 0
                    below_d[r] = 1 if c[i - 1] < Dv else 0
                    last_d[r] = -10 ** 8
                    prevD[r] = Dv
                if pend_d[r] == 1:
                    if l[i] < ext_d[r]:
                        ext_d[r] = l[i]
                    if c[i] > Dv:
                        if k < maxsig and i + 1 <= day_end[i] and i + 1 < n:
                            s_bar[k] = i + 1; s_dir[k] = 1
                            s_stop[k] = ext_d[r] - sbuf; s_ref[k] = r
                            s_depth[k] = (Dv - ext_d[r]) / dv
                            s_nrb[k] = i - pst_d[r]; s_nsw[k] = nsw_d[r]; s_sig[k] = i
                            k += 1
                        pend_d[r] = 0; nsw_d[r] += 1; below_d[r] = 0; last_d[r] = i
                    elif (i - pst_d[r]) >= N:
                        pend_d[r] = 0; nsw_d[r] += 1; last_d[r] = i
                        below_d[r] = 1 if c[i] < Dv else 0
                else:
                    if below_d[r] == 0 and l[i] < Dv - pen and (i - last_d[r]) >= cooldown:
                        pend_d[r] = 1; pst_d[r] = i; ext_d[r] = l[i]
                        if c[i] > Dv:
                            if k < maxsig and i + 1 <= day_end[i] and i + 1 < n:
                                s_bar[k] = i + 1; s_dir[k] = 1
                                s_stop[k] = ext_d[r] - sbuf; s_ref[k] = r
                                s_depth[k] = (Dv - ext_d[r]) / dv
                                s_nrb[k] = 0; s_nsw[k] = nsw_d[r]; s_sig[k] = i
                                k += 1
                            pend_d[r] = 0; nsw_d[r] += 1; below_d[r] = 0; last_d[r] = i
                    else:
                        below_d[r] = 1 if c[i] < Dv else 0
            else:
                pend_d[r] = 0; below_d[r] = 1; prevD[r] = np.nan

    return (s_bar[:k], s_dir[:k], s_stop[:k], s_ref[:k],
            s_depth[:k], s_nrb[:k], s_nsw[:k], s_sig[:k])


# ------------------------------------------------------------------ simulation

@njit(cache=True)
def simulate(o, h, l, c, day_end, dayvol,
             sig_bar, sig_dir, sig_stop,
             rr, maxhold, slip, pv, comm,
             min_risk_f, max_risk_f, lo_bar, hi_bar):
    """One position at a time. Returns per-trade R, dollars, entry bar, exit bar, exit code."""
    m = sig_bar.shape[0]
    tR = np.empty(m, np.float64); tD = np.empty(m, np.float64)
    tEnt = np.empty(m, np.int64); tExit = np.empty(m, np.int64)
    tCode = np.empty(m, np.int64); tRisk = np.empty(m, np.float64)
    tDir = np.empty(m, np.int64); tIdx = np.empty(m, np.int64)
    k = 0
    free_at = -1
    for s in range(m):
        b = sig_bar[s]
        if b <= free_at:
            continue
        if b < lo_bar or b > hi_bar:
            continue
        d = sig_dir[s]
        ent = o[b] + slip * d
        stp = sig_stop[s]
        risk = (ent - stp) * d
        dv = dayvol[b]
        if risk <= 0:
            continue
        if risk < min_risk_f * dv or risk > max_risk_f * dv:
            continue
        tgt = ent + rr * risk * d
        end = day_end[b]
        lastb = b + maxhold
        if lastb > end:
            lastb = end
        code = 0; ex = 0.0; xb = lastb
        for j in range(b, lastb + 1):
            if d == 1:
                if l[j] <= stp:
                    ex = stp - slip; code = -1; xb = j; break
                if h[j] >= tgt:
                    ex = tgt; code = 1; xb = j; break
            else:
                if h[j] >= stp:
                    ex = stp + slip; code = -1; xb = j; break
                if l[j] <= tgt:
                    ex = tgt; code = 1; xb = j; break
        if code == 0:
            ex = c[lastb] - slip * d; xb = lastb; code = 2
        gross = (ex - ent) * d
        dollars = gross * pv - comm
        tR[k] = dollars / (risk * pv)
        tD[k] = dollars; tEnt[k] = b; tExit[k] = xb; tCode[k] = code
        tRisk[k] = risk; tDir[k] = d; tIdx[k] = s
        k += 1
        free_at = xb
    return tR[:k], tD[:k], tEnt[:k], tExit[:k], tCode[:k], tRisk[:k], tDir[:k], tIdx[:k]


# ------------------------------------------------------------------ metrics

def metrics(R, D, ent, day_id, ndays_split, pv_ref=2.0):
    n = len(R)
    if n == 0:
        return dict(n=0, avgR=0.0, tpd=0.0, wr=0.0, dpt=0.0, drop3=0.0, tstat=0.0, maxdd=0.0, total=0.0)
    avgR = float(R.mean())
    sd = float(R.std(ddof=1)) if n > 1 else 0.0
    t = avgR / (sd / math.sqrt(n)) if sd > 0 else 0.0
    srt = np.sort(R)
    drop3 = float(srt[:-3].mean()) if n > 3 else float('nan')
    eq = np.cumsum(D)
    peak = np.maximum.accumulate(np.concatenate([[0.0], eq]))
    dd = float((peak - np.concatenate([[0.0], eq])).max())
    return dict(n=int(n), avgR=avgR, tpd=n / max(ndays_split, 1), wr=float((R > 0).mean()),
                dpt=float(D.mean()), drop3=drop3, tstat=float(t), maxdd=dd, total=float(D.sum()))


def split_masks(pack):
    idx = pack['index']
    return idx


def build_splits(nq):
    idx = nq['index']
    is_m = (idx >= pd.Timestamp('2023-01-01', tz=idx.tz)) & (idx < pd.Timestamp('2025-01-01', tz=idx.tz))
    o1_m = idx >= pd.Timestamp('2025-01-01', tz=idx.tz)
    ii = np.where(is_m)[0]; oo = np.where(o1_m)[0]
    return (int(ii[0]), int(ii[-1]), len(np.unique(nq['day_id'][ii]))), \
           (int(oo[0]), int(oo[-1]), len(np.unique(nq['day_id'][oo])))


# ------------------------------------------------------------------ driver helpers

SIGCACHE = {}

def get_sigs(pack, pen, N, sbuf, cooldown=5):
    key = (id(pack), pen, N, sbuf, cooldown)
    if key not in SIGCACHE:
        SIGCACHE[key] = gen_signals(pack['o'], pack['h'], pack['l'], pack['c'],
                                    pack['levU'], pack['levL'], pack['day_id'],
                                    pack['dayvol'], pack['day_end'],
                                    pen, N, sbuf, cooldown, 400000)
    return SIGCACHE[key]


WINDOWS = {
    'FULL': (1080, 1019),        # whole cycle 18:00 -> 16:59 (wraps)
    'RTH':  (570, 930),          # 09:30 -> 15:30 entries
    'AM':   (570, 720),          # 09:30 -> 12:00
    'LDN':  (180, 570),          # 03:00 -> 09:30
    'PM':   (720, 930),          # 12:00 -> 15:30
    'LNY':  (180, 930),          # 03:00 -> 15:30
}


def win_mask(tmin_at_entry, w):
    lo, hi = WINDOWS[w]
    if w == 'FULL':
        return np.ones(len(tmin_at_entry), bool)
    return (tmin_at_entry >= lo) & (tmin_at_entry <= hi)


def run_cfg(pack, cfg, lo_bar, hi_bar, ndays):
    """cfg keys: pen,N,sbuf,refs(tuple),win,rr,maxhold,virgin,dmin,dmax,rmin,rmax"""
    sb, sd, ss, sr, sdp, snrb, snsw, ssig = get_sigs(pack, cfg['pen'], cfg['N'], cfg['sbuf'])
    tm = pack['tmin'][sb]
    m = np.isin(sr, np.array(cfg['refs']))
    m &= win_mask(tm, cfg['win'])
    m &= (sdp >= cfg.get('dmin', 0.0)) & (sdp <= cfg.get('dmax', 1e9))
    v = cfg.get('virgin', 'any')
    if v == 'virgin':
        m &= (snsw == 0)
    elif v == 'retest':
        m &= (snsw >= 1)
    if cfg.get('dir', 'both') == 'long':
        m &= (sd == 1)
    elif cfg.get('dir', 'both') == 'short':
        m &= (sd == -1)
    if not m.any():
        return None, None
    R, D, ent, xb, code, risk, dirs, tidx = simulate(
        pack['o'], pack['h'], pack['l'], pack['c'], pack['day_end'], pack['dayvol'],
        np.ascontiguousarray(sb[m]), np.ascontiguousarray(sd[m]), np.ascontiguousarray(ss[m]),
        cfg['rr'], cfg['maxhold'], 0.25, pack['pv'], pack['comm'],
        cfg.get('rmin', 0.0), cfg.get('rmax', 1e9), lo_bar, hi_bar)
    mm = metrics(R, D, ent, pack['day_id'], ndays)
    extra = dict(R=R, D=D, ent=ent, xb=xb, code=code, risk=risk, dirs=dirs,
                 sel=np.where(m)[0][tidx], sb=sb, sr=sr, sdp=sdp, snsw=snsw, snrb=snrb)
    return mm, extra

