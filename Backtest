"""
capacity.py — CAP-1: capacity-saturating probe of E[r | F_OHLCV] at h=3 (15 min).

    python capacity.py TAPE.csv --preflight      # run this FIRST. Do not skip it.
    python capacity.py TAPE.csv --fit            # fit IS, derive+freeze the gate
    python capacity.py TAPE.csv --adjudicate     # touch the holdout. ONCE.

TAPE.csv: timestamp/time/date, open, high, low, close, volume.  1-minute.  Any tz.

--------------------------------------------------------------------------------
WHAT THIS IS
--------------------------------------------------------------------------------
NOT a hand-specified family. 128 strictly-causal OHLCV features handed to a universal
approximator with purged K-fold CV. The target is VOL-NORMALISED (z = r_{t+3}/sigma_t)
because a raw-points target lets the model chase MAGNITUDE — it learns "fire when vol
is extreme", which is beta, not alpha, and it dies when you strip the crisis.
That failure was measured. This is the fix.

--------------------------------------------------------------------------------
WHAT I MEASURED ON AN INDEPENDENT TAPE (Oanda SPX500 2005-2020, 3960 sessions)
--------------------------------------------------------------------------------
  OOS IC (vol-normalised, frozen model, untouched 2017-2020) ... +0.0381
  gate |sigma*zhat| >= 1.50 pt, crisis-stripped 2017-2019 ...... 698 trades / 160 days
  gross ....................................................... 1.156 pt   sd 9.248 pt
  k_gross ..................................................... 0.125
  net @ c=0.19 ................................................ +0.966 pt
  t_naive ..................................................... 2.75   (A LIE — overlaps)
  t_DAY-CLUSTERED ............................................. 3.20   <- the honest one
  realised maxDD @ 1 MES on $1,000 ............................ 61.4%
  bootstrap maxDD ............................................. med 31% / p90 58% / p95 71%
  full-Kelly n* ............................................... 2.25 contracts (1 MES = 0.45x)
  P(ruin to $200) ............................................. 2.7%

  PROBE POWER AT TOLL SCALE ................................... 13%
  => this instrument sees ~1/8 of a 0.35pt edge. A NULL FROM IT PROVES NOTHING.
     It can find edge. It can never prove absence. Do not let it, or me, tell you
     the OHLCV class is closed.

--------------------------------------------------------------------------------
CRITICAL: B_min = 80c/k**2 DOES NOT APPLY HERE
--------------------------------------------------------------------------------
That form was derived under g = 2c (the horizon optimum). This cell runs g = 6.1c.
Use the general quarter-Kelly form:      B_min = 4 * s^2 * V / (g - c)
  s = per-trade sd (pt), V = $/pt, g = gross pt/trade, c = toll pt/trade.
For this cell @ c=0.19: B_min = 4(9.248^2)(5)/0.966 = $1,771  — NOT $973.
--------------------------------------------------------------------------------
"""
from __future__ import annotations
import sys, json, argparse, warnings
import numpy as np, pandas as pd
warnings.filterwarnings("ignore")

import lightgbm as lgb
from features import build, audit_causality

H          = 3            # 3 bars @5m = 15 min
V_PT       = 5.0          # $/pt MES
TOLL       = 0.50         # SET THIS TO YOUR ACTUAL TOLL. It is the free variable.
GATE_PT    = None         # derived in --fit, frozen to gate.json. Never hand-set.
IS_END     = "2016-12-31"
CRISIS     = [("2020-02-01", "2020-05-31")]   # PREREGISTERED strip. Add nothing later.
DD_MAX     = 30.0         # max-DD ceiling, %. THE GATE IS SELECTED ON THIS, NOT ON t.
ACCOUNT    = 1000.0

PARAMS = dict(objective="regression", learning_rate=0.05, num_leaves=63,
              min_child_samples=200, subsample=0.8, subsample_freq=1,
              colsample_bytree=0.6, reg_lambda=1.0, n_estimators=200,
              n_jobs=-1, verbose=-1)


# ───────────────────────────────────────────────────────────── data
def load(path):
    df = pd.read_csv(path)
    tc = next(c for c in df.columns if c.lower() in
              ("timestamp", "time", "date", "datetime"))
    df[tc] = pd.to_datetime(df[tc], utc=True, format="mixed")
    df = df.set_index(tc).tz_convert("America/New_York").sort_index()
    df.columns = [c.lower() for c in df.columns]
    df = df[["open", "high", "low", "close", "volume"]].astype(float)
    df = df[~df.index.duplicated(keep="first")]
    r = df.between_time("09:30", "15:59")
    r = r[r.index.dayofweek < 5]
    b5 = r.resample("5min").agg(open=("open", "first"), high=("high", "max"),
                                low=("low", "min"), close=("close", "last"),
                                volume=("volume", "sum")).dropna()
    return b5[b5.groupby(b5.index.date)["close"].transform("size") >= 60]


def targets(b5):
    c = b5["close"]; day = pd.Series(b5.index.normalize(), index=b5.index)
    fwd = (c.shift(-H) - c).to_numpy()
    same = (day.shift(-H).to_numpy() == day.to_numpy())
    y = np.where(same, fwd, np.nan)                       # POINTS
    sig = c.diff(H).rolling(78).std().to_numpy()          # causal scale
    z = y / np.where(sig > 1e-6, sig, np.nan)             # VOL-NORMALISED target
    return y, z, sig


def purged_folds(n, k, h, embargo=78):
    size = n // k
    for i in range(k):
        a, b = i * size, (n if i == k - 1 else (i + 1) * size)
        yield (np.concatenate([np.arange(0, max(0, a - h)),
                               np.arange(min(n, b + embargo), n)]), np.arange(a, b))


# ─────────────────────────────────────────────── the ONLY honest t-stat here
def clustered_t(net: pd.Series):
    """50% of h=3 trades overlap their forward windows. A naive t on them is FICTION.
    Cluster by DAY. Days are the unit of independence."""
    d = net.groupby(net.index.normalize())
    dm, w = d.mean(), d.size()
    nd = len(dm)
    mu = np.average(dm, weights=w)
    se = np.sqrt(np.average((dm - mu) ** 2, weights=w) / nd)
    return mu / se, nd


def dd_bootstrap(net_pt, B0=1000.0, n_boot=4000, seed=7):
    pnl = net_pt.to_numpy() * V_PT
    eq = B0 + np.cumsum(pnl)
    pk = np.maximum.accumulate(np.r_[B0, eq])[1:]
    realised = -((eq - pk) / pk).min() * 100
    rng = np.random.default_rng(seed); mdd = []; ruin = 0
    for _ in range(n_boot):
        e = B0 + np.cumsum(rng.choice(pnl, len(pnl), replace=True))
        if e.min() <= 0.2 * B0: ruin += 1
        p = np.maximum.accumulate(np.r_[B0, e])[1:]
        mdd.append(-((e - p) / p).min() * 100)
    mdd = np.array(mdd)
    return dict(realised=realised, med=np.median(mdd), p75=np.percentile(mdd, 75),
                p90=np.percentile(mdd, 90), p95=np.percentile(mdd, 95),
                ruin=100 * ruin / n_boot, end_equity=eq[-1])


def kelly(net_pt, gross_sd_pt, B0=1000.0):
    """full-Kelly contracts. 1 MES = 1/n* of full Kelly. DD scales ~linearly with it."""
    m = net_pt.mean() * V_PT
    v = (gross_sd_pt * V_PT) ** 2
    return m * B0 / v


def bmin(g, s, c):
    """GENERAL quarter-Kelly. NOT 80c/k^2 — that form assumes g=2c and does not hold here."""
    return 4 * s ** 2 * V_PT / (g - c) if g > c else np.inf


# ═══════════════════════════════════════════════════════════ PREFLIGHT
def preflight(b5):
    y, z, sig = targets(b5)
    F = build(b5).copy()
    ok = F.notna().all(axis=1).to_numpy() & np.isfinite(y) & np.isfinite(z)
    isx = ok & np.asarray(F.index <= pd.Timestamp(IS_END, tz="America/New_York"))
    X, zz, yy = F[isx].to_numpy(np.float32), z[isx], y[isx]
    P = lambda *a: print(*a, flush=True)
    P("=" * 78); P("PREFLIGHT — every one of these must pass before you touch a holdout")
    P("=" * 78)

    # T1 ── causality. I caught a REAL leak on my tape (on_gap / current-day ATR).
    #       Your tape is different data. Run it.
    bad = [c for s_ in (0, 1, 2) for c in audit_causality(b5, 500, s_)]
    P(f"T1 CAUSALITY   {'PASS — no feature at t sees t+1..end' if not bad else 'FAIL: '+str(set(bad))}")

    # T2 ── purge integrity: no train label window may reach into the test block
    n = len(zz); viol = 0
    for tr, te in purged_folds(n, 4, H):
        viol += int(((tr + H >= te[0]) & (tr <= te[-1])).sum())
    P(f"T2 PURGE       {'PASS — 0 label-window overlaps' if viol==0 else f'FAIL: {viol} overlaps'}")

    # T3 ── SHUFFLE TEST. Break the label→feature link. IC MUST collapse to 0.
    #       If a shuffled model still shows IC, the CV leaks and every number is fiction.
    rng = np.random.default_rng(0)
    ics = []
    for _ in range(3):
        zs = zz.copy(); rng.shuffle(zs)
        o = np.full(n, np.nan)
        for tr, te in purged_folds(n, 4, H):
            m = lgb.LGBMRegressor(**PARAMS); m.fit(X[tr], zs[tr]); o[te] = m.predict(X[te])
        ics.append(np.corrcoef(o, zs)[0, 1])
    P(f"T3 SHUFFLE     IC on shuffled labels = {np.mean(ics):+.4f} "
      f"({'PASS — collapses to 0' if abs(np.mean(ics))<0.01 else 'FAIL — CV LEAKS'})")

    # T4 ── POWER. Plant a known edge in the real noise. If power is tiny, a NULL
    #       from this probe is worthless and you must NOT conclude 'no edge'.
    cols = ["mom12", "vz12", "from_vwap", "vol24", "clv", "rng_atr"]
    Z = F[isx][cols].to_numpy(); Z = (Z - Z.mean(0)) / (Z.std(0) + 1e-9)
    s_ = np.tanh(Z[:, 0]) * Z[:, 1] + .7 * Z[:, 2] * Z[:, 3] - .5 * Z[:, 4] ** 2
    s_ = (s_ - s_.mean()) / s_.std()
    P("T4 POWER       planted -> recovered (top decile, real noise, real features)")
    base = None
    for E in (0.0, 0.35, 1.00):
        ys = yy - yy.mean() + (E / 1.755) * s_
        o = np.full(n, np.nan)
        for tr, te in purged_folds(n, 4, H):
            m = lgb.LGBMRegressor(**PARAMS); m.fit(X[tr], ys[tr])
            o[te] = pd.Series(m.predict(X[te])).rank(pct=True).to_numpy()
        top = ys[o >= 0.9].mean()
        if E == 0: base = top; P(f"                 null      -> {top:+.3f} pt  (bias floor)")
        else: P(f"                 {E:.2f} pt  -> {top-base:+.3f} pt  = {100*(top-base)/E:.0f}% POWER")
    P("\n  If power at 0.35pt is <20%, this probe is blind at toll scale. It can still")
    P("  FIND edge — it can never prove ABSENCE. Never write 'no OHLCV edge' in the ledger.")
    P("=" * 78)


# ═══════════════════════════════════════════════════════════ FIT (IS only)
def fit(b5):
    y, z, sig = targets(b5)
    F = build(b5).copy()
    ok = F.notna().all(axis=1).to_numpy() & np.isfinite(y) & np.isfinite(z)
    isx = ok & np.asarray(F.index <= pd.Timestamp(IS_END, tz="America/New_York"))
    X, zz, yy, ss = F[isx].to_numpy(np.float32), z[isx], y[isx], sig[isx]
    n = len(zz)
    o = np.full(n, np.nan)
    for tr, te in purged_folds(n, 4, H):
        m = lgb.LGBMRegressor(**PARAMS); m.fit(X[tr], zz[tr]); o[te] = m.predict(X[te])
    e = ss * o                                    # expected move, POINTS
    idx = F.index[isx]
    print(f"IS {n:,} bars   purged-OOF IC(z) = {np.corrcoef(o[np.isfinite(o)], zz[np.isfinite(o)])[0,1]:+.4f}\n")
    print(f"{'gate |E|>=':>11}{'n':>7}{'days':>6}{'/yr':>6}{'gross':>8}{'net':>8}"
          f"{'t_clust':>9}{'k':>7}{'B_min$':>9}{'xKelly':>8}{'~maxDD':>8}")
    print("-" * 88)
    print("  xKelly = what 1 MES on $1,000 actually is.  ~maxDD ~= xKelly * 71% (full-Kelly DD).")
    print("  THE GATE IS YOUR DRAWDOWN DIAL. You cannot size below 1 contract; you can only")
    print("  trade less often and better. Pick on maxDD, not on t.")
    print("-" * 88)
    best = None
    for thr in (0.50, 0.75, 1.00, 1.25, 1.50, 2.00, 2.50):
        g = np.abs(e) >= thr
        if g.sum() < 60: continue
        gp = pd.Series(np.where(e[g] > 0, yy[g], -yy[g]), index=idx[g])
        net = gp - TOLL
        t, nd = clustered_t(net)
        s_sd = gp.std(ddof=1); B = bmin(gp.mean(), s_sd, TOLL)
        yrs = (idx[-1] - idx[0]).days / 365.25
        nk = kelly(net, s_sd); xk = 1/nk if nk > 0 else np.inf
        print(f"{thr:>11.2f}{len(gp):>7}{nd:>6}{len(gp)/yrs:>6.0f}{gp.mean():>8.3f}"
              f"{net.mean():>8.3f}{t:>9.2f}{gp.mean()/s_sd:>7.3f}{B:>9,.0f}"
              f"{xk:>8.2f}{xk*71:>7.0f}%")
        # SELECT ON DRAWDOWN, NOT ON t. Loosest gate satisfying t>=3.0 AND maxDD<=DD_MAX.
        # Maximising t would pick a 53%-DD cell. That is how you blow up a $1k account.
        if t >= 3.0 and xk * 71 <= DD_MAX and (best is None or thr < best[0]):
            best = (thr, t, xk * 71)
    print("-" * 88)
    if not best:
        print(f"\nNo IS gate clears t_clust>=3.0 AND maxDD<={DD_MAX}%. STOP. Do not open the holdout."); return
    json.dump(dict(gate=best[0], toll=TOLL, h=H), open("gate.json", "w"))
    print(f"\nFROZEN -> gate.json:  |E| >= {best[0]:.2f} pt   (IS t_clust={best[1]:.2f}, est maxDD {best[2]:.0f}%)")
    print("Do not re-run --fit after looking at the holdout. That is the whole point.")


# ═══════════════════════════════════════════════════════════ ADJUDICATE (once)
def adjudicate(b5):
    G = json.load(open("gate.json")); thr, toll = G["gate"], G["toll"]
    y, z, sig = targets(b5)
    F = build(b5).copy()
    ok = F.notna().all(axis=1).to_numpy() & np.isfinite(y) & np.isfinite(z)
    cut = pd.Timestamp(IS_END, tz="America/New_York")
