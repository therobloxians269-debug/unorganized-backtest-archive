#!/usr/bin/env python3
"""
================================================================================
Third-Friday Settlement Reversal (3FPS)  —  falsification backtest on MES MBO
================================================================================
Mechanism : option-dealer "charm" hedging into the third-Friday a.m. settlement
            (SOQ). Net delta drift forces dealers to BUY the index/futures
            overnight into expiration, creating a temporary ~14bps (monthly) /
            ~26bps (quarterly) overnight rise that REVERSES intraday by ~noon.
            Ref: Baltussen, Terstegge & Whelan (AFA 2024/25), "Option-Driven
            ... Derivative Payoff Bias / Third Friday Price Spike".

Trade     : LONG the front MES contract at Thursday RTH close (16:00 ET);
            FLIP to SHORT at Friday cash open (09:30 ET, the SOQ window);
            EXIT (flat) at Friday ~noon (12:00 ET).
            => captures (overnight rise) + (intraday reversal).

Data      : Databento MES MBO .dbn.zst (this script), or any OHLCV feed that can
            supply the three snapshot prices (swap in load_*; see feed_from_csv).

Discipline: out-of-sample split, walk-forward by year, deflated Sharpe with
            honest trial-counting, realistic retail cost model + cost sweep,
            beta-neutrality regression, and a NON-expiration-week placebo.
            Pre-registered kill conditions are checked and printed verbatim.

Author    : built for Kaveh's falsification-first research stack.
================================================================================
"""
from __future__ import annotations
import argparse, glob, sys, math, warnings
from dataclasses import dataclass, field
from datetime import datetime, timedelta, time
import numpy as np
import pandas as pd
from scipy import stats

warnings.simplefilter("ignore", category=FutureWarning)
ET = "America/New_York"
EULER = 0.5772156649015329
CME_MONTH = {1:"F",2:"G",3:"H",4:"J",5:"K",6:"M",7:"N",8:"Q",9:"U",10:"V",11:"X",12:"Z"}
MONTH_CME = {v:k for k,v in CME_MONTH.items()}

# =============================================================================
# CONFIG
# =============================================================================
@dataclass
class Config:
    data_glob: str = ""                       # e.g. "/data/mes_mbo/*.dbn.zst"
    feed_csv: str = ""                        # optional: precomputed snapshot feed
    # snapshot clock (ET)
    thu_close: time = time(16, 0)             # Thursday RTH cash close
    fri_open:  time = time(9, 30)             # Friday cash open / SOQ window
    fri_noon:  time = time(12, 0)             # intraday reversal exit
    # cost model (index points & per-side commission in points) -- RETAIL defaults
    # MES: tick=0.25pt=$1.25 ; ES: tick=0.25pt=$12.50. kappa = slippage per crossing.
    instrument: str = "MES"                   # "MES" or "ES" (scales commission->points)
    kappa_pts: float = 0.25                   # slippage per spread crossing (1 tick default)
    comm_per_side_usd: float = 0.62           # retail $/side (MES~0.62, ES~2.25)
    cost_sweep_kappa: tuple = (0.0, 0.125, 0.25, 0.375, 0.5, 0.75)
    # legs
    legs: str = "both"                        # "both" | "overnight" | "reversal"
    # statistics
    oos_split: str = "2021-01-01"             # in-sample < split <= out-of-sample
    n_trials: int = 24                        # honest trial count for deflated Sharpe
    roll_trail_days: int = 5                  # trailing-vol window for front-month roll
    front_vol_floor: float = 0.20             # min share of day's max vol to be eligible
    verbose: bool = True

POINT_VALUE = {"MES": 5.0, "ES": 50.0, "MYM": 0.5}   # $ per index point

# =============================================================================
# ANALYTICS CORE  (validated independently — see test_analytics.py)
# =============================================================================
def cycle_cost_points(kappa, phi_side, n_cross, n_sides):
    return n_cross*kappa + n_sides*phi_side

def cycle_returns(df, kappa_pts, comm_side_usd, instrument, legs="both"):
    pv = POINT_VALUE[instrument]
    phi_pts = comm_side_usd / pv                      # commission per side in index points
    out = df.copy()
    base = out["thu_close"].to_numpy(float)
    on_pnl  = out["fri_open"].to_numpy(float) - base
    rev_pnl = out["fri_open"].to_numpy(float) - out["fri_noon"].to_numpy(float)
    if legs == "both":      gross_pts, n_cross, n_sides = on_pnl + rev_pnl, 4, 4
    elif legs == "overnight": gross_pts, n_cross, n_sides = on_pnl, 2, 2
    elif legs == "reversal":  gross_pts, n_cross, n_sides = rev_pnl, 2, 2
    else: raise ValueError(legs)
    cost_pts = cycle_cost_points(kappa_pts, phi_pts, n_cross, n_sides)
    out["gross_ret"] = gross_pts / base
    out["cost_ret"]  = cost_pts / base
    out["net_ret"]   = out["gross_ret"] - out["cost_ret"]
    out["mkt_ret"]   = (out["fri_noon"].to_numpy(float) - base) / base
    return out

def basic_stats(r, ppy):
    r = np.asarray(r, float); r = r[~np.isnan(r)]; n = r.size
    if n < 2: return dict(n=n, mean=np.nan, std=np.nan, t=np.nan, sharpe_ann=np.nan,
                          hit=np.nan, ann_ret=np.nan, mdd=np.nan)
    mean, std = r.mean(), r.std(ddof=1)
    t = mean/(std/np.sqrt(n)) if std>0 else np.nan
    eq = np.cumsum(r); mdd = float((eq - np.maximum.accumulate(eq)).min())
    return dict(n=n, mean=mean, std=std, t=t,
                sharpe_ann=(mean/std)*np.sqrt(ppy) if std>0 else np.nan,
                hit=float((r>0).mean()), ann_ret=mean*ppy, mdd=mdd)

def deflated_sharpe(r, n_trials):
    r = np.asarray(r, float); r = r[~np.isnan(r)]; n = r.size
    if n < 4 or r.std(ddof=1)==0: return dict(sr=np.nan, sr0=np.nan, dsr=np.nan, p=np.nan)
    sr = r.mean()/r.std(ddof=1)
    g3 = stats.skew(r); g4 = stats.kurtosis(r, fisher=False)
    if n_trials < 2: sr0 = 0.0
    else:
        z1 = stats.norm.ppf(1-1.0/n_trials); z2 = stats.norm.ppf(1-1.0/(n_trials*np.e))
        sr0 = ((1-EULER)*z1 + EULER*z2) * np.sqrt(1.0/(n-1))
    denom = np.sqrt(1 - g3*sr + ((g4-1)/4.0)*sr**2)
    dsr_stat = (sr - sr0)*np.sqrt(n-1)/denom
    dsr = stats.norm.cdf(dsr_stat)
    return dict(sr=sr, sr0=sr0, dsr=dsr, p=1-dsr)

def beta_neutrality(net, mkt):
    y = np.asarray(net,float); x = np.asarray(mkt,float)
    m = ~(np.isnan(y)|np.isnan(x)); y,x = y[m],x[m]; n=y.size
    if n < 3: return dict(alpha=np.nan,beta=np.nan,alpha_t=np.nan,beta_t=np.nan,r2=np.nan,n=n)
    X = np.column_stack([np.ones(n), x])
    coef,*_ = np.linalg.lstsq(X, y, rcond=None)
    resid = y - X@coef; dof = n-2
    cov = (resid@resid)/dof * np.linalg.inv(X.T@X); se = np.sqrt(np.diag(cov))
    ss = ((y-y.mean())**2).sum(); r2 = 1-(resid@resid)/ss if ss>0 else np.nan
    return dict(alpha=coef[0],beta=coef[1],alpha_t=coef[0]/se[0],beta_t=coef[1]/se[1],r2=r2,n=n)

# =============================================================================
# EXPIRATION CALENDAR
# =============================================================================
def nth_weekday(year, month, weekday=4, n=3):   # weekday 4 = Friday
    d = datetime(year, month, 1)
    offset = (weekday - d.weekday()) % 7
    return (d + timedelta(days=offset + 7*(n-1))).date()

def third_fridays(start: datetime, end: datetime):
    out = []
    y, m = start.year, start.month
    while datetime(y, m, 1) <= end:
        tf = nth_weekday(y, m, 4, 3)
        if start.date() <= tf <= end.date():
            out.append((tf, m in (3,6,9,12)))   # (date, is_quarterly/triple-witching)
        m += 1
        if m > 12: m, y = 1, y+1
    return out

def second_fridays(start, end):    # placebo: non-expiration week
    out = []
    y, m = start.year, start.month
    while datetime(y, m, 1) <= end:
        sf = nth_weekday(y, m, 4, 2)
        if start.date() <= sf <= end.date(): out.append((sf, False))
        m += 1
        if m > 12: m, y = 1, y+1
    return out

# =============================================================================
# MES MBO LOADER  (Databento .dbn.zst)
# =============================================================================
def _expiry_key_from_symbol(sym: str):
    """Parse CME symbol like 'MESZ4'/'MESZ24' -> sortable int (year*12+month)."""
    if not isinstance(sym, str) or len(sym) < 4: return None
    code = sym[-2] if sym[-1].isdigit() and sym[-2] in MONTH_CME else None
    # handle 1- or 2-digit year
    tail = sym[len(sym)-1] if not sym[-2:].isdigit() else sym[-2:]
    for cut in (2,1):
        c = sym[-(cut+1)]
        if c in MONTH_CME and sym[-cut:].isdigit():
            yr = int(sym[-cut:]); yr += 2020 if yr < 50 else 1900 if yr>=50 else 0
            if cut == 1: yr = 2020 + int(sym[-1])      # single digit -> 202x
            return yr*12 + MONTH_CME[c]
    return None

def load_trades_from_dbn(data_glob: str) -> pd.DataFrame:
    """Read MES MBO files, keep TRADE events, return tidy frame in ET."""
    import databento as db
    files = sorted(glob.glob(data_glob))
    if not files:
        raise FileNotFoundError(f"no files match {data_glob!r}")
    frames = []
    for fp in files:
        store = db.DBNStore.from_file(fp)
        df = store.to_df(price_type="float", pretty_ts=True, map_symbols=True, tz="UTC")
        df = df.reset_index()
        # locate event-time column robustly
        tcol = "ts_event" if "ts_event" in df.columns else ("index" if "index" in df.columns else df.columns[0])
        df = df[df["action"] == "T"].copy()                 # trades only
        if df.empty: continue
        df["ts"] = pd.to_datetime(df[tcol], utc=True).dt.tz_convert(ET)
        sym = df["symbol"] if "symbol" in df.columns else df["instrument_id"].astype(str)
        keep = pd.DataFrame({
            "ts": df["ts"].values,
            "date": df["ts"].dt.date.values,
            "symbol": sym.values,
            "instrument_id": df["instrument_id"].values,
            "price": df["price"].astype(float).values,
            "size": df["size"].astype(float).values,
        })
        frames.append(keep)
    if not frames:
        raise ValueError("no trade events found in input files")
    t = pd.concat(frames, ignore_index=True).sort_values("ts").reset_index(drop=True)
    return t

def build_front_continuous(trades: pd.DataFrame, trail_days=5, vol_floor=0.20) -> pd.DataFrame:
    """Continuous front-month series via VOLUME-CROSSOVER roll with a monotonic
    (never-roll-backward) constraint, and an immediate advance if the current front
    goes dark. This rolls ~when the deferred contract's volume overtakes the front
    (~8 days before quarterly expiry, matching the literature) and guarantees the
    chosen contract is actually trading on Thu, Fri-open and Fri-noon of expiry week
    (no stale/dead-contract snapshots, no roll-basis contamination on quarterlies)."""
    trades = trades.copy()
    vol = (trades.groupby(["date","instrument_id"])["size"].sum()
           .unstack(fill_value=0.0).sort_index())
    iids = list(vol.columns)
    # Expiry ORDER is taken from the data: a contract that stops trading earlier expires
    # earlier. This is robust to any symbology (1- or 2-digit years, raw ids) — no parsing.
    last_vol_date = {i: vol.index[(vol[i] > 0).to_numpy().nonzero()[0].max()] for i in iids
                     if (vol[i] > 0).any()}
    # tie-break with parsed symbol month/year when available (helps when two contracts share
    # a last-trade date in sparse data), else by first-seen.
    sym_key = (trades.assign(k=trades["symbol"].map(_expiry_key_from_symbol))
               .dropna(subset=["k"]).groupby("instrument_id")["k"].first().to_dict())
    iid_key = {i: (last_vol_date.get(i, pd.Timestamp.max.date()),
                   sym_key.get(i, 0)) for i in iids}
    order_iids = sorted(iids, key=lambda i: iid_key[i])
    front_by_date = {}
    current = None
    for d in vol.index:
        today = vol.loc[d]
        if current is None or today.get(current, 0.0) <= 0:
            # (re)initialise or advance off a dark contract: nearest forward contract w/ volume
            fwd = [i for i in order_iids
                   if (current is None or iid_key[i] >= iid_key.get(current, -np.inf)) and today[i] > 0]
            if fwd:
                current = min(fwd, key=lambda i: iid_key[i])
        if current is not None:
            cur_vol = today.get(current, 0.0)
            # roll forward on a clean volume crossover by a later-expiry contract
            cand = [i for i in order_iids if iid_key[i] > iid_key[current] and today[i] > cur_vol]
            if cand:
                current = min(cand, key=lambda i: iid_key[i])   # nearest later contract that has overtaken
        front_by_date[d] = current
    trades["front_iid"] = trades["date"].map(front_by_date)
    return trades[trades["instrument_id"] == trades["front_iid"]].copy()

def _snap(day_trades: pd.DataFrame, clk: time, mode: str):
    """Return price at a target ET clock on one day's trades.
    mode='last' -> last trade at/<= clk ; mode='first' -> first trade at/>= clk."""
    if day_trades.empty: return np.nan
    secs = day_trades["ts"].dt.hour*3600 + day_trades["ts"].dt.minute*60 + day_trades["ts"].dt.second
    target = clk.hour*3600 + clk.minute*60 + clk.second
    if mode == "last":
        sel = day_trades[secs <= target]
        return float(sel["price"].iloc[-1]) if len(sel) else np.nan
    else:
        sel = day_trades[secs >= target]
        return float(sel["price"].iloc[0]) if len(sel) else np.nan

def extract_snapshots(front: pd.DataFrame, calendar, cfg: Config) -> pd.DataFrame:
    """For each expiration date build (thu_close, fri_open, fri_noon, is_quarterly).
    Thursday = the last trading day strictly before the third Friday present in data."""
    by_date = {d: g for d, g in front.groupby("date")}
    trade_dates = sorted(by_date.keys())
    rows = []
    for tf, is_q in calendar:
        if tf not in by_date:        # Friday not in data (holiday/missing)
            continue
        prior = [d for d in trade_dates if d < tf]
        if not prior: continue
        thu = prior[-1]
        if (tf - thu).days > 5:        # data gap -> skip rather than use a stale Thursday
            continue
        g_thu, g_fri = by_date[thu], by_date[tf]
        tc = _snap(g_thu, cfg.thu_close, "last")
        fo = _snap(g_fri, cfg.fri_open, "first")
        fn = _snap(g_fri, cfg.fri_noon, "last")
        if any(np.isnan([tc, fo, fn])): continue
        rows.append(dict(exp_date=tf, thu_date=thu, thu_close=tc, fri_open=fo,
                         fri_noon=fn, is_quarterly=is_q))
    return pd.DataFrame(rows)

# =============================================================================
# OPTIONAL CSV FEED (OHLCV path) — columns: exp_date,thu_close,fri_open,fri_noon,is_quarterly
# =============================================================================
def feed_from_csv(path: str) -> pd.DataFrame:
    df = pd.read_csv(path)
    df["exp_date"] = pd.to_datetime(df["exp_date"]).dt.date
    return df

# =============================================================================
# REPORTING
# =============================================================================
def _ppy(label):   # periods per year for annualisation
    return {"ALL":12, "MONTHLY-only":8, "QUARTERLY":4, "PLACEBO":12}[label]

def _print_block(label, df, cfg):
    r = cycle_returns(df, cfg.kappa_pts, cfg.comm_per_side_usd, cfg.instrument, cfg.legs)
    ppy = _ppy(label)
    g, n = basic_stats(r["gross_ret"], ppy), basic_stats(r["net_ret"], ppy)
    d = deflated_sharpe(r["net_ret"].values, cfg.n_trials)
    b = beta_neutrality(r["net_ret"].values, r["mkt_ret"].values)
    print(f"\n--- {label}  (N={g['n']}) ---")
    print(f"  GROSS  mean {g['mean']*1e4:7.2f}bps  t={g['t']:6.2f}  Sharpe(ann) {g['sharpe_ann']:6.2f}  hit {g['hit']*100:5.1f}%")
    print(f"  NET    mean {n['mean']*1e4:7.2f}bps  t={n['t']:6.2f}  Sharpe(ann) {n['sharpe_ann']:6.2f}  hit {n['hit']*100:5.1f}%  annRet {n['ann_ret']*100:5.2f}%  maxDD {n['mdd']*1e4:7.1f}bps")
    print(f"  DSR(net, {cfg.n_trials} trials) = {d['dsr']:.3f}   beta={b['beta']:+.3f} (t={b['beta_t']:+.2f})  alpha={b['alpha']*1e4:+.2f}bps (t={b['alpha_t']:+.2f})  R2={b['r2']:.3f}")
    return r, n, d, b

def run_report(snap: pd.DataFrame, placebo: pd.DataFrame, cfg: Config):
    print("="*80); print("THIRD-FRIDAY SETTLEMENT REVERSAL (3FPS) — FALSIFICATION REPORT")
    print(f"instrument={cfg.instrument}  legs={cfg.legs}  kappa={cfg.kappa_pts}pt  comm=${cfg.comm_per_side_usd}/side  OOS split={cfg.oos_split}")
    print("="*80)
    snap = snap.sort_values("exp_date").reset_index(drop=True)
    snap["year"] = pd.to_datetime(snap["exp_date"]).dt.year
    split = pd.to_datetime(cfg.oos_split).date()
    buckets = {
        "ALL": snap,
        "MONTHLY-only": snap[~snap["is_quarterly"]],
        "QUARTERLY": snap[snap["is_quarterly"]],
    }
    print("\n############ FULL SAMPLE ############")
    full = {k: _print_block(k, v, cfg) for k,v in buckets.items() if len(v)>=2}

    print("\n############ IN-SAMPLE  (< %s) ############" % cfg.oos_split)
    isamp = snap[pd.to_datetime(snap["exp_date"]).dt.date < split]
    if len(isamp)>=2: _print_block("ALL", isamp, cfg)
    print("\n############ OUT-OF-SAMPLE  (>= %s)  [decisive test] ############" % cfg.oos_split)
    oos = snap[pd.to_datetime(snap["exp_date"]).dt.date >= split]
    oos_res = _print_block("ALL", oos, cfg) if len(oos)>=2 else None
    if len(oos[oos["is_quarterly"]])>=2: _print_block("QUARTERLY", oos[oos["is_quarterly"]], cfg)

    print("\n############ PLACEBO: 2nd-Friday (NON-expiration) weeks ############")
    if len(placebo)>=2: _print_block("PLACEBO", placebo, cfg)

    print("\n############ WALK-FORWARD by year (NET, ALL expirations) ############")
    rall = cycle_returns(snap, cfg.kappa_pts, cfg.comm_per_side_usd, cfg.instrument, cfg.legs)
    yr = rall.assign(year=snap["year"]).groupby("year")["net_ret"].agg(["count","mean","sum"])
