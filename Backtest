import numpy as np, pandas as pd, warnings; warnings.filterwarnings('ignore')
from crs import build_levels, rejections
from beauty import trade_mae, one_per_day
TARGET, THRESH = 1500.0, 1000.0     # Apex 25K: $1,500 profit, $1,000 PEAK-TRAILING
def mc(daily, mics, n=20000, maxd=200, seed=1):
    rng=np.random.default_rng(seed); D=daily.values
    pas=blow=0; days=[]; d30=0
    for _ in range(n):
        eq=0.0; peak=0.0
        for d in range(maxd):
            eq+=rng.choice(D)*mics
            peak=max(peak,eq)
            if eq<=peak-THRESH: blow+=1; break
            if eq>=TARGET:
                pas+=1; days.append(d+1); d30+= (d+1)<=30; break
        else: pass
    return pas/n*100, blow/n*100, (np.median(days) if days else np.nan), d30/n*100
for nm,f,y in [('NQ 23-24','nq_v6.parquet',(2023,2024)),('NQ 2025','nq_v6.parquet',(2025,2025)),
               ('MNQ 2026','mnq_v6.parquet',(2026,2026))]:
    df=pd.read_parquet(f); LV=build_levels(df)
    R=rejections(df,LV,minConf=1)
    m=(pd.DatetimeIndex(R.t).year>=y[0])&(pd.DatetimeIndex(R.t).year<=y[1])
    t=trade_mae(df,one_per_day(R[m],df),rr=4.0,pv=2.0,comm=1.50)
    daily=t.groupby(pd.DatetimeIndex(t.t).normalize()).pnl.sum()
    print(f'--- {nm}: {len(t)} trades, {len(daily)} trading days, $/day {daily.mean():+.2f}, worst day {daily.min():+.0f} ---')
