def mc(trades, target=1500., thresh=2500., micros=1, n_sims=20000, seed=5, max_trades=400):
    """Apex-style eval: trailing threshold follows PEAK equity incl. intra-trade unrealised."""
    R=trades[['pnl','risk','peakR']].values
    rng=np.random.default_rng(seed); npass=nblow=0
    for _ in range(n_sims):
        eq=0.; peak=0.; k=0
        while k<max_trades:
            j=rng.integers(len(R))
            pnl,risk,pk=R[j]
            pnl*=micros
            # intra-trade unrealised peak (drives Apex's trailing threshold)
            up=eq+pk*risk*2.0*micros
            peak=max(peak,up,eq)
            if peak-min(eq,eq+pnl) > thresh and (peak - (eq+pnl))>thresh:
                nblow+=1; break
            eq+=pnl; peak=max(peak,eq)
            if peak-eq>thresh: nblow+=1; break
            if eq>=target: npass+=1; break
            k+=1
        else:
            pass
    return npass/n_sims, nblow/n_sims

