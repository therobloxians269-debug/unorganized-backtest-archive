"""Diversified daily time-series momentum (trend) on a free ETF basket.

Causal 12-month-momentum sign per asset, inverse-vol sized to a portfolio vol target,
net of a turnover cost. The durable, multi-asset survivor -- the opposite of fighting
intraday efficiency on one index.

    PYTHONPATH=. python3 research/daily_trend.py
"""
from __future__ import annotations

import numpy as np
import pandas as pd

from ope.validation import perf_stats

SYMS = ["SPY", "QQQ", "IWM", "EFA", "EEM", "TLT", "IEF", "GLD", "DBC", "UUP"]
LOOK, VOLWIN, TGT, COST_BP = 252, 60, 0.10, 1.0


def main() -> None:
    import yfinance as yf
    px = yf.download(SYMS, start="2006-01-01", auto_adjust=True, progress=False)["Close"]
    px = px.dropna(how="all").dropna(axis=1, thresh=int(len(px) * 0.5))
    rets = px.pct_change()
    sig = np.sign(px.pct_change(LOOK)).shift(1)                  # causal 12m trend sign
    ann_vol = (rets.rolling(VOLWIN).std() * np.sqrt(252)).shift(1)
    n_active = sig.abs().sum(axis=1).replace(0, np.nan)
    w = sig.mul(TGT, axis=0).div(n_active, axis=0) / ann_vol     # inverse-vol, vol-targeted
    w = w.clip(-1.0, 1.0)
    gross = (w * rets).sum(axis=1)
    turn = w.diff().abs().sum(axis=1)
    net = (gross - turn * COST_BP * 1e-4).dropna()
    net = net[net.index >= px.pct_change(LOOK).first_valid_index()]

    s = perf_stats(net)
    yrs = (net.index[-1] - net.index[0]).days / 365.25
    print(f"basket: {list(px.columns)}")
    print(f"period: {net.index[0].date()} -> {net.index[-1].date()} ({yrs:.1f}y), {len(net)} days\n")
    print(f"NET  Sharpe={s['sharpe']:.2f}  ann={s['ann_return']*100:.1f}%  "
          f"vol={s['ann_vol']*100:.1f}%  maxDD={s['max_drawdown']*100:.1f}%  win={s['win_rate']*100:.0f}%")
    for lab, seg in (("2006-2014", net[net.index.year <= 2014]),
                     ("2015-2021", net[(net.index.year >= 2015) & (net.index.year <= 2021)]),
                     ("2022-now ", net[net.index.year >= 2022])):
        ss = perf_stats(seg)
        print(f"  {lab}: Sharpe={ss['sharpe']:+.2f} ann={ss['ann_return']*100:+5.1f}% maxDD={ss['max_drawdown']*100:+6.1f}%")


if __name__ == "__main__":
    main()

