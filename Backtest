import pandas as pd,numpy as np,warnings; warnings.filterwarnings('ignore')
def sim(df,sig,A,minscore=0,tmso_gate=0,max_stop=15.,buf=2.,max_hold=1440,max_trades_day=2,
        tp1_R=1.0,tp1_frac=0.5,be=True,tp2_R=6.0,trail=0.0,entry_mode='market',
        point_val=20.,comm=4.,slip_ticks=1.,tick=.25):
    o,h,l,c=A['o'],A['h'],A['l'],A['c']; day,mq=A['day'],A['mq']; bs,us=A['bs'],A['us']
    n=len(o); slip=slip_ticks*tick; out=[];used={};busy=-1
    I,D,Ar=sig['i'].values,sig['d'].values,sig['arm_i'].values
    for x in range(len(I)):
        i,d,a=int(I[x]),int(D[x]),int(Ar[x])
        if i<=busy or i+2>=n: continue
        if tmso_gate and mq[i]>tmso_gate: continue
        if minscore and ((bs[i] if d==-1 else us[i])<minscore): continue
        k=day[i]
        if used.get(k,0)>=max_trades_day: continue
        stop=(max(h[a:i+1].max(),h[i])+buf) if d==-1 else (min(l[a:i+1].min(),l[i])-buf)
        if entry_mode=='market':
            entry=o[i+1]+(-slip if d==-1 else slip); j0=i+1
        else:  # limit retest back at the CISD break level, valid 30 bars
            lim=c[i]; j0=None
            for q in range(i+1,min(i+31,n)):
                if (d==-1 and h[q]>=lim) or (d==1 and l[q]<=lim): j0=q; break
            if j0 is None: continue
            entry=lim
        risk=abs(stop-entry)
        if risk>max_stop or risk<1.0: continue
        t1=entry-tp1_R*risk if d==-1 else entry+tp1_R*risk
        t2=entry-tp2_R*risk if d==-1 else entry+tp2_R*risk
        pos=1.0; real=0.0; cs=stop; got1=False; ext=entry; fills=1; why='open'
        for j in range(j0+1,min(j0+1+max_hold,n)):
            hi,lo=h[j],l[j]
            if (hi>=cs) if d==-1 else (lo<=cs):
                px=cs+(slip if d==-1 else -slip)
                real+=pos*((entry-px) if d==-1 else (px-entry))
                why='stop' if not got1 else ('be' if abs(cs-entry)<tick else 'trail'); break
            if not got1 and tp1_frac>0 and ((lo<=t1) if d==-1 else (hi>=t1)):
                real+=tp1_frac*tp1_R*risk; pos-=tp1_frac; got1=True; fills+=1
                if be: cs=entry
                if pos<=1e-9: why='tp1'; break
            if (tp1_frac==0 or got1):
                if tp2_R>0 and ((lo<=t2) if d==-1 else (hi>=t2)):
                    real+=pos*tp2_R*risk; why='tp2'; break
                if trail>0:
                    ext=min(ext,lo) if d==-1 else max(ext,hi)
                    ns=ext+trail if d==-1 else ext-trail
                    cs=min(cs,ns) if d==-1 else max(cs,ns)
        else:
            j=min(j0+max_hold,n-1); px=o[j]+(slip if d==-1 else -slip)
            real+=pos*((entry-px) if d==-1 else (px-entry)); why='time'
        net=real*point_val-comm*fills
        out.append((df.index[j0],d,risk,why,net,net/(risk*point_val),got1))
        used[k]=used.get(k,0)+1; busy=j
    return pd.DataFrame(out,columns=['t','d','risk','why','pnl','R','tp1'])

def arrs(df):
    return dict(o=df['o'].values,h=df['h'].values,l=df['l'].values,c=df['c'].values,
                day=df['daycycle'].values,mq=df['min_into_q90'].values,
                bs=df['bear_score'].values,us=df['bull_score'].values)
