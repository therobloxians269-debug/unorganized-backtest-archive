import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

def run_production_v5(df, lookback=100, deviation_mult=2.0, sl_mult=1.5, atr_lookback=14):
    """
    Full Production Script for Strategy V5: POC-Deviation Reversion
    Optimal Parameters: SL=1.5x, Lookback=100, Calculation Step=5
    """
    temp_df = df.copy()

    # 1. Efficient POC Calculation (Fair Value)
    poc_series = []
    for i in range(len(temp_df)):
        if i < lookback or i % 5 != 0:
            poc_series.append(np.nan)
            continue
        
        window = temp_df.iloc[i-lookback:i]
        # Inline POC calculation for speed
        price_min, price_max = window['Low'].min(), window['High'].max()
        bins = np.linspace(price_min, price_max, 51)
        v_profile = np.zeros(50)
        
        for _, bar in window.iterrows():
            mask = (bins[:-1] <= bar['High']) & (bins[1:] >= bar['Low'])
            if mask.any(): v_profile[mask] += bar['Volume'] / mask.sum()
            
        poc_series.append((bins[np.argmax(v_profile)] + bins[np.argmax(v_profile)+1]) / 2)

    temp_df['POC'] = pd.Series(poc_series, index=temp_df.index).ffill()

    # 2. ATR Calculation (Volatility/Risk)
    hl = temp_df['High'] - temp_df['Low']
    hc = np.abs(temp_df['High'] - temp_df['Close'].shift())
    lc = np.abs(temp_df['Low'] - temp_df['Close'].shift())
    temp_df['ATR'] = pd.concat([hl, hc, lc], axis=1).max(axis=1).rolling(atr_lookback).mean()

    # 3. Leak-Proof Signal Processing
    temp_df['Sig_POC'] = temp_df['POC'].shift(1)
    temp_df['Sig_ATR'] = temp_df['ATR'].shift(1)
    temp_df['Prev_Close'] = temp_df['Close'].shift(1)
    
    temp_df = temp_df.dropna()
    trades, equity = [], [1000]
    pos, bal = 0, 1000

    # 4. Backtest Execution Loop
    for i in range(len(temp_df)):
        row = temp_df.iloc[i]
        
        if pos == 0: # Entry Logic
            deviation = row['Sig_POC'] - row['Prev_Close']
            if deviation > (row['Sig_ATR'] * deviation_mult):
                pos, entry = 1, row['Open']
                sl = entry - (row['Sig_ATR'] * sl_mult)
                tp = row['Sig_POC']
        
        elif pos == 1: # Exit Logic
            if row['Low'] <= sl:
                pnl = (sl - entry) * 5 - 6.40
                bal += pnl; trades.append(pnl); pos = 0
            elif row['High'] >= tp:
                pnl = (tp - entry) * 5 - 6.40
                bal += pnl; trades.append(pnl); pos = 0
        
        equity.append(bal)

    return trades, equity

