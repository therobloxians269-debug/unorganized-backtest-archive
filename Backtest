"""
Performance & risk analytics — the institutional due-diligence battery.

Fully shown (this is methodology, not Core IP): perf stats, rolling Sharpe, drawdown episodes,
monthly distribution, tail risk (VaR/CVaR/skew/kurtosis), return & risk contribution, correlation
stability, sensitivity/slippage re-runs, Monte-Carlo block bootstrap, and the deflated Sharpe ratio.

Everything operates on plain return Series/DataFrames, so it can grade ANY strategy — the redacted
sleeves are not required to run or read this module.
"""
from __future__ import annotations

import numpy as np
import pandas as pd
from scipy.stats import kurtosis, norm, skew

ANN = 365  # crypto-inclusive calendar; pass 252 for equity-only series
EULER = 0.5772156649015329


# ───────────────────────────────────────────────────────────── core stats
def max_drawdown(r: pd.Series) -> float:
    eq = (1 + r).cumprod()
    return float((eq / eq.cummax() - 1).min())


def perf_stats(r: pd.Series, ppy: int = ANN) -> dict:
    r = r.dropna()
    if len(r) < 5 or r.std() == 0:
        return dict(cagr=0, vol=0, sharpe=0, sortino=0, calmar=0, maxdd=0)
    yrs = len(r) / ppy
    cagr = (1 + r).prod() ** (1 / yrs) - 1
    vol = r.std() * np.sqrt(ppy)
    sharpe = r.mean() / r.std() * np.sqrt(ppy)
    downside = r[r < 0].std()
    sortino = r.mean() / downside * np.sqrt(ppy) if downside > 0 else np.nan
    dd = max_drawdown(r)
    return dict(cagr=cagr, vol=vol, sharpe=sharpe, sortino=sortino,
                calmar=cagr / abs(dd) if dd < 0 else np.nan, maxdd=dd)


def probabilistic_sharpe(r: pd.Series, sr_star_ann: float = 0.0, ppy: int = ANN) -> float:
    r = r.dropna().values
    n = len(r)
    if n < 10 or r.std() == 0:
        return np.nan
    sr = r.mean() / r.std()
    sk, ku = pd.Series(r).skew(), pd.Series(r).kurt() + 3
    denom = np.sqrt(1 - sk * sr + (ku - 1) / 4 * sr ** 2)
    return float(norm.cdf((sr - sr_star_ann / np.sqrt(ppy)) * np.sqrt(n - 1) / denom))


def deflated_sharpe(r: pd.Series, n_trials: int, sr_trial_var_ann: float, ppy: int = ANN) -> float:
    v = sr_trial_var_ann / ppy
    if v <= 0 or n_trials < 2:
        return probabilistic_sharpe(r, 0.0, ppy)
    e1, e2 = norm.ppf(1 - 1 / n_trials), norm.ppf(1 - 1 / (n_trials * np.e))
    sr_star = np.sqrt(v) * ((1 - EULER) * e1 + EULER * e2)
    return probabilistic_sharpe(r, sr_star * np.sqrt(ppy), ppy)


# ───────────────────────────────────────────────────────────── distributions / tails
def rolling_sharpe(r: pd.Series, months: int, ppy: int = ANN) -> pd.Series:
    win = int(round(months / 12 * ppy))
    return r.rolling(win).apply(
        lambda x: x.mean() / x.std() * np.sqrt(ppy) if x.std() > 0 else np.nan).dropna()


def monthly_distribution(r: pd.Series) -> dict:
    m = r.resample("ME").apply(lambda x: (1 + x).prod() - 1).dropna()
    return dict(n=len(m), avg=m.mean(), std=m.std(), best=m.max(), worst=m.min(),
                pct_positive=(m > 0).mean(), skew=float(skew(m)), kurtosis=float(kurtosis(m)),
                series=m)


def tail_risk(r: pd.Series, levels=(5, 1)) -> dict:
    m = r.resample("ME").apply(lambda x: (1 + x).prod() - 1).dropna()
    out = {}
    for p in levels:
        var = float(np.percentile(m, p))
        out[f"VaR_{100 - p}"] = var
        out[f"CVaR_{100 - p}"] = float(m[m <= var].mean())
    return out


def drawdown_episodes(r: pd.Series, top: int = 5) -> pd.DataFrame:
    eq = (1 + r).cumprod()
    peak, peak_d = eq.iloc[0], eq.index[0]
    in_dd = False
    trough = start_peak = peak
    trough_d = start_peak_d = peak_d
    rows = []
    for d, v in eq.items():
        if v >= peak:
            if in_dd:
                rows.append((start_peak_d, trough_d, d, trough / start_peak - 1))
                in_dd = False
            peak, peak_d = v, d
        else:
            if not in_dd:
                in_dd, trough, trough_d, start_peak, start_peak_d = True, v, d, peak, peak_d
            if v < trough:
                trough, trough_d = v, d
    if in_dd:
        rows.append((start_peak_d, trough_d, None, trough / start_peak - 1))
    df = pd.DataFrame(rows, columns=["peak", "trough", "recovered", "depth"])
    df["days_to_trough"] = (df["trough"] - df["peak"]).dt.days
    df["recovery_days"] = (df["recovered"] - df["trough"]).dt.days
    return df.sort_values("depth").head(top).reset_index(drop=True)


# ───────────────────────────────────────────────────────────── attribution
def return_contribution(components: pd.DataFrame, program: pd.Series) -> pd.Series:
    return (components.mean() / program.mean()).rename("return_contribution")


def risk_contribution(components: pd.DataFrame, program: pd.Series) -> pd.Series:
    var = program.var()
    return components.apply(lambda c: c.cov(program) / var).rename("risk_contribution")


def correlation_stability(sleeve_returns: pd.DataFrame, crisis: tuple[str, str] | None = None) -> dict:
    full = sleeve_returns.corr()
    off = full.where(~np.eye(len(full), dtype=bool)).stack()
    out = dict(avg=float(off.mean()), max=float(off.max()))
    if crisis:
        c = sleeve_returns.loc[crisis[0]:crisis[1]].corr()
        coff = c.where(~np.eye(len(c), dtype=bool)).stack()
        out["crisis_avg"], out["crisis_max"] = float(coff.mean()), float(coff.max())
    return out


# ───────────────────────────────────────────────────────────── monte carlo
def block_bootstrap(r_weekly: pd.Series, n_paths: int = 10_000, block: int = 8,
                    ppy: int = 52, seed: int = 42) -> pd.DataFrame:
    rng = np.random.default_rng(seed)
    x = r_weekly.dropna().values
    n = len(x)
    nb = int(np.ceil(n / block))
    sh, cg, dd = np.empty(n_paths), np.empty(n_paths), np.empty(n_paths)
    for i in range(n_paths):
        idx = (rng.integers(0, n, nb)[:, None] + np.arange(block)[None, :]).ravel()[:n] % n
        s = x[idx]
        sd = s.std()
        sh[i] = s.mean() / sd * np.sqrt(ppy) if sd > 0 else 0.0
        eq = np.cumprod(1 + s)
        dd[i] = (eq / np.maximum.accumulate(eq) - 1).min()
        cg[i] = eq[-1] ** (ppy / n) - 1
    return pd.DataFrame({"sharpe": sh, "cagr": cg, "maxdd": dd})

