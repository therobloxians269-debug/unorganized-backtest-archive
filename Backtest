#!/usr/bin/env python3
"""MES VWAP Trend-Day Rider (5-min) - my synthesis strategy.
Trade WITH the intraday trend (VWAP-aligned), 1-3x/day, let winners run.
  Entry 1: opening-range (30m) breakout, VWAP-aligned.
  Entry 2-3: VWAP pullback-and-resume in trend dir (re-load), cap 3/day.
  Stop 1.5*ATR (room). Exit: 3*ATR chandelier trail + EOD (ride trend days).
Real ES 5m front-month 2010-2026, realistic Tradovate friction, by era + drawdown."""
import numpy as np, pandas as pd
import dual_orb as D
COMM, SLIP, DPP, FLOOR = D.COMM, D.SLIP, D.DPP, D.FLOOR
ORN = 6

def strat(sessions, stop_atr=1.5, exit_mode="trail", trail_atr=3.0, vwap_filter=True, pullbacks=True):
    out = []
    for s in sessions:
        h, l, c, atr, vwap = s["h"], s["l"], s["c"], s["atr"], s["vwap"]
        ORh = float(h[:ORN].max()); ORl = float(l[:ORN].min())
        pos = 0; entry = stop = np.nan; ebar = -1; risk0 = np.nan; maxfav = 0.0
        broke = 0; n = 0
        for b in range(ORN, 78):
            if pos == 0 and n < 3:
                above = (c[b] > vwap[b]) or (not vwap_filter)
                below = (c[b] < vwap[b]) or (not vwap_filter)
                sig = 0
                if broke == 0:                                   # Entry 1: first OR break, aligned
                    if c[b] > ORh and above: sig = 1; broke = 1
                    elif c[b] < ORl and below: sig = -1; broke = -1
                elif pullbacks:                                  # Entry 2-3: VWAP pullback-and-resume
                    if broke == 1 and above and l[b] <= vwap[b] + 0.5*atr[b] and c[b] > c[b-1]:
                        sig = 1
                    elif broke == -1 and below and h[b] >= vwap[b] - 0.5*atr[b] and c[b] < c[b-1]:
                        sig = -1
                if sig != 0:
                    pos = sig; entry = c[b]; ebar = b; maxfav = 0.0
                    stop = entry - sig*max(stop_atr*atr[b], FLOOR); risk0 = abs(entry-stop); n += 1
                continue
            if pos != 0 and b > ebar:
                if (l[b] <= stop) if pos > 0 else (h[b] >= stop):
                    g = pos*(stop-entry); out.append((s["date"], g, g-D.fric(True, "stop"), risk0, "stop")); pos = 0; continue
                if exit_mode == "trail":
                    fav = (h[b]-entry) if pos > 0 else (entry-l[b]); maxfav = max(maxfav, fav)
                    tr = (entry+maxfav) - trail_atr*atr[b] if pos > 0 else (entry-maxfav) + trail_atr*atr[b]
                    stop = max(stop, tr) if pos > 0 else min(stop, tr)
                if b == 77:
                    g = pos*(c[b]-entry); out.append((s["date"], g, g-D.fric(True, "eod"), risk0, "eod")); pos = 0
    return pd.DataFrame(out, columns=["date", "gross", "net", "risk", "kind"])

def rep(tr, name, ndays):
    if len(tr) < 20:
        print(f"{name:30s} n={len(tr):4d} (too few)"); return
    tr = tr.copy(); tr["yr"] = pd.to_datetime(tr["date"]).dt.year
    def one(d, lbl):
        if len(d) < 5: return f"    {lbl:9s} —"
        net = d["net"].to_numpy(); eq = np.cumsum(net)*DPP; dd = (eq-np.maximum.accumulate(eq)).min()
        R = (net/d["risk"].clip(lower=1e-9)).mean()
        return (f"    {lbl:9s} n={len(d):4d} grossR={(d['gross']/d['risk'].clip(lower=1e-9)).mean():+.3f} "
                f"netR={R:+.3f} hit={(net>0).mean():.2f} ${net.sum()*DPP:>7.0f} maxDD=${dd:>7.0f} "
                f"ret/DD={(net.sum()*DPP/abs(dd)) if dd<0 else float('inf'):>4.1f}")
    print(name)
    print(one(tr, "ALL"))
    print(one(tr[tr.yr < 2020], "pre-2020"))
    print(one(tr[(tr.yr >= 2020) & (tr.yr <= 2021)], "2020-21"))
    print(one(tr[tr.yr >= 2022], "2022+"))

def main():
    S = D.load_5m()
    nd = len(S)
    print(f"{nd} sessions {S[0]['date']}..{S[-1]['date']}. friction {COMM}+{SLIP}/market fill.\n")
    print("===== MY STRATEGY: VWAP Trend-Day Rider — exit fork =====")
    a = strat(S, exit_mode="trail"); rep(a, "Rider (1.5ATR stop, 3ATR trail)", nd)
    print(f"    trades/day (2022+) = {len(a[pd.to_datetime(a['date']).dt.year>=2022])/len([s for s in S if s['date'].year>=2022]):.2f}")
    b = strat(S, exit_mode="eod");   rep(b, "Rider (1.5ATR stop, EOD exit)", nd)
    print("\n===== ablations (is each piece pulling weight?) =====")
    rep(strat(S, vwap_filter=False), "  no VWAP filter", nd)
    rep(strat(S, pullbacks=False),   "  no pullback re-entries (1/day)", nd)

if __name__ == "__main__":
    main()

