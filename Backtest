#!/usr/bin/env python3
"""GEXLAB M0b — free historical chain backfill (Alpha Vantage).

There is no free intraday options history. There IS free END-OF-DAY history:
Alpha Vantage's HISTORICAL_OPTIONS returns a full chain for any past date with
open interest, IV and greeks, on the free tier, at 25 calls/day.

25/day sounds crippling. It is not, because we do not need every session -- we
need a sample with enough power to answer one question. Two plans:

  opex    3rd-Friday expiries only. The pin test (Ni/Pearson/Poteshman) lives
          entirely on these days. 10 years = ~120 calls = 5 days of pulling.
  weekly  one session per week. Enough to regress realised vol on net GEX
          across regimes. 4 years = ~208 calls = 9 days of pulling.
  dense   every trading day in a range, for a focused window once something
          looks alive.

The ledger is append-only and a date is never pulled twice, so this is safe to
run daily from cron forever. It stops itself when the daily budget is spent.

CAUSALITY. Reported OI for date D reflects positions cleared overnight by OCC,
so it is known before D's open. This module still labels it as of D and every
downstream test must predict D+1 or later. Never use date-D OI to explain
date-D price.

    export ALPHAVANTAGE_API_KEY=...          (free: alphavantage.co/support/#api-key)
    python3 backfill.py plan weekly 2022-01-01 2025-12-31
    python3 backfill.py run  weekly 2022-01-01 2025-12-31
    python3 backfill.py status
"""
from __future__ import annotations

import json
import os
import sys
import time
import datetime as dt
from pathlib import Path

import pandas as pd
import requests

ROOT = Path(__file__).resolve().parent
HIST = ROOT / "data" / "hist" / "QQQ"
CAL = ROOT / "data" / "calendar_QQQ.parquet"
LEDGER = ROOT / "data" / "backfill_ledger.json"
AV = "https://www.alphavantage.co/query"
DAILY_BUDGET = 25          # free tier
SLEEP = 1.5                # be polite; AV throttles bursts

RIGHT = {"call": "C", "put": "P"}


def api_key() -> str:
    k = os.environ.get("ALPHAVANTAGE_API_KEY")
    if not k:
        f = Path.home() / ".alphavantage_key"
        if f.exists():
            k = f.read_text().strip()
    if not k:
        raise SystemExit(
            "No API key. Get a free one (20 seconds, no card):\n"
            "  https://www.alphavantage.co/support/#api-key\n"
            "then:  echo YOURKEY > ~/.alphavantage_key")
    return k


# ───────────────────────── trading calendar + spot ─────────────────────────
def calendar(refresh: bool = False) -> pd.DataFrame:
    """QQQ daily bars from yfinance. Its index IS the exact trading calendar,
    and we need the close anyway -- AV's option payload has no underlying price."""
    if CAL.exists() and not refresh:
        return pd.read_parquet(CAL)
    import yfinance as yf
    df = yf.Ticker("QQQ").history(period="max", auto_adjust=False)[["Open", "High", "Low", "Close"]]
    df.index = pd.to_datetime(df.index).tz_localize(None).normalize()
    df = df.rename(columns=str.lower)
    CAL.parent.mkdir(parents=True, exist_ok=True)
    df.to_parquet(CAL)
    print(f"calendar cached: {len(df):,} sessions {df.index[0]:%Y-%m-%d}..{df.index[-1]:%Y-%m-%d}")
    return df


def third_friday(ts: pd.Timestamp) -> bool:
    return ts.weekday() == 4 and 15 <= ts.day <= 21


def plan_dates(plan: str, start: str, end: str) -> list[str]:
    cal = calendar()
    idx = cal.loc[start:end].index
    if plan == "opex":
        sel = [d for d in idx if third_friday(d)]
    elif plan == "weekly":
        sel = list(pd.Series(idx, index=idx).groupby(pd.Grouper(freq="W")).last().dropna())
    elif plan == "dense":
        sel = list(idx)
    else:
        raise SystemExit(f"unknown plan {plan!r} (opex|weekly|dense)")
    return [pd.Timestamp(d).strftime("%Y-%m-%d") for d in sel]


# ───────────────────────────── ledger ─────────────────────────────
def load_ledger() -> dict:
    if LEDGER.exists():
        return json.loads(LEDGER.read_text())
    return {"done": [], "empty": [], "spend": {}}


def save_ledger(L: dict) -> None:
    LEDGER.parent.mkdir(parents=True, exist_ok=True)
    LEDGER.write_text(json.dumps(L, indent=1))


def spent_today(L: dict) -> int:
    return L["spend"].get(dt.date.today().isoformat(), 0)


# ───────────────────────────── fetch + normalise ─────────────────────────────
def fetch_day(date: str, key: str) -> pd.DataFrame | None:
    r = requests.get(AV, params={"function": "HISTORICAL_OPTIONS", "symbol": "QQQ",
                                 "date": date, "apikey": key}, timeout=60)
    j = r.json()
    if "data" not in j:
        msg = j.get("Information") or j.get("Note") or j.get("Error Message") or str(j)[:200]
        if "rate limit" in msg.lower() or "premium" in msg.lower() or "25 requests" in msg:
            raise RuntimeError(f"RATE_LIMIT: {msg[:160]}")
        print(f"  {date}: no data ({msg[:90]})")
        return None
    d = j["data"]
    if not d:
        return None

    df = pd.DataFrame(d)
    df["expiry"] = pd.to_datetime(df["expiration"]).dt.date
    df["right"] = df["type"].map(RIGHT)
    df["option"] = df["contractID"]
    num = {"strike": "strike", "bid": "bid", "ask": "ask", "bid_size": "bid_size",
           "ask_size": "ask_size", "volume": "volume", "open_interest": "open_interest",
           "implied_volatility": "iv", "delta": "delta", "gamma": "gamma",
           "theta": "theta", "vega": "vega", "rho": "rho"}
    for src, dst in num.items():
        df[dst] = pd.to_numeric(df.get(src), errors="coerce")

    cal = calendar()
    ts = pd.Timestamp(date)
    spot = float(cal.loc[ts, "close"]) if ts in cal.index else float("nan")

    df["snap_ts"] = ts + pd.Timedelta(hours=16)
    df["underlying"] = "QQQ"
    df["spot"] = spot
    df["opt_root"] = "QQQ"
    df["src"] = "AV_EOD"
    keep = ["option", "opt_root", "expiry", "right", "strike", "bid", "ask", "bid_size",
            "ask_size", "iv", "open_interest", "volume", "delta", "gamma", "vega",
            "theta", "rho", "snap_ts", "underlying", "spot", "src"]
    return df[keep]


def run(plan: str, start: str, end: str) -> None:
    key = api_key()
    L = load_ledger()
    dates = plan_dates(plan, start, end)
    todo = [d for d in dates if d not in L["done"] and d not in L["empty"]]
    budget = DAILY_BUDGET - spent_today(L)
    if budget <= 0:
        print(f"daily budget spent ({DAILY_BUDGET}). {len(todo)} dates still queued; "
              f"run again tomorrow.")
        return

    HIST.mkdir(parents=True, exist_ok=True)
    print(f"plan={plan}  queued={len(todo)}  budget left today={budget}")
    n = 0
    for date in todo[:budget]:
        try:
            df = fetch_day(date, key)
        except RuntimeError as e:
            print(f"  stopping: {e}")
            break
        L["spend"][dt.date.today().isoformat()] = spent_today(L) + 1
        n += 1
        if df is None or df.empty:
            L["empty"].append(date)
        else:
            out = HIST / f"QQQ_{date.replace('-', '')}.parquet"
            df.to_parquet(out, index=False)
            oi = df["open_interest"].sum()
            print(f"  {date}: {len(df):5,} contracts  OI {oi:11,.0f}  -> {out.name}")
            L["done"].append(date)
        save_ledger(L)
        time.sleep(SLEEP)

    remain = len([d for d in dates if d not in L["done"] and d not in L["empty"]])
    days = -(-remain // DAILY_BUDGET)
    print(f"\npulled {n} today. {remain} remaining ≈ {days} more day(s) of pulling.")


def status() -> None:
    L = load_ledger()
    fs = sorted(HIST.glob("*.parquet")) if HIST.exists() else []
    print(f"stored     {len(fs)} sessions")
    if fs:
        print(f"range      {fs[0].stem[-8:]} .. {fs[-1].stem[-8:]}")
        mb = sum(f.stat().st_size for f in fs) / 1e6
        print(f"size       {mb:.1f} MB")
    print(f"empty      {len(L['empty'])} dates returned nothing")
    print(f"today      {spent_today(L)}/{DAILY_BUDGET} calls used")


if __name__ == "__main__":
    a = sys.argv[1:]
    if not a or a[0] == "status":
        status()
    elif a[0] == "plan":
        ds = plan_dates(a[1], a[2], a[3])
        print(f"plan={a[1]}  {len(ds)} sessions  "
              f"≈ {-(-len(ds)//DAILY_BUDGET)} days at {DAILY_BUDGET}/day")
        print(f"first: {ds[:5]}\nlast:  {ds[-5:]}")
    elif a[0] == "run":
        run(a[1], a[2], a[3])
    else:
        raise SystemExit(__doc__)

