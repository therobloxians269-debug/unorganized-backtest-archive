"""
THE CHROME MODEL — THE VOCABULARY.

Everything here is candlestick price action. No indicators inside any signal
condition. Every term is something you can point at on a chart. ADR appears only
for stop sizing, never inside a condition.

The vocabulary is grounded in what WE measured, not borrowed:

  · rail hardness      soft rails reclaim 90-95%, hard rails 55-64%   (18,383 crossings)
  · penetration        soft 0.04-0.06 ADR, hard 0.50-0.63 ADR
  · reclaim speed      soft median 1-2 min, hard 3-5 min
  · the setting        72.4% ES / 77.8% NQ set an extreme in hour one
  · the strip          0.53 ADR spent by 10:30, 0.93 final
  · rotation regimes   WELDED / TRACKING / ROTATING
  · the fill law       a level is a STOP, never an entry

FAMILIES
  1  THE BAR        single-candle shapes
  2  THE PAIR       two-bar relationships
  3  THE RUN        three-and-more bar sequences
  4  ZONES          areas price left behind, with lifecycle state
  5  RAILS          levels, graded by measured hardness
  6  SWEEPS         how a rail gets taken, graded by depth and speed
  7  THE SESSION    where in the day, and how much budget is left
  8  CHARACTER      what kind of day it is, read live
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')

RTH0, RTH1, IBLEN = 570, 960, 60


# ═══════════════════════════════════════════════════════════════════════════
#  BAR CONSTRUCTION
# ═══════════════════════════════════════════════════════════════════════════
def build(day, rb, tf=5):
    out = []
    for dd, row in day.iterrows():
        b = rb.get(dd)
        if b is None:
            continue
        A = float(row.ADR)
        H1, L1, C1, O1, V1, T1 = b['H'], b['L'], b['C'], b['O'], b['V'], b['T']
        if not (A > 0) or len(C1) < 300:
            continue
        n = (len(C1) // tf) * tf
        ix = np.arange(n).reshape(-1, tf)
        mib = T1 < RTH0 + IBLEN
        out.append(pd.DataFrame(dict(
            day=dd, ADR=A, end=ix[:, -1], t=T1[ix[:, -1]],
            o=O1[ix[:, 0]], h=H1[ix].max(1), l=L1[ix].min(1), c=C1[ix[:, -1]],
            v=V1[ix].sum(1),
            sesO=float(C1[0]),
            onH=float(row.onH), onL=float(row.onL),
            pdH=float(row.prevHi), pdL=float(row.prevLo),
            ibH=float(H1[mib].max()) if mib.sum() > 10 else np.nan,
            ibL=float(L1[mib].min()) if mib.sum() > 10 else np.nan)))
    d = pd.concat(out, ignore_index=True)
    d = add_weekly(d)
    return d


def add_weekly(d):
    """Prior-week high/low — the hardest rails we measured."""
    s = d.groupby('day').agg(hi=('h', 'max'), lo=('l', 'min'))
    wk = s.index.to_period('W')
    wh = s.groupby(wk).hi.max().shift(1)
    wl = s.groupby(wk).lo.min().shift(1)
    m = pd.DataFrame({'pwH': s.index.to_period('W').map(wh),
                      'pwL': s.index.to_period('W').map(wl)}, index=s.index)
    return d.merge(m, left_on='day', right_index=True, how='left')


# ═══════════════════════════════════════════════════════════════════════════
#  THE VOCABULARY
# ═══════════════════════════════════════════════════════════════════════════
def vocabulary(d):
    """Returns (frame with all terms as booleans, list of term names)."""
    g = d.copy()
    rng = (g.h - g.l).replace(0, np.nan)
    body = g.c - g.o
    top, bot = np.maximum(g.o, g.c), np.minimum(g.o, g.c)
    uw, lw, bf = (g.h - top) / rng, (bot - g.l) / rng, body.abs() / rng
    up = body > 0
    P = lambda s, k=1: s.groupby(g.day).shift(k)
    RMAX = lambda s, w: s.groupby(g.day).transform(
        lambda x: x.shift(1).rolling(w, min_periods=w).max())
    RMIN = lambda s, w: s.groupby(g.day).transform(
        lambda x: x.shift(1).rolling(w, min_periods=w).min())

    ph, pl, pc, po = P(g.h), P(g.l), P(g.c), P(g.o)
    ph2, pl2, pc2 = P(g.h, 2), P(g.l, 2), P(g.c, 2)
    ph3, pl3 = P(g.h, 3), P(g.l, 3)
    prng = (ph - pl).replace(0, np.nan)
    pbody = (pc - po)
    ptop, pbotm = np.maximum(po, pc), np.minimum(po, pc)

    Q = {}

    # ── FAMILY 1 · THE BAR ────────────────────────────────────────────────
    Q['SLAB_UP']    = up & (bf >= 0.70)                    # body is the bar
    Q['SLAB_DN']    = (~up) & (bf >= 0.70)
    Q['STALL']      = bf <= 0.25                           # all wick, no progress
    Q['DOJI']       = bf <= 0.10
    Q['PIN_UP']     = (lw >= 0.55) & (bf <= 0.40)          # long tail below
    Q['PIN_DN']     = (uw >= 0.55) & (bf <= 0.40)
    Q['CLEANTOP']   = uw <= 0.05                           # closed on its high
    Q['CLEANBOT']   = lw <= 0.05
    Q['TOPHEAVY']   = (uw >= 0.35) & (lw <= 0.15)
    Q['BOTHEAVY']   = (lw >= 0.35) & (uw <= 0.15)
    Q['SPLIT']      = (uw >= 0.25) & (lw >= 0.25)          # rejected both ways
    Q['WIDE']       = rng >= 1.6 * prng
    Q['NARROW']     = rng <= 0.6 * prng
    Q['UPBAR']      = up
    Q['DNBAR']      = ~up

    # ── FAMILY 2 · THE PAIR ───────────────────────────────────────────────
    Q['SWALLOW_UP'] = (g.h >= ph) & (g.l <= pl) & up       # outside bar, up close
    Q['SWALLOW_DN'] = (g.h >= ph) & (g.l <= pl) & (~up)
    Q['NEST']       = (g.h <= ph) & (g.l >= pl)            # inside bar
    Q['SHELF_TOP']  = (g.h - ph).abs() <= 0.10 * prng      # matched highs
    Q['SHELF_BOT']  = (g.l - pl).abs() <= 0.10 * prng
    Q['SNAP_UP']    = g.c > ph                             # closed beyond prior bar
    Q['SNAP_DN']    = g.c < pl
    Q['FADE_UP']    = (g.h > ph) & (g.c < pc)              # took the high, closed weaker
    Q['FADE_DN']    = (g.l < pl) & (g.c > pc)
    Q['STEP_UP']    = (g.h > ph) & (g.l > pl)              # higher high, higher low
    Q['STEP_DN']    = (g.h < ph) & (g.l < pl)
    Q['HANDOFF_UP'] = bot > ptop                           # body gap up
    Q['HANDOFF_DN'] = top < pbotm
    Q['FLIP_UP']    = (pbody < 0) & up & (g.c > ptop)      # down bar reversed, closed over it
    Q['FLIP_DN']    = (pbody > 0) & (~up) & (g.c < pbotm)
    Q['ABSORB_TOP'] = (g.h >= ph) & (g.c <= pc) & (g.v > P(g.v))   # more effort, no result
    Q['ABSORB_BOT'] = (g.l <= pl) & (g.c >= pc) & (g.v > P(g.v))

    # ── FAMILY 3 · THE RUN ────────────────────────────────────────────────
    dup = (g.c > pc).astype(float)
    roll3 = dup.groupby(g.day).rolling(3, min_periods=3).sum().reset_index(level=0, drop=True)
    Q['LADDER_UP']  = roll3 == 3
    Q['LADDER_DN']  = roll3 == 0
    r1, r2 = P(rng, 1), P(rng, 2)
    Q['CHOKE']      = (rng < r1) & (r1 < r2)               # three contracting ranges
    Q['FLARE']      = rng > RMAX(rng.rename('r'), 5)       # biggest in six
    Q['CASCADE_DN'] = (g.l < pl) & (pl < pl2) & (pl2 < pl3)
    Q['CASCADE_UP'] = (g.h > ph) & (ph > ph2) & (ph2 > ph3)
    Q['THREEPUSH_UP'] = (g.h > ph) & (ph > ph2) & (g.c < pc)   # third push fails
    Q['THREEPUSH_DN'] = (g.l < pl) & (pl < pl2) & (g.c > pc)
    Q['PIVOT_HI']   = (ph > g.h) & (ph > ph2)
    Q['PIVOT_LO']   = (pl < g.l) & (pl < pl2)
    Q['COILSPRING'] = P(Q['CHOKE'].fillna(False)) & Q['FLARE'].fillna(False)

    # ── FAMILY 4 · ZONES ──────────────────────────────────────────────────
    # a VOID is a true unfilled gap: bar i's range never touches bar i-2's
    Q['VOID_UP']    = g.l > ph2
    Q['VOID_DN']    = g.h < pl2
    Q['VOID_FRESH_UP'] = Q['VOID_UP'].fillna(False) & ~P(Q['VOID_UP'].fillna(False)).fillna(False)
    Q['VOID_FRESH_DN'] = Q['VOID_DN'].fillna(False) & ~P(Q['VOID_DN'].fillna(False)).fillna(False)
    # SLAB ZONE — the body of a big-body bar, the area it left in one move
    Q['IN_SLAB_UP'] = (g.c <= P(top)) & (g.c >= P(bot)) & P(Q['SLAB_UP'].fillna(False)).fillna(False)
    Q['IN_SLAB_DN'] = (g.c <= P(top)) & (g.c >= P(bot)) & P(Q['SLAB_DN'].fillna(False)).fillna(False)
    # POCKET — price back inside a prior NEST (compression) area
    Q['IN_POCKET']  = P(Q['NEST'].fillna(False)).fillna(False) & (g.c <= ph) & (g.c >= pl)
    Q['ZONE_TAG_UP'] = Q['VOID_UP'].fillna(False).groupby(g.day).shift(1).fillna(False) & (g.l <= ph2)
    Q['ZONE_TAG_DN'] = Q['VOID_DN'].fillna(False).groupby(g.day).shift(1).fillna(False) & (g.h >= pl2)

    # ── FAMILY 5 · RAILS (graded by MEASURED hardness) ───────────────────
    # soft: reclaimed 90-95%.  mid: 75-83%.  hard: 55-64%.
    for nm, col, side in (('ONH', 'onH', 'up'), ('ONL', 'onL', 'dn'),
                          ('IBH', 'ibH', 'up'), ('IBL', 'ibL', 'dn'),
                          ('PDH', 'pdH', 'up'), ('PDL', 'pdL', 'dn'),
                          ('PWH', 'pwH', 'up'), ('PWL', 'pwL', 'dn')):
        lvl = g[col]
        live = (g.t >= RTH0 + IBLEN) if nm.startswith('IB') else True
        if side == 'up':
            Q[f'AT_{nm}']    = (g.h >= lvl) & (g.l <= lvl) & live
            Q[f'OVER_{nm}']  = (g.c > lvl) & live
            Q[f'TAKE_{nm}']  = (g.h > lvl) & (P(g.h) <= lvl) & live      # first poke
        else:
            Q[f'AT_{nm}']    = (g.h >= lvl) & (g.l <= lvl) & live
            Q[f'UNDER_{nm}'] = (g.c < lvl) & live
            Q[f'TAKE_{nm}']  = (g.l < lvl) & (P(g.l) >= lvl) & live
    Q['AT_SOFT'] = Q['AT_ONH'] | Q['AT_ONL'] | Q['AT_IBH'] | Q['AT_IBL']
    Q['AT_MID']  = Q['AT_PDH'] | Q['AT_PDL']
    Q['AT_HARD'] = Q['AT_PWH'] | Q['AT_PWL']

    # ── FAMILY 6 · SWEEPS (depth + speed, per our measurements) ──────────
    h5, l5 = RMAX(g.h, 5), RMIN(g.l, 5)
    h10, l10 = RMAX(g.h, 10), RMIN(g.l, 10)
    h20, l20 = RMAX(g.h, 20), RMIN(g.l, 20)
    Q['SKID_HI']   = (g.h > h5) & (g.c < h5)               # poked, thrown back
    Q['SKID_LO']   = (g.l < l5) & (g.c > l5)
    Q['SKID_HI10'] = (g.h > h10) & (g.c < h10)
    Q['SKID_LO10'] = (g.l < l10) & (g.c > l10)
    Q['SKID_HI20'] = (g.h > h20) & (g.c < h20)
    Q['SKID_LO20'] = (g.l < l20) & (g.c > l20)
    Q['WELD_HI']   = (g.h > h10) & (g.c > h10)             # took it AND held
    Q['WELD_LO']   = (g.l < l10) & (g.c < l10)
    Q['STAB_HI']   = (g.h > h10) & ((g.h - h10) / g.ADR >= 0.15)   # deep poke
    Q['STAB_LO']   = (g.l < l10) & ((l10 - g.l) / g.ADR >= 0.15)
    Q['GRAZE_HI']  = (g.h > h10) & ((g.h - h10) / g.ADR <= 0.05)   # shallow poke
    Q['GRAZE_LO']  = (g.l < l10) & ((l10 - g.l) / g.ADR <= 0.05)
    Q['DBLSWEEP']  = (Q['SKID_HI'].fillna(False) & P(Q['SKID_LO'].fillna(False)).fillna(False)) | \
                     (Q['SKID_LO'].fillna(False) & P(Q['SKID_HI'].fillna(False)).fillna(False))
    Q['SWEEP_AT_SOFT_HI'] = Q['SKID_HI'].fillna(False) & Q['AT_SOFT'].fillna(False)
    Q['SWEEP_AT_SOFT_LO'] = Q['SKID_LO'].fillna(False) & Q['AT_SOFT'].fillna(False)
    Q['SWEEP_AT_HARD_HI'] = Q['SKID_HI'].fillna(False) & (Q['AT_MID'] | Q['AT_HARD']).fillna(False)
    Q['SWEEP_AT_HARD_LO'] = Q['SKID_LO'].fillna(False) & (Q['AT_MID'] | Q['AT_HARD']).fillna(False)

    # ── FAMILY 7 · THE SESSION ────────────────────────────────────────────
    Q['HOUR1']   = g.t < RTH0 + 60                          # the setting: 72-78%
    Q['MORNING'] = (g.t >= RTH0 + 60) & (g.t < 720)
    Q['MIDDAY']  = (g.t >= 720) & (g.t < 810)
    Q['AFTNOON'] = (g.t >= 810) & (g.t < 900)
    Q['CLOSING'] = g.t >= 900
    Q['ABOVE_OPEN'] = g.c > g.sesO
    Q['BELOW_OPEN'] = g.c < g.sesO
    cmax = g.groupby('day').h.cummax(); cmin = g.groupby('day').l.cummin()
    used = (cmax - cmin) / g.ADR
    Q['STRIP_LOW']  = used <= 0.50                          # budget barely spent
    Q['STRIP_MID']  = (used > 0.50) & (used <= 0.90)
    Q['STRIP_SPENT'] = used > 0.90                          # median final is 0.93
    Q['AT_SESS_HI'] = g.h >= cmax - 1e-9
    Q['AT_SESS_LO'] = g.l <= cmin + 1e-9
    Q['EXT_HI'] = (g.c - cmin) / (cmax - cmin).replace(0, np.nan) >= 0.80
    Q['EXT_LO'] = (g.c - cmin) / (cmax - cmin).replace(0, np.nan) <= 0.20

    # ── FAMILY 8 · CHARACTER (rotation regime, read live) ────────────────
    tp = (g.h + g.l + g.c) / 3.0
    vwap = (tp * g.v).groupby(g.day).cumsum() / g.v.groupby(g.day).cumsum().replace(0, np.nan)
    side = np.sign(g.c - vwap)
    flip = (side != side.groupby(g.day).shift(1)).astype(float)
    rot = flip.groupby(g.day).cumsum()
    Q['WELDED']   = rot <= 5                                # 31.9% of days, 1.18 ADR
    Q['TRACKING'] = (rot > 5) & (rot <= 15)
    Q['ROTATING'] = rot > 15                                # 28.8%, 0.79 ADR
    Q['NEW_HI_SESS'] = g.h >= cmax.groupby(g.day).shift(1)
    Q['NEW_LO_SESS'] = g.l <= cmin.groupby(g.day).shift(1)

    names = []
    for k, v in Q.items():
        g[k] = pd.Series(v, index=g.index).fillna(False).astype(bool)
        names.append(k)
    return g, names


def families():
    return {
        'BAR': ['SLAB_UP','SLAB_DN','STALL','DOJI','PIN_UP','PIN_DN','CLEANTOP','CLEANBOT',
                'TOPHEAVY','BOTHEAVY','SPLIT','WIDE','NARROW','UPBAR','DNBAR'],
        'PAIR': ['SWALLOW_UP','SWALLOW_DN','NEST','SHELF_TOP','SHELF_BOT','SNAP_UP','SNAP_DN',
                 'FADE_UP','FADE_DN','STEP_UP','STEP_DN','HANDOFF_UP','HANDOFF_DN',
                 'FLIP_UP','FLIP_DN','ABSORB_TOP','ABSORB_BOT'],
        'RUN': ['LADDER_UP','LADDER_DN','CHOKE','FLARE','CASCADE_UP','CASCADE_DN',
                'THREEPUSH_UP','THREEPUSH_DN','PIVOT_HI','PIVOT_LO','COILSPRING'],
        'ZONE': ['VOID_UP','VOID_DN','VOID_FRESH_UP','VOID_FRESH_DN','IN_SLAB_UP','IN_SLAB_DN',
                 'IN_POCKET','ZONE_TAG_UP','ZONE_TAG_DN'],
        'RAIL': ['AT_ONH','AT_ONL','AT_IBH','AT_IBL','AT_PDH','AT_PDL','AT_PWH','AT_PWL',
                 'AT_SOFT','AT_MID','AT_HARD','OVER_ONH','UNDER_ONL','OVER_PDH','UNDER_PDL',
                 'OVER_PWH','UNDER_PWL','TAKE_ONH','TAKE_ONL','TAKE_PDH','TAKE_PDL',
                 'TAKE_PWH','TAKE_PWL','TAKE_IBH','TAKE_IBL','OVER_IBH','UNDER_IBL'],
        'SWEEP': ['SKID_HI','SKID_LO','SKID_HI10','SKID_LO10','SKID_HI20','SKID_LO20',
