#!/usr/bin/env python3
"""HONEST multi-family strategy search with OOS discipline built in.
Generate MANY diverse candidate edges (trend, fade, level-break, time-of-day,
range-expansion), each wrapped in the $1k survival overlay (ATR stop, daily stop,
monthly breaker). Select on TRAIN (2022-2023). Validate BLIND on TEST (2024-2026).
Report: (1) how good the in-sample winner looks, (2) whether it survives OOS,
(3) how many of ALL candidates clear a real bar OOS. This is the referee, not a
curve-shopping tool: we look at OOS survivors, not in-sample champions."""
import itertools, numpy as np, pandas as pd
import omni2_lib as L
from omni2_lib import ORN, FLOOR, fric, DPP

S_ALL = L.load()

# ----------------------------------------------------------------- trade sim
def sim(sess, entries, stop_atr, exit_mode, target_R):
    """entries: list of (bar, side). One position at a time; daily stop after a loss."""
    h, l, c, atr, vwap = sess["h"], sess["l"], sess["c"], sess["atr"], sess["vwap"]
    res = []; i = 0; stopped = False
    ent = {b: s for b, s in entries}
    b = ORN
    while b < 78:
        if not stopped and b in ent and b < 77:
            side = ent[b]; entry = c[b]
            stop = entry - side*max(stop_atr*atr[b], FLOOR); risk = abs(entry-stop)
            tgt = entry + side*target_R*risk if exit_mode == "target" else None
            j = b+1
            while j < 78:
                if (l[j] <= stop) if side > 0 else (h[j] >= stop):
                    res.append((side*(stop-entry) - fric("stop"), risk)); stopped = stopped or True; b = j; break
                if tgt is not None and ((h[j] >= tgt) if side > 0 else (l[j] <= tgt)):
                    res.append((side*(tgt-entry) - fric("target"), risk)); b = j; break
                if j == 77:
                    g = side*(c[j]-entry) - fric("eod"); res.append((g, risk)); stopped = stopped or (g < 0); b = j; break
                j += 1
        b += 1
    return res

# ----------------------------------------------------------------- candidate families
def fam_trend(sess, gate, k):
    e = []; broke = False
    for b in range(ORN, 77):
        if sess["er"][b] < gate: continue
        if sess["c"][b] > sess["or_hi"] and sess["c"][b] > sess["vwap"][b]: e.append((b, 1)); break
        if sess["c"][b] < sess["or_lo"] and sess["c"][b] < sess["vwap"][b]: e.append((b, -1)); break
    return e

def fam_vwap_fade(sess, k, loregime):
    for b in range(ORN, 77):
        if sess["er"][b] > loregime: continue                # only in RANGE regime
        d = sess["c"][b] - sess["vwap"][b]
        if d <= -k*sess["atr"][b]: return [(b, 1)]           # stretched below -> long back to vwap
        if d >=  k*sess["atr"][b]: return [(b, -1)]
    return []

def fam_prevlevel(sess, buf):
    if sess["prev_hi"] is None: return []
    for b in range(ORN, 77):
        if sess["c"][b] > sess["prev_hi"] + buf*sess["atr"][b]: return [(b, 1)]
        if sess["c"][b] < sess["prev_lo"] - buf*sess["atr"][b]: return [(b, -1)]
    return []

def fam_tod(sess, ebar, mode):
    if ebar >= 77: return []
    if mode == "mom":  return [(ebar, 1 if sess["c"][ebar] > sess["vwap"][ebar] else -1)]
    else:              return [(ebar, -1 if sess["c"][ebar] > sess["vwap"][ebar] else 1)]

def fam_rangeexp(sess, k):
    for b in range(ORN, 77):
        rng = sess["h"][b] - sess["l"][b]
        if rng >= k*sess["atr"][b]:
            side = 1 if sess["c"][b] > sess["o"][b] else -1
            if (side > 0 and sess["c"][b] > sess["vwap"][b]) or (side < 0 and sess["c"][b] < sess["vwap"][b]):
                return [(b, side)]
    return []

def build_candidates():
    C = []
    for gate in [0.30, 0.40, 0.50, 0.55, 0.60]:
        for ex, tr in [("eod", 0), ("target", 1.0), ("target", 2.0)]:
            C.append((f"trend g{gate} {ex}{tr}", lambda s, g=gate: fam_trend(s, g, 0), ex, tr))
    for k in [1.0, 1.5, 2.0]:
        for lo in [0.13, 0.20]:
            for ex, tr in [("target", 1.0), ("eod", 0)]:
                C.append((f"vwapFade k{k} lo{lo} {ex}{tr}", lambda s, k=k, lo=lo: fam_vwap_fade(s, k, lo), ex, tr))
    for buf in [0.0, 0.25, 0.5]:
        for ex, tr in [("eod", 0), ("target", 2.0)]:
            C.append((f"prevLvl buf{buf} {ex}{tr}", lambda s, b=buf: fam_prevlevel(s, b), ex, tr))
    for eb in [6, 12, 24, 48]:
        for mode in ["mom", "fade"]:
            C.append((f"tod b{eb} {mode}", lambda s, eb=eb, m=mode: fam_tod(s, eb, m), "eod", 0))
    for k in [1.5, 2.0, 2.5]:
        for ex, tr in [("eod", 0), ("target", 1.5)]:
            C.append((f"rangeExp k{k} {ex}{tr}", lambda s, k=k: fam_rangeexp(s, k), ex, tr))
    return C

# ----------------------------------------------------------------- $1k equity + metrics
def equity(sig, exit_mode, target_R, y_lo, y_hi, Lmonth=150.0, start=1000.0, stop_atr=1.5):
    eq = start; peak = start; maxdd = 0.0; tot = 0.0; cur = None; mpnl = 0.0; broken = False; nd = 0
    day_usd = []
    for s in S_ALL:
        if not (y_lo <= s["date"].year <= y_hi): continue
        ym = (s["date"].year, s["date"].month)
        if ym != cur: cur = ym; mpnl = 0.0; broken = False
        if broken: day_usd.append(0.0); continue
        u = sum(g for g, _ in sim(s, sig(s), stop_atr, exit_mode, target_R)) * DPP
        if u != 0: nd += 1
        eq += u; tot += u; mpnl += u; peak = max(peak, eq); maxdd = min(maxdd, eq - peak)
        day_usd.append(u)
        if Lmonth > 0 and mpnl <= -Lmonth: broken = True
    mar = tot/abs(maxdd) if maxdd < 0 else (9.99 if tot > 0 else 0.0)
    return dict(ret=tot, maxdd=maxdd, mar=mar, nd=nd, day_usd=np.array(day_usd))

def ruin_mc(day_usd, dates, start=1000, n=8000, seed=3):
    if len(day_usd) == 0: return 1.0
    df = pd.DataFrame({"u": day_usd, "ym": [(d.year, d.month) for d in dates]})
    mp = df.groupby("ym")["u"].sum().to_numpy()
    if len(mp) < 3: return 1.0
    rng = np.random.default_rng(seed); ruin = 0
    for _ in range(n):
        eq = start + np.cumsum(rng.choice(mp, size=54, replace=True))
        ruin += eq.min() <= 0
    return ruin/n

def main():
    C = build_candidates()
    tr_dates = [s["date"] for s in S_ALL if 2022 <= s["date"].year <= 2023]
    te_dates = [s["date"] for s in S_ALL if 2024 <= s["date"].year <= 2026]
    rows = []
    for name, sig, ex, tr in C:
        TR = equity(sig, ex, tr, 2022, 2023)
        TE = equity(sig, ex, tr, 2024, 2026)
        rows.append(dict(name=name, tr_ret=TR["ret"], tr_mar=TR["mar"],
                         te_ret=TE["ret"], te_mar=TE["mar"],
                         te_ruin=ruin_mc(TE["day_usd"], te_dates), n=TR["nd"]))
    df = pd.DataFrame(rows)
    print(f"searched {len(df)} candidates across 5 families\n")
    print("=== TOP 10 by IN-SAMPLE MAR (what a curve-shopper would ship) ===")
    top = df.sort_values("tr_mar", ascending=False).head(10)
    print(top.to_string(index=False, columns=["name","tr_ret","tr_mar","te_ret","te_mar","te_ruin"],
                        float_format=lambda x: f"{x:.2f}"))
    # honest survivors: positive AND robust OOS AND low ruin
    surv = df[(df.te_ret > 0) & (df.te_mar > 1.0) & (df.tr_ret > 0) & (df.tr_mar > 1.0) & (df.te_ruin < 0.10)]
    print(f"\n=== HONEST SURVIVORS (train+ AND test+ MAR>1 both AND P(ruin)<10%): {len(surv)} of {len(df)} ===")
    if len(surv):
        print(surv.to_string(index=False, columns=["name","tr_ret","tr_mar","te_ret","te_mar","te_ruin"],
                            float_format=lambda x: f"{x:.2f}"))
    else:
        print("  NONE. Not one candidate cleared a real out-of-sample bar.")

if __name__ == "__main__":
    main()

