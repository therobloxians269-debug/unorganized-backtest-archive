"""Two block families:
   REJECTION block  -> mean reversion (fade the extreme)
   PULLBACK / ORDER block -> trend continuation (last opposite candle before displacement)
   Both causal: a block is stamped at the bar that CONFIRMS it."""
import pandas as pd, numpy as np, warnings; warnings.filterwarnings('ignore')
FLAT=1019

def htf(df, tf=15):
    r=df.resample(f'{tf}min',label='left',closed='left').agg(
        {'o':'first','h':'max','l':'min','c':'last','v':'sum'}).dropna()
    tr=pd.concat([r.h-r.l,(r.h-r.c.shift()).abs(),(r.l-r.c.shift()).abs()],axis=1).max(axis=1)
    r['atr']=tr.rolling(14).mean(); r['vma']=r['v'].rolling(20).mean()
    return r

def rejection_blocks(r, tf=15, swing=2, min_wick=1.0, min_wick_pct=0.30):
    o,h,l,c,v=r['o'].values,r['h'].values,r['l'].values,r['c'].values,r['v'].values
    atr,vma=r['atr'].values,r['vma'].values; t=r.index; n=len(r); out=[]
    for p in range(swing,n-swing):
        bhi,blo=max(o[p],c[p]),min(o[p],c[p])
        body=max(abs(c[p]-o[p]),.25); rng=max(h[p]-l[p],.25)
        upw,dnw=h[p]-bhi,blo-l[p]; w=range(p-swing,p+swing+1)
        a=max(atr[p],.25) if np.isfinite(atr[p]) else .25
        vm=max(vma[p],1.) if np.isfinite(vma[p]) else 1.
        kn=t[p+swing]+pd.Timedelta(minutes=tf)
        if all(h[q]<h[p] for q in w if q!=p) and upw>min_wick*body and upw/rng>=min_wick_pct:
            sc=(upw/rng)+min(upw/a,2)/2+min(v[p]/vm,3)/3+sum(1 for q in w if q!=p and h[q]<h[p])/(swing*2)
            out.append(dict(known=kn,top=h[p],bot=bhi,dir=-1,score=sc,kind='REJ',atr=a))
        if all(l[q]>l[p] for q in w if q!=p) and dnw>min_wick*body and dnw/rng>=min_wick_pct:
            sc=(dnw/rng)+min(dnw/a,2)/2+min(v[p]/vm,3)/3+sum(1 for q in w if q!=p and l[q]>l[p])/(swing*2)
            out.append(dict(known=kn,top=blo,bot=l[p],dir=1,score=sc,kind='REJ',atr=a))
    return pd.DataFrame(out)

def pullback_blocks(r, tf=15, disp_atr=1.0, disp_bars=3, lookback=6):
    """Order block = last opposite-colour candle before a displacement leg.
       Displacement = net move >= disp_atr*ATR over disp_bars bars that also makes a new extreme."""
    o,h,l,c,v=r['o'].values,r['h'].values,r['l'].values,r['c'].values,r['v'].values
    atr,vma=r['atr'].values,r['vma'].values; t=r.index; n=len(r); out=[]
    for i in range(lookback+disp_bars, n):
        a=atr[i] if np.isfinite(atr[i]) and atr[i]>0 else np.nan
        if not np.isfinite(a): continue
        s=i-disp_bars
        net=c[i]-o[s]
        if abs(net) < disp_atr*a: continue
        up = net>0
        # must break the prior `lookback` extreme -> genuine displacement, not drift
        if up and h[i] <= max(h[s-lookback:s]): continue
        if (not up) and l[i] >= min(l[s-lookback:s]): continue
        # last opposite-colour candle before the leg
        ob=None
        for q in range(s,max(s-lookback,0)-1,-1):
            if (up and c[q]<o[q]) or ((not up) and c[q]>o[q]): ob=q; break
        if ob is None: continue
        vm=max(vma[i],1.) if np.isfinite(vma[i]) else 1.
        strength=abs(net)/a
        sc=min(strength,3)/3 + min(v[i]/vm,3)/3 + (1.0 if abs(net)>1.5*a else 0.5)
        kn=t[i]+pd.Timedelta(minutes=tf)
        if up:  out.append(dict(known=kn,top=max(o[ob],c[ob]),bot=l[ob],dir=1,score=sc,kind='PB',atr=a,leg=h[i]))
        else:   out.append(dict(known=kn,top=h[ob],bot=min(o[ob],c[ob]),dir=-1,score=sc,kind='PB',atr=a,leg=l[i]))
    return pd.DataFrame(out)

def trade_blocks(df, B, tgt_mode='atr', tgt=1.0, buf=2.0, valid_bars=240, max_hold=240,
                 max_stop=60., min_stop=1.5, pv=20., comm=4., slip=0.25,
                 min_score=0.0, cooldown=30, displace=None, seed=0):
    idx=df.index; h=df['h'].values; l=df['l'].values; o=df['o'].values
    m=df['minofday'].values; n=len(df); rng=np.random.default_rng(seed)
    out=[]; last=-10**9
    for _,b in B.iterrows():
        if b.score<min_score: continue
        top,bot,d=b.top,b.bot,int(b.dir)
        if displace is not None:
            sh=displace*(1 if rng.random()<.5 else -1); top,bot=top+sh,bot+sh
        s=idx.searchsorted(b.known)
        if s<=last+cooldown or s>=n-2: continue
        j=None
        for q in range(s,min(s+valid_bars,n)):
            if FLAT<=m[q]<1080: break
            if l[q]<=top and h[q]>=bot: j=q; break
        if j is None or j+2>=n: continue
        ep=o[j+1]+(slip if d==1 else -slip)
        st=(bot-buf) if d==1 else (top+buf)
        risk=abs(ep-st)
        if risk>max_stop or risk<min_stop: continue
        if tgt_mode=='atr': tg=ep+tgt*b.atr if d==1 else ep-tgt*b.atr
        elif tgt_mode=='R': tg=ep+tgt*risk if d==1 else ep-tgt*risk
        else: tg=b.leg
        rr=abs(tg-ep)/risk
        if rr<=0: continue
        px=None
        for k in range(j+1,min(j+1+max_hold,n)):
            if FLAT<=m[k]<1080: px=o[k]+(slip if d==-1 else -slip); w='flat'; break
            if (h[k]>=st) if d==-1 else (l[k]<=st): px=st+(slip if d==-1 else -slip); w='stop'; break
            if (l[k]<=tg) if d==-1 else (h[k]>=tg): px=tg; w='tgt'; break
        if px is None: k=min(j+max_hold,n-1); px=o[k]; w='time'
        pts=(ep-px) if d==-1 else (px-ep); net=pts*pv-comm
        out.append(dict(t=idx[j+1],d=d,kind=b.kind,score=b.score,R=net/(risk*pv),
                        pnl=net,rr=rr,why=w,risk=risk))
        last=k
    return pd.DataFrame(out)

def rep(t,days,lab):
    if t is None or len(t)<15: return f'{lab:34s} n={0 if t is None else len(t)}'
    pf=t.pnl[t.pnl>0].sum()/max(1e-9,-t.pnl[t.pnl<0].sum())
    R=np.sort(t.R.values)[::-1]; d3=(R.sum()-R[:3].sum())/max(1,len(R)-3)
    return (f'{lab:34s} n={len(t):4d} ({len(t)/days:4.2f}/d) WR={(t.pnl>0).mean()*100:4.1f}% '
            f'avgR={t.R.mean():+.3f} d3={d3:+.3f} $/tr={t.pnl.mean():+7.1f} PF={pf:4.2f}')

