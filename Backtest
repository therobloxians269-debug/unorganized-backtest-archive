"""
QT cascade engine — mechanical test of the NQsavage setup.

    HTF PO3 bias  ->  external SSMT (15m, vs TDO)  ->  internal SSMT (90m/micro, vs TNY/TMSO)  ->  1m CISD entry

Traded instrument: NQ.  Correlated references: ES, YM.
All timestamps America/New_York, open-stamped 1-minute bars.
"""
from __future__ import annotations
import numpy as np
import pandas as pd

NY = "America/New_York"

ES_YM_PATH = "/Users/kaveh/quant_lab/cache/es_ym_1m.parquet"
NQ_PATH    = "/Users/kaveh/Downloads/mesx/NQ_true1min_2022_2025.csv"

NQ_TICK      = 0.25      # points
NQ_PT_VALUE  = 20.0      # $/point, full-size NQ
MNQ_PT_VALUE = 2.0       # $/point, micro

# all-in round-turn cost in NQ POINTS (commission + 1 tick slippage each side)
COST_PTS_NQ  = 0.75      # ~$5 RT commission (0.25pt) + 0.5pt slippage
COST_PTS_MNQ = 1.12      # ~$1.24 RT on $2/pt (0.62pt) + 0.5pt slippage


# --------------------------------------------------------------------------
# data
# --------------------------------------------------------------------------
def load_data(verbose: bool = True) -> pd.DataFrame:
    """ES/NQ/YM 1m on a common NY-tz open-stamped index.

    The NQ csv is CLOSE-stamped (bar covering 09:30-09:31 is labelled 09:31)
    while the es_ym parquet is OPEN-stamped.  Verified empirically: naive join
    gives corr(es,nq)=0.054; after the -1min shift it is 0.920, vs an
    ES/YM same-file control of 0.878.  See selftest.test_alignment.
    """
    ey = pd.read_parquet(
        ES_YM_PATH,
        columns=["es_open", "es_high", "es_low", "es_close",
                 "ym_open", "ym_high", "ym_low", "ym_close"],
    )

    nq = pd.read_csv(NQ_PATH, usecols=["timestamp ET", "open", "high", "low", "close"])
    ts = pd.to_datetime(nq["timestamp ET"], format="%m/%d/%Y %H:%M")
    ts = ts - pd.Timedelta(minutes=1)                      # <-- close-stamped -> open-stamped
    ts = ts.dt.tz_localize(NY, ambiguous="NaT", nonexistent="NaT")
    nq = nq.assign(ts=ts).dropna(subset=["ts"]).set_index("ts").sort_index()
    nq = nq[~nq.index.duplicated(keep="first")][["open", "high", "low", "close"]]
    nq.columns = ["nq_open", "nq_high", "nq_low", "nq_close"]

    df = ey.join(nq, how="inner").sort_index()
    df = df.dropna()

    # session day: futures day runs 18:00 -> 18:00, so +6h maps a bar to its session date
    df["sdate"] = (df.index + pd.Timedelta(hours=6)).date
    df["tmin"] = df.index.hour * 60 + df.index.minute      # minutes past NY midnight

    # drop short sessions (Sunday opens / holidays) -- need a full day for QT cycles
    bars = df.groupby("sdate")["tmin"].transform("size")
    df = df[bars >= 500].copy()

    if verbose:
        print(f"[data] {len(df):,} bars  {df.index.min()} -> {df.index.max()}  "
              f"{df['sdate'].nunique()} session days")
    return df


def scramble_references(df: pd.DataFrame, offset_days: int = 37) -> pd.DataFrame:
    """NULL: rotate ES/YM forward by N session days so real divergence is
    destroyed but each series keeps its own marginal distribution.

    If SSMT scores the same here as on real data, the divergence carries no
    information and the external/internal layers are decoration.
    """
    out = df.copy()
    days = sorted(out["sdate"].unique())
    shift = {d: days[(i + offset_days) % len(days)] for i, d in enumerate(days)}

    ref = out[["es_open", "es_high", "es_low", "es_close",
               "ym_open", "ym_high", "ym_low", "ym_close", "sdate", "tmin"]].copy()
    ref["src"] = ref["sdate"].map(shift)
    # index donor rows by (donor_date, minute) and pull them onto the target bars
    donor = ref.set_index(["sdate", "tmin"])[
        ["es_open", "es_high", "es_low", "es_close",
         "ym_open", "ym_high", "ym_low", "ym_close"]]
    donor = donor[~donor.index.duplicated(keep="first")]
    keys = pd.MultiIndex.from_arrays([ref["src"].values, ref["tmin"].values])
    pulled = donor.reindex(keys)
    for c in donor.columns:
        out[c] = pulled[c].values
    return out.dropna()


# --------------------------------------------------------------------------
# QT clock  --  True Open of any cycle == the open of that cycle's Q2
# --------------------------------------------------------------------------
# day cycle   18:00 -> 18:00, quarters 18:00 / 00:00 / 06:00 / 12:00  -> TDO = 00:00
# NY session  06:00 -> 12:00, quarters 06:00 / 07:30 / 09:00 / 10:30  -> TNY = 07:30
# 90m block   -> micro quarters at +0 / +22.5m / +45m / +67.5m        -> TMSO = +22.5m
# week        Sun 18:00 start, Q2 = Tuesday session -> TWO = Monday 18:00

TDO_MIN = 0            # 00:00
TNY_MIN = 7 * 60 + 30  # 07:30  (canonical QT)
TNY_ALT = 9 * 60 + 30  # 09:30  (what he told us -- tested as a variant)

# 90m block boundaries across the full 18:00->18:00 day, in minutes past NY midnight
_BLOCK_STARTS = [(18 * 60 + 90 * k) % 1440 for k in range(16)]


def block_start_min(tmin: int) -> int:
    """Start (minutes past midnight) of the 90m block containing tmin."""
    off = (tmin - 18 * 60) % 1440
    return (18 * 60 + (off // 90) * 90) % 1440


def tmso_min(tmin: int) -> float:
    """True Micro Session Open = block start + 22.5 minutes."""
    return (block_start_min(tmin) + 22.5) % 1440


def add_true_opens(df: pd.DataFrame) -> pd.DataFrame:
    """Attach TDO / TNY / TNY_ALT / TMSO / TWO price levels (NQ) to every bar."""
    out = df.copy()

    def level_at(minute: int, col: str = "nq_open") -> pd.Series:
        """price at the given minute-of-day, per session day, forward-filled."""
        hits = out[out["tmin"] == minute]
        return out["sdate"].map(hits.groupby("sdate")[col].first())

    out["tdo"] = level_at(TDO_MIN)
    out["tny"] = level_at(TNY_MIN)
    out["tny_alt"] = level_at(TNY_ALT)

    # TMSO: open of the bar at (block start + 22.5m). 22.5 is not a whole minute,
    # so the micro-quarter opens on the :22/:23 and :52/:53 boundaries -- take the
    # bar at floor(+22.5) = +22 minutes into the block.
    out["_blk"] = [block_start_min(t) for t in out["tmin"]]
    out["_tmso_min"] = (out["_blk"] + 22) % 1440
    tm = out[out["tmin"] == out["_tmso_min"]]
    key = pd.MultiIndex.from_arrays([tm["sdate"], tm["_blk"]])
    tmso_lvl = pd.Series(tm["nq_open"].values, index=key)
    tmso_lvl = tmso_lvl[~tmso_lvl.index.duplicated(keep="first")]
    out["tmso"] = tmso_lvl.reindex(
        pd.MultiIndex.from_arrays([out["sdate"], out["_blk"]])).values

    # TWO = Monday 18:00 ET == first bar of the Tuesday session
    mon18 = out[(out.index.dayofweek == 0) & (out["tmin"] == 18 * 60)]
    two_by_week = mon18.groupby(mon18.index.isocalendar().week)["nq_open"].first()
    out["two"] = pd.Series(out.index.isocalendar().week.values,
                           index=out.index).map(two_by_week)

    return out.drop(columns=["_blk", "_tmso_min"])


# --------------------------------------------------------------------------
# resampling
# --------------------------------------------------------------------------
def resample(df: pd.DataFrame, rule: str) -> pd.DataFrame:
    """Resample the 3-symbol 1m frame to a higher timeframe (label = bar open)."""
    agg = {}
    for p in ("es", "nq", "ym"):
        agg[f"{p}_open"] = (f"{p}_open", "first")
        agg[f"{p}_high"] = (f"{p}_high", "max")
        agg[f"{p}_low"] = (f"{p}_low", "min")
        agg[f"{p}_close"] = (f"{p}_close", "last")
    out = df.resample(rule, label="left", closed="left", origin="start_day").agg(**agg)
    return out.dropna()


# --------------------------------------------------------------------------
# SSMT  (Smart-money / sequential divergence between correlated assets)
# --------------------------------------------------------------------------
def ssmt(bars: pd.DataFrame, lookback: int = 12, side: str = "short",
         require_both: bool = False) -> pd.Series:
    """True where NQ takes out its prior `lookback`-bar extreme and a reference does not.

    side='short' -> divergence at the HIGHS (NQ makes HH, ES/YM fail)
    side='long'  -> divergence at the LOWS  (NQ makes LL, ES/YM fail)
    """
    if side == "short":
        def took(p):
            prior = bars[f"{p}_high"].rolling(lookback).max().shift(1)
            return bars[f"{p}_high"] > prior
    else:
        def took(p):
            prior = bars[f"{p}_low"].rolling(lookback).min().shift(1)
            return bars[f"{p}_low"] < prior

    nq, es, ym = took("nq"), took("es"), took("ym")
    ref_failed = (~es & ~ym) if require_both else (~es | ~ym)
    return (nq & ref_failed).fillna(False)


# --------------------------------------------------------------------------
# CISD  (Change in State of Delivery)
# --------------------------------------------------------------------------
def cisd(bars: pd.DataFrame, side: str = "short", prefix: str = "nq") -> pd.Series:
    """Bearish CISD: a body CLOSE below the OPEN of the first candle in the run of
    consecutive up-close candles that delivered price into the recent high.
    Wicks are ignored entirely -- only opens and closes matter.

    Bullish CISD is the mirror.
    """
    o = bars[f"{prefix}_open"].to_numpy()
    c = bars[f"{prefix}_close"].to_numpy()
    n = len(o)
    sig = np.zeros(n, dtype=bool)

    want_up = c > o if side == "short" else c < o

    armed = np.nan     # open of the first candle of the most recent consecutive run
    prev_in_run = False

    for i in range(n):
        if want_up[i]:
            if not prev_in_run:
                armed = o[i]        # a FRESH consecutive run -> re-arm at its first open
            prev_in_run = True
        else:
            prev_in_run = False
            if np.isfinite(armed):
                broke = (c[i] < armed) if side == "short" else (c[i] > armed)
                if broke:
                    sig[i] = True
                    armed = np.nan  # consumed; wait for the next run to re-arm
    return pd.Series(sig, index=bars.index)

