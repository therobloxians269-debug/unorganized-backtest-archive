#!/usr/bin/env python3
"""
Founder Accumulation ETF — BENCHMARK / PLACEBO TEST
====================================================
The 27%/yr headline from backtest.py is worthless on its own: the universe is
mega-cap tech over 2015-2026, which returned enormous amounts by simply existing.

This script asks the only question that matters:
    Does the ACCUMULATION SIGNAL add anything over holding the same stocks?

Four arms, identical universe, identical rebalance calendar, identical costs:
    1. SIGNAL      rank by -momentum/vol, hold top 6            (the strategy)
    2. HOLD ALL    equal-weight all 10, rebalance monthly        (universe control)
    3. RANDOM      pick 6 at random each month                   (placebo)
    4. INVERSE     rank by +momentum/vol, hold top 6             (sign control)

If SIGNAL does not beat HOLD ALL and RANDOM, there is no edge -- only beta to a
basket that went up. If INVERSE beats SIGNAL, the hypothesis is backwards.
"""

import pandas as pd
import numpy as np
import yfinance as yf
from datetime import timedelta
import warnings
warnings.filterwarnings('ignore')

FOUNDERS = ['NVDA', 'TSLA', 'META', 'AMZN', 'GOOG', 'MSFT', 'AAPL', 'NFLX', 'CRM', 'PANW']
HOLDINGS = 6
START_DATE = '2015-01-01'
END_DATE = '2026-08-11'
COST_BPS = 10.0   # 10 bps round-trip per rebalanced position: spread + commission
N_RANDOM = 200    # placebo draws

print("\n" + "="*80)
print(" FOUNDER ACCUMULATION — BENCHMARK & PLACEBO")
print("="*80)

# ── data ────────────────────────────────────────────────────────────────────
print("\n[*] Fetching prices...")
series = []
for ticker in FOUNDERS + ['SPY']:
    try:
        df = yf.download(ticker, start=START_DATE, end=END_DATE, progress=False)
        if len(df) > 0 and 'Close' in df.columns:
            s = df['Close'].copy()
            s.name = ticker
            series.append(s)
    except Exception:
        pass

allpx = pd.concat(series, axis=1).dropna(how='all')
spy = allpx['SPY'].dropna()
prices = allpx[[c for c in allpx.columns if c != 'SPY']].dropna(how='all')
print(f"[+] {len(prices.columns)} founder tickers + SPY, {len(prices)} trading days\n")


def third_fridays(start_str, end_str, index):
    dates, cur, end = [], pd.Timestamp(start_str).replace(day=1), pd.Timestamp(end_str)
    while cur <= end:
        month_end = (cur + pd.DateOffset(months=1)).replace(day=1) - timedelta(days=1)
        fridays = pd.date_range(start=cur, end=month_end, freq='W-FRI')
        if len(fridays) >= 3 and fridays[2] <= end:
            dates.append(fridays[2])
        cur = (cur + pd.DateOffset(months=1)).replace(day=1)
    snapped = [index[index >= d][0] for d in dates if len(index[index >= d]) > 0]
    return sorted(set(snapped))


REBAL = third_fridays(START_DATE, END_DATE, prices.index)
print(f"[+] {len(REBAL)} rebalance dates (3rd Friday)\n")

# Precompute price lookup as plain numpy for speed
px = prices.ffill()
cols = list(px.columns)
col_idx = {c: i for i, c in enumerate(cols)}
pxv = px.values
dates = px.index
rebal_set = set(REBAL)


def momentum_scores(row_i, sign=+1):
    """
    sign=+1 -> ACCUMULATION: high score for NEGATIVE momentum (founder buys weakness)
    sign=-1 -> INVERSE:      high score for POSITIVE momentum (plain momentum)
    """
    out = {}
    if row_i < 90:
        return out
    for c, j in col_idx.items():
        p_now, p_then = pxv[row_i, j], pxv[row_i - 90, j]
        if not np.isfinite(p_now) or not np.isfinite(p_then) or p_then <= 0:
            continue
        mom = (p_now / p_then) - 1.0
        window = pxv[max(0, row_i - 90):row_i + 1, j]
        rets = np.diff(window) / window[:-1]
        rets = rets[np.isfinite(rets)]
        if len(rets) < 10:
            continue
        vol = float(np.std(rets))
        out[c] = sign * (-mom) / max(vol, 0.001)
    return out


def run(arm, seed=None):
    """arm: 'signal' | 'holdall' | 'random' | 'inverse'"""
    rng = np.random.default_rng(seed)
    cash = 1000.0
    shares = np.zeros(len(cols))
    pv_hist = np.empty(len(dates))

    for i in range(len(dates)):
        if dates[i] in rebal_set:
            # liquidate to cash
            row = pxv[i]
            held = np.isfinite(row) & (shares > 0)
            cash += float(np.sum(shares[held] * row[held]))
            shares = np.zeros(len(cols))

            # choose the basket
            if arm == 'holdall':
                pick = [c for c in cols if np.isfinite(pxv[i, col_idx[c]])]
            elif arm == 'random':
                avail = [c for c in cols if np.isfinite(pxv[i, col_idx[c]])]
                k = min(HOLDINGS, len(avail))
                pick = list(rng.choice(avail, size=k, replace=False)) if k else []
            else:
                sc = momentum_scores(i, sign=+1 if arm == 'signal' else -1)
                pick = [t for t, _ in sorted(sc.items(), key=lambda x: x[1], reverse=True)[:HOLDINGS]]

            if pick:
                per = cash / len(pick)
                spent = 0.0
                for t in pick:
                    j = col_idx[t]
                    p = pxv[i, j]
                    if np.isfinite(p) and p > 0:
                        # cost charged on the notional traded into each name
                        eff = per * (1.0 - COST_BPS / 10000.0)
                        shares[j] = eff / p
                        spent += per
                cash -= spent

        row = pxv[i]
        held = np.isfinite(row) & (shares > 0)
        pv_hist[i] = cash + float(np.sum(shares[held] * row[held]))

    return pv_hist


def stats(pv, label):
    r = np.diff(pv) / pv[:-1]
    r = r[np.isfinite(r)]
    yrs = len(pv) / 252.0
    cagr = (pv[-1] / pv[0]) ** (1 / yrs) - 1
    vol = float(np.std(r)) * np.sqrt(252)
    sharpe = cagr / vol if vol > 0 else 0.0
    cummax = np.maximum.accumulate(pv)
    mdd = float(np.min((pv - cummax) / cummax))
    calmar = cagr / abs(mdd) if mdd < 0 else 0.0
    return {
        'label': label, 'final': pv[-1], 'cagr': cagr, 'vol': vol,
        'sharpe': sharpe, 'mdd': mdd, 'calmar': calmar,
        'skew': float(pd.Series(r).skew()),
    }


print("[*] Running arms...\n")
res = []
res.append(stats(run('signal'),  'SIGNAL (accumulation)'))
res.append(stats(run('holdall'), 'HOLD ALL 10 (control)'))
res.append(stats(run('inverse'), 'INVERSE (momentum)'))

# SPY buy & hold, normalised to $1,000
spy_al = spy.reindex(px.index).ffill().dropna()
spy_pv = 1000.0 * (spy_al / spy_al.iloc[0]).values
res.append(stats(spy_pv, 'SPY buy & hold'))

# Random placebo distribution
