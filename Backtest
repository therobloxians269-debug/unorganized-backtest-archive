"""
FORCED FLOW — three candidates, ours, candle-only, mechanism-first.

The premise from today's two kills: every dead concept in the program is CHART
STRUCTURE (a location), every survivor is an EXOGENOUS EVENT OR REGIME. So stop
looking for patterns and look for flow somebody is OBLIGATED to execute.

None of these is a level, so [[the fill paradox]] does not apply to any of them.

---------------------------------------------------------------------------
FF1 · THE LEAN — VWAP execution obligation
    Mechanism: a large share of institutional index execution is benchmarked to
    VWAP. An algo working a buy order is measured against VWAP, so it must keep
    participating, and it participates HARDEST when price is below its benchmark.
    Sustained time below VWAP therefore manufactures a real, non-discretionary bid.
    Observable: TIME SPENT below VWAP, and the integral of the discount. This is a
    DURATION, not a deviation.
    ⚠ Must be distinguished from the dead VWAP sigma-fade: that was a DEVIATION
      fade (killed at every sigma). Deviation is included here as a CONTROL so we
      can prove duration adds something beyond "price is far from VWAP".

FF2 · THE HANDOFF — overnight inventory redistribution
    Mechanism: overnight moves print in thin liquidity. Inventory acquired cheaply
    at 03:00 must be handed to RTH participants at real size. When a large
    overnight move was built on LITTLE volume, RTH liquidity has not validated
    those prices and has to re-auction them.
    Observable: overnight net move per unit of overnight volume. Not a level.

FF3 · THE CROSS — opening auction imbalance
    Mechanism: the 09:30 cross is a genuine forced-clearing event; accumulated
    overnight order imbalance is discharged into it. Unusual opening volume means
    an unusually large imbalance was cleared.
    Observable: first-minutes volume vs its own trailing norm, signed by the
    direction it printed. Not a level.
"""
import numpy as np, pandas as pd, warnings
warnings.filterwarnings('ignore')

RTH0, RTH1 = 570, 960


def session_signals(day, rb, checks=tuple(range(600, 931, 30))):
    """
    One row per (session, checkpoint) carrying every forced-flow signal, all causal,
    plus the forward return to the close in ADR units.
    """
    rows = []
    for dd, row in day.iterrows():
        b = rb.get(dd)
        if b is None:
            continue
        H, L, C, T, V = b['H'], b['L'], b['C'], b['T'], b['V']
        A = float(row.ADR); o = float(row.o930)
        if not (A > 0) or len(C) < 200:
            continue
        tp = (H + L + C) / 3.0
        cpv = np.cumsum(tp * V); cv = np.cumsum(V)
        vwap = np.where(cv > 0, cpv / np.maximum(cv, 1e-9), C)
        below = (C < vwap).astype(float)
        disc = (vwap - C) / A                      # + when price is below VWAP
        cum_below = np.cumsum(below)
        cum_disc = np.cumsum(np.maximum(disc, 0.0))
        cum_prem = np.cumsum(np.maximum(-disc, 0.0))

        # --- FF2, fixed for the whole session, known at 09:30 ---
        on_net = (o - float(row.prevC)) / A
        on_rng = (float(row.onH) - float(row.onL)) / A
        onv = float(row.onV) if np.isfinite(row.onV) else np.nan
        onv_n = float(row.onV_z) if 'onV_z' in row.index else np.nan
        # inventory built per unit of liquidity: big move, little volume = cheap
        ff2 = on_net / max(onv_n, 0.05) if np.isfinite(onv_n) else np.nan

        # --- FF3, known a few minutes after the open ---
        n5 = min(5, len(C) - 1)
        v5 = float(V[:n5].sum())
        v5_n = v5 / float(row.openV_ma) if ('openV_ma' in row.index
                                            and np.isfinite(row.openV_ma)
                                            and row.openV_ma > 0) else np.nan
        d5 = (float(C[n5 - 1]) - o) / A
        ff3 = np.sign(d5) * v5_n if np.isfinite(v5_n) else np.nan

        cl = float(C[-1])
        for t in checks:
            k = int(np.searchsorted(T, t, side='right')) - 1
            if k < 30 or k >= len(C) - 15:
                continue
            n = k + 1
            rows.append(dict(
                day=dd, t=t, ADR=A, o930=o, px=float(C[k]),
                # FF1 duration family
                f_below=cum_below[k] / n,
                f_disc=cum_disc[k] / n,
                f_lean=(cum_disc[k] - cum_prem[k]) / n,
                # FF1 controls — deviation, the thing already killed
                c_dev=(float(C[k]) - vwap[k]) / A,
                c_absdev=abs(float(C[k]) - vwap[k]) / A,
                # FF2 / FF3
                f_hand=ff2, on_net=on_net, on_rng=on_rng,
                f_cross=ff3,
                # forward, in ADR units, from this checkpoint to the close
                y=(cl - float(C[k])) / A,
            ))
    return pd.DataFrame(rows).replace([np.inf, -np.inf], np.nan)


def add_norms(day):
    """Trailing norms that the signals need, all shifted so today never sees itself."""
    day = day.copy()
    day['onV_z'] = day.onV / day.onV.shift(1).rolling(20, min_periods=10).mean()
    return day


def daycluster(x, days):
    """Mean and day-clustered t. Sessions are the independent unit, not rows."""
    x = np.asarray(x, dtype=float)
    m = np.isfinite(x)
    if m.sum() < 30:
        return np.nan, np.nan, int(m.sum())
    g = pd.Series(x[m]).groupby(np.asarray(days)[m]).mean()
    if len(g) < 10 or g.std(ddof=1) == 0:
        return float(g.mean()), np.nan, int(m.sum())
    return float(g.mean()), float(g.mean() / (g.std(ddof=1) / np.sqrt(len(g)))), int(m.sum())


def ic(sig, y, days):
    """Spearman IC with a day-clustered t, the cleanest test of a continuous signal."""
    d = pd.DataFrame({'s': sig, 'y': y, 'd': days}).dropna()
    if len(d) < 100:
        return np.nan, np.nan, len(d)
    per = d.groupby('d').apply(lambda g: g.s.corr(g.y, method='spearman')
                               if len(g) > 3 and g.s.nunique() > 2 else np.nan).dropna()
    if len(per) < 20:
        r = d.s.corr(d.y, method='spearman')
        return float(r), np.nan, len(d)
    return float(per.mean()), float(per.mean() / (per.std(ddof=1) / np.sqrt(len(per)))), len(d)


def quintiles(sig, y, days, name='', q=5):
    d = pd.DataFrame({'s': sig, 'y': y, 'd': days}).dropna()
    if len(d) < 200:
        print(f'    {name}: too few rows ({len(d)})')
        return None
    try:
        d['b'] = pd.qcut(d.s, q, labels=False, duplicates='drop')
    except ValueError:
        return None
    print(f'    {name:<12}' + ''.join(f'{f"Q{i+1}":>12}' for i in range(d.b.nunique())))
    mus, ts = [], []
    for i in sorted(d.b.unique()):
        g = d[d.b == i]
        mu, t, n = daycluster(g.y, g.d)
        mus.append(mu); ts.append(t)
    print(f'    {"mean y":<12}' + ''.join(f'{m:>+12.4f}' for m in mus))
    print(f'    {"t (day)":<12}' + ''.join(f'{t:>+12.2f}' for t in ts))
    return mus

